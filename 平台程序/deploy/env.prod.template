# 新平台后端生产环境变量（api2.zszhj.com 部署用）
# 用法：复制为服务器上 /opt/zhongshu/.env（权限 600），值已在本机 .env 备齐——逐项搬运即可
ZS_PG_URL=jdbc:postgresql://127.0.0.1:5432/zhongshu_design
ZS_PG_USERNAME=zhongshu
ZS_PG_PASSWORD=__生产PG密码__
ZS_REDIS_HOST=127.0.0.1
ZS_REDIS_PORT=6379
ZS_REDIS_PASSWORD=__生产Redis密码__
ZS_INTERNAL_SECRET=__见本机 .env__
ZS_ACCESS_CODE_PEPPER=__见本机 .env__
ZS_ACCESS_CODE_PEPPER_VERSION=v1
ZS_ACCESS_CODE_ARTIFACT_KEY=__见本机 .env__
ZS_WX_APPID=wxfa0a79d4e68cdb80
ZS_WX_APPSECRET=__C端小程序后台获取__
PF_WX_PROVIDER=real
PF_WX_STAFF_APPID=wxe584f6fad7b54487
PF_WX_STAFF_APPSECRET=__见本机 .env__
PF_SMS_PROVIDER=real
PF_SMS_SDK_APP_ID=1401223778
PF_SMS_SECRET_ID=__见本机 .env__
PF_SMS_SECRET_KEY=__见本机 .env__
PF_SMS_REGION=ap-guangzhou
PF_SMS_SIGN_NAME=__待签名审核__
# 验证码模板 2026-11-13 已审核通过（StatusCode 0=已生效）
PF_SMS_TEMPLATE_ID=2774958
ZS_COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
ZS_COS_REGION=ap-guangzhou
ZS_COS_BUCKET=zhongshu-design-1397776231
ZS_COS_SECRET_ID=__见本机 .env__
ZS_COS_SECRET_KEY=__见本机 .env__
ZS_MODERATION_SECRET_ID=__见本机 .env__
ZS_MODERATION_SECRET_KEY=__见本机 .env__
ZS_MODERATION_REGION=ap-guangzhou
ZS_MODERATION_BIZ_TYPE=zhongshu-asset
ZS_MODERATION_DAILY_LIMIT=5000
ZS_AI_BASE_URL=https://api.apilio.ai/v1
ZS_AI_MODEL=gpt-5.6-sol
ZS_AI_API_KEY=__用户自配__
# AI Runtime（笔记润色等）：P4D 交付前留空=功能关闭，前端提示"暂未配置"
# ZS_AI_RUNTIME_URL=
ZS_CONTENT_TASK_SWEEP_ENABLED=true
# ---- 24 号 B-14：激活码退役（生产必须 false；守卫强制"显式 false"，缺失即拒启） ----
ZS_ACCESS_CODE_ENABLED=false
# ---- 24 号 D6 §2.4：长期未终结预扣告警（只告警+人工核对，不自动退款） ----
# 架构决策：设计小程序与赋能平台独立运营，点数不互通 → 迁移永久关闭（true 仅限人工复核场景）
ZS_ORG_POINT_MIGRATION_ENABLED=false
ZS_ORG_POINT_PENDING_ALERT=true
ZS_ORG_POINT_PENDING_ALERT_HOURS=24
# ---- 充值/虚拟支付：首发保持 false；开通微信虚拟支付后补齐三键再改 true ----
ZS_RECHARGE_ENABLED=false
# ZS_XPAY_OFFER_ID=__微信后台虚拟支付道具ID__
# ZS_XPAY_OFFER_APP_KEY=__道具密钥__
# ZS_XPAY_OFFER_PUSH_TOKEN=__推送token__
ZS_PAY_STUB_AUTO_SETTLE=false
# ---- 内容创作五通道密钥：缺哪个通道哪个调用报错（1_114_000_006），互不影响 ----
# ZS_DIADI_APP_ID=__待注入__
# ZS_DIADI_APP_SECRET=__待注入__
# ZS_DASHSCOPE_API_KEY=__待注入__
# ZS_DEEPSEEK_API_KEY=__待注入__
# ZS_HIFLY_API_KEY=__待注入__
# ZS_METASO_API_KEY=__待注入__
# ---- 运维拨测（可选）：deploy/ops/probe-health.sh 读取 ----
# ZS_OPS_WEBHOOK=__企业微信群机器人webhook__
ZS_CORS_ALLOWED_ORIGINS=https://api.zszhj.com
# ---- 日志落盘（P0 必配）：logback 用 ${LOG_FILE} 且无默认值，缺省会写成 LOG_FILE_IS_UNDEFINED ----
# 部署前先建目录并授权：mkdir -p /opt/zhongshu/logs && chown zhongshu:zhongshu /opt/zhongshu/logs
LOG_FILE=/opt/zhongshu/logs/zhongshu.log
