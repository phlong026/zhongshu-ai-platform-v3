# NON-EXECUTABLE PLAN FRAGMENT. Proposed 100 GiB data + 200 GiB backup disks, not purchased.
# Region ap-shanghai, zone ap-shanghai-5, instance ins-4m1linvl.
# Prefer new encrypted B-only volumes; actual type, quota, capacity and price require a live quote.
B_SAME_HOST_MOUNT=/mnt/zhongshu-platform-b-data
B_SAME_HOST_DATA_ROOT=/mnt/zhongshu-platform-b-data/zhongshu-platform-b
AI_RUNTIME_JOURNAL_DIR=/mnt/zhongshu-platform-b-data/zhongshu-platform-b/runtime-journal
B_SAME_HOST_MIN_FREE_BYTES=26843545600
B_SAME_HOST_STORAGE_PROOF_FILE=/etc/zhongshu-platform-b/storage-evidence/data-proof.json
B_SAME_HOST_STORAGE_PROOF_SHA256=
B_SAME_HOST_STORAGE_ATTESTATION_FILE=/etc/zhongshu-platform-b/storage-evidence/data-attestation.json
B_SAME_HOST_STORAGE_ATTESTATION_SIGNATURE_FILE=/etc/zhongshu-platform-b/storage-evidence/data-attestation.sig
B_SAME_HOST_APPROVER_PUBLIC_KEY_FILE=/etc/zhongshu-platform-b/storage-evidence/approver.pem
B_SAME_HOST_PROTECTED_A_PATHS_FILE=/etc/zhongshu-platform-b/storage-evidence/protected-a-paths.txt
B_SAME_HOST_BACKUP_MOUNT=/mnt/zhongshu-platform-b-backup
B_SAME_HOST_BACKUP_ROOT=/mnt/zhongshu-platform-b-backup/zhongshu-platform-b-backups
B_SAME_HOST_BACKUP_MIN_FREE_BYTES=34359738368
B_SAME_HOST_BACKUP_MAX_BYTES=103079215104
B_SAME_HOST_BACKUP_STORAGE_PROOF_FILE=/etc/zhongshu-platform-b/storage-evidence/backup-proof.json
B_SAME_HOST_BACKUP_STORAGE_PROOF_SHA256=
B_SAME_HOST_BACKUP_STORAGE_ATTESTATION_FILE=/etc/zhongshu-platform-b/storage-evidence/backup-attestation.json
B_SAME_HOST_BACKUP_STORAGE_ATTESTATION_SIGNATURE_FILE=/etc/zhongshu-platform-b/storage-evidence/backup-attestation.sig
B_SAME_HOST_BACKUP_APPROVER_PUBLIC_KEY_FILE=/etc/zhongshu-platform-b/storage-evidence/approver.pem
