# Copy outside all source/release directories. Fill every value; no usable defaults.
# Images must already be imported after isolated build/scanning; no production pull/build.
PLATFORM_API_IMAGE=
PLATFORM_PG_BOOTSTRAP_PASSWORD_FILE=
PLATFORM_PG_OWNER_PASSWORD_FILE=
PLATFORM_PG_APP_PASSWORD_FILE=
PLATFORM_REDIS_APP_PASSWORD_FILE=
PLATFORM_REDIS_BACKUP_PASSWORD_FILE=
# External platform.properties supplies the complete signed zhongshu.design.remote.* configuration:
# enabled=true; origin=https://design-provider:48443; caller-app-id; active-key-id;
# keys.<active-key-id> (dedicated Base64 key), plus the real zhongshu.org-point.headquarters-tenant-id.
# Never reuse A consumer/Runtime secrets. Missing/invalid enabled credentials reject API startup.
# The separate anonymous published-case HTTPS origin is non-secret and is forwarded explicitly.
# It must point at A's public API origin and must not reuse zhongshu.design.remote.origin.
PF_DESIGN_PUBLIC_CASES_ORIGIN=
# Other PF_DESIGN_* entries in this Compose env file are NOT forwarded to the container.
# External platform.properties must also set zhongshu.org-point.headquarters-tenant-id
# to the verified B headquarters tenant. Test fixture values must never be used in production.
PLATFORM_CONFIG_FILE=

# B design capability overlay (compose.capabilities.yaml). Every file stays outside source/release trees.
DESIGN_PROVIDER_IMAGE=
AI_RUNTIME_IMAGE=
DESIGN_PG_BOOTSTRAP_PASSWORD_FILE=
DESIGN_PG_OWNER_PASSWORD_FILE=
DESIGN_PG_APP_PASSWORD_FILE=
DESIGN_REDIS_APP_PASSWORD_FILE=
DESIGN_REDIS_BACKUP_PASSWORD_FILE=
DESIGN_PROVIDER_CONFIG_FILE=
DESIGN_PROVIDER_MIGRATION_CONFIG_FILE=
DESIGN_PROVIDER_KEYSTORE_FILE=
DESIGN_PROVIDER_TRUSTSTORE_FILE=
DESIGN_PROVIDER_CA_FILE=
AI_RUNTIME_CONFIG_FILE=
# Must be an existing absolute mount point on a dedicated thick-provisioned ext4/xfs volume.
# A normal Compose named volume does not satisfy the production capacity/fsync gate.
AI_RUNTIME_JOURNAL_DIR=
# Exact B output bucket expected in the frozen COS version inventory. Never set an A bucket.
COS_B_BUCKET=

# Optional same-host dedicated-disk overlay. Leave every B_SAME_HOST_* value empty to disable it.
# When enabled, fill every value and run same_host_storage.py check/prepare before any Compose mutation.
# The script never formats a disk or changes Docker's data-root. The mount must already be approved ext4/xfs.
B_SAME_HOST_MOUNT=
B_SAME_HOST_DATA_ROOT=
B_SAME_HOST_STORAGE_PROOF_FILE=
B_SAME_HOST_STORAGE_PROOF_SHA256=
B_SAME_HOST_STORAGE_ATTESTATION_FILE=
B_SAME_HOST_STORAGE_ATTESTATION_SIGNATURE_FILE=
B_SAME_HOST_APPROVER_PUBLIC_KEY_FILE=
# External root-owned file containing existing absolute A paths, one per line. At least one is required.
B_SAME_HOST_PROTECTED_A_PATHS_FILE=
# Reviewed live-free floor in bytes after images and recovery/backup headroom are calculated.
B_SAME_HOST_MIN_FREE_BYTES=
