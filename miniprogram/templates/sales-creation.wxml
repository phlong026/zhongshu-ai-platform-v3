<view class="page workbench-page sales-page creation-page center-page">
  <view class="workbench-header"><brand-header divider="{{true}}" title="内容创作" /></view>
  <view class="content center-body">
    <view class="section remix-card">

      <view class="creation-modes"><button wx:for="{{modes}}" wx:key="id" class="creation-mode {{item.id==='remix'?'selected':''}}" data-mode="{{item.id}}" bindtap="chooseMode"><image src="/assets/{{item.icon}}.png" mode="aspectFit"/><text>{{item.title}}</text><text class="creation-mode-hint">{{item.subtitle}}</text></button></view>
      <view class="section-heading remix-heading"><text class="section-title">爆款文案二创</text></view>
      <view class="share-input"><image class="link-icon" src="/assets/creation-link.png" mode="aspectFit" /><input class="link-input" value="{{link}}" bindinput="inputLink" placeholder="粘贴视频分享链接" maxlength="2000" aria-label="视频分享链接" /><button class="paste-button" bindtap="paste">粘贴</button></view>
<button class="creation-primary extract-button" bindtap="extract" disabled="{{extracting}}">{{extracting?extractStage+' '+parseProgress+'%':'提取文案'}}</button>
      <text wx:if="{{extractError}}" class="sales-note">{{extractError}}</text>
      <button class="manual-link" bindtap="openEditor">手动写文案<view class="chevron" /></button>
    </view>
    <view class="section creation-tools"><view class="section-heading"><text class="section-title">创作工具</text></view><view class="shortcuts"><button wx:for="{{shortcuts}}" wx:key="key" class="shortcut" data-key="{{item.key}}" bindtap="openShortcut"><image src="{{item.iconPath||'/assets/creation-'+item.icon+'.png'}}" mode="aspectFit" /><text>{{item.title}}</text></button></view></view>
    <view class="section recent-card"><view class="section-heading"><text class="section-title">最近创作</text><button class="text-link" bindtap="allRecent">查看全部<view class="chevron" /></button></view><view wx:for="{{recent}}" wx:key="id" class="recent-row"><image class="recent-cover" src="{{item.image}}" mode="aspectFill" /><view class="recent-copy"><text class="recent-title">{{item.title}}</text><text class="hint">{{item.badge}}</text><text wx:if="{{item.updatedText}}" class="hint">{{item.updatedText}}</text></view><button class="recent-action" data-id="{{item.id}}" data-task="{{item.taskId}}" bindtap="editRecent">{{item.action}}<view class="chevron" /></button></view><view wx:if="{{!recent.length}}" class="sales-empty">暂无最近创作</view></view>

  </view>
</view>

<view wx:if="{{sheet}}" class="creation-sheet-overlay" style="bottom:{{sheet==='editor'?editorKeyboardBottom||0:0}}px" bindtap="closeSheet" catchtouchmove="noop"><view class="creation-sheet {{sheet==='editor'?'creation-editor-sheet':''}} {{editorKeyboardOpen?'keyboard-open':''}}" style="{{sheet==='editor'?'height:'+editorSheetHeight+'px':''}}" catchtap="noop"><view class="creation-sheet-header"><text>{{sheetTitle}}</text><button class="creation-sheet-close" bindtap="closeSheet">关闭</button></view><text class="creation-sheet-text">输入会自动暂存，关闭后可以继续。</text><view class="creation-resizable"><textarea style="height:{{editorInputHeight}}px" class="creation-sheet-input" adjust-position="{{false}}" cursor-spacing="16" bindkeyboardheightchange="editorKeyboardChange" show-confirm-bar="{{true}}" value="{{editorText}}" bindinput="inputEditor" placeholder="写下创作主题和口播文案" maxlength="7000" aria-label="口播文案"/><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="editor" data-normal="220" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded.editor?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view><button class="creation-primary creation-sheet-button" bindtap="saveDraft">保存并继续</button></view></view>
