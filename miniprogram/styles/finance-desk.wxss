@import "./steps.wxss";
.fin-page{min-height:100vh;background:#faf8f4;color:#24211f;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif;font-size:27rpx;line-height:1.5;padding-bottom:calc(152rpx + env(safe-area-inset-bottom));box-sizing:border-box}.fin-content{padding:0 26rpx 24rpx}.fin-page button{box-sizing:border-box;margin:0;background:transparent;color:inherit;font:inherit;text-align:left;padding:0;border:0;border-radius:0;line-height:1.5}.fin-page button::after{border:0}.fin-context{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:#707780;font-size:25rpx;padding:10rpx 6rpx 22rpx}.fin-context-role{border-left:1rpx solid #ded6ca;padding-left:20rpx;margin-right:auto}.fin-card{background:#fff;border-radius:24rpx;padding:24rpx 22rpx;margin-bottom:22rpx;overflow:hidden}.fin-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:22rpx;min-height:42rpx}.fin-title{font-size:32rpx;font-weight:650;line-height:1.4;border-left:7rpx solid #89512a;padding-left:14rpx}.fin-page .fin-text{color:#89512a;font-size:24rpx;display:flex;align-items:center;justify-content:center;white-space:nowrap;min-height:54rpx}.fin-chevron{width:18rpx;height:24rpx;margin-left:8rpx;flex-shrink:0}.fin-muted{font-size:24rpx;color:#9a9187;line-height:1.5}.fin-metrics{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.fin-page .fin-metric{display:flex;align-items:center;gap:17rpx;background:#faf8f4;border-radius:15rpx;min-height:126rpx;padding:18rpx 16rpx;min-width:0}.fin-metric>image{width:49rpx;height:49rpx;flex-shrink:0}.fin-metric>view{min-width:0;display:flex;flex-direction:column}.fin-metric .fin-muted{font-size:25rpx;white-space:nowrap}.fin-number{font-size:47rpx;font-weight:650;line-height:1.3;color:#89512a;white-space:nowrap;font-variant-numeric:tabular-nums}.fin-metric.warning .fin-number,.fin-metric.warning .fin-muted{color:#b3402a}.fin-note{display:block;font-size:23rpx;line-height:1.6;color:#9a9187;margin-top:20rpx}.fin-page .fin-task{display:flex;align-items:center;gap:20rpx;width:100%;padding:22rpx 0;border-bottom:1rpx solid #eee8df}.fin-task:last-child{border-bottom:0;padding-bottom:8rpx}.fin-row-icon{height:72rpx;width:72rpx;flex-shrink:0;border-radius:50%;object-fit:contain}.fin-grow{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}.fin-name{font-weight:550;font-size:28rpx;line-height:1.5;overflow-wrap:anywhere}.fin-amount{color:#89512a;font-size:34rpx;font-weight:600;line-height:1.5;font-variant-numeric:tabular-nums}.fin-status{font-size:22rpx;color:#89512a;background:#f7f1e8;border-radius:7rpx;padding:3rpx 11rpx;align-self:flex-start;line-height:1.5}.fin-status.warning{background:#fff0e9;color:#b3402a}.fin-small-primary{background:#89512a;color:#fff;border-radius:10rpx;padding:12rpx 16rpx;font-size:25rpx;flex-shrink:0;white-space:nowrap}.fin-shortcuts{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx}.fin-page .fin-shortcuts button{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;background:#faf8f4;border-radius:13rpx;padding:16rpx 3rpx;gap:8rpx;font-size:25rpx;text-align:center}.fin-shortcuts image{height:46rpx;width:46rpx}.fin-shortcuts .fin-muted{font-size:22rpx;white-space:normal;min-height:50rpx}.fin-three{display:flex;justify-content:space-around;gap:16rpx;text-align:center}.fin-three>view{flex:1;display:flex;flex-direction:column;align-items:center}.fin-three>view+view{border-left:1rpx solid #eee8df}.fin-value{color:#89512a;font-size:36rpx;font-weight:600}.fin-page .fin-link-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx 0;width:100%;border-bottom:1rpx solid #eee8df}.fin-link-row:last-child{border-bottom:0}.fin-secondary{display:grid;grid-template-columns:1fr 1fr;gap:14rpx 24rpx}.fin-page .fin-secondary button{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;min-height:62rpx;color:#707780}.fin-page .fin-identity{color:#9a9187;text-align:center;display:block;width:100%;font-size:23rpx;min-height:70rpx}.fin-empty{display:flex;flex-direction:column;align-items:center;gap:14rpx;padding:36rpx 16rpx;color:#9a9187;font-size:25rpx;text-align:center}.fin-search{display:flex;align-items:center;background:#fff;border:1rpx solid #e3ded6;border-radius:44rpx;padding:0 22rpx;height:82rpx;margin:12rpx 0 20rpx}.fin-search>image{height:34rpx;width:34rpx;margin-right:15rpx;flex-shrink:0}.fin-search input{font-size:27rpx;flex:1;min-width:0;height:70rpx}.fin-page .fin-clear{font-size:22rpx;color:#89512a;min-width:64rpx;min-height:60rpx;display:flex;align-items:center;justify-content:center}.fin-segments{display:flex;background:#f3eee7;border-radius:16rpx;padding:4rpx;margin-bottom:22rpx;gap:4rpx}.fin-page .fin-segment{flex:1;text-align:center;border-radius:12rpx;padding:18rpx 4rpx;color:#9a9187;font-size:29rpx}.fin-page .fin-segment.selected{background:#89512a;color:#fff}.fin-filters{white-space:nowrap;margin-bottom:20rpx}.fin-filters>view{display:flex;gap:12rpx}.fin-page .fin-chip{background:#f4f0e9;border-radius:13rpx;padding:14rpx 22rpx;font-size:25rpx;display:inline-block;flex-shrink:0}.fin-page .fin-chip.selected{background:#89512a;color:#fff}.fin-filter-row{display:flex;gap:12rpx;margin:0 0 20rpx}.fin-filter-row picker{flex:1;min-width:0;background:#fff;border-radius:10rpx;text-align:center;font-size:24rpx;padding:15rpx 4rpx}.fin-filter-row .fin-filter-label{white-space:nowrap}.fin-flow-row{padding:22rpx 0;border-bottom:1rpx solid #eee8df}.fin-flow-row:last-child{border-bottom:0}.fin-row-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx}.fin-row-heading{display:flex;align-items:center;gap:13rpx;flex-wrap:wrap}.fin-flow-detail{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin-top:13rpx}.fin-page .fin-outline{border:2rpx solid #89512a;border-radius:10rpx;padding:10rpx 19rpx;color:#89512a;font-size:25rpx;white-space:nowrap;min-height:62rpx;display:flex;align-items:center;justify-content:center}.fin-page .fin-primary{background:#89512a;border-radius:12rpx;padding:18rpx 24rpx;color:#fff;font-size:28rpx;min-height:84rpx;text-align:center;display:flex;align-items:center;justify-content:center}.fin-back-row{display:flex;align-items:center;justify-content:space-between;padding:8rpx 2rpx 20rpx}.fin-page .fin-back{display:flex;align-items:center;color:#707780;min-height:60rpx;font-size:26rpx}.fin-back>image{width:18rpx;height:28rpx;margin-right:12rpx}.fin-pair{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:20rpx 0}.fin-pair>view{display:flex;flex-direction:column;gap:4rpx}.fin-pair>view+view{border-left:1rpx solid #eee8df;padding-left:22rpx}.fin-pair .fin-amount{font-size:38rpx}.fin-project-top{display:flex;gap:20rpx;align-items:center}.fin-project-top>image{height:74rpx;width:74rpx;flex-shrink:0}.fin-detail-values{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.fin-detail-values>view{background:#faf8f4;padding:20rpx 16rpx;border-radius:12rpx;display:flex;flex-direction:column;gap:6rpx}.fin-detail-values .fin-amount{font-size:39rpx;white-space:nowrap}.fin-page .fin-project-action{display:flex;justify-content:flex-end;margin-top:14rpx}.fin-actions{display:flex;gap:16rpx;margin:20rpx 0 12rpx}.fin-actions>button{flex:1}.fin-error{color:#b3402a;background:#fff0e9;border-radius:12rpx;padding:24rpx;margin-bottom:20rpx;font-size:26rpx}.fin-period{display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:24rpx;color:#9a9187;margin-bottom:20rpx}.fin-period picker{color:#89512a}.fin-subtitle{font-size:25rpx;color:#9a9187;margin-top:5rpx;display:block}.fin-no-match{padding:38rpx 20rpx;text-align:center;color:#9a9187;font-size:26rpx}.fin-company-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.fin-company-head .fin-name{font-size:31rpx}.fin-mini-links{display:flex;flex-wrap:wrap;gap:16rpx}.fin-page .fin-mini-links button{font-size:24rpx;color:#89512a;min-height:66rpx;display:flex;align-items:center}

.fin-company-name{display:flex;align-items:center;gap:16rpx;min-width:0}.fin-company-name>image{width:64rpx;height:64rpx;flex-shrink:0}

@import "./project-flow.wxss";
.fin-page{font-family:var(--business-font);font-size:28rpx;line-height:42rpx;color:var(--business-ink)}.fin-content{padding:20rpx 28rpx 24rpx}.fin-card{border:1rpx solid var(--business-line);border-radius:22rpx;padding:22rpx;margin-bottom:24rpx}.fin-title{font-size:32rpx;line-height:46rpx;font-weight:600}.fin-muted,.fin-note,.fin-context{font-size:24rpx;line-height:36rpx;color:var(--business-muted)}.fin-page .fin-segment,.fin-search input{font-size:28rpx;line-height:42rpx}.fin-small-primary{font-size:28rpx;line-height:42rpx}
