@import './sales.wxss';
page {
  --creation-brand: var(--zs-brand);
  --creation-text: var(--zs-ink);
  --creation-muted: #68717f;
  --creation-bg: var(--zs-bg);
  --creation-soft: #fbf1e7;
  --creation-border: #e5dfd7;
  background: var(--creation-bg);
  color: var(--creation-text);
  font-family:var(--zs-font-family);
  font-size:var(--zs-font-emphasis);
  line-height: 1.6;
}
.creation-page { min-height: 100vh; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.creation-page button { min-width: 44px; min-height: 44px; }
.creation-body { padding: 24rpx var(--zs-space-page) 0; }
.creation-card { background: var(--zs-card); border-radius: 22rpx; }
.creation-heading { min-height: 48rpx; display: flex; align-items: center; gap: 16rpx; }
.creation-heading-title { font-size:var(--zs-font-title); font-weight: 600; line-height: 46rpx; }
.creation-arrow { width: 14rpx; height: 24rpx; flex-shrink: 0; }
.creation-brown, .studio-brown { color: var(--creation-brand); }
.creation-muted, .studio-muted { color: var(--creation-muted); }
.creation-primary, .studio-primary, .studio-outline {
  position: relative; min-height: var(--zs-control-height); height: auto; padding: 12rpx 24rpx;
  border-radius: var(--zs-control-radius); white-space: normal; overflow-wrap: anywhere; text-align: center; font-size:var(--zs-font-emphasis); font-weight: 500; line-height: 42rpx;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
}
.creation-primary, .studio-primary { background: var(--creation-brand); color: #fffaf4; overflow: hidden; }
.studio-outline { border: 1rpx solid var(--creation-brand); color: var(--creation-brand); background: transparent; }
.creation-primary .button-label, .studio-primary > text { position: relative; }
.creation-primary[disabled], .studio-primary[disabled] { background: #e5dfd7; color: #68717f; }
button:active{ opacity: .78; }
.creation-sheet-overlay { position: fixed; inset: 0; z-index: 1100; background: rgba(25,19,15,.38); display: flex; align-items: flex-end; }
.creation-sheet { width: 100%; max-height: 85vh; overflow-y: auto; background: #fffdf9; border-radius: 24rpx 24rpx 0 0; padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); }
.creation-sheet-header { display: flex; justify-content: space-between; align-items: center; font-size:var(--zs-font-title); font-weight: 600; margin-bottom: 16rpx; }
.creation-sheet-close { font-size:var(--zs-font-body); font-weight: 400; color: var(--creation-brand); min-height: 44px; min-width: 44px; display: flex; align-items: center; justify-content: center; }
.creation-sheet-text { display: block; color: var(--creation-muted); font-size:var(--zs-font-meta); line-height: 36rpx; margin-top: 16rpx; }
.creation-sheet-input { width: 100%; height: 30vh; max-height: 420rpx; border: 1rpx solid var(--creation-border); border-radius: 16rpx; padding: 20rpx; margin: 16rpx 0; font-size:var(--zs-font-emphasis); line-height: 44rpx; }
.creation-sheet-button { width: 100%; margin-top: 24rpx; }
.creation-sheet-row { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 0; min-height: 44px; border-bottom: 1rpx solid var(--creation-border); text-align: left; width: 100%; font-size:var(--zs-font-emphasis); }
.creation-sheet-thumb { width: 144rpx; height: 96rpx; border-radius: 16rpx; flex-shrink: 0; }
.creation-sheet-row-title { font-size:var(--zs-font-emphasis); }
.creation-notice { display: block; color: var(--creation-muted); font-size:var(--zs-font-meta); line-height: 36rpx; padding: 0 4rpx; margin-bottom: 24rpx; }
.creation-empty { padding: 48rpx 24rpx; font-size:var(--zs-font-emphasis); line-height: 44rpx; color: var(--creation-muted); text-align: center; }
.creation-empty .studio-outline, .creation-empty .creation-primary { width: 100%; margin-top: 24rpx; }
.creation-page .empty { color: var(--creation-muted); font-size:var(--zs-font-body); line-height: 40rpx; padding: 32rpx 24rpx; }
