@import "./profile-session.wxss";
.profile-page{background:#fcfbf8}.profile-page .content{padding:15rpx 29rpx 0}.profile-card{display:flex;align-items:center;background:#fff;border-radius:22rpx;padding:25rpx 29rpx;height:176rpx;text-align:left;margin-bottom:23rpx}.profile-avatar,.guest-avatar{width:132rpx;height:132rpx;border-radius:50%;margin-right:27rpx;flex-shrink:0}.guest-avatar{background:#f5efe7;color:#b49d87;text-align:center;line-height:132rpx;font-size:80rpx}.profile-info{flex:1;min-width:0}.profile-name{display:block;font-size:35rpx;line-height:52rpx;font-weight:600}.profile-role{display:block;font-size:24rpx;color:#8892a6;line-height:36rpx;white-space:nowrap}.profile-link{color:#94501e;font-size:24rpx;margin-right:12rpx}.login-link{background:#9b4f1d;color:#fff;border-radius:14rpx;padding:10rpx 30rpx}.quick-card{display:flex;background:#fff;border-radius:20rpx;height:133rpx;margin-bottom:23rpx}.quick-card button{flex:1;display:flex;align-items:center;padding:15rpx 27rpx;gap:20rpx;text-align:left}.quick-card button+button{border-left:1rpx solid #f3efea}.quick-card image{width:53rpx;height:62rpx;flex-shrink:0}.quick-card .count{display:block;font-size:42rpx;line-height:44rpx;font-weight:600;color:#9a4c19}.quick-card .chevron{margin-left:auto}.brown{color:#9b4f1d}.section{border-radius:20rpx;padding:16rpx 20rpx;margin-bottom:23rpx;background:#fff}.section-title{font-family:inherit;font-size:29rpx;letter-spacing:0}.section-heading{padding-left:23rpx;height:45rpx;margin-bottom:10rpx}.section-heading::before{top:6rpx;height:32rpx;background:#9b4f1d}.text-link{font-size:23rpx}.academy-desc{display:block;font-size:24rpx;color:#8892a6;margin:6rpx 10rpx 20rpx}.course-card{display:flex;padding:10rpx;background:#fcfaf6;border-radius:16rpx;text-align:left;gap:27rpx;min-height:236rpx}.course-image{width:323rpx;height:210rpx;border-radius:12rpx;flex-shrink:0}.course-info{flex:1;min-width:0}.course-tag{display:block;font-size:21rpx;line-height:33rpx;color:#9b4f1d}.course-title{display:block;font-size:25rpx;line-height:38rpx;font-weight:600;white-space:nowrap}.course-status{display:block;font-size:20rpx;line-height:29rpx;color:#8892a6;margin-top:10rpx}.progress-track{height:8rpx;background:#e9e8e4;border-radius:8rpx;margin-top:3rpx;overflow:hidden}.progress-value{height:100%;background:#a16432}.continue{display:block;background:#a35927;color:#fff;width:150rpx;text-align:center;border-radius:10rpx;margin:24rpx 0 5rpx auto;font-size:23rpx;line-height:47rpx}.two-grid{display:flex;gap:12rpx}.two-grid .tile{display:flex;align-items:center;flex:1;padding:20rpx 26rpx;gap:28rpx;height:117rpx;background:#fbf9f5;border-radius:14rpx;font-size:25rpx}.two-grid image{width:62rpx;height:69rpx}.two-grid .chevron{position:static;margin-left:auto}.service-section{padding:0 24rpx}.service-row{display:flex;align-items:center;height:95rpx;text-align:left;gap:32rpx;padding:0 11rpx}.service-row+.service-row{border-top:1rpx solid #f2efeb}.service-row image{width:44rpx;height:50rpx}.service-row>text,.service-row>view:not(.chevron){flex:1}.small{display:block;font-size:21rpx}
.profile-page{font-family:ZSDashboard,sans-serif}
.section-title{font-size:30rpx}.course-title{font-size:27rpx}.course-status{font-size:23rpx;line-height:32rpx}

.profile-page{font-weight:400;line-height:40rpx;letter-spacing:0}.profile-page button{font-family:inherit}.section-title{font-weight:700;line-height:40rpx}
.profile-name,.quick-card .count{font-weight:700}.course-title{font-weight:500;line-height:40rpx}.course-status{line-height:34rpx}.service-row{font-size:27rpx;line-height:40rpx}
.profile-page.profile-nested{min-height:100vh;padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}
