.profile-page{background:#faf8f5;color:#191715}
.profile-page .content{padding:8rpx 16rpx 0}
.profile-page.profile-nested{min-height:100vh;padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}
.profile-page .section,.profile-card{background:var(--zs-card);border-radius:20rpx;margin-bottom:16rpx}
.profile-page .section{padding:0 24rpx}
.profile-card{display:flex;align-items:center;gap:18rpx;min-height:148rpx;padding:18rpx 24rpx;text-align:left}
.guest-card{width:100%}
.profile-avatar{width:108rpx;height:108rpx;border:4rpx solid #f3ede7;border-radius:50%;flex:none}
.profile-info{flex:1;min-width:0}
.profile-name-row,.profile-identity{display:flex;align-items:center;gap:10rpx;min-width:0}
.profile-name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:32rpx;line-height:42rpx;font-weight:700}
.profile-role-label{flex:none;padding:0 12rpx;border-radius:10rpx;background:#f5ece2;color:var(--zs-brand);font-size:24rpx;line-height:34rpx}
.profile-identity{flex-wrap:wrap;column-gap:14rpx;row-gap:0}
.profile-organization{color:var(--zs-text-3);font-size:24rpx;line-height:34rpx;overflow-wrap:anywhere}
.profile-page .text-link{gap:8rpx;font-size:26rpx;line-height:36rpx;white-space:nowrap}
.profile-page .identity-link{font-size:23rpx;min-height:40rpx}
.profile-page .profile-action{flex:none;min-height:84rpx;margin-left:auto}
.login-link{flex:none;margin-left:auto;padding:8rpx 20rpx;border-radius:12rpx;background:var(--zs-brand);color:var(--zs-card)}
.profile-page .section-heading{min-height:60rpx;padding-top:8rpx}
.profile-page .section-title{font-size:33rpx;font-weight:700;line-height:44rpx}
.profile-page .service-row{display:flex;align-items:center;gap:27rpx;width:100%;min-height:86rpx;padding:12rpx 0;text-align:left;font-size:30rpx;line-height:39rpx}
.profile-page .service-row+.service-row,.profile-page .course-resources{border-top:1rpx solid #eee9e3}
.profile-page .service-row image,.profile-page .tile image{width:50rpx;height:50rpx;flex:none}
.profile-page .row-body{flex:1;min-width:0}
.profile-page .announcement-section .service-row{min-height:112rpx}
.announcement-title,.announcement-preview{display:block}
.announcement-title{font-size:31rpx;font-weight:650}
.announcement-preview{color:var(--zs-text-3);font-size:25rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.message-count{min-width:48rpx;padding:1rpx 13rpx;border-radius:40rpx;background:#985523;color:#fff;text-align:center;font-size:24rpx;font-weight:600}
.profile-page .two-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;padding:6rpx 0 20rpx}
.profile-page .tile{display:flex;align-items:center;gap:19rpx;width:100%;min-height:84rpx;padding:10rpx 16rpx;background:#f7f4ef;border-radius:14rpx;font-size:28rpx;text-align:left}
.profile-page .tile text{min-width:0;overflow-wrap:anywhere}
.profile-page .tile .chevron{position:static;margin-left:auto}
.profile-page .course-card{display:flex;gap:16rpx;width:100%;min-height:170rpx;margin:8rpx 0 14rpx;border-radius:16rpx;background:#f7f4ef;text-align:left;overflow:hidden}
.course-image{width:37%;min-height:170rpx;height:auto;flex:none;border-radius:14rpx}
.course-info{display:flex;flex-direction:column;flex:1;min-width:0;padding:10rpx 12rpx 10rpx 0}
.course-title{font-size:27rpx;line-height:38rpx;font-weight:650}
.course-status{color:var(--zs-text-3);font-size:24rpx;line-height:34rpx}
.academy-section>.course-status{padding:10rpx 0 18rpx}
.progress-track{height:8rpx;background:#e4dfd9;border-radius:8rpx;margin:8rpx 0;overflow:hidden}
.progress-value{height:100%;background:#985523}
.continue{align-self:flex-end;margin-top:auto;padding:2rpx 20rpx;border-radius:9rpx;background:#985523;color:var(--zs-card);font-size:24rpx;line-height:43rpx}
