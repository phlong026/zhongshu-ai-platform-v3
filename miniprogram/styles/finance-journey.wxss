dding:26rpx;box-sizing:border-box}.journey-result{display:flex;flex-direction:column;align-items:center;gap:20rpx;padding:48rpx 28rpx;text-align:center;font-size:29rpx}.journey-result button{width:100%}.journey-result-amount{display:block;font-size:50rpx;line-height:72rpx;font-weight:600;color:var(--zs-brand);font-variant-numeric:tabular-nums}.journey-cash-summary{display:grid;grid-template-columns:1fr 1fr;gap:26rpx}.journey-cash-summary>view:last-child{grid-column:span 2;padding-top:22rpx;border-top:1rpx solid var(--zs-line)}.journey-cash-summary text{display:block;font-size:26rpx;line-height:40rpx;color:#786f66}.journey-cash-summary text+text{font-size:36rpx;font-weight:600;color:var(--zs-text);line-height:52rpx;font-variant-numeric:tabular-nums}.journey-cash-summary>view:last-child text+text{color:var(--zs-brand)}.journey-cash-filters{display:flex;align-items:center;gap:18rpx;padding:12rpx 0}.journey-cash-filters button{min-height:76rpx;padding:16rpx 20rpx;font-size:27rpx;color:#786f66}.journey-cash-filters .active{font-weight:600;color:var(--zs-brand)}.journey-cash-filters>text{margin-left:auto}.journey .book-transaction{min-height:150rpx}.journey .fin-search input{flex:1;min-width:0;font-size:28rpx}.journey-pending{padding:18rpx;background:#fbf1e7;border-radius:12rpx;font-size:27rpx;line-height:40rpx;margin-bottom:20rpx}.journey-contract .journey-row{margin:12rpx 0}.journey .book-info-row{font-size:28rpx}.journey .book-balance-label{padding:0;text-align:left;min-height:44rpx;font-size:26rpx}.journey .book-business-actions>button{min-height:72rpx;height:auto}.journey .book-tabs>.book-tab{min-height:80rpx;height:auto}

