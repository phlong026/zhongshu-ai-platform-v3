@import "./workbench.wxss";
@import "./sales.wxss";
.customer-tabs.customer-work-filters{display:flex;gap:12rpx;margin:18rpx 0 4rpx;overflow:visible}.customer-tabs.customer-work-filters .customer-day-button{position:relative;flex:1;min-width:0;min-height:58rpx;padding:0 10rpx;border:1rpx solid transparent;border-radius:999rpx;background:var(--sales-soft);color:#74695c;justify-content:center;gap:0;font-size:var(--zs-font-meta);line-height:36rpx}.customer-tabs.customer-work-filters .customer-day-button.active{background:var(--sales-brand);border-color:var(--sales-brand);color:#fff;font-weight:500}.customer-tabs.customer-work-filters .sales-stat-dot{position:absolute;top:9rpx;right:12rpx;margin:0}
.customer-search{margin:20rpx 0 0}.customer-tabs{margin-bottom:6rpx}.customer-tabs .customer-day-button{flex:1 1 auto;justify-content:center;gap:8rpx;padding:16rpx 12rpx}.customer-tabs .sales-stat-dot{margin:0 0 0 -2rpx;align-self:flex-start}.customer-list-row{display:flex;align-items:flex-start;gap:18rpx;width:100%;padding:28rpx 0;text-align:left;border-bottom:1rpx solid var(--sales-line)}.customer-list-row:last-of-type{border-bottom:0}.customer-initial{width:78rpx;height:78rpx;flex-shrink:0;border-radius:50%;background:#faf1e5;color:var(--sales-brand);text-align:center;line-height:78rpx;font-size:var(--zs-font-title)}.customer-row-copy{flex:1;min-width:0}.customer-row-heading{display:flex;align-items:center;gap:14rpx;flex-wrap:wrap;font-size:var(--zs-font-title);font-weight:500;line-height:44rpx}.customer-row-copy>.hint{display:block;margin-top:6rpx;overflow-wrap:anywhere}.customer-cue{margin-left:auto;font-size:var(--zs-font-caption);line-height:32rpx;font-weight:400;color:var(--sales-brand);padding:2rpx 12rpx;border-radius:8rpx}.customer-cue.customer-cue-muted{color:var(--sales-muted)}.customer-row-foot{display:flex;align-items:center;gap:12rpx;margin-top:10rpx}.customer-next{flex:1;min-width:0;color:var(--sales-brand);font-size:var(--zs-font-meta);line-height:36rpx;overflow-wrap:anywhere}.customer-call{width:64rpx;height:64rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--sales-brand);border-radius:50%;background:var(--zs-card)}.customer-call>image{width:32rpx;height:32rpx}.sales-page .customer-action{padding:10rpx 16rpx;min-width:116rpx;min-height:64rpx;font-size:var(--zs-font-meta)}.customer-list-end{text-align:center;padding:22rpx 0 6rpx}
