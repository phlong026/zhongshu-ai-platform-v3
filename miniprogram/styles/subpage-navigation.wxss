/* Existing warm paper, familiar back arrow, and a reachable workbench shortcut. */
.subpage-shell{position:fixed;top:0;left:0;right:0}
.subpage-nav{position:relative;display:flex;align-items:center;justify-content:center;min-height:44px}
.subpage-back{position:absolute;left:0;top:0;width:88rpx;min-width:44px;height:100%;min-height:44px;display:flex;align-items:center;justify-content:center;padding:0;margin:0;background:transparent}
.subpage-back::after{border:0}
.subpage-title{max-width:calc(100% - 370rpx);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.return-home{position:absolute;left:92rpx;top:0;width:88rpx;min-width:44px;height:100%;min-height:44px;display:flex;align-items:center;justify-content:center;padding:0;margin:0;background:transparent;color:var(--zs-brand);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:var(--zs-font-caption);line-height:32rpx;font-weight:400}.return-home::after{border:0}
