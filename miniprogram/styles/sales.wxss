@import "./business-tokens.wxss";
/* Shared sales surface: entry pages and their existing business flows. */
page{--sales-brand:var(--business-brand);--sales-paper:var(--business-paper);--sales-soft:#f7f3ed;--sales-ink:var(--zs-ink);--sales-muted:var(--business-muted);--sales-line:var(--zs-line);--sales-font:var(--zs-font-family)}
.sales-page.sales-page{background:var(--sales-paper);color:var(--sales-ink);font-family:var(--zs-font-family);font-size:var(--zs-font-emphasis);font-weight:400;line-height:42rpx;letter-spacing:0;min-height:100vh;padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}
.sales-page.sales-page button,.sales-page.sales-page input,.sales-page.sales-page textarea{font-family:var(--zs-font-family);letter-spacing:0}
.sales-page.sales-page .content{padding:20rpx var(--zs-space-page) 0}
.sales-page.sales-page .section{background:var(--zs-card);border:0;border-radius:var(--zs-radius);padding:var(--zs-space-card);margin:0 0 var(--zs-space-section);box-shadow:none}
.sales-page.sales-page .section-heading{min-height:52rpx;height:auto;padding:0;margin:0 0 18rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.sales-page.sales-page .section-title{font-family:var(--zs-font-family);font-size:var(--zs-font-title);font-weight:600;line-height:46rpx;letter-spacing:0}
.sales-page.sales-page .hint,.sales-page.sales-page .muted{font-size:var(--zs-font-meta);font-weight:400;line-height:36rpx;color:var(--sales-muted)}
.sales-page.sales-page .outline{display:inline-flex;align-items:center;justify-content:center;gap:8rpx;min-height:72rpx;height:auto;line-height:36rpx;padding:12rpx 22rpx;border:1rpx solid var(--sales-brand);border-radius:14rpx;font-size:var(--zs-font-body);font-weight:500;flex-shrink:0;background:var(--zs-card);color:var(--sales-brand)}
.sales-page.sales-page .text-link{display:inline-flex;align-items:center;gap:10rpx;min-height:60rpx;font-size:var(--zs-font-meta);font-weight:400;line-height:36rpx;color:var(--sales-brand);padding:0}
.sales-page.sales-page .chevron{border-color:var(--sales-brand)}
.sales-page .sales-search{display:flex;align-items:center;gap:18rpx;min-height:80rpx;background:var(--sales-paper);border:2rpx solid var(--zs-card);border-radius:42rpx;padding:12rpx 22rpx}
.sales-page .sales-search>image{width:32rpx;height:32rpx;flex-shrink:0}
.sales-page .sales-search>input{flex:1;min-width:0;height:48rpx;font-size:var(--zs-font-emphasis);line-height:42rpx}
.sales-page .sales-note{display:block;padding:4rpx 8rpx 22rpx;color:var(--sales-muted);font-size:var(--zs-font-meta);line-height:36rpx}

.sales-page .sales-footer-link{display:flex;align-items:center;justify-content:center;gap:14rpx;min-height:76rpx;width:100%;font-size:var(--zs-font-body);color:var(--sales-brand)}
.sales-page .sales-empty{padding:34rpx 12rpx;text-align:center;font-size:var(--zs-font-emphasis);line-height:44rpx;color:var(--sales-muted)}
.sales-page .sales-badge{font-size:var(--zs-font-caption);line-height:32rpx;font-weight:400;color:var(--sales-brand);background:#faf1e5;padding:2rpx 12rpx;border-radius:8rpx}
@media(max-width:360px){.sales-page.sales-page .content{padding-left:24rpx;padding-right:24rpx}.sales-page.sales-page .section{padding:20rpx}.sales-page.sales-page .section-title{font-size:var(--zs-font-title)}}
/* Filter buttons shared by the customer list and the home to-do board */
.customer-work-filters{display:flex;gap:16rpx;margin:20rpx 0}
.customer-day-button{flex:1;display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:16rpx;border-radius:12rpx;background:#f7f3ed;border:1rpx solid var(--zs-line);color:#74695c;font-size:var(--zs-font-meta);line-height:36rpx;min-height:72rpx}
/* Overdue dot shared by the home follow-up metric and the customer-list tab */
.sales-stat-dot{width:14rpx;height:14rpx;border-radius:50%;background:var(--zs-danger);margin:0 10rpx 0 auto}
.customer-day-button.active{background:#f7ebdc;border-color:var(--zs-brand);color:var(--zs-brand)}
