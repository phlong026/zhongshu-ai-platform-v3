/* Project ledger: amounts keep their own column; technical IDs stay in details. */
.book-page-title{display:block;font-size:36rpx;font-weight:600;line-height:50rpx;color:var(--zs-text);overflow-wrap:anywhere}
.book-list-heading,.book-detail-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:6rpx 4rpx 24rpx}
.book-search{margin-bottom:18rpx}.book-search input{flex:1;min-width:0;font-size:28rpx}
.book-tabs{display:flex;gap:8rpx;margin:0 0 20rpx;align-items:center}.book-tab{flex:1;padding:18rpx 8rpx;min-height:80rpx;line-height:40rpx;border-radius:14rpx;color:var(--zs-text-3);font-size:28rpx;white-space:nowrap}.book-tab.selected{color:var(--zs-brand);background:#f1e8dc;font-weight:600}
.book-list-item{display:flex;width:100%;align-items:center;gap:20rpx;padding:26rpx 24rpx;text-align:left;min-height:150rpx}.book-list-icon{width:64rpx;height:64rpx;flex-shrink:0;opacity:.85}.book-list-main{flex:1;min-width:0}.book-list-name{display:block;font-weight:600;font-size:32rpx;line-height:46rpx;overflow-wrap:anywhere}.book-list-meta{display:block;font-size:25rpx;line-height:36rpx;color:var(--zs-text-3);margin-top:8rpx}.book-list-state{flex-shrink:0;font-size:24rpx;color:var(--zs-text-3)}.book-chevron{width:13rpx;height:20rpx;opacity:.6;flex-shrink:0}
.book-overview{padding:30rpx 28rpx 0}.book-balance-label{font-size:27rpx;color:var(--zs-text-3);line-height:40rpx}.book-balance{display:flex;align-items:baseline;gap:10rpx;font-size:52rpx;font-weight:600;line-height:78rpx;letter-spacing:0;color:var(--zs-brand);font-variant-numeric:tabular-nums;white-space:nowrap;padding:2rpx 0 24rpx}.book-currency{font-size:24rpx;font-weight:400;margin-right:7rpx;opacity:.75}
.book-metrics{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:24rpx;border-top:1rpx solid var(--zs-line);padding:16rpx 0}.book-metric{min-width:0;padding:16rpx 0}.book-metric-label{display:block;color:var(--zs-text-3);font-size:25rpx;line-height:36rpx}.book-metric-value{display:block;margin-top:5rpx;color:var(--zs-text);font-size:33rpx;font-weight:600;line-height:46rpx;font-variant-numeric:tabular-nums;white-space:nowrap}.book-cost-total{display:flex;justify-content:space-between;gap:16rpx;padding:22rpx 0;border-top:1rpx solid var(--zs-line);font-size:26rpx;color:var(--zs-text-3);font-variant-numeric:tabular-nums}
.book-entry-actions{display:flex;gap:20rpx;margin:24rpx 0 10rpx}.book-entry-actions button{flex:1;min-width:0;min-height:84rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;padding:18rpx}.book-business-actions{display:flex;align-items:center;justify-content:space-between;gap:10rpx;margin:0 0 18rpx}.book-business-actions button{flex:1;min-width:0;min-height:78rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx}
.book-transactions{padding:10rpx 24rpx}.book-transactions .book-tabs{margin:0;border-bottom:1rpx solid var(--zs-line);padding:8rpx 0 16rpx}.book-transaction{display:flex;width:100%;align-items:center;gap:20rpx;min-height:132rpx;padding:25rpx 0;text-align:left;border-bottom:1rpx solid var(--zs-line)}.book-transaction:last-child{border-bottom:0}.book-transaction-main{flex:1;min-width:0}.book-transaction-name{display:block;font-size:29rpx;font-weight:500;line-height:42rpx;color:var(--zs-text);overflow-wrap:anywhere}.book-transaction-meta{display:block;font-size:23rpx;line-height:34rpx;color:var(--zs-text-3);margin-top:5rpx}.book-transaction-type{display:inline-block;margin-top:10rpx;padding:3rpx 10rpx;border-radius:6rpx;background:#f7f4ef;color:var(--zs-text-3);font-size:21rpx;line-height:30rpx}.book-transaction-right{display:flex;align-items:center;justify-content:flex-end;gap:12rpx;flex-shrink:0}.book-transaction-amount{display:block;flex-shrink:0;font-size:31rpx;font-weight:600;line-height:46rpx;font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--zs-text)}.book-transaction-amount.income{color:#577a61}.book-transaction-amount.expense{color:var(--zs-text)}
.book-empty{display:flex;flex-direction:column;align-items:center;gap:18rpx;padding:50rpx 24rpx;color:var(--zs-text-3);font-size:28rpx}.book-empty image{width:70rpx;height:70rpx;opacity:.65}
.book-detail-overlay{position:fixed;top:0;right:0;bottom:0;left:0;z-index:10001}.book-detail-mask{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(28,23,18,.4)}.book-detail-sheet{position:absolute;bottom:0;left:0;right:0;background:#fff;border-radius:32rpx 32rpx 0 0;padding:30rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box}.book-detail-scroll{max-height:68vh}.book-detail-amount{display:block;text-align:center;font-size:52rpx;line-height:80rpx;font-weight:600;font-variant-numeric:tabular-nums;margin-top:24rpx}.book-detail-name{display:block;text-align:center;font-size:30rpx;line-height:44rpx;margin:8rpx 0 30rpx}.book-info-row{display:flex;justify-content:space-between;align-items:baseline;gap:30rpx;padding:18rpx 0;font-size:27rpx;line-height:40rpx;border-bottom:1rpx solid var(--zs-line)}.book-info-row>text:first-child{color:var(--zs-text-3);flex-shrink:0}.book-info-row>text:last-child{text-align:right;overflow-wrap:anywhere;min-width:0}.book-detail-sheet .fin-outline{margin-top:24rpx}
.book-form .fin-input{min-width:0;overflow-wrap:anywhere}.book-form .fin-form-row{padding:20rpx 0}.book-form .fin-form-row>text{font-size:27rpx}.book-form .fin-input{font-size:28rpx}.book-form .fin-primary{margin-top:28rpx}
.fin-page .book-list-item{background:#fff;border:1rpx solid var(--zs-line);border-radius:20rpx}
.fin-page .book-tab{border-radius:14rpx}
.fin-page .book-transaction{border-radius:0;background:transparent}
.book-employee-row{padding:24rpx 0;border-bottom:1rpx solid var(--zs-line)}.book-employee-row:last-child{border-bottom:0}.book-employee-state{font-size:25rpx;color:var(--zs-brand)}.book-employee-total{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0 8rpx;font-size:28rpx;color:var(--zs-text-3)}.book-employee-total>text:last-child{font-size:34rpx;font-weight:600;color:var(--zs-text);font-variant-numeric:tabular-nums}.book-employee-row .fin-outline{margin-top:24rpx}

/* Compact actions and text tabs, shared by project and company books. */
.fin-page .book-entry-actions{gap:16rpx;margin:16rpx 0 0}
.fin-page .book-entry-actions>button{height:68rpx;min-height:68rpx;padding:12rpx 18rpx;border-radius:12rpx;font-size:27rpx;font-weight:500;line-height:40rpx}
.fin-page .book-business-actions{gap:0;margin:0 0 12rpx;min-height:60rpx}
.fin-page .book-business-actions>button{height:54rpx;min-height:54rpx;margin:3rpx 0;padding:8rpx 0;line-height:36rpx;font-size:24rpx;font-weight:400;color:#8b735e}
.fin-page .book-business-actions>button+button{border-left:1rpx solid #e8dfd4;border-radius:0}
.fin-page .book-tabs{gap:0;justify-content:space-between;margin:0 0 18rpx;padding:0;border-bottom:1rpx solid var(--zs-line)}
.fin-page .book-transactions>.book-tabs{margin:0;padding:0;border-bottom:1rpx solid var(--zs-line)}
.fin-page .book-tabs>.book-tab{display:flex;align-items:center;justify-content:center;position:relative;flex:1;min-width:0;min-height:72rpx;height:72rpx;padding:0;line-height:38rpx;font-size:27rpx;font-weight:400;color:#7f7871;background:transparent;border:0;border-radius:0}
.fin-page .book-tabs>.book-tab.selected{color:var(--zs-brand);background:transparent;border-radius:0;font-weight:600}
.book-tab-label{display:inline-block;padding:17rpx 0 13rpx;line-height:38rpx;border-bottom:4rpx solid transparent}
.book-tab.selected>.book-tab-label{border-bottom-color:var(--zs-brand)}
.fin-page .book-transactions{padding-top:0}

.fin-page .book-entry-actions.book-entry-actions-standalone{margin-bottom:18rpx}
