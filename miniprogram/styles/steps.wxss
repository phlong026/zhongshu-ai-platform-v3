.flow-steps{display:flex;align-items:flex-start;gap:10rpx;margin:24rpx 0}
.flow-step{flex:1;min-width:0;text-align:center;font-size:var(--zs-font-meta);color:var(--zs-text-3);display:flex;flex-direction:column;align-items:center;gap:12rpx}
.flow-step-index{width:44rpx;height:44rpx;border:2rpx solid #d7d2cb;border-radius:50%;color:var(--zs-text-3);display:flex;align-items:center;justify-content:center;font-size:var(--zs-font-meta)}
.flow-step.done{color:var(--zs-brand)}
.flow-step.done .flow-step-index{border-color:var(--zs-brand);background:var(--zs-brand);color:var(--zs-card)}
.flow-step.current{color:var(--zs-brand);font-weight:600}
.flow-step.current .flow-step-index{border-color:var(--zs-brand);color:var(--zs-brand);box-shadow:0 0 0 6rpx #f4e9d9}
