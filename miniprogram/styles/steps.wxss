.flow-steps{display:flex;align-items:flex-start;gap:10rpx;margin:24rpx 0}
.flow-step{flex:1;min-width:0;text-align:center;font-size:23rpx;color:#858a91;display:flex;flex-direction:column;align-items:center;gap:12rpx}
.flow-step-index{width:44rpx;height:44rpx;border:2rpx solid #d7d2cb;border-radius:50%;color:#858a91;display:flex;align-items:center;justify-content:center;font-size:24rpx}
.flow-step.done{color:#89512a}
.flow-step.done .flow-step-index{border-color:#89512a;background:#89512a;color:#fff}
.flow-step.current{color:#89512a;font-weight:600}
.flow-step.current .flow-step-index{border-color:#89512a;color:#89512a;box-shadow:0 0 0 6rpx #f4e9d9}
