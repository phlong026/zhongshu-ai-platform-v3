/* Unified interaction sizing and shared control states, imported by app.wxss.
   Every tappable control reaches the 88rpx (44px) minimum. Text links keep their layout position
   through compensating margins; list rows simply grow. Minimum heights use !important because several page stylesheets pin control heights. */
.text-link.text-link{min-height:88rpx!important;margin-top:-17rpx;margin-bottom:-17rpx;padding-top:0;padding-bottom:0;font-size:26rpx;line-height:40rpx}
.workflow-nav.workflow-nav{min-height:88rpx!important}
.project-utilities.project-utilities button{display:flex;align-items:center;min-height:88rpx!important;padding:0 8rpx;font-size:26rpx}
.commission-file.commission-file,.sales-profile-learning-action.sales-profile-learning-action{display:flex;align-items:center;min-height:88rpx!important}
.check-row.check-row,.workflow.workflow .check-row,.workflow .steps .link{min-height:88rpx!important}
.return-home.return-home{font-size:24rpx}
.input-row.input-row{min-height:88rpx!important}
.input-row .input.input,.input-row.input-row input,.input-row.input-row picker{min-height:80rpx}
button.link.link{min-height:88rpx!important}
