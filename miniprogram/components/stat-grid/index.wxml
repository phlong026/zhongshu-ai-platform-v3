<view class="stat-grid zs-theme"><button wx:for="{{items}}" wx:key="label" data-filter="{{item.filter}}" bindtap="tap" hover-class="pressed"><text class="stat-value">{{item.value}}<text wx:if="{{item.unit}}" class="stat-unit">{{item.unit}}</text></text><text class="stat-label">{{item.label}}</text></button></view>
