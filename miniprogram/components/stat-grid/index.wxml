<view class="stat-grid {{variant}} zs-theme"><block wx:for="{{items}}" wx:key="label"><button wx:if="{{interactive}}" data-filter="{{item.filter}}" bindtap="tap" hover-class="pressed"><text class="stat-value">{{item.value}}<text wx:if="{{item.unit}}" class="stat-unit">{{item.unit}}</text></text><text class="stat-label">{{item.label}}</text></button><view wx:else class="stat-item"><text class="stat-label">{{item.label}}</text><text class="stat-value">{{item.value}}<text wx:if="{{item.unit}}" class="stat-unit">{{item.unit}}</text></text></view></block></view>
