<template name="metric"><button class="metric {{size||''}}" data-key="{{item.key}}" bindtap="metric" disabled="{{!item.known}}" hover-class="metric-pressed" aria-label="{{item.label}} {{item.value}}{{item.unit}}，查看明细"><view class="metric-label"><text>{{item.label}}</text><image src="/assets/creation-chevron.png"/></view><view class="metric-number"><text class="metric-value {{item.value.length>8?'compact':''}}">{{item.value}}</text><text class="metric-unit">{{item.unit}}</text></view><text wx:if="{{item.caption}}" class="metric-caption">{{item.caption}}</text></button></template>
<view class="overview {{role}}">
 <view class="summary-card">
  <view class="overview-heading"><view wx:if="{{role==='owner'}}" class="tabs"><button class="{{tab==='operating'?'selected':''}}" data-tab="operating" bindtap="switchTab">经营</button><button class="{{tab==='ledger'?'selected':''}}" data-tab="ledger" bindtap="switchTab">账本</button></view><text wx:else class="heading-title">{{role==='business'?'业务概览':role==='engineering'?'工程概览':'本月收支'}}</text><picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view class="month">{{month}}<image src="/assets/creation-down.png"/></view></picker></view>
  <view class="overview-status {{(error||loading)?'active':''}}" aria-live="polite"><text>{{error||(loading?'正在更新业务数据…':'')}}</text><button wx:if="{{error}}" bindtap="load">重新加载</button></view>
  <block wx:if="{{role==='business'||role==='engineering'||(role==='owner'&&tab==='operating')}}">
   <view class="metric-grid {{role==='engineering'?'three':'two'}} primary-grid"><template wx:for="{{board.primary}}" wx:key="key" is="metric" data="{{item:item,size:'large'}}"/></view>
   <view class="metric-grid three secondary-grid"><template wx:for="{{board.secondary}}" wx:key="key" is="metric" data="{{item:item}}"/></view>
  </block>
  <block wx:if="{{role==='finance'||(role==='owner'&&tab==='ledger')}}">
   <view class="net-metric"><template is="metric" data="{{item:board.metrics.net,size:'hero'}}"/></view>
   <view class="metric-grid two cash-grid"><template is="metric" data="{{item:board.metrics.received,size:'cash'}}"/><template is="metric" data="{{item:board.metrics.paid,size:'cash'}}"/></view>
   <view class="refunds"><button data-key="clientRefund" bindtap="metric">客户退款 <text>{{board.metrics.clientRefund.value}}{{board.metrics.clientRefund.unit}}</text></button><text>·</text><button data-key="expenseRefund" bindtap="metric">支出退回 <text>{{board.metrics.expenseRefund.value}}{{board.metrics.expenseRefund.unit}}</text></button></view>
  </block>
  <view wx:if="{{role==='business'}}" class="follow-strip"><button data-key="followups" bindtap="metric"><image src="/assets/studio-clock.png"/><text>待跟进</text><text class="strip-number">{{board.metrics.followups.value}}</text><text>人</text><text wx:if="{{board.metrics.followups.overdueCount}}" class="overdue-pill">逾期 {{board.metrics.followups.overdueCount}}</text></button><button data-key="handover" bindtap="metric"><image src="/assets/contract.png"/><text>待移交</text><text class="strip-number">{{board.metrics.handover.value}}</text><text>项</text><image class="arrow" src="/assets/creation-chevron.png"/></button></view>
  <view wx:if="{{role==='engineering'}}" class="engineering-alerts"><button wx:for="{{board.alerts}}" wx:key="key" data-key="{{item.key}}" bindtap="metric" disabled="{{!item.known}}"><view class="alert-icon"><image src="{{index===0?'/assets/studio-clock.png':index===1?'/pages/engineering/assets/material.png':index===2?'/pages/engineering/assets/tasks.png':'/assets/contract.png'}}"/></view><view class="alert-copy"><text>{{item.label}}<image src="/assets/creation-chevron.png"/></text><text wx:if="{{item.caption}}" class="metric-caption">{{item.caption}}</text></view><view class="alert-value">{{item.value}}<text>{{item.unit}}</text></view></button></view>
 </view>
 <view wx:if="{{role==='finance'}}" class="summary-card unsettled"><view class="overview-heading"><text class="heading-title">未结事项</text><text class="current">当前</text></view><view class="metric-grid two balance-grid"><template wx:for="{{board.balances}}" wx:key="key" is="metric" data="{{item:item,size:'balance'}}"/></view><view class="metric-grid three secondary-grid"><template wx:for="{{board.secondary}}" wx:key="key" is="metric" data="{{item:item}}"/></view><view class="caption-footer">报销已含在待付余额</view></view>
 <block wx:if="{{role==='owner'}}"><view class="summary-card owner-engineering"><view class="overview-heading"><text class="heading-title">工程交付</text></view><view class="metric-grid three"><template wx:for="{{board.engineering}}" wx:key="key" is="metric" data="{{item:item}}"/></view></view><view class="summary-card"><view class="overview-heading"><text class="heading-title">资金关注</text></view><view class="funds-grid"><template wx:for="{{board.funds}}" wx:key="key" is="metric" data="{{item:item}}"/></view><button class="caption-footer" data-key="incomplete" bindtap="metric">账务资料待完善 {{board.metrics.incomplete.value}} 笔 ›</button></view></block>
</view>
