:host{display:block;flex-shrink:0}
.month-select-button{margin:0;padding:0;line-height:1.4;background:transparent;border:0;font-family:inherit}.month-select-button::after{border:0}
.month-trigger{height:84rpx;display:flex;align-items:center;padding:0 0 0 8rpx;box-sizing:border-box;min-width:218rpx}
.month-pill{display:flex;align-items:center;justify-content:center;gap:12rpx;height:64rpx;padding:0 17rpx;background:#fff;border:1rpx solid #e6ddd3;border-radius:18rpx;box-sizing:border-box;transition:background .15s,border-color .15s}
.month-trigger-pressed .month-pill,.month-pill-open{background:#f8f1e8;border-color:#bfa184}
.month-calendar{width:29rpx;height:29rpx;flex-shrink:0}
.month-value{color:#47372b;font-size:28rpx;line-height:36rpx;font-weight:600;letter-spacing:.4rpx;font-variant-numeric:tabular-nums}
.month-chevron{width:16rpx;height:22rpx;margin-left:3rpx;transform:rotate(90deg);opacity:.7;transition:transform .15s}
.month-chevron-open{transform:rotate(-90deg)}
.month-overlay{position:fixed;top:0;right:0;bottom:0;left:0;z-index:10000;color:#29231e;font-family:var(--zs-font-family,-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif)}
.month-mask{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(28,23,18,.4)}
.month-sheet{position:absolute;bottom:0;left:0;right:0;background:#fff;border-radius:32rpx 32rpx 0 0;padding:14rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box;box-shadow:0 -8rpx 40rpx rgba(53,35,20,.08);animation:month-appear .18s ease-out}
.month-handle{width:64rpx;height:7rpx;border-radius:8rpx;background:#e8e2db;margin:0 auto 10rpx}
.month-toolbar{height:84rpx;display:flex;align-items:center;justify-content:space-between}
.month-title{font-size:34rpx;font-weight:600;line-height:46rpx}
.month-cancel,.month-confirm{height:80rpx;min-width:84rpx;display:flex;align-items:center;font-size:30rpx}
.month-cancel{color:#8a8077;justify-content:flex-start}.month-confirm{color:#8b552c;font-weight:600;justify-content:flex-end}
.month-action-pressed{opacity:.55}
.month-year-row{height:90rpx;display:flex;align-items:center;justify-content:space-between;margin:3rpx 5rpx 22rpx}
.month-year{font-size:34rpx;font-weight:600;letter-spacing:1rpx;font-variant-numeric:tabular-nums}
.month-select-button.month-year-arrow{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:50%;background:#faf8f5}
.month-year-arrow[disabled]{opacity:.25}.month-year-arrow image{width:18rpx;height:26rpx}.month-arrow-left{transform:rotate(180deg)}
.month-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx}
.month-select-button.month-cell{position:relative;height:88rpx;border-radius:16rpx;background:#faf8f5;border:1rpx solid #eee8e0;display:flex;align-items:center;justify-content:center;color:#5a4b40;font-size:30rpx;font-weight:500;box-sizing:border-box}
.month-select-button.month-cell-selected{background:#8b552c;border-color:#8b552c;color:#fff;font-weight:600}
.month-cell icon{position:absolute;right:12rpx;bottom:9rpx;line-height:1}
.month-cell-pressed{opacity:.7}
.month-caption{display:block;margin-top:27rpx;text-align:center;font-size:24rpx;line-height:36rpx;color:#a1978e}
@keyframes month-appear{from{transform:translateY(30rpx);opacity:.6}to{transform:translateY(0);opacity:1}}
