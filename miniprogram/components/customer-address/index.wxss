:host{display:block}.address-row{display:flex;align-items:center;gap:16rpx;margin:8rpx 0}.address-label{width:150rpx;flex-shrink:0;color:#5f6672;font-size:var(--zs-font-body,28rpx);line-height:38rpx}.address-picker{flex:1;min-width:0}.address-control,.address-manual{box-sizing:border-box;border:1rpx solid #e8e8ed;border-radius:10rpx;background:#fffefc;min-height:64rpx;padding:8rpx 16rpx;font-size:var(--zs-font-body,28rpx);line-height:38rpx}.address-control{display:flex;align-items:center;gap:12rpx}.address-control>text:first-child{flex:1;overflow-wrap:anywhere}.address-placeholder{color:#8c929b}.address-arrow{color:#8c929b;flex-shrink:0}.address-manual{flex:1;min-width:0;height:64rpx}.address-note,.address-error{font-size:var(--zs-font-meta,26rpx);line-height:36rpx;color:#8b5b3a}.address-error{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.address-error button{flex-shrink:0;margin:0}
