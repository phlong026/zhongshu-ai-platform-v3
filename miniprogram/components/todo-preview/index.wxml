<view class="todo-preview {{appearance==='home'?'home-todos':''}} {{ownerMode?'owner-today-todos':''}}">
 <view wx:if="{{ownerMode}}" class="owner-todo-heading">
  <text>{{title}}</text>
  <view class="owner-todo-links">
   <button wx:if="{{decisionTotal}}" data-mode="decisions" bindtap="openOwnerList">待决策 {{decisionTotal}} ›</button>
   <button data-mode="all" bindtap="openOwnerList" aria-label="{{'查看全部 '+total+' 项待办'}}">查看全部<text class="home-todo-badge">{{total}}</text>›</button>
  </view>
 </view>
 <view wx:elif="{{appearance==='home'}}" class="home-todo-heading"><view><text>{{title}}</text><text wx:if="{{total}}" class="home-todo-badge">{{total}}</text></view><button wx:if="{{remaining}}" bindtap="toggle" aria-expanded="{{expanded}}" aria-label="{{expanded?'收起待办':'查看全部'+total+'项待办'}}">{{expanded?'收起':'另 '+remaining+' 项'}}<image src="/assets/creation-chevron.png"/></button></view>
 <view class="todo-rows"><button wx:for="{{visibleRows}}" wx:key="key" class="todo-preview-row" data-index="{{item.index}}" disabled="{{item.disabled}}" bindtap="activate" hover-class="todo-preview-pressed"><view wx:if="{{appearance==='home'&&!ownerMode}}" class="todo-initial">{{item.initial}}</view><view class="todo-preview-copy"><text class="todo-preview-title">{{item.title}}</text><view wx:if="{{item.meta||item.amount}}" class="todo-preview-detail"><text class="todo-preview-meta">{{item.meta}}</text><text wx:if="{{item.amount}}" class="todo-preview-amount">{{item.amount}}</text></view></view><text wx:if="{{appearance==='home'&&!item.disabled}}" class="todo-action {{index===0?'primary-action':''}}">{{item.action}}</text><image wx:if="{{!ownerMode&&!item.disabled&&(appearance!=='home'||index!==0)}}" class="todo-preview-arrow" src="/assets/creation-chevron-muted.png" mode="aspectFit"/></button><view wx:if="{{appearance==='home'&&!total}}" class="home-todo-empty">当前暂无需本人办理事项</view></view>
 <button wx:if="{{remaining&&appearance!=='home'}}" class="todo-preview-toggle" bindtap="toggle" aria-expanded="{{expanded}}" aria-label="{{expanded?'收起待办，只显示前3项':'查看全部'+total+'项待办'}}" hover-class="todo-preview-pressed"><text>{{expanded?'收起':'查看全部'}}</text><text class="todo-preview-count">{{expanded?'共 '+total+' 项':'另 '+remaining+' 项'}}</text><view class="todo-preview-chevron {{expanded?'is-expanded':''}}"/></button>
</view>
