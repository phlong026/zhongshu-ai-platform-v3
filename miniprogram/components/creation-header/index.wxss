@import "../../styles/component-tokens.wxss";
@import "../../styles/subpage-navigation.wxss";
.creation-header { background: var(--zs-bg); position: fixed; top: 0; left: 0; right: 0; z-index: 100; }
.creation-nav { height: 88rpx; min-height: 44px; position: relative; display: flex; align-items: center; justify-content: center; }
.nav-title { font-family:var(--zs-font-family); font-size:var(--zs-font-title); line-height: 40rpx; font-weight: 600; color: var(--zs-ink); max-width: calc(100% - 240rpx); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.back { position: absolute; left: 12rpx; top: 0; width: 88rpx; min-width: 44px; height: 100%; min-height: 44px; display: flex; align-items: center; justify-content: center; padding: 0; margin: 0; background: transparent; }
.back::after { border: 0; }
.back image { width: 25rpx; height: 36rpx; }
.pressed { opacity: .65; }
