@import "../../styles/component-tokens.wxss";
.asset-recharge {
  position: relative;
  z-index: 1;
  margin: -8rpx 0;
  padding: 0 24rpx;
  min-height: 60rpx;
  line-height: 60rpx;
  border-radius: 14rpx;
  background: #fff4e4;
  color: #75451f;
  font-size: var(--zs-font-body);
  font-weight: 600;
}
.asset-recharge::after { border: 0; }
.asset-card {
  position: relative;
  margin: 0 0 16rpx;
  border-radius: 20rpx;
  padding: 18rpx 32rpx 21rpx;
  overflow: hidden;
  background: linear-gradient(125deg, #965424, #753f17 70%, #703b17);
  color: #fffaf3;
}
.asset-card::after {
  content: "";
  position: absolute;
  right: -64rpx;
  top: -72rpx;
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
  background: rgba(255, 250, 243, 0.08);
}
.asset-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--zs-font-meta);
  color: rgba(255, 250, 243, 0.82);
}
.asset-status {
  margin-left: auto;
  min-height: 32rpx;
  color: rgba(255, 250, 243, 0.66);
}
.asset-metrics {
  display: flex;
  align-items: stretch;
  margin-top: 8rpx;
}
.asset-metric {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}
.asset-divider {
  width: 1rpx;
  margin: 2rpx 34rpx;
  background: rgba(255, 250, 243, 0.18);
}
.asset-num {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 56rpx;
}
.asset-unit {
  margin-top: 2rpx;
  font-size: var(--zs-font-meta);
  font-weight: 400;
  color: rgba(255, 250, 243, 0.85);
}
.asset-feedback {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: var(--zs-font-caption);
  color: rgba(255, 250, 243, 0.76);
}
.asset-warning {
  color: #ffe1a3;
}
.asset-retry {
  flex: none;
  min-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: var(--zs-font-caption);
  color: #fffaf3;
  border: 1rpx solid rgba(255, 250, 243, 0.42);
  background: rgba(255, 250, 243, 0.08);
}
