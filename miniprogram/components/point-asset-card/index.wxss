@import "../../styles/component-tokens.wxss";
/* 公司积分卡：延续「我的」页品牌棕渐变，不承载充值入口。 */
.asset-card {
  position: relative;
  margin-top: var(--zs-space-section);
  border-radius: 24rpx;
  padding: 30rpx 30rpx 28rpx;
  overflow: hidden;
  background: linear-gradient(128deg, var(--zs-brand) 0%, var(--zs-brand-press) 62%, #6a3d1c 100%);
  color: #fffaf3;
  box-shadow: 0 14rpx 36rpx rgba(117, 69, 31, 0.24);
}
.asset-card::after {
  content: "";
  position: absolute;
  right: -64rpx;
  top: -72rpx;
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
  background: rgba(255, 250, 243, 0.08);
}
.asset-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--zs-font-caption);
  color: rgba(255, 250, 243, 0.82);
}
.asset-status {
  margin-left: auto;
  min-height: 32rpx;
  color: rgba(255, 250, 243, 0.66);
}
.asset-label {
  font-size: var(--zs-font-caption);
}
.asset-metrics {
  display: flex;
  align-items: stretch;
  margin-top: 16rpx;
}
.asset-metric {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}
.asset-divider {
  width: 1rpx;
  margin: 4rpx 28rpx;
  background: rgba(255, 250, 243, 0.18);
}
.asset-num {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 56rpx;
}
.asset-unit {
  margin-top: 2rpx;
  font-size: var(--zs-font-meta);
  font-weight: 400;
  color: rgba(255, 250, 243, 0.85);
}
.asset-sub {
  margin-top: 8rpx;
  font-size: var(--zs-font-caption);
  color: rgba(255, 250, 243, 0.66);
}
.asset-feedback {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: var(--zs-font-caption);
  color: rgba(255, 250, 243, 0.76);
}
.asset-warning {
  color: #ffe1a3;
}
.asset-retry {
  flex: none;
  min-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: var(--zs-font-caption);
  color: #fffaf3;
  border: 1rpx solid rgba(255, 250, 243, 0.42);
  background: rgba(255, 250, 243, 0.08);
}
