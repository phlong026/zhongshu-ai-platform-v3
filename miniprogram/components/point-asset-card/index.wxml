<view wx:if="{{visible}}" class="asset-card">
  <view class="asset-head"><text class="asset-label">公司积分</text><text class="asset-status" bindtap="retry">{{refreshing?'更新中':errorMessage?'更新失败，重试':''}}</text><button wx:if="{{hasPost}}" class="asset-recharge" bindtap="openRecharge">充值</button></view>
  <view class="asset-metrics">
    <view class="asset-metric">
      <text class="asset-num">{{balanceText}}</text>
      <text class="asset-unit">{{balanceLabel}}</text>
    </view>
    <view class="asset-divider"/>
    <view class="asset-metric">
      <text class="asset-num">{{usedText}}</text>
      <text class="asset-unit">本人本月使用</text>
    </view>
  </view>
  <button wx:if="{{state==='ready' && purchaseAvailable}}" class="asset-retry" bindtap="openPackages">模拟积分套餐</button>
  <view wx:if="{{state==='suspended'}}" class="asset-feedback asset-warning">
    <text>公司积分账户已暂停，请联系管理员</text><button class="asset-retry" bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{state==='empty'}}" class="asset-feedback">
    <text>{{emptyMessage}}</text><button class="asset-retry" bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{state==='error'}}" class="asset-feedback">
    <text>{{errorMessage}}</text><button class="asset-retry" bindtap="retry">重试</button>
  </view>
</view>
