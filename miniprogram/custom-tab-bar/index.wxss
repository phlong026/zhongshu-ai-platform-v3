@import "../styles/component-tokens.wxss";
.tabbar { position: fixed; z-index: 50; bottom: 0; left: 0; width: 100%; display: flex; padding: 14rpx 0 max(9rpx, calc(env(safe-area-inset-bottom) - 14rpx)); border-top: 1rpx solid #e4e2de; background: rgba(255,255,255,.98); box-sizing: border-box; }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 0; margin: 0; font-size:var(--zs-font-caption); color: #7d8085; line-height: 24rpx; background: transparent; border-radius: 0; }
.tab::after { border: 0; }
.tab.active { color: var(--zs-brand-press); }
.tab-icon { width: 40rpx; height: 40rpx; margin-bottom: 4rpx; }
.tab-icon.engineering { width: 49rpx; }
.tab-icon.muted-icon { filter: grayscale(1); opacity: .55; }
.pressed { opacity: .7; }
