@import "./styles/tokens.wxss";
@import "./styles/controls.wxss";
@import "./styles/unified.wxss";
page { background: var(--zs-bg); color: var(--zs-ink); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size:var(--zs-font-body); }
view, text, button, input, textarea, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; border-radius: 0; font-size: inherit; line-height: inherit; background: transparent; color: inherit; }
button::after { border: 0; }
button[disabled] { color: #aaa; }
.page { min-height: 100vh; padding-bottom: calc(108rpx + env(safe-area-inset-bottom)); }
.content { padding: 0 26rpx; }
.section { background: rgba(255,255,255,.9); border-radius: 25rpx; padding: 18rpx; margin-bottom: 16rpx; }
.section-heading { height: 54rpx; display: flex; align-items: center; justify-content: space-between; padding-left: 25rpx; position: relative; }
.section-heading::before { content: ""; width: 6rpx; height: 34rpx; border-radius: 4rpx; background: #76471e; position: absolute; left: 0; top: 10rpx; }
.section-title { font-family:inherit; font-weight: 700; font-size:var(--zs-font-heading); line-height: 1.2; letter-spacing: 1rpx; }
.section-heading.compact .section-title { font-size:var(--zs-font-emphasis); }
.plus { font-size:var(--zs-font-title); font-weight: 300; margin-right: 7rpx; vertical-align: -1rpx; }
.text-link { display: flex; align-items: center; gap: 12rpx; font-size:var(--zs-font-meta); color: var(--zs-brand-press); }
.chevron { width: 10rpx; height: 10rpx; border-right: 1.6rpx solid var(--zs-brand-press); border-top: 1.6rpx solid var(--zs-brand-press); transform: rotate(45deg); flex-shrink: 0; margin-right: 5rpx; }
.muted { color: var(--zs-text-3); }
.icon { display: block; width: 50rpx; height: 50rpx; flex-shrink: 0; }
.tile { position: relative; background: var(--zs-bg); border-radius: 20rpx; text-align: left; }
.tile .chevron { position: absolute; right: 26rpx; top: 50%; }
.pressed { opacity: .72; }
.empty { padding: 35rpx 20rpx; text-align: center; color: var(--zs-text-3); }

/* Page actions follow their content so long forms remain fully readable. */
.page-actions{display:flex;align-items:center;gap:16rpx;margin:24rpx 0 0;padding:16rpx 0;background:transparent;border-top:1rpx solid #eee9e1;box-sizing:border-box}
.build>.page-actions,.growth-page>.page-actions{margin-left:28rpx;margin-right:28rpx}
/* Native button ::after must stay inside its own button, including when disabled. */
.page-actions.page-actions>button{flex:1;min-width:0;width:0;height:88rpx;min-height:88rpx;margin:0;position:relative;display:flex;align-items:center;justify-content:center;padding:0 16rpx;line-height:38rpx;box-sizing:border-box}
.page-actions.studio-bottom-pair{flex-wrap:nowrap}
.page-actions.studio-bottom-pair>button{min-width:0}
.workflow.workflow,.build.build,.admin.admin,.account.account,.video-page.video-page,.studio-page.studio-page,.growth-page.growth-page,.record-page.record-page,.explore-page.explore-page{padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}
.action-note{display:block;padding:12rpx 28rpx;color:var(--zs-text-3);text-align:center;font-size:var(--zs-font-meta);line-height:34rpx}
.sheet.sheet,.creation-sheet.creation-sheet{padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}
.sheet-save,.sheet>.solid,.creation-sheet-button,.sheet-confirm{position:sticky;bottom:0;z-index:2;min-height:88rpx;flex-shrink:0}

.workbench-denied{padding:32rpx 24rpx}.workbench-denied>text{display:block;margin-bottom:24rpx;line-height:44rpx}.workbench-denied>text+text{font-size:var(--zs-font-body);color:var(--zs-text-3)}.workbench-denied>button{width:100%;margin:24rpx 0 0;min-height:88rpx;line-height:88rpx}
