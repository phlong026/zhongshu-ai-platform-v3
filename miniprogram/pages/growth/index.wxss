@import "../../styles/sales.wxss";
.growth-page{padding-bottom:calc(176rpx + env(safe-area-inset-bottom))}.growth-page .section{margin:24rpx 0;padding:28rpx;background:#fff;border-radius:20rpx}.growth-page .row{display:block;margin:18rpx 0;line-height:1.7}.record{display:flex;flex-direction:column;align-items:flex-start;text-align:left;padding:22rpx 8rpx;border-bottom:1rpx solid #ece6dc;line-height:1.7;background:transparent}.record text{display:block}.record text+text,.hint{color:#7b7066;font-size:24rpx}.input{box-sizing:border-box;display:block;width:100%;border:1rpx solid #ded6ca;border-radius:12rpx;margin:20rpx 0;padding:20rpx;background:#fff;min-height:84rpx}.note{height:170rpx}.cover{display:block;width:100%;height:300rpx}.error{display:block;color:#b3402a;padding:20rpx 0}

.growth-page.growth-page{background:#faf8f4;color:#141312;font-family:var(--sales-font);font-size:28rpx;line-height:42rpx}.growth-page .section{padding:22rpx;border-radius:22rpx;margin:24rpx 0}.growth-page .section-title{font-family:inherit;font-size:32rpx;font-weight:600;line-height:46rpx;letter-spacing:0}.growth-page .row{font-size:28rpx;line-height:42rpx}.growth-page .input{font-family:inherit;font-size:28rpx;line-height:42rpx;border-color:#eee8df;border-radius:14rpx;background:#faf8f4}.growth-page .hint,.growth-page .record text+text{font-size:24rpx;line-height:36rpx;color:#9a9187}.growth-page .primary{font-family:inherit;font-size:28rpx;font-weight:500;line-height:42rpx;background:#89512a;color:#fffaf3;border-radius:14rpx;min-height:88rpx;padding:12rpx 24rpx}.growth-page button{font-family:inherit}

