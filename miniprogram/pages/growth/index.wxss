.growth-page{padding-bottom:calc(176rpx + env(safe-area-inset-bottom))}.growth-page .section{margin:24rpx 0;padding:28rpx;background:#fff;border-radius:20rpx}.growth-page .row{display:block;margin:18rpx 0;line-height:1.7}.record{display:flex;flex-direction:column;align-items:flex-start;text-align:left;padding:22rpx 8rpx;border-bottom:1rpx solid #ece6dc;line-height:1.7;background:transparent}.record text{display:block}.record text+text,.hint{color:#7b7066;font-size:24rpx}.input{box-sizing:border-box;display:block;width:100%;border:1rpx solid #ded6ca;border-radius:12rpx;margin:20rpx 0;padding:20rpx;background:#fff;min-height:84rpx}.note{height:170rpx}.cover{display:block;width:100%;height:300rpx}.error{display:block;color:#a83125;padding:20rpx 0}
