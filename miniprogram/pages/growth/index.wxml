<view class="page growth-page"><business-header title="{{title}}"/><demo-guide id="demo-guide"/><view class="content">
<view class="section"><text class="hint">本机模拟流程 · 内容发布不发送到外部平台，客资为测试登记。</text></view>
<view wx:if="{{missing}}" class="section"><text>此记录不存在、已交接或当前岗位无权查看。</text><button bindtap="home">返回业务工作台</button></view>
<block wx:elif="{{view==='home'}}">
<view class="section"><view class="section-heading"><text class="section-title">{{canManage?'团队内容与发布':'本人内容与发布'}}</text></view><button wx:for="{{contents}}" wx:key="id" class="record" data-view="content" data-id="{{item.id}}" bindtap="open"><text>{{item.pack.title}}</text><text>{{item.status}} · V{{item.versions.length}}</text></button><text wx:if="{{!contents.length}}" class="hint">暂无已提交作品。请从业务工作台开始内容创作。</text></view>
<view class="section"><view class="section-heading"><text class="section-title">{{canManage?'团队客资与跟进':'本人客资与跟进'}}</text></view><button wx:for="{{leads}}" wx:key="id" class="record" data-view="lead" data-id="{{item.id}}" bindtap="open"><text>{{item.name}} · {{item.status}}</text><text>{{item.source}} · {{item.need}}</text></button><text wx:if="{{!leads.length}}" class="hint">暂无本人客资；发布作品后可通过「登记客资」直接建立本人客户。</text></view>
</block>
<view wx:elif="{{view==='content' && content}}" class="section"><text class="section-title">{{content.pack.title}}</text><text class="row">状态：{{content.status}} · V{{content.versions.length}}</text><image class="cover" src="{{content.pack.cover}}" mode="aspectFit"/><text class="row">{{content.pack.publishText}}</text><text class="row">目标账号：{{content.pack.accountId}}</text><text class="row">原作者：{{content.authorId}}</text><text wx:if="{{content.review}}" class="row">历史审核记录：{{content.review.note}}</text><text wx:if="{{content.publishedUrl}}" class="row">发布链接：{{content.publishedUrl}}</text></view>
<view wx:elif="{{view==='capture'}}" class="section"><text class="section-title">来源与有效咨询</text><picker range="{{publishedNames}}" data-key="contentId" value="{{publishedIndex||0}}" bindchange="pick"><view class="input">{{publishedNames[publishedIndex||0]}}</view></picker><input class="input" data-key="name" value="{{form.name}}" placeholder="客户称呼" bindinput="input"/><input class="input" data-key="phone" value="{{form.phone}}" placeholder="测试手机号" type="number" bindinput="input"/><input class="input" data-key="source" value="{{form.source}}" placeholder="非内容来源：来访、转介绍等" bindinput="input"/><textarea class="input note" data-key="need" value="{{form.need}}" placeholder="咨询需求，不能用曝光量代替线索" bindinput="input"/><text class="hint">客资直接登记为本人客户，自动保留作品与发布来源；同手机号老客直接关联原档案，团队分工与无效客资处理在线下完成。</text></view>
<view wx:elif="{{view==='lead' && lead}}" class="section"><text class="section-title">{{lead.name}} · {{lead.status}}</text><text class="row">{{lead.phone}} · {{lead.source}}</text><text class="row">{{lead.need}}</text><text class="row">原发布：{{lead.publicationId||'真实非内容来源'}}</text><picker class="lead-assignee" wx:if="{{canManage && lead.status!=='已转客户'}}" range="{{staffNames}}" data-key="staffId" bindchange="pick"><view class="input">{{staffNames[staffIndex]||'选择业务员'}}</view></picker><view wx:for="{{lead.follows}}" wx:key="at" class="record"><text>{{item.by}} · {{item.note}}</text></view><textarea wx:if="{{lead.status!=='已转客户'}}" class="input note" data-key="note" value="{{form.note}}" placeholder="跟进内容／退回原因" bindinput="input"/><view wx:if="{{existingCustomer && lead.status!=='已转客户'}}" class="record"><text>已有客户：{{existingCustomer.name}} · 原负责人{{existingCustomer.owner}}</text><text class="hint">关联后保留本次来源，原客户负责人不变，不重复新增客户。</text><button class="lead-link-existing" data-action="link-existing" bindtap="perform">关联已有客户并保留咨询来源</button></view><button wx:if="{{requestExistingLink && canHandleLead}}" class="lead-request-link" data-action="request-link" bindtap="perform">提交负责人关联已有客户</button><text wx:if="{{lead.status==='待负责人关联'}}" class="hint">已交负责人核对原客户，原线索与咨询来源保留。</text><button class="lead-convert" wx:if="{{canHandleLead && lead.status==='跟进中'}}" data-action="convert" bindtap="perform">识别有效需求并转客户</button><button wx:if="{{!canManage && lead.status!=='已转客户'}}" data-action="return" bindtap="perform">退回负责人重新分配</button><button wx:if="{{lead.status==='已转客户'}}" bindtap="goCustomer">查看关联客户与办理进度</button></view>
<text wx:if="{{error}}" class="error" role="alert">{{error}}</text></view>
<view class="page-actions growth-actions"><button wx:if="{{view==='home' && canCapture}}" class="primary" data-view="capture" bindtap="open">＋登记客资</button><button wx:elif="{{primary && !missing}}" class="primary" bindtap="perform">{{primary}}</button><button wx:else class="primary" bindtap="home">返回业务工作台</button></view></view>

