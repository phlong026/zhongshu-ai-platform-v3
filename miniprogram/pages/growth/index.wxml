<view class="page growth-page"><business-header title="{{title}}"/><demo-guide id="demo-guide"/><view class="content">
<view class="section"><text class="hint">本机模拟流程 · 内容发布不发送到外部平台，线索为测试登记。</text></view>
<view wx:if="{{missing}}" class="section"><text>此记录不存在、已交接或当前岗位无权查看。</text><button bindtap="home">返回业务工作台</button></view>
<block wx:elif="{{view==='home'}}">
<view class="section"><view class="section-heading"><text class="section-title">{{canManage?'团队内容与审核':'本人内容与发布'}}</text></view><button wx:for="{{contents}}" wx:key="id" class="record" data-view="content" data-id="{{item.id}}" bindtap="open"><text>{{item.pack.title}}</text><text>{{item.status}} · V{{item.versions.length}}</text></button><text wx:if="{{!contents.length}}" class="hint">暂无已提交作品。请从业务工作台开始内容创作。</text></view>
<view class="section"><view class="section-heading"><text class="section-title">{{canManage?'团队线索与分配':'本人线索与跟进'}}</text></view><button wx:for="{{leads}}" wx:key="id" class="record" data-view="lead" data-id="{{item.id}}" bindtap="open"><text>{{item.name}} · {{item.status}}</text><text>{{item.source}} · {{item.need}}</text></button><text wx:if="{{!leads.length}}" class="hint">暂无本人可办线索；共享线索由负责人分配后接收。</text></view>
</block>
<view wx:elif="{{view==='content' && content}}" class="section"><text class="section-title">{{content.pack.title}}</text><text class="row">状态：{{content.status}} · V{{content.versions.length}}</text><image class="cover" src="{{content.pack.cover}}" mode="aspectFit"/><text class="row">{{content.pack.publishText}}</text><text class="row">目标账号：{{content.pack.accountId}}</text><text class="row">原作者：{{content.authorId}}</text><text class="row">审核意见：{{content.review.note||'尚未审核'}}</text><block wx:if="{{canReview && content.status==='待审核'}}"><picker range="{{['通过','退回修改']}}" data-key="reviewResult" bindchange="pick"><view class="input">{{form.reviewResult||'通过'}}</view></picker><textarea class="input note" data-key="note" value="{{form.note}}" placeholder="审核意见／具体修改项" bindinput="input"/></block><button wx:if="{{canEditContent && content.status!=='演示已发布'}}" bindtap="editContent">回原作品修改发布包</button></view>
<view wx:elif="{{view==='capture'}}" class="section"><text class="section-title">来源与有效咨询</text><picker range="{{publishedNames}}" data-key="contentId" value="{{publishedIndex||0}}" bindchange="pick"><view class="input">{{publishedNames[publishedIndex||0]}}</view></picker><input class="input" data-key="name" value="{{form.name}}" placeholder="客户称呼" bindinput="input"/><input class="input" data-key="phone" value="{{form.phone}}" placeholder="测试手机号" type="number" bindinput="input"/><input class="input" data-key="source" value="{{form.source}}" placeholder="非内容来源：来访、转介绍等" bindinput="input"/><textarea class="input note" data-key="need" value="{{form.need}}" placeholder="咨询需求，不能用曝光量代替线索" bindinput="input"/><text class="hint">内容咨询进入团队待分配池，保留作品和发布来源；直接来访归当前业务员待接收。</text></view>
<view wx:elif="{{view==='lead' && lead}}" class="section"><text class="section-title">{{lead.name}} · {{lead.status}}</text><text class="row">{{lead.phone}} · {{lead.source}}</text><text class="row">{{lead.need}}</text><text class="row">原发布：{{lead.publicationId||'真实非内容来源'}}</text><picker wx:if="{{canManage && lead.status!=='已转客户'}}" range="{{staffNames}}" data-key="staffId" bindchange="pick"><view class="input">{{staffNames[staffIndex]||'选择业务员'}}</view></picker><view wx:for="{{lead.follows}}" wx:key="at" class="record"><text>{{item.by}} · {{item.note}}</text></view><textarea wx:if="{{lead.status!=='已转客户'}}" class="input note" data-key="note" value="{{form.note}}" placeholder="跟进内容／退回原因" bindinput="input"/><button class="lead-convert" wx:if="{{canHandleLead && lead.status==='跟进中'}}" data-action="convert" bindtap="perform">识别有效需求并转客户</button><button wx:if="{{!canManage && lead.status!=='已转客户'}}" data-action="return" bindtap="perform">退回负责人重新分配</button><button wx:if="{{lead.status==='已转客户'}}" bindtap="goCustomer">查看关联客户与办理进度</button></view>
<text wx:if="{{error}}" class="error" role="alert">{{error}}</text></view>
<view class="page-actions growth-actions"><button wx:if="{{view==='home' && canCapture}}" class="primary" data-view="capture" bindtap="open">＋登记来源线索</button><button wx:elif="{{primary && !missing}}" class="primary" bindtap="perform">{{primary}}</button><button wx:else class="primary" bindtap="home">返回业务工作台</button></view></view>
