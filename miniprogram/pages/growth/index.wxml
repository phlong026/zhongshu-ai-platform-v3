<view class="page growth-page"><business-header id="subpage-header" title="{{title}}"/><view class="content">

<view wx:if="{{missing}}" class="section"><text>此记录不存在、已交接或当前岗位无权查看。</text><button bindtap="home">返回业务工作台</button></view>
<block wx:elif="{{view==='home'}}">
<view wx:if="{{growthStats}}" class="section">
  <view class="section-heading"><text class="section-title">内容获客总览</text></view>
  <text class="row">门店已发布 {{growthStats.publishedCount}} 条 · 有效咨询 {{growthStats.consultations}} 次</text>
  <text class="row">关联客户 {{growthStats.linkedCustomers}} 人，其中已签约 {{growthStats.signedCustomers}} 人 · 有净实收 {{growthStats.netPaidCustomers}} 人</text>
  <text class="hint">咨询和客户按当前岗位统计。签约和净实收按关联客户当前有效合同统计，净实收已扣除核实退款。总览按客户去重。</text>
</view>
<view wx:elif="{{publicationError}}" class="section" role="alert"><text>{{publicationError}}</text><button size="mini" bindtap="syncGrowth">重新加载</button></view>
<view wx:if="{{published.length}}" class="section">
  <view class="section-heading"><text class="section-title">按发布查看</text></view>
  <navigator wx:for="{{published}}" wx:key="publicationId" class="record" url="/pages/studio/index?view=detail&record={{item.publicationId}}">
    <text>{{item.title}}</text><text>有效咨询 {{item.consultations}} 次 · 关联客户 {{item.linkedCustomers}} 人</text>
    <text>关联客户中已签约 {{item.signedCustomers}} 人 · 有净实收 {{item.netPaidCustomers}} 人</text>
  </navigator>
  <text class="hint">这里显示关联客户的当前状态，不代表本作品带来的签约或收款。同一客户可出现在多条发布中。</text>
</view>
<view class="section"><view class="section-heading"><text class="section-title">{{canManage?'团队内容与发布':'本人内容与发布'}}</text></view><button wx:for="{{contents}}" wx:key="id" class="record" data-view="content" data-id="{{item.id}}" bindtap="open"><text>{{item.pack.title}}</text><text>{{item.status}} · V{{item.versions.length}}</text></button><text wx:if="{{!contents.length}}" class="hint">暂无已提交作品</text></view>
<view class="section"><view class="section-heading"><text class="section-title">{{canManage?'团队客资与跟进':'本人客资与跟进'}}</text></view><view wx:if="{{canManage && (pendingLeads.length||pendingError)}}" class="section"><view class="section-heading"><text class="section-title">待关联客资</text></view><button wx:for="{{pendingLeads}}" wx:key="leadId" class="record"><text>{{item.name}} · {{item.phone}}</text><view style="display:flex;gap:12rpx;margin-top:8rpx"><button size="mini" data-lead-id="{{item.leadId}}" disabled="{{item.busy}}" bindtap="onlineLinkLead">关联原客户</button><button size="mini" data-lead-id="{{item.leadId}}" disabled="{{item.busy}}" bindtap="onlineInvalidateLead">作废</button></view></button><text class="hint">手机号重复，待负责人关联或作废</text><view wx:if="{{pendingError}}" class="hint">{{pendingError}} <button size="mini" bindtap="loadPendingLeads">重试</button></view></view><button wx:for="{{leads}}" wx:key="id" class="record" data-view="lead" data-id="{{item.id}}" bindtap="open"><text>{{item.name}} · {{item.status}}</text><text>{{item.source}} · {{item.need}}</text></button><text wx:if="{{!leads.length}}" class="hint">暂无我的客资</text></view>
</block>
<view wx:elif="{{view==='content' && content}}" class="section"><text class="section-title">{{content.pack.title}}</text><text class="row">状态：{{content.status}} · V{{content.versions.length}}</text><image class="cover" src="{{content.pack.cover}}" mode="aspectFit"/><text class="row">{{content.pack.publishText}}</text><text class="row">目标账号：{{content.pack.accountId}}</text><text class="row">原作者：{{content.authorId}}</text><text wx:if="{{content.review}}" class="row">历史审核记录：{{content.review.note}}</text><text wx:if="{{content.publishedUrl}}" class="row">发布链接：{{content.publishedUrl}}</text></view>
<view wx:elif="{{view==='capture'}}" class="section"><text class="section-title">来源与有效咨询</text><picker range="{{publishedNames}}" data-key="contentId" value="{{publishedIndex||0}}" bindchange="pick"><view class="input">{{publishedIndex?publishedNames[publishedIndex]:directSourceChosen?'直接来访／转介绍':form.contentId?'正在核对发布来源':'选择客资来源'}}</view></picker><view wx:if="{{publicationError}}" class="hint" role="alert">{{publicationError}} <button size="mini" bindtap="syncGrowth">重新加载</button></view><button size="mini" wx:if="{{!directSourceChosen&&!publishedIndex}}" bindtap="chooseDirectSource">直接来访／转介绍</button><input class="input" data-key="name" value="{{form.name}}" placeholder="客户称呼" bindinput="input"/><input class="input" data-key="phone" value="{{form.phone}}" placeholder="手机号" type="number" bindinput="input"/><input class="input" data-key="source" value="{{form.source}}" placeholder="非内容来源：来访、转介绍等" bindinput="input"/><textarea class="input note" data-key="need" value="{{form.need}}" placeholder="咨询需求，不能用曝光量代替线索" bindinput="input"/></view>
<view wx:elif="{{view==='lead' && lead}}" class="section"><text class="section-title">{{lead.name}} · {{lead.status}}</text><text class="row">{{lead.phone}} · {{lead.source}}</text><text class="row">{{lead.need}}</text><text class="row">原发布：{{lead.publicationId||'真实非内容来源'}}</text><view wx:for="{{lead.follows}}" wx:key="at" class="record"><text>{{item.by}} · {{item.note}}</text></view><textarea wx:if="{{lead.status!=='已转客户'}}" class="input note" data-key="note" value="{{form.note}}" placeholder="跟进内容" bindinput="input"/><view wx:if="{{existingCustomer && lead.status!=='已转客户'}}" class="record"><text>已有客户：{{existingCustomer.name}} · 原负责人{{existingCustomer.owner}}</text><text class="hint">保留咨询来源和原负责人</text><button class="lead-link-existing" data-action="link-existing" bindtap="perform">关联已有客户</button></view><button wx:if="{{requestExistingLink && canHandleLead}}" class="lead-request-link" data-action="request-link" bindtap="perform">请负责人关联</button><text wx:if="{{lead.status==='待负责人关联'}}" class="hint">已交负责人核对原客户，原线索与咨询来源保留。</text><button class="lead-convert" wx:if="{{canHandleLead && lead.status==='跟进中'}}" data-action="convert" bindtap="perform">转为客户</button><button wx:if="{{lead.status==='已转客户'}}" bindtap="goCustomer">查看客户进度</button></view>
<text wx:if="{{error}}" class="error" role="alert">{{error}}</text></view>
<view class="page-actions growth-actions"><button wx:if="{{view==='home' && canCapture}}" class="primary" data-view="capture" bindtap="open">＋登记客资</button><button wx:elif="{{view==='content' && content.publishedUrl && canCapture && !missing}}" class="primary consultation-entry" bindtap="registerConsultation">登记本作品咨询客资</button><button wx:elif="{{primary && !missing}}" class="primary" bindtap="perform">{{primary}}</button><button wx:else class="primary" bindtap="home">返回业务工作台</button></view></view>
