<import src="./parts.wxml"/>
<view class="hq-page zs-theme">
  <brand-header title="{{title}}" back="{{true}}"/>
  <view class="hq-content">
    <view wx:if="{{error}}" class="hq-card"><text class="hq-error">{{error}}</text><button class="hq-outline" bindtap="reload">重新加载</button><button wx:if="{{!ready}}" class="hq-text-button" bindtap="identity">切换工作身份</button></view>
    <text wx:if="{{loading}}" class="hq-loading">正在读取记录…</text>
    <block wx:if="{{ready}}">
      <view class="hq-detail-scope"><text>总部全品牌查询</text><text class="hq-badge">只读</text></view>
      <view wx:if="{{fileBusy||fileError}}" class="hq-file-notice"><text wx:if="{{fileBusy}}">正在核验并打开附件…</text><text wx:if="{{fileError}}" class="hq-error">{{fileError}}</text></view>
      <block wx:if="{{kind==='ledger'}}">
        <view class="hq-card"><text class="hq-eyebrow">{{companyName}}</text><text class="hq-heading">{{ledgerTitle}}</text><text class="hq-meta">根据财务已登记数据汇总，金额单位：元</text></view>
        <view class="hq-ledger-summary"><view wx:for="{{ledger.summary}}" wx:key="label" class="hq-card"><text class="hq-meta">{{item.label}}</text><text class="hq-summary-value">{{item.value}}</text></view></view>
        <view wx:if="{{ledger.accounting}}" class="hq-card"><view class="hq-record-top"><text class="hq-title">项目核算</text><text class="hq-status">{{ledger.accounting.status}}</text></view><text class="hq-meta">按已确认项目费用计算的毛利</text><text class="hq-amount">{{ledger.accounting.profit}}</text><view class="hq-field"><text>已确认项目费用</text><text>{{ledger.accounting.cost}}</text></view><view class="hq-field"><text>现金结余</text><text>{{ledger.accounting.cash}}</text></view><text class="hq-note">现金结余不表示项目利润。</text><text class="hq-meta">{{ledger.accounting.basis}}</text><view wx:if="{{ledger.accounting.latest}}" class="hq-history-item"><text class="hq-title">最近确认 V{{ledger.accounting.latest.version}}</text><text class="hq-meta">{{ledger.accounting.latest.date}} · 当时毛利 {{ledger.accounting.latest.profit}} · 当时现金结余 {{ledger.accounting.latest.cash}} · 当时待付款 {{ledger.accounting.latest.outstanding}}</text><text class="hq-note">{{ledger.accounting.latest.note}}</text></view></view>
        <view class="hq-section-heading"><text class="hq-title">收支明细</text><text class="hq-meta">{{ledger.entries.length}} 条</text></view>
        <view wx:if="{{ledger.truncated}}" class="hq-card hq-warning">当前仅显示最近 500 条明细，汇总金额仍按整个账本计算。完整原单可返回财务列表按日期查询和导出。</view>
        <button wx:for="{{ledger.entries}}" wx:key="key" class="hq-card hq-record" data-index="{{index}}" bindtap="openEntry"><view class="hq-record-top"><text class="hq-title">{{item.name}}</text><text class="hq-status">{{item.type}}</text></view><text class="hq-amount">{{item.amount}}</text><text class="hq-meta">{{item.date}} · {{item.status}}</text><text wx:if="{{item.counterparty}}" class="hq-meta">{{item.counterparty}}</text><text wx:if="{{item.note}}" class="hq-note">{{item.note}}</text><text wx:if="{{item.kind}}" class="hq-open-hint">查看原始记录与凭证 ›</text></button>
        <text wx:if="{{!ledger.entries.length}}" class="hq-empty">该账本暂无收支记录</text>
      </block>
      <block wx:else>
        <view class="hq-card"><text class="hq-eyebrow">{{detail.brandName}} · {{detail.companyName}}</text><view class="hq-record-top"><text class="hq-heading">{{detail.name}}</text><text class="hq-status">{{detail.status}}</text></view><template is="fields" data="{{rows:detail.fields}}"/></view>
        <block wx:if="{{kind==='customers'}}">
          <view class="hq-card">
            <button class="hq-entry hq-plain" bindtap="toggleExternal"><view><text class="hq-title">外部委托与成果</text><text class="hq-meta">查看委托需求、外部图纸及各版付款约定</text></view><text class="hq-arrow">{{externalOpen?'−':'+'}}</text></button>
            <block wx:if="{{externalOpen}}">
              <view class="hq-subtabs"><button class="hq-subtab {{externalKind==='requests'?'is-active':''}}" data-kind="requests" bindtap="selectExternal">委托需求</button><button class="hq-subtab {{externalKind==='results'?'is-active':''}}" data-kind="results" bindtap="selectExternal">外部成果</button></view>
              <view wx:for="{{externalRows}}" wx:key="key" class="hq-history-item">
                <view class="hq-record-top"><text class="hq-title">{{item.title}}</text><text class="hq-badge">只读</text></view><text class="hq-meta">{{item.date}} · {{item.actor}}</text>
                <template is="fields" data="{{rows:item.fields}}"/><template is="files" data="{{files:item.files,fileBusy}}"/>
                <view wx:if="{{item.payment}}" class="hq-stage"><text class="hq-title">本版委托留存的付款约定</text><text class="hq-meta">{{item.payment.source}} V{{item.payment.version}} · {{item.payment.total}}</text><view wx:for="{{item.payment.stages}}" wx:for-item="paymentRow" wx:key="key" class="hq-node"><view class="hq-field"><text>{{paymentRow.label}}</text><text>{{paymentRow.amount}}</text></view><text class="hq-meta">{{paymentRow.ratio}} {{paymentRow.trigger}}{{paymentRow.node?' · 节点 '+paymentRow.node:''}}{{paymentRow.date?' · '+paymentRow.date:''}}</text></view></view>
              </view>
              <text wx:if="{{externalLoading}}" class="hq-loading">正在读取委托资料…</text><text wx:if="{{externalError}}" class="hq-error">{{externalError}}</text><text wx:if="{{!externalLoading&&!externalError&&!externalRows.length}}" class="hq-meta">暂未登记{{externalKind==='requests'?'委托需求':'外部成果'}}</text>
              <button wx:if="{{externalMore||externalError}}" class="hq-text-button" bindtap="moreExternal" loading="{{externalLoading}}" disabled="{{externalLoading}}">{{externalError?'重试读取资料':'加载更多版本'}}</button>
            </block>
          </view>
          <view class="hq-section-heading"><text class="hq-title">客户八步跟进</text><text class="hq-meta">已完成 {{detail.completed}} / 8 · {{detail.progress}}%</text></view>
          <view class="hq-progress-track hq-workflow-progress"><view style="width:{{detail.progress}}%"></view></view>
          <view wx:for="{{detail.steps}}" wx:key="code" class="hq-card hq-step {{item.completed?'is-completed':''}}">
            <button class="hq-step-head" data-code="{{item.code}}" bindtap="expandStep"><text class="hq-step-number">{{item.number}}</text><view class="hq-step-title"><text class="hq-title">{{item.name}}</text><text class="hq-meta">{{item.source}}</text></view><text class="hq-status">{{item.status}}</text><text class="hq-arrow">{{expanded===item.code?'−':'+'}}</text></button>
            <view wx:if="{{expanded===item.code}}" class="hq-step-content"><text wx:if="{{item.occurredOn}}" class="hq-meta">发生日期 {{item.occurredOn}}</text><template is="fields" data="{{rows:item.fields}}"/><text wx:if="{{item.note}}" class="hq-note">{{item.note}}</text><template is="files" data="{{files:item.files,fileBusy}}"/><text wx:if="{{!item.fields.length&&!item.files.length&&!item.note}}" class="hq-meta">此步骤暂无补充资料</text></view>
          </view>
          <text wx:if="{{!detail.steps.length}}" class="hq-empty">该客户尚未建立八步跟进记录</text>
          <view class="hq-card"><button class="hq-entry hq-plain" bindtap="toggleHistory"><text class="hq-title">跟进历史记录</text><text class="hq-arrow">{{historyOpen?'−':'+'}}</text></button><block wx:if="{{historyOpen}}"><view wx:for="{{history}}" wx:key="id" class="hq-history-item"><view class="hq-record-top"><text class="hq-title">{{item.step}}</text><text class="hq-status">{{item.type}}</text></view><text class="hq-meta">{{item.actor}} · {{item.date}}</text><text wx:if="{{item.occurredOn}}" class="hq-meta">发生日期 {{item.occurredOn}}</text><template is="fields" data="{{rows:item.fields}}"/><text wx:if="{{item.note}}" class="hq-note">{{item.note}}</text><template is="files" data="{{files:item.files,fileBusy}}"/></view><text wx:if="{{historyError}}" class="hq-error">{{historyError}}</text><text wx:if="{{!history.length&&!historyLoading&&!historyError}}" class="hq-meta">暂无历史记录</text><button wx:if="{{historyMore||historyError||historyLoading}}" class="hq-text-button" loading="{{historyLoading}}" disabled="{{historyLoading}}" bindtap="loadHistory">{{historyError?'重试加载历史':'加载更多历史'}}</button></block></view>
        </block>
        <block wx:elif="{{kind==='projects'}}">
          <button class="hq-card hq-entry" bindtap="openLedger"><view><text class="hq-title">项目独立账本</text><text class="hq-meta">查看此项目的收支与费用明细</text></view><text class="hq-arrow">›</text></button>
          <view class="hq-card"><text class="hq-title">合同与付款计划</text><template is="fields" data="{{rows:detail.contractFields}}"/><view wx:for="{{detail.stages}}" wx:key="id" class="hq-stage"><view class="hq-record-top"><text class="hq-title">{{item.name}}</text><text class="hq-amount">{{item.amount}}</text></view><text class="hq-meta">{{item.ratio?'比例 '+item.ratio+' · ':''}}{{item.trigger||'付款条件待完善'}}{{item.dueDate?' · 到期 '+item.dueDate:''}}</text><view class="hq-stage-values"><view><text>净收款</text><text>{{item.received}}</text></view><view><text>已退款</text><text>{{item.refunded}}</text></view><view><text>待收金额</text><text>{{item.balance}}</text></view></view></view><text wx:if="{{!detail.stages.length}}" class="hq-meta">暂无付款计划记录</text></view>
          <view class="hq-card"><text class="hq-title">工程节点</text><view wx:for="{{detail.nodes}}" wx:key="id" class="hq-node"><view class="hq-record-top"><text>{{item.name}}</text><text class="hq-status">{{item.status}}</text></view><text class="hq-meta">{{item.start}} — {{item.end}}</text></view><text wx:if="{{!detail.nodes.length}}" class="hq-meta">暂无工程节点</text></view>
          <view class="hq-card"><text class="hq-title">工程资料</text><view wx:for="{{documents}}" wx:key="id" class="hq-document"><text>{{item.name}}</text><text class="hq-meta">{{item.kind}} · 版本 {{item.version}} · {{item.date}}</text><button wx:if="{{item.file}}" class="hq-file" data-key="{{item.file.key}}" bindtap="openFile" disabled="{{fileBusy}}">查看资料 ›</button><text wx:else class="hq-meta">该历史资料暂无可核验的附件，请由所属公司补充</text></view><text wx:if="{{!documents.length}}" class="hq-meta">暂无工程资料</text><text wx:if="{{documentsError}}" class="hq-error">{{documentsError}}</text><button wx:if="{{documentsMore}}" class="hq-text-button" data-kind="documents" bindtap="moreProjectItems" loading="{{documentsLoading}}" disabled="{{documentsLoading}}">{{documentsError?'重试读取资料':'加载更多资料'}}</button></view>
          <view class="hq-card"><text class="hq-title">现场记录</text><view wx:for="{{siteRecords}}" wx:key="id" class="hq-history-item"><view class="hq-record-top"><text>{{item.date}}</text><text class="hq-status">{{item.result}}</text></view><text wx:if="{{item.recordType}}" class="hq-meta">{{item.recordType}}</text><text class="hq-note">{{item.note}}</text><template is="files" data="{{files:item.files,fileBusy}}"/></view><text wx:if="{{!siteRecords.length}}" class="hq-meta">暂无现场记录</text><text wx:if="{{siteError}}" class="hq-error">{{siteError}}</text><button wx:if="{{siteMore}}" class="hq-text-button" data-kind="site-records" bindtap="moreProjectItems" loading="{{siteLoading}}" disabled="{{siteLoading}}">{{siteError?'重试读取现场记录':'加载更多现场记录'}}</button></view>
          <view class="hq-card"><text class="hq-title">交付与结算</text><template is="fields" data="{{rows:detail.closureFields}}"/><template is="files" data="{{files:detail.files,fileBusy}}"/><text wx:if="{{!detail.closureFields.length&&!detail.files.length}}" class="hq-meta">暂无交付与结算资料</text></view>
        </block>
        <view wx:elif="{{detail.files.length}}" class="hq-card"><text class="hq-title">财务凭证</text><template is="files" data="{{files:detail.files,fileBusy}}"/></view>
      </block>
    </block>
  </view>
</view>
