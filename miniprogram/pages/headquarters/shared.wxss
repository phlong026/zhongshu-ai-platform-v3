.hq-page{min-height:100vh;background:var(--zs-bg,#faf8f4);color:#352b22;font-size:28rpx;line-height:1.6}
.hq-content{padding:28rpx 30rpx 60rpx}.hq-with-nav{padding-bottom:calc(164rpx + env(safe-area-inset-bottom))}
.hq-page button{margin:0;font-weight:500;font-size:28rpx;line-height:1.5;border-radius:14rpx}.hq-page button::after{border:0}.hq-page button[disabled]{opacity:.5}
.hq-card{display:block;margin-bottom:24rpx;padding:28rpx;background:#fff;border:1rpx solid #eee8df;border-radius:22rpx;text-align:left}
.hq-heading-row,.hq-record-top,.hq-section-heading,.hq-results-heading,.hq-detail-scope{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.hq-heading-row{margin-bottom:24rpx}.hq-heading-row>view{min-width:0}.hq-heading{display:block;font-size:38rpx;font-weight:650;line-height:1.4;overflow-wrap:anywhere}.hq-title{display:block;font-size:30rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere}
.hq-eyebrow{display:block;color:#887563;font-size:24rpx;margin-bottom:8rpx}.hq-meta{display:block;color:#8b8177;font-size:24rpx;line-height:1.7;overflow-wrap:anywhere}.hq-badge,.hq-status{color:#89512a;background:#f7f1e9;border-radius:8rpx;padding:5rpx 12rpx;font-size:22rpx;white-space:nowrap;flex-shrink:0}.hq-status{background:#f5f3ef;color:#7d6e5f}.hq-badge{font-weight:600}
.hq-scope{display:grid;grid-template-columns:1fr 1fr;padding:20rpx 24rpx;gap:24rpx}.hq-scope-picker{min-width:0}.hq-scope-picker+picker{border-left:1rpx solid #eee8df;padding-left:24rpx}.hq-select-value{display:flex;justify-content:space-between;gap:12rpx;font-size:27rpx;font-weight:600;overflow-wrap:anywhere}
.hq-tabs{display:flex;gap:8rpx;margin:8rpx 0 24rpx;border-bottom:1rpx solid #eae1d5}.hq-page .hq-tab{flex:1;padding:18rpx 0;background:transparent;color:#8b8177;border-radius:0;font-size:27rpx}.hq-page .hq-tab.is-active{color:#89512a;border-bottom:4rpx solid #89512a;font-weight:650}
.hq-subtabs{display:flex;gap:12rpx;margin-bottom:24rpx}.hq-page .hq-subtab{flex:1;padding:12rpx 4rpx;background:#f0ebe4;color:#827467;font-size:26rpx}.hq-page .hq-subtab.is-active{background:#89512a;color:#fff}
.hq-search{display:flex;gap:16rpx;align-items:center}.hq-search input{flex:1;min-width:0;height:76rpx;background:#f8f6f3;padding:0 18rpx;border-radius:12rpx;font-size:26rpx}.hq-input{height:72rpx;margin-top:16rpx;background:#f8f6f3;padding:0 18rpx;border-radius:12rpx;font-size:26rpx}
.hq-date-row{display:flex;align-items:center;gap:16rpx;margin:16rpx 0 10rpx;font-size:25rpx;color:#8b8177}.hq-date-row picker{flex:1;border:1rpx solid #eae1d5;padding:12rpx;border-radius:12rpx;text-align:center;color:#514336}
.hq-page .hq-primary,.hq-page .hq-small-primary{background:#89512a;color:#fff;padding:20rpx 24rpx;text-align:center}.hq-page .hq-small-primary{padding:16rpx 20rpx;flex-shrink:0;font-size:26rpx}.hq-page .hq-outline{padding:20rpx 24rpx;background:#fff;color:#89512a;border:1rpx solid #c9af93;text-align:center}.hq-page .hq-text-button{padding:16rpx 4rpx;background:transparent;color:#89512a;text-align:center;font-size:26rpx}
.hq-metrics{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.hq-page .hq-metric{padding:26rpx;border-radius:22rpx}.hq-number{display:block;font-size:56rpx;line-height:1.5;font-weight:650;color:#6c4529}.hq-link{font-size:23rpx;color:#89512a}.hq-entry{display:flex;align-items:center;justify-content:space-between;gap:22rpx;width:100%}.hq-entry>view{min-width:0}.hq-page .hq-entry.hq-card{margin-bottom:24rpx;padding:28rpx;border-radius:22rpx;background:#fff}.hq-arrow{font-size:34rpx;color:#a98d72;flex-shrink:0}.hq-footnote,.hq-section-caption{display:block;font-size:24rpx;color:#918476;line-height:1.8;margin:12rpx 0 24rpx}
.hq-page .hq-record{width:100%;margin-bottom:22rpx;border-radius:22rpx;background:#fff}.hq-record-top{align-items:flex-start}.hq-record-top .hq-title,.hq-record-top .hq-heading{min-width:0}.hq-company{display:block;font-size:23rpx;color:#9a846c;margin:10rpx 0 16rpx;overflow-wrap:anywhere}.hq-amount{display:block;font-size:32rpx;font-weight:600;color:#784c2e;white-space:nowrap}.hq-record>.hq-amount{margin-bottom:10rpx}.hq-open-hint{display:block;text-align:right;font-size:23rpx;color:#a68a6f;margin-top:12rpx}.hq-results-heading{margin-bottom:16rpx}
.hq-progress{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #f0ebe4}.hq-progress-caption{display:flex;justify-content:space-between;color:#8b6b4d;font-size:24rpx}.hq-progress-track{height:8rpx;background:#eee7dc;border-radius:8rpx;overflow:hidden;margin-top:10rpx}.hq-progress-track>view{height:100%;background:#a77549;border-radius:8rpx}.hq-workflow-progress{margin:4rpx 0 24rpx}
.hq-section-heading{margin:30rpx 0 18rpx}.hq-detail-scope{font-size:24rpx;color:#8b8177;margin-bottom:20rpx}.hq-field{display:flex;gap:24rpx;padding:16rpx 0;border-bottom:1rpx solid #f3eee7;font-size:26rpx;align-items:flex-start}.hq-field:last-child{border-bottom:0}.hq-field-label{color:#8b8177;width:184rpx;flex-shrink:0}.hq-field-value{flex:1;min-width:0;white-space:pre-wrap;overflow-wrap:anywhere}.hq-note{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:26rpx;margin:18rpx 0;color:#65594d}
.hq-page .hq-step{padding:0}.hq-page .hq-step-head{display:flex;align-items:center;gap:16rpx;padding:26rpx 22rpx;background:transparent;text-align:left}.hq-step-number{font-size:32rpx;font-weight:600;color:#ad967e}.hq-step-title{flex:1;min-width:0}.hq-step-title .hq-meta{font-size:22rpx;margin-top:4rpx}.is-completed .hq-step-number{color:#7b8c64}.is-completed .hq-step-head .hq-status{color:#63734f;background:#eef1e7}.hq-step-content{padding:0 24rpx 24rpx;border-top:1rpx solid #f1eae2}.hq-step-content>.hq-meta{margin-top:16rpx}
.hq-page .hq-file{display:flex;align-items:center;gap:16rpx;text-align:left;width:100%;background:#f7f4ef;color:#6a503c;border:1rpx solid #eee4d6;border-radius:12rpx;padding:18rpx;margin-top:14rpx;font-size:25rpx}.hq-file-icon{font-size:20rpx;color:#a57c51;border-right:1rpx solid #ddcebd;padding-right:14rpx;flex-shrink:0}.hq-file-label{flex:1;min-width:0;overflow-wrap:anywhere}.hq-file-notice{padding:18rpx 22rpx;border-radius:12rpx;background:#fff6e8;margin-bottom:20rpx;font-size:25rpx}
.hq-history-item,.hq-node,.hq-document,.hq-stage{border-top:1rpx solid #eee8df;padding:22rpx 0}.hq-history-item:last-child,.hq-node:last-child,.hq-document:last-child,.hq-stage:last-child{padding-bottom:0}.hq-card>.hq-title{margin-bottom:18rpx}.hq-page .hq-plain{padding:0;background:transparent;text-align:left}
.hq-stage-values{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:14rpx}.hq-stage-values>view>text{display:block;font-size:23rpx;overflow-wrap:anywhere}.hq-stage-values>view>text:first-child{color:#9a8c7e;margin-bottom:4rpx}.hq-ledger-summary{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.hq-ledger-summary .hq-card{margin:0;padding:22rpx}.hq-summary-value{display:block;font-size:28rpx;font-weight:600;color:#795336;overflow-wrap:anywhere}
.hq-warning{background:#fff7e9;color:#8f7047;font-size:24rpx}.hq-loading,.hq-empty{display:block;padding:30rpx 12rpx;text-align:center;color:#9a8b7c;font-size:26rpx}.hq-empty>.hq-heading{font-size:30rpx;margin-bottom:20rpx}.hq-empty>.hq-primary{margin-top:24rpx}.hq-error{display:block;color:#b04c39;font-size:25rpx;line-height:1.7;overflow-wrap:anywhere}.hq-more{width:100%;margin-bottom:24rpx!important}.hq-export .hq-meta{margin:12rpx 0 22rpx}.hq-export button+button{margin-top:16rpx}.hq-export .hq-error{margin-top:16rpx}
