<view class="page design-page workbench-page sales-page">
  <view class="workbench-header"><brand-header divider="{{true}}" title="AI设计" /></view>
  <view class="content">
    <view class="design-hero"><image class="design-hero-picture" src="/pages/design/assets/biz-case-1.jpg" mode="aspectFill"/><view class="design-hero-veil"/><view class="design-hero-copy"><view class="design-hero-title"><text>把建房想法</text><text>变成方案</text></view><button wx:if="{{entranceEnabled}}" class="primary" data-view="ai-config" bindtap="open">开始AI设计</button></view></view>
    <view wx:if="{{entranceEnabled}}" class="design-quick"><button wx:for="{{entries}}" wx:key="view" class="design-entry" data-view="{{item.view}}" bindtap="open"><image src="/assets/{{item.icon}}.png" mode="aspectFit"/><view><text>{{item.title}}</text></view><view class="chevron"/></button></view>
    <text wx:if="{{!entranceEnabled}}" class="sales-note">请使用平台账号登录 AI 设计</text>
    <view wx:if="{{entranceEnabled}}" class="design-recent">
      <view class="section-heading recent-heading"><view class="recent-heading-title"><text class="section-title">最近任务</text><text wx:if="{{recentRunning}}" class="recent-count">{{recentRunning}}项进行中</text></view><button class="text-link" bindtap="{{recentError?'retryRecent':'openAllTasks'}}">{{recentError?'重试':'全部任务'}} <image src="/assets/creation-chevron.png"/></button></view>
      <view wx:if="{{recentLoading && recentCount === 0}}" class="design-catalog-state">正在读取最近任务…</view>
      <view wx:elif="{{recentError && recentCount === 0}}" class="design-catalog-state"><text>{{recentError}}</text><button class="outline" bindtap="retryRecent">重新加载</button></view>
      <view wx:elif="{{recentCount > 0}}" class="recent-list"><button wx:for="{{recentTasks}}" wx:key="id" class="recent-task" data-id="{{item.id}}" bindtap="openRecent"><view class="recent-cover"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFit" data-id="{{item.id}}" data-cover="{{item.coverUrl}}" binderror="recentCoverError"/><image wx:else class="recent-icon" src="{{item.icon}}" mode="aspectFit"/></view><view class="recent-info"><text class="recent-title">{{item.title}}</text><text class="recent-meta">{{item.metadata||'设计任务'}}</text><text wx:if="{{item.progress}}" class="recent-progress">{{item.progress}}</text></view><view class="recent-side"><text class="recent-status {{item.tone}}">{{item.statusText}}</text><view class="recent-action"><text>{{item.action}}</text><image src="/assets/creation-chevron.png"/></view></view></button></view>
      <view wx:else class="design-catalog-state">暂无设计任务</view>
    </view>
    <view wx:if="{{entranceEnabled}}" class="design-catalog">
      <view class="section-heading design-catalog-heading"><view><text class="section-title">户型灵感</text></view><button class="text-link" bindtap="openCatalog">查看全部 <view class="chevron"/></button></view>
      <view wx:if="{{catalogLoading&&!catalogCount}}" class="design-catalog-state"><text>正在加载户型资料…</text></view>
      <view wx:elif="{{catalogError&&!catalogCount}}" class="design-catalog-state design-catalog-error"><text>{{catalogError}}</text><button class="outline" bindtap="retryCatalog">重新加载</button></view>
      <view wx:elif="{{catalogLoaded&&!catalogCount}}" class="design-catalog-state"><text>暂无已发布户型</text><button class="outline" bindtap="retryCatalog">刷新</button></view>
      <view wx:else class="design-cases-grid">
        <button wx:for="{{catalogCases}}" wx:key="id" class="design-case case-cover-watch" data-id="{{item.id}}" bindtap="openCatalogCase">
          <view class="design-case-media">
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="catalogImageError"/>
            <view wx:elif="{{item.coverLoading}}" class="design-cover-state">图片加载中…</view>
            <view wx:elif="{{!item.coverAssetId}}" class="design-cover-state">暂无封面</view>
            <view wx:else class="design-cover-state design-cover-retry" role="button" aria-label="重新加载户型封面" data-id="{{item.id}}" catchtap="retryCatalogCover">封面加载失败，点击重试</view>
          </view>
          <view class="design-case-copy"><text>{{item.title}}</text><text class="hint">{{item.faceWidth}}×{{item.depth}}m · {{item.floorCount}}层</text><view class="chevron"/></view>
        </button>
      </view>
    </view>
  </view>
</view>
<workspace-nav id="design-workspace-nav" active-index="{{6}}" nested />
