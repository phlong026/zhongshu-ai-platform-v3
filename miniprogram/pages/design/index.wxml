<view class="page design-page workbench-page sales-page">
  <view class="workbench-header"><brand-header divider="{{true}}" title="AI设计" /></view>
  <view class="content">
    <view class="design-hero"><image class="design-hero-picture" src="{{cases[0].image}}" mode="aspectFill"/><view class="design-hero-veil"/><view class="design-hero-copy"><view class="design-hero-title"><text>把建房想法</text><text>变成方案</text></view><view class="design-hero-description"><text>从需求到平面、立面</text><text>与预算参考</text></view><button class="primary" data-view="ai-config" bindtap="open">开始AI设计</button></view></view>
    <view class="design-quick"><button wx:for="{{entries}}" wx:key="view" class="design-entry" data-view="{{item.view}}" bindtap="open"><image src="/assets/{{item.icon}}.png" mode="aspectFit"/><view><text>{{item.title}}</text><text class="hint">{{item.hint}}</text></view><view class="chevron"/></button></view>
    <view class="section design-cases"><view class="section-heading"><text class="section-title">精选灵感</text><button class="text-link" data-view="inspiration" bindtap="open">查看全部<view class="chevron"/></button></view><view class="design-cases-grid"><button wx:for="{{cases}}" wx:key="id" class="design-case" data-id="{{item.id}}" bindtap="openCase"><image src="{{item.image}}" mode="aspectFill"/><view class="design-case-copy"><text>{{item.name}}</text><text class="hint">建面{{item.area}}㎡ · {{item.floors}}层 · {{item.style}}</text><view class="chevron"/></view></button></view></view>
    <text class="sales-note">先浏览灵感、生成方案或测算预算，选定后可关联客户保存。</text>
  </view>
</view>
<workspace-nav id="design-workspace-nav" active-index="{{6}}" nested />
