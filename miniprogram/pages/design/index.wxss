@import "../../styles/workbench.wxss";
@import "../../styles/sales.wxss";
.design-hero{position:relative;min-height:340rpx;overflow:hidden;border-radius:22rpx;margin-bottom:24rpx;background:var(--sales-soft)}.design-hero-picture{position:absolute;left:0;right:0;top:0;bottom:0;width:100%;height:100%}.design-hero-copy{position:relative;z-index:1;display:flex;align-items:flex-start;flex-direction:column;gap:14rpx;width:58%;min-height:340rpx;padding:26rpx 24rpx;background:rgba(250,248,244,.9)}.design-hero-copy>text{font-size:var(--zs-font-meta);line-height:36rpx;color:#775b40}.design-hero-copy>text.design-hero-title{font-size:var(--zs-font-heading);line-height:52rpx;color:var(--sales-ink);font-weight:600}.sales-page .design-hero-copy>.primary{margin-top:auto;min-height:76rpx;font-size:var(--zs-font-emphasis)}.design-quick{display:flex;gap:20rpx;margin-bottom:24rpx}.design-quick>button{flex:1;min-width:0;display:flex;align-items:center;gap:14rpx;text-align:left;background:var(--zs-card);border-radius:22rpx;padding:22rpx 18rpx;min-height:136rpx}.design-quick>button>image{width:48rpx;height:48rpx;flex-shrink:0}.design-quick>button>view:not(.chevron){flex:1;min-width:0}.design-quick text{display:block;font-size:var(--zs-font-title);font-weight:500;line-height:44rpx}.design-quick text.hint{font-size:var(--zs-font-caption);font-weight:400;line-height:34rpx;white-space:nowrap}.design-cases-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.design-case{min-width:0;overflow:hidden;border-radius:16rpx;background:var(--sales-paper);text-align:left}.design-case>image{display:block;width:100%;height:210rpx}.design-case-copy{position:relative;padding:14rpx 16rpx}.design-case-copy>text{display:block;padding-right:14rpx;font-size:var(--zs-font-emphasis);font-weight:500;line-height:42rpx}.design-case-copy>text.hint{font-size:var(--zs-font-caption);font-weight:400;line-height:34rpx;margin-top:4rpx;overflow-wrap:anywhere}.design-case-copy .chevron{position:absolute;right:14rpx;top:31rpx}
.design-hero-title{font-size:var(--zs-font-heading);line-height:52rpx;color:var(--sales-ink);font-weight:600}.design-hero-title>text{display:block}
.sales-page .design-hero-copy>.primary{font-size:var(--zs-font-emphasis)}
.design-hero-picture{left:auto;right:0;width:52%;height:100%;background:#f7f3ed}.design-hero-copy{width:48%;background:#f7f3ed}
.design-hero-description{font-size:var(--zs-font-meta);line-height:36rpx;color:#775b40}.design-hero-description>text{display:block}
.design-quick{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.design-quick>button{width:100%;padding:20rpx 16rpx;gap:12rpx;min-height:128rpx}.design-quick text{font-size:var(--zs-font-emphasis);line-height:42rpx}.design-quick text.hint{font-size:var(--zs-font-caption);line-height:34rpx;white-space:normal}.design-quick>button>image{width:44rpx;height:44rpx}

.design-hero{min-height:360rpx;background:#f5efe4}.design-hero-picture{right:-4%;width:80%;height:100%;background:transparent}.design-hero-veil{position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,#f5efe4 0%,rgba(245,239,228,.97) 25%,rgba(245,239,228,.82) 40%,rgba(245,239,228,.2) 62%,rgba(245,239,228,0) 80%)}.design-hero-copy{width:57%;min-height:360rpx;background:transparent;padding:28rpx 24rpx;z-index:2}.design-hero-title{font-size:var(--zs-font-heading);line-height:50rpx}.sales-page .design-hero-copy>.primary{min-height:72rpx;padding:12rpx 20rpx}.design-hero-description{font-size:var(--zs-font-meta);line-height:36rpx}
.design-catalog{margin-top:30rpx}.design-catalog-heading{align-items:flex-end;margin-bottom:18rpx}.design-catalog-heading>view>text{display:block}.design-catalog-heading .hint{margin-top:3rpx}.design-catalog-heading .text-link{display:flex;align-items:center;gap:8rpx}.design-catalog-state{display:flex;min-height:176rpx;align-items:center;justify-content:center;flex-direction:column;gap:18rpx;padding:28rpx;border-radius:18rpx;background:var(--zs-card);color:var(--zs-text-3);font-size:var(--zs-font-meta);text-align:center}.design-catalog-state .outline{min-width:190rpx}.design-catalog-error{color:#985a32}.design-case-media{height:210rpx;background:#eee8df}.design-case-media>image{display:block;width:100%;height:100%}.design-cover-state{display:flex;width:100%;height:100%;align-items:center;justify-content:center;padding:24rpx;color:var(--zs-text-3);font-size:var(--zs-font-caption);text-align:center}.design-cover-retry{border-radius:0;background:#eee8df;line-height:34rpx}.design-case-copy .hint{min-height:34rpx}

.design-hero, .design-hero-copy{min-height:320rpx}.design-quick>button{min-height:108rpx}.design-quick{margin-bottom:32rpx}.design-catalog-heading{margin-top:0}

/* Cards must not inherit the workbench button's horizontal flex layout. */
.sales-page .design-cases-grid > .design-case { display:flex; flex-direction:column; align-items:stretch; justify-content:flex-start; padding:0; min-width:0; }
.design-case .design-case-media { width:100%; height:210rpx; flex:none; overflow:hidden; }
.design-case .design-case-copy { width:100%; box-sizing:border-box; }

.design-recent{margin:36rpx 0}.recent-heading{align-items:center;margin-bottom:24rpx;gap:12rpx}.recent-heading-title{display:flex;align-items:center;gap:16rpx;min-width:0}.recent-count{font-size:22rpx;color:#89512a;background:#f0e0ce;padding:6rpx 16rpx;border-radius:24rpx;white-space:nowrap}.recent-heading .text-link{display:flex;align-items:center;gap:6rpx;white-space:nowrap}.recent-heading image,.recent-action image{width:20rpx;height:20rpx}.recent-list{padding:0 20rpx;background:#fff;border-radius:22rpx}.sales-page .recent-task{display:flex;align-items:center;gap:16rpx;width:100%;min-height:156rpx;padding:20rpx 0;border-radius:0;background:transparent;text-align:left;border-bottom:1rpx solid #eae3db}.sales-page .recent-task:last-child{border-bottom:0}.recent-cover{width:144rpx;height:112rpx;border-radius:12rpx;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#f7f3ec}.recent-cover>image{width:100%;height:100%}.recent-cover>.recent-icon{width:48rpx;height:48rpx}.recent-info{display:flex;flex-direction:column;gap:8rpx;min-width:0;flex:1}.recent-title{font-size:27rpx;font-weight:600;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.recent-meta{font-size:23rpx;line-height:1.4;color:#8d8075}.recent-progress{font-size:24rpx;color:#89512a}.recent-side{display:flex;align-items:flex-end;flex-direction:column;gap:22rpx;flex-shrink:0}.recent-status{padding:5rpx 14rpx;border-radius:28rpx;font-size:23rpx;line-height:1.3}.recent-status.warm{background:#fff0d5;color:#a46814}.recent-status.green{background:#e4f1e0;color:#427d3e}.recent-status.red{background:#fce7df;color:#ac4d35}.recent-status.muted{background:#eeeae5;color:#8a8179}.recent-action{display:flex;align-items:center;gap:6rpx;color:#89512a;font-size:25rpx}.recent-note{display:flex;align-items:center;gap:12rpx;margin-top:18rpx;color:#8b8178;font-size:24rpx}.recent-note image{width:26rpx;height:26rpx}.design-case .design-case-media{height:236rpx}.design-case .design-case-copy{background:#fff;padding:14rpx 14rpx 18rpx}
