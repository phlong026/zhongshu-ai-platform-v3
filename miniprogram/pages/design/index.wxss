@import "../../styles/workbench.wxss";
@import "../../styles/sales.wxss";
.design-hero{position:relative;min-height:340rpx;overflow:hidden;border-radius:22rpx;margin-bottom:24rpx;background:var(--sales-soft)}.design-hero-picture{position:absolute;left:0;right:0;top:0;bottom:0;width:100%;height:100%}.design-hero-copy{position:relative;z-index:1;display:flex;align-items:flex-start;flex-direction:column;gap:14rpx;width:58%;min-height:340rpx;padding:26rpx 24rpx;background:rgba(250,248,244,.9)}.design-hero-copy>text{font-size:24rpx;line-height:36rpx;color:#775b40}.design-hero-copy>text.design-hero-title{font-size:38rpx;line-height:52rpx;color:var(--sales-ink);font-weight:600}.sales-page .design-hero-copy>.primary{margin-top:auto;min-height:76rpx;font-size:27rpx}.design-quick{display:flex;gap:20rpx;margin-bottom:24rpx}.design-quick>button{flex:1;min-width:0;display:flex;align-items:center;gap:14rpx;text-align:left;background:#fff;border-radius:22rpx;padding:22rpx 18rpx;min-height:136rpx}.design-quick>button>image{width:48rpx;height:48rpx;flex-shrink:0}.design-quick>button>view:not(.chevron){flex:1;min-width:0}.design-quick text{display:block;font-size:30rpx;font-weight:500;line-height:44rpx}.design-quick text.hint{font-size:22rpx;font-weight:400;line-height:34rpx;white-space:nowrap}.design-cases-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.design-case{min-width:0;overflow:hidden;border-radius:16rpx;background:var(--sales-paper);text-align:left}.design-case>image{display:block;width:100%;height:210rpx}.design-case-copy{position:relative;padding:14rpx 16rpx}.design-case-copy>text{display:block;padding-right:14rpx;font-size:28rpx;font-weight:500;line-height:42rpx}.design-case-copy>text.hint{font-size:22rpx;font-weight:400;line-height:34rpx;margin-top:4rpx;overflow-wrap:anywhere}.design-case-copy .chevron{position:absolute;right:14rpx;top:31rpx}.design-more{display:flex;gap:20rpx}.design-more>button{flex:1;min-width:0;display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:64rpx;text-align:left;font-size:25rpx;color:var(--sales-brand)}
.design-hero-title{font-size:38rpx;line-height:52rpx;color:var(--sales-ink);font-weight:600}.design-hero-title>text{display:block}
.sales-page .design-hero-copy>.primary{font-size:28rpx}
.design-hero-picture{left:auto;width:66%}.design-hero-copy{width:52%}
.design-hero-description{font-size:24rpx;line-height:36rpx;color:#775b40}.design-hero-description>text{display:block}
