@import "../../styles/workbench.wxss";
.design-intro{display:block;margin-bottom:20rpx}.design-entry-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.design-entry{border-radius:12rpx;overflow:hidden;background:#faf8f4;text-align:left;min-width:0}.design-entry>image{display:block;width:100%;height:210rpx}.design-entry-copy{position:relative;padding:18rpx 18rpx 22rpx}.design-entry-copy>text{display:block;font-size:26rpx;font-weight:500;line-height:40rpx}.design-entry-copy>text.hint{font-size:22rpx;font-weight:400;margin-top:6rpx;padding-right:8rpx;line-height:34rpx}.design-entry-copy .chevron{position:absolute;right:18rpx;top:32rpx}.design-note{display:block;font-size:22rpx;line-height:36rpx;color:#858991;padding:0 10rpx 28rpx}
