@import "../../styles/workbench.wxss";
.customer-search{height:74rpx;display:flex;align-items:center;gap:20rpx;border:4rpx solid #fff;border-radius:40rpx;padding:0 24rpx;margin-bottom:20rpx}.customer-search>image{width:32rpx;height:32rpx;flex-shrink:0}.customer-search>input{flex:1;min-width:0;font-size:26rpx}.customer-filters{display:flex;border-bottom:1rpx solid #eee9e1;margin-bottom:4rpx}.customer-filters>button{flex:1;font-size:24rpx;line-height:72rpx;color:#858991}.customer-filters>button.active{color:#75451f;font-weight:500;border-bottom:3rpx solid #75451f}.customer-list-row{display:flex;align-items:center;gap:20rpx;width:100%;padding:24rpx 0;text-align:left;border-bottom:1rpx solid #eee9e1}.customer-list-row:last-child{border-bottom:0}.customer-initial{width:74rpx;height:74rpx;flex-shrink:0;border-radius:50%;background:#faf1e5;color:#75451f;text-align:center;line-height:74rpx;font-size:30rpx}.customer-row-copy{flex:1;min-width:0}.customer-row-heading{display:flex;align-items:center;gap:16rpx;font-size:26rpx;font-weight:500;line-height:40rpx}.customer-status{font-size:20rpx;font-weight:400;line-height:30rpx;padding:2rpx 12rpx;background:#faf1e5;color:#75451f;border-radius:6rpx}.customer-row-copy>.hint{display:block;margin-top:6rpx;overflow-wrap:anywhere}
