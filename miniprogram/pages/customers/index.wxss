@import "../../styles/workbench.wxss";
@import "../../styles/sales.wxss";
.customer-demo-label{display:block;text-align:right;color:#a3a09a;font-size:21rpx;line-height:30rpx;margin:4rpx 0 18rpx}.sales-page .customer-counts .sales-stat-value{font-size:42rpx;line-height:56rpx}.customer-search{margin:20rpx 0 10rpx}.customer-filters{display:flex;border-bottom:1rpx solid var(--sales-line);margin-bottom:0}.customer-filters>button{flex:1;min-height:80rpx;font-size:26rpx;line-height:78rpx;color:var(--sales-muted)}.customer-filters>button.active{color:var(--sales-brand);font-weight:600;border-bottom:3rpx solid var(--sales-brand)}.customer-list-row{display:flex;align-items:center;gap:18rpx;width:100%;padding:28rpx 0;text-align:left;border-bottom:1rpx solid var(--sales-line)}.customer-list-row:last-child{border-bottom:0}.customer-initial{width:78rpx;height:78rpx;flex-shrink:0;border-radius:50%;background:#faf1e5;color:var(--sales-brand);text-align:center;line-height:78rpx;font-size:32rpx}.customer-row-copy{flex:1;min-width:0}.customer-row-heading{display:flex;align-items:center;gap:14rpx;flex-wrap:wrap;font-size:30rpx;font-weight:500;line-height:44rpx}.customer-row-copy>.hint{display:block;margin-top:6rpx;overflow-wrap:anywhere}.customer-next{display:block;margin-top:10rpx;color:var(--sales-brand);font-size:24rpx;line-height:36rpx;overflow-wrap:anywhere}.sales-page .customer-action{padding:10rpx 16rpx;min-width:116rpx;min-height:68rpx;font-size:24rpx}.customer-management{display:flex;gap:16rpx}.customer-management>button{flex:1;display:flex;align-items:center;gap:12rpx;text-align:left;font-size:25rpx;min-height:80rpx}.customer-management image{width:42rpx;height:42rpx;flex-shrink:0}.customer-management text{flex:1}.sales-page .customer-owner{font-size:22rpx}
