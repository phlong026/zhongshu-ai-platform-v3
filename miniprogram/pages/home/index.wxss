.home-page{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;background:#faf8f4;color:#3b2414;height:100vh;min-height:0;display:flex;flex-direction:column;overflow:hidden;padding-bottom:calc(82rpx + max(9rpx, calc(env(safe-area-inset-bottom) - 14rpx)))}
.home-header{position:relative;flex-shrink:0;z-index:60;background:#faf8f4}
.home-hero{position:relative;height:420rpx;overflow:hidden}.home-hero-image{position:absolute;inset:0;width:100%;height:100%}.home-hero-copy{position:relative;padding:42rpx 0 0 42rpx;width:390rpx}
.home-brand-title,.home-platform-title{display:block;font-size:46rpx;font-weight:600;line-height:62rpx;letter-spacing:0}.home-platform-title{font-size:45rpx}.home-hero-slogan{display:block;margin-top:12rpx;font-size:25rpx;line-height:38rpx;font-weight:500;white-space:nowrap;color:#211c17}.home-hero-description{display:block;margin-top:6rpx;font-size:22rpx;line-height:34rpx;color:#66635e;white-space:nowrap}
.home-hero-button,.home-login-button{display:flex;align-items:center;justify-content:center;gap:14rpx;background:#75451f;color:#fffaf3;border-radius:40rpx;font-size:24rpx;font-weight:400;line-height:36rpx}.home-hero-button{margin-top:22rpx;width:192rpx;height:58rpx}.home-hero-button .chevron,.home-login-button .chevron{border-color:#fffaf3}
.home-content{padding:12rpx 29rpx 4rpx}.home-title{font-size:30rpx;font-weight:600;line-height:42rpx;color:#3b2414;letter-spacing:0}.home-page .section-heading{height:56rpx;padding-left:23rpx;margin-bottom:8rpx}.home-page .section-heading::before{height:30rpx;top:13rpx;background:#75451f}
.home-role-grid{display:grid;grid-template-columns:1fr 1fr;margin:0 0 14rpx}.home-role{display:flex;align-items:center;min-width:0;gap:15rpx;padding:24rpx 10rpx;min-height:120rpx}.home-role:nth-child(even){border-left:1rpx solid #e9e4dd;padding-left:22rpx}.home-role:nth-child(-n+2){border-bottom:1rpx solid #e9e4dd}.home-role-icon{width:72rpx;height:72rpx;flex-shrink:0;border-radius:50%;background:#faf1e5;display:flex;align-items:center;justify-content:center}.home-role-icon image{width:45rpx;height:45rpx}.home-role-copy{min-width:0}.home-role-name{display:block;font-size:25rpx;font-weight:500;line-height:38rpx;white-space:nowrap}.home-role-description{display:block;font-size:20rpx;line-height:30rpx;color:#858585;white-space:nowrap}
.ai-section{margin-bottom:14rpx}.ai-cards{display:flex;gap:13rpx}.ai-card{flex:1;min-width:0;border-radius:11rpx;overflow:hidden;background:#fbf3e7;text-align:left}.ai-picture{display:block;width:100%;height:182rpx}.ai-caption{height:85rpx;padding:9rpx 24rpx;position:relative}.ai-title{display:block;font-size:25rpx;font-weight:500;line-height:34rpx}.ai-desc{display:block;font-size:22rpx;line-height:31rpx;color:#858585}.ai-caption .chevron{position:absolute;right:24rpx;top:34rpx}
.home-flow-steps{display:flex;margin:6rpx 0 16rpx}.home-flow-step{flex:1;min-width:0;position:relative;display:flex;align-items:center;flex-direction:column;font-size:22rpx;line-height:34rpx}.home-flow-icon{width:74rpx;height:74rpx;border-radius:50%;background:#faf1e5;display:flex;align-items:center;justify-content:center;margin-bottom:7rpx}.home-flow-icon image{width:46rpx;height:46rpx}.home-flow-arrow{position:absolute;right:-8rpx;top:18rpx;color:#858585;font-size:29rpx}
.home-login-banner{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:94rpx;background:#f7eddf;border-radius:11rpx;padding:14rpx 22rpx;margin-bottom:12rpx}.home-login-banner>view{flex:1;min-width:0}.home-login-title{display:block;font-size:24rpx;font-weight:500;line-height:36rpx;white-space:nowrap}.home-login-description{display:block;color:#858585;font-size:20rpx;line-height:30rpx;white-space:nowrap}.home-login-button{width:158rpx;height:56rpx;flex-shrink:0;font-size:22rpx;gap:9rpx}
@media(max-width:360px){.home-role{gap:10rpx;padding-left:4rpx}.home-role:nth-child(even){padding-left:12rpx}.home-role-icon{width:64rpx;height:64rpx}.home-login-banner{padding-left:16rpx;padding-right:16rpx}.home-login-title{font-size:23rpx}.home-login-button{width:146rpx}.home-login-description{font-size:19rpx}}

/* The public introduction fits the viewport above the existing custom tab bar. */
.home-hero{height:330rpx;flex-shrink:0}.home-hero-copy{padding-top:22rpx}.home-brand-title,.home-platform-title{line-height:56rpx}.home-hero-slogan{margin-top:6rpx;font-size:24rpx;line-height:32rpx}.home-hero-description{margin-top:4rpx;line-height:30rpx}.home-hero-button{margin-top:14rpx;height:52rpx}
.home-content{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:space-between;gap:8rpx;padding-top:8rpx;padding-bottom:8rpx}.home-roles,.ai-section,.home-flow,.home-login-banner{flex-shrink:0}.home-page .section-heading{height:50rpx;margin-bottom:6rpx}.home-page .section-heading::before{top:10rpx}.home-role-grid{margin-bottom:0}.home-role{padding-top:16rpx;padding-bottom:16rpx;min-height:104rpx}.ai-section{margin-bottom:0}.ai-picture{height:154rpx}.ai-caption{height:76rpx;padding-top:6rpx;padding-bottom:6rpx}.ai-caption .chevron{top:30rpx}.home-flow-steps{margin:4rpx 0 0}.home-flow-icon{width:64rpx;height:64rpx;margin-bottom:4rpx}.home-flow-icon image{width:42rpx;height:42rpx}.home-flow-arrow{top:12rpx}.home-login-banner{min-height:86rpx;margin-bottom:0;padding-top:10rpx;padding-bottom:10rpx}
@media(max-height:780px){.home-hero{height:310rpx}.home-hero-copy{padding-top:14rpx}.home-page .section-heading{height:48rpx}.home-title{font-size:29rpx}.home-role{padding-top:12rpx;padding-bottom:12rpx;min-height:96rpx}.ai-picture{height:140rpx}.home-content{gap:6rpx}}
@media(max-height:700px){.home-hero{height:280rpx}.home-hero-copy{padding-top:10rpx}.home-brand-title,.home-platform-title{font-size:40rpx;line-height:48rpx}.home-hero-slogan{font-size:23rpx;line-height:30rpx}.home-hero-description{font-size:21rpx;line-height:28rpx}.home-hero-button{height:46rpx;margin-top:10rpx;font-size:23rpx}.home-role-grid{grid-template-columns:repeat(4,1fr)}.home-role,.home-role:nth-child(even){flex-direction:column;gap:4rpx;padding:4rpx 0;min-height:0;border:0}.home-role:nth-child(-n+2){border:0}.home-role-icon{width:56rpx;height:56rpx}.home-role-icon image{width:38rpx;height:38rpx}.home-role-name{font-size:22rpx;line-height:32rpx}.home-role-description{display:none}.ai-picture{height:100rpx}.ai-caption{height:68rpx;padding-left:18rpx}.ai-desc{font-size:21rpx}.home-flow-icon{width:50rpx;height:50rpx}.home-flow-icon image{width:34rpx;height:34rpx}.home-flow-arrow{top:4rpx}.home-title{font-size:27rpx}.home-login-banner{min-height:80rpx}.home-login-title{font-size:22rpx}.home-login-description{font-size:19rpx}}
