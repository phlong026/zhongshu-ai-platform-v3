page{background:#f7f5f1;color:#201c18}.detail-page{padding:24rpx 24rpx 80rpx}.detail-summary,.record{background:#fff;border-radius:22rpx;padding:26rpx;margin-bottom:20rpx}.detail-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:30rpx;font-weight:650}.detail-heading picker>view{font-size:25rpx;font-weight:400;display:flex;align-items:center;gap:12rpx}.detail-heading image{width:18rpx;height:12rpx}.detail-number{font-size:68rpx;font-weight:750;color:#8b522b;margin:18rpx 0}.detail-number>text{font-size:28rpx;font-weight:400;margin-left:8rpx}.detail-note,.record-count{display:block;font-size:25rpx;line-height:1.6;color:#817970}.record-count{margin-top:18rpx}.record-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;font-size:29rpx;font-weight:650}.amount{color:#8b522b;white-space:nowrap}.record-subtitle{display:block;color:#817970;font-size:25rpx;margin:12rpx 0}.record-bottom{display:flex;align-items:center;justify-content:space-between;color:#9b938b;font-size:23rpx}.record-bottom button{display:flex;align-items:center;gap:10rpx;padding:8rpx 0;color:#8b522b;background:none;margin:0;font-size:26rpx}.record-bottom image{width:12rpx;height:22rpx}button::after{border:0}.empty{padding:64rpx 20rpx;text-align:center;color:#948b81;font-size:27rpx}.more,.visit-action{color:#8b522b;background:#efe5d8;font-size:27rpx;margin:16rpx 0;line-height:2.7}.error{color:#ab592b;font-size:25rpx;padding:20rpx 0;display:block}.error button{background:#f3e4d4;color:#8b522b;font-size:26rpx}.muted{font-size:23rpx;font-weight:400;color:#8d857c}.overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:150;display:flex;align-items:flex-end}.budget-sheet{box-sizing:border-box;width:100%;max-height:88vh;overflow-y:auto;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom))}.budget-sheet .detail-heading button{font-size:26rpx;margin:0;background:none;color:#8b522b}.budget