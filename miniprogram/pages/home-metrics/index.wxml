<brand-header title="{{title}}" back="{{true}}"/>
<view class="detail-page"><view class="detail-summary"><view class="detail-heading"><text>{{title}}</text><picker wx:if="{{monthly}}" mode="date" fields="month" value="{{period}}" bindchange="month"><view>{{period}}<image src="/assets/creation-down.png"/></view></picker><text wx:else class="muted">当前未结</text></view><view class="detail-number">{{metric.value||'—'}}<text>{{metric.unit}}</text></view><text class="detail-note">{{noteText}}</text><text class="record-count">共 {{total}} 条对应明细</text></view>
 <button wx:if="{{key==='visits'&&canRegisterVisit}}" class="visit-action" bindtap="collectVisit">选择客户，登记实际接待</button>
 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="retry">重新加载</button></view>
 <view class="records"><view wx:for="{{rows}}" wx:key="key" class="record"><view class="record-head"><text>{{item.title}}</text><text wx:if="{{item.amount!==0}}" class="amount">¥{{item.amountText}}</text></view><text class="record-subtitle">{{item.subtitle}}</text><view class="record-bottom"><text>{{item.date||'未约定日期'}}</text><button wx:if="{{item.url}}" data-key="{{item.key}}" bindtap="open">{{item.action}}<image src="/assets/creation-chevron.png"/></button></view></view></view>
 <view wx:if="{{loading}}" class="empty">正在加载明细…</view><view wx:elif="{{!rows.length&&!error}}" class="empty">{{monthly?'该月份暂无对应业务记录':'当前暂无此类未结事项'}}</view><button wx:if="{{more&&!loading}}" class="more" bindtap="more">加载更多</button>
</view>
<view wx:if="{{selected}}" class="overlay" catchtap="close"><view class="budget-sheet" catchtap="noop"><view class="detail-heading"><text>客户参考预算确认</text><button bindtap="close">关闭</button></view><text class="budget-title">{{selected.title}} · {{selected.budget.title}}</text><text class="detail-note">版本 V{{selected.budget.version}} · {{selected.totalText}}</text><button class="more" bindtap="openBudget">查看客户预算资料</button><block wx:if="{{selected.writable}}"><text class="detail-note">请记录客户对本版参考预算的确认；此记录不代表第六步「别墅报价」已完成。</text><textarea value="{{note}}" bindinput="note" maxlength="500" placeholder="例如：11月18日到店核对，客户确认本版预算及施工范围"/><text wx:if="{{confirmError}}" class="error">{{confirmError}}</text><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="confirmBudget">记录本版预算已确认</button></block><text wx:else class="detail-note">{{selected.readonlyNote}}</text></view></view>
