<view class="page engineering-page workbench-page {{guest?'engineering-guest':'engineering-live'}}">
  <view class="workbench-header"><brand-header id="engineering-workbench-header" divider="{{true}}" account-font="{{true}}" title="{{deskTitle||'工程工作台'}}" /></view>
  <view class="content guest-content">
  <block wx:if="{{guest}}">
    <view class="guest-search-row"><view class="guest-search"><image src="/pages/engineering/assets/search.png" mode="aspectFit"/><input value="{{guestKeyword}}" bindinput="searchGuest" placeholder="搜索项目、客户或地址" placeholder-class="guest-search-placeholder" confirm-type="search" maxlength="60" aria-label="搜索项目、客户或地址"/><button wx:if="{{guestKeyword}}" class="guest-search-clear" bindtap="clearGuestSearch" aria-label="清空搜索"><image src="/assets/studio-clear.png" mode="aspectFit"/></button></view><button class="primary guest-new" data-action="newProject" bindtap="openAction" hover-class="pressed"><image src="/pages/engineering/assets/add.png" mode="aspectFit"/>新建</button></view>
    <view class="guest-stats"><button wx:for="{{previewStats}}" wx:key="label" data-action="{{item.action}}" bindtap="openAction" hover-class="pressed"><image src="/pages/engineering/assets/{{item.icon}}.png" mode="aspectFit"/><view><text class="guest-stat-label">{{item.label}}</text><view class="guest-stat-number">{{item.value}}<text>{{item.unit}}</text></view></view></button></view>
    <view class="section guest-todos"><view class="section-heading"><text class="section-title">今日待办</text><button class="guest-section-link" data-action="siteConfirm" bindtap="openAction">全部待办<image src="/pages/engineering/assets/arrow.png" mode="aspectFit"/></button></view><view wx:for="{{previewTodos}}" wx:key="id" class="guest-task"><view class="guest-task-icon"><image src="/pages/engineering/assets/{{item.icon}}.png" mode="aspectFit"/></view><view class="guest-task-copy"><text class="guest-task-title">{{item.title}}</text><view class="guest-task-note"><image src="/pages/engineering/assets/clock.png" mode="aspectFit"/><text>{{item.note}}</text></view></view><button class="{{item.outline?'outline':'primary'}}" data-action="{{item.action}}" bindtap="openAction" hover-class="pressed">{{item.button}}</button></view></view>
    <view class="section guest-projects"><view class="section-heading"><text class="section-title">在建项目</text><button class="guest-section-link" data-action="projects" bindtap="openAction">全部项目<image src="/pages/engineering/assets/arrow.png" mode="aspectFit"/></button></view>
      <view wx:for="{{previewProjects}}" wx:key="id" class="guest-project {{item.featured?'guest-project-featured':''}}"><button class="guest-project-photo" data-action="projects" bindtap="openAction" aria-label="{{item.name}}，登录后查看项目"><image src="{{item.image}}" mode="aspectFill"/></button><view class="guest-project-body"><button class="guest-project-name" data-action="projects" bindtap="openAction"><text>{{item.name}}</text><image src="/pages/engineering/assets/arrow-muted.png" mode="aspectFit"/></button><text class="guest-project-meta">{{item.city}} · {{item.area}}<text class="guest-meta-divider">|</text>{{item.stage}}</text><text class="guest-progress-label">计划进度 <text>{{item.progress}}%</text></text><view class="guest-progress-row"><progress percent="{{item.progress}}" stroke-width="8" activeColor="#89512a" backgroundColor="#ededeb" border-radius="6"/><text>{{item.progress}}%</text></view>
        <view wx:if="{{item.featured}}" class="guest-stages"><view class="guest-stage-line"/><view wx:for="{{item.stages}}" wx:for-item="stage" wx:key="label" class="guest-stage {{stage.current?'is-current':''}}"><view class="guest-stage-dot"/><text>{{stage.label}}</text></view></view>
        <view wx:if="{{item.featured}}" class="guest-next-node"><image src="/pages/engineering/assets/calendar.png" mode="aspectFit"/><text>{{item.next}}</text></view><view wx:if="{{item.featured}}" class="guest-project-action"><button class="primary" data-action="projects" bindtap="openAction">查看项目<image src="/pages/engineering/assets/arrow-white.png" mode="aspectFit"/></button></view>
      </view></view>
      <view wx:if="{{!previewProjects.length}}" class="guest-project-empty"><text>没有找到匹配项目</text><text>试试客户姓名、项目名称或所在城市</text><button class="outline" bindtap="clearGuestSearch">重置搜索</button></view>
    </view>
    <view class="section guest-shortcuts"><view class="section-heading"><text class="section-title">快捷操作</text></view><view class="guest-shortcut-grid"><button wx:for="{{previewShortcuts}}" wx:key="title" data-action="{{item.action}}" bindtap="openAction" hover-class="pressed"><image src="/pages/engineering/assets/{{item.icon}}.png" mode="aspectFit"/><text class="guest-shortcut-title">{{item.title}}</text><text class="guest-shortcut-note">{{item.note}}</text></button></view></view>
    <button class="primary guest-login-button" data-action="login" bindtap="openAction">登录后查看本人工作台</button>
  </block>
  <view wx:elif="{{!canWork}}" class="section engineering-empty workbench-denied"><text class="section-title">{{active?'当前岗位无工程办理权限':'登录后查看工程工作台'}}</text><text>当前身份：{{roleLabel||'访客'}}</text><text>工程办理按工程师、项目经理及管理岗位授权开放。请返回本人工作台办理岗位事项。</text><button wx:if="{{active}}" class="primary return-workbench" data-tab="{{homeTab}}" bindtap="goTab">返回{{homeTitle}}</button><button wx:else class="primary" data-action="login" bindtap="openAction">登录后继续</button></view><block wx:else>
    <view class="guest-search-row"><view class="guest-search"><image src="/pages/engineering/assets/search.png" mode="aspectFit"/><input value="{{deskKeyword}}" bindinput="searchDesk" placeholder="搜索项目、客户或地址" placeholder-class="guest-search-placeholder" confirm-type="search" maxlength="60" aria-label="搜索本人可见项目、客户或地址"/><button wx:if="{{deskKeyword}}" class="guest-search-clear" bindtap="clearDeskSearch" aria-label="清空搜索"><image src="/assets/studio-clear.png" mode="aspectFit"/></button></view></view>
    <view class="guest-stats"><button wx:for="{{deskStats}}" wx:key="label" data-action="{{item.action}}" bindtap="openAction" hover-class="pressed"><image src="/pages/engineering/assets/{{item.icon}}.png" mode="aspectFit"/><view><text class="guest-stat-label">{{item.label}}</text><view class="guest-stat-number">{{item.value}}<text>{{item.unit}}</text></view></view></button></view>
    <block wx:if="{{isBossEng}}">
      <view class="section"><view class="section-heading"><text class="section-title">工程款闸门</text><text class="hint">钱没到，交付自动暂停</text></view>
        <view class="boss-eng-card"><view class="boss-eng-money"><text>开工款待收</text><text class="boss-eng-num">{{bossEng.startTotal}}</text></view><view class="boss-eng-money"><text>封顶款待收</text><text class="boss-eng-num">{{bossEng.topTotal}}</text></view><view wx:for="{{bossEng.overdue}}" wx:key="*this" class="boss-eng-overdue">{{item}}</view></view>
      </view>
      <view class="section"><view class="section-heading"><text class="section-title">项目进度</text><button class="guest-section-link" data-action="projects" bindtap="openAction">全部项目<image src="/pages/engineering/assets/arrow.png" mode="aspectFit"/></button></view>
        <view class="boss-eng-card">
          <view wx:for="{{bossEng.rows}}" wx:key="key" class="boss-eng-proj"><view class="boss-eng-r1"><text class="boss-eng-name {{item.late?'late':''}}">{{item.name}}</text><text class="boss-eng-pct">{{item.pct}}%</text></view><text class="boss-eng-r2">{{item.detail}}</text><view class="boss-eng-track"><view class="boss-eng-fill {{item.late?'late':''}}" style="width:{{item.pct}}%"/></view></view>
          <text wx:if="{{!bossEng.rows.length}}" class="hint">当前没有在建或待开工项目</text>
        </view>
      </view>
      <view class="section"><view class="section-heading"><text class="section-title">本月已付</text></view>
        <view class="boss-eng-card"><view class="boss-eng-money"><text>财务登记付款合计</text><text class="boss-eng-num">{{bossEng.spend}}</text></view></view>
      </view>
    </block>
    <view wx:if="{{!isBossEng}}" class="section guest-todos"><view class="section-heading"><text class="section-title">今日待办</text><button wx:if="{{deskTodos.length}}" class="guest-section-link" data-action="siteConfirm" bindtap="openAction">查看待办<image src="/pages/engineering/assets/arrow.png" mode="aspectFit"/></button></view><view wx:for="{{deskTodos}}" wx:key="id" class="guest-task"><view class="guest-task-icon"><image src="/pages/engineering/assets/{{item.icon}}.png" mode="aspectFit"/></view><view class="guest-task-copy"><text class="guest-task-title">{{item.title}}</text><view class="guest-task-note"><image src="/pages/engineering/assets/clock.png" mode="aspectFit"/><text>{{item.note}}</text></view></view><button class="{{item.outline?'outline':'primary'}}" data-action="{{item.action}}" bindtap="openAction" hover-class="pressed">{{item.button}}</button></view><text wx:if="{{!deskTodos.length}}" class="hint">当前暂无需要本人处理的事项</text></view>
    <view wx:if="{{!isBossEng}}" class="section guest-projects"><view class="section-heading"><text class="section-title">在建项目</text><button class="guest-section-link" data-action="projects" bindtap="openAction">全部项目<image src="/pages/engineering/assets/arrow.png" mode="aspectFit"/></button></view>
      <view wx:for="{{deskProjects}}" wx:key="id" class="guest-project {{item.featured?'guest-project-featured':''}}"><button class="guest-project-photo" data-id="{{item.id}}" data-action="projectDetail" bindtap="openAction" aria-label="{{item.name}}，查看项目"><image src="{{item.image}}" mode="aspectFill"/></button><view class="guest-project-body"><button class="guest-project-name" data-id="{{item.id}}" data-action="projectDetail" bindtap="openAction"><text>{{item.name}}</text><image src="/pages/engineering/assets/arrow-muted.png" mode="aspectFit"/></button><text class="guest-project-meta">{{item.city}} · {{item.area}}<text class="guest-meta-divider">|</text>{{item.stage}}</text><text class="guest-progress-label">完成进度 <text>{{item.progress}}%</text></text><view class="guest-progress-row"><progress percent="{{item.progress}}" stroke-width="8" activeColor="#89512a" backgroundColor="#ededeb" border-radius="6"/><text>{{item.progress}}%</text></view>
        <view wx:if="{{item.featured}}" class="guest-stages"><view class="guest-stage-line"/><view wx:for="{{item.stages}}" wx:for-item="stage" wx:key="label" class="guest-stage {{stage.current?'is-current':''}}"><view class="guest-stage-dot"/><text>{{stage.label}}</text></view></view>
        <view wx:if="{{item.featured}}" class="guest-next-node"><image src="/pages/engineering/assets/calendar.png" mode="aspectFit"/><text>{{item.next}}</text></view><view wx:if="{{item.featured}}" class="guest-project-action"><button class="primary" data-id="{{item.id}}" data-action="projectDetail" bindtap="openAction">查看项目<image src="/pages/engineering/assets/arrow-white.png" mode="aspectFit"/></button></view>
      </view></view>
      <view wx:if="{{!deskProjects.length}}" class="guest-project-empty"><text>暂无符合条件的在建项目</text><text>可搜索客户或城市，也可进入全部项目查看</text><button wx:if="{{deskKeyword}}" class="outline" bindtap="clearDeskSearch">重置搜索</button><button wx:else class="outline" data-action="projects" bindtap="openAction">查看全部项目</button></view>
    </view>
    <view class="section guest-shortcuts"><view class="section-heading"><text class="section-title">快捷操作</text></view><view class="guest-shortcut-grid"><button wx:for="{{deskShortcuts}}" wx:key="title" data-action="{{item.action}}" bindtap="openAction" hover-class="pressed"><image src="/pages/engineering/assets/{{item.icon}}.png" mode="aspectFit"/><text class="guest-shortcut-title">{{item.title}}</text><text class="guest-shortcut-note">{{item.note}}</text></button></view></view>
  </block></view>
</view>
<action-panel workbench="{{true}}" id="dashboard-action-panel" panel="{{panel}}" bindclose="closePanel" bindsubmit="submitPanel" />

