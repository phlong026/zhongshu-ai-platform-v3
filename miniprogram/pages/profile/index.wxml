<view class="page profile-page {{engineeringProfile?'engineering-desk engineering-profile':''}}"><brand-header account-font="{{!engineeringProfile}}" divider="{{engineeringProfile}}" title="我的"/><view class="content">
 <block wx:if="{{engineeringProfile}}">
 <view class="eng-section eng-profile-overview"><button class="eng-profile-person profile-menu" data-view="profile" bindtap="open"><image class="eng-profile-avatar" src="{{avatar}}" mode="aspectFill"/><view class="eng-grow"><text class="eng-profile-name">{{name}}</text><text class="eng-muted">{{company}} · {{role}}</text></view><text class="eng-muted">个人资料</text><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button>
 <view class="eng-profile-quick"><button class="profile-menu" data-view="messages" bindtap="open"><image src="/assets/account-message.jpg"/><text>消息通知</text><text wx:if="{{unread}}" class="eng-profile-count">{{unread}}</text><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button><button class="profile-menu" data-view="personal-performance" bindtap="open"><image src="/assets/account-chart.jpg"/><text>我的绩效</text><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button></view>
 <button class="eng-profile-identity profile-menu" data-view="identity" bindtap="open"><image src="/assets/account-shop.jpg"/><view class="eng-grow"><text>组织与工作身份</text><text class="eng-muted">{{company}} · {{role}}</text></view><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button><button wx:if="{{teamTitle}}" class="eng-profile-team eng-link" bindtap="openTeam">{{teamTitle}}<image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button></view>
 <view class="eng-section"><view class="eng-heading"><text>众墅学堂</text></view><view class="eng-profile-learning"><button class="profile-menu" data-view="learning&amp;category=工程" bindtap="open"><image src="/assets/graduate.png"/><text>培训课程</text><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button><button class="profile-menu" data-view="learning&amp;tab=资料&amp;category=工程" bindtap="open"><image src="/assets/book.png"/><text>学习资料</text><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button></view>
 <button class="eng-profile-course profile-menu" data-view="course" data-id="engineering" bindtap="open"><image src="{{courseImage}}" mode="aspectFill"/><view class="eng-grow"><text class="eng-name">乡墅开工与现场交底</text><view class="eng-progress-row"><view class="eng-progress"><view style="width:{{progress.percent}}%"/></view></view><text class="eng-muted">已学{{progress.completed}}/{{progress.total}}节</text><text class="eng-link">继续学习<image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></text></view></button></view>
 <view class="eng-section"><view class="eng-heading"><text>服务与设置</text></view><button class="eng-row eng-profile-service profile-menu" data-view="orders" bindtap="open"><image src="/assets/account-order.jpg"/><text class="eng-grow">我的订单</text><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button><button class="eng-row eng-profile-service profile-menu" data-view="help" bindtap="open"><image src="/assets/account-headset.jpg"/><text class="eng-grow">帮助与反馈</text><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button><button class="eng-row eng-profile-service profile-menu" data-view="privacy" bindtap="open"><image src="/assets/account-shield.jpg"/><text class="eng-grow">账号与隐私</text><image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button></view>
 </block><block wx:else>
<button class="profile-card profile-menu" data-view="{{loggedIn?'profile':'login'}}" bindtap="open"><image wx:if="{{loggedIn}}" class="profile-avatar" src="{{avatar}}" mode="aspectFill"/><image wx:else class="profile-avatar guest-avatar" src="/assets/account-guest-avatar.jpg" mode="aspectFill"/><view class="profile-info"><text class="profile-name">{{loggedIn?name:'欢迎来到众墅之家'}}</text><text class="profile-role">{{loggedIn?company+' · '+role:'登录后使用专属服务'}}</text></view><text class="profile-link {{!loggedIn?'login-link':''}}">{{loggedIn?'个人资料':'登录'}}</text><view wx:if="{{loggedIn}}" class="chevron"/></button>
<view wx:if="{{loggedIn}}" class="quick-card"><button class="profile-menu" data-view="messages" bindtap="open"><image src="/assets/account-message.jpg"/><view><text>消息</text><text class="count">{{unread}}</text></view><view class="chevron"/></button><button class="profile-menu" data-view="personal-performance" bindtap="open"><image src="/assets/account-chart.jpg"/><text>我的绩效</text><text class="brown">查看</text><view class="chevron"/></button></view>
<view wx:if="{{loggedIn}}" class="section service-section"><button class="service-row profile-menu" data-view="identity" bindtap="open"><text>组织与工作身份</text><view class="chevron"/></button><button wx:if="{{teamTitle}}" class="service-row" bindtap="openTeam"><text>{{teamTitle}}</text><view class="chevron"/></button></view><view class="section academy-section"><view class="section-heading"><text class="section-title">学习培训</text><button class="text-link profile-menu" data-view="learning" bindtap="open">全部课程 <view class="chevron"/></button></view><text class="academy-desc">自媒体运营 · 招商 · 设计 · 工程 · AI</text><button class="course-card profile-menu" data-view="course" bindtap="open"><image class="course-image" src="{{courseImage}}" mode="aspectFill"/><view class="course-info"><text class="course-tag">{{loggedIn?'继续学习':'公开课程'}}</text><text class="course-title">AI短视频获客实战</text><block wx:if="{{loggedIn}}"><text class="course-status">已完成{{progress.completed}}/8节</text><view class="progress-track"><view class="progress-value" style="width:{{progress.percent}}%"/></view></block><text class="continue">{{loggedIn?'继续学习':'查看课程'}}</text></view></button></view>
<view wx:if="{{showStoreServices}}" class="section franchise-section"><view class="section-heading"><text class="section-title">加盟商服务</text></view><view class="two-grid"><button class="tile profile-menu" data-view="services" bindtap="open"><image src="/assets/account-shop.jpg"/><text>展陈设计</text><view class="chevron"/></button><button class="tile profile-menu" data-view="procurement" bindtap="open"><image src="/assets/account-bag.jpg"/><text>众墅甄选</text><view class="chevron"/></button></view></view>
<view class="section service-section"><button class="service-row profile-menu" data-view="orders" bindtap="open"><image src="/assets/account-order.jpg"/><view><text>我的订单</text><text wx:if="{{!loggedIn}}" class="muted small">登录后查看</text></view><view class="chevron"/></button><button class="service-row profile-menu" data-view="help" bindtap="open"><image src="/assets/account-headset.jpg"/><text>帮助与反馈</text><view class="chevron"/></button><button class="service-row profile-menu" data-view="{{loggedIn?'privacy':'policy'}}" bindtap="open"><image src="/assets/account-shield.jpg"/><text>{{loggedIn?'账号与隐私':'隐私政策'}}</text><view class="chevron"/></button></view>
<button wx:if="{{!loggedIn}}" class="agreement profile-menu" data-view="agreement" bindtap="open">《用户协议》 ›</button></block><button wx:if="{{loggedIn}}" class="profile-logout" bindtap="logout">退出登录</button></view></view>
