<brand-header title="{{screen==='receipt'?'确认到账':screen==='project'?'项目办理':'跨设备联调'}}" back="{{true}}"/>
<view class="collab-page">
  <view class="simulation-note">模拟数据联调 · 微信通知由模拟网关投递</view>
  <view wx:if="{{pending}}" class="error pending"><text>上一笔操作结果待核实，请先确认原操作。</text><button class="link" bindtap="retry" disabled="{{busy}}">核实上一笔操作</button></view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><button wx:if="{{connected && !pending}}" class="link" bindtap="refresh">刷新状态</button></view>
  <view wx:if="{{!connected}}" class="card">
    <text class="heading">接入模拟工作台</text><text class="muted block">财务与行政分别使用自己的测试接入码，数据通过同一服务端同步。</text>
    <text class="label">联调服务地址</text><input class="input" value="{{endpoint}}" data-key="endpoint" bindinput="input" placeholder="http://电脑局域网地址:8787"/>
    <text class="label">本人测试接入码</text><input class="input" value="{{inviteCode}}" data-key="inviteCode" bindinput="input" password="{{true}}" placeholder="请输入本人接入码"/>
    <view class="page-actions"><button class="solid connect" bindtap="connect" disabled="{{busy}}">{{busy?'正在连接':'进入工作台'}}</button></view>
  </view>
  <block wx:else>
    <view class="sync-row"><text>已同步 {{synchronizedAt}}</text><button class="link messages-entry" data-tab="messages" bindtap="tab">消息 {{unread?('· '+unread):''}}</button></view>
    <block wx:if="{{screen==='receipt'}}">
      <view class="card"><text class="heading">{{activeTask.name}}</text><text class="amount">{{activeTask.amountText}}</text><text class="muted block">核对本笔真实业务来源，示例凭据仅用于本轮联调。</text></view>
      <view class="card"><text class="heading">实际到账登记</text>
        <text class="label">本次到账金额（元）</text><input class="input" type="digit" value="{{form.amount}}" data-form="true" data-key="amount" bindinput="input"/>
        <text class="label">到账日期</text><picker mode="date" value="{{form.date}}" data-form="true" data-key="date" bindchange="input"><view class="input">{{form.date}}　⌄</view></picker>
        <text class="label">银行到账流水</text><input class="input" value="{{form.transaction}}" data-form="true" data-key="transaction" bindinput="input" placeholder="请填写本笔模拟流水"/>
        <text class="label">到账凭据</text><button class="outline proof" bindtap="sampleProof">{{form.proofRef?'已选择模拟银行凭据':'选择模拟银行凭据'}}</button>
        <text class="label">说明（选填）</text><textarea class="input note" value="{{form.note}}" data-form="true" data-key="note" bindinput="input"/>
        <checkbox-group class="check" bindchange="check"><label><checkbox checked="{{form.checked}}" value="checked" color="#824019"/>已核对本笔到账、金额、流水和凭据</label></checkbox-group>
      </view>
      <view class="page-actions"><button class="outline" bindtap="back">返回</button><button class="solid submit" bindtap="submit" disabled="{{busy}}">确认到账并同步</button></view>
    </block>
    <block wx:elif="{{screen==='project'}}">
      <view class="card"><text class="heading">{{activeProject.name}}</text><text class="state">{{activeProject.state}}</text><text class="muted block">{{activeProject.city}} · {{activeProject.scope}}</text></view>
      <view class="card"><text class="heading">设计需求</text><text class="body">{{activeProject.requirement}}</text><view wx:if="{{activeProject.dispatchedAt}}" class="record"><text class="label">正式成果下发记录</text><text class="body">{{activeProject.recipient}} · {{activeProject.dispatchNote}}</text></view></view>
      <view wx:if="{{activeProject.action}}" class="card"><text class="heading">{{activeProject.action==='complete'?'登记设计完成':'登记图纸下发'}}</text>
        <block wx:if="{{activeProject.action==='dispatch'}}"><text class="label">成果接收人</text><input class="input" value="{{form.recipient}}" data-form="true" data-key="recipient" bindinput="input" placeholder="本次成果实际接收人"/></block>
        <text class="label">{{activeProject.action==='complete'?'完成说明（选填）':'交付清单、渠道及说明'}}</text><textarea class="input note" value="{{form.note}}" data-form="true" data-key="note" bindinput="input"/>
        <checkbox-group class="check" bindchange="check"><label><checkbox checked="{{form.checked}}" value="checked" color="#824019"/>{{activeProject.action==='complete'?'设计及内部审核已完成':'本次示例正式图纸已通过模拟渠道下发'}}</label></checkbox-group>
      </view>
      <view class="page-actions"><button class="outline" bindtap="back">返回</button><button wx:if="{{activeProject.action}}" class="solid submit" bindtap="submit" disabled="{{busy}}">{{activeProject.action==='complete'?'设计完成':'成果已下发'}}</button></view>
    </block>
    <block wx:elif="{{tab==='home'}}">
      <view class="greeting"><text>你好，{{actor.name}}</text><text class="muted">{{finance?'总部收款财务':'设计行政'}}</text></view>
      <view class="metrics {{finance?'two':''}}"><view wx:for="{{metrics}}" wx:key="label" class="metric"><text class="muted block">{{item.label}}</text><text class="metric-value">{{item.value}}<text class="unit">{{item.unit}}</text></text></view></view>
      <view class="card"><view class="heading-row"><text class="heading">今日待办 {{tasks.length}}</text><button class="link" data-tab="projects" bindtap="tab">查看全部 ›</button></view>
        <view wx:for="{{tasks}}" wx:key="id" class="task"><view class="grow"><text class="strong block">{{item.name}}</text><text class="muted block">{{finance?item.amountText:'本项目已满足办理条件'}}</text></view><button class="solid small task-action" data-id="{{item.id}}" bindtap="openTask">{{item.actionLabel}}</button></view>
        <text wx:if="{{!tasks.length}}" class="empty block">暂无可办理事项，后续进度将自动同步</text>
      </view>
      <view class="card"><text class="heading">最近办理</text><button wx:for="{{recent}}" wx:key="customerId" class="project-row" data-id="{{item.customerId}}" bindtap="openProject"><view class="grow"><text class="strong block">{{item.name}}</text><text class="muted block">{{item.action}} · {{item.atText}}</text></view><text class="link">查看记录 ›</text></button><text wx:if="{{!recent.length}}" class="empty block">暂无本人的办理记录</text></view>
    </block>
    <block wx:elif="{{tab==='projects'}}">
      <input class="input search" value="{{keyword}}" bindinput="search" placeholder="搜索项目或需求"/>
      <view class="card"><text class="heading">{{finance?'项目进度':'全部项目'}} {{projectRows.length}}</text><button wx:for="{{projectRows}}" wx:key="id" class="project-row" data-id="{{item.id}}" bindtap="openProject"><view class="grow"><text class="strong block">{{item.name}}</text><text class="muted block">{{item.scope}} · {{item.state}}</text></view><text class="link">查看 ›</text></button><text wx:if="{{!projectRows.length}}" class="empty block">暂无匹配项目</text></view>
    </block>
    <block wx:elif="{{tab==='messages'}}">
      <view class="card"><text class="heading">站内消息</text><button wx:for="{{messages}}" wx:key="id" class="message" data-id="{{item.id}}" bindtap="openMessage"><view class="grow"><text class="strong block">{{item.read?'':'● '}}{{item.title}}</text><text class="muted block">{{item.description}}</text></view><text class="link">查看 ›</text></button><text wx:if="{{!messages.length}}" class="empty block">暂无消息</text></view>
      <view class="card"><text class="heading">模拟微信通知</text><button wx:for="{{deliveries}}" wx:key="id" class="mock-delivery" data-id="{{item.id}}" bindtap="openDelivery"><view class="grow"><text class="strong block">{{item.title}}</text><text class="muted block">{{item.description}}</text><text class="muted block">模拟网关已投递 · {{item.sentAtText}}</text></view><text class="link">去办理 ›</text></button><text wx:if="{{!deliveries.length}}" class="empty block">暂无模拟投递记录</text></view>
    </block>
    <block wx:else>
      <view class="card"><text class="heading">{{actor.name}}</text><text class="body">服务端分配的测试身份 · {{finance?'总部收款财务':'设计行政'}}</text><text class="muted block">本机不保存共享账簿，业务以服务端记录为准。</text></view>
      <view wx:if="{{!finance}}" class="card"><text class="heading">模拟微信提醒</text><text class="body">{{consent==='accepted'?'已模拟授权一次通知。到账满足条件后，网关会自动投递。':'请先模拟授权一次通知，再由财务确认到账。'}}</text><button class="outline subscribe" bindtap="subscribe" disabled="{{busy}}">模拟授权一次通知</button><text class="muted block">此操作仅验证发送流程，真实微信授权需后续接入。</text></view>
      <view wx:if="{{jobs.length}}" class="card"><text class="heading">通知发送记录</text><view wx:for="{{jobs}}" wx:key="id" class="job"><text class="body">{{item.statusText}} · 尝试 {{item.attempts}} 次</text><text wx:if="{{item.lastError}}" class="muted block">{{item.lastError}}</text></view></view>
      <button class="outline disconnect" bindtap="disconnect">退出本机联调会话</button>
    </block>
    <view wx:if="{{screen==='workspace'}}" class="workspace-tabs"><button class="{{tab==='home'?'active':''}}" data-tab="home" bindtap="tab">首页</button><button class="{{tab==='projects'?'active':''}}" data-tab="projects" bindtap="tab">项目</button><button class="{{tab==='mine'?'active':''}}" data-tab="mine" bindtap="tab">我的</button></view>
  </block>
</view>
