page{background:#faf8f4;color:#241e19;font-size:28rpx}.collab-page{min-height:100vh;padding:0 28rpx calc(152rpx + env(safe-area-inset-bottom))}.simulation-note{padding:14rpx 18rpx;margin:0 0 20rpx;border-radius:12rpx;background:#f7eddd;color:#98652d;font-size:23rpx;line-height:36rpx}.card{padding:26rpx;margin-bottom:24rpx;border:1rpx solid #ece3d9;border-radius:22rpx;background:#fff}.block,.heading,.label,.body,.state{display:block}.heading{font-size:32rpx;font-weight:600;line-height:46rpx;margin-bottom:18rpx}.body{line-height:1.7;white-space:pre-wrap;word-break:break-all}.label{margin:24rpx 0 12rpx;font-size:27rpx;line-height:1.6}.muted{font-size:25rpx;line-height:1.65;color:#827c76}.input{box-sizing:border-box;width:100%;min-height:86rpx;border:1rpx solid #e5ddd3;border-radius:12rpx;background:#fbf9f6;padding:18rpx;font-size:28rpx;line-height:1.5}.note{height:160rpx}.solid,.outline{min-height:84rpx;padding:18rpx 24rpx;border-radius:14rpx;font-size:28rpx;line-height:46rpx}.solid{background:#89512a;color:#fff}.outline{border:1rpx solid #ae774d;color:#89512a;background:#fff}.small{min-height:64rpx;padding:10rpx 22rpx;font-size:26rpx;white-space:nowrap}.proof,.subscribe{width:100%;margin:12rpx 0 18rpx}.check{margin-top:24rpx;line-height:1.7}.check checkbox{transform:scale(.85);vertical-align:top}.amount{display:block;font-size:42rpx;color:#89512a;font-weight:600;margin-bottom:12rpx}.state{color:#995226;font-weight:600;margin:0 0 12rpx}.error{padding:20rpx;margin-bottom:20rpx;border:1rpx solid #e6b9aa;border-radius:14rpx;background:#fff1e9;color:#923d2b;line-height:1.6}.error .link{display:inline-block;margin-right:20rpx;padding:10rpx 0}.link{color:#89512a;font-size:25rpx;line-height:40rpx;white-space:nowrap}.sync-row{display:flex;align-items:center;justify-content:space-between;color:#827c76;font-size:23rpx;margin:0 0 18rpx}.greeting{display:flex;flex-wrap:wrap;align-items:center;gap:18rpx;margin:0 0 24rpx}.greeting>text:first-child{font-size:34rpx;font-weight:600;line-height:48rpx}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin-bottom:28rpx}.metrics.two{grid-template-columns:repeat(2,minmax(0,1fr))}.metric{background:#fff;border:1rpx solid #e7ded1;border-radius:20rpx;padding:24rpx 18rpx;min-width:0}.metric-value{display:block;font-size:38rpx;font-weight:600;color:#78421d;line-height:58rpx;word-break:break-all}.unit{font-size:23rpx;font-weight:400;color:#9b8977;margin-left:6rpx}.heading-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.task,.project-row,.message,.mock-delivery{display:flex;align-items:center;gap:20rpx;width:100%;padding:22rpx 0;border-bottom:1rpx solid #eee7de;text-align:left}.task:last-child,.project-row:last-child,.message:last-child,.mock-delivery:last-child{border-bottom:0}.grow{flex:1;min-width:0}.strong{font-weight:600;line-height:1.6}.empty{font-size:25rpx;line-height:1.7;padding:22rpx 0}.record{margin-top:20rpx;border-top:1rpx solid #eee7de}.job{padding:14rpx 0;border-bottom:1rpx solid #eee7de}.search{margin:0 0 24rpx}.workspace-tabs{position:fixed;bottom:0;left:0;right:0;display:flex;padding:16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e6e1d9;z-index:10}.workspace-tabs button{flex:1;min-height:68rpx;line-height:68rpx;color:#89837d;font-size:27rpx}.workspace-tabs .active{font-weight:600;color:#89512a}.disconnect{width:100%;margin-top:24rpx}.page-actions{position:static;padding-bottom:0;margin-bottom:0}@media(max-width:360px){.metric{padding:20rpx 12rpx}.metric .muted{font-size:22rpx}.metric-value{font-size:34rpx}}
