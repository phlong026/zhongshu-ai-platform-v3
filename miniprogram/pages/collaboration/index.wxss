page{background:var(--zs-bg);color:#241e19;font-size:var(--zs-font-emphasis)}.collab-page{min-height:100vh;padding:0 var(--zs-space-page) calc(152rpx + env(safe-area-inset-bottom))}.simulation-note{padding:14rpx 18rpx;margin:0 0 20rpx;border-radius:12rpx;background:#f7eddd;color:#98652d;font-size:var(--zs-font-meta);line-height:36rpx}.card{padding:var(--zs-space-card);margin-bottom:var(--zs-space-section);border:1rpx solid var(--zs-line);border-radius:var(--zs-radius);background:var(--zs-card)}.block,.heading,.label,.body,.state{display:block}.heading{font-size:var(--zs-font-title);font-weight:600;line-height:46rpx;margin-bottom:18rpx}.body{line-height:1.7;white-space:pre-wrap;word-break:break-all}.label{margin:24rpx 0 12rpx;font-size:var(--zs-font-emphasis);line-height:1.6}.muted{font-size:var(--zs-font-body);line-height:1.65;color:#827c76}.input{box-sizing:border-box;width:100%;min-height:86rpx;border:1rpx solid #e5ddd3;border-radius:12rpx;background:#fbf9f6;padding:18rpx;font-size:var(--zs-font-emphasis);line-height:1.5}.note{height:160rpx}.solid,.outline{display:flex;align-items:center;justify-content:center;min-height:var(--zs-control-height);height:auto;padding:20rpx 24rpx;white-space:normal;overflow-wrap:anywhere;border-radius:14rpx;font-size:var(--zs-font-emphasis);line-height:46rpx}.solid{background:var(--zs-brand);color:var(--zs-card)}.outline{border:1rpx solid #ae774d;color:var(--zs-brand);background:var(--zs-card)}.small{min-height:64rpx;padding:10rpx 22rpx;font-size:var(--zs-font-body);white-space:nowrap}.proof,.subscribe{width:100%;margin:12rpx 0 18rpx}.check{margin-top:24rpx;line-height:1.7}.check checkbox{transform:scale(.85);vertical-align:top}.amount{display:block;font-size:var(--zs-font-heading);color:var(--zs-brand);font-weight:600;margin-bottom:12rpx}.state{color:#995226;font-weight:600;margin:0 0 12rpx}.error{padding:20rpx;margin-bottom:20rpx;border:1rpx solid #e6b9aa;border-radius:14rpx;background:#fff1e9;color:var(--zs-danger);line-height:1.6}.error .link{display:inline-block;margin-right:20rpx;padding:10rpx 0}.link{color:var(--zs-brand);font-size:var(--zs-font-body);line-height:40rpx;white-space:nowrap}.sync-row{display:flex;align-items:center;justify-content:space-between;color:#827c76;font-size:var(--zs-font-meta);margin:0 0 18rpx}.greeting{display:flex;flex-wrap:wrap;align-items:center;gap:18rpx;margin:0 0 24rpx}.greeting>text:first-child{font-size:var(--zs-font-title);font-weight:600;line-height:48rpx}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin-bottom:28rpx}.metrics.two{grid-template-columns:repeat(2,minmax(0,1fr))}.metric{background:var(--zs-card);border:1rpx solid #e7ded1;border-radius:20rpx;padding:24rpx 18rpx;min-width:0}.metric-value{display:block;font-size:var(--zs-font-heading);font-weight:600;color:#78421d;line-height:58rpx;word-break:break-all}.unit{font-size:var(--zs-font-meta);font-weight:400;color:#9b8977;margin-left:6rpx}.heading-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.task,.project-row,.message,.mock-delivery{display:flex;align-items:center;gap:20rpx;width:100%;padding:22rpx 0;border-bottom:1rpx solid #eee7de;text-align:left}.task:last-child,.project-row:last-child,.message:last-child,.mock-delivery:last-child{border-bottom:0}.grow{flex:1;min-width:0}.strong{font-weight:600;line-height:1.6}.empty{font-size:var(--zs-font-body);line-height:1.7;padding:22rpx 0}.record{margin-top:20rpx;border-top:1rpx solid #eee7de}.job{padding:14rpx 0;border-bottom:1rpx solid #eee7de}.search{margin:0 0 24rpx}.workspace-tabs{position:fixed;bottom:0;left:0;right:0;display:flex;padding:16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));background:var(--zs-card);border-top:1rpx solid #e6e1d9;z-index:10}.workspace-tabs button{flex:1;min-height:68rpx;line-height:68rpx;color:#89837d;font-size:var(--zs-font-emphasis)}.workspace-tabs .active{font-weight:600;color:var(--zs-brand)}.disconnect{width:100%;margin-top:24rpx}.page-actions{position:static;padding-bottom:0;margin-bottom:0}@media(max-width:360px){.metric{padding:20rpx 12rpx}.metric .muted{font-size:var(--zs-font-caption)}.metric-value{font-size:var(--zs-font-title)}}

.collab-page .solid[disabled],.collab-page .outline[disabled]{background:var(--zs-line);border-color:var(--zs-line);color:var(--zs-text-3);opacity:1}
