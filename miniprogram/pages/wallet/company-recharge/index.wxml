<brand-header title="公司额度充值" back="{{true}}"/>
<view class="recharge">
  <view wx:if="{{company}}" class="company"><text>充值到公司额度池</text><text class="company-name">{{company}}</text></view>
  <view wx:if="{{loading}}" class="panel message">正在读取充值套餐…</view>
  <view wx:elif="{{error}}" class="panel message"><text>{{error}}</text><button class="retry" bindtap="retry">重新加载</button></view>
  <block wx:else>
    <view wx:if="{{order}}" class="panel">
      <text class="heading">{{order.label}}</text><text class="summary">{{order.amount}} · {{order.credits}} 额度</text>
      <text class="minor">订单号 {{order.id}}</text>
      <button wx:if="{{order.canPay&&enabled}}" class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="checkout">继续支付原订单 {{order.amount}}</button>
      <text wx:if="{{order.quoteExpired}}" class="minor">套餐已调整。等微信确认原单后再充值，请勿重复付款。</text>
      <button wx:if="{{order.status==='CREDITED'||order.status==='CLOSED'||order.status==='FAILED'||order.status==='REFUNDED'||order.status==='REFUND_REVIEW'}}" class="retry" bindtap="dismissOrder">返回套餐</button>
      <button wx:if="{{order.status==='PROCESSING'||order.status==='PAID'||order.status==='REFUNDING'}}" class="retry" bindtap="retry">刷新订单状态</button>
    </view>
    <view wx:elif="{{!hasPlans}}" class="panel message"><text>{{enabled||browseOnly?'暂无可购买的充值套餐':reason}}</text><button class="retry" bindtap="retry">刷新套餐</button></view>
    <view wx:else class="panel">
      <text class="heading">{{browseOnly?'充值套餐':'选择充值套餐'}}</text>
      <view class="plans"><button wx:for="{{plans}}" wx:key="id" class="plan {{selected.id===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="choose" disabled="{{busy||browseOnly}}">
        <text class="plan-name">{{item.name}}</text><text class="price">{{item.amount}}</text><text class="minor">到账 {{item.credits}} 额度</text>
      </button></view>
      <text wx:if="{{browseOnly}}" class="note">{{reason}}</text>
      <button wx:else class="primary" disabled="{{!selected||busy}}" loading="{{busy}}" bindtap="checkout">{{selected?'确认充值 '+selected.amount:'请选择套餐'}}</button>
    </view>
    <text wx:if="{{note}}" class="note">{{note}}</text>
  </block>
</view>
