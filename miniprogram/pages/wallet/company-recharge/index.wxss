.closed-page {
  padding: var(--zs-space-page);
}
.closed-panel {
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--zs-surface, #fff);
}
.closed-title, .closed-message {
  display: block;
}
.closed-title {
  font-size: var(--zs-font-heading, 32rpx);
  font-weight: 600;
}
.closed-message {
  margin-top: 12rpx;
  color: var(--zs-text-3);
  font-size: var(--zs-font-body);
}
.closed-action {
  margin-top: 28rpx;
  border-radius: 12rpx;
  background: var(--zs-brand);
  color: #fff;
}
