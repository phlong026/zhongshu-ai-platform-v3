<import src="./parts.wxml"/>
<view class="entrust-page">
  <business-header title="外部设计委托"/>
  <view class="entrust-body">
    <view wx:if="{{error||conflict||uncertain}}" class="entrust-error" role="alert"><text>{{error||(conflict?'委托或付款计划已更新，请载入最新记录后重新核对。':'')}}</text><button wx:if="{{uncertain}}" class="entrust-link" loading="{{busy}}" disabled="{{busy}}" bindtap="runPending">用原请求重试核对</button><button wx:elif="{{conflict}}" class="entrust-link" bindtap="reloadLatest">载入最新记录</button></view>
    <view wx:if="{{loading&&!ready}}" class="entrust-empty">正在读取委托…</view>
    <view wx:elif="{{!ready}}" class="entrust-empty"><text>暂无可查看的委托内容</text><button class="entrust-secondary" bindtap="load">重新加载</button><button class="entrust-link" bindtap="chooseIdentity">登录或切换工作身份</button></view>
    <block wx:else>
      <view class="entrust-card"><view class="entrust-heading"><text>{{context.customerName||'客户委托'}}</text><text class="entrust-badge">{{context.statusLabel}}</text></view><text wx:if="{{context.commissionId}}" class="entrust-muted entrust-spaced">委托编号 {{context.commissionId}}</text><text wx:else class="entrust-muted entrust-spaced">填写真实委托需求，后续登记外部交付成果</text></view>
      <view class="entrust-tabs"><button class="{{tab==='request'?'selected':''}}" data-tab="request" bindtap="changeTab">委托需求</button><button class="{{tab==='result'?'selected':''}}" data-tab="result" bindtap="changeTab">外部成果</button><button class="{{tab==='history'?'selected':''}}" data-tab="history" bindtap="changeTab">历史记录</button></view>
      <view wx:if="{{context.mode==='LEGACY'}}" class="entrust-card"><text class="entrust-heading">原委托记录</text><text class="entrust-muted entrust-spaced">{{context.canConvert?'转入后保留原编号及历史记录，重新登记外部需求和成果。':'当前记录保留在原流程，暂不能转入外部委托。'}}</text><view class="entrust-actions"><button class="entrust-secondary" bindtap="openLegacy">查看原记录</button><button wx:if="{{context.canConvert&&!editing}}" class="entrust-primary" data-action="convert" bindtap="startEdit">转入外部流程</button></view></view>
      <block wx:if="{{tab==='request'}}">
        <block wx:if="{{editing==='register'||editing==='convert'}}">
          <view class="entrust-card"><view class="entrust-heading"><text>{{editing==='convert'?'转入外部流程':context.request?'变更委托需求':'登记委托需求'}}</text><text class="entrust-muted">{{context.request?'当前 V'+context.request.version:''}}</text></view>
            <view class="entrust-field"><text class="entrust-label">实际委托日期 <text class="entrust-required">*</text></text><picker mode="date" value="{{form.entrustedOn}}" end="{{today}}" data-key="entrustedOn" bindchange="input" disabled="{{busy||uploading||uncertain||conflict}}"><view class="entrust-input entrust-picker">{{form.entrustedOn||'请选择实际委托日期'}}<text>›</text></view></picker></view>
            <view wx:for="{{requestFields}}" wx:key="key" class="entrust-field"><text class="entrust-label">{{item.label}} <text wx:if="{{item.required}}" class="entrust-required">*</text></text><textarea wx:if="{{item.kind==='textarea'}}" class="entrust-input entrust-textarea" value="{{form[item.key]}}" data-key="{{item.key}}" maxlength="{{item.max}}" placeholder="{{item.placeholder}}" bindinput="input" disabled="{{busy||uploading||uncertain||conflict}}"/><input wx:else class="entrust-input" type="{{item.type||'text'}}" value="{{form[item.key]}}" data-key="{{item.key}}" maxlength="{{item.max}}" placeholder="{{item.placeholder}}" bindinput="input" disabled="{{busy||uploading||uncertain||conflict}}"/></view>
            <view class="entrust-field"><text class="entrust-label">委托附件 <text class="entrust-muted">{{form.attachments.length}} / 20</text></text><template is="files" data="{{files:form.attachments,removable:true,locked:busy||uploading||uncertain||conflict}}"/><view wx:if="{{form.attachments.length<20}}" class="entrust-actions"><button class="entrust-secondary" data-slot="attachments" bindtap="chooseFile" disabled="{{busy||uploading||uncertain||conflict||uploadFailed}}">选择文件</button><button class="entrust-secondary" data-slot="attachments" bindtap="choosePhoto" disabled="{{busy||uploading||uncertain||conflict||uploadFailed}}">拍照 / 相册</button></view><text class="entrust-muted entrust-spaced">PDF、JPG、PNG，每份不超过 30MB</text></view>
            <view wx:if="{{context.request||editing==='convert'}}" class="entrust-field"><text class="entrust-label">{{editing==='convert'?'转入原因':'变更原因'}} <text class="entrust-required">*</text></text><textarea class="entrust-input entrust-textarea" value="{{form.reason}}" data-key="reason" bindinput="input" maxlength="500" placeholder="说明此次办理原因" disabled="{{busy||uploading||uncertain||conflict}}"/><text wx:if="{{context.result}}" class="entrust-muted entrust-spaced">本次需求保存后，原成果留在历史中，新需求需重新登记对应成果。</text></view>
          </view>
          <view class="entrust-card"><template is="plan" data="{{plan:context.currentPlan}}"/><text class="entrust-muted entrust-spaced">提交时保存当前约定的版本</text><button class="entrust-link" bindtap="openPlan">{{context.currentPlan.source==='CONTRACT'?'查看合同付款约定':'填写 / 查看付款草案'}}</button></view>
        </block>
        <block wx:elif="{{context.request}}"><view class="entrust-card"><view class="entrust-heading"><text>委托需求 V{{context.request.version}}</text><button wx:if="{{context.canRegister}}" class="entrust-link" data-action="register" bindtap="startEdit">变更需求</button></view><template is="request" data="{{record:context.request}}"/></view><view class="entrust-card"><template is="plan" data="{{plan:context.request.plan}}"/><text class="entrust-muted entrust-spaced">本版委托提交时的约定</text><button class="entrust-link" bindtap="openPlan">查看当前付款约定</button></view></block>
        <view wx:elif="{{context.mode!=='LEGACY'}}" class="entrust-card entrust-empty"><text>尚未登记外部委托需求</text><button wx:if="{{context.canRegister}}" class="entrust-primary" data-action="register" bindtap="startEdit">登记委托需求</button></view>
      </block>
      <block wx:elif="{{tab==='result'}}">
        <view wx:if="{{editing==='results'}}" class="entrust-card"><view class="entrust-heading"><text>{{context.result?'更正外部成果':'登记外部成果'}}</text><text class="entrust-muted">需求 V{{context.request.version}}</text></view>
          <view class="entrust-field"><text class="entrust-label">实际交付日期 <text class="entrust-required">*</text></text><picker mode="date" value="{{form.deliveredOn}}" end="{{today}}" data-key="deliveredOn" bindchange="input" disabled="{{busy||uploading||uncertain||conflict}}"><view class="entrust-input entrust-picker">{{form.deliveredOn||'请选择实际交付日期'}}<text>›</text></view></picker></view>
          <view class="entrust-field"><text class="entrust-label">图纸版本 <text class="entrust-required">*</text></text><input class="entrust-input" value="{{form.drawingVersion}}" data-key="drawingVersion" maxlength="64" placeholder="例如：外部施工图 V2" bindinput="input" disabled="{{busy||uploading||uncertain||conflict}}"/></view>
          <view wx:for="{{fileSlots}}" wx:key="key" class="entrust-field"><text class="entrust-label">{{item.label}} <text class="entrust-required">*</text></text><button wx:if="{{item.assetId}}" class="entrust-file-name entrust-file" data-asset-id="{{item.assetId}}" data-kind="results" data-version="{{context.result.version}}" bindtap="previewFile">{{item.title}} · 查看</button><view class="entrust-actions"><button class="entrust-secondary" data-slot="{{item.key}}" bindtap="chooseFile" disabled="{{busy||uploading||uncertain||conflict||uploadFailed}}">{{item.assetId?'替换文件':'选择文件'}}</button><button class="entrust-secondary" data-slot="{{item.key}}" bindtap="choosePhoto" disabled="{{busy||uploading||uncertain||conflict||uploadFailed}}">拍照 / 相册</button></view></view>
          <text class="entrust-muted entrust-spaced">PDF、JPG、PNG，每份不超过 30MB</text>
          <view class="entrust-field"><text class="entrust-label">{{context.result?'更正原因':'成果说明'}} <text wx:if="{{context.result}}" class="entrust-required">*</text></text><textarea class="entrust-input entrust-textarea" value="{{form.note}}" data-key="note" maxlength="1000" placeholder="{{context.result?'说明更正了哪些内容':'记录本次成果交付情况，可选填'}}" bindinput="input" disabled="{{busy||uploading||uncertain||conflict}}"/></view>
        </view>
        <view wx:elif="{{context.result}}" class="entrust-card"><view class="entrust-heading"><text>成果记录 V{{context.result.version}}</text><button wx:if="{{context.canResults}}" class="entrust-link" data-action="results" bindtap="startEdit">更正成果</button></view><template is="result" data="{{record:context.result}}"/></view>
        <view wx:else class="entrust-card entrust-empty"><text>{{context.request?'等待外部服务方交付成果':'先登记委托需求，再登记对应成果'}}</text><button wx:if="{{context.canResults}}" class="entrust-primary" data-action="results" bindtap="startEdit">登记外部成果</button></view>
      </block>
      <block wx:elif="{{tab==='history'}}">
        <view wx:if="{{!context.history.length}}" class="entrust-card entrust-empty">暂无外部委托版本记录</view>
        <view wx:for="{{context.history}}" wx:key="key" class="entrust-card"><button class="entrust-history-heading" data-key="{{item.key}}" bindtap="toggleHistory"><view><text>{{item.title}} V{{item.version}}</text><text class="entrust-muted">{{item.description}} · {{item.occurredOn}}</text></view><text>{{historyKey===item.key?'收起':'查看'}}</text></button><block wx:if="{{historyKey===item.key}}"><template is="{{item.kind==='requests'?'request':'result'}}" data="{{record:item}}"/><view wx:if="{{item.kind==='requests'}}" class="entrust-history-plan"><template is="plan" data="{{plan:item.plan}}"/></view><text class="entrust-muted entrust-spaced">记录日期 {{item.createdOn||'—'}}{{item.actorUserId?' · 经办人编号 '+item.actorUserId:''}}</text></block></view>
        <button wx:if="{{context.hasLegacy}}" class="entrust-link" bindtap="openLegacy">查看原委托及费用历史</button>
      </block>
      <view wx:if="{{uploading||uploadFailed}}" class="entrust-upload"><text>{{uploadName}}</text><text>{{uploading?'正在上传并验收文件…':uploadRetryable?'上传结果待核对':'文件验收未通过，请重新选择'}}</text><view wx:if="{{!uploading}}" class="entrust-actions"><button wx:if="{{uploadRetryable}}" class="entrust-secondary" bindtap="retryUpload">重试核对</button><button wx:if="{{uploadRestartAllowed}}" class="entrust-secondary" bindtap="restartUpload">重新上传</button><button class="entrust-link" bindtap="discardUpload">取消本次选择</button></view></view>
    </block>
  </view>
  <view wx:if="{{ready&&editing}}" class="entrust-footer"><button class="entrust-primary" loading="{{busy}}" disabled="{{busy||uploading||uploadFailed||uncertain||conflict}}" bindtap="submit">{{editing==='convert'?'确认转入外部流程':editing==='results'?'保存外部成果':'保存委托需求'}}</button></view>
</view>
