<view class="page engineering-desk materials-page">
  <brand-header title="材料" divider="{{true}}"/>
  <view class="eng-content">
    <view wx:if="{{error}}" class="eng-empty">
      <text class="eng-error">{{error}}</text>
      <button class="eng-outline" bindtap="retry">重新打开</button>
      <button class="eng-link" bindtap="home">返回工程首页</button>
    </view>
    <view wx:else class="eng-empty"><text>正在打开材料页面…</text></view>
  </view>
</view>
