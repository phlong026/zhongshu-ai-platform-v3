@import "../../../styles/component-tokens.wxss";
@import "../../../styles/subpage-navigation.wxss";
:host{display:block}.header{position:fixed;top:0;left:0;right:0;z-index:90;background:var(--zs-bg)}.nav{height:82rpx;display:flex;align-items:center;justify-content:center;position:relative;font-size:var(--zs-font-title);font-weight:600;color:var(--zs-ink)}.back{position:absolute;left:12rpx;top:0;width:76rpx;height:82rpx;display:flex;align-items:center;justify-content:center;background:transparent}.back image{width:23rpx;height:34rpx}.back::after{border:0}

.nav{font-family:var(--zs-font-family);font-size:var(--zs-font-title);font-weight:600;line-height:40rpx}
