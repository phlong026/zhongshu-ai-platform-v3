<view class="wb-root page engineering-desk engineering-home">
<brand-header title="工程工作台" divider="{{true}}"/>  <view wx:if="{{eng}}" class="eng-content wb-content">
    <view class="eng-hello wb-greeting"><text>你好，{{eng.name}}</text></view>
    <home-overview id="role-overview" role="engineering"/>
    <view wx:if="{{platformTodos&&platformTodos.status!=='idle'}}" class="eng-section home-todo-shell"><text wx:if="{{platformTodos.warning}}" class="eng-muted pt-warning">{{platformTodos.warning}}</text><block wx:if="{{platformTodos.status==='loading'}}"><text class="eng-muted">待办加载中…</text></block><block wx:elif="{{platformTodos.status==='degraded'}}"><text class="eng-muted">{{platformTodos.message||'待办暂时无法加载'}}</text><button class="eng-outline pt-retry" bindtap="retryPlatformTodos">重新加载</button></block><block wx:elif="{{platformTodos.status==='partial-empty'}}"><text class="eng-muted">已加载部分暂无待办</text><button class="eng-outline pt-retry" bindtap="retryPlatformTodos">重新加载</button></block><block wx:else><todo-preview appearance="home" id="today-todos" rows="{{platformTodos.rows}}" scope="{{platformTodos.sessionGen+':'+platformTodos.postKey}}" bind:activate="openPlatformTodo"/></block><view wx:if="{{platformTodos.refreshError}}"><text class="eng-muted">待办更新失败：{{platformTodos.refreshError}}</text><button class="eng-outline pt-retry" bindtap="retryPlatformTodos">重试</button></view></view>
    <view wx:if="{{error}}" class="eng-section"><text class="eng-error">{{error}}</text><button class="eng-outline pt-retry" bindtap="retryLoad">重新加载</button></view>
    <view class="eng-section wb-tools"><view class="eng-heading"><text>常用功能</text></view><view class="eng-tools"><button class="eng-shortcut" data-action="projects" bindtap="openEngineering"><view class="eng-tool-icon"><image src="/pages/engineering/assets/folder.png"/></view><text>我的项目</text></button><button class="eng-shortcut" data-action="prepare" bindtap="openEngineering"><view class="eng-tool-icon"><image src="/pages/engineering/assets/tasks.png"/></view><text>开工准备</text></button><button class="eng-shortcut" data-action="schedule" bindtap="openEngineering"><view class="eng-tool-icon"><image src="/pages/engineering/assets/calendar.png"/></view><text>施工计划</text></button><button class="eng-shortcut" data-action="materials" bindtap="openEngineering"><view class="eng-tool-icon"><image src="/pages/engineering/assets/material.png"/></view><text>施工材料</text></button></view></view>
    <view class="eng-section eng-recent">
      <view class="eng-heading"><text>重点项目</text></view>
      <button wx:if="{{eng.recent}}" class="eng-row eng-recent-project" data-url="{{eng.recent.url}}" bindtap="openEngineering" hover-class="pressed">
        <image class="eng-thumb" src="{{eng.recent.image}}" mode="aspectFill"/>
        <view class="eng-grow"><text class="eng-name">{{eng.recent.name}}</text><text class="eng-tag">{{eng.recent.stage}}</text><text class="eng-muted">{{eng.recent.date?'开工 '+eng.recent.date:'待完善开工信息'}}</text></view>
        <image class="eng-arrow" src="/assets/creation-chevron-muted.png"/>
      </button>
      <text wx:else class="eng-muted">暂无项目</text>
      <view wx:if="{{eng.projectCount>1}}" class="eng-recent-footer"><button class="eng-link" data-action="projects" bindtap="openEngineering">显示更多<image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button></view>
    </view>
    <view class="eng-section"><view class="eng-heading"><text>众墅甄选</text></view><button class="eng-store-button" data-action="store" bindtap="openEngineering" aria-label="众墅甄选，进入供应链材料商店"><image class="eng-store-banner" src="/pages/build/assets/materials-banner.jpg" mode="widthFix"/></button></view>
  </view>
</view><custom-tab-bar active-index="{{2}}" nested="{{true}}"/>
