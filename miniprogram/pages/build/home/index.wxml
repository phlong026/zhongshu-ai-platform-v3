<view class="page engineering-desk engineering-home">
<brand-header title="工程工作台" divider="{{true}}"/>  <view wx:if="{{eng}}" class="eng-content">
    <view class="eng-hello"><text>你好，{{eng.name}}</text></view><text class="eng-muted eng-date">{{eng.date}}</text>
    <view class="eng-section"><stat-grid items="{{eng.stats}}" bind:stattap="openStat"/></view>
    <view wx:if="{{error}}" class="eng-section"><text class="eng-error">{{error}}</text><button class="eng-outline pt-retry" bindtap="retryLoad">重新加载</button></view>
    <view wx:if="{{platformTodos&&platformTodos.status!=='idle'}}" class="eng-section"><view class="eng-heading"><text>平台待办</text><text wx:if="{{platformTodos.status==='ready'||platformTodos.status==='partial'}}" class="eng-muted">已加载可办理 {{platformTodos.count}} 件</text></view><text wx:if="{{platformTodos.warning}}" class="eng-muted pt-warning">{{platformTodos.warning}}</text><block wx:if="{{platformTodos.status==='loading'}}"><text class="eng-muted">待办加载中…</text></block><block wx:elif="{{platformTodos.status==='degraded'}}"><text class="eng-muted">{{platformTodos.message||'待办暂时无法加载'}}</text><button class="eng-outline pt-retry" bindtap="retryPlatformTodos">重新加载</button></block><block wx:elif="{{platformTodos.status==='ready'&&platformTodos.rows.length===0}}"><text class="eng-muted">暂无待办</text></block><block wx:elif="{{platformTodos.status==='partial-empty'}}"><text class="eng-muted">已加载部分暂无待办</text><button class="eng-outline pt-retry" bindtap="retryPlatformTodos">重新加载</button></block><block wx:else><view wx:for="{{platformTodos.rows}}" wx:key="key" class="eng-row pt-row {{item.clickable?'':'pt-row-disabled'}}" data-path="{{item.path}}" data-clickable="{{item.clickable}}" bindtap="openPlatformTodo"><view class="eng-grow"><text class="eng-name">{{item.title}}</text><text class="eng-muted">{{item.typeLabel}} · {{item.actionHint}}</text></view><text wx:if="{{item.amount}}" class="eng-todo-title">{{item.amount}}</text></view></block></view>
    <view class="eng-section"><view class="eng-heading"><text>常用功能</text></view><view class="eng-tools"><button class="eng-shortcut" data-action="projects" bindtap="openEngineering"><view class="eng-tool-icon"><image src="/pages/engineering/assets/folder.png"/></view><text>我的项目</text></button><button class="eng-shortcut" data-action="prepare" bindtap="openEngineering"><view class="eng-tool-icon"><image src="/pages/engineering/assets/tasks.png"/></view><text>开工准备</text></button><button class="eng-shortcut" data-action="schedule" bindtap="openEngineering"><view class="eng-tool-icon"><image src="/pages/engineering/assets/calendar.png"/></view><text>施工计划</text></button><button class="eng-shortcut" data-action="materials" bindtap="openEngineering"><view class="eng-tool-icon"><image src="/pages/engineering/assets/material.png"/></view><text>施工材料</text></button></view></view>
    <view class="eng-section eng-recent"><view class="eng-heading"><text>最近项目</text><button class="eng-link" data-action="projects" bindtap="openEngineering">查看全部<image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button></view><view wx:if="{{eng.recent}}" class="eng-row"><image class="eng-thumb" src="{{eng.recent.image}}" mode="aspectFill"/><view class="eng-grow"><text class="eng-name">{{eng.recent.name}}</text><text class="eng-muted">{{eng.recent.stage}}</text><text class="eng-muted">{{eng.recent.status==='待开工'?'待核查开工条件':eng.recent.progressKnown?'进度 '+eng.recent.progress+'%':'进度以项目详情为准'}}</text><text wx:if="{{eng.recent.overdue}}" class="eng-tag tone-danger">逾期{{eng.recent.overdue}}个节点</text><view wx:if="{{eng.recent.progressKnown}}" class="eng-progress-row"><view class="eng-progress"><view style="width:{{eng.recent.progress}}%"/></view></view></view><button class="eng-primary" data-url="{{eng.recent.url}}" bindtap="openEngineering">继续办理</button></view><text wx:else class="eng-muted">接收工程或查看项目后，可在这里继续办理。</text></view>
    <view class="eng-section"><view class="eng-heading"><text>众墅甄选</text></view><button class="eng-store-button" data-action="store" bindtap="openEngineering" aria-label="众墅甄选，进入供应链材料商店"><image class="eng-store-banner" src="/assets/materials-banner.jpg" mode="widthFix"/></button><view class="eng-store-note"><text class="eng-muted">供应链材料商店</text><button class="eng-link" data-action="store" bindtap="openEngineering">进入材料商店<image class="eng-arrow" src="/assets/creation-chevron-muted.png"/></button></view></view>
  </view>
</view><custom-tab-bar active-index="{{2}}" nested="{{true}}"/>
