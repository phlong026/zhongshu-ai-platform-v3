<template name="sections">
 <view wx:for="{{sections}}" wx:for-item="section" wx:for-index="sectionIndex" wx:key="index" class="card section section-{{sectionIndex}} {{section.columns?'columns':''}}">
  <view wx:if="{{section.title}}" class="heading"><image wx:if="{{section.headingIcon}}" class="heading-icon" src="/pages/build/assets/{{section.headingIcon}}.jpg"/><text>{{section.title}}</text><text wx:if="{{section.badge}}" class="badge">{{section.badge}}</text><text wx:if="{{section.caption}}" class="caption">{{section.caption}}</text></view>
  <block wx:for="{{section.items}}" wx:for-item="item" wx:key="index">
   <view wx:if="{{item.type==='kv'}}" class="kv"><text class="label">{{item.label}}</text><text class="value">{{item.value}}</text></view>
   <view wx:elif="{{item.type==='notice'}}" class="notice"><text>{{item.value}}</text></view>
   <view wx:elif="{{item.type==='text'}}" class="block-text {{section.good?'good-text':''}}"><image wx:if="{{section.good}}" src="/assets/studio-check-green.png"/>{{item.value}}</view>
   <view wx:elif="{{item.type==='field'}}" class="field"><text class="label">{{item.label}}<text wx:if="{{item.required}}" class="required"> *</text></text><picker wx:if="{{item.kind==='date'||item.kind==='time'}}" mode="{{item.kind}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="pick"><view class="control {{form[item.key]?'':'placeholder'}}">{{form[item.key]||(item.kind==='date'?'请选择日期':'请选择时间')}}<image class="arrow" src="/assets/creation-chevron-muted.png"/></view></picker><input wx:else value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" type="{{item.kind==='digit'?'digit':item.kind==='number'?'number':'text'}}" placeholder="{{item.label==='项目名称'?'请输入项目名称':item.label==='客户称呼'?'请输入客户称呼':'请输入'}}" class="control" maxlength="200" aria-label="{{item.label}}"/></view>
   <view wx:elif="{{item.type==='material-mode'}}" class="material-mode"><button class="{{form.materialMode==='常用材料'?'selected':''}}" data-mode="常用材料" bindtap="materialMode">常用材料</button><button class="{{form.materialMode!=='常用材料'?'selected':''}}" data-mode="自定义材料" bindtap="materialMode">自定义材料</button></view>
   <view wx:elif="{{item.type==='pick'}}" class="field"><text class="label">{{item.label}}</text><picker range="{{item.displayValues||item.values}}" data-values="{{item.values}}" data-key="{{item.key}}" bindchange="pick"><view class="control">{{item.valueNames?item.valueNames[form[item.key]]||'请选择':form[item.key]||'请选择'}}<image class="arrow" src="/assets/creation-chevron-muted.png"/></view></picker></view>
   <view wx:elif="{{item.type==='file'}}" class="file-wrap"><text wx:if="{{item.required}}" class="file-label">{{item.label}}<text class="required"> *</text></text><button class="file-row" data-key="{{item.key}}" data-file="{{item.savedFile||form[item.key]}}" bindtap="{{item.savedFile?'preview':'upload'}}"><image class="file-icon" src="{{item.savedFile||form[item.key]?'/pages/build/assets/pdf.jpg':item.key==='photo'?'/pages/build/assets/camera.jpg':'/pages/build/assets/plus.jpg'}}" mode="aspectFit"/><view class="flex"><text class="row-name">{{item.savedFile?item.label:form[item.key]?form[item.key].name:view==='new'?item.label:item.key==='photo'?'拍照或上传':item.key==='ownerFile'?'上传业主已签凭证':'上传'+item.label}}</text><text wx:if="{{item.description}}" class="muted">{{item.description}}</text><text wx:elif="{{form[item.key]&&form[item.key].sample}}" class="muted">本地示例附件</text></view><text wx:if="{{item.badge}}" class="badge neutral">{{item.badge}}</text><text wx:if="{{item.savedFile||form[item.key]}}" class="link" data-file="{{item.savedFile||form[item.key]}}" catchtap="preview">查看</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view>
   <button wx:elif="{{item.type==='link'}}" class="row link-row" data-view="{{item.view}}" data-node-id="{{item.nodeId}}" data-material-id="{{item.materialId}}" data-supply-id="{{item.supplyId}}" data-receipt-id="{{item.receiptId}}" data-reship-id="{{item.reshipId}}" data-record="{{item.record}}" data-collection-id="{{item.collectionId}}" bindtap="go"><image wx:if="{{item.icon}}" src="{{item.icon==='money'?'/assets/money.png':'/pages/build/assets/'+item.icon+'.jpg'}}" class="row-icon" mode="aspectFit"/><view class="flex"><view class="row-name">{{item.label}}<text wx:if="{{item.badge}}" class="badge">{{item.badge}}</text></view><text wx:if="{{item.description}}" class="muted">{{item.description}}</text></view><text wx:if="{{item.button}}" class="row-button {{item.outline?'outline':''}}">{{item.button}}</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></button>
   <button wx:elif="{{item.type==='check'}}" class="check-row" data-key="{{item.key}}" bindtap="toggle"><image src="{{form[item.key]?'/pages/build/assets/checkbox-checked.jpg':'/pages/build/assets/checkbox-empty.jpg'}}" class="checkbox" mode="aspectFit"/><text>{{item.label}}</text></button>

   <view wx:elif="{{item.type==='subline'}}" class="subline muted">{{item.value}}</view>
   <view wx:elif="{{item.type==='amount-row'}}" class="amount-row"><text class="label">{{item.label}}</text><text class="money">{{item.value}}</text></view>
   <view wx:elif="{{item.type==='upload-field'}}" class="field"><text class="label">{{item.label}}<text class="required"> *</text></text><button class="upload-box" data-key="{{item.key}}" bindtap="upload"><image src="/pages/build/assets/plus.jpg" mode="aspectFit"/><text>{{form[item.key]?form[item.key].name:'上传凭据'}}</text></button></view>
   <view wx:elif="{{item.type==='media'}}" class="media-grid"><view wx:for="{{item.values}}" wx:for-item="media" wx:key="key"><text>{{media.label}}</text><view class="media-row"><button data-key="{{media.key}}" bindtap="upload"><image wx:if="{{form[media.key]}}" src="{{form[media.key].path||media.image}}" mode="aspectFill"/><image wx:else src="/pages/build/assets/plus.jpg" mode="aspectFit" class="media-plus"/></button><button class="media-add" data-key="{{media.key}}" bindtap="upload"><image src="/pages/build/assets/plus.jpg" mode="aspectFit"/></button></view></view></view>
   <view wx:elif="{{item.type==='money'}}" class="money">{{item.value}}</view>
   <view wx:elif="{{item.type==='supplier'}}" class="soft"><text class="muted">供应商</text><text class="row-name">{{item.value}}</text><text class="muted">{{item.description}}</text></view>
   <view wx:elif="{{item.type==='material-summary'}}" class="material-summary"><image src="/pages/build/assets/cement-icon.jpg" class="big-icon"/><view class="flex"><text class="name">{{item.name}}</text><view class="stats"><view><text>需用</text><text class="num">{{item.quantity}} {{item.unit}}</text></view><view><text>已安排</text><text class="num muted">{{item.arranged}} {{item.unit}}</text></view><view><text>未安排</text><text class="num copper">{{item.unarranged}} {{item.unit}}</text></view></view></view></view>
   <view wx:elif="{{item.type==='node-info'}}" class="node-info"><image src="/pages/build/assets/shovel.jpg" class="big-icon"/><view class="flex"><text class="name">{{item.name}} <text class="badge">{{item.status}}</text></text><text class="muted">计划　{{item.start}} — {{item.end}}</text><text class="muted">实际开始　{{item.actual||'未开始'}}</text></view></view>
   <button wx:elif="{{item.type==='button'}}" class="btn" data-view="{{item.view}}" bindtap="go">{{item.label}}</button>
   <view wx:elif="{{item.type==='payment-totals'}}" class="payment-totals"><view><text class="muted">待办理余款</text><text class="money">¥ {{item.remaining}}</text></view><text class="muted">约定金额 ¥{{item.total}} · 已登记付款 ¥{{item.paid}}</text></view>
   <view wx:elif="{{item.type==='steps'}}" class="steps"><text wx:for="{{item.values}}" wx:key="*this">{{item}}</text></view>
   <view wx:elif="{{item.type==='three-stats'}}" class="stats"><view wx:for="{{item.values}}" wx:key="label"><text>{{item.label}}</text><text class="num">{{item.value}}<text class="unit">{{item.unit}}</text></text></view></view>
   <view wx:elif="{{item.type==='images'}}" class="photos"><image wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"/></view>
  </block>
 </view>
</template>
<view class="build view-{{view}} {{header}} {{modal?'modal-open':''}}">
 <business-header id="subpage-header" title="{{title}}" home="engineering"/>
 <view class="body"><view wx:if="{{canManageTasks}}" class="build-utilities"><button class="build-utility" bindtap="taskAccess">协作授权<view class="chevron"/></button></view>
  <view wx:if="{{missing}}" class="card empty">{{error}}<view class="page-actions"><button class="btn" data-view="projects" bindtap="go">返回我的项目</button></view></view>
  <block wx:elif="{{view==='projects'}}">
   <view class="manager-line">{{roleLabel}} · {{actorName}} <text class="divider">|</text> {{displayDate}}<button data-view="boss" bindtap="go" aria-label="工程概览">概览</button></view>
   <view class="search"><image src="/assets/search.png"/><input value="{{keyword}}" bindinput="search" placeholder="搜索客户或项目" aria-label="搜索客户或项目"/></view>
   <view class="filters"><button wx:for="{{filters}}" wx:key="*this" data-value="{{item}}" bindtap="filter" class="{{filter===item?'active':''}}">{{item}} ({{counts[item]}})</button></view>
   <view wx:for="{{projects}}" wx:key="id" class="card project-card {{item.status==='待交付'?'compact-card':''}}"><image src="{{item.image}}" class="project-image" mode="aspectFill"/><view class="project-content"><view class="name">{{item.name}} <text class="badge {{item.status==='施工中'?'blue':item.status==='待交付'||item.status==='已交付'?'green':''}}">{{item.status}}</text></view><view class="meta"><image src="/pages/build/assets/house-icon.jpg"/>{{item.floors}}层 · {{item.area}}㎡</view><view class="meta"><image src="/pages/build/assets/calendar.jpg"/>{{item.status==='待交付'?'竣工资料待整理':item.actualStart?'当前节点：'+item.plan.nodes[0].name:item.accepted+' 已接收'}}</view><button wx:if="{{item.status!=='待交付'}}" class="project-alert" data-id="{{item.id}}" data-view="{{item.actualStart?'batches':'prepare'}}" bindtap="go">{{item.note}}<image class="arrow" src="/assets/creation-chevron.png"/></button><view class="project-bottom"><button class="btn small-btn" data-id="{{item.id}}" bindtap="chooseProject">查看项目</button></view></view></view>
   <view wx:if="{{!projects.length}}" class="card empty">暂无符合条件的项目<button data-value="全部" bindtap="filter" class="link">查看全部项目</button></view>
  </block>
  <block wx:elif="{{view==='boss'}}">
   <view class="manager-line boss-manager"><text>♙ 王店长 · 本店</text><text>{{displayDate}}</text></view>
   <view class="card boss-stats"><view><image src="/pages/build/assets/boss-home.jpg"/><view><text class="num">{{counts['施工中']}}</text><text>在建项目</text></view></view><view><image src="/pages/build/assets/boss-warning.jpg"/><view><text class="num">{{attention}}</text><text>待整改</text></view></view><view><image src="/pages/build/assets/boss-box.jpg"/><view><text class="num">{{materialExceptions}}</text><text>材料差异</text></view></view></view>
   <view class="card"><view class="heading">需要关注</view><button class="row boss-attention" data-view="rectify" data-id="{{attentionProject.id}}" data-node-id="{{attentionNodeId}}" bindtap="go" disabled="{{!attentionProject}}"><image class="row-icon" src="/pages/build/assets/boss-warning.jpg"/><view class="flex"><text class="row-name">{{attentionProject?attentionNodeName+'验收待整改':'当前无未闭环整改'}}</text><text class="muted">{{attentionProject.name}}</text><text class="muted">{{attentionIssue}}</text><text class="muted" wx:if="{{attentionProject}}">工程负责人　{{attentionProject.manager}}</text></view><text class="row-button">查看整改 ›</text></button></view>
   <view class="card boss-projects"><view class="heading">在建项目<text class="caption">共 {{activeProjects.length}} 个项目</text></view><view wx:for="{{activeProjects}}" wx:key="id" class="row"><image class="boss-thumb" src="{{item.image}}" mode="aspectFill"/><view class="flex"><view class="row-name">{{item.name}}</view><text class="muted">{{item.floors}}层 · {{item.area}}㎡</text><text class="muted">基础工程 · {{item.id===attentionProject.id?'待整改':item.status}}</text><text class="muted">实际开工　{{item.actualStart.date}}</text><button class="outline boss-open" data-id="{{item.id}}" data-view="overview" bindtap="go">查看项目 ›</button></view></view></view>
   <view class="card"><view class="heading">本店工程事项</view><button wx:for="{{[{title:'节点验收与整改',description:'查看节点检查、整改及复验情况',view:'inspection-history',icon:'boss-inspect'},{title:'材料与款项',description:'查看材料进场、使用及收款情况',view:'payments',icon:'boss-box'},{title:'已交付项目',description:'查看本店已交付的项目资料',view:'archive',icon:'boss-file'}]}}" wx:key="view" class="row" data-view="projects" data-destination="{{item.view}}" bindtap="go"><image class="row-icon" src="/pages/build/assets/{{item.icon}}.jpg"/><view class="flex"><text class="row-name">{{item.title}}</text><text class="muted">{{item.description}}</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view>
   <view class="card"><button class="row boss-summary" data-modal="summary" bindtap="go"><image class="row-icon" src="/pages/build/assets/boss-summary.jpg"/><view class="flex"><text class="row-name">AI工程摘要</text><text class="muted">依据本店可见项目记录，辅助查看工程重点、待办与风险提示。</text></view><text class="row-button">查看摘要 ›</text></button></view>
  </block>
  <block wx:else>
   <view wx:if="{{view==='new'}}" class="card manager-card"><view class="initial">{{actorInitial}}</view><view><text class="name">{{actorName}}</text><text class="muted">{{roleLabel}}</text></view></view>
   <view wx:elif="{{header!=='none'}}" class="card project-banner {{header}}">
    <button wx:if="{{header==='compact'}}" class="compact-project" data-view="overview" bindtap="go"><view><text class="name">{{p.name}}</text><text wx:if="{{view==='supply'}}" class="muted">周材料 · 材料办理人</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></button>
    <block wx:else><image wx:if="{{header==='photo'}}" class="banner-photo" src="{{bannerImage||p.image}}" mode="aspectFill"/><view wx:elif="{{view!=='finance'&&view!=='supply-payment'}}" class="initial">{{initial}}</view><view class="banner-info"><view class="name">{{header==='photo'||view==='documents'?p.name:p.customer}}<text wx:if="{{view!=='node'&&view!=='delivery'}}" class="badge {{projectStatus==='已交付'?'green':projectStatus==='施工中'?'blue':''}}">{{headerBadge||projectStatus}}</text></view><view class="meta"><image wx:if="{{header==='photo'}}" src="/pages/build/assets/house-icon.jpg"/>{{header==='avatar'?p.city+' · ':''}}{{p.floors}}层 · {{p.area}}㎡{{view==='documents'||view==='start'||view==='node'?' · '+p.manager:''}}</view><view wx:if="{{header==='photo'&&view!=='node'}}" class="meta"><image src="/pages/build/assets/manager.jpg"/>工程负责人　{{p.manager}}<text wx:if="{{p.assignedEngineerName}}"> · 执行 {{p.assignedEngineerName}}</text></view><view wx:if="{{view==='overview'||view==='archive'||view==='documents'}}" class="meta"><image wx:if="{{header==='photo'}}" src="/pages/build/assets/calendar.jpg"/>{{p.delivery?'已交付 '+p.delivery.date:'已接收 '+p.accepted}}</view></view></block>
    <view wx:if="{{view==='prepare'||view==='collection'}}" class="banner-soft"><view class="kv"><text class="label">工程负责人</text><text>{{p.manager}}</text></view><view wx:if="{{p.assignedEngineerName}}" class="kv"><text class="label">执行工程人员</text><text>{{p.assignedEngineerName}}</text></view><view class="kv"><text class="label">已接收</text><text>{{p.accepted}}</text></view></view><view wx:if="{{view==='start'}}" class="banner-soft">登记日期　{{displayDate}}</view>
   </view>
   <view wx:if="{{tabs.length}}" class="tabs"><button wx:for="{{tabs}}" wx:key="*this" class="{{tab===index?'active':''}}" data-index="{{index}}" bindtap="tab">{{item}}</button></view>
   <block wx:if="{{view==='prepare'}}"><view class="card prepare-card"><view class="heading">开工条件核对</view><view class="progress-line"><text>已核对 {{checkedCount}}/6</text><progress percent="{{checkedCount/6*100}}" activeColor="#a43c0c" backgroundColor="#e6e7eb" stroke-width="8"/></view><view wx:for="{{checks}}" wx:key="index" class="check-item" data-modal="{{canPrepare?'prepare':''}}" data-index="{{index}}" bindtap="{{canPrepare?'go':'noop'}}"><text class="number">{{index+1}}</text><view class="flex"><text class="row-name">{{item.name}}</text><text class="muted">{{item.description}}</text></view><text class="badge {{item.done?'green':'neutral'}}">{{item.done?'已核对':'待核对'}}</text><image wx:if="{{canPrepare}}" class="arrow" src="/assets/creation-chevron-muted.png"/></view><view class="notice">{{ready?'开工条件已核齐，请登记实际开工。':'当前仍有 '+(6-checkedCount)+' 项待核对，请补齐记录。'}}<text class="muted">图纸上传、抄送与专业审核分别记录。</text></view><view class="kv soft"><text class="label">核对日期</text><text>{{displayDate}}</text></view></view></block>
   <block wx:elif="{{view==='schedule'}}"><view class="card plan-card"><view class="row"><image class="row-icon" src="/pages/build/assets/file.jpg"/><view><text class="name">计划 v{{p.plan.version}} <text class="badge">{{projectStatus}}</text></text><text class="badge">v{{p.plan.version}} · {{p.sends.length?'已有发送记录':'未发送'}}</text></view></view><view wx:if="{{canSchedule}}" class="plan-actions"><button class="outline" bindtap="exportPlan"><image class="action-icon" src="/pages/build/assets/export.jpg"/>导出计划</button><button class="outline" bindtap="sendPlan"><image class="action-icon" src="/pages/build/assets/send.jpg"/>发送甲方</button><button class="outline" bindtap="more">更多 ···</button></view></view><view class="card node-list"><button wx:for="{{p.plan.nodes}}" wx:key="id" class="row node-row" data-view="node" data-node-id="{{item.id}}" bindtap="go"><text class="number">0{{index+1}}</text><view class="flex"><view class="name"><text>{{item.name}}</text><text class="badge">{{item.status}}</text></view><text class="muted">{{item.start}} — {{item.end}} · {{index===0?p.materials.length+'项材料':'待配材料'}}</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></button><button wx:if="{{canSchedule}}" class="soft add-node" data-modal="node-edit" data-node-id="" bindtap="go"><image class="action-icon" src="/pages/build/assets/add.jpg"/>新增节点</button></view><view class="card"><button class="row" data-view="history" bindtap="go"><image src="/pages/build/assets/file.jpg" class="row-icon"/><view class="flex"><text class="row-name">计划详情与发送记录</text><text class="muted">修改后另存版本，已发版本保留。</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="notice">计划日期不代表实际开工。</view></block>
   <block wx:elif="{{view==='materials'}}"><view wx:if="{{canMaterials}}" class="material-actions"><button data-modal="material" bindtap="go">按节点配材</button><button data-modal="material" bindtap="go">新增材料</button></view><view class="material-filters"><picker range="{{filterNodes}}" data-key="nodeFilter" bindchange="materialFilter"><view>{{nodeFilter}}</view></picker><picker range="{{materialFilters}}" data-key="materialFilter" bindchange="materialFilter"><view>{{materialFilter}}</view></picker></view><view wx:for="{{materials}}" wx:key="id" class="card material-card"><view class="name">{{item.name}}<text class="badge">{{item.submitted?'部分已安排':'待提交'}}</text></view><text class="muted">需用 <text class="strong">{{item.quantity}}</text> {{item.unit}} · 未安排 <text class="copper strong">{{item.unarranged}}</text> {{item.unit}}</text><text class="muted">需到场 {{item.date}}</text><button class="material-bottom" data-view="supply" data-material-id="{{item.id}}" bindtap="go"><text>详情展开</text><text class="muted">已安排 <text class="copper">{{item.arranged}}</text> {{item.unit}} · 实收 <text class="copper">{{item.received}}</text> {{item.unit}}</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view wx:if="{{!materials.length}}" class="card empty">暂无符合条件的材料需求</view></block>
   <view wx:if="{{p && canViewFunds}}" class="card build-links"><button class="build-link" data-view="receivables" bindtap="openOperating"><text>合同收款与放行条件</text><view class="chevron"/></button><button class="build-link" data-view="expenses" bindtap="openOperating"><text>提交费用与查看成本</text><view class="chevron"/></button></view><template is="sections" data="{{sections,form,view}}"/>
   <view wx:if="{{view==='overview'}}" class="more-links"><button wx:if="{{canViewFunds}}" data-view="payments" bindtap="go">节点款项</button><button data-view="delivery" bindtap="go">竣工交付</button><button data-modal="summary" bindtap="go">工程摘要</button><button data-view="customer" bindtap="go">业主进度</button></view>
  </block>
  <view wx:if="{{error&&!modal&&!missing}}" class="error">{{error}}</view>
 </view>
 <text wx:if="{{footnote}}" class="action-note">{{footnote}}</text>
 <view wx:if="{{view==='projects'&&canEdit&&!destination}}" class="footer page-actions"><button class="outline btn" data-view="new" bindtap="go">新增项目</button><button class="outline btn" data-view="new" bindtap="go">新增额外项目</button></view>
 <view wx:elif="{{primary}}" class="footer page-actions {{view==='prepare'?'prepare-footer':''}}"><button wx:if="{{secondary}}" class="btn outline secondary" disabled="{{secondaryDisabled}}" bindtap="secondary">{{secondary}}</button><button class="btn primary-action" disabled="{{primaryDisabled||busy}}" bindtap="primary">{{primary}}</button></view>
 <view wx:if="{{modal}}" class="shade" bindtap="closeModal"><view class="sheet {{modal==='summary'?'summary-sheet':''}} {{modal==='reschedule'?'reschedule-sheet':''}} {{modal==='material'?'material-sheet':''}}" catchtap="noop"><view class="sheet-title"><text>{{modalTitle}}</text><button class="close" bindtap="closeModal" aria-label="关闭"><image src="/pages/build/assets/close.jpg" mode="aspectFit"/></button></view><view wx:if="{{modal==='summary'}}" class="summary-context">{{p.name}} · {{displayDate}}<text>仅依据当前账号可见记录</text></view><scroll-view scroll-y class="sheet-body"><template is="sections" data="{{sections:modalSections,form,view}}"/><view wx:if="{{error}}" class="error">{{error}}</view></scroll-view><view class="sheet-footer"><button wx:if="{{modal!=='summary'&&modal!=='material'}}" class="btn outline" bindtap="closeModal">取消</button><button class="btn modal-save" bindtap="modalSubmit" disabled="{{busy}}">{{modal==='summary'?'查看验收记录':modal==='reschedule'?'确认改期':modal==='material'?'保存到材料计划':'保存'}}</button></view></view></view>
</view>
