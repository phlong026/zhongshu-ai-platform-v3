@import "../../../styles/engineering.wxss";
.eng-project-card .eng-tools>button{padding:12rpx 0;gap:8rpx}.eng-project-compact .eng-progress-row{margin:10rpx 0}.eng-project-compact .eng-name{font-size:var(--zs-font-emphasis)}.eng-incoming-action{font-size:var(--zs-font-meta);padding:10rpx 16rpx}.eng-selection-note{margin-bottom:18rpx;color:var(--zs-brand);font-size:var(--zs-font-emphasis)}.eng-tasks-count{font-size:var(--zs-font-body);color:var(--zs-text-3)}
.projects-page .record-field{padding:16rpx 0;border-bottom:1rpx solid var(--zs-line);font-size:var(--zs-font-emphasis)}.projects-page .record-field>text{display:block;margin-bottom:10rpx}.projects-page .record-field input{box-sizing:border-box;background:var(--zs-bg);border:1rpx solid var(--zs-line);border-radius:12rpx;padding:18rpx;width:100%;height:88rpx;font-size:var(--zs-font-emphasis);line-height:42rpx;color:var(--zs-ink)}.projects-page .record-field picker{padding:12rpx 0}.projects-page .eng-submit{margin-top:20rpx}
