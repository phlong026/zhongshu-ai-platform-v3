@import "../../../styles/engineering.wxss";
.flow-body{padding:20rpx 24rpx 56rpx}.flow-totals{display:flex;gap:16rpx}.flow-totals>view{flex:1;min-width:0}.flow-totals text,.flow-row text,.flow-field>text{display:block}.flow-totals text:first-child,.flow-field>text{color:var(--zs-text-muted);font-size:24rpx}.flow-field,.flow-row{display:block;padding:16rpx 0;border-bottom:1rpx solid var(--zs-line)}.flow-field input,.flow-field picker,.flow-field textarea{box-sizing:border-box;width:100%;min-height:56rpx;padding:8rpx 0;font-size:28rpx}.flow-body button{margin-top:12rpx}.flow-error{color:#96341d}
