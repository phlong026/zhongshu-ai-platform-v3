.record-page .eng-name{display:block}.record-nav{display:flex;justify-content:space-between;margin-bottom:20rpx}.record-nav button{font-size:26rpx;min-height:64rpx;color:#89512a;padding:12rpx}.record-field{padding:16rpx 0;border-bottom:1rpx solid #eee8df;font-size:27rpx}.record-field>text{display:block;margin-bottom:10rpx}.record-field input,.record-field textarea,.record-node input{box-sizing:border-box;background:#faf8f4;border:1rpx solid #eee8df;border-radius:12rpx;padding:18rpx;width:100%;min-height:78rpx;font-size:27rpx;line-height:40rpx;color:#141312}.record-field textarea{min-height:130rpx}.record-field picker{padding:12rpx 0}.record-node{padding:18rpx 0;border-bottom:1rpx solid #eee8df}.record-node input{margin-bottom:14rpx}.record-grid{display:flex;gap:16rpx}.record-grid input{flex:1;min-width:0}.record-check{text-align:left;color:#89512a;font-size:27rpx;min-height:68rpx}.record-page .eng-row{color:#141312;white-space:normal}.record-page .eng-primary{white-space:normal;text-align:center}.record-page .eng-tag{margin:12rpx 0}
