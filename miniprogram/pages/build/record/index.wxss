@import "../../../styles/engineering.wxss";
.record-page .eng-name{display:block}.record-field{padding:16rpx 0;border-bottom:1rpx solid var(--zs-line);font-size:var(--zs-font-emphasis)}.record-field>text{display:block;margin-bottom:10rpx}.record-field input,.record-field textarea,.record-node input{box-sizing:border-box;background:var(--zs-bg);border:1rpx solid var(--zs-line);border-radius:12rpx;padding:18rpx;width:100%;min-height:78rpx;font-size:var(--zs-font-emphasis);line-height:40rpx;color:var(--zs-ink)}.record-field textarea{min-height:130rpx}.record-field picker{padding:12rpx 0}.record-node{padding:18rpx 0;border-bottom:1rpx solid var(--zs-line)}.record-node input{margin-bottom:14rpx}.record-grid{display:flex;gap:16rpx}.record-grid input{flex:1;min-width:0}.record-check{text-align:left;color:var(--zs-brand);font-size:var(--zs-font-emphasis);min-height:68rpx}.record-page .eng-row{color:var(--zs-ink);white-space:normal}.record-page .eng-primary{white-space:normal;text-align:center}.record-page .eng-tag{margin:12rpx 0}

.record-page{padding-bottom:calc(176rpx + env(safe-area-inset-bottom))}.record-field,.record-field input,.record-field textarea,.record-node input{font-size:var(--zs-font-emphasis);line-height:42rpx}.record-field input,.record-node input{height:88rpx;min-height:88rpx}.record-field>text{line-height:42rpx}.record-node>.eng-muted{margin:14rpx 0 8rpx}.record-actions .primary-action{font-size:var(--zs-font-emphasis);line-height:42rpx}.record-page .eng-tag{font-size:var(--zs-font-caption)}

.record-node-menu{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:18rpx}.record-node-menu button{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:16rpx 10rpx;border:1rpx solid var(--zs-line);border-radius:14rpx;background:var(--zs-bg);color:var(--zs-brand);font-size:var(--zs-font-body);line-height:40rpx;white-space:nowrap}
.node-site-records .record-photos{display:flex;flex-wrap:wrap;gap:12rpx;margin:14rpx 0}.node-site-records .record-photo{width:200rpx;height:200rpx;border-radius:14rpx;background:#f3efe8;border:1rpx solid var(--zs-line)}
.record-document-mask{position:fixed;inset:0;z-index:180;background:rgba(0,0,0,.48)}.record-document-panel{position:absolute;top:150rpx;left:24rpx;right:24rpx;bottom:40rpx;background:#f0ece6;border-radius:20rpx;overflow:hidden;display:flex;flex-direction:column}.record-document-panel>.eng-heading{padding:20rpx 24rpx;background:var(--zs-card);gap:12rpx;margin:0;font-size:var(--zs-font-emphasis)}.record-document-scroll{height:0;flex:1;min-height:0}.record-document-paper{background:var(--zs-card);min-height:680rpx;margin:20rpx;padding:32rpx 24rpx;text-align:center}.record-document-title{display:block;font-size:var(--zs-font-title);font-weight:600;margin-bottom:14rpx}.record-document-summary{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-top:2rpx solid #736351;border-bottom:1rpx solid #e7ded2;margin-top:24rpx;font-size:var(--zs-font-meta)}.record-document-paper image{width:100%;height:580rpx;display:block;margin:20rpx 0}.record-document-review{font-size:var(--zs-font-hero);color:#6e9879;margin:70rpx 0}.record-document-review>text{font-size:var(--zs-font-emphasis);color:#6c5b4a;display:block;margin-top:25rpx}.record-document-confirmation{margin:80rpx 0;font-size:var(--zs-font-emphasis);line-height:2}.record-document-confirmation>text{display:block}.record-document-confirmation>text:last-child{text-align:right;font-size:var(--zs-font-heading);font-style:italic;margin-top:50rpx;color:#875d3e}.record-document-version{display:block;font-size:var(--zs-font-caption);color:#b4a99b;margin-top:30rpx;word-break:break-all}
.record-template{padding:16rpx 0;border-bottom:1rpx solid var(--zs-line)}.record-template .record-field{border-bottom:0}.record-template .eng-submit{margin-top:8rpx}

/* Count labels stay readable on small phones without squeezing four actions into one row. */
@media(max-width:360px){.record-node-menu{grid-template-columns:repeat(2,minmax(0,1fr))}.record-node-menu button{white-space:normal;overflow-wrap:anywhere}}
/* Separate actual-file and reference-file actions so their outlines never touch. */
.record-field .eng-outline+.eng-outline{margin-top:12rpx}

.camera-entry{display:flex;align-items:center;justify-content:space-between;text-align:left;width:100%;box-sizing:border-box}.camera-entry:after{border:0}.camera-entry>view{display:flex;flex-direction:column;gap:8rpx}.camera-actions{display:flex;gap:20rpx;margin-top:24rpx}.camera-actions button{margin:0;flex:1}.camera-player{width:100%;height:380rpx;margin-top:24rpx;background:#182224;border-radius:16rpx}.progress-pace{display:block;font-size:24rpx;color:#52766d;margin-top:8rpx}.progress-late{color:#bb4936}.progress-card .eng-heading{align-items:center}.camera-form input{min-height:80rpx}.camera-form>.eng-primary{margin-top:24rpx}

/* Short summaries first; full records and editors open on demand. */
.record-title-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100%;min-width:0}.record-title-row .eng-name{flex:1;min-width:0;overflow-wrap:anywhere}.record-title-row .eng-tag{margin:0;flex-shrink:0}.record-project-header>.eng-muted{margin-top:10rpx}.record-page .eng-muted{font-size:26rpx;line-height:38rpx;color:#756e65}.project-summary .eng-heading{margin-bottom:8rpx}.project-summary .eng-primary{margin-top:18rpx}.summary-percent{font-size:30rpx;font-weight:600;color:var(--zs-brand)}.summary-alert{font-size:26rpx;line-height:38rpx;color:#a63d2b}.project-tools{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;padding:16rpx}.project-tool{min-height:118rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;font-size:28rpx;line-height:38rpx;padding:10rpx 4rpx;white-space:normal}.project-tool image{width:42rpx;height:42rpx}.record-money-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:16rpx 0 4rpx}.record-money-grid>view{min-width:0}.record-money-grid text{display:block;font-size:28rpx;line-height:40rpx;overflow-wrap:anywhere}.record-money-grid text:first-child{font-size:24rpx;color:#756e65}.record-money-grid text:last-child{font-weight:600}.record-more{display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:88rpx;width:100%;color:var(--zs-brand);font-size:26rpx;border-top:1rpx solid var(--zs-line);margin-top:8rpx;padding:12rpx 0}.disclosure-arrow{width:12rpx;height:20rpx;flex-shrink:0;transform:rotate(90deg)}.disclosure-arrow.is-open{transform:rotate(-90deg)}.record-disclosure{display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100%;text-align:left;min-height:88rpx;font-size:30rpx}.record-disclosure>text:last-child{color:var(--zs-brand);font-size:26rpx}.schedule-node{padding:0}.schedule-summary{display:flex;align-items:center;gap:14rpx;text-align:left;width:100%;min-height:126rpx;padding:16rpx 0}.schedule-summary .eng-tag{margin:0}.schedule-editor{padding:16rpx;background:var(--zs-bg);border-radius:14rpx;margin-bottom:18rpx}.schedule-editor .record-grid>picker{flex:1;min-width:0}.schedule-editor .record-field{padding:10rpx 0;border:0;font-size:28rpx;line-height:42rpx}.schedule-editor .record-field>text{font-size:24rpx;color:#756e65;margin:0}.settlement-table{margin-top:20rpx;font-size:26rpx;line-height:40rpx}.settlement-table>view{display:grid;grid-template-columns:.65fr 1fr 1fr 1fr;gap:10rpx;padding:14rpx 0;border-bottom:1rpx solid var(--zs-line)}.settlement-table>view:first-child{color:#756e65}.settlement-table text{overflow-wrap:anywhere;min-width:0}.record-page{padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.record-page.has-actions{padding-bottom:calc(176rpx + env(safe-area-inset-bottom))}.record-actions{position:fixed;left:0;right:0;bottom:0;z-index:20;margin:0;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));background:var(--zs-card);border-top:1rpx solid var(--zs-line)}.record-page .record-actions .primary-action{min-height:88rpx;padding:14rpx;font-size:30rpx}.record-field:last-child{border-bottom:0}.record-disclosure+block{margin-top:10rpx}
@media(max-width:360px){.record-money-grid{gap:8rpx}.record-money-grid text{font-size:26rpx}.settlement-table{font-size:24rpx}.project-tool{font-size:26rpx}}
.fields-prepare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:20rpx}.fields-prepare .record-field{min-width:0}.fields-prepare .field-file,.fields-prepare .field-note{grid-column:1/-1}.fields-prepare .record-field>text{font-size:28rpx}.fields-prepare .record-field input{font-size:30rpx}
