@import "../../../styles/engineering.wxss";
.record-page .eng-name{display:block}.record-field{padding:16rpx 0;border-bottom:1rpx solid #eee8df;font-size:27rpx}.record-field>text{display:block;margin-bottom:10rpx}.record-field input,.record-field textarea,.record-node input{box-sizing:border-box;background:#faf8f4;border:1rpx solid #eee8df;border-radius:12rpx;padding:18rpx;width:100%;min-height:78rpx;font-size:27rpx;line-height:40rpx;color:#141312}.record-field textarea{min-height:130rpx}.record-field picker{padding:12rpx 0}.record-node{padding:18rpx 0;border-bottom:1rpx solid #eee8df}.record-node input{margin-bottom:14rpx}.record-grid{display:flex;gap:16rpx}.record-grid input{flex:1;min-width:0}.record-check{text-align:left;color:#89512a;font-size:27rpx;min-height:68rpx}.record-page .eng-row{color:#141312;white-space:normal}.record-page .eng-primary{white-space:normal;text-align:center}.record-page .eng-tag{margin:12rpx 0}

.record-page{padding-bottom:calc(176rpx + env(safe-area-inset-bottom))}.record-field,.record-field input,.record-field textarea,.record-node input{font-size:28rpx;line-height:42rpx}.record-field input,.record-node input{height:88rpx;min-height:88rpx}.record-field>text{line-height:42rpx}.record-node>.eng-muted{margin:14rpx 0 8rpx}.record-actions .primary-action{font-size:28rpx;line-height:42rpx}.record-page .eng-tag{font-size:22rpx}

.record-node-menu{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:18rpx}.record-node-menu button{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:16rpx 12rpx;border:1rpx solid #eee8df;border-radius:14rpx;background:#faf8f4;color:#89512a;font-size:28rpx;line-height:42rpx}
.node-site-records .record-photos{display:flex;flex-wrap:wrap;gap:12rpx;margin:14rpx 0}.node-site-records .record-photo{width:200rpx;height:200rpx;border-radius:14rpx;background:#f3efe8;border:1rpx solid #eee8df}
.record-document-mask{position:fixed;inset:0;z-index:180;background:rgba(0,0,0,.48)}.record-document-panel{position:absolute;top:150rpx;left:24rpx;right:24rpx;bottom:40rpx;background:#f0ece6;border-radius:20rpx;overflow:hidden;display:flex;flex-direction:column}.record-document-panel>.eng-heading{padding:20rpx 24rpx;background:#fff;gap:12rpx;margin:0;font-size:27rpx}.record-document-scroll{height:0;flex:1;min-height:0}.record-document-paper{background:#fff;min-height:680rpx;margin:20rpx;padding:32rpx 24rpx;text-align:center}.record-document-title{display:block;font-size:32rpx;font-weight:600;margin-bottom:14rpx}.record-document-summary{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-top:2rpx solid #736351;border-bottom:1rpx solid #e7ded2;margin-top:24rpx;font-size:24rpx}.record-document-paper image{width:100%;height:580rpx;display:block;margin:20rpx 0}.record-document-review{font-size:100rpx;color:#6e9879;margin:70rpx 0}.record-document-review>text{font-size:29rpx;color:#6c5b4a;display:block;margin-top:25rpx}.record-document-confirmation{margin:80rpx 0;font-size:29rpx;line-height:2}.record-document-confirmation>text{display:block}.record-document-confirmation>text:last-child{text-align:right;font-size:38rpx;font-style:italic;margin-top:50rpx;color:#875d3e}.record-document-version{display:block;font-size:20rpx;color:#b4a99b;margin-top:30rpx;word-break:break-all}
