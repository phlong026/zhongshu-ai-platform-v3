    <view wx:for="{{settle.expenseReview}}" wx:key="id">
      <text>{{item.name}}：工程修订 {{item.revised}}，财务原应付 {{item.booked}}，净已付 {{item.paid}}</text>
      <text wx:if="{{item.above}}">（净已付比修订金额多 {{item.above}}）</text>
    </view>
   </view><button wx:if="{{p.settlement}}" class="eng-link" data-url="{{links[4].url}}" bindtap="go">前往归档</button></view>
