<wxs src="../../../utils/tone.wxs" module="st"/>
<template name="record-more"><button wx:if="{{total>3}}" class="record-more" data-section="{{section}}" bindtap="toggleSection" aria-label="{{open?'收起':'展开全部'}}{{label}}">{{open?'收起':'查看全部 · 另 '+(total-3)+'条'}}<image class="disclosure-arrow {{open?'is-open':''}}" src="/assets/creation-chevron-muted.png"/></button></template>
<template name="record-fields"><view class="eng-section record-fields fields-{{layout}}"><view wx:for="{{fields}}" wx:key="key" class="record-field field-{{item.key}}"><text>{{item.label}}</text><picker wx:if="{{item.type==='date'}}" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="input"><view>{{form[item.key]||'请选择日期'}}</view></picker><picker wx:elif="{{item.type==='handler'}}" range="{{handlers}}" range-key="name" bindchange="pickDelayOwner"><view>{{form.delayOwnerName||'请选择责任人'}}</view></picker><picker wx:elif="{{item.type==='supply'}}" range="{{form.supplyOptions}}" range-key="label" bindchange="supplyPick"><view class="record-field">{{form.supplyLabel||'请选择供应事项'}}</view></picker><picker wx:elif="{{item.type==='quality'}}" range="{{item.options}}" bindchange="pickArrivalQuality"><view class="record-field">{{form.quality||'合格'}}</view></picker><picker wx:elif="{{item.type==='purpose'}}" range="{{purposes}}" range-key="label" bindchange="pickPurpose"><view class="record-field">{{purposeLabel||'请选择费用用途'}}</view></picker><view wx:elif="{{item.type==='file'}}"><button class="eng-outline" data-key="{{item.key}}" bindtap="upload">{{layout==='node'&&item.key==='file'&&form.files.length?'继续添加凭据（已选 '+form.files.length+'/9）':fileNames[item.key]||'选择凭据'}}</button><button wx:if="{{demo}}" class="eng-outline" data-sample-key="{{item.key}}" bindtap="useSampleFile">使用本项目参考凭据</button><block wx:if="{{layout==='node'&&item.key==='file'}}"><view wx:for="{{form.files}}" wx:for-item="evidence" wx:for-index="slot" wx:key="path" class="eng-row"><button class="eng-link" data-file="{{evidence}}" bindtap="preview">{{slot+1}}. {{evidence.name}}</button><button class="eng-link" data-index="{{slot}}" bindtap="removeNodeEvidence">移除</button></view></block><button wx:elif="{{form[item.key]}}" class="eng-link" data-file="{{form[item.key]}}" bindtap="preview">预览已选凭据</button></view><button wx:elif="{{item.type==='check'}}" class="record-check" data-key="{{item.key}}" bindtap="toggle">{{form[item.key]?'已确认':'点击确认'}}</button><textarea wx:elif="{{item.type==='textarea'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="{{item.maxLength||140}}" auto-height="{{true}}"/><input wx:else placeholder="{{item.placeholder||''}}" type="{{item.type==='digit'?'digit':'text'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input"/></view></view></template>
<view class="page engineering-desk record-page {{actions.length?'has-actions':''}}">

 <brand-header id="brand-header" title="{{title}}" divider="{{true}}"/>
 <view class="eng-content">
  <text wx:if="{{error}}" class="eng-error">{{error}}</text><button wx:if="{{paymentUncertain}}" class="eng-outline" bindtap="retryPayment" disabled="{{busy}}" loading="{{busy}}">重试核对保存结果</button><button wx:elif="{{paymentConflict}}" class="eng-outline" bindtap="reloadPayment" disabled="{{busy}}">重新加载付款计划</button>
  <button wx:if="{{error&&!p&&!paymentUncertain&&!paymentConflict}}" class="eng-outline" bindtap="reloadProject">重新加载工程</button>
  <block wx:if="{{p}}">
   <view class="eng-section record-project-header"><view class="record-title-row"><text class="eng-name">{{p.name}}</text><text class="eng-tag">{{stageText}}</text></view><text class="eng-muted">{{p.manager}}{{p.city?' · '+p.city:''}}{{p.area?' · '+p.area+'㎡':''}}{{p.floors?' · '+p.floors+'层':''}}</text></view>
   <view wx:if="{{p.sourceType==='INCREMENT'&&p.parentProjectId}}" class="eng-section"><text class="eng-muted">本增项的历史资料保留在此记录，合同收款及开工请在原工程办理。</text><button class="eng-link" data-url="/pages/build/record/index?id={{p.parentProjectId}}&amp;view=overview" bindtap="go">打开原工程</button></view>
   <view wx:if="{{externalHandoverUrl&&(view==='overview'||view==='prepare'||view==='documents'||view==='archive')}}" class="eng-section"><view class="eng-heading"><text>外部成果移交 V{{externalHandoverVersion}}</text><button class="eng-link" data-url="{{externalHandoverUrl}}" bindtap="go">查看移交记录</button></view><text class="eng-muted">查看客户确认凭据、成果资料及随包付款约定</text></view>
   <view wx:if="{{(view==='node'||view==='delay'||view==='start')&&node}}" class="eng-section progress-card">
    <text wx:if="{{view==='delay'}}" class="eng-name">{{node.name}}</text><view class="eng-heading"><text>进度偏差</text><text class="progress-pace {{node.deviationDays>0?'progress-late':''}}">{{node.pace||'待排期'}}</text></view>
    <text class="eng-muted">原计划完成 {{node.baselineEnd||'未留存'}}</text><text class="eng-muted">当前排期 {{node.end||'待填写'}}</text><text wx:if="{{node.completedAt}}" class="eng-muted">实际完成 {{node.completedAt}}</text>
    <text wx:if="{{node.delayReason&&(view!=='delay'||!actions.length)}}" class="eng-muted">延期原因：{{node.delayReason}}</text>
    <text wx:if="{{view!=='delay'||!actions.length}}" class="eng-muted">处理责任人：{{node.delayOwnerName||'未登记'}}</text>
    <text wx:if="{{node.recoveryDate&&(view!=='delay'||!actions.length)}}" class="eng-muted">预计完成 {{node.recoveryDate}}</text>
    <text wx:if="{{node.recoveryAction&&(view!=='delay'||!actions.length)}}" class="eng-muted">处理措施：{{node.recoveryAction}}</text>
    <button wx:if="{{view!=='delay'&&(node.deviationDays>0||node.delayHistory.length)}}" class="eng-link" data-url="{{delayUrl}}" bindtap="go">{{own&&node.status!=='已完成'?'处理延期':'查看处理记录'}}</button>
   </view>
   <view wx:if="{{view==='start'&&p.actualStart}}" class="eng-section">
    <view class="eng-heading"><text>实际开工原单</text></view>
    <text class="eng-muted">实际开工日期 {{p.actualStart.date}}</text>
    <text wx:if="{{p.actualStart.actor}}" class="eng-muted">开工经办人 {{p.actualStart.actor}}</text>
    <text wx:if="{{p.actualStart.note}}" class="eng-name">{{p.actualStart.note}}</text>
    <button wx:for="{{p.actualStart.assetIds}}" wx:key="*this" class="eng-link" data-asset-id="{{item}}" bindtap="previewAsset">查看开工凭据{{p.actualStart.assetIds.length>1?' '+(index+1):''}}</button>
   </view>
   <view wx:if="{{view==='start'&&startSaveState}}" class="eng-section">
    <text class="eng-muted">{{startSaveState==='sending'?'正在提交原开工记录':startSaveState==='saved'?'已提交，正在核对原单':'开工回执待核对'}}</text>
    <button wx:if="{{startCanRetry}}" class="eng-outline" bindtap="retryStart" disabled="{{busy}}">使用原开工记录重试</button>
    <button wx:elif="{{startSaveState!=='sending'}}" class="eng-link" bindtap="reloadProject">重新核对工程原单</button>
   </view>
   <text wx:if="{{view==='start'&&fields.length}}" class="eng-muted">现场记录均选填，可填写待核对事项。各栏连同标题共限 1000 字符。</text>
   <view wx:if="{{view==='start'&&startBlocked}}" class="eng-section"><button class="eng-primary" data-url="{{startPrerequisiteUrl}}" bindtap="go">{{startBlocked}}</button></view>
   <block wx:if="{{view==='cameras'}}">
    <view class="eng-section"><view class="eng-heading"><text>摄像头 {{cameras.length}}</text><button wx:if="{{canManageCameras}}" class="eng-link" bindtap="editCamera">添加摄像头</button></view><text wx:if="{{cameraError}}" class="eng-error">{{cameraError}}</text><button wx:if="{{cameraError}}" class="eng-link" bindtap="reloadCameras">重新加载</button><text wx:elif="{{!cameras.length}}" class="eng-muted">暂无摄像头</text></view>
    <view wx:for="{{cameras}}" wx:key="id" class="eng-section camera-card"><view class="eng-heading"><text>{{item.name}}</text><text class="eng-tag">{{!item.enabled?'已停用':item.configured?'已配置':'待接入'}}</text></view><text class="eng-muted">{{item.location}}</text>
     <view class="camera-actions"><button wx:if="{{item.enabled&&item.configured}}" class="eng-primary" data-id="{{item.id}}" bindtap="playCamera">{{playingCameraId===item.id?'重新加载':'查看画面'}}</button><button wx:if="{{canManageCameras}}" class="eng-outline" data-id="{{item.id}}" bindtap="editCamera">管理</button></view>
     <block wx:if="{{playingCameraId===item.id}}"><text wx:if="{{playbackLoading}}" class="eng-muted">正在加载画面</text><video wx:if="{{playbackUrl}}" id="site-camera-player" class="camera-player" src="{{playbackUrl}}" autoplay="{{true}}" muted="{{true}}" controls="{{true}}" show-fullscreen-btn="{{true}}" binderror="cameraVideoError" bindplay="cameraVideoReady"/><text wx:if="{{playbackError}}" class="eng-error">{{playbackError}}</text></block>
    </view>
    <view wx:if="{{cameraFormOpen&&canManageCameras}}" class="eng-section camera-form"><view class="eng-heading"><text>{{form.cameraId?'管理摄像头':'添加摄像头'}}</text><button class="eng-link" bindtap="closeCameraForm">取消</button></view>
     <view class="record-field"><text>摄像头名称</text><input value="{{form.cameraName}}" data-key="cameraName" bindinput="input" maxlength="80" placeholder="例如：东侧施工区"/></view>
     <view class="record-field"><text>安装位置</text><input value="{{form.cameraLocation}}" data-key="cameraLocation" bindinput="input" maxlength="120" placeholder="例如：大门内侧立杆"/></view>
     <view class="record-field"><text>播放地址（选填）</text><input value="{{form.cameraUrl}}" data-key="cameraUrl" bindinput="input" maxlength="2048" placeholder="https://…/live.m3u8"/><text class="eng-muted">{{form.cameraId?'留空保留原地址；停用后无法观看。':'设备未安装时可先保存名称和位置。'}}</text></view>
     <view class="record-field"><text>启用摄像头</text><switch checked="{{form.cameraEnabled}}" bindchange="toggleCameraEnabled"/></view>
     <button class="eng-primary" data-action="camera-save" bindtap="perform" disabled="{{busy}}">保存摄像头</button>
    </view>
   </block>
   <view wx:if="{{view==='node'&&node}}" class="eng-section"><text class="eng-name">{{node.name}} · {{node.status}}</text><text class="eng-muted">计划 {{node.start}} 至 {{node.end}}</text><view class="record-node-menu"><button data-section="site" disabled="{{!fields.length&&!siteRecords.length}}" bindtap="jumpNodeSection">施工记录</button><button data-section="inspection" bindtap="jumpNodeSection">验收记录</button><button data-url="{{nodeMaterialUrl}}" bindtap="go">材料计划 {{nodePlans.length}}</button><button data-url="{{nodeFundingUrl}}" bindtap="go">资金计划</button></view></view>
   <button wx:if="{{view==='node'&&canCorrectNode}}" class="eng-section record-disclosure" data-section="nodeEdit" bindtap="toggleSection"><text>更正完成记录</text><text>{{expanded.nodeEdit?'收起':'编辑'}}</text></button><template wx:if="{{view==='node'&&fields.length&&own&&node.status!=='已完成'}}" is="record-fields" data="{{layout:view,fields:fields,form:form,fileNames:fileNames,demo:demo,purposes:purposes,purposeLabel:purposeLabel,handlers:handlers}}"/>
    <view wx:if="{{view==='node'&&canCorrectNode&&expanded.nodeEdit}}" class="eng-section node-correct">
     <view class="eng-heading"><text>更正本节点完成记录</text></view>
     <view class="record-field"><text>实际完成日期</text><picker mode="date" value="{{form.nodeDate}}" data-key="nodeDate" bindchange="input"><view>{{form.nodeDate}}</view></picker></view>
     <view class="record-field"><text>施工情况与验收说明（不改留空）</text><textarea value="{{form.nodeNote}}" placeholder="保留原说明" data-key="nodeNote" bindinput="input" auto-height="{{true}}"/></view>
     <view class="record-field"><text>验收凭据</text><picker range="{{nodeEvidenceOptions}}" range-key="label" value="{{nodeEvidenceIndex}}" bindchange="selectNodeReplacement" disabled="{{busy}}"><view>{{nodeEvidenceOptions[nodeEvidenceIndex].label}} ›</view></picker>
      <block wx:if="{{form.nodeReplaceAssetId}}"><button class="eng-outline" data-key="nodeFile" bindtap="upload">{{fileNames.nodeFile||'选择替换这一张的新凭据'}}</button><button wx:if="{{form.nodeFile}}" class="eng-link" data-file="{{form.nodeFile}}" bindtap="preview">预览新凭据</button></block>
     </view>
     <view class="record-field"><text>更正或撤回原因</text><input value="{{form.nodeReason}}" data-key="nodeReason" bindinput="input"/></view>
     <button class="eng-outline eng-submit" data-action="node-correct" bindtap="perform" disabled="{{busy}}">保存更正</button><button wx:if="{{canReopen}}" class="eng-outline eng-submit" data-action="node-reopen" bindtap="perform" disabled="{{busy}}">撤回本节点完成</button><text wx:else class="eng-muted">只有最近完成、且下一节点还没开始记录的节点可以撤回。</text>
    </view>
   <include src="payment-plan.wxml"/>
   <template wx:if="{{view==='prepare'&&fields.length&&own}}" is="record-fields" data="{{layout:view,fields:fields,form:form,fileNames:fileNames,demo:demo,purposes:purposes,purposeLabel:purposeLabel,handlers:handlers}}"/>
   <view wx:if="{{view==='prepare'}}" class="eng-section"><text wx:if="{{!p.actualStart}}" class="eng-muted">开工前需排好计划，并按正式合同收齐开工前约定款项。</text><text wx:else class="eng-muted">{{p.recordFlow.prepared.note}}</text><button class="eng-link" data-url="{{links[1].url}}" bindtap="go">查看移交资料</button></view>
   <block wx:if="{{view==='overview'}}">
    <view class="eng-section project-summary"><view class="eng-heading"><text>施工进度</text><text class="eng-muted">{{paceDone}} / {{paceTotal}} 节点</text></view><view class="eng-progress-row"><view class="eng-progress"><view style="width:{{progressPercent}}%"/></view><text class="summary-percent">{{progressPercent}}%</text></view><view wx:if="{{paceOverdue}}" class="summary-alert"><text>延期 {{paceOverdue}} 个节点</text></view><button wx:if="{{next}}" class="eng-primary" data-url="{{next.url}}" bindtap="go">{{next.title}}</button></view>
    <view class="eng-section project-tools"><button wx:for="{{projectTools}}" wx:key="url" class="project-tool" data-url="{{item.url}}" bindtap="go"><image src="{{item.icon}}"/><text>{{item.label}}</text></button></view>
    <view class="eng-section"><view class="eng-heading"><text>今日待办</text></view><todo-preview id="today-todos" rows="{{pending}}" scope="{{p.id}}" bind:activate="go"/><text wx:if="{{!pending.length}}" class="eng-muted">今日暂无待办</text></view>
    <view class="eng-section"><view class="eng-heading"><text>施工节点</text><text class="eng-muted">共 {{paceTotal}} 项</text></view><button wx:for="{{nodeRows}}" wx:key="id" wx:if="{{expanded.progress||item.preview}}" class="eng-row progress-node-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">{{item.name}}</text><text class="eng-muted">{{item.start||'待排期'}}{{item.end&&item.end!==item.start?' — '+item.end:''}}</text><text wx:if="{{item.pace}}" class="progress-pace {{item.deviationDays>0?'progress-late':''}}">{{item.pace}}</text></view><text class="eng-tag {{st.tone(item.status)}}">{{item.status}} ›</text></button><template is="record-more" data="{{total:nodeRows.length,open:expanded.progress,section:'progress',label:'施工节点'}}"/></view>
    <view wx:if="{{waiting.length}}" class="eng-section"><view class="eng-heading"><text>办理中</text></view><button wx:for="{{waiting}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><text class="eng-grow">{{item.title}}</text><text>查看</text></button><text wx:if="{{!waiting.length}}" class="eng-muted">暂无等待事项</text></view>

   </block>
   <view wx:if="{{view==='payments'||view==='collection'||(view==='prepare'&&!fields.length)||view==='settlement'}}" class="eng-section"><view class="eng-heading"><text>工程收款</text></view><button wx:for="{{installments}}" wx:key="stage" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><view class="record-title-row"><text class="eng-name">{{item.name}}</text><text class="eng-tag">{{item.status}}</text></view><text wx:if="{{item.due||item.waitingForWork}}" class="eng-muted">{{item.waitingForWork?'待施工条件完成':'约定到期 ' + item.due}}</text><view class="record-money-grid"><view><text>应收</text><text>{{item.expected}}</text></view><view><text>已登记</text><text>{{item.confirmed}}</text></view><view><text>待收</text><text>{{item.remaining}}</text></view></view></view></button></view>
   <view wx:if="{{view==='collection'&&collectionDeclarations.length}}" class="eng-section">
    <view class="eng-heading"><text>本期到账申报</text></view>
    <view wx:for="{{collectionDeclarations}}" wx:key="id" wx:if="{{expanded.declarations||index<3}}" class="eng-row"><view class="eng-grow">
      <text class="eng-name">¥ {{item.amountText}} · {{item.status}}</text><text class="eng-muted">{{item.date}} · {{item.transactionNo}}</text>
      <text wx:if="{{item.reason}}" class="eng-muted">退回原因 {{item.reason}}</text><text wx:if="{{item.receiptId}}" class="eng-muted">财务收款单 {{item.receiptId}}</text>
    </view></view><template is="record-more" data="{{total:collectionDeclarations.length,open:expanded.declarations,section:'declarations',label:'记录'}}"/>
   </view>
   <view wx:if="{{view==='collection'&&dunning.length}}" class="eng-section"><view class="eng-heading"><text>催收登记</text></view><view wx:for="{{dunning}}" wx:key="id" wx:if="{{expanded.dunning||index<3}}" class="eng-row"><view class="eng-grow"><text class="eng-name">{{item.label}} · {{item.date}} · {{item.promiseDate?'业主承诺 '+item.promiseDate+' 付款':'已催收，暂无承诺'}}</text><text wx:if="{{item.note}}" class="eng-muted">{{item.note}}</text></view></view><template is="record-more" data="{{total:dunning.length,open:expanded.dunning,section:'dunning',label:'记录'}}"/></view><view wx:if="{{(view==='payments'||view==='collection')&&collections.length}}" class="eng-section"><view class="eng-heading"><text>原收款记录</text></view><view wx:for="{{collections}}" wx:key="id" wx:if="{{expanded.collections||index<3}}" class="eng-row record-collection-row"><view class="eng-grow"><text>{{item.date}} · {{item.amountText}}{{item.status?' · '+item.status:''}}</text><text class="eng-muted">{{item.transaction}}</text></view><view><button wx:if="{{item.canPreviewFile&&item.fileAssetId}}" class="eng-link" data-asset-id="{{item.fileAssetId}}" bindtap="previewAsset">查看凭据</button><button wx:if="{{item.url}}" class="eng-link" data-url="{{item.url}}" bindtap="go">查看项目账</button></view></view><template is="record-more" data="{{total:collections.length,open:expanded.collections,section:'collections',label:'记录'}}"/></view><view wx:if="{{view==='prepare'||view==='project'}}" class="eng-section"><view class="eng-heading"><text>施工计划</text><button wx:if="{{view==='prepare'}}" class="eng-link" bindtap="togglePlan">{{showPlan?'收起':'查看或调整'}}</button></view><text wx:if="{{platEng}}" class="eng-muted">实际开工前填写计划开工日期；远期节点可后补，施工安排可并行。</text><block wx:if="{{view==='project'||showPlan}}"><view wx:if="{{view==='prepare'&&own&&!platEng}}" class="record-template"><picker range="{{templates}}" range-key="name" value="{{templateIndex}}" data-key="templateIndex" bindchange="pickTemplate"><view class="record-field">进度计划模板：{{templates[templateIndex].name}}　点击更换</view></picker><button class="eng-outline eng-submit" data-action="apply-template" bindtap="applyTemplate">恢复标准一级计划节点</button><button class="eng-outline" data-action="import-plan" bindtap="importPlan">从Excel导入进度计划</button><text class="eng-muted">导入约定格式的xlsx：节点名称、开始日期、结束日期三列，最多20行；缺少封顶验收（主体封顶）时自动补充。</text><text class="eng-muted">节点随项目接收自动创建；恢复或导入后，请逐项填写各节点开始与结束日期，随开工准备一并保存。</text></view><picker wx:if="{{view==='project'&&own&&engineers.length}}" range="{{engineers}}" range-key="name" data-key="engineerId" value="{{engineerIndex}}" bindchange="pickEngineer"><view class="record-field">项目工程人员：{{engineers[engineerIndex].name}}　点击调整</view></picker><view wx:for="{{form.nodes}}" wx:key="id" class="record-node schedule-node"><button class="schedule-summary" data-id="{{item.id}}" bindtap="togglePlanNode" aria-label="{{item.name}}，{{planEditorId===item.id?'收起详情':'查看节点详情'}}"><view class="eng-grow"><text class="eng-name">{{item.name}}</text><text class="eng-muted">{{item.milestone==='start'?'计划开工 ':''}}{{item.start||'待排期'}}{{item.milestone!=='start'&&item.end&&item.end!==item.start?' — '+item.end:''}}</text></view><text class="eng-tag {{st.tone(item.status)}}">{{item.status}}</text><image class="disclosure-arrow {{planEditorId===item.id?'is-open':''}}" src="/assets/creation-chevron-muted.png"/></button><view wx:if="{{planEditorId===item.id}}" class="schedule-editor"><input value="{{item.name}}" disabled="{{item.milestone==='start'||!own||p.delivery||p.archived||item.status==='已完成'}}" data-index="{{index}}" data-key="name" bindinput="nodeInput"/><view class="record-grid"><picker mode="date" value="{{item.start}}" disabled="{{!own||p.delivery||p.archived||item.status==='已完成'}}" data-index="{{index}}" data-key="start" bindchange="nodeInput"><view class="record-field"><text>{{item.milestone==='start'?'计划开工':'开始日期'}}</text>{{item.start||'选择日期'}}</view></picker><picker wx:if="{{item.milestone!=='start'}}" mode="date" value="{{item.end}}" disabled="{{!own||p.delivery||p.archived||item.status==='已完成'}}" data-index="{{index}}" data-key="end" bindchange="nodeInput"><view class="record-field"><text>结束日期</text>{{item.end||'选择日期'}}</view></picker></view></view></view></block></view>
   <block wx:if="{{view==='materials'}}"><button wx:if="{{!nodeId}}" class="eng-outline eng-submit" data-url="/pages/build/projects/index?destination=materials" bindtap="go">切换项目</button>
    <view class="eng-section"><view class="eng-heading"><text>材料计划</text></view><button wx:for="{{plans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">材料计划 · {{item.due}}</text><text class="eng-muted">{{item.lines.length}}项材料 · {{item.arrival}} · {{item.payment}}</text></view></button><text wx:if="{{!plans.length}}" class="eng-muted">暂无材料计划</text></view>
