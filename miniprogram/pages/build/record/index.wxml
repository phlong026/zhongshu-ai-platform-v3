       <text class="eng-muted">本项运费（元，无运费填0）</text><input type="digit" placeholder="本项运费（元，无运费填0）" value="{{item.freight}}" data-index="{{index}}" data-key="freight" bindinput="lineInput"/>
      </block>
     </view>
     <button class="eng-outline" data-key="termsFile" bindtap="upload">{{fileNames.termsFile||'上传实际采购凭据'}}</button>
     <button wx:if="{{form.termsFile}}" class="eng-link" data-file="{{form.termsFile}}" bindtap="preview">预览采购凭据</button>
     <button class="eng-outline eng-submit" data-action="material-terms" bindtap="perform" disabled="{{busy}}">保存采购金额</button>
