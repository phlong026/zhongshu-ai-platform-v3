   <view wx:if="{{view==='funding'&&node}}" class="eng-section"><text class="eng-name">{{node.name}} · {{node.status}}</text><text class="eng-muted">计划 {{node.start}} 至 {{node.end}}</text><button wx:if="{{view==='funding'}}" class="eng-link" data-url="{{nodeRecordUrl}}" bindtap="go">查看施工节点</button></view>
   <view wx:if="{{view==='node'}}" class="eng-section"><view class="eng-heading"><text>节点材料</text><button class="eng-link" data-url="{{nodeMaterialUrl}}" bindtap="go">{{node.status==='已完成'?'查看计划':'提交或查看'}}</button></view><button wx:for="{{nodePlans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>{{item.lines.length}}项材料 · {{item.due}}</text><text class="eng-muted">{{item.arrival}} · {{item.payment}}</text></view><text>查看</text></button><text wx:if="{{!nodePlans.length}}" class="eng-muted">暂无材料计划</text></view>
   <view wx:if="{{(view==='node'||view==='funding')&&nodeMoney}}" class="eng-section"><view class="eng-heading"><text>节点资金</text><button wx:if="{{view==='node'}}" class="eng-link" data-url="{{nodeFundingUrl}}" bindtap="go">查看或记录</button></view><view class="record-money-grid"><view><text>材料应付</text><text>{{nodeMoney.committedText}}</text></view><view><text>已付</text><text>{{nodeMoney.paidText}}</text></view><view><text>待付</text><text>{{nodeMoney.remainingText}}</text></view></view><text wx:if="{{!nodeMoney.known}}" class="eng-muted">含未定价材料，金额待补全</text><text wx:if="{{nodeMoney.funding}}" class="eng-muted">计划用款 {{nodeMoney.funding.due}} · {{nodeMoney.funding.note}}</text><block wx:if="{{view==='funding'}}"><button wx:for="{{nodePlans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>材料计划 · {{item.due}}</text><text class="eng-muted">{{item.payment}} · 应付 {{item.totalText}}</text></view><text>查看</text></button><view wx:for="{{nodeMoney.expenses}}" wx:key="id" class="record-field"><text>{{item.name}} · {{item.amountText}}</text><text class="eng-muted">{{item.status==='approved'?'已批准':item.status==='pending'?'待确认':'原事项待补充'}}</text></view><button class="eng-outline eng-submit" data-url="/pages/build/record/index?id={{p.id}}&view=expenses" bindtap="go">项目人工及其他费用</button></block></view>
