    <view wx:if="{{canAdjust}}" class="eng-section material-adjust"><button class="record-disclosure" data-section="adjust" bindtap="toggleSection"><text>调整需用数量</text><text>{{expanded.adjust?'收起':'调整'}}</text></button><block wx:if="{{expanded.adjust}}"><text class="eng-muted">填 0 取消用料，不撤销应付。不得少于已到货数量。</text><view wx:for="{{form.lines}}" wx:key="id" class="record-field"><text>{{item.name}} · 需用 {{item.quantity}}{{item.unit}} · 已到 {{item.received}}{{item.unit}}</text><text wx:if="{{item.locked}}" class="eng-muted">已有付款，不能由工程调整</text><input wx:else type="digit" placeholder="调整后的需用数量，不改留空" value="{{item.adjust}}" data-index="{{index}}" data-key="adjust" bindinput="lineInput"/></view><view class="record-field"><text>调整原因</text><input value="{{form.adjustReason}}" data-key="adjustReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="material-adjust" bindtap="perform" disabled="{{busy}}">保存数量调整</button></block></view><view wx:if="{{materialFollowups.length}}" class="eng-section"><view class="eng-heading"><text>催到货记录</text></view><view wx:for="{{materialFollowups}}" wx:key="id" wx:if="{{expanded.followups||index<3}}" class="record-field"><text>{{item.date}} · {{item.promiseDate?'供应商承诺 '+item.promiseDate+' 到货':'已催办，暂无承诺日期'}}</text><text wx:if="{{item.note}}" class="eng-muted">{{item.note}}</text></view><template is="record-more" data="{{total:materialFollowups.length,open:expanded.followups,section:'followups',label:'记录'}}"/></view><view wx:if="{{arrivals.length}}" class="eng-section"><view class="eng-heading"><text>到货记录</text></view><view wx:for="{{arrivals}}" wx:key="id" wx:if="{{expanded.arrivals||index<3}}" class="record-field"><text>{{item.date}} · {{item.materialName}} · {{item.qualityText}} {{item.actual}}{{item.unit}}</text><text class="eng-muted">{{item.note}}</text><text wx:if="{{item.corrections.length}}" class="eng-muted">已更正，原记 {{item.corrections[0].from}}{{item.unit}}</text><button wx:if="{{item.file}}" class="eng-link" data-file="{{item.file}}" bindtap="preview">查看到货凭据</button><button wx:if="{{item.canCorrect}}" class="eng-link" data-id="{{item.id}}" bindtap="pickArrival">更正数量</button></view><template is="record-more" data="{{total:arrivals.length,open:expanded.arrivals,section:'arrivals',label:'记录'}}"/></view><view wx:if="{{view==='material'&&form.correctId}}" class="eng-section"><view class="eng-heading"><text>更正到货数量</text><button class="eng-link" bindtap="cancelCorrection">取消</button></view><view class="record-field"><text>更正后的实到数量</text><input type="digit" value="{{form.correctActual}}" data-key="correctActual" bindinput="input"/></view><view class="record-field"><text>更正原因</text><input value="{{form.correctReason}}" data-key="correctReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="arrival-correct" bindtap="perform" disabled="{{busy}}">保存更正</button></view>
    <view wx:if="{{canTerms}}" class="eng-section">
     <view class="eng-heading"><text>采购金额（财务记录）</text></view>
     <text class="eng-muted">已付款项不可修改。</text>
     <view wx:for="{{form.lines}}" wx:key="id" wx:if="{{!item.cancelled}}" class="record-node">
      <text class="eng-name">{{item.name}}</text><text wx:if="{{item.termsLocked}}" class="eng-muted">请到原财务事项处理。</text>
      <block wx:else>
       <text class="eng-muted">实际供应方</text><input placeholder="实际供应方" value="{{item.supplier}}" data-index="{{index}}" data-key="supplier" bindinput="lineInput"/>
