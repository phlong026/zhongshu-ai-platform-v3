   <view wx:if="{{view==='payments'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>付款与成本</text></view><button class="eng-row" data-url="/pages/build/record/index?id={{p.id}}&view=expenses" bindtap="go">项目费用</button><button class="eng-row" data-view="payables" bindtap="operating">{{own?'材料付款进度':'材料及费用付款记录'}}</button><button class="eng-row" data-view="costs" bindtap="operating">项目成本</button></view>
   <view wx:if="{{view==='expenses'}}" class="eng-section"><view class="eng-heading"><text>项目费用清单</text><button wx:if="{{!expenseSaveState&&expenseMode!=='register'}}" class="eng-link" data-mode="register" bindtap="expenseMode">{{p.archived?'返回费用清单':'返回登记'}}</button></view><view wx:for="{{expenseRows}}" wx:key="id" wx:if="{{expanded.expenses||index<3}}" class="record-field"><view class="eng-grow"><text>{{item.name}} · {{item.purposeText}} · {{item.amountText}}元</text><text class="eng-muted">{{item.statusText}}</text></view><view wx:if="{{!expenseSaveState}}"><button wx:if="{{item.canTerms}}" class="eng-link" data-mode="terms" data-id="{{item.id}}" bindtap="expenseMode">挂应付</button><button wx:if="{{item.canRevise}}" class="eng-link" data-mode="revise" data-id="{{item.id}}" bindtap="expenseMode">修订</button><button wx:if="{{item.canCancel}}" class="eng-link" data-mode="cancel" data-id="{{item.id}}" bindtap="expenseMode">取消</button></view></view><template is="record-more" data="{{total:expenseRows.length,open:expanded.expenses,section:'expenses',label:'记录'}}"/><text wx:if="{{!expenseRows.length}}" class="eng-muted">暂无项目费用</text><text wx:if="{{expenseMode!=='register'&&expenseTarget}}" class="eng-name">当前操作：{{expenseTarget}}</text></view>
