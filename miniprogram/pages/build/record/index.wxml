   <view wx:if="{{view==='node'&&siteRecords.length}}" class="eng-section node-site-records"><view class="eng-heading"><text>现场记录</text></view><view wx:for="{{siteRecords}}" wx:key="id" wx:if="{{expanded.site||index<3}}" class="record-field"><text>{{item.date}} · {{item.note}}</text><view wx:if="{{item.images.length}}" class="record-photos"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="path" class="record-photo" src="{{photo.path}}" mode="aspectFill" data-file="{{photo}}" bindtap="preview"/></view><button wx:if="{{item.file&&!item.images.length}}" class="eng-link" data-file="{{item.file}}" bindtap="preview">查看现场凭据</button><block wx:if="{{!item.file&&!item.images.length&&item.files.length}}"><button wx:for="{{item.files}}" wx:for-item="asset" wx:key="assetId" class="eng-link" data-asset-id="{{asset.assetId}}" catchtap="previewAsset">查看凭据{{index+1>1?'（'+(index+1)+'）':''}}</button></block><button wx:if="{{item.canCorrect}}" class="eng-link" data-id="{{item.id}}" bindtap="pickSite">更正</button></view><template is="record-more" data="{{total:siteRecords.length,open:expanded.site,section:'site',label:'记录'}}"/></view><view wx:if="{{view==='node'&&form.siteId}}" class="eng-section"><view class="eng-heading"><text>更正现场记录</text><button class="eng-link" bindtap="cancelCorrection">取消</button></view><view class="record-field"><text>现场情况</text><textarea value="{{form.siteNote}}" data-key="siteNote" bindinput="input" auto-height="{{true}}"/></view><view class="record-field"><text>现场凭据（不换可不选）</text><button class="eng-outline" data-key="siteFile" bindtap="upload">{{fileNames.siteFile||'选择凭据'}}</button><button wx:if="{{demo}}" class="eng-outline" data-sample-key="siteFile" bindtap="useSampleFile">使用本项目参考凭据</button><button wx:if="{{form.siteFile}}" class="eng-link" data-file="{{form.siteFile}}" bindtap="preview">预览现场凭据</button></view><view class="record-field"><text>更正原因</text><input value="{{form.siteReason}}" data-key="siteReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="site-correct" bindtap="perform" disabled="{{busy}}">保存更正</button></view><view wx:if="{{view==='delivery'&&p.delivery}}" class="eng-section"><view class="eng-heading"><text>交付记录</text></view><text class="eng-muted">{{p.delivery.date}} · 接收人：{{p.delivery.recipient}}</text><button wx:if="{{p.delivery.fileAssetId}}" class="eng-link" data-asset-id="{{p.delivery.fileAssetId}}" catchtap="previewAsset">查看交付凭据</button><button wx:if="{{p.delivery.ownerAssetId&&p.delivery.ownerAssetId!==p.delivery.fileAssetId}}" class="eng-link" data-asset-id="{{p.delivery.ownerAssetId}}" catchtap="previewAsset">查看业主签收凭据</button></view>
   <view wx:if="{{view==='documents'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>项目资料</text></view><button wx:for="{{docs}}" wx:key="name" class="eng-row" data-kind="{{item.file.previewKind}}" data-file="{{item.file}}" bindtap="preview"><view class="eng-grow"><text>{{item.name}}</text></view><text>查看</text></button></view>
   <view wx:if="{{view==='settlement'}}" class="eng-section"><view class="eng-heading"><text>结算汇总</text></view><text class="eng-name">{{p.settlement?'已于 '+p.settlement.date+' 确认结算':'待确认'}}</text><text wx:if="{{p.settlement}}" class="eng-muted">{{p.settlement.note}}</text><view class="settlement-table"><view><text>支出</text><text>应付</text><text>已付</text><text>待付</text></view><view><text>材料</text><text>{{settle.materialsTotalText}}</text><text>{{settle.materialsPaidText}}</text><text>{{settle.materialsRemainingText}}</text></view><view><text>费用</text><text>{{settle.expensesTotalText}}</text><text>{{settle.expensesPaidText}}</text><text>{{settle.expensesRemainingText}}{{settle.expenseReview.length?'（原账余额，待核对）':''}}</text></view></view><view wx:if="{{settle.expenseReview.length}}" class="eng-note">
