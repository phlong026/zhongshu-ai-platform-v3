   <button wx:if="{{platEng&&(view==='overview'||view==='node')}}" class="eng-outline" data-url="/pages/build/issues/index?project={{p.id}}&node={{view==='node'?node.id:''}}" bindtap="go">现场整改与复验 ›</button>
   <view wx:if="{{(view==='overview'||view==='project'||view==='archive'||view==='settlement')&&events.length}}" class="eng-section"><view class="eng-heading"><text>项目记录</text></view><view wx:for="{{events}}" wx:key="id" wx:if="{{expanded.events||index<3}}" class="record-field record-event-row"><text>{{item.title}}</text><text class="eng-muted">{{item.time}} · {{item.by}}</text></view><template is="record-more" data="{{total:events.length,open:expanded.events,section:'events',label:'记录'}}"/></view>
  </block>
  <view wx:if="{{samplePreview.previewKind}}" class="record-document-mask"><view class="record-document-panel"><view class="eng-heading"><text>{{samplePreview.name}}</text><button class="eng-link" bindtap="closeSamplePreview">关闭</button></view><scroll-view scroll-y class="record-document-scroll"><view class="record-document-paper"><text class="record-document-title">{{samplePreview.name}}</text><text class="eng-muted">众墅之家 · {{samplePreview.meta.version}}</text><view class="record-document-summary"><text>{{samplePreview.previewCustomer}} · {{samplePreview.previewArea}}㎡</text><text>版本 {{samplePreview.meta.version}}</text></view><image wx:if="{{samplePreview.previewImage}}" src="{{samplePreview.previewImage}}" bindtap="zoomSampleImage" mode="aspectFit"/><view wx:if="{{samplePreview.previewKind==='review'}}" class="record-document-review">✓<text>本版专业审核已完成</text></view><view wx:if="{{samplePreview.previewKind==='confirmation'}}" class="record-document-confirmation"><text>确认采用本版设计成果及施工图</text><text>{{samplePreview.meta.confirmationParty}}</text></view><text class="eng-muted">{{samplePreview.projectName}}</text><text class="record-document-version">体验资料 · {{samplePreview.projectId}}</text></view></scroll-view></view></view>
  <view wx:if="{{samplePreview&&!samplePreview.previewKind}}" class="eng-section"><view class="eng-heading"><text>{{samplePreview.name}}</text></view><text class="eng-name">{{samplePreview.text}}</text><button class="eng-outline" bindtap="closeSamplePreview">关闭预览</button></view>
  <view wx:if="{{view==='project'&&(canTransferManager||managerTransferPending)}}" class="eng-section">
    <view class="eng-heading"><text>工程负责人</text></view>
    <button wx:if="{{!managerTransferOpen&&!managerTransferPending}}" class="eng-outline" bindtap="openManagerTransfer" disabled="{{busy}}">转交工程</button>
    <view wx:if="{{managerTransferOpen||managerTransferPending}}">
      <text wx:if="{{managerTransferError}}" class="eng-muted">{{managerTransferError}}</text>
      <text wx:if="{{managerTransferLoading}}" class="eng-muted">正在查找可接手同事…</text>
      <picker wx:if="{{managerTransferRows.length&&!managerTransferPending}}" range="{{managerTransferRows}}" range-key="name" bindchange="pickManagerTransfer" disabled="{{busy}}"><view class="record-field">{{managerTransferName||'选择接手同事'}}</view></picker>
      <button wx:if="{{managerTransferRows.length&&!managerTransferPending}}" class="eng-primary" bindtap="confirmManagerTransfer" disabled="{{busy||!managerTransferSelected}}">确认转交</button>
      <button wx:if="{{managerTransferPending}}" class="eng-outline" bindtap="retryManagerTransfer" loading="{{busy}}" disabled="{{busy}}">核对转交结果</button>
      <button wx:elif="{{!managerTransferLoading&&!managerTransferRows.length&&managerTransferError}}" class="eng-outline" bindtap="openManagerTransfer" disabled="{{busy}}">重新加载名单</button>
      <button wx:if="{{!managerTransferPending}}" class="eng-link" bindtap="closeManagerTransfer" disabled="{{busy}}">收起</button>
    </view>
  </view>
  <view wx:if="{{actions.length&&!expenseSaveState&&(view!=='node'||node.status!=='已完成')}}" class="page-actions record-actions"><button wx:for="{{actions}}" wx:key="action" class="{{index===0?'eng-primary':'eng-outline'}} primary-action" data-action="{{item.action}}" bindtap="perform" loading="{{busy}}" disabled="{{busy||paymentUncertain||paymentConflict||managerTransferPending}}">{{item.label}}</button></view>
 </view>
</view>
