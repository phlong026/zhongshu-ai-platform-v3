<view class="page engineering-desk record-page">
 <brand-header title="{{title}}" divider="{{true}}"/>
 <view class="eng-content">
  <view class="record-nav"><button bindtap="back">返回</button><button bindtap="home">工程首页</button></view>
  <text wx:if="{{error}}" class="eng-error">{{error}}</text>
  <block wx:if="{{p}}">
   <view class="eng-section"><text class="eng-name">{{p.name}}</text><text class="eng-muted">项目工程人员：{{p.manager}}</text><text class="eng-tag">{{stageText}}</text><text class="eng-muted">{{p.city}} · {{p.area}}㎡ · {{p.floors}}层</text></view>
   <block wx:if="{{view==='overview'}}">
    <view class="eng-section"><view class="eng-heading"><text>下一步</text></view><button wx:if="{{next}}" class="eng-primary" data-url="{{next.url}}" bindtap="go">{{next.title}}</button><text wx:else class="eng-muted">施工记录已完成，款项与保修可在原项目继续办理</text></view>
    <view class="eng-section"><view class="eng-heading"><text>施工进度</text></view><view wx:for="{{p.plan.nodes}}" wx:key="id" class="eng-row"><view class="eng-grow"><text class="eng-name">{{item.name}}</text><text class="eng-muted">{{item.start}} 至 {{item.end}}</text></view><text class="eng-tag">{{item.status}}</text></view><button wx:if="{{own&&!p.delivery}}" class="eng-outline eng-submit" data-url="{{nodeUrl}}" bindtap="go">记录当前施工节点</button></view>
    <view class="eng-section"><view class="eng-heading"><text>待我办理</text></view><button wx:for="{{pending}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><text class="eng-grow">{{item.title}}</text><text>去记录</text></button><text wx:if="{{!pending.length}}" class="eng-muted">暂无待办</text></view>
    <view class="eng-section"><view class="eng-heading"><text>办理中</text></view><button wx:for="{{waiting}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><text class="eng-grow">{{item.title}}</text><text>查看</text></button><text wx:if="{{!waiting.length}}" class="eng-muted">暂无等待事项</text></view>
    <view class="eng-section"><button wx:for="{{links}}" wx:key="label" class="eng-row" data-url="{{item.url}}" bindtap="go"><text>{{item.label}}</text></button></view>
   </block>
   <view wx:if="{{view==='overview'||view==='payments'||view==='collection'||view==='prepare'}}" class="eng-section"><view class="eng-heading"><text>两次工程收款</text></view><button wx:for="{{installments}}" wx:key="stage" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">{{item.name}} · {{item.status}}</text><text class="eng-muted">应收 {{item.expected}} · 已确认 {{item.confirmed}}</text><text class="eng-muted">待财务确认 {{item.pending}} · 待收 {{item.remaining}}</text></view></button></view>
   <view wx:if="{{(view==='payments'||view==='collection')&&collections.length}}" class="eng-section"><view class="eng-heading"><text>原收款记录</text></view><button wx:for="{{collections}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>{{item.date}} · {{item.amountText}} · {{item.status}}</text><text class="eng-muted">{{item.transaction}}</text></view><text>{{item.status==='退回补充'?'补充原记录':'查看'}}</text></button></view><view wx:if="{{view==='prepare'||view==='project'}}" class="eng-section"><view class="eng-heading"><text>施工计划</text></view><picker wx:if="{{view==='project'&&own}}" range="{{engineers}}" range-key="name" value="{{engineerIndex}}" bindchange="pickEngineer"><view class="record-field">项目工程人员：{{engineers[engineerIndex].name}}　点击调整</view></picker><view wx:for="{{form.nodes}}" wx:key="id" class="record-node"><input value="{{item.name}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="name" bindinput="nodeInput"/><text class="eng-muted">{{item.status}}</text><picker mode="date" value="{{item.start}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="start" bindchange="nodeInput"><view class="record-field">开始：{{item.start}}</view></picker><picker mode="date" value="{{item.end}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="end" bindchange="nodeInput"><view class="record-field">结束：{{item.end}}</view></picker></view></view>
   <block wx:if="{{view==='materials'}}"><button class="eng-outline eng-submit" data-url="/pages/build/projects/index?destination=materials" bindtap="go">选择其他项目的材料计划</button>
    <view class="eng-section"><view class="eng-heading"><text>已有材料计划</text></view><button wx:for="{{plans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">材料计划 · {{item.due}}</text><text class="eng-muted">{{item.lines.length}}项材料 · {{item.arrival}} · {{item.payment}}</text></view></button><text wx:if="{{!plans.length}}" class="eng-muted">暂无材料计划</text></view>
    <view wx:if="{{own&&!p.delivery}}" class="eng-section"><view class="eng-heading"><text>提交材料计划</text></view><picker range="{{p.plan.nodes}}" range-key="name" value="{{nodeIndex}}" bindchange="pickNode"><view class="record-field">使用节点：{{p.plan.nodes[nodeIndex].name}}　点击选择</view></picker><view wx:for="{{form.lines}}" wx:key="index" class="record-node"><input placeholder="材料名称" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="lineInput"/><input placeholder="规格（选填）" value="{{item.spec}}" data-index="{{index}}" data-key="spec" bindinput="lineInput"/><view class="record-grid"><input type="digit" placeholder="需用数量" value="{{item.quantity}}" data-index="{{index}}" data-key="quantity" bindinput="lineInput"/><input placeholder="单位" value="{{item.unit}}" data-index="{{index}}" data-key="unit" bindinput="lineInput"/></view></view><button class="eng-outline" bindtap="addLine">添加一种材料</button></view>
   </block>
   <block wx:if="{{view==='material'&&plan}}">
    <view class="eng-section"><view class="eng-heading"><text>到货与付款</text></view><text class="eng-name">{{plan.arrival}} · {{plan.payment}}</text><text class="eng-muted">应付 {{plan.totalText}} · 已付 {{plan.paidText}} · 待付 {{plan.remainingText}}</text><view wx:for="{{plan.lines}}" wx:key="id" class="eng-row"><view class="eng-grow"><text class="eng-name">{{item.name}} {{item.spec}}</text><text class="eng-muted">需用 {{item.quantity}}{{item.unit}} · 合格实收 {{item.received}}{{item.unit}} · 未到 {{item.remaining}}{{item.unit}}</text><text class="eng-muted">{{item.supplier}} · {{item.paymentStatus}}</text></view><button wx:if="{{(finance||item.canSupplement)&&item.payUrl}}" class="eng-outline" data-url="{{item.payUrl}}" bindtap="go">{{item.canSupplement?'补充原事项':'办理付款'}}</button></view></view>
    <view wx:if="{{own&&!p.delivery&&plan.arrival!=='已验收齐全'}}" class="eng-section"><view class="eng-heading"><text>确认本次到货</text></view><view wx:for="{{form.lines}}" wx:key="id" class="record-field"><text>{{item.name}}</text><input type="digit" placeholder="本次实际合格到货数量，无到货留空" value="{{item.actual}}" data-index="{{index}}" data-key="actual" bindinput="lineInput"/></view></view>
    <view wx:if="{{arrivals.length}}" class="eng-section"><view class="eng-heading"><text>到货记录</text></view><view wx:for="{{arrivals}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.materialName}} · 合格实收 {{item.actual}}{{item.unit}}</text><text class="eng-muted">{{item.note}}</text><button class="eng-link" data-file="{{item.file}}" bindtap="preview">查看到货凭据</button></view></view>
    <view wx:if="{{canTerms}}" class="eng-section"><view class="eng-heading"><text>付款信息</text></view><text class="eng-muted">由公司或财务记录实际采购金额，付款沿原财务事项办理</text><view wx:for="{{form.lines}}" wx:key="id" class="record-node"><text class="eng-name">{{item.name}}</text><input placeholder="实际供应方" value="{{item.supplier}}" data-index="{{index}}" data-key="supplier" bindinput="lineInput"/><input type="digit" placeholder="实际单价（元）" value="{{item.unitPrice}}" data-index="{{index}}" data-key="unitPrice" bindinput="lineInput"/><input type="digit" placeholder="本项运费（元，无运费填0）" value="{{item.freight}}" data-index="{{index}}" data-key="freight" bindinput="lineInput"/></view><button class="eng-outline" data-key="termsFile" bindtap="upload">{{form.termsFile.name||'上传实际采购凭据'}}</button><button class="eng-outline eng-submit" data-action="material-terms" bindtap="perform" disabled="{{busy}}">保存付款信息，交财务办理</button></view>
   </block>
   <view wx:if="{{view==='node'&&node}}" class="eng-section"><text class="eng-name">{{node.name}} · {{node.status}}</text><text class="eng-muted">记录实际施工、现场验收与问题处理结果，完成后接续下一节点</text><button class="eng-outline eng-submit" data-url="{{links[2].url}}" bindtap="go">查看本项目材料计划</button></view>
   <view wx:if="{{view==='node'&&siteRecords.length}}" class="eng-section"><view class="eng-heading"><text>本节点现场记录</text></view><view wx:for="{{siteRecords}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.note}}</text><button wx:if="{{item.file}}" class="eng-link" data-file="{{item.file}}" bindtap="preview">查看现场凭据</button></view></view><view wx:if="{{view==='documents'||view==='archive'||view==='prepare'}}" class="eng-section"><view class="eng-heading"><text>项目资料</text></view><button wx:for="{{docs}}" wx:key="name" class="eng-row" data-file="{{item.file}}" bindtap="preview"><view class="eng-grow"><text>{{item.name}}</text><text class="eng-muted">{{item.file.name}}</text></view><text>查看</text></button></view>
   <view wx:if="{{view==='archive'}}" class="eng-section"><text class="eng-name">{{p.archived?'施工资料已归档':p.delivery?'已交付，待归档':'请先记录工程交付'}}</text><text wx:if="{{p.delivery}}" class="eng-muted">{{p.delivery.date}} · 业主签收：{{p.delivery.recipient}}</text><button class="eng-outline eng-submit" data-url="{{links[5].url}}" bindtap="go">保修记录</button></view>
   <view wx:if="{{view==='payments'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>费用与财务收尾</text></view><button class="eng-row" data-view="expenses" bindtap="operating">人工、运输及其他项目费用</button><button class="eng-row" data-view="payables" bindtap="operating">材料及费用付款记录</button><button class="eng-row" data-view="costs" bindtap="operating">项目成本</button><button class="eng-row" data-view="settlement" bindtap="operating">项目财务结清</button></view>
   <view wx:if="{{fields.length&&own}}" class="eng-section"><view wx:for="{{fields}}" wx:key="key" class="record-field"><text>{{item.label}}</text><picker wx:if="{{item.type==='date'}}" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="input"><view>{{form[item.key]||'请选择日期'}}</view></picker><button wx:elif="{{item.type==='file'}}" class="eng-outline" data-key="{{item.key}}" bindtap="upload">{{form[item.key].name||'选择凭据'}}</button><button wx:elif="{{item.type==='check'}}" class="record-check" data-key="{{item.key}}" bindtap="toggle">{{form[item.key]?'已确认':'点击确认'}}</button><textarea wx:elif="{{item.type==='textarea'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height="{{true}}"/><input wx:else type="{{item.type==='digit'?'digit':'text'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input"/></view></view>
   <button wx:for="{{actions}}" wx:key="action" class="eng-primary eng-submit primary-action" data-action="{{item.action}}" bindtap="perform" loading="{{busy}}" disabled="{{busy}}">{{item.label}}</button>
   <view wx:if="{{view==='warranty'}}" class="eng-section"><view wx:for="{{warranties}}" wx:key="id" class="eng-row"><view class="eng-grow"><text>{{item.date}} · {{item.status}}</text><text class="eng-muted">{{item.note}}</text></view><button wx:if="{{own}}" class="eng-outline" data-id="{{item.id}}" bindtap="editWarranty">补充原记录</button></view></view>
   <view wx:if="{{view==='overview'||view==='project'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>项目记录</text></view><view wx:for="{{events}}" wx:key="id" class="record-field"><text>{{item.title}}</text><text class="eng-muted">{{item.time}} · {{item.by}}</text></view></view>
  </block>
 </view>
</view>
