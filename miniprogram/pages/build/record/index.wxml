<wxs src="../../../utils/tone.wxs" module="st"/>
<template name="record-fields"><view class="eng-section record-fields"><view wx:for="{{fields}}" wx:key="key" class="record-field"><text>{{item.label}}</text><picker wx:if="{{item.type==='date'}}" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="input"><view>{{form[item.key]||'请选择日期'}}</view></picker><picker wx:elif="{{item.type==='supply'}}" range="{{form.supplyOptions}}" range-key="label" bindchange="supplyPick"><view class="record-field">{{form.supplyLabel||'请选择供应事项'}}</view></picker><picker wx:elif="{{item.type==='purpose'}}" range="{{purposes}}" range-key="label" bindchange="pickPurpose"><view class="record-field">{{purposeLabel||'请选择费用用途'}}</view></picker><view wx:elif="{{item.type==='file'}}"><button class="eng-outline" data-key="{{item.key}}" bindtap="upload">{{fileNames[item.key]||'选择实际凭据'}}</button><button wx:if="{{demo}}" class="eng-outline" data-sample-key="{{item.key}}" bindtap="useSampleFile">使用本项目参考凭据</button><button wx:if="{{form[item.key]}}" class="eng-link" data-file="{{form[item.key]}}" bindtap="preview">预览已选凭据</button></view><button wx:elif="{{item.type==='check'}}" class="record-check" data-key="{{item.key}}" bindtap="toggle">{{form[item.key]?'已确认':'点击确认'}}</button><textarea wx:elif="{{item.type==='textarea'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height="{{true}}"/><input wx:else type="{{item.type==='digit'?'digit':'text'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input"/></view></view></template>
<view class="page engineering-desk record-page">

 <brand-header id="brand-header" title="{{title}}" divider="{{true}}"/>
 <view class="eng-content">
  <text wx:if="{{error}}" class="eng-error">{{error}}</text>
  <block wx:if="{{p}}">
   <view class="eng-section"><text class="eng-name">{{p.name}}</text><text class="eng-muted">项目工程人员：{{p.manager}}</text><text class="eng-tag">{{stageText}}</text><text class="eng-muted">{{p.city}} · {{p.area}}㎡ · {{p.floors}}层</text></view>
   <view wx:if="{{view==='node'&&node}}" class="eng-section"><text class="eng-name">{{node.name}} · {{node.status}}</text><text class="eng-muted">计划 {{node.start}} 至 {{node.end}}</text><view class="record-node-menu"><button data-section="site" bindtap="jumpNodeSection">施工记录</button><button data-section="inspection" bindtap="jumpNodeSection">验收记录</button><button data-url="{{nodeMaterialUrl}}" bindtap="go">材料计划 {{nodePlans.length}}</button><button data-url="{{nodeFundingUrl}}" bindtap="go">资金计划</button></view></view>
   <template wx:if="{{view==='node'&&fields.length&&own}}" is="record-fields" data="{{fields:fields,form:form,fileNames:fileNames,demo:demo,purposes:purposes,purposeLabel:purposeLabel}}"/>
   <template wx:if="{{view==='prepare'&&fields.length&&own}}" is="record-fields" data="{{fields:fields,form:form,fileNames:fileNames,demo:demo,purposes:purposes,purposeLabel:purposeLabel}}"/>
   <view wx:if="{{view==='prepare'}}" class="eng-section"><text wx:if="{{platEng}}" class="eng-muted">在线保存已开放（凭据走平台资产通道上传）；请核对三期金额（Σ须等于合同总额）后提交，真实 COS 渠道验收随后续批次。</text><text class="eng-muted">收款期次约定随已签合同自动生成并即时生效；各期款项由门店财务登记，收齐后推进后续节点。</text><button class="eng-link" data-url="{{links[1].url}}" bindtap="go">查看已接收的项目资料</button></view>
   <block wx:if="{{view==='overview'}}">
    <view class="eng-section"><view class="eng-heading"><text>下一步</text></view><button wx:if="{{next}}" class="eng-primary" data-url="{{next.url}}" bindtap="go">{{next.title}}</button><text wx:else class="eng-muted">施工记录已完成，结算、归档与款项可在原项目继续办理</text></view>
    <view class="eng-section"><view class="eng-heading"><text>施工进度</text><text class="eng-muted">{{paceDone}}/{{paceTotal}} 节点完成</text><text wx:if="{{paceOverdue}}" class="eng-tag tone-danger">逾期{{paceOverdue}}个节点</text></view><button wx:for="{{nodeRows}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">{{item.name}}</text><text class="eng-muted">{{item.start}} 至 {{item.end}}</text></view><text wx:if="{{item.pace}}" class="eng-tag {{st.tone(item.pace)}}">{{item.pace}}</text><text class="eng-tag {{st.tone(item.status)}}">{{item.status}} ›</text></button><button wx:if="{{own&&!p.delivery}}" class="eng-outline eng-submit" data-url="{{nodeUrl}}" bindtap="go">记录当前施工节点</button></view>
    <view class="eng-section"><view class="eng-heading"><text>今日待办</text></view><button wx:for="{{pending}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><text class="eng-grow">{{item.title}}</text><text>去记录</text></button><text wx:if="{{!pending.length}}" class="eng-muted">今日暂无待办</text></view>
    <view class="eng-section"><view class="eng-heading"><text>办理中</text></view><button wx:for="{{waiting}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><text class="eng-grow">{{item.title}}</text><text>查看</text></button><text wx:if="{{!waiting.length}}" class="eng-muted">暂无等待事项</text></view>
    <view class="eng-section"><button wx:for="{{links}}" wx:key="label" class="eng-row" data-url="{{item.url}}" bindtap="go"><text>{{item.label}}</text></button></view>
   </block>
   <view wx:if="{{view==='overview'||view==='payments'||view==='collection'||view==='prepare'||view==='settlement'}}" class="eng-section"><view class="eng-heading"><text>工程收款期次</text></view><button wx:for="{{installments}}" wx:key="stage" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">{{item.name}} · {{item.status}}</text><text class="eng-muted">应收 {{item.expected}} · 已登记 {{item.confirmed}}</text><text class="eng-muted">待收 {{item.remaining}}</text></view></button></view>
   <view wx:if="{{view==='collection'&&dunning.length}}" class="eng-section"><view class="eng-heading"><text>催收登记</text></view><view wx:for="{{dunning}}" wx:key="id" class="eng-row"><view class="eng-grow"><text class="eng-name">{{item.date}} · {{item.promiseDate?'业主承诺 '+item.promiseDate+' 付款':'已催收，暂无承诺'}}</text><text wx:if="{{item.note}}" class="eng-muted">{{item.note}}</text></view></view></view><view wx:if="{{(view==='payments'||view==='collection')&&collections.length}}" class="eng-section"><view class="eng-heading"><text>原收款记录</text></view><button wx:for="{{collections}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>{{item.date}} · {{item.amountText}} · {{item.status}}</text><text class="eng-muted">{{item.transaction}}</text></view><view><text wx:if="{{item.fileAssetId}}" class="eng-link" data-asset-id="{{item.fileAssetId}}" catchtap="previewAsset">查看凭据</text><text>{{item.status==='退回补充'?'补充原记录':'查看'}}</text></view></button></view><view wx:if="{{view==='prepare'||view==='project'}}" class="eng-section"><view class="eng-heading"><text>施工计划</text><button wx:if="{{view==='prepare'}}" class="eng-link" bindtap="togglePlan">{{showPlan?'收起':'查看或调整'}}</button></view><block wx:if="{{view==='project'||showPlan}}"><view wx:if="{{view==='prepare'&&own&&!platEng}}" class="record-template"><picker range="{{templates}}" range-key="name" value="{{templateIndex}}" data-key="templateIndex" bindchange="pickTemplate"><view class="record-field">进度计划模板：{{templates[templateIndex].name}}　点击更换</view></picker><button class="eng-outline eng-submit" data-action="apply-template" bindtap="applyTemplate">恢复标准一级计划节点</button><button class="eng-outline" data-action="import-plan" bindtap="importPlan">从Excel导入进度计划</button><text class="eng-muted">导入约定格式的xlsx：节点名称、开始日期、结束日期三列，最多20行；缺少封顶验收（主体封顶）时自动补充。</text><text class="eng-muted">节点随项目接收自动创建；恢复或导入后，请逐项填写各节点开始与结束日期，随开工准备一并保存。</text></view><picker wx:if="{{view==='project'&&own&&engineers.length}}" range="{{engineers}}" range-key="name" data-key="engineerId" value="{{engineerIndex}}" bindchange="pickEngineer"><view class="record-field">项目工程人员：{{engineers[engineerIndex].name}}　点击调整</view></picker><view wx:for="{{form.nodes}}" wx:key="id" class="record-node"><input value="{{item.name}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="name" bindinput="nodeInput"/><text class="eng-muted">{{item.status}}</text><picker mode="date" value="{{item.start}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="start" bindchange="nodeInput"><view class="record-field">开始：{{item.start}}</view></picker><picker mode="date" value="{{item.end}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="end" bindchange="nodeInput"><view class="record-field">结束：{{item.end}}</view></picker></view></block></view>
   <block wx:if="{{view==='materials'}}"><button wx:if="{{!nodeId}}" class="eng-outline eng-submit" data-url="/pages/build/projects/index?destination=materials" bindtap="go">选择其他项目的材料计划</button>
    <view class="eng-section"><view class="eng-heading"><text>已有材料计划</text></view><button wx:for="{{plans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">材料计划 · {{item.due}}</text><text class="eng-muted">{{item.lines.length}}项材料 · {{item.arrival}} · {{item.payment}}</text></view></button><text wx:if="{{!plans.length}}" class="eng-muted">暂无材料计划</text></view>
    <view wx:if="{{own&&!p.delivery&&(!nodeId||node.status!=='已完成')}}" class="eng-section"><view class="eng-heading"><text>提交材料计划</text></view><picker range="{{p.plan.nodes}}" range-key="name" value="{{nodeIndex}}" disabled="{{!!nodeId}}" bindchange="pickNode"><view class="record-field">使用节点：{{p.plan.nodes[nodeIndex].name}}</view></picker><view wx:for="{{form.lines}}" wx:key="index" class="record-node"><input placeholder="材料名称" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="lineInput"/><input placeholder="规格（选填）" value="{{item.spec}}" data-index="{{index}}" data-key="spec" bindinput="lineInput"/><view class="record-grid"><input type="digit" placeholder="需用数量" value="{{item.quantity}}" data-index="{{index}}" data-key="quantity" bindinput="lineInput"/><input placeholder="单位" value="{{item.unit}}" data-index="{{index}}" data-key="unit" bindinput="lineInput"/></view></view><button class="eng-outline record-add-line" bindtap="addLine">添加一种材料</button></view>
   </block>
   <block wx:if="{{view==='material'&&plan}}">
    <view class="eng-section"><view class="eng-heading"><text>到货与付款</text></view><text class="eng-muted">本计划施工节点：{{node.name}}</text><text class="eng-name">{{plan.arrival}} · {{plan.payment}}</text><text class="eng-muted">应付 {{plan.totalText}} · 已付 {{plan.paidText}} · 待付 {{plan.remainingText}}</text><view wx:for="{{plan.lines}}" wx:key="id" class="eng-row"><view class="eng-grow"><text class="eng-name">{{item.name}} {{item.spec}}</text><text class="eng-muted">需用 {{item.quantity}}{{item.unit}} · 合格实收 {{item.received}}{{item.unit}} · 未到 {{item.remaining}}{{item.unit}}</text><text class="eng-muted">{{item.supplier}} · {{item.paymentStatus}}</text></view><button wx:if="{{(canPay||item.canSupplement)&&item.payUrl}}" class="eng-outline" data-url="{{item.payUrl}}" bindtap="go">{{item.canSupplement?'补充原事项':'办理付款'}}</button></view></view>
    <view wx:if="{{own&&!p.delivery&&plan.arrival!=='已验收齐全'&&plan.arrival!=='已取消'}}" class="eng-section"><view class="eng-heading"><text>确认本次到货</text></view><view wx:for="{{form.lines}}" wx:key="id" wx:if="{{!item.cancelled}}" class="record-field"><text>{{item.name}}</text><input type="digit" placeholder="本次实际合格到货数量，无到货留空" value="{{item.actual}}" data-index="{{index}}" data-key="actual" bindinput="lineInput"/></view></view>
    <view wx:if="{{canAdjust}}" class="eng-section material-adjust"><view class="eng-heading"><text>调整需用数量</text></view><text class="eng-muted">多报或不再需要时按实际修改，填 0 为取消；不能少于已到货数量，已有付款的材料由财务处理。</text><view wx:for="{{form.lines}}" wx:key="id" class="record-field"><text>{{item.name}} · 需用 {{item.quantity}}{{item.unit}} · 已到 {{item.received}}{{item.unit}}</text><text wx:if="{{item.locked}}" class="eng-muted">已有付款，不能由工程调整</text><input wx:else type="digit" placeholder="调整后的需用数量，不改留空" value="{{item.adjust}}" data-index="{{index}}" data-key="adjust" bindinput="lineInput"/></view><view class="record-field"><text>调整原因</text><input value="{{form.adjustReason}}" data-key="adjustReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="material-adjust" bindtap="perform" disabled="{{busy}}">保存数量调整</button></view><view wx:if="{{materialFollowups.length}}" class="eng-section"><view class="eng-heading"><text>催到货记录</text></view><view wx:for="{{materialFollowups}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.promiseDate?'供应商承诺 '+item.promiseDate+' 到货':'已催办，暂无承诺日期'}}</text><text wx:if="{{item.note}}" class="eng-muted">{{item.note}}</text></view></view><view wx:if="{{arrivals.length}}" class="eng-section"><view class="eng-heading"><text>到货记录</text></view><view wx:for="{{arrivals}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.materialName}} · 合格实收 {{item.actual}}{{item.unit}}</text><text class="eng-muted">{{item.note}}</text><text wx:if="{{item.corrections.length}}" class="eng-muted">已更正，原记 {{item.corrections[0].from}}{{item.unit}}</text><button class="eng-link" data-file="{{item.file}}" bindtap="preview">查看到货凭据</button><button wx:if="{{item.canCorrect}}" class="eng-link" data-id="{{item.id}}" bindtap="pickArrival">更正数量</button></view></view><view wx:if="{{view==='material'&&form.correctId}}" class="eng-section"><view class="eng-heading"><text>更正到货数量</text><button class="eng-link" bindtap="cancelCorrection">取消</button></view><view class="record-field"><text>更正后的实到数量</text><input type="digit" value="{{form.correctActual}}" data-key="correctActual" bindinput="input"/></view><view class="record-field"><text>更正原因</text><input value="{{form.correctReason}}" data-key="correctReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="arrival-correct" bindtap="perform" disabled="{{busy}}">保存更正</button></view>
    <view wx:if="{{canTerms}}" class="eng-section"><view class="eng-heading"><text>采购金额（财务记录）</text></view><text class="eng-muted">采购金额由财务或老板记录，工程人员只需提交材料计划并确认到货；付款沿原财务事项办理</text><view wx:for="{{form.lines}}" wx:key="id" wx:if="{{!item.cancelled}}" class="record-node"><text class="eng-name">{{item.name}}</text><text class="eng-muted">实际供应方</text><input placeholder="实际供应方" value="{{item.supplier}}" data-index="{{index}}" data-key="supplier" bindinput="lineInput"/><text class="eng-muted">实际单价（元）</text><input type="digit" placeholder="实际单价（元）" value="{{item.unitPrice}}" data-index="{{index}}" data-key="unitPrice" bindinput="lineInput"/><text class="eng-muted">本项运费（元，无运费填0）</text><input type="digit" placeholder="本项运费（元，无运费填0）" value="{{item.freight}}" data-index="{{index}}" data-key="freight" bindinput="lineInput"/></view><button class="eng-outline" data-key="termsFile" bindtap="upload">{{fileNames.termsFile||'上传实际采购凭据'}}</button><button wx:if="{{demo}}" class="eng-outline" data-sample-key="termsFile" bindtap="useSampleFile">使用本项目参考凭据</button><button wx:if="{{form.termsFile}}" class="eng-link" data-file="{{form.termsFile}}" bindtap="preview">预览采购凭据</button><button class="eng-outline eng-submit" data-action="material-terms" bindtap="perform" disabled="{{busy}}">保存付款信息，交财务办理</button></view>
   </block>
   <view wx:if="{{view==='funding'&&node}}" class="eng-section"><text class="eng-name">{{node.name}} · {{node.status}}</text><text class="eng-muted">计划 {{node.start}} 至 {{node.end}}</text><text class="eng-muted">施工、验收、材料和资金均关联本节点</text><button wx:if="{{view==='funding'}}" class="eng-link" data-url="{{nodeRecordUrl}}" bindtap="go">返回本节点记录</button></view>
   <view wx:if="{{view==='node'}}" class="eng-section"><view class="eng-heading"><text>本节点材料计划</text><button class="eng-link" data-url="{{nodeMaterialUrl}}" bindtap="go">{{node.status==='已完成'?'查看计划':'提交或查看'}}</button></view><button wx:for="{{nodePlans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>{{item.lines.length}}项材料 · {{item.due}}</text><text class="eng-muted">{{item.arrival}} · {{item.payment}}</text></view><text>查看</text></button><text wx:if="{{!nodePlans.length}}" class="eng-muted">本节点尚无材料计划；无需新增材料时，核对现场材料后继续记录。</text></view>
   <view wx:if="{{(view==='node'||view==='funding')&&nodeMoney}}" class="eng-section"><view class="eng-heading"><text>本节点资金计划</text><button wx:if="{{view==='node'}}" class="eng-link" data-url="{{nodeFundingUrl}}" bindtap="go">查看或记录</button></view><text class="eng-name">预计用款 {{nodeMoney.plannedText}}</text><text class="eng-muted">已记录材料及费用 {{nodeMoney.committedText}}</text><text class="eng-muted">实际已付 {{nodeMoney.paidText}} · 尚待付款 {{nodeMoney.remainingText}}</text><text wx:if="{{!nodeMoney.known}}" class="eng-muted">部分材料采购金额待记录，汇总金额尚未完整。</text><text wx:if="{{nodeMoney.funding}}" class="eng-muted">计划用款 {{nodeMoney.funding.due}} · {{nodeMoney.funding.note}}</text><text class="eng-muted">资金计划用于安排用款，实际付款沿原材料或费用事项办理。</text><block wx:if="{{view==='funding'}}"><button wx:for="{{nodePlans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>材料计划 · {{item.due}}</text><text class="eng-muted">{{item.payment}} · 应付 {{item.totalText}}</text></view><text>查看</text></button><view wx:for="{{nodeMoney.expenses}}" wx:key="id" class="record-field"><text>{{item.name}} · {{item.amountText}}</text><text class="eng-muted">{{item.status==='approved'?'已批准':item.status==='pending'?'待确认':'原事项待补充'}}</text></view><button class="eng-outline eng-submit" data-url="/pages/build/record/index?id={{p.id}}&view=expenses" bindtap="go">本节点人工及其他费用</button></block></view>
   <view wx:if="{{view==='node'}}" class="eng-section node-inspection"><view class="eng-heading"><text>本节点验收记录</text></view><view wx:for="{{inspections}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.result}} · {{item.person}}</text><button class="eng-link" data-file="{{item.file}}" bindtap="preview">查看验收凭据</button></view><text wx:if="{{!inspections.length}}" class="eng-muted">现场核对后，在本节点记录验收结果并确认完成。</text></view><view wx:if="{{view==='node'&&canCorrectNode}}" class="eng-section node-correct"><view class="eng-heading"><text>更正本节点完成记录</text></view><view class="record-field"><text>实际完成日期</text><picker mode="date" value="{{form.nodeDate}}" data-key="nodeDate" bindchange="input"><view>{{form.nodeDate}}</view></picker></view><view class="record-field"><text>施工情况与验收记录</text><textarea value="{{form.nodeNote}}" data-key="nodeNote" bindinput="input" auto-height="{{true}}"/></view><view class="record-field"><text>现场及验收凭据</text><button class="eng-outline" data-key="nodeFile" bindtap="upload">{{fileNames.nodeFile||'选择凭据'}}</button><button wx:if="{{demo}}" class="eng-outline" data-sample-key="nodeFile" bindtap="useSampleFile">使用本项目参考凭据</button><button wx:if="{{form.nodeFile}}" class="eng-link" data-file="{{form.nodeFile}}" bindtap="preview">预览验收凭据</button></view><view class="record-field"><text>更正或撤回原因</text><input value="{{form.nodeReason}}" data-key="nodeReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="node-correct" bindtap="perform" disabled="{{busy}}">保存更正</button><button wx:if="{{canReopen}}" class="eng-outline eng-submit" data-action="node-reopen" bindtap="perform" disabled="{{busy}}">撤回本节点完成</button><text wx:else class="eng-muted">只有最近完成、且下一节点还没开始记录的节点可以撤回。</text></view>

   <view wx:if="{{view==='node'&&siteRecords.length}}" class="eng-section node-site-records"><view class="eng-heading"><text>本节点现场记录</text></view><view wx:for="{{siteRecords}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.note}}</text><view wx:if="{{item.images.length}}" class="record-photos"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="path" class="record-photo" src="{{photo.path}}" mode="aspectFill" data-file="{{photo}}" bindtap="preview"/></view><button wx:if="{{item.file&&!item.images.length}}" class="eng-link" data-file="{{item.file}}" bindtap="preview">查看现场凭据</button><block wx:if="{{!item.file&&!item.images.length&&item.files.length}}"><button wx:for="{{item.files}}" wx:for-item="asset" wx:key="assetId" class="eng-link" data-asset-id="{{asset.assetId}}" catchtap="previewAsset">查看凭据{{index+1>1?'（'+(index+1)+'）':''}}</button></block><button wx:if="{{item.canCorrect}}" class="eng-link" data-id="{{item.id}}" bindtap="pickSite">更正</button></view></view><view wx:if="{{view==='node'&&form.siteId}}" class="eng-section"><view class="eng-heading"><text>更正现场记录</text><button class="eng-link" bindtap="cancelCorrection">取消</button></view><view class="record-field"><text>现场情况</text><textarea value="{{form.siteNote}}" data-key="siteNote" bindinput="input" auto-height="{{true}}"/></view><view class="record-field"><text>现场凭据（不换可不选）</text><button class="eng-outline" data-key="siteFile" bindtap="upload">{{fileNames.siteFile||'选择凭据'}}</button><button wx:if="{{demo}}" class="eng-outline" data-sample-key="siteFile" bindtap="useSampleFile">使用本项目参考凭据</button><button wx:if="{{form.siteFile}}" class="eng-link" data-file="{{form.siteFile}}" bindtap="preview">预览现场凭据</button></view><view class="record-field"><text>更正原因</text><input value="{{form.siteReason}}" data-key="siteReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="site-correct" bindtap="perform" disabled="{{busy}}">保存更正</button></view><view wx:if="{{view==='delivery'&&p.delivery}}" class="eng-section"><view class="eng-heading"><text>交付与签收</text></view><text class="eng-muted">{{p.delivery.date}} · 业主签收：{{p.delivery.recipient}}</text><button wx:if="{{p.delivery.fileAssetId}}" class="eng-link" data-asset-id="{{p.delivery.fileAssetId}}" catchtap="previewAsset">查看交付凭据</button><button wx:if="{{p.delivery.ownerAssetId&&p.delivery.ownerAssetId!==p.delivery.fileAssetId}}" class="eng-link" data-asset-id="{{p.delivery.ownerAssetId}}" catchtap="previewAsset">查看业主签收凭据</button></view>
   <view wx:if="{{view==='node'&&siteRecords.length}}" class="eng-section node-site-records"><view class="eng-heading"><text>本节点现场记录</text></view><view wx:for="{{siteRecords}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.note}}</text><view wx:if="{{item.images.length}}" class="record-photos"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="path" class="record-photo" src="{{photo.path}}" mode="aspectFill" data-file="{{photo}}" bindtap="preview"/></view><button wx:if="{{item.file&&!item.images.length}}" class="eng-link" data-file="{{item.file}}" bindtap="preview">查看现场凭据</button><block wx:if="{{!item.file&&!item.images.length&&item.files.length}}"><button wx:for="{{item.files}}" wx:for-item="asset" wx:key="assetId" class="eng-link" data-asset-id="{{asset.assetId}}" catchtap="previewAsset">查看凭据{{index+1>1?'（'+(index+1)+'）':''}}</button></block><button wx:if="{{item.canCorrect}}" class="eng-link" data-id="{{item.id}}" bindtap="pickSite">更正</button></view></view><view wx:if="{{view==='node'&&form.siteId}}" class="eng-section"><view class="eng-heading"><text>更正现场记录</text><button class="eng-link" bindtap="cancelCorrection">取消</button></view><view class="record-field"><text>现场情况</text><textarea value="{{form.siteNote}}" data-key="siteNote" bindinput="input" auto-height="{{true}}"/></view><view class="record-field"><text>现场凭据（不换可不选）</text><button class="eng-outline" data-key="siteFile" bindtap="upload">{{fileNames.siteFile||'选择凭据'}}</button><button wx:if="{{demo}}" class="eng-outline" data-sample-key="siteFile" bindtap="useSampleFile">使用本项目参考凭据</button><button wx:if="{{form.siteFile}}" class="eng-link" data-file="{{form.siteFile}}" bindtap="preview">预览现场凭据</button></view><view class="record-field"><text>更正原因</text><input value="{{form.siteReason}}" data-key="siteReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="site-correct" bindtap="perform" disabled="{{busy}}">保存更正</button></view><view wx:if="{{view==='documents'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>项目资料</text></view><button wx:for="{{docs}}" wx:key="name" class="eng-row" data-kind="{{item.file.previewKind}}" data-file="{{item.file}}" bindtap="preview"><view class="eng-grow"><text>{{item.name}}</text><text class="eng-muted">{{item.file.name}}</text></view><text>查看</text></button></view>
   <view wx:if="{{view==='settlement'}}" class="eng-section"><view class="eng-heading"><text>结算汇总</text></view><text class="eng-name">{{p.settlement?'已于 '+p.settlement.date+' 确认结算':'待确认'}}</text><text wx:if="{{p.settlement}}" class="eng-muted">{{p.settlement.note}}</text><text class="eng-muted">材料应付 {{settle.materialsTotalText}} · 已付 {{settle.materialsPaidText}} · 待付 {{settle.materialsRemainingText}}</text><text class="eng-muted">项目费用 {{settle.expensesTotalText}} · 已付 {{settle.expensesPaidText}} · 待付 {{settle.expensesRemainingText}}</text><text class="eng-muted">工程收款期次见上方汇总；确认结算后即可归档项目资料。</text><button wx:if="{{p.settlement}}" class="eng-link" data-url="{{links[4].url}}" bindtap="go">前往归档</button></view>
   <view wx:if="{{view==='archive'}}" class="eng-section"><text class="eng-name">{{p.archived?'项目资料已归档':p.settlement?'已结算，待归档':p.delivery?'已交付，请先确认项目结算':'请先记录工程交付'}}</text><text wx:if="{{p.delivery}}" class="eng-muted">{{p.delivery.date}} · 业主签收：{{p.delivery.recipient}}</text><button wx:if="{{p.delivery&&!p.settlement}}" class="eng-link" data-url="{{settlementUrl}}" bindtap="go">前往项目结算</button></view>
   <view wx:if="{{view==='payments'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>费用与财务收尾</text></view><button class="eng-row" data-url="/pages/build/record/index?id={{p.id}}&view=expenses" bindtap="go">人工、运输及其他项目费用</button><button class="eng-row" data-view="payables" bindtap="operating">材料及费用付款记录</button><button class="eng-row" data-view="costs" bindtap="operating">项目成本</button><text class="eng-muted">项目财务结清线下办理；本页保留原项目收付款与成本记录供核对。</text></view>
   <view wx:if="{{view==='expenses'}}" class="eng-section"><view class="eng-heading"><text>项目费用清单</text><button wx:if="{{expenseMode!=='register'}}" class="eng-link" data-mode="register" bindtap="expenseMode">返回登记</button></view><view wx:for="{{expenseRows}}" wx:key="id" class="record-field"><view class="eng-grow"><text>{{item.name}} · {{item.purposeText}} · {{item.amountText}}元</text><text class="eng-muted">{{item.statusText}}</text></view><view wx:if="{{item.canTerms}}"><button class="eng-link" data-mode="terms" data-id="{{item.id}}" bindtap="expenseMode">挂应付</button><button class="eng-link" data-mode="revise" data-id="{{item.id}}" bindtap="expenseMode">修订</button><button class="eng-link" data-mode="cancel" data-id="{{item.id}}" bindtap="expenseMode">取消</button></view><view wx:elif="{{item.canRevise}}"><button class="eng-link" data-mode="revise" data-id="{{item.id}}" bindtap="expenseMode">修订</button></view></view><text wx:if="{{!expenseRows.length}}" class="eng-muted">尚无直接项目费用；劳务、运输等费用在此登记（确认即计成本）。</text><text wx:if="{{expenseMode!=='register'&&expenseTarget}}" class="eng-name">当前操作：{{expenseTarget}}</text></view>
   <template wx:if="{{fields.length&&(own||(view==='collection'&&actions.length))&&view!=='prepare'&&view!=='node'}}" is="record-fields" data="{{fields:fields,form:form,fileNames:fileNames,demo:demo,purposes:purposes,purposeLabel:purposeLabel}}"/>

   <view wx:if="{{view==='overview'||view==='project'||view==='archive'||view==='settlement'}}" class="eng-section"><view class="eng-heading"><text>项目记录</text></view><view wx:for="{{events}}" wx:key="id" class="record-field"><text>{{item.title}}</text><text class="eng-muted">{{item.time}} · {{item.by}}</text></view></view>
  </block>
  <view wx:if="{{samplePreview.previewKind}}" class="record-document-mask"><view class="record-document-panel"><view class="eng-heading"><text>{{samplePreview.name}}</text><button class="eng-link" bindtap="closeSamplePreview">关闭</button></view><scroll-view scroll-y class="record-document-scroll"><view class="record-document-paper"><text class="record-document-title">{{samplePreview.name}}</text><text class="eng-muted">众墅之家 · {{samplePreview.meta.version}}</text><view class="record-document-summary"><text>{{samplePreview.previewCustomer}} · {{samplePreview.previewArea}}㎡</text><text>版本 {{samplePreview.meta.version}}</text></view><image wx:if="{{samplePreview.previewImage}}" src="{{samplePreview.previewImage}}" bindtap="zoomSampleImage" mode="aspectFit"/><view wx:if="{{samplePreview.previewKind==='review'}}" class="record-document-review">✓<text>本版专业审核已完成</text></view><view wx:if="{{samplePreview.previewKind==='confirmation'}}" class="record-document-confirmation"><text>确认采用本版设计成果及施工图</text><text>{{samplePreview.meta.confirmationParty}}</text></view><text class="eng-muted">{{samplePreview.projectName}}</text><text class="record-document-version">体验资料 · {{samplePreview.projectId}}</text></view></scroll-view></view></view>
  <view wx:if="{{samplePreview&&!samplePreview.previewKind}}" class="eng-section"><view class="eng-heading"><text>{{samplePreview.name}}</text></view><text class="eng-muted">体验模拟资料</text><text class="eng-name">{{samplePreview.text}}</text><button class="eng-outline" bindtap="closeSamplePreview">关闭预览</button></view>
  <view wx:if="{{actions.length}}" class="page-actions record-actions"><button wx:for="{{actions}}" wx:key="action" class="{{index===0?'eng-primary':'eng-outline'}} primary-action" data-action="{{item.action}}" bindtap="perform" loading="{{busy}}" disabled="{{busy}}">{{item.label}}</button></view>
 </view>
</view>
