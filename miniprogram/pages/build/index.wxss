/* Engineering typography: static Noto Sans SC faces keep glyphs and weight consistent. */
.build{font-family:'ZSEngineeringRegular','Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-weight:400;font-size:26rpx;line-height:1.5}
.build button,.build input,.build picker{font-family:inherit;font-weight:inherit;letter-spacing:0}
.build .heading,.build .name,.build .row-name,.build .strong,.build .num,.build .money,.build .sheet-title{font-family:'ZSEngineeringBold','Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-weight:400}
.build .heading{font-size:34rpx;line-height:48rpx;letter-spacing:0}
.build .name{font-size:34rpx;line-height:48rpx}
.build .row-name{font-size:29rpx;line-height:43rpx}
.build .muted,.build .meta{font-size:25rpx;line-height:38rpx;font-weight:400}
.build .badge,.build .link,.build .row-button,.build .btn{font-family:'ZSEngineeringMedium','Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-weight:400}
.build .label,.build .value,.build .control{font-family:'ZSEngineeringRegular','Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-size:26rpx;line-height:39rpx}
.build .caption{font-size:22rpx;line-height:32rpx;font-family:'ZSEngineeringRegular','Noto Sans SC',sans-serif}
.build .notice{font-size:23rpx;line-height:35rpx}
.build .footer .btn{font-size:30rpx;line-height:42rpx}
.build .banner-info .name,.build .project-content .name{font-size:32rpx;line-height:46rpx}
.build .project-banner.avatar .banner-info .name{font-size:34rpx}
.build .project-content .meta{font-size:24rpx;line-height:36rpx}
.build .project-content .badge{font-size:20rpx}
.build .node-list .name{font-size:32rpx}
.build .node-list .muted{font-size:24rpx;line-height:36rpx}
.build .check-item .row-name{font-size:28rpx;line-height:41rpx}
.build .check-item .muted{font-size:22rpx;line-height:33rpx}
.build .file-row .row-name{font-size:27rpx;line-height:40rpx}
.build .file-row .muted{font-size:22rpx;line-height:32rpx}
.view-node .row-name{font-size:26rpx}
.build .sheet-title{font-size:34rpx;line-height:50rpx}
.build .material-sheet .label,.build .material-sheet .control{font-size:24rpx;line-height:36rpx}
.build .material-mode .selected{font-family:'ZSEngineeringMedium','Noto Sans SC',sans-serif}
.build .summary-sheet .row-name{font-size:30rpx;line-height:44rpx}
.build .summary-sheet .muted{font-size:25rpx;line-height:37rpx}
.view-rectify .field .label,.view-rectify .control{font-size:24rpx;line-height:36rpx}

/* Measured against normalized reference images; compact archive and boss use smaller rows. */
.build .heading{font-size:32rpx;line-height:46rpx}
.build .name{font-size:32rpx;line-height:46rpx}
.build .row-name{font-family:'ZSEngineeringMedium','Noto Sans SC',sans-serif;font-size:28rpx;line-height:42rpx}
.build .muted,.build .meta{font-size:24rpx;line-height:36rpx}
.build .label,.build .value,.build .control{font-size:25rpx;line-height:38rpx}
.view-archive .heading,.view-boss .heading{font-size:30rpx;line-height:44rpx}
.view-archive .section .row-name,.view-boss .section .row-name{font-size:24rpx;line-height:35rpx}
.view-archive .section .muted,.view-boss .section .muted{font-size:20rpx;line-height:30rpx}
.view-archive .section .row{min-height:86rpx;padding:10rpx 0;gap:18rpx}
.view-archive .section>.row .row-icon{height:70rpx;width:70rpx}
.view-archive .block-text{font-size:23rpx;line-height:34rpx;padding:10rpx 0}
.view-archive .project-banner{padding:16rpx}.view-archive .banner-photo{width:235rpx;height:230rpx}
.view-archive .section{padding:18rpx 20rpx;margin-bottom:15rpx}.view-archive .heading{margin-bottom:12rpx}
.view-archive .section .notice{font-size:20rpx;line-height:29rpx;padding:9rpx 15rpx}
.view-archive .section-2{padding:10rpx 20rpx;background:#fff8ef}
.view-archive .section-2 .row-name{color:var(--copper);font-size:26rpx}
.view-archive .section-2 .row-button{font-size:23rpx;padding:9rpx 16rpx}
.view-archive .good-text image{height:42rpx;width:42rpx;background:#f0faee;border-radius:50%;padding:7rpx}
.view-archive .good-text{gap:16rpx}

.view-boss .card{padding:18rpx 22rpx;border:0;margin-bottom:16rpx}
.view-boss .boss-manager{justify-content:space-between;height:68rpx;font-size:24rpx;color:#191919}.boss-manager>text:last-child{font-size:20rpx;color:var(--muted)}
.view-boss .boss-stats{display:flex;gap:0;padding:20rpx 12rpx;margin-top:0}
.boss-stats>view{display:flex;align-items:center;gap:9rpx;flex:1;padding:0 9rpx;border-right:1rpx solid #ececec}.boss-stats>view:last-child{border:0}
.boss-stats image{width:70rpx;height:70rpx;flex-shrink:0}.boss-stats text{display:block;font-size:20rpx;color:var(--muted)}.boss-stats .num{font-size:39rpx;line-height:48rpx;color:var(--copper)}
.view-boss .heading{margin-bottom:12rpx}.view-boss .row{min-height:100rpx;padding:10rpx 0;gap:18rpx}.view-boss .row .row-icon{width:76rpx;height:76rpx}
.view-boss .boss-attention{align-items:flex-start;background:#fff9ef;border-radius:13rpx;padding:17rpx 12rpx}.boss-attention .row-button{margin-top:27rpx;font-size:22rpx;padding:10rpx 15rpx}
.view-boss .boss-attention .muted{font-size:20rpx;line-height:29rpx}.view-boss .boss-attention .row-name{font-size:25rpx}
.view-boss .boss-thumb{width:230rpx;height:236rpx}.view-boss .boss-projects .row-name{font-size:27rpx;line-height:42rpx}.view-boss .boss-projects .muted{font-size:22rpx;line-height:35rpx}.boss-open{min-height:48rpx;padding:4rpx 14rpx;font-size:22rpx;margin-top:9rpx;margin-left:auto}
.view-boss .boss-summary{background:#fff8eb;padding:12rpx 0;border-radius:12rpx}.view-boss .boss-summary .row-name{color:var(--copper);font-size:27rpx}.view-boss .boss-summary .row-button{font-size:22rpx;padding:10rpx 14rpx}.view-boss{padding-bottom:20rpx}

.sheet-footer{margin-top:auto;flex-shrink:0}.sheet-footer>.btn{height:88rpx;min-height:88rpx;padding:0 16rpx;display:flex;align-items:center;justify-content:center}

/* Entry links share one list-row pattern with the business pages: no stacked full-width outline buttons. */
.build-utilities{display:flex;justify-content:flex-end;padding:0 0 8rpx}
.build-utility{display:flex;align-items:center;gap:12rpx;min-height:88rpx;padding:0 8rpx;background:transparent;color:#89512a;font-size:26rpx;line-height:40rpx;border:0;margin:0}.build-utility::after,.build-link::after{border:0}
.build-links{padding:0 22rpx}
.build-link{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:96rpx;margin:0;padding:0 4rpx;background:transparent;border:0;border-top:1rpx solid #eee8df;border-radius:0;color:#141312;font-size:28rpx;line-height:42rpx;font-weight:400;text-align:left}
.build-link:first-child{border-top:0}
.build-link .chevron{flex-shrink:0;margin-right:8rpx}
