page{background:#f7f5f1;color:#26211c}.body{padding:24rpx}.card{background:white;padding:26rpx;border-radius:24rpx}.heading,.title,text{display:block}.heading{font-size:36rpx;font-weight:700}.title{font-size:30rpx;font-weight:650;margin:20rpx 0 10rpx}text{font-size:26rpx;line-height:1.55}.row{background:#fff;border-bottom:1rpx solid #e4ded8;text-align:left}button{color:#885027;background:#f8f2eb;font-size:27rpx;margin:16rpx 0 0}button::after{border:0}input,textarea{width:100%;box-sizing:border-box;background:#faf8f5;padding:16rpx;font-size:28rpx;margin:12rpx 0;height:auto}textarea{min-height:150rpx}.error{color:#a23718}
