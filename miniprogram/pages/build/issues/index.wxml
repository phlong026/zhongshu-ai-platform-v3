<brand-header title="{{quality?'材料质检处置':'现场整改与复验'}}" back="{{true}}"/>
<view class="body"><view class="card"><text class="heading">{{projectName}}</text><text wx:if="{{loading}}">正在读取…</text>
  <view wx:if="{{selected}}"><text class="title">{{selected.title}}</text><text>{{selected.status}} · 单号 {{selected.id}}</text><text wx:if="{{selected.node}}">{{selected.node}}</text><text>{{selected.note}}</text></view>
  <block wx:elif="{{!loading&&!quality}}"><button class="row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.title}} · {{item.status}} ›</button><text wx:if="{{!rows.length}}">暂无现场整改单</text></block>
  <block wx:if="{{!loading&&editable&&(!selected||selected.state!=='CLOSED')}}"><text class="title">{{selected?'办理记录':'登记现场整改'}}</text><input wx:if="{{!selected}}" placeholder="整改事项" maxlength="160" value="{{title}}" data-field="title" bindinput="input"/><textarea placeholder="填写现场情况、处置或复验说明" maxlength="800" value="{{note}}" data-field="note" bindinput="input"/>
    <button wx:if="{{quality}}" bindtap="photo">{{photo?'已选择照片 · 更换':'选择质检凭据照片'}}</button><button wx:if="{{quality}}" data-action="resolve" bindtap="save" disabled="{{saving}}">确认更换后合格</button>
    <button wx:elif="{{!selected}}" data-action="create" bindtap="save" disabled="{{saving}}">登记整改</button><button wx:elif="{{selected.state==='OPEN'}}" data-action="submit" bindtap="save" disabled="{{saving}}">提交复验</button><block wx:else><button data-action="pass" bindtap="save" disabled="{{saving}}">复验通过并销项</button><button data-action="return" bindtap="save" disabled="{{saving}}">退回整改</button></block>
  </block><text class="error" wx:if="{{error}}">{{error}}</text><button wx:if="{{error&&!editable}}" bindtap="load">重新加载</button>
</view></view>
