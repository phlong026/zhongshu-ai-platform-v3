page{background:#faf8f4;color:#352f29}.evidence-page{min-height:100vh}.evidence-body{padding:24rpx 28rpx 180rpx}.evidence-card{padding:32rpx;margin-bottom:24rpx;background:#fff;border-radius:22rpx;border:1rpx solid #eee8e0}.evidence-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:32rpx;font-weight:600}.evidence-badge{padding:8rpx 16rpx;background:#f4ede3;border-radius:10rpx;font-size:23rpx;font-weight:400;color:#805632}.evidence-total{font-size:48rpx;font-weight:600;margin:28rpx 0 24rpx}.evidence-fact{display:flex;justify-content:space-between;gap:24rpx;font-size:24rpx;color:#82776c;margin-bottom:12rpx}.evidence-field{margin-top:30rpx}.evidence-label{display:block;font-size:27rpx;margin-bottom:14rpx}.evidence-input{box-sizing:border-box;width:100%;min-height:82rpx;padding:22rpx;border:1rpx solid #e7e1d8;border-radius:12rpx;background:#fff;font-size:27rpx;line-height:1.5}.evidence-picker{display:flex;align-items:center;justify-content:space-between}.evidence-textarea{min-height:150rpx}.evidence-value{font-size:30rpx;line-height:1.8}.evidence-file{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:22rpx;background:#faf7f2;border-radius:12rpx}.evidence-file>view{min-width:0;flex:1}.evidence-file-title{display:block;font-size:27rpx;word-break:break-all;margin-bottom:8rpx}.evidence-muted{font-size:24rpx;color:#91867b;line-height:1.7}.evidence-hint{display:block;margin-top:12rpx}.evidence-actions{display:flex;gap:18rpx;flex-wrap:wrap;margin-top:22rpx}.evidence-primary,.evidence-secondary,.evidence-link{margin:0;font-size:27rpx;border-radius:12rpx;line-height:1.5}.evidence-primary::after,.evidence-secondary::after,.evidence-link::after{border:0}.evidence-primary{padding:24rpx 28rpx;background:#774c2a;color:#fff;font-weight:500}.evidence-secondary{padding:18rpx 22rpx;background:#f6f1e9;color:#7a5434;border:1rpx solid #ded2c4}.evidence-link{padding:10rpx 0;background:transparent;color:#855b37;font-size:25rpx}.evidence-primary[disabled]{background:#d0bca8;color:#fff}.evidence-secondary[disabled],.evidence-link[disabled]{opacity:.48}.evidence-error{padding:24rpx;margin-bottom:22rpx;color:#9c4c32;background:#fff2eb;border:1rpx solid #f0dbcf;border-radius:14rpx;font-size:26rpx;line-height:1.65}.evidence-error .evidence-link{text-align:left}.evidence-upload{margin-top:24rpx;padding:22rpx;background:#faf7f2;border-radius:12rpx;font-size:24rpx;color:#8a6a4d;line-height:1.8}.evidence-upload>text{display:block;word-break:break-all}.evidence-warning{display:block;color:#a56a35;font-size:25rpx;margin-top:26rpx;line-height:1.7}.evidence-footer{position:fixed;left:0;right:0;bottom:0;z-index:20;padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #eae3d9}.evidence-empty{padding:120rpx 36rpx;display:flex;align-items:center;flex-direction:column;gap:30rpx;text-align:center;color:#8c8175;font-size:28rpx;line-height:1.7}
