<view class="evidence-page">
  <business-header title="{{context.status==='WAIT_SIGN'?'合同签约':'合同凭证'}}"/>
  <view wx:if="{{!ready}}" class="evidence-empty"><text>{{loading?'正在加载合同…':error||'合同暂不可用'}}</text><view wx:if="{{!loading}}" class="evidence-actions"><button class="evidence-secondary" bindtap="load">重新加载</button><button class="evidence-secondary" bindtap="chooseIdentity">登录／切换身份</button></view></view>
  <view wx:else class="evidence-body">
    <view class="evidence-card"><view class="evidence-heading"><text>{{context.customerName||'客户合同'}}</text><text class="evidence-badge">{{context.statusLabel}}</text></view><view class="evidence-total">¥ {{context.totalText}}</view><view class="evidence-fact"><text>合同编号</text><text>{{context.contractId}}</text></view><button class="evidence-link" bindtap="openPlan" disabled="{{busy||uploading}}">查看付款计划 ›</button></view>
    <view wx:if="{{error}}" class="evidence-error"><text>{{error}}</text><button wx:if="{{uncertain}}" class="evidence-link" bindtap="runPending" loading="{{busy}}" disabled="{{busy}}">原请求重试核对</button><button wx:elif="{{!busy&&!uploading&&!uploadFailed}}" class="evidence-link" bindtap="reloadLatest">载入最新合同</button></view>
    <view wx:if="{{conflict}}" class="evidence-error"><text>合同已有更新，请载入最新版本后办理。</text><button class="evidence-link" bindtap="reloadLatest">载入最新合同</button></view>
    <view class="evidence-card"><view class="evidence-heading"><text>签约资料</text><text wx:if="{{!context.canWrite}}" class="evidence-muted">只读</text></view>
      <view class="evidence-field"><text class="evidence-label">实际签约日期</text><picker wx:if="{{editing}}" mode="date" end="{{today}}" value="{{form.signedDate}}" data-key="signedDate" bindchange="input" disabled="{{busy||uploading||uncertain||conflict}}"><view class="evidence-input evidence-picker"><text>{{form.signedDate||'选择实际签约日期'}}</text><text>⌄</text></view></picker><text wx:else class="evidence-value">{{context.signedDate||'待补录'}}</text></view>
      <view class="evidence-field"><text class="evidence-label">已签合同文件</text><view wx:if="{{form.assetId}}" class="evidence-file"><view><text class="evidence-file-title">{{form.fileName||'当前合同文件'}}</text><text class="evidence-muted">{{dirty&&form.assetId!==context.assetId?'已上传，待保存':'合同已关联文件'}}</text></view><button class="evidence-link" bindtap="previewFile">查看</button></view><text wx:else class="evidence-muted">待上传已签合同扫描件或照片</text>
        <view wx:if="{{editing}}" class="evidence-actions"><button class="evidence-secondary" bindtap="chooseFile" disabled="{{busy||uploading||uncertain||conflict}}">{{form.assetId?'更换合同文件':'选择合同文件'}}</button><button class="evidence-secondary" bindtap="choosePhoto" disabled="{{busy||uploading||uncertain||conflict}}">拍照／相册</button></view><text wx:if="{{editing}}" class="evidence-muted evidence-hint">PDF、JPG 或 PNG，单个文件不超过20MB。</text>
      </view>
      <view wx:if="{{uploading||uploadFailed}}" class="evidence-upload"><text>{{uploadName}}</text><text>{{uploading?'正在上传并验收…':'上传未完成'}}</text><view wx:if="{{uploadFailed}}" class="evidence-actions"><button wx:if="{{uploadRetryable}}" class="evidence-link" bindtap="retryUpload">重试核对</button><button wx:if="{{uploadRestartAllowed}}" class="evidence-link" bindtap="restartUpload">重新上传</button><button class="evidence-link" bindtap="discardUpload">取消本次选择</button></view></view>
      <view wx:if="{{editing&&context.status==='SIGNED'}}" class="evidence-field"><text class="evidence-label">补录／更正原因</text><textarea class="evidence-input evidence-textarea" value="{{form.reason}}" data-key="reason" bindinput="input" maxlength="500" auto-height disabled="{{busy||uploading||uncertain||conflict}}" placeholder="填写本次补录或更正的原因"/></view>
      <text wx:if="{{context.status==='SIGNED'&&!context.hasEvidence&&!editing}}" class="evidence-warning">请补录实际签约日期及已签合同文件。</text>
    </view>
    <button wx:if="{{!editing&&context.canWrite}}" class="evidence-primary" bindtap="startEdit">补录／更正合同凭证</button>
  </view>
  <view wx:if="{{ready&&editing}}" class="evidence-footer"><button class="evidence-primary" bindtap="submit" loading="{{busy}}" disabled="{{busy||uploading||uncertain||conflict||uploadFailed}}">{{context.status==='WAIT_SIGN'?'确认签约并登记':'保存合同凭证'}}</button></view>
</view>
