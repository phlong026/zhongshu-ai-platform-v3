<template name="ruleText"><view class="payroll-rule-field"><text>底薪约定</text><text>{{rule.baseSalaryNote}}</text></view><view class="payroll-rule-field"><text>考核要求</text><text>{{rule.assessmentNote}}</text></view><view class="payroll-rule-field"><text>提成约定</text><text>{{rule.commissionNote}}</text></view><view class="payroll-rule-field"><text>管理层确认依据</text><text>{{rule.evidenceNote}}</text></view></template>
<view class="accounting-page">
  <business-header title="薪酬核算"/>
  <view wx:if="{{!ready}}" class="accounting-empty"><text>{{loading?'正在读取本公司核算资料…':error||'薪酬核算暂不可用'}}</text><button wx:if="{{!loading}}" class="accounting-secondary" bindtap="load">重新加载</button><button wx:if="{{!loading}}" class="accounting-link" bindtap="login">登录／切换身份</button></view>
  <view wx:else class="accounting-body">
    <view class="payroll-toolbar"><view class="payroll-families"><button wx:for="{{families}}" wx:key="key" class="payroll-tab {{index===familyIndex?'selected':''}}" data-index="{{index}}" bindtap="changeFamily" disabled="{{busy||uncertain||loading}}">{{item.label}}</button></view><picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth" disabled="{{busy||uncertain||loading}}"><view class="payroll-month">{{month}}⌄</view></picker></view>
    <view wx:if="{{headquarters}}" class="payroll-notice"><text>总部只读 · {{companyName}}</text><text class="accounting-muted">查看该公司的业务与工程薪酬核算及规则版本</text></view>
    <view class="payroll-notice"><text>人工核算 · 不自动生成工资</text><text class="accounting-muted">核算记录用于对账，不代表真实发款。实际费用登记和付款继续由财务原流程办理。</text></view>
    <view wx:if="{{error}}" class="accounting-error"><text>{{error}}</text><button wx:if="{{uncertain}}" class="accounting-link" bindtap="retry" loading="{{busy}}" disabled="{{busy}}">用原请求重试</button><button wx:elif="{{!busy}}" class="accounting-link" bindtap="load">载入最新</button></view>
    <block wx:if="{{detail}}">
      <view class="accounting-heading"><button class="accounting-link" bindtap="closeDetail">‹ 返回核算记录</button><button wx:if="{{context.canWrite}}" class="accounting-link" bindtap="correct">更正核算</button></view>
      <view class="accounting-card"><view class="accounting-history-top"><text>{{detail.userName}} · V{{detail.version}}</text><text class="accounting-muted">{{detail.month}}</text></view><text class="accounting-caption">人工核算合计</text><view class="accounting-profit">¥ {{detail.totalText}}</view><view class="accounting-metrics"><view><text>底薪</text><text>¥ {{detail.baseText}}</text></view><view><text>提成</text><text>¥ {{detail.commissionText}}</text></view><view><text>其他调整</text><text>¥ {{detail.adjustmentText}}</text></view></view><text class="accounting-record-note">{{detail.note}}</text><text class="accounting-muted">{{detail.ruleLabel}} · {{detail.date}}</text></view>
      <view class="accounting-card"><text class="accounting-title">本月发放核对</text>
        <block wx:if="{{settlement}}"><view class="accounting-metrics"><view><text>当前应发</text><text>¥ {{settlement.dueText}}</text></view><view><text>实际已发</text><text>¥ {{settlement.paidText}}</text></view><view><text>未发</text><text>¥ {{settlement.unpaidText}}</text></view></view>
          <text class="accounting-muted">已核实公司付款 {{settlement.paymentCount}} 笔，合计 ¥{{settlement.grossText}}，支出退回 ¥{{settlement.refundedText}}。</text>
          <button wx:if="{{context.canWrite&&settlement.latestPaymentId}}" class="accounting-link" bindtap="openPaymentSource">查看最近一笔付款原单</button>
          <text wx:if="{{settlement.overpaidText!=='0.00'}}" class="accounting-error">超过当前应发 ¥{{settlement.overpaidText}}</text>
          <text class="accounting-muted">已发和未发仅按本员工本岗位当月已关联原单核对。未关联的历史付款请查财务原账。</text>
          <button wx:if="{{context.canWrite&&detail.id===settlement.currentRecordId}}" class="accounting-link" bindtap="openPayment">登记薪酬付款</button>
        </block><block wx:else><text class="accounting-muted">{{settlementError||'正在核对付款原单…'}}</text><button wx:if="{{settlementError}}" class="accounting-link" bindtap="loadSettlement">重新核对原单</button></block>
      </view>
      <view wx:if="{{detail.rule}}" class="accounting-card"><text class="accounting-title">本版本引用的规则 V{{detail.rule.version}}</text><template is="ruleText" data="{{rule:detail.rule}}"/></view>
      <view wx:for="{{detail.commissions}}" wx:key="key" class="accounting-card"><view class="accounting-history-top"><text>{{item.projectName}}</text><text>¥ {{item.amountText}}</text></view><text class="accounting-muted">{{item.stageName}}</text><text wx:if="{{item.netText}}" class="accounting-muted">核算时该节点净回款 ¥ {{item.netText}}</text><text class="accounting-record-note">{{item.basis}}</text></view>
      <view class="accounting-history-heading"><text class="accounting-title">该员工当月历史版本</text></view><button wx:for="{{versions}}" wx:key="id" class="accounting-card payroll-history-button" data-id="{{item.id}}" bindtap="viewVersion"><view class="accounting-history-top"><text>V{{item.version}} · ¥ {{item.totalText}}</text><text class="accounting-muted">{{item.date}}</text></view><text class="accounting-muted">{{item.ruleLabel}}</text><text class="accounting-record-note">{{item.note}}</text></button><text wx:if="{{versionsError}}" class="accounting-error">{{versionsError}}</text><button wx:if="{{versionsMore}}" class="accounting-link accounting-more" bindtap="moreVersions" loading="{{versionsLoading}}" disabled="{{versionsLoading||loading}}">{{versionsError?'重试读取历史':'加载更多版本'}}</button>
    </block>
    <block wx:else>
      <view wx:if="{{!headquarters}}" class="accounting-card payroll-rule-status"><view class="accounting-history-top"><text>{{activeRule.status==='UNCONFIGURED'?'薪酬规则待配置':'适用规则 V'+activeRule.effectiveRule.version}}</text><button wx:if="{{context.canWrite&&!form&&!ruleForm}}" class="accounting-link" bindtap="newRule">登记规则</button></view><text class="accounting-muted">{{activeRule.status==='UNCONFIGURED'?'管理层尚未提供当前月份的规则。只能登记逐项人工确认的金额。':'生效月份 '+activeRule.effectiveRule.effectiveMonth+'；金额仍需财务逐人核对。'}}</text></view>
      <view wx:if="{{ruleForm}}" class="accounting-card">
        <view class="accounting-history-top"><text>登记管理层确认的规则</text><button class="accounting-link" bindtap="closeForm" disabled="{{busy||uncertain}}">取消</button></view>
        <text class="payroll-label">生效月份</text><picker mode="date" fields="month" value="{{ruleForm.effectiveMonth}}" data-key="effectiveMonth" bindchange="input" disabled="{{busy||uncertain||conflict}}"><view class="payroll-picker">{{ruleForm.effectiveMonth}}</view></picker>
        <text class="payroll-label">底薪约定</text><textarea class="accounting-input" value="{{ruleForm.baseSalaryNote}}" data-key="baseSalaryNote" bindinput="input" maxlength="2000" auto-height disabled="{{busy||uncertain||conflict}}" placeholder="填写管理层提供的底薪标准及适用范围"/>
        <text class="payroll-label">绩效考核要求</text><textarea class="accounting-input" value="{{ruleForm.assessmentNote}}" data-key="assessmentNote" bindinput="input" maxlength="2000" auto-height disabled="{{busy||uncertain||conflict}}" placeholder="填写考核项目、周期及确认依据"/>
        <text class="payroll-label">提成约定</text><textarea class="accounting-input" value="{{ruleForm.commissionNote}}" data-key="commissionNote" bindinput="input" maxlength="2000" auto-height disabled="{{busy||uncertain||conflict}}" placeholder="填写提成口径、节点和适用条件，不自动执行公式"/>
        <text class="payroll-label">管理层确认依据</text><textarea class="accounting-input" value="{{ruleForm.evidenceNote}}" data-key="evidenceNote" bindinput="input" maxlength="1000" auto-height disabled="{{busy||uncertain||conflict}}" placeholder="填写确认日期、会议或文件编号和调整说明"/>
        <checkbox-group bindchange="check"><label class="accounting-check"><checkbox value="confirmed" checked="{{ruleForm.confirmed}}" disabled="{{busy||uncertain||conflict}}" color="#80512e"/><text>已核对，本规则由管理层提供并确认</text></label></checkbox-group><button class="accounting-primary" bindtap="submit" loading="{{busy}}" disabled="{{busy||uncertain||conflict}}">保存新规则版本</button>
      </view>
      <view wx:elif="{{form}}" class="accounting-card">
        <view class="accounting-history-top"><text>{{form.expectedVersion?'更正本月核算':'登记本月人工核算'}}</text><button class="accounting-link" bindtap="closeForm" disabled="{{busy||uncertain}}">取消</button></view>
        <text class="payroll-label">本公司员工</text><picker range="{{staff}}" range-key="name" bindchange="chooseStaff" disabled="{{busy||uncertain||conflict||formLoading}}"><view class="payroll-picker">{{form.userName||'选择当前岗位员工'}}⌄</view></picker><text wx:if="{{formLoading}}" class="accounting-muted">正在核对员工已有版本…</text><text wx:if="{{form.expectedVersion}}" class="accounting-muted">本月已有 V{{form.expectedVersion}}，本次保存更正版本，历史金额保留。</text>
        <view class="payroll-money-fields"><view><text class="payroll-label">底薪（元）</text><input class="payroll-picker" type="digit" value="{{form.base}}" data-key="base" bindinput="input" placeholder="逐人确认后填写" disabled="{{busy||uncertain||conflict||formLoading}}"/></view><view><text class="payroll-label">其他调整（元，可负）</text><input class="payroll-picker" type="text" value="{{form.adjustment}}" data-key="adjustment" bindinput="input" disabled="{{busy||uncertain||conflict||formLoading}}"/></view></view>
        <view class="accounting-history-heading"><text class="accounting-title">人工提成明细</text><button class="accounting-link" bindtap="addLine" disabled="{{busy||uncertain||conflict||formLoading||form.commissions.length>=30}}">＋ 添加</button></view>
        <view wx:for="{{form.commissions}}" wx:key="key" class="payroll-line"><view class="accounting-history-top"><text>提成 {{index+1}}</text><button class="accounting-link" data-key="{{item.key}}" bindtap="removeLine" disabled="{{busy||uncertain||conflict||formLoading}}">移除</button></view><picker range="{{context.projects}}" range-key="name" data-key="{{item.key}}" bindchange="chooseProject" disabled="{{busy||uncertain||conflict||formLoading}}"><view class="payroll-picker">{{item.projectName||'选择本公司工程'}}⌄</view></picker><picker wx:if="{{item.projectId}}" range="{{item.stages}}" range-key="label" data-key="{{item.key}}" bindchange="chooseStage" disabled="{{busy||uncertain||conflict||formLoading||item.stagesLoading}}"><view class="payroll-picker">{{item.stagesLoading?'读取付款节点…':item.stageName||'不关联付款节点'}}⌄</view></picker><text wx:if="{{item.netText}}" class="accounting-muted">该节点当前净回款 ¥ {{item.netText}}，作为人工核算依据</text><text wx:if="{{item.stageError}}" class="accounting-error">{{item.stageError}}</text><input class="payroll-picker" type="digit" value="{{item.amount}}" data-key="{{item.key}}" data-field="amount" bindinput="lineInput" placeholder="人工核定提成（元）" disabled="{{busy||uncertain||conflict||formLoading}}"/><textarea class="accounting-input" value="{{item.basis}}" data-key="{{item.key}}" data-field="basis" bindinput="lineInput" maxlength="1000" auto-height placeholder="填写本项提成核定依据" disabled="{{busy||uncertain||conflict||formLoading}}"/></view>
        <text class="payroll-label">{{form.expectedVersion?'更正原因与核对说明':'核对说明'}}</text><textarea class="accounting-input" value="{{form.note}}" data-key="note" bindinput="input" maxlength="1000" auto-height placeholder="填写人工核算依据、调整原因及需要跟进的事项" disabled="{{busy||uncertain||conflict||formLoading}}"/><checkbox-group bindchange="check"><label class="accounting-check"><checkbox value="confirmed" checked="{{form.confirmed}}" disabled="{{busy||uncertain||conflict||formLoading}}" color="#80512e"/><text>已逐项核对本月底薪、提成和调整金额</text></label></checkbox-group><view class="accounting-cash"><text>人工核算合计</text><text>¥ {{totalText}}</text></view><button class="accounting-primary" bindtap="submit" loading="{{busy}}" disabled="{{busy||uncertain||conflict||formLoading}}">保存核算版本</button>
      </view>
      <block wx:else>
        <view class="payroll-list-heading"><view class="payroll-families"><button class="payroll-tab {{kind==='records'?'selected':''}}" data-kind="records" bindtap="changeKind" disabled="{{busy||uncertain||loading}}">核算记录</button><button class="payroll-tab {{kind==='rules'?'selected':''}}" data-kind="rules" bindtap="changeKind" disabled="{{busy||uncertain||loading}}">规则版本</button></view><button wx:if="{{context.canWrite&&kind==='records'}}" class="accounting-link" bindtap="newRecord" disabled="{{busy||uncertain||loading}}">登记核算</button></view>
        <block wx:if="{{kind==='records'}}"><button wx:for="{{rows}}" wx:key="id" class="accounting-card payroll-history-button" data-id="{{item.id}}" bindtap="openRecord"><view class="accounting-history-top"><text>{{item.userName}} · V{{item.version}}</text><text>¥ {{item.totalText}}</text></view><text class="accounting-muted">底薪 ¥{{item.baseText}} · 提成 ¥{{item.commissionText}}</text><text class="accounting-muted">{{item.ruleLabel}} · {{item.date}}</text><text class="accounting-record-note">{{item.note}}</text></button></block>
        <block wx:else><view wx:for="{{rows}}" wx:key="id" class="accounting-card"><view class="accounting-history-top"><text>规则 V{{item.version}}</text><text class="accounting-muted">{{item.effectiveMonth}} 起生效</text></view><template is="ruleText" data="{{rule:item}}"/></view></block>
        <text wx:if="{{!rows.length&&!listBusy&&!listError}}" class="accounting-empty">{{kind==='records'?'本月暂无人工核算记录':'尚未登记规则版本'}}</text><text wx:if="{{listError}}" class="accounting-error">{{listError}}</text><button wx:if="{{hasMore}}" class="accounting-link accounting-more" bindtap="more" disabled="{{listBusy||loading}}" loading="{{listBusy}}">{{listError?'重试读取':'加载更多'}}</button>
      </block>
    </block>
  </view>
</view>
