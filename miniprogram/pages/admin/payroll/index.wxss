@import "../accounting/index.wxss";
.payroll-toolbar,.payroll-list-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:26rpx}.payroll-families{display:flex;gap:12rpx}.payroll-tab{padding:0 20rpx;margin:0;background:transparent;color:#857a6d;font-size:26rpx;line-height:2.5;border-radius:10rpx}.payroll-tab::after{border:none}.payroll-tab.selected{background:#e9dfd1;color:#785338;font-weight:600}.payroll-month{font-size:27rpx;color:#785338}.payroll-notice{font-size:27rpx;color:#785338;padding:4rpx 4rpx 28rpx;line-height:1.7}.payroll-notice>.accounting-muted{margin-top:8rpx}.payroll-rule-field{margin-top:22rpx;line-height:1.7;font-size:26rpx}.payroll-rule-field>text{display:block;white-space:pre-wrap}.payroll-rule-field>text:first-child{font-size:23rpx;color:#948779;margin-bottom:6rpx}.payroll-label{display:block;font-size:26rpx;color:#796e60;margin:25rpx 0 12rpx}.payroll-picker{box-sizing:border-box;display:block;background:#f8f6f2;border-radius:12rpx;font-size:26rpx;line-height:1.6;min-height:78rpx;padding:17rpx 20rpx;margin-bottom:14rpx;width:100%;color:#39332d}.payroll-money-fields{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.payroll-line{border:1rpx solid #e8e0d6;border-radius:14rpx;padding:22rpx;margin-bottom:20rpx;background:#fdfcfa}.payroll-line .accounting-input{min-height:110rpx}.payroll-history-button{display:block;text-align:left;width:100%;font-size:28rpx;line-height:1.7}.payroll-history-button::after{border:none}.payroll-rule-status>.accounting-history-top{margin-bottom:12rpx}.payroll-rule-status>.accounting-history-top>text{font-size:28rpx}.payroll-list-heading{margin-top:26rpx}
