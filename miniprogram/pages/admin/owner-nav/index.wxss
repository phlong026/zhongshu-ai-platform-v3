:host{display:block}.boss-nav{position:fixed;z-index:60;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1rpx solid #ebe5dc;padding:14rpx 0 calc(12rpx + env(safe-area-inset-bottom));font-family:sans-serif}.boss-nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:5rpx;padding:0;margin:0;background:transparent;color:#9a9187;font-size:24rpx;line-height:36rpx;font-weight:500;border-radius:0}.boss-nav-item::after{border:0}.boss-nav-item image{width:44rpx;height:44rpx}.boss-nav-item.active{color:#89512a}.boss-nav-item .muted{filter:grayscale(1);opacity:.55}
