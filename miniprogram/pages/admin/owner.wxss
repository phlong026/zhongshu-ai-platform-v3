/* Shared type and spacing system for all four boss pages and their overview pages. */
.owner-quick>.owner-arrow{width:16rpx!important;height:26rpx!important}
.owner-page{--boss-brown:#89512a;--boss-ink:#30291f;--boss-muted:#9a9187;background:#faf8f4;color:var(--boss-ink);font-family:"Noto Sans SC","Microsoft YaHei",sans-serif;font-size:28rpx;font-weight:400;line-height:42rpx;letter-spacing:0;min-height:100vh;padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}
.owner-page button,.owner-page input,.owner-page textarea,.owner-page picker{font-family:inherit;font-size:inherit;font-weight:inherit;line-height:inherit;letter-spacing:0}
.owner-page button{border-radius:0}.owner-page button::after{border:0}.owner-content{padding:20rpx 28rpx}.owner-card{background:#fff;border-radius:24rpx;padding:22rpx;margin-bottom:20rpx}.owner-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:18rpx;min-height:48rpx}.owner-heading>text:first-child{font-size:32rpx;line-height:46rpx;font-weight:700;border-left:6rpx solid var(--boss-brown);padding-left:16rpx}.owner-muted{display:block;color:var(--boss-muted);font-size:24rpx;line-height:36rpx;font-weight:400}.owner-name{display:block;font-size:28rpx;line-height:42rpx;font-weight:500;overflow-wrap:anywhere}.owner-title{font-size:36rpx;line-height:52rpx;font-weight:700}.owner-hello{display:flex;align-items:center;gap:16rpx;margin-bottom:8rpx;flex-wrap:wrap}.owner-date{margin-bottom:22rpx}.owner-badge{display:inline-flex;color:var(--boss-brown);background:#f8eee2;border-radius:9rpx;padding:2rpx 12rpx;font-size:22rpx;line-height:34rpx;font-weight:400;white-space:nowrap}.owner-count{background:var(--boss-brown);color:#fff;border-radius:40rpx;padding:0 12rpx;font-size:24rpx;line-height:36rpx}.owner-link{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;color:var(--boss-brown);font-size:24rpx!important;line-height:36rpx!important;min-height:60rpx;flex-shrink:0}.owner-arrow{width:16rpx;height:26rpx;flex-shrink:0}.owner-statistics{display:flex;align-items:stretch;padding:22rpx 0;border-radius:18rpx;background:#fcf8f2}.owner-stat{flex:1;min-width:0;text-align:center;border-right:1rpx solid #ebe5dc;padding:0 6rpx}.owner-stat:last-child{border-right:0}.owner-number{display:block;color:var(--boss-brown);font-size:46rpx;line-height:60rpx;font-weight:700;white-space:nowrap}.owner-unit{font-size:24rpx;line-height:36rpx;font-weight:400;margin-left:5rpx}.owner-stat .owner-muted{font-size:23rpx;line-height:36rpx;margin-bottom:8rpx}.owner-stat-label{display:block;font-size:24rpx;line-height:36rpx;color:var(--boss-muted)}.owner-tools{display:flex;align-items:stretch;gap:8rpx}.owner-tool{display:flex;flex:1;min-width:0;align-items:center;flex-direction:column;gap:14rpx;padding:10rpx 0;font-size:24rpx!important;line-height:36rpx!important;white-space:nowrap}.owner-tool-icon{display:flex;align-items:center;justify-content:center;width:90rpx;height:90rpx;border-radius:50%;background:#faf5ee}.owner-tool-icon image{width:54rpx;height:54rpx}.owner-row{width:100%;display:flex;align-items:center;gap:18rpx;padding:20rpx 0;text-align:left;border-bottom:1rpx solid #ebe5dc;min-height:90rpx}.owner-row:last-child{border-bottom:0;padding-bottom:0}.owner-row:first-child{padding-top:0}.owner-grow{flex:1;min-width:0}.owner-thumb{width:152rpx;height:132rpx;object-fit:cover;border-radius:14rpx;flex-shrink:0}.owner-amount{display:block;color:var(--boss-brown);font-size:34rpx;line-height:48rpx;font-weight:700}.owner-primary,.owner-outline{display:flex;align-items:center;justify-content:center;color:#fffaf3;background:var(--boss-brown);border:2rpx solid var(--boss-brown)!important;border-radius:14rpx!important;padding:12rpx 22rpx;min-height:74rpx;flex-shrink:0;font-size:26rpx!important;line-height:38rpx!important;font-weight:500!important}.owner-outline{color:var(--boss-brown);background:#fff}.owner-progress{width:100%;height:12rpx;border-radius:12rpx;overflow:hidden;background:#e9e9ee;margin-top:14rpx}.owner-progress>view{height:100%;background:var(--boss-brown);border-radius:12rpx}.owner-period{display:flex;justify-content:space-between;align-items:center;gap:14rpx;margin-bottom:20rpx}.owner-period picker{display:flex;align-items:center;min-height:64rpx;color:var(--boss-brown);font-size:26rpx;line-height:38rpx}.owner-period picker>view{display:flex;align-items:center;gap:12rpx}.owner-select-icon{width:22rpx;height:14rpx;transform:rotate(90deg)}.owner-tabs{display:flex;gap:8rpx;padding:6rpx;background:#f4eee5;border-radius:20rpx;margin-bottom:20rpx}.owner-tabs button{flex:1;border-radius:16rpx;min-height:72rpx;font-size:28rpx;line-height:42rpx;padding:14rpx 12rpx;color:#9a9187}.owner-tabs .selected{background:var(--boss-brown);color:#fff}.owner-search{display:flex;align-items:center;gap:16rpx;min-height:76rpx;border-radius:40rpx;padding:10rpx 20rpx;background:#fff;margin-bottom:20rpx;border:1rpx solid #ebe5dc}.owner-search>image{width:30rpx;height:30rpx}.owner-search input{flex:1;min-width:0;font-size:26rpx;line-height:38rpx;min-height:54rpx}.owner-search button{font-size:24rpx;color:var(--boss-brown);min-height:54rpx;min-width:64rpx}.owner-empty{text-align:center;padding:34rpx 16rpx;color:var(--boss-muted);font-size:26rpx;line-height:40rpx}.owner-note{font-size:24rpx;line-height:36rpx;color:var(--boss-muted);margin-top:16rpx}.owner-error{display:block;font-size:26rpx;line-height:40rpx;padding:18rpx 22rpx;background:#fff2e9;color:#b3402a;border-radius:16rpx;margin-bottom:20rpx}.owner-keyline{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.owner-keyline .owner-name{flex:1;min-width:0}.owner-figure{font-size:60rpx;line-height:78rpx;font-weight:700;color:var(--boss-brown)}.owner-denominator{font-size:32rpx;line-height:46rpx;font-weight:400;color:var(--boss-muted);margin-left:8rpx}.owner-target{border-radius:18rpx;background:#fcf8f2;padding:22rpx}.owner-target>.owner-name{margin:16rpx 0 8rpx}.owner-metric{padding:20rpx 0;border-top:1rpx solid #ebe5dc;margin-top:20rpx}.owner-metric:last-child{padding-bottom:0}.owner-percent{font-size:28rpx;line-height:42rpx;font-weight:700;color:var(--boss-brown)}.owner-person{display:flex;align-items:center;gap:20rpx;width:100%;text-align:left}.owner-avatar{width:132rpx;height:132rpx;border-radius:50%;flex-shrink:0}.owner-quick-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.owner-quick{display:flex;align-items:center;gap:16rpx;text-align:left;min-height:150rpx;padding:18rpx 10rpx;border-bottom:1rpx solid #ebe5dc}.owner-quick:nth-child(odd){border-right:1rpx solid #ebe5dc}.owner-quick:nth-last-child(-n+2){border-bottom:0}.owner-quick>image{width:54rpx;height:54rpx;flex-shrink:0}.owner-menu-icon{width:44rpx;height:44rpx;flex-shrink:0}.owner-initial{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;background:#f7eee1;border-radius:50%;color:var(--boss-brown);font-size:30rpx;line-height:44rpx;font-weight:500;flex-shrink:0}.owner-card>.owner-row .owner-muted{margin-top:5rpx}.owner-profile-notice{margin:20rpx 0}.owner-readonly-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:18rpx 0;border-bottom:1rpx solid #ebe5dc}.owner-readonly-row>text:last-child{text-align:right;max-width:66%;overflow-wrap:anywhere}.owner-readonly-row:last-child{border:0}.owner-form-row{display:flex;justify-content:space-between;align-items:center;gap:24rpx;min-height:96rpx;border-bottom:1rpx solid #ebe5dc}.owner-form-row:last-child{border:0}.owner-form-row input{flex:1;min-width:0;text-align:right;min-height:72rpx;font-size:28rpx;line-height:42rpx}.owner-save{width:100%;margin-top:24rpx}.owner-detail{padding-bottom:40rpx}.owner-summary-line{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap}.owner-finance-note{margin-top:20rpx}.owner-review-link{margin-top:14rpx}.owner-project-totals{color:#9a9187;font-size:24rpx;line-height:38rpx}.owner-project-totals>text{color:var(--boss-brown);font-weight:500}.owner-heading-meta{color:var(--boss-muted);font-size:24rpx;line-height:36rpx;font-weight:400}

