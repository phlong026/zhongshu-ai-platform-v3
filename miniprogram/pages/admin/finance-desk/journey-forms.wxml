<import src="./receipt-revision.wxml"/>
<import src="./workbench.wxml"/>
<view wx:if="{{wbForm&&(wbForm.type==='receipt'||wbForm.type==='expense'||wbForm.type==='payable')}}" class="fin-card journey-form">
 <view wx:if="{{wbForm.payrollRecordId}}" class="journey-source"><text class="journey-source-name">{{wbForm.counterparty}} · {{wbForm.payrollFamily}}</text><text>{{wbForm.name}} · 公司日常账</text><text>已关联实付 ¥{{wbForm.payrollPaid}} · 未发 ¥{{wbForm.payrollRemaining}}</text><text class="journey-note">填写本次实际付出的金额。历史付款已记账的，请核对财务原单。</text></view>
 <view wx:if="{{wbForm.type==='receipt'}}" class="journey-mode"><button class="{{wbForm.receiptMode!=='other'?'selected':''}}" data-mode="contract" bindtap="changeReceiptMode" disabled="{{wbBusy||paymentPending}}">合同回款</button><button class="{{wbForm.receiptMode==='other'?'selected':''}}" data-mode="other" bindtap="changeReceiptMode" disabled="{{wbBusy||paymentPending}}">其他收款</button></view>
 <view wx:if="{{!wbForm.payrollRecordId}}" id="jf-scope" class="journey-field"><text class="journey-label">{{wbForm.type==='receipt'&&wbForm.receiptMode!=='other'?'项目 / 客户':'记入账本'}}<text class="journey-required"> *</text></text><picker range="{{journeyScopes}}" range-key="name" data-field="scope" bindchange="journeyPick" disabled="{{wbBusy||paymentPending}}"><view class="journey-input {{journeyErrorField==='scope'?'invalid':''}} {{!wbForm.scope?'placeholder':''}}">{{wbForm.scopeLabel||'请选择'}}<image src="/assets/creation-chevron-muted.png"/></view></picker><text wx:if="{{journeyErrorField==='scope'}}" class="journey-error">{{wbError}}</text></view>
 <block wx:if="{{wbForm.type==='receipt'&&wbForm.receiptMode!=='other'}}">
  <view id="jf-stage" class="journey-field"><text class="journey-label">本次款项<text class="journey-required"> *</text></text><picker range="{{journeyStages}}" range-key="label" data-field="stageId" bindchange="journeyPick" disabled="{{!wbForm.scope||paymentPending}}"><view class="journey-input {{!wbForm.stageId?'placeholder':''}}">{{wbForm.stageLabel||'选择合同款项'}}<image src="/assets/creation-chevron-muted.png"/></view></picker><text wx:if="{{journeyErrorField==='stage'}}" class="journey-error">{{wbError}}</text><text wx:if="{{wbForm.scope&&!journeyStages.length}}" class="journey-note">暂无合同款，可选「其他收款」。</text></view>
  <view wx:if="{{journeyStage}}" class="journey-source"><text>{{journeyStage.customer_name}}</text><view class="journey-row"><text>该期未收</text><text class="journey-money">¥{{journeyStage.remainingText}}</text></view></view>
  <view wx:for="{{journeyReceiptPending}}" wx:key="id" class="journey-pending"><text>已有到账申报 ¥{{item.amountText}}</text><button class="fin-text" data-id="{{item.id}}" bindtap="openJourneyDeclaration" disabled="{{wbBusy||paymentPending}}">先核实这笔收款 ›</button></view>
 </block>
 <block wx:else>
  <view wx:if="{{!wbForm.payrollRecordId}}" id="jf-name" class="journey-field"><text class="journey-label">{{wbForm.type==='receipt'?'收款事由':'费用用途'}}<text class="journey-required"> *</text></text><input cursor-spacing="24" class="journey-input {{journeyErrorField==='name'?'invalid':''}}" data-field="name" value="{{wbForm.name}}" bindinput="wbInput" maxlength="160" placeholder="{{wbForm.type==='receipt'?'如：前期定金':'如：现场运输费'}}" disabled="{{wbBusy||paymentPending}}"/><text wx:if="{{journeyErrorField==='name'}}" class="journey-error">{{wbError}}</text></view>
  <view wx:if="{{wbForm.type!=='receipt'&&!wbForm.payrollRecordId}}" class="journey-field"><text class="journey-label">费用分类</text><picker range="{{journeyCategories}}" data-field="category" bindchange="journeyPick" disabled="{{wbBusy||paymentPending}}"><view class="journey-input">{{wbForm.category}}<image src="/assets/creation-chevron-muted.png"/></view></picker></view>
 </block>
 <view id="jf-amount" class="journey-field"><text class="journey-label">{{wbForm.type==='receipt'?'实际收到':wbForm.type==='payable'?'待付款金额':'实际付出'}}（元）<text class="journey-required"> *</text></text><input cursor-spacing="24" class="journey-input journey-amount-input {{journeyErrorField==='amount'?'invalid':''}}" type="digit" data-field="amount" value="{{wbForm.amount}}" bindinput="wbInput" placeholder="0.00" disabled="{{wbBusy||paymentPending}}"/><text wx:if="{{journeyErrorField==='amount'}}" class="journey-error">{{wbError}}</text></view>
 <view wx:if="{{!wbForm.payrollRecordId&&(wbForm.type!=='receipt'||wbForm.receiptMode==='other')}}" id="jf-counterparty" class="journey-field"><text class="journey-label">{{wbForm.type==='receipt'?'付款方':'收款方'}}<text wx:if="{{wbForm.type!=='receipt'}}" class="journey-required"> *</text><text wx:else class="journey-muted">（选填）</text></text><input cursor-spacing="24" class="journey-input" data-field="counterparty" value="{{wbForm.counterparty}}" bindinput="wbInput" placeholder="{{wbForm.type==='receipt'?'填写付款人或单位':'填写实际收款人或单位'}}" disabled="{{wbBusy||paymentPending}}"/><text wx:if="{{journeyErrorField==='counterparty'}}" class="journey-error">{{wbError}}</text></view>
 <view wx:if="{{!wbForm.payrollRecordId&&wbForm.type==='expense'&&wbForm.category!=='材料'&&wbForm.category!=='人工'}}" class="journey-field"><text class="journey-label">由谁支付</text><picker range="{{['公司支付','员工已垫付']}}" data-field="fundingType" bindchange="wbInput" disabled="{{wbBusy||paymentPending}}"><view class="journey-input">{{wbForm.fundingType==='EMPLOYEE'?'员工已垫付':'公司支付'}}<image src="/assets/creation-chevron-muted.png"/></view></picker><picker wx:if="{{wbForm.fundingType==='EMPLOYEE'}}" range="{{workbenchStaff}}" range-key="name" data-field="payerUserId" bindchange="wbPick" disabled="{{wbBusy||paymentPending}}"><view class="journey-input">{{wbForm.payerUserIdLabel||'选择实际垫付人'}}</view></picker></view>
 <view id="jf-date" class="journey-field"><text class="journey-label">{{wbForm.type==='payable'?'费用发生日':'实际日期'}}<text class="journey-required"> *</text></text><picker mode="date" value="{{wbForm.date}}" data-field="date" bindchange="wbInput" disabled="{{wbBusy||paymentPending}}"><view class="journey-input">{{wbForm.date}}<image src="/assets/creation-chevron-muted.png"/></view></picker><text wx:if="{{journeyErrorField==='date'}}" class="journey-error">{{wbError}}</text></view>
 <view wx:if="{{wbForm.type!=='payable'}}" id="jf-account" class="journey-field"><view class="journey-row"><text class="journey-label">{{wbForm.type==='receipt'?'收款账户':'付款账户'}}<text class="journey-required"> *</text></text><picker range="{{journeyAccounts}}" data-field="account" bindchange="journeyPick" disabled="{{wbBusy||paymentPending}}"><view class="journey-link">选常用账户</view></picker></view><input cursor-spacing="24" class="journey-input" data-field="accountName" value="{{wbForm.accountName}}" bindinput="wbInput" placeholder="选择常用账户或直接填写" disabled="{{wbBusy||paymentPending}}"/><text wx:if="{{journeyErrorField==='account'}}" class="journey-error">{{wbError}}</text></view>
 <view class="journey-field"><text class="journey-label">流水号<text class="journey-muted">（选填）</text></text><input cursor-spacing="24" class="journey-input" data-field="transactionNo" value="{{wbForm.transactionNo}}" bindinput="wbInput" placeholder="银行或支付平台的交易流水号" disabled="{{wbBusy||paymentPending}}"/></view>
 <button class="journey-voucher" bindtap="wbVoucher" disabled="{{wbBusy||paymentPending}}">{{wbForm.voucherName||'添加凭据（选填）'}} ›</button>
 <text wx:if="{{wbError&&!journeyErrorField}}" class="journey-error">{{wbError}}</text>
 <button class="fin-primary" bindtap="submitJourneyEntry" loading="{{wbBusy||registerBusy}}" disabled="{{wbBusy||registerBusy||paymentPending}}">{{wbForm.type==='receipt'?'确认登记收款':wbForm.type==='payable'?'保存待付费用':'登记付款'}}</button>
</view>
<template wx:elif="{{registerType==='revision'}}" is="receiptRevision" data="{{compactHeader:true,revisionForm:revisionForm,revisionBusy:revisionBusy,revisionHistory:revisionHistory,registerError:registerError,registerBusy:registerBusy,paymentPending:paymentPending}}"/>
<view wx:elif="{{registerType==='payment'||registerType==='refund'||registerType==='expense-refund'}}" class="fin-card journey-form">

 <block wx:if="{{registerType==='payment'}}">
  <view wx:if="{{!registerForm.reimbursement}}" id="jf-source" class="journey-field"><text class="journey-label">待付款事项<text class="journey-required"> *</text></text><picker range="{{journeyPaymentOptions}}" range-key="label" data-field="payableId" bindchange="journeyChoosePayable"><view class="journey-input {{!registerForm.payableId?'placeholder':''}}">{{registerForm.payableIdLabel||'选择已登记的采购或费用'}}<image src="/assets/creation-chevron-muted.png"/></view></picker><text wx:if="{{journeyErrorField==='source'}}" class="journey-error">{{registerError}}</text><text wx:if="{{!journeyPaymentOptions.length}}" class="journey-note">当前没有待付采购或费用。</text><button class="journey-inline-link" data-type="expense" bindtap="openWorkbenchEntry">没有原单，补记其他支出 ›</button></view>
  <view wx:if="{{registerForm.reimbursement&&journeyReimbursement}}" class="journey-source"><text class="journey-source-name">报销给 {{journeyReimbursement.payer_name}}</text><text>{{journeyReimbursement.projectName}} · {{journeyReimbursement.stage}}</text><view class="journey-pair"><text>垫付 ¥{{journeyReimbursement.eligibleText}}</text><text>已报 ¥{{journeyReimbursement.paidText}}</text></view><view class="journey-row"><text>待报销</text><text class="journey-money">¥{{journeyReimbursement.remainingText}}</text></view></view>
  <view wx:elif="{{journeyPayment}}" class="journey-source"><text class="journey-source-name">{{journeyPayment.counterparty}}</text><text>{{journeyPayment.projectName}}</text><view class="journey-pair"><text>合计 ¥{{journeyPayment.totalText}}</text><text>已付 ¥{{journeyPayment.paidText}}</text></view><view class="journey-row"><text>待付款</text><text class="journey-money">¥{{journeyPayment.remainingText}}</text></view></view>
  <view wx:if="{{registerForm.allowEmployee&&!registerForm.reimbursement}}" class="journey-field"><text class="journey-label">由谁支付</text><picker range="{{['公司支付','业务已垫付设计费']}}" data-field="fundingType" bindchange="registerInput"><view class="journey-input">{{registerForm.fundingType==='EMPLOYEE'?'业务已垫付设计费':'公司支付'}}</view></picker><picker wx:if="{{registerForm.fundingType==='EMPLOYEE'}}" range="{{workbenchStaff}}" range-key="name" data-field="payerUserId" bindchange="registerPick"><view class="journey-input">{{registerForm.payerName||'选择实际垫付人'}}</view></picker></view>
 </block>
 <block wx:else>
  <view id="jf-source" class="journey-field"><text class="journey-label">{{registerType==='refund'?'原收款':'原付款'}}<text class="journey-required"> *</text></text><picker range="{{journeyRefundOptions}}" range-key="label" bindchange="journeyChooseRefund"><view class="journey-input">{{registerType==='refund'?(registerForm.receiptIdLabel||'选择原收款'):(registerForm.paymentIdLabel||'选择原付款')}}<image src="/assets/creation-chevron-muted.png"/></view></picker></view>
  <view wx:if="{{journeyRefund}}" class="journey-source">
   <view class="journey-row"><text>{{journeyRefund.referenceLabel}}</text><text selectable class="journey-source-reference">{{journeyRefund.reference}}</text></view>
   <view class="journey-row"><text>原金额</text><text>¥{{journeyRefund.originalText}}</text></view>
   <view class="journey-row"><text>剩余可退</text><text class="journey-money">¥{{journeyRefund.remainingText}}</text></view>
  </view>
  <view wx:if="{{registerType==='expense-refund'}}" class="journey-field"><text class="journey-label">实际退回至</text><picker range="{{[registerForm.originalRefundFundingType?'沿用原退回去向':'原付款方','公司账户','原垫付员工']}}" data-field="refundFundingType" bindchange="registerInput"><view class="journey-input">{{registerForm.refundFundingType==='COMPANY'?'公司账户':registerForm.refundFundingType==='EMPLOYEE'?'原垫付员工':'原付款方'}}</view></picker></view>
 </block>
 <block wx:if="{{registerType!=='payment'||registerForm.payableId}}">
 <view id="jf-amount" class="journey-field"><text class="journey-label">{{registerForm.reimbursement?'本次报销':registerType==='payment'?'本次实际付款':'实际退款金额'}}（元）<text class="journey-required"> *</text></text><input cursor-spacing="24" class="journey-input journey-amount-input" type="digit" data-field="amount" value="{{registerForm.amount}}" bindinput="registerInput" placeholder="0.00"/><text wx:if="{{journeyErrorField==='amount'}}" class="journey-error">{{registerError}}</text></view>
 <view wx:if="{{registerType==='payment'}}" id="jf-account" class="journey-field"><view class="journey-row"><text class="journey-label">实际付款账户<text class="journey-required"> *</text></text><picker range="{{journeyAccounts}}" data-field="account" bindchange="journeyPick"><view class="journey-link">选常用账户</view></picker></view><input cursor-spacing="24" class="journey-input" data-field="accountName" value="{{registerForm.accountName}}" bindinput="registerInput" placeholder="选择常用账户或直接填写"/><text wx:if="{{journeyErrorField==='account'}}" class="journey-error">{{registerError}}</text></view>
 <view wx:else id="jf-reason" class="journey-field"><text class="journey-label">退回原因<text class="journey-required"> *</text></text><input cursor-spacing="24" class="journey-input" data-field="reason" value="{{registerForm.reason}}" bindinput="registerInput"/><text wx:if="{{journeyErrorField==='reason'}}" class="journey-error">{{registerError}}</text></view>
 <view id="jf-date" class="journey-field"><text class="journey-label">实际日期<text class="journey-required"> *</text></text><picker mode="date" value="{{registerType==='payment'?registerForm.payDate:registerForm.date}}" data-field="{{registerType==='payment'?'payDate':'date'}}" bindchange="registerInput"><view class="journey-input">{{registerType==='payment'?registerForm.payDate:registerForm.date}}<image src="/assets/creation-chevron-muted.png"/></view></picker><text wx:if="{{journeyErrorField==='date'}}" class="journey-error">{{registerError}}</text></view>
 <view class="journey-field"><text class="journey-label">流水号<text class="journey-muted">（选填）</text></text><input cursor-spacing="24" class="journey-input" data-field="transactionNo" value="{{registerForm.transactionNo}}" bindinput="registerInput" placeholder="银行或支付平台的交易流水号"/></view>
 <button class="journey-voucher" bindtap="registerUpload">{{registerForm.voucherName||'添加凭据（选填）'}} ›</button>
 <text class="journey-note">登记已发生的线下收付款，不发起转账。</text><text wx:if="{{registerError&&!journeyErrorField}}" class="journey-error">{{registerError}}</text>
 <button class="fin-primary" bindtap="submitJourneyRegister" loading="{{registerBusy}}" disabled="{{registerBusy}}">{{registerForm.reimbursement?'确认登记报销':registerType==='payment'?'登记付款':'登记退款'}}</button>
 </block>
</view>
<block wx:else><template is="workbench" data="{{compactHeader:true,view:'form',wbForm:wbForm,wbBusy:wbBusy,paymentPending:paymentPending,wbError:wbError,workbenchBooks:workbenchBooks,financialStages:financialStages,allocationReceipts:allocationReceipts,allocationReceiptsLoading:allocationReceiptsLoading,allocationReceiptsError:allocationReceiptsError,allocationReceiptHint:allocationReceiptHint,workbenchStaff:workbenchStaff}}"/></block>
