<template name="receiptRevision">
    <view class="fin-card"><view wx:if="{{!compactHeader}}" class="fin-heading"><text class="fin-title">修订收款金额（全留痕）</text><button class="fin-text" bindtap="cancelRegister">取消</button></view>
     <view class="fin-form-row"><text class="fin-muted">原金额</text><text class="fin-input">{{revisionForm.originAmount}}</text></view>
     <view class="fin-form-row"><text class="fin-muted">新金额</text><input class="fin-input" data-field="amount" bindinput="revisionInput" value="{{revisionForm.amount}}"/></view>
     <view class="fin-form-row"><text class="fin-muted">修订说明（留痕）</text><input class="fin-input" data-field="note" bindinput="revisionInput" value="{{revisionForm.note}}"/></view>
     <text wx:if="{{registerError}}" class="fin-error">{{registerError}}</text><button class="fin-primary" bindtap="submitRevision" disabled="{{revisionBusy}}">提交修订</button>
     <view wx:if="{{revisionHistory}}" class="fin-form-row" style="margin-top:12rpx"><text class="fin-muted">修订历史</text>
      <text wx:if="{{revisionHistory.status==='loading'}}" class="fin-muted">加载中…</text>
      <text wx:elif="{{revisionHistory.status==='failed'}}" class="fin-muted">历史加载失败（不影响提交）</text>
      <text wx:elif="{{revisionHistory.status==='ready'&&!revisionHistory.rows.length}}" class="fin-muted">暂无修订记录</text>
      <block wx:elif="{{revisionHistory.status==='ready'}}">
       <view wx:for="{{revisionHistory.rows}}" wx:key="versionAfter" style="width:100%"><text>_v{{item.versionAfter}}：{{item.originalText}} → {{item.newText}} · {{item.note}}（{{item.dateText}}）</text></view>
      </block>
     </view>
    </view>
</template>
