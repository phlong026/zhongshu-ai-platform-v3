<import src="./project-books.wxml"/>
<import src="./workbench.wxml"/>
<view class="journey">
 <block wx:if="{{journeyResult}}">
  <view class="fin-card journey-result"><icon type="success" size="42" color="#8c542e"/><text class="journey-title">{{journeyResult.title}}</text><text class="journey-result-amount">¥{{journeyResult.amount}}</text><text>{{journeyResult.name}}</text><text class="journey-muted">已记录至 {{journeyResult.scopeLabel}}</text><text wx:if="{{journeyResult.employee}}" class="journey-muted">员工垫付已记账，待报销</text><button class="fin-primary" bindtap="viewJourneyResult">{{journeyResult.employee?'查看账本':'查看本笔记录'}}</button><button class="fin-outline" bindtap="closeFinanceEntry">{{journeyReturnLabel||'返回上一页'}}</button></view>
 </block>
 <block wx:elif="{{journeyDeclaration}}">
  <view class="fin-card journey-form">
   <view class="journey-source"><text class="journey-source-name">{{journeyDeclaration.name}}</text><text>{{journeyDeclaration.projectName}}</text><text class="journey-result-amount">¥{{journeyDeclaration.amountText}}</text></view>
   <view class="book-info-row"><text>到账日期</text><text>{{journeyDeclaration.date}}</text></view>
   <view class="journey-field"><view class="journey-row"><text class="journey-label">实际收款账户<text class="journey-required"> *</text></text><picker range="{{journeyAccounts}}" data-field="account" bindchange="journeyPick" disabled="{{wbBusy||declarationPending}}"><view class="journey-link">选常用账户</view></picker></view><input cursor-spacing="24" class="journey-input" data-field="accountName" value="{{declarationForm.accountName}}" bindinput="declarationInput" maxlength="100" disabled="{{wbBusy||declarationPending}}" placeholder="选择常用账户或直接填写"/></view>
   <view class="journey-field"><text class="journey-label">收款方式<text class="journey-required"> *</text></text><picker range="{{['银行转账','现金','其他']}}" data-field="method" bindchange="declarationInput" disabled="{{wbBusy||declarationPending}}"><view class="journey-input">{{declarationForm.method==='bank'?'银行转账':declarationForm.method==='cash'?'现金':declarationForm.method==='other'?'其他':'选择实际收款方式'}}</view></picker></view>
   <view class="book-info-row"><text>流水号</text><text selectable>{{journeyDeclaration.transaction_no||'未填写'}}</text></view><button wx:if="{{journeyDeclaration.voucher_file_id}}" class="fin-outline" bindtap="openJourneyVoucher">查看到账凭据</button>
   <text class="journey-note">核实到账后，申报同步为已收款。</text><text wx:if="{{workbenchError}}" class="journey-error">{{workbenchError}}</text><button class="fin-primary" data-id="{{journeyDeclaration.id}}" bindtap="confirmCollectionDeclaration" loading="{{wbBusy}}" disabled="{{wbBusy}}">{{declarationPending&&!wbBusy?'按原资料重试核实':'确认实际到账'}}</button><button class="fin-text" data-id="{{journeyDeclaration.id}}" bindtap="returnCollectionDeclaration" disabled="{{wbBusy||declarationPending}}">退回补充资料</button>
  </view>
 </block>
 <block wx:elif="{{registerType||wbForm}}"><include src="./journey-forms.wxml"/></block>
 <block wx:else>
  <template wx:if="{{view==='projects'}}" is="projectBooks" data="{{keyword,bookListTab,financeProjects,financeProjectLoading,financeProjectError}}"/>
  <button wx:if="{{view==='book'}}" class="journey-back" bindtap="back"><image src="/assets/creation-back.png"/>返回账本列表</button>
  <template wx:if="{{view==='book'}}" is="projectBook" data="{{journeyEnabled,wbForm,bookName,bookNet,bookCost,bookAccounting,bookAccountingUrl,bookScope,bookSummary,bookEntries,bookResult,bookEmployeeRows,bookFlowTab,canLinkBook,bookLoading,bookError,bookCollectionUrl,bookMaterialsUrl,bookExpensesUrl}}"/>
  <block wx:if="{{view==='reimbursements'}}">
   <view class="journey-page-heading"><text class="journey-title">员工报销</text><text class="journey-muted">{{journeyReimbursements.length}}笔</text></view>
   <text wx:if="{{workbenchError}}" class="journey-error">{{workbenchError}}</text>
   <view wx:for="{{journeyReimbursements}}" wx:key="id" class="fin-card journey-employee"><view class="fin-heading"><text class="journey-title">{{item.payer_name}}</text><text class="journey-state">{{item.state}}</text></view><text class="journey-muted">{{item.projectName}}</text><text class="journey-note">{{item.stage}} · {{item.pay_date}}</text><view class="journey-employee-amount"><text>{{item.remaining<0?'待归还':'待报销'}}</text><text>¥{{item.remainingText}}</text></view><view class="journey-pair"><text>垫付 ¥{{item.eligibleText}}</text><text>已报销 ¥{{item.paidText}}</text></view><text wx:if="{{item.recovered_cents>0}}" class="journey-muted">已归还 ¥{{item.recoveredText}}</text><button wx:if="{{item.remaining>0}}" class="fin-primary" data-id="{{item.id}}" bindtap="reimburseEmployee">办理报销</button><button wx:if="{{item.remaining<0}}" class="fin-outline" data-id="{{item.id}}" bindtap="recoverEmployee">登记员工归还</button><button wx:if="{{journeyEnabled}}" class="fin-text" data-id="{{item.id}}" bindtap="openEmployeeAdvance">垫付明细</button></view>
   <view wx:if="{{!journeyReimbursements.length&&!workbenchError}}" class="fin-card book-empty">暂无员工报销事项</view>
  </block>
  <block wx:if="{{view==='progress'}}">
   <view class="journey-page-heading"><text class="journey-title">正在办理</text><text class="journey-muted">{{journeyProgress.length}}笔</text></view>
   <button wx:for="{{journeyProgress}}" wx:key="id" class="fin-card journey-progress" data-key="{{item.key||item.id}}" data-url="{{item.url}}" bindtap="openFinanceTask"><view class="journey-row"><text class="journey-source-name">{{item.name}}</text><text class="journey-state">{{item.status}}</text></view><text class="journey-muted">{{item.projectName}}</text><view class="journey-row journey-amount-end"><text class="journey-money">{{item.amount}}</text></view></button>
   <view wx:if="{{!journeyProgress.length}}" class="fin-card book-empty">暂无进行中事项</view>
  </block>
  <block wx:if="{{view==='tasks'}}"><view class="journey-page-heading"><text class="journey-title">待我办理</text><text class="journey-muted">{{rows.length}}笔</text></view><button wx:for="{{rows}}" wx:key="key" class="fin-card journey-progress" data-key="{{item.key||item.id}}" data-url="{{item.url}}" bindtap="openFinanceTask"><text class="journey-source-name">{{item.name}}</text><view class="journey-row"><text class="journey-state">{{item.status}}</text><text class="journey-money">{{item.amount}}</text></view></button><view wx:if="{{!rows.length}}" class="fin-card book-empty">{{platformNotice||'暂无待办事项'}}</view></block>
  <block wx:if="{{view==='flows'}}">
   <view class="journey-page-heading"><text class="journey-title">{{flowTab==='receivables'?'业主收款':flowTab==='payables'?'待付事项':flowTab==='reconcile'?'月末对账':'收支流水'}}</text><month-select wx:if="{{flowTab==='ledger'||flowTab==='reconcile'}}" value="{{journeyPeriod==='全部月份'?selectedMonth:journeyPeriod}}" bind:change="financeMonth"/></view>
   <view class="book-tabs journey-flow-tabs"><button class="book-tab {{flowTab==='ledger'?'selected':''}}" data-tab="ledger" bindtap="segment"><text class="book-tab-label">流水</text></button><button class="book-tab {{flowTab==='receivables'?'selected':''}}" data-tab="receivables" bindtap="segment"><text class="book-tab-label">业主收款</text></button><button class="book-tab {{flowTab==='payables'?'selected':''}}" data-tab="payables" bindtap="segment"><text class="book-tab-label">待付事项</text></button><button class="book-tab {{flowTab==='reconcile'?'selected':''}}" data-tab="reconcile" bindtap="segment"><text class="book-tab-label">对账</text></button></view>
   <view wx:if="{{platformFinance.status==='degraded'}}" class="fin-card"><text class="journey-error">{{platformFinance.message||workbenchError}}</text><button class="fin-text" bindtap="retryPlatformFinance">重新加载</button></view>
   <view class="fin-refresh-status" bindtap="retryPlatformFinance">{{financeRefreshing?'更新中…':platformFinance.message||reconciliation.message||workbenchError?'更新失败，点此重试':''}}</view>
   <block wx:if="{{flowTab==='ledger'}}">
    <view class="fin-card journey-cash-summary"><view><text>流入</text><text>¥{{platformFinance.status==='ready'?journeyTotals.incoming:'—'}}</text></view><view><text>流出</text><text>¥{{platformFinance.status==='ready'?journeyTotals.outgoing:'—'}}</text></view><view><text>收支净额</text><text>¥{{platformFinance.status==='ready'?journeyTotals.net:'—'}}</text></view></view>
    <view class="fin-search"><image src="/assets/search.png"/><input cursor-spacing="24" value="{{keyword}}" bindinput="search" placeholder="搜索项目、对方或用途"/><button wx:if="{{keyword}}" class="fin-text" bindtap="clear">清空</button></view>
    <view class="journey-cash-filters"><button class="{{!journeyDirection||journeyDirection==='all'?'active':''}}" data-direction="all" bindtap="changeCashDirection">全部</button><button class="{{journeyDirection==='in'?'active':''}}" data-direction="in" bindtap="changeCashDirection">流入</button><button class="{{journeyDirection==='out'?'active':''}}" data-direction="out" bindtap="changeCashDirection">流出</button><text class="journey-muted">{{journeyCashTotal}}笔</text></view>
    <view class="fin-card book-transactions"><button wx:for="{{journeyCashRows}}" wx:key="key" class="book-transaction" data-key="{{item.key}}" bindtap="openJourneyCash"><view class="book-transaction-main"><text class="book-transaction-name">{{item.name}}</text><text class="book-transaction-meta">{{item.projectName}}</text><text class="book-transaction-meta">{{item.date||'日期待核'}}{{item.counterparty?' · '+item.counterparty:''}}</text></view><view class="book-transaction-right"><text class="book-transaction-amount {{item.tone}}">{{item.sign}}{{item.amount}}</text><image class="book-chevron" src="/assets/creation-chevron-muted.png"/></view></button><view wx:if="{{!journeyCashRows.length&&platformFinance.status==='ready'}}" class="book-empty">暂无符合条件的收支</view></view>
    <text class="journey-note">员工垫付见账本「员工往来」。</text>
    <view wx:if="{{reconciliation.abnormalCount}}" class="journey-pending"><text>{{reconciliation.abnormalCount}}笔资金待核对</text><button class="fin-text" data-tab="reconcile" bindtap="segment">查看对账 ›</button></view>
    <view class="journey-two-actions"><button class="fin-primary" data-type="receipt" bindtap="openRegister">登记收款</button><button class="fin-outline" data-type="payment" bindtap="openRegister">登记付款</button></view>
    <view wx:if="{{voidNotice}}" class="fin-card"><text class="journey-note">{{voidNotice}}</text><button class="fin-text" bindtap="dismissVoidNotice">知道了</button></view><text wx:if="{{ledgerError}}" class="journey-error">{{ledgerError}}</text>
   </block>
   <block wx:if="{{flowTab==='receivables'}}">
    <view wx:if="{{journeyDeclarations.length}}" class="journey-page-heading"><text class="journey-source-name">待核实到账</text><text class="journey-state">{{journeyDeclarations.length}}笔</text></view>
    <button wx:for="{{journeyDeclarations}}" wx:key="id" class="fin-card journey-progress" data-id="{{item.id}}" bindtap="openJourneyDeclaration"><text class="journey-source-name">{{item.name}}</text><text class="journey-muted">{{item.projectName}}</text><view class="journey-row"><text class="journey-muted">{{item.date}}</text><text class="journey-money">¥{{item.amountText}}</text></view><text class="journey-state">核实实际到账 ›</text></button>
    <view wx:if="{{platformFinance.bankFlows.length}}" class="fin-card"><text class="journey-title">到账待匹配</text><view wx:for="{{platformFinance.bankFlows}}" wx:key="id" class="journey-source"><text>{{item.bankRef}} · ¥{{item.amountCents/100}}</text><picker range="{{platformRegister.pendingReceipts}}" range-key="label" data-flow-id="{{item.id}}" bindchange="bankPick"><view class="journey-input">选择待登记收款</view></picker><button class="fin-outline" data-flow-id="{{item.id}}" bindtap="confirmBankSubmit">匹配原收款</button></view></view>
    <view class="journey-page-heading"><text class="journey-source-name">合同应收</text><button class="fin-text" data-type="receipt" bindtap="openRegister">登记收款</button></view>
    <view wx:for="{{financialStages}}" wx:key="id" class="fin-card journey-contract"><text class="journey-source-name">{{item.customer_name}} · {{item.stageName}}</text><view class="journey-row"><text class="journey-muted">待收款</text><text class="journey-money">¥{{item.remainingText}}</text></view><view class="journey-two-actions"><button wx:if="{{item.amount_cents>item.collected_cents}}" class="fin-outline" data-id="{{item.id}}" bindtap="collectJourneyStage">登记到账</button><button wx:if="{{item.amount_cents>item.collected_cents}}" class="fin-text" data-id="{{item.id}}" bindtap="openReceiptAllocation">抵扣已有定金</button></view><button class="fin-text" data-id="{{item.contract_id}}" bindtap="openContractChange">付款计划与变更记录</button></view>
    <view wx:if="{{!financialStages.length&&!journeyDeclarations.length}}" class="fin-card book-empty">暂无合同应收</view>
   </block>
   <block wx:if="{{flowTab==='payables'}}"><button class="fin-text" data-type="payable" bindtap="openRegister">登记其他待付费用</button><view wx:for="{{journeyPayables}}" wx:key="id" wx:if="{{item.canPay||item.commissionHold}}" class="fin-card journey-contract"><view class="journey-row"><text class="journey-source-name">{{item.name}}</text><text class="journey-state">{{item.commissionHold?'待老板核对':item.paidCents>0?'部分付款':'待付款'}}</text></view><text class="journey-muted">{{item.projectName}} · {{item.counterparty}}</text><view class="journey-employee-amount"><text>待付款</text><text>¥{{item.remainingText}}</text></view><view class="journey-pair"><text>合计 ¥{{item.totalText}}</text><text>已付 ¥{{item.paidText}}</text></view><text wx:if="{{item.commissionHold}}" class="journey-note">{{item.holdReason}}</text><button wx:if="{{item.canPay}}" class="fin-primary" data-id="{{item.id}}" bindtap="payJourneyRow">{{item.sourceType==='reimbursement'?'办理报销':'登记付款'}}</button><view class="journey-two-actions"><button wx:if="{{item.canAdjust}}" class="fin-text" data-id="{{item.id}}" bindtap="openPayableAdjustment">结算调整</button><button wx:if="{{item.canAssign}}" class="fin-text" data-id="{{item.id}}" bindtap="assignPayableBook">账本归属</button></view></view><view wx:if="{{!journeyPayableCount}}" class="fin-card book-empty">暂无待付款事项</view></block>
   <block wx:if="{{flowTab==='reconcile'}}"><include src="./month-reconciliation.wxml"/></block>
  </block>
 </block>
 <template is="bookEntryDetail" data="{{bookEntryDetail,journeyEnabled}}"/>
</view>
