<import src="./receipt-revision.wxml"/>
<import src="./project-books.wxml"/>
<import src="./workbench.wxml"/>
<import src="./finance-home.wxml"/>
<import src="../../profile/profile.wxml"/>
<view class="fin-page">
 <view wx:if="{{paymentNotice}}" class="journey-source"><text>{{paymentNotice}}</text><button wx:if="{{paymentPending}}" disabled="{{!paymentRetry}}" bindtap="retryPendingPayment">核验原单并重试</button></view>

 <block wx:if="{{view==='profile'&&ready}}"><template is="profile" data="{{loggedIn,name,identityOrganization,identityRole,learningAvailable,learningLoading,learningError,courseId,profileLoading,profileError,avatar,unread,announcementTitle,progress,courseImage,courseTitle,entries,showStoreServices,showAdminMap,showStoreMap,ownerProfile,managementEntries,nested:true}}"/></block>
 <block wx:elif="{{view==='desk'&&ready}}"><template is="financeHome" data="{{desk:deskHome,platformFinance:platformFinance,platformTodos:platformTodos,financeRefreshing:financeRefreshing}}"/></block>
 <block wx:else>
 <brand-header id="finance-page-header" wx:if="{{journeyEnabled&&(wbForm||registerType||journeyDeclaration||journeyResult||designReceiptForm)}}" action account-font title="{{journeyResult?'登记结果':journeyDeclaration?'核实业主到账':designReceiptForm?'核实设计款到账':wbForm?journeyEntryTitles[wbForm.type]:registerType==='payment'&&registerForm.reimbursement?'办理报销':journeyEntryTitles[registerType]}}" return-label="{{journeyReturnLabel||'返回上一页'}}" busy="{{wbBusy||registerBusy||revisionBusy||designReceiptBusy||busy}}" bind:return="returnFinanceEntry"/>
 <brand-header id="finance-page-header" wx:else branded fixed divider account-font title="{{title||'财务工作台'}}"/>
 <view class="fin-content">
 <block wx:if="{{ready}}">
 <template wx:if="{{refundVoidable&&!registerType&&!wbForm&&!bookEntryDetail&&!journeyResult&&!journeyDeclaration&&!designReceiptForm}}" is="refundCorrectionQueue" data="{{items:platformFinance.refundCorrections}}"/>
 <block wx:if="{{journeyEnabled&&!designReceiptForm}}"><include src="./journey.wxml"/></block><block wx:else>
  <template wx:if="{{platformApiMode&&!projectLedgerReadOnly}}" is="workbench" data="{{view,registerType,bookScope,canLinkBook,bookLoading,bookError,bookSummary,bookEntries,bookResult,bookEmployeeRows,bookName,bookNet,bookCost,bookAccounting,bookAccountingUrl,bookFlowTab,bookEntryDetail,bookCollectionUrl,bookMaterialsUrl,bookExpensesUrl,workbenchError,reimbursementRows,wbForm,wbBusy,wbError,workbenchBooks,collectionDeclarations,financialStages,allocationReceipts,workbenchStaff}}"/>
  <template wx:if="{{platformApiMode&&view==='projects'&&!wbForm}}" is="projectBooks" data="{{keyword,bookListTab,financeProjects,financeProjectLoading,financeProjectError}}"/>
  <view wx:if="{{platformApiMode&&view==='flows'&&!registerType&&!wbForm&&!designReceiptForm}}" class="fin-card">
   <view class="fin-heading"><text class="fin-title">设计费 · 门店付款 / 平台核收</text><button class="fin-text" bindtap="loadDesignFees">{{designFeeStatus==='loading'?'更新中…':designFeeError?'更新失败，重试':'刷新'}}</button></view>
   <text class="fin-muted">按原委托版本和期次登记线下实付，不发起转账。</text>
   <text wx:if="{{designFeeStatus==='loading'&&!designFeeRows.length}}" class="fin-muted">正在加载…</text><text wx:if="{{designFeeError&&!designFeeRows.length}}" class="fin-error">{{designFeeError}}</text>
   <view wx:for="{{designFeeRows}}" wx:key="key" class="fin-flow-row"><text class="fin-name">委托 {{item.commissionId}} · V{{item.submissionVersion}} · {{item.stageLabel}}</text><text class="fin-muted">应付 ¥{{item.expectedText}} · 门店净付 ¥{{item.paidText}} · 平台净收 ¥{{item.receivedText}}</text><button wx:if="{{item.canPay}}" class="fin-outline" data-key="{{item.key}}" bindtap="openDesignPayment">登记付款</button><view wx:for="{{item.payments}}" wx:for-item="payment" wx:key="paymentId"><text class="fin-muted">原付款 {{payment.paymentId}} · 可核收 ¥{{payment.receivableText}}</text><button wx:if="{{payment.canReceive}}" class="fin-outline" data-key="{{item.key}}" data-payment-id="{{payment.paymentId}}" bindtap="openDesignReceipt">分笔核收这笔付款</button></view></view>
   <text wx:if="{{designFeeStatus==='ready'&&!designFeeRows.length}}" class="fin-muted">暂无本组织设计费用记录</text><button wx:if="{{designFeeRows.length<designFeeTotal}}" class="fin-text" bindtap="moreDesignFees">加载更多设计费用</button>
   <text wx:for="{{designFeeRows}}" wx:key="key" wx:if="{{item.exceptionText}}" class="fin-error">委托 {{item.commissionId}} {{item.stageLabel}} · {{item.exceptionText}}</text>
  </view>
  <view wx:if="{{designReceiptForm}}" class="fin-card"><view wx:if="{{!journeyEnabled}}" class="fin-heading"><text class="fin-title">按原付款分笔核收</text><button class="fin-text" bindtap="cancelDesignReceipt">取消</button></view><text class="fin-muted">原付款 {{designReceiptPaymentId}}</text><view class="fin-form-row"><text>本次实际到账（元）</text><input cursor-spacing="24" class="fin-input" type="digit" data-field="amount" bindinput="designReceiptInput" value="{{designReceiptForm.amount}}"/></view><view class="fin-form-row"><text>实际到账日</text><picker mode="date" data-field="receivedDate" bindchange="designReceiptInput"><view>{{designReceiptForm.receivedDate}}</view></picker></view><view class="fin-form-row"><text>银行流水号</text><input cursor-spacing="24" class="fin-input" data-field="transactionNo" bindinput="designReceiptInput" value="{{designReceiptForm.transactionNo}}"/></view><button class="fin-text" bindtap="designReceiptVoucher">{{designReceiptForm.voucherName||'选择实际到账凭证（选填）'}}</button><text wx:if="{{designReceiptError}}" class="fin-error">{{designReceiptError}}</text><button class="fin-primary" loading="{{designReceiptBusy}}" disabled="{{designReceiptBusy}}" bindtap="submitDesignReceipt">确认核收</button></view>
  <template wx:if="{{platformApiMode&&view==='project'}}" is="readonlyProjectBook" data="{{id,projectBookName,projectBookNet,projectLedgerSummary,projectLedgerEntries,projectLedgerTotal,ledgerProjectLoading,ledgerProjectError,projectLedgerReadOnly}}"/>
  <view wx:if="{{!registerType&&!wbForm&&(view==='flows'||(view==='projects'&&!platformApiMode)||view==='partners'||view==='tasks')}}" class="fin-desk-tools">
   <view class="fin-search"><image src="/assets/search.png" mode="aspectFit"/><input cursor-spacing="24" class="fin-search-input" value="{{keyword}}" bindinput="search" placeholder="{{view==='partners'?'搜索加盟商或项目':view==='projects'?'搜索客户、项目或进度':'搜索客户、项目或原单'}}" confirm-type="search" maxlength="80" aria-label="搜索财务原单"/><button wx:if="{{keyword}}" class="fin-clear" bindtap="clear">清空</button></view>
   <view class="fin-desk-context"><text>{{company}}</text><text wx:if="{{flowScope==='all'}}" class="fin-desk-period">全部月份</text><picker wx:else mode="date" fields="month" value="{{period}}" bindchange="month"><view class="fin-desk-period">{{periodText}}⌄</view></picker></view>
   <view wx:if="{{!registerType&&!wbForm&&(view==='flows'||(view==='projects'&&!platformApiMode)||view==='partners')}}" class="fin-segments"><button class="fin-segment {{view==='flows'&&flowTab==='ledger'?'selected':''}}" data-tab="ledger" bindtap="segment">流水</button><button class="fin-segment {{view==='flows'&&flowTab==='receivables'?'selected':''}}" data-tab="receivables" bindtap="segment">应收</button><button class="fin-segment {{view==='flows'&&flowTab==='payables'?'selected':''}}" data-tab="payables" bindtap="segment">应付</button><button class="fin-segment {{view==='flows'&&flowTab==='reconcile'?'selected':''}}" data-tab="reconcile" bindtap="segment">月末对账</button><button class="fin-segment {{view!=='flows'?'selected':''}}" data-tab="books" bindtap="segment">{{hq?'加盟商':'项目账'}}</button></view>
  </view>
  <view wx:if="{{stats.length&&!(platformApiMode&&flowTab==='ledger')}}" class="fin-card"><view class="fin-heading"><text class="fin-title">{{view==='partners'?'总部往来':flowTab==='reconcile'?'月末对账汇总':flowScope==='all'?'累计有效收款':flowScope==='current'?'本月有效收款':flowTab==='payables'?'付款与占用':flowTab==='ledger'?'本月实际收付':'收款与应收'}}</text></view><view class="fin-three"><view wx:for="{{stats}}" wx:key="label"><text class="fin-muted">{{item.label}}</text><text class="fin-value">{{item.value}}</text></view></view></view>

  <block wx:if="{{view==='flows'}}">
   <block wx:if="{{platformApiMode&&flowTab==='ledger'&&(platformFinance.status==='ready'||platformFinance.status==='loading'||platformFinance.status==='degraded')}}">
       <view wx:if="{{!registerType&&!wbForm&&flowTab!=='reconcile'&&reconciliation&&reconciliation.status!=='loading'}}" class="fin-card"><view class="fin-heading"><text class="fin-title">对账视图（{{reconciliation.month||'本月'}}）</text><text class="fin-muted fin-refresh-hint" bindtap="retryPlatformFinance">{{financeRefreshing?'更新中…':reconciliation.message?'更新失败，点此重试':''}}</text></view><block wx:if="{{reconciliation.status==='ready'}}"><view class="fin-three"><view><text class="fin-muted">毛额·已登记收款</text><text class="fin-value">¥{{reconciliation.grossText}}</text></view><view><text class="fin-muted">退款·对客</text><text class="fin-value">¥{{reconciliation.refundsText}}</text></view><view><text class="fin-muted">净实收</text><text class="fin-value">¥{{reconciliation.netText}}</text></view></view><text wx:if="{{reconciliation.abnormalCount}}" class="fin-muted">异常资金待关联 {{reconciliation.abnormalCount}} 笔 ¥{{reconciliation.abnormalText}}；其中日期待核 {{reconciliation.datePendingCount}} 笔 ¥{{reconciliation.datePendingText}}（待归月单列，不计入净额）</text><text wx:else class="fin-muted">无待关联异常资金</text></block><text wx:else class="fin-muted">{{reconciliation.message||'对账数据暂时无法加载'}}</text></view>
   <view wx:if="{{platformFinance.status==='loading'}}" class="fin-card"><text class="fin-muted">平台台账加载中…</text></view>
   <view wx:elif="{{platformFinance.status==='degraded'}}" class="fin-card"><text class="fin-muted">{{platformFinance.message||'平台台账暂时无法加载'}}</text><button class="fin-text" bindtap="retryPlatformFinance">重新加载</button></view>
   <block wx:else>
    <view wx:if="{{voidNotice}}" class="fin-card fin-void-notice"><view class="fin-heading"><text class="fin-title">台账联动提示</text><button class="fin-text" bindtap="dismissVoidNotice">知道了</button></view><text class="fin-note">{{voidNotice}}</text></view>
    <view wx:if="{{ledgerError}}" class="fin-error">{{ledgerError}}</view>
    <view wx:if="{{platformFinance.bankFlows.length}}" class="fin-card"><text class="fin-title">到账待匹配</text><view wx:for="{{platformFinance.bankFlows}}" wx:key="id" wx:if="{{item.status!=='CONFIRMED'}}" class="fin-flow-row"><text>{{item.bankRef}} · ¥{{item.amountCents/100}} · {{item.bankDate}}</text><picker range="{{platformRegister.pendingReceipts}}" range-key="label" data-flow-id="{{item.id}}" bindchange="bankPick"><view class="fin-input">选择待登记收款</view></picker><button class="fin-outline" data-flow-id="{{item.id}}" bindtap="confirmBankSubmit">匹配原收款</button></view></view>
<view wx:if="{{!registerType&&!wbForm}}" class="fin-card"><view class="fin-heading"><text class="fin-title">收支流水</text><text class="fin-muted fin-refresh-hint" bindtap="retryPlatformFinance">{{financeRefreshing?'更新中…':platformFinance.message?'更新失败，点此重试':platformLedger.length+'笔'}}</text></view>
     <view wx:for="{{platformLedger}}" wx:key="id" class="fin-flow-row"><view class="fin-row-top"><view class="fin-grow"><text class="fin-name">{{item.name}}</text><view class="fin-row-heading"><text class="fin-amount {{item.tone}}">{{item.amountText}}</text><text class="fin-status">{{item.category}}</text></view><text class="fin-muted">{{item.dateText}} · {{item.status}}</text><button class="fin-text" data-id="{{item.id}}" data-kind="{{item.sourceKind}}" bindtap="openFinanceSupplement">补充凭据／说明</button><button wx:if="{{item.category==='收款'}}" class="fin-text" data-id="{{item.id}}" bindtap="openRevision">修订金额</button><button wx:if="{{refundVoidable&&item.sourceKind==='refund'&&item.status==='已核实'}}" class="fin-text" data-id="{{item.id}}" bindtap="openCorrection">作废重登</button><button wx:if="{{item.canVoid}}" class="fin-text" data-id="{{item.id}}" bindtap="openPaymentVoid">撤销</button></view></view></view>
     <view wx:if="{{!platformLedger.length}}" class="fin-list-empty fin-empty"><text>平台台账暂无记录</text></view>
     <view wx:if="{{ledgerAllCount>platformLedger.length}}" class="fin-list-empty"><button class="fin-text" bindtap="loadMoreLedger">加载更多（{{ledgerAllCount-platformLedger.length}} 笔）</button></view>
    </view>
    <view wx:if="{{!registerType&&!wbForm}}" class="fin-card"><view class="fin-heading"><text class="fin-title">登记</text></view><view class="fin-shortcuts"><button class="fin-shortcut" data-type="receipt" bindtap="openRegister">收款登记</button><button class="fin-shortcut" data-type="payment" bindtap="openRegister">登记付款</button><button class="fin-shortcut" data-type="refund" bindtap="openRegister">登记退款</button><button class="fin-shortcut" data-type="expense-refund" bindtap="openRegister">登记退款（支出退回）</button><button class="fin-shortcut" data-type="payable" bindtap="openRegister">应付登记</button></view></view>
    <template wx:if="{{registerType==='revision'}}" is="receiptRevision" data="{{revisionForm,revisionBusy,revisionHistory,registerError}}"/>
    <view wx:if="{{registerType&&registerType!=='revision'}}" class="fin-card"><view class="fin-heading"><text class="fin-title">{{registerType==='receipt'?'收款登记':registerType==='payment'?'登记付款':registerType==='refund'?'登记退款':registerType==='expense-refund'?'登记退款':'应付登记'}}</text><button class="fin-text" bindtap="cancelRegister">取消</button></view>
     <view class="fin-form-row"><text class="fin-muted">金额（元）</text><input cursor-spacing="24" class="fin-input" type="digit" data-field="amount" bindinput="registerInput" value="{{registerForm.amount}}"/></view>
     <block wx:if="{{registerType==='receipt'}}">
      <view class="fin-form-row"><text class="fin-muted">款项名称</text><input cursor-spacing="24" class="fin-input" data-field="name" bindinput="registerInput" value="{{registerForm.name}}"/></view>
      <view class="fin-form-row"><text class="fin-muted">方式</text><picker range="{{['bank','cash','other']}}" data-field="method" bindchange="registerInput"><view class="fin-input">{{registerForm.method||'bank'}}</view></picker></view>
      <view class="fin-form-row"><text class="fin-muted">流水号（bank 必填）</text><input cursor-spacing="24" class="fin-input" data-field="transactionNo" bindinput="registerInput" value="{{registerForm.transactionNo}}"/></view>
      <view class="fin-form-row"><text class="fin-muted">收款日期</text><picker mode="date" data-field="receivedDate" bindchange="registerInput"><view class="fin-input">{{registerForm.receivedDate||'请选择实际日期'}}</view></picker></view>
      <view class="fin-form-row"><text class="fin-muted">凭证（jpg/png/pdf ≤20MB）</text><button class="fin-text" data-field="voucher" bindtap="registerUpload">{{registerForm.voucherName||'选择文件'}}</button></view>
     </block>
     <block wx:if="{{registerType==='payment'}}"><button class="fin-text" data-type="expense" bindtap="openWorkbenchEntry">没有原业务单？补记零星付款</button>
      <view class="fin-form-row"><text class="fin-muted">关联应付</text><picker range="{{platformRegister.payables}}" range-key="label" data-field="payableId" bindchange="registerPick"><view class="fin-input">{{registerForm.payableIdLabel||'请选择'}}</view></picker></view>
      <view class="fin-form-row"><text>实际付款账户</text><input cursor-spacing="24" class="fin-input" data-field="accountName" bindinput="registerInput" value="{{registerForm.accountName}}"/></view><view wx:if="{{registerForm.allowEmployee}}" class="fin-form-row"><text>付款方式</text><picker range="{{['公司支付','业务个人垫付设计费']}}" data-field="fundingType" bindchange="registerInput"><view class="fin-input">{{registerForm.fundingType==='EMPLOYEE'?'业务个人垫付设计费':'公司支付'}}</view></picker></view>
      <view wx:if="{{registerForm.fundingType==='EMPLOYEE'}}" class="fin-form-row"><text>实际垫付人</text><picker range="{{workbenchStaff}}" range-key="name" data-field="payerUserId" bindchange="registerPick"><view class="fin-input">{{registerForm.payerName||'选择本公司业务人员'}}</view></picker></view>
      <view class="fin-form-row"><text class="fin-muted">付款日期</text><picker mode="date" data-field="payDate" bindchange="registerInput"><view class="fin-input">{{registerForm.payDate||'请选择实际日期'}}</view></picker></view>
      <view class="fin-form-row"><text class="fin-muted">流水号</text><input cursor-spacing="24" class="fin-input" data-field="transactionNo" bindinput="registerInput" value="{{registerForm.transactionNo}}"/></view>
      <view class="fin-form-row"><text class="fin-muted">凭证（jpg/png/pdf ≤20MB）</text><button class="fin-text" data-field="voucher" bindtap="registerUpload">{{registerForm.voucherName||'选择文件'}}</button></view>
     </block>
     <block wx:if="{{registerType==='refund'}}">
      <view class="fin-form-row"><text class="fin-muted">关联收款</text><picker range="{{platformRegister.refundable}}" range-key="label" data-field="receiptId" bindchange="registerPick"><view class="fin-input">{{registerForm.receiptIdLabel||'请选择'}}</view></picker></view>
      <view class="fin-form-row"><text class="fin-muted">退款原因</text><input cursor-spacing="24" class="fin-input" data-field="reason" bindinput="registerInput" value="{{registerForm.reason}}"/></view>
      <view class="fin-form-row"><text class="fin-muted">退款日期</text><picker mode="date" data-field="date" bindchange="registerInput"><view class="fin-input">{{registerForm.date||'请选择日期'}}</view></picker></view>
     </block>
     <block wx:if="{{registerType==='expense-refund'}}"><view class="fin-form-row"><text>实际退回至</text><picker range="{{[registerForm.originalRefundFundingType?'沿用原退回去向':'沿用原出资人','公司账户','原垫付员工']}}" data-field="refundFundingType" bindchange="registerInput"><view class="fin-input">{{registerForm.refundFundingType==='COMPANY'?'公司账户':registerForm.refundFundingType==='EMPLOYEE'?'原垫付员工':'沿用原出资人'}}</view></picker></view>
      <view class="fin-form-row"><text class="fin-muted">关联付款单</text><picker range="{{platformRegister.expenseRefundable}}" range-key="label" data-field="paymentId" bindchange="registerPick"><view class="fin-input">{{registerForm.paymentIdLabel||'请选择'}}</view></picker></view>
      <view class="fin-form-row"><text class="fin-muted">退回原因</text><input cursor-spacing="24" class="fin-input" data-field="reason" bindinput="registerInput" value="{{registerForm.reason}}"/></view>
      <view class="fin-form-row"><text class="fin-muted">退回日期</text><picker mode="date" data-field="date" bindchange="registerInput"><view class="fin-input">{{registerForm.date||'请选择日期'}}</view></picker></view>
      <view class="fin-form-row"><text class="fin-muted">流水号</text><input cursor-spacing="24" class="fin-input" data-field="transactionNo" bindinput="registerInput" value="{{registerForm.transactionNo}}"/></view>
     </block>
     <block wx:if="{{registerType==='payable'}}">
      <view class="fin-form-row"><text class="fin-muted">收款方</text><input cursor-spacing="24" class="fin-input" data-field="recipient" bindinput="registerInput" value="{{registerForm.recipient}}"/></view>
      <view class="fin-form-row"><text class="fin-muted">阶段</text><input cursor-spacing="24" class="fin-input" data-field="stage" bindinput="registerInput" value="{{registerForm.stage}}"/></view>
      <view class="fin-form-row"><text class="fin-muted">协议号</text><input cursor-spacing="24" class="fin-input" data-field="agreementRef" bindinput="registerInput" value="{{registerForm.agreementRef}}"/></view>
     </block>
     <text wx:if="{{registerError}}" class="fin-muted">{{registerError}}</text>
     <button class="fin-primary" bindtap="submitRegister" loading="{{registerBusy}}">{{registerType==='payment'?'登记付款':registerType==='refund'||registerType==='expense-refund'?'登记退款':'提交登记'}}</button>
    </view>
   </block>
  </block>
  <block wx:if="{{flowTab==='reconcile'}}"><include src="./month-reconciliation.wxml"/></block>
   <view wx:if="{{!(platformApiMode&&flowTab==='reconcile')}}" class="fin-filter-row"><picker data-type="status" range="{{statusOptions}}" bindchange="pick"><view class="fin-filter-label">{{statusFilter}}⌄</view></picker><text wx:if="{{flowScope==='all'||flowScope==='current'}}" class="fin-filter-label">{{flowScope==='all'?'累计实收':'本月实收'}}</text><picker wx:else data-type="category" range="{{categoryOptions}}" bindchange="pick"><view class="fin-filter-label">{{category}}⌄</view></picker><picker data-type="sort" range="{{['到期优先','金额优先','最新优先']}}" bindchange="pick"><view class="fin-filter-label">{{sort}}⌄</view></picker></view>
   <view wx:if="{{due||filter==='overdue'}}" class="fin-period"><text>{{due?'仅看未来7天约定到期':'仅看已逾期款项'}}</text><button class="fin-text" bindtap="clear">显示全部</button></view>
   <view class="fin-card" wx:if="{{!(platformApiMode&&flowTab==='ledger')&&!(platformApiMode&&flowTab==='reconcile')}}"><view class="fin-heading"><text class="fin-title">{{flowScope==='all'?'累计有效收款':flowScope==='current'?'本月有效收款':flowTab==='payables'?'应付事项':flowTab==='ledger'?'实际收付流水':flowTab==='reconcile'?'对账留痕':'应收事项'}}</text><text class="fin-muted">{{rows.length}}笔</text></view>
    <view wx:for="{{rows}}" wx:key="id" class="fin-flow-row"><view class="fin-row-top"><view class="fin-grow"><text class="fin-name">{{item.name}}</text><view class="fin-row-heading"><text class="fin-amount">{{item.amountText}}</text><text class="fin-status {{item.tone}}">{{item.status}}</text></view><text class="fin-muted">{{item.subtitle}}</text></view></view><view class="fin-flow-detail"><view class="fin-grow"><text class="fin-muted">{{item.dateText}}</text><text class="fin-muted">{{item.detail}}</text></view><button wx:if="{{item.url}}" class="fin-outline" data-url="{{item.url}}" bindtap="go">{{item.action}}</button><text wx:elif="{{!item.canPay&&flowTab!=='payables'}}" class="fin-muted">历史只读</text></view>
     <view wx:if="{{flowTab==='payables'||item.canPay}}" class="fin-source-actions">
      <button wx:if="{{flowTab==='payables'&&item.canAssign}}" class="fin-text" aria-label="{{item.name}}：归属账本" data-id="{{item.id}}" bindtap="assignPayableBook">归属账本</button>
      <button wx:if="{{flowTab==='payables'&&item.canAdjust}}" class="fin-text" aria-label="{{item.name}}：调整结算" data-id="{{item.id}}" bindtap="openPayableAdjustment">调整结算</button>
      <button wx:if="{{item.canPay}}" class="fin-outline" aria-label="{{item.name}}：登记付款" data-id="{{item.id}}" bindtap="paySourceRow">登记付款</button>
     </view>
    </view>
    <view wx:if="{{!rows.length}}" class="fin-list-empty fin-no-match"><image src="/assets/management-schedule.jpg" mode="aspectFit"/><text>暂无符合条件的{{flowTab==='ledger'?'有效流水':'原单事项'}}</text><button class="fin-text" bindtap="clear">重置筛选</button></view>
   </view>
  </block>

  <block wx:if="{{(view==='projects'&&!platformApiMode)||view==='partners'}}">
   <scroll-view class="fin-filters" scroll-x><view><button wx:for="{{filters}}" wx:key="id" class="fin-chip {{filter===item.id?'selected':''}}" data-filter="{{item.id}}" bindtap="filter">{{item.label}} {{item.count}}</button></view></scroll-view>
   <block wx:if="{{view==='projects'&&!platformApiMode}}"><view wx:for="{{rows}}" wx:key="id" class="fin-card"><text>{{item.name}}</text></view></block>
   <block wx:else><view wx:for="{{rows}}" wx:key="id" class="fin-card"><view class="fin-company-head"><view class="fin-company-name"><image src="/assets/account-shop.jpg" mode="aspectFit"/><text class="fin-name">{{item.name}}</text></view><text class="fin-status {{item.tone}}">{{item.status}}</text></view><view class="fin-pair"><view><text class="fin-muted">{{item.simulatedDesign?'一次性设计费体验模拟':'设计款待确认到账'}}</text><text class="fin-amount">{{item.simulatedDesign?item.simulatedDesignText:item.designText}}</text></view><view><text class="fin-muted">代垫未收回</text><text class="fin-amount">{{item.advanceText}}</text></view></view><view class="fin-flow-detail"><text class="fin-muted">{{item.simulatedDesign?'模拟付款登记完成通知已同步，不产生到账登记待办':item.pending?'门店已付待总部确认 '+item.pendingText:'当前没有待确认到账款项'}}</text><button class="fin-outline" data-url="{{item.url}}" bindtap="go">查看往来</button></view></view></block>
   <view wx:if="{{!rows.length}}" class="fin-card fin-list-empty fin-empty"><image src="/assets/management-schedule.jpg" mode="aspectFit"/><text>暂无符合条件的{{view==='partners'?'加盟商关联往来':'项目账目'}}</text><button class="fin-text" bindtap="clear">重置搜索与筛选</button></view>
  </block>

  <block wx:if="{{view==='project'&&!platformApiMode}}">
   <view class="fin-back-row"><button class="fin-back" bindtap="back"><image src="/assets/creation-back.png"/>项目</button><button class="fin-text" bindtap="home">工作台</button></view>
   <view class="fin-card"><view class="fin-project-top"><image src="/assets/house.png" mode="aspectFit"/><view class="fin-grow"><text class="fin-name">{{detail.name}}</text><text class="fin-muted">项目编号：{{detail.id}}</text></view><text class="fin-status">{{detail.status}}</text></view></view>
   <view wx:if="{{detail.design.length}}" class="fin-card"><view class="fin-heading"><text class="fin-title">设计服务账</text></view><block wx:if="{{detail.simulatedDesign}}"><view class="fin-detail-values"><view><text class="fin-muted">计费总额</text><text class="fin-amount">{{detail.serviceTotalText}}</text></view><view><text class="fin-muted">支付状态</text><text class="fin-amount">{{detail.simulation.status}}</text></view></view><text class="fin-note">{{detail.simulation.pricingText}} · 体验模拟支付记录不计入正式实收实付</text></block><block wx:else><view class="fin-detail-values"><view><text class="fin-muted">约定服务费</text><text class="fin-amount">{{detail.serviceTotalText}}</text></view><view><text class="fin-muted">门店有效已付</text><text class="fin-amount">{{detail.designPaidText}}</text></view><view><text class="fin-muted">{{detail.external?'总部实际到账':'剩余未付'}}</text><text class="fin-amount">{{detail.external?detail.designReceivedText:detail.designRemainingText}}</text></view><view><text class="fin-muted">{{detail.external?'待总部确认':'设计款项状态'}}</text><text class="fin-amount">{{detail.external?detail.pendingText:detail.designRemainingText}}</text></view></view><text class="fin-note">设计服务约定 V{{detail.serviceVersion}} · {{detail.serviceApproved?'老板已批准':'费用待老板审批'}}</text></block></view>
   <view wx:if="{{detail.design.length}}" class="fin-card"><view class="fin-heading"><text class="fin-title">{{detail.simulatedDesign?'一次性设计费支付知会':'设计款项进度'}}</text></view><view wx:for="{{detail.design}}" wx:key="id" class="fin-flow-row"><view class="fin-row-top"><text class="fin-name">{{item.label}}</text><text class="fin-status">{{item.status}}</text></view><block wx:if="{{item.simulated}}"><text class="fin-subtitle">计价 {{item.pricingText}} · 总额 {{item.amountText}}</text><text class="fin-subtitle">{{item.paidText}} · 体验模拟支付记录不计入正式实收实付</text><view class="fin-project-action"><button class="fin-outline" data-url="{{item.url}}" bindtap="go">查看支付知会</button></view></block><block wx:else><text class="fin-subtitle">约定 {{item.amountText}}</text><text class="fin-subtitle">门店有效已付 {{item.paidText}}{{item.external?' · 总部实际到账 '+item.receivedText:''}}</text><view class="fin-project-action"><button class="fin-outline" data-url="{{item.url}}" bindtap="go">查看{{item.external?'到账进度':'付款原单'}}</button></view></block></view><text class="fin-note">{{detail.simulatedDesign?'一次性模拟付款登记完成后，总部设计可继续办理本版成果。':'首尾款足额到账且设计完成后，可继续办理正式图纸下发。'}}</text></view>
   <view class="fin-card"><view class="fin-heading"><text class="fin-title">建造收付与成本</text></view><view wx:if="{{detail.total}}"><view class="fin-pair"><view><text class="fin-muted">建造合同</text><text class="fin-amount">{{detail.contractText}}</text></view><view><text class="fin-muted">合同未收</text><text class="fin-amount">{{detail.remainingText}}</text></view></view><text class="fin-note">有效合同实收 {{detail.receivedText}} · 已发生成本 {{detail.costText}}</text><text class="fin-note">合同预计毛利 {{detail.profitText}}，尚未扣公司日常费用。</text></view><text wx:else class="fin-muted">未签建造合同，暂无建造合同应收。</text><view class="fin-mini-links"><button data-url="{{detail.contractUrl}}" bindtap="go">合同应收与分期</button><button data-url="{{detail.payablesUrl}}" bindtap="go">材料与费用应付</button><button wx:if="{{detail.settlementUrl}}" data-url="{{detail.settlementUrl}}" bindtap="go">项目财务收尾</button></view></view>
   <view wx:if="{{detail.settlement}}" class="fin-card"><view class="fin-heading"><text class="fin-title">项目财务收尾</text><text class="fin-status">{{detail.settlement.label}}</text></view><text class="fin-note">工程资料归档与财务结清分别确认，账目变化后重新核对。</text><button wx:for="{{detail.settlement.blockers}}" wx:key="key" class="fin-link-row" data-url="{{item.url}}" bindtap="go"><text class="fin-muted">{{item.text}}</text><image wx:if="{{item.url}}" class="fin-chevron" src="/assets/creation-chevron-muted.png"/></button><button class="fin-outline" data-url="{{detail.settlement.url}}" bindtap="go">查看财务收尾条件</button></view>
   <view class="fin-card"><button class="fin-link-row" data-url="{{detail.sourceUrl}}" bindtap="go"><text>财务原单与凭证</text><image class="fin-chevron" src="/assets/creation-chevron-muted.png"/></button></view>
  </block>

  <block wx:if="{{view==='partner'}}">
   <view class="fin-back-row"><button class="fin-back" bindtap="back"><image src="/assets/creation-back.png"/>加盟商往来</button><button class="fin-text" bindtap="home">工作台</button></view>
   <view class="fin-card"><view class="fin-heading"><text class="fin-title">{{partner.name}}</text><text class="fin-status {{partner.tone}}">{{partner.status}}</text></view><view class="fin-pair"><view><text class="fin-muted">{{partner.simulatedDesign?'一次性设计费体验模拟':'设计款待确认到账'}}</text><text class="fin-amount">{{partner.simulatedDesign?partner.simulatedDesignText:partner.designText}}</text></view><view><text class="fin-muted">代垫未收回</text><text class="fin-amount">{{partner.advanceText}}</text></view></view><text class="fin-note">{{partner.simulatedDesign?'体验模拟支付记录不计入正式实收实付，不产生总部到账登记待办。':'加盟商登记付款后，总部财务按实际银行到账分笔确认。'}}</text></view>
   <view class="fin-card"><view class="fin-heading"><text class="fin-title">{{partner.simulatedDesign?'一次性设计费支付知会':'设计费用到账进度'}}</text></view><view wx:for="{{partner.design}}" wx:key="id" class="fin-flow-row"><text class="fin-name">{{item.name}}</text><block wx:if="{{item.simulated}}"><text class="fin-subtitle">计价 {{item.pricingText}} · 总额 {{item.amountText}}</text><text class="fin-subtitle">{{item.paidText}} · 不计正式实收实付</text><view class="fin-flow-detail"><text class="fin-amount">{{item.status}}</text><button class="fin-outline" data-url="{{item.url}}" bindtap="go">查看支付知会</button></view></block><block wx:else><text class="fin-subtitle">约定 {{item.amountText}} · 门店有效已付 {{item.paidText}}</text><text class="fin-subtitle">总部实际到账 {{item.receivedText}} · {{item.status}}</text><view class="fin-flow-detail"><text class="fin-amount">待确认 {{item.receiptRemainingText}}</text><button class="fin-outline" data-url="{{item.url}}" bindtap="go">查看到账进度</button></view></block></view><text wx:if="{{!partner.design.length}}" class="fin-muted">暂无已批准的设计费用约定。</text></view>
   <view class="fin-card"><view class="fin-heading"><text class="fin-title">总部材料代垫</text></view><view wx:for="{{partner.material}}" wx:key="id" class="fin-flow-row"><text class="fin-name">{{item.name}}</text><text class="fin-subtitle">总部已垫 {{item.advancedText}} · 门店已还 {{item.repaidText}}</text><text class="fin-subtitle">总部已核收 {{item.receivedText}} · 待核 {{item.pendingText}}</text><view class="fin-flow-detail"><text class="fin-amount">未收回 {{item.remainingText}}</text><button wx:if="{{item.canOpen}}" class="fin-outline" data-url="{{item.url}}" bindtap="go">{{item.action}}</button><text wx:else class="fin-muted">等待门店归还或补证</text></view></view><text wx:if="{{!partner.material.length}}" class="fin-muted">暂无总部实际代垫款项。</text></view>
  </block>

  <block wx:if="{{view==='statement'}}">
   <view class="fin-back-row"><button class="fin-back" bindtap="back"><image src="/assets/creation-back.png"/>{{hq?'加盟商往来':'项目账目'}}</button><button class="fin-text" bindtap="home">工作台</button></view>
   <view class="fin-card"><view class="fin-project-top"><image src="/assets/house.png" mode="aspectFit"/><view class="fin-grow"><text class="fin-name">{{statement.name}}</text><text class="fin-muted">{{statement.companyFrom}} → {{statement.companyTo}}</text><text class="fin-muted">{{statement.label}} · 服务约定 V{{statement.version}}</text></view><text class="fin-status">{{statement.status}}</text></view></view>
   <view class="fin-card"><view class="fin-heading"><text class="fin-title">本期到账进度</text></view><view class="fin-detail-values"><view><text class="fin-muted">本期约定</text><text class="fin-amount">{{statement.amountText}}</text></view><view><text class="fin-muted">门店有效已付</text><text class="fin-amount">{{statement.paidText}}</text></view><view><text class="fin-muted">总部实际到账</text><text class="fin-amount">{{statement.receivedText}}</text></view><view><text class="fin-muted">待确认到账</text><text class="fin-amount">{{statement.receiptRemainingText}}</text></view></view><view wx:if="{{statement.external}}" class="flow-steps"><view wx:for="{{statement.steps}}" wx:key="label" class="flow-step {{item.done?'done':''}}"><text class="flow-step-index">{{index+1}}</text><text>{{item.label}}</text></view></view><text class="fin-note">{{statement.policy}}</text></view>
   <view class="fin-card"><view class="fin-heading"><text class="fin-title">加盟商分笔付款</text></view><view wx:for="{{statement.paymentRecords}}" wx:key="id" class="fin-flow-row"><view class="fin-row-top"><view class="fin-grow"><text class="fin-muted">{{item.date}} · 第{{index+1}}笔</text><text class="fin-amount">{{item.amountText}}</text></view><text class="fin-status">{{item.status}}</text></view><view class="fin-flow-detail"><text class="fin-muted">{{item.transaction?'原流水 '+item.transaction:'付款凭据仅付款组织可见'}}</text><button wx:if="{{item.url}}" class="fin-outline" data-url="{{item.url}}" bindtap="go">{{item.action}}</button></view></view><view wx:if="{{!statement.paymentRecords.length}}" class="fin-empty">尚未登记本期付款。</view></view>
   <view class="fin-card"><view class="fin-heading"><text class="fin-title">总部分笔到账</text></view><view wx:for="{{statement.receiptRecords}}" wx:key="id" class="fin-flow-row"><view class="fin-row-top"><view class="fin-grow"><text class="fin-muted">{{item.date}} · 第{{index+1}}笔</text><text class="fin-amount">{{item.amountText}}</text></view><text class="fin-status">{{item.status}}</text></view><view class="fin-flow-detail"><text class="fin-muted">到账流水 {{item.transaction}}</text><button wx:if="{{item.url}}" class="fin-outline" data-url="{{item.url}}" bindtap="go">{{item.action}}</button><text wx:else class="fin-muted">历史只读</text></view></view><view wx:if="{{!statement.receiptRecords.length}}" class="fin-empty">总部尚未确认本期实际到账。</view><text class="fin-note">{{statement.notice}}</text></view>
   <view class="fin-actions"><button wx:if="{{statement.evidenceUrl}}" class="fin-outline" data-url="{{statement.evidenceUrl}}" bindtap="go">索取原单凭证</button><button wx:if="{{statement.primary}}" class="fin-primary" data-url="{{statement.primary.url}}" bindtap="go">{{statement.primary.label}}</button></view>
  </block>

  <block wx:if="{{view==='tasks'}}"><view class="fin-card"><view class="fin-heading"><text class="fin-title">今日待办</text><text class="fin-muted">{{rows.length}}笔</text></view><todo-preview id="today-todos" rows="{{rows}}" scope="{{platformTodos.sessionGen+':'+platformTodos.postKey}}" bind:activate="openFinanceTask"/><view wx:if="{{platformTodos.refreshError}}"><text class="fin-muted">待办更新失败：{{platformTodos.refreshError}}</text><button class="fin-text" bindtap="refreshFinanceTasks">重试</button></view><view wx:if="{{!rows.length}}" class="fin-list-empty fin-empty"><image src="/assets/management-schedule.jpg" mode="aspectFit"/><text>今日暂无待办</text><text class="fin-muted">可返回收支或项目查看原记录。</text></view></view><button class="fin-primary" bindtap="home">返回工作台</button></block>
 </block>
 </block>
 <view wx:else class="fin-card"><text class="fin-error">{{error||'正在读取本组织财务数据'}}</text><button class="fin-primary" bindtap="home">返回本人工作台</button></view>
 </view>
 </block>
 <workspace-nav wx:if="{{!financeKeyboardOpen}}" id="finance-desk-nav" active-index="{{view==='profile'?4:view==='desk'||view==='tasks'?16:17}}" nested/>
</view>
