<import src="./project-books.wxml"/>
<template name="workbench">
 <view wx:if="{{!wbForm&&!registerType&&collectionDeclarations.length&&(view==='flows'||view==='reimbursements')}}" class="fin-card"><text class="fin-title">业主到账待核实</text><view wx:for="{{collectionDeclarations}}" wx:key="id" class="fin-flow-row"><text>合同 {{item.contract_id}} · {{item.stage}}</text><text class="fin-amount">¥{{item.amount}}</text><text class="fin-muted">{{item.received_date}} · {{item.transaction_no}}</text><button class="fin-outline" disabled="{{wbBusy}}" data-id="{{item.id}}" bindtap="openJourneyDeclaration">核实实际到账</button><button class="fin-text" data-id="{{item.id}}" bindtap="returnCollectionDeclaration">退回补充</button></view></view>
 <view wx:if="{{view==='flows'&&!wbForm&&!registerType&&financialStages.length}}" class="fin-card"><text class="fin-title">合同应收及尾款</text><view wx:for="{{financialStages}}" wx:key="id" class="fin-flow-row"><text>{{item.label}}</text><button class="fin-text" data-id="{{item.contract_id}}" bindtap="openContractChange">登记已确认的合同变更</button><button class="fin-text" data-id="{{item.id}}" bindtap="openReceiptAllocation">抵扣已有定金／预收款</button></view></view>
 <template wx:if="{{view==='book'}}" is="projectBook" data="{{wbForm,bookName,bookNet,bookCost,bookAccounting,bookAccountingUrl,bookScope,bookSummary,bookEntries,bookResult,bookEmployeeRows,bookFlowTab,bookEntryDetail,canLinkBook,bookLoading,bookError,bookCollectionUrl,bookMaterialsUrl,bookExpensesUrl}}"/>
 <view wx:if="{{view==='reimbursements'}}" class="fin-card">
  <text class="fin-title">报销办理</text><text wx:if="{{workbenchError}}" class="fin-error">{{workbenchError}}</text>
  <view wx:for="{{reimbursementRows}}" wx:key="id" class="fin-flow-row"><text class="fin-name">{{item.payer_name}} · {{item.stage}}</text><text class="fin-muted">{{item.pay_date}} · 已报销 ¥{{item.paidText}}</text><text class="fin-amount">{{item.remaining<0?'员工应归还':'尚待报销'}} ¥{{item.remaining<0?item.absoluteAmount:item.amount}}</text><button wx:if="{{item.remaining>0}}" class="fin-outline" data-id="{{item.id}}" bindtap="reimburseEmployee">办理报销</button><button wx:if="{{item.remaining<0}}" class="fin-outline" data-id="{{item.id}}" bindtap="recoverEmployee">登记员工归还</button><text wx:if="{{item.remaining===0}}" class="fin-muted">已结清</text></view>
  <text wx:if="{{!reimbursementRows.length&&!workbenchError}}" class="fin-muted">暂无员工垫付记录</text>
 </view>
 <view wx:if="{{wbForm}}" class="fin-card book-form">
  <view wx:if="{{!compactHeader}}" class="fin-heading"><text class="fin-title">{{wbForm.type==='book'?'新建账本':wbForm.type==='receipt'?'登记收款':wbForm.type==='payable'?'登记应付':wbForm.type==='contractchange'?'合同变更':wbForm.type==='payablechange'?'结算调整':wbForm.type==='allocation'?'抵扣定金':wbForm.type==='linkbook'?'关联工程':wbForm.type==='assignbook'?'账本归属':wbForm.type==='supplement'?'补充资料':wbForm.type==='recovery'?'登记员工归还':'登记付款'}}</text><button class="fin-text" bindtap="cancelWorkbench" disabled="{{wbBusy||paymentPending}}">取消</button></view>
  <view wx:if="{{wbForm.type==='book'||wbForm.type==='receipt'||wbForm.type==='expense'||wbForm.type==='payable'}}" class="fin-form-row"><text>事项名称</text><input cursor-spacing="24" class="fin-input" data-field="name" value="{{wbForm.name}}" bindinput="wbInput" maxlength="160" disabled="{{wbBusy||paymentPending}}"/></view>
  <block wx:if="{{wbForm.type==='book'||wbForm.type==='linkbook'}}">
   <text class="fin-muted">前期项目账按来源客户接续工程；已登记收付保留原单。</text>
   <view wx:if="{{!wbForm.sourceCustomerLocked}}" class="fin-form-row"><text>查找来源客户</text><input cursor-spacing="24" class="fin-input" placeholder="客户姓名或手机号" data-field="sourceKeyword" value="{{wbForm.sourceKeyword}}" bindinput="wbInput" bindconfirm="searchBookSources" disabled="{{wbBusy||paymentPending}}"/><button class="fin-text" bindtap="searchBookSources" disabled="{{wbBusy||wbForm.sourceLoading||paymentPending}}">查询</button></view>
   <view class="fin-form-row"><text>来源客户</text><text wx:if="{{wbForm.sourceCustomerLocked}}" class="fin-input">{{wbForm.customerLabel||'正在核对原来源客户…'}}</text><picker wx:else range="{{wbForm.sourceOptions}}" range-key="label" data-field="customerId" bindchange="pickBookSource" disabled="{{wbBusy||wbForm.sourceLoading||wbForm.sourceFailed||paymentPending}}"><view class="fin-input">{{wbForm.customerLabel||'选择实际来源客户'}}</view></picker></view>
   <text wx:if="{{wbForm.sourceLoading}}" class="fin-muted">正在加载来源客户…</text><text wx:elif="{{wbForm.sourceHasMore}}" class="fin-muted">客户较多，请按姓名或手机号缩小查询范围。</text><text wx:elif="{{!wbForm.sourceOptions.length&&!wbForm.sourceFailed}}" class="fin-muted">未找到客户，请核对姓名、手机号和当前公司。</text>
   <button wx:if="{{wbForm.sourceFailed}}" class="fin-text" bindtap="searchBookSources" disabled="{{wbBusy||paymentPending}}">重新加载来源客户</button>
   <view wx:if="{{wbForm.customerId&&(wbForm.availableCommissionId||wbForm.commissionId)}}" class="fin-form-row"><text>设计委托来源（选填）</text><text wx:if="{{wbForm.sourceCommissionLocked}}" class="fin-input">原设计委托 {{wbForm.commissionId}}</text><picker wx:else range="{{['仅按来源客户','属于该客户设计委托']}}" data-field="commissionId" value="{{wbForm.commissionId?1:0}}" bindchange="pickBookSource" disabled="{{wbBusy||wbForm.sourceLoading||wbForm.sourceFailed||paymentPending}}"><view class="fin-input">{{wbForm.commissionId?'该客户设计委托 '+wbForm.commissionId:'仅按来源客户'}}</view></picker></view>
   <text wx:if="{{wbForm.type==='book'}}" class="fin-muted">来源只能对应一个工程时自动接续；存在多个工程时，请在账本内明确关联原工程。</text>
  </block>
  <block wx:if="{{wbForm.type==='allocation'}}">
   <view class="fin-form-row"><text>抵扣期次</text><text class="fin-input">{{wbForm.stageLabel}} · 待收 ¥{{wbForm.stageRemainingText}}</text></view>
   <view class="fin-form-row"><text>关联原实际收款</text>
    <picker wx:if="{{allocationReceipts.length}}" range="{{allocationReceipts}}" range-key="label" data-field="receiptId" bindchange="wbPick" disabled="{{wbBusy||paymentPending||allocationReceiptsLoading}}"><view class="fin-input">{{wbForm.receiptLabel||'选择原收款'}}</view></picker>
    <text wx:elif="{{allocationReceiptsLoading}}" class="fin-muted">正在核对当前合同可抵扣的收款…</text>
    <text wx:elif="{{allocationReceiptsError}}" class="fin-error">{{allocationReceiptsError}}</text>
    <text wx:elif="{{allocationReceiptHint}}" class="fin-muted">{{allocationReceiptHint}}</text>
    <text wx:else class="fin-muted">当前没有可抵扣的原收款</text>
   </view>
   <button wx:if="{{allocationReceiptsError}}" class="fin-text" bindtap="loadAllocationCandidates" disabled="{{wbBusy||paymentPending}}">重新加载候选收款</button>
   <text class="fin-muted">仅显示当前合同归属可用的未分配手工收款；标记“未关联客户”的收款请先核对原始凭证。</text>
  </block>
  <block wx:if="{{wbForm.type==='contractchange'}}"><button class="fin-outline" data-id="{{wbForm.contractId}}" bindtap="openContractChange" disabled="{{wbBusy||paymentPending}}">打开付款计划</button></block>
  <block wx:if="{{wbForm.type==='payablechange'}}"><view class="fin-form-row"><text>调整后的结算总额（元）</text><input cursor-spacing="24" class="fin-input" type="digit" data-field="amount" value="{{wbForm.amount}}" bindinput="wbInput" disabled="{{wbBusy||paymentPending}}"/></view><picker mode="date" data-field="dueDate" bindchange="wbInput" disabled="{{wbBusy||paymentPending}}"><view class="fin-input">{{wbForm.dueDate||'约定付款日（选填）'}}</view></picker></block>
  <view wx:if="{{wbForm.type==='contractchange'||wbForm.type==='payablechange'||wbForm.type==='assignbook'||wbForm.type==='supplement'}}" class="fin-form-row"><text>{{wbForm.type==='supplement'?'补充说明':wbForm.type==='assignbook'?'归属说明':'变更依据'}}</text><input cursor-spacing="24" class="fin-input" data-field="reason" value="{{wbForm.reason}}" bindinput="wbInput" disabled="{{wbBusy||paymentPending}}"/></view>
  <view wx:if="{{wbForm.type==='linkbook'}}" class="fin-form-row"><text>原工程</text><picker range="{{wbForm.projectChoices}}" range-key="name" data-field="scope" bindchange="wbPick" disabled="{{wbBusy||wbForm.sourceLoading||wbForm.sourceFailed||paymentPending}}"><view class="fin-input">{{wbForm.scopeLabel||'明确选择该客户的原工程'}}</view></picker><text wx:if="{{wbForm.customerId&&!wbForm.projectChoices.length}}" class="fin-muted">当前没有可接续的原工程，请核对来源和工程建档情况。</text><text wx:elif="{{wbForm.projectChoices.length>1}}" class="fin-muted">该客户有多个工程，请按原事项选择，避免串账。</text></view>
  <view wx:if="{{wbForm.type==='assignbook'}}" class="fin-form-row"><text>关联工程</text><picker range="{{workbenchBooks}}" range-key="name" data-field="scope" bindchange="wbPick" disabled="{{wbBusy||paymentPending}}"><view class="fin-input">{{wbForm.scopeLabel||'选择已有工程项目'}}</view></picker></view>
  <block wx:if="{{wbForm.type==='receipt'||wbForm.type==='expense'||wbForm.type==='payable'||wbForm.type==='recovery'}}">
   <view wx:if="{{wbForm.type==='receipt'}}" class="fin-form-row"><text>合同收款（选填）</text><picker range="{{financialStages}}" range-key="label" data-field="stageId" bindchange="wbPick" disabled="{{wbBusy||paymentPending}}"><view class="fin-input">{{wbForm.stageLabel||'选择合同期次'}}</view></picker></view><view wx:if="{{!wbForm.stageId&&wbForm.type!=='recovery'}}" class="fin-form-row"><text>账本归属</text><picker range="{{workbenchBooks}}" range-key="name" data-field="scope" bindchange="wbPick" disabled="{{wbBusy||paymentPending}}"><view class="fin-input">{{wbForm.scopeLabel||'选择账本'}}</view></picker></view>
   <view wx:if="{{wbForm.type!=='recovery'}}" class="fin-form-row"><text>分类</text><input cursor-spacing="24" class="fin-input" data-field="category" value="{{wbForm.category}}" bindinput="wbInput" disabled="{{wbBusy||paymentPending}}"/></view>
   <view class="fin-form-row"><text>金额（元）</text><input cursor-spacing="24" class="fin-input" type="digit" data-field="amount" value="{{wbForm.amount}}" bindinput="wbInput" disabled="{{wbBusy||paymentPending}}"/></view>
   <view class="fin-form-row"><text>实际日期</text><picker mode="date" data-field="date" value="{{wbForm.date}}" bindchange="wbInput" disabled="{{wbBusy||paymentPending}}"><view class="fin-input">{{wbForm.date}}</view></picker></view>
   <block wx:if="{{wbForm.type==='expense'}}"><view class="fin-form-row"><text>付款方式</text><picker range="{{['公司支付','员工垫付']}}" data-field="fundingType" bindchange="wbInput" disabled="{{wbBusy||paymentPending}}"><view class="fin-input">{{wbForm.fundingType==='EMPLOYEE'?'员工已垫付':'公司支付'}}</view></picker></view><view wx:if="{{wbForm.fundingType==='EMPLOYEE'}}" class="fin-form-row"><text>实际垫付人</text><picker range="{{workbenchStaff}}" range-key="name" data-field="payerUserId" bindchange="wbPick" disabled="{{wbBusy||paymentPending}}"><view class="fin-input">{{wbForm.payerUserIdLabel||'选择实际垫付人'}}</view></picker></view></block><view wx:if="{{wbForm.type!=='recovery'}}" class="fin-form-row"><text>对方</text><input cursor-spacing="24" class="fin-input" data-field="counterparty" value="{{wbForm.counterparty}}" bindinput="wbInput" disabled="{{wbBusy||paymentPending}}"/></view>
   <view class="fin-form-row"><text>收付账户</text><input cursor-spacing="24" class="fin-input" placeholder="如：公司银行账户、公司微信、现金" data-field="accountName" value="{{wbForm.accountName}}" bindinput="wbInput" disabled="{{wbBusy||paymentPending}}"/></view>
   <view class="fin-form-row"><text>流水号（选填）</text><input cursor-spacing="24" class="fin-input" data-field="transactionNo" value="{{wbForm.transactionNo}}" bindinput="wbInput" disabled="{{wbBusy||paymentPending}}"/></view>
   <button class="fin-text" bindtap="wbVoucher" disabled="{{wbBusy||paymentPending}}">{{wbForm.voucherName||'添加凭据'}}</button>
  </block>
  <button wx:if="{{wbForm.type==='supplement'}}" class="fin-text" bindtap="wbVoucher" disabled="{{wbBusy||paymentPending}}">{{wbForm.voucherName||'选择补充凭据'}}</button><text wx:if="{{wbError}}" class="fin-error">{{wbError}}</text><button class="fin-primary" bindtap="submitWorkbench" loading="{{wbBusy}}" disabled="{{wbBusy||paymentPending}}">{{wbForm.type==='payment'||wbForm.type==='expense'?'登记付款':'保存登记'}}</button>
 </view>
</template>
