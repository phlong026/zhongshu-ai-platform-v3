<template name="projectBooks">
 <view class="book-list-heading"><text class="book-page-title">我的账本</text><button class="fin-text" bindtap="createFinanceBook">新建账本</button></view>
 <view class="fin-search book-search"><image src="/assets/search.png" mode="aspectFit"/><input cursor-spacing="24" value="{{keyword}}" bindinput="search" placeholder="搜索项目或账本" maxlength="80"/><button wx:if="{{keyword}}" class="fin-text" bindtap="clear">清空</button></view>
 <view class="book-tabs"><button class="book-tab {{!bookListTab||bookListTab==='all'?'selected':''}}" data-tab="all" bindtap="changeBookListTab"><text class="book-tab-label">全部</text></button><button class="book-tab {{bookListTab==='project'?'selected':''}}" data-tab="project" bindtap="changeBookListTab"><text class="book-tab-label">项目</text></button><button class="book-tab {{bookListTab==='book'?'selected':''}}" data-tab="book" bindtap="changeBookListTab"><text class="book-tab-label">前期客户</text></button><button class="book-tab {{bookListTab==='company'?'selected':''}}" data-tab="company" bindtap="changeBookListTab"><text class="book-tab-label">公司日常</text></button></view>
 <view class="fin-refresh-status" bindtap="loadFinanceProjects">{{financeProjectLoading?'更新中…':financeProjectError?'更新失败，点此重试':''}}</view>
 <button wx:for="{{financeProjects}}" wx:key="id" class="fin-card book-list-item" data-url="{{item.url}}" bindtap="go"><image class="book-list-icon" src="{{item.kind==='项目账本'?'/assets/house.png':'/assets/book.png'}}" mode="aspectFit"/><view class="book-list-main"><text class="book-list-name">{{item.name}}</text><text class="book-list-meta">{{item.kind}}</text></view><text wx:if="{{item.statusText!==item.kind}}" class="book-list-state">{{item.statusText}}</text><image class="book-chevron" src="/assets/creation-chevron-muted.png"/></button>
 <view wx:if="{{!financeProjects.length&&!financeProjectLoading&&!financeProjectError}}" class="fin-card book-empty"><image src="/assets/book.png" mode="aspectFit"/><text>暂无账本</text><button class="fin-text" bindtap="createFinanceBook">新建账本</button></view>
</template>
<template name="projectBook">
 <view wx:if="{{!wbForm}}">
  <view class="book-detail-heading"><view class="book-list-main"><text class="book-page-title">{{bookName||'项目账本'}}</text><text class="book-list-meta">累计收支</text></view><button wx:if="{{canLinkBook}}" class="fin-text" bindtap="linkFinanceBook">关联工程</button></view>
  <view class="fin-refresh-status" bindtap="loadBookLedger">{{bookLoading?'更新中…':bookError?'更新失败，点此重试':''}}</view>
  <block wx:if="{{bookResult}}">
   <view class="fin-card book-overview"><view class="book-balance-heading"><text class="book-balance-label">现金结余</text><button class="fin-text" bindtap="showBookCalculation">口径</button></view><view class="book-balance"><text class="book-currency">¥</text><text>{{bookNet}}</text></view><view class="book-metrics"><view wx:for="{{bookSummary}}" wx:key="key" class="book-metric"><text class="book-metric-label">{{item.label}}</text><text class="book-metric-value"><text class="book-currency">¥</text>{{item.value}}</text></view></view><view class="book-cost-total"><text>{{bookScope==='company'?'日常费用':'项目费用'}}</text><text>¥ {{bookCost}}</text></view></view>
   <view wx:if="{{bookAccountingUrl}}" class="fin-card book-accounting"><view class="book-detail-heading"><text class="book-page-title">项目核算</text><button class="fin-text" data-url="{{bookAccountingUrl}}" bindtap="go">核算与确认记录 ›</button></view><block wx:if="{{bookAccounting}}"><view class="book-cost-total"><text>按已确认费用计算的毛利</text><text>¥ {{bookAccounting.profitText}}</text></view><text class="fin-muted">{{bookAccounting.stateText}} · 合同金额减已确认项目费用</text></block><text wx:else class="fin-muted">查看合同收入、项目费用及核算确认版本</text></view>
   <view class="book-entry-actions {{bookScope==='company'||canLinkBook?'book-entry-actions-standalone':''}}"><button class="fin-primary" data-type="receipt" bindtap="openWorkbenchEntry">登记收款</button><button class="fin-outline" data-type="payment" bindtap="openRegister">登记付款</button></view>
   <view wx:if="{{bookScope!=='company'&&!canLinkBook}}" class="book-business-actions"><button class="fin-text" data-url="{{bookCollectionUrl}}" bindtap="go">合同回款</button><button class="fin-text" data-url="{{bookMaterialsUrl}}" bindtap="go">材料采购</button><button class="fin-text" data-url="{{bookExpensesUrl}}" bindtap="go">工程费用</button></view>
   <view class="fin-card book-transactions"><view class="book-tabs"><button class="book-tab {{bookFlowTab==='cash'?'selected':''}}" data-tab="cash" bindtap="changeBookFlowTab"><text class="book-tab-label">收支流水</text></button><button class="book-tab {{bookFlowTab==='cost'?'selected':''}}" data-tab="cost" bindtap="changeBookFlowTab"><text class="book-tab-label">费用明细</text></button><button class="book-tab {{bookFlowTab==='employee'?'selected':''}}" data-tab="employee" bindtap="changeBookFlowTab"><text class="book-tab-label">员工往来</text></button></view>
    <button wx:if="{{bookFlowTab!=='employee'}}" wx:for="{{bookEntries}}" wx:key="key" class="book-transaction" data-key="{{item.key}}" bindtap="openBookEntry"><view class="book-transaction-main"><text class="book-transaction-name">{{item.name}}</text><text class="book-transaction-meta">{{item.date||(item.type==='PAYABLE'?'':'日期待核')}}<text wx:if="{{item.counterparty}}">{{item.date?' · ':''}}{{item.counterparty}}</text></text></view><view class="book-transaction-right"><text class="book-transaction-amount {{item.tone}}">{{item.sign}}{{item.amount}}</text><image class="book-chevron" src="/assets/creation-chevron-muted.png"/></view></button>
    <view wx:if="{{bookFlowTab==='employee'&&bookResult.employeeScopeIncomplete}}" class="book-empty"><text>当前仅显示近期流水关联的员工往来，较早记录可能未列出。</text></view>
    <view wx:if="{{bookFlowTab==='employee'}}" wx:for="{{bookEmployeeRows}}" wx:key="id" class="book-employee-row"><view class="fin-heading"><text class="book-transaction-name">{{item.payer_name}}</text><text class="book-employee-state">{{item.remaining>0?'待报销':item.remaining<0?'待归还':'已结清'}}</text></view><text class="book-transaction-meta">{{item.stage}} · {{item.pay_date}}</text><view class="book-employee-total"><text>{{item.remaining<0?'员工应归还':'待报销'}}</text><text>¥ {{item.remainingText}}</text></view><text class="book-transaction-meta">垫付 ¥{{item.eligibleText}} · 已报销 ¥{{item.paidText}}</text><button wx:if="{{item.remaining>0}}" class="fin-outline" data-id="{{item.id}}" bindtap="reimburseEmployee">办理报销</button><button wx:if="{{item.remaining<0}}" class="fin-outline" data-id="{{item.id}}" bindtap="recoverEmployee">登记归还</button><button wx:if="{{journeyEnabled}}" class="fin-text" data-id="{{item.id}}" bindtap="openEmployeeAdvance">垫付明细</button></view>
    <view wx:if="{{bookFlowTab==='employee'?!bookEmployeeRows.length:!bookEntries.length}}" class="book-empty"><text>暂无{{bookFlowTab==='cost'?'费用记录':bookFlowTab==='employee'?(bookResult.employeeScopeIncomplete?'可显示的近期员工往来':'员工往来'):'收支记录'}}</text></view>
    <text wx:if="{{bookResult.truncated}}" class="fin-muted">已展示最近500笔，可在电脑端查看完整记录</text>
   </view>
  </block>
 </view>
 <template is="bookEntryDetail" data="{{bookEntryDetail,journeyEnabled}}"/>
</template>
<template name="readonlyProjectBook">
 <view wx:if="{{id&&!ledgerProjectError}}" class="book-business-actions"><button class="fin-text" bindtap="openProjectAccounting">项目核算与结项确认 ›</button></view>
 <view class="book-detail-heading"><text class="book-page-title">{{projectBookName||'项目账本'}}</text></view>
 <view class="fin-card book-overview"><text class="book-balance-label">现金结余</text><view class="book-balance"><text class="book-currency">¥</text><text>{{projectBookNet}}</text></view><view class="book-metrics"><view wx:for="{{projectLedgerSummary}}" wx:key="key" class="book-metric"><text class="book-metric-label">{{item.label}}</text><text class="book-metric-value"><text class="book-currency">¥</text>{{item.value}}</text></view></view></view>
 <view wx:if="{{!projectLedgerReadOnly&&!ledgerProjectError}}" class="book-business-actions"><button class="fin-text" data-url="/pages/build/record/index?id={{id}}&view=collection" bindtap="go">合同回款</button><button class="fin-text" data-url="/pages/build/record/index?id={{id}}&view=materials" bindtap="go">材料采购</button><button class="fin-text" data-url="/pages/build/record/index?id={{id}}&view=expenses" bindtap="go">工程费用</button></view>
 <view class="fin-card book-transactions"><view class="fin-heading"><text class="fin-title">账目明细</text><text class="fin-muted">{{projectLedgerTotal}}笔</text></view><text wx:if="{{ledgerProjectLoading}}" class="fin-muted">正在加载…</text><text wx:if="{{ledgerProjectError}}" class="fin-error">{{ledgerProjectError}}</text><view wx:for="{{projectLedgerEntries}}" wx:key="key" class="book-transaction"><view class="book-transaction-main"><text class="book-transaction-name">{{item.typeLabel}}</text><text class="book-transaction-meta">{{item.dateText||'日期待核'}}{{item.type==='PAYABLE'&&item.status==='已结清'?' · 已结清':''}}</text></view><text class="book-transaction-amount {{item.tone}}">{{item.sign}}{{item.amountText}}</text></view><button wx:if="{{projectLedgerEntries.length<projectLedgerTotal}}" class="fin-text" bindtap="moreProjectLedger">加载更多</button></view>
</template>

<template name="bookEntryDetail">
 <view wx:if="{{bookEntryDetail}}" class="book-detail-overlay"><view class="book-detail-mask" bindtap="closeBookEntry"/><view class="book-detail-sheet"><view class="fin-heading"><text class="fin-title">{{bookEntryDetail.label}}详情</text><button class="fin-text" bindtap="closeBookEntry">关闭</button></view><scroll-view scroll-y class="book-detail-scroll"><text class="book-detail-amount {{bookEntryDetail.tone}}">{{bookEntryDetail.sign}}¥{{bookEntryDetail.amount}}</text><text class="book-detail-name">{{bookEntryDetail.name}}</text><view class="book-info-row"><text>日期</text><text>{{bookEntryDetail.date||'待补充'}}</text></view><view class="book-info-row"><text>对方</text><text>{{bookEntryDetail.counterparty||'未填写'}}</text></view><view class="book-info-row"><text>分类</text><text>{{bookEntryDetail.sourceLabel}}</text></view><view class="book-info-row"><text>账户</text><text>{{bookEntryDetail.account_name||'未填写'}}</text></view><view class="book-info-row"><text>状态</text><text>{{bookEntryDetail.statusText}}</text></view><view wx:if="{{bookEntryDetail.transaction_no}}" class="book-info-row"><text>流水号</text><text selectable>{{bookEntryDetail.transaction_no}}</text></view><view wx:if="{{bookEntryDetail.note}}" class="book-info-row"><text>备注</text><text>{{bookEntryDetail.note}}</text></view><view class="book-info-row"><text>记录编号</text><text selectable>{{bookEntryDetail.id}}</text></view><view wx:if="{{journeyEnabled}}"><button wx:if="{{bookEntryDetail.canRefund}}" class="fin-outline" bindtap="refundBookEntry">{{bookEntryDetail.type==='RECEIPT'?'登记退款':'登记退款（支出退回）'}}</button><button wx:if="{{bookEntryDetail.canRevise}}" class="fin-text" data-id="{{bookEntryDetail.key}}" bindtap="openRevision">修订金额</button><button wx:if="{{bookEntryDetail.canVoid}}" class="fin-text" data-id="{{bookEntryDetail.key}}" bindtap="openPaymentVoid">撤销付款登记</button><button wx:if="{{bookEntryDetail.canCorrect}}" class="fin-text" data-id="{{bookEntryDetail.key}}" bindtap="openCorrection">作废重登</button></view><button wx:if="{{bookEntryDetail.voucher_file_id}}" class="fin-outline" bindtap="openBookVoucher">查看凭据</button><button wx:if="{{bookEntryDetail.type!=='PAYABLE'}}" class="fin-text" data-id="{{bookEntryDetail.id}}" data-kind="{{bookEntryDetail.type==='RECEIPT'?'receipt':bookEntryDetail.type==='PAYMENT'||bookEntryDetail.type==='ADVANCE'?'payment':'refund'}}" bindtap="openFinanceSupplement">补充说明或凭据</button></scroll-view></view></view>
</template>
