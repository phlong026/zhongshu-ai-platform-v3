<template name="financeHome">
<view class="wb-root fin-page fin-home"><brand-header branded divider account-font title="{{desk.title||'财务工作台'}}"/>
 <view class="fin-content wb-content">
  <view class="fin-home-intro wb-greeting"><view><text class="fin-home-greeting">你好，{{desk.name}}</text></view><month-select wx:if="{{desk.hq}}" id="finance-month" class="fin-month-control" value="{{desk.period}}" bind:change="financeMonth"/></view>
<view class="fin-refresh-status" bindtap="retryPlatformFinance">{{financeRefreshing?'更新中…':platformFinance.message?'更新失败，点此重试':''}}</view>
<home-overview id="role-overview" wx:if="{{!desk.hq}}" role="finance" period="{{desk.period}}" bind:monthchange="financeMonth"/><view wx:else class="fin-card fin-home-summary"><view class="fin-home-metrics"><button wx:for="{{desk.metrics}}" wx:key="label" class="fin-home-metric {{item.tone}}" data-url="{{item.url}}" bindtap="go"><text>{{item.label}}</text><text>{{platformFinance&&!item.taskMetric?'¥':''}}{{item.value}}</text></button></view></view>
  <view class="fin-card fin-home-list home-todo-shell">
   <text wx:if="{{platformTodos.warning}}" class="fin-muted">{{platformTodos.warning}}</text><text wx:if="{{platformTodos.status==='loading'}}" class="fin-muted">待办加载中…</text><view wx:if="{{platformTodos.status==='degraded'||platformTodos.status==='partial-empty'}}"><text class="fin-muted">{{platformTodos.message||'待办暂时无法完整加载'}}</text><button class="fin-text" bindtap="refreshFinanceTasks">重新加载</button></view>
   <todo-preview wx:if="{{desk.tasks.length||platformTodos.status==='ready'||platformTodos.status==='partial'}}" appearance="home" id="today-todos" rows="{{desk.tasks}}" scope="{{platformTodos.sessionGen+':'+platformTodos.postKey}}" bind:activate="openFinanceTask"/>
   <view wx:if="{{platformTodos.refreshError}}"><text class="fin-muted">待办更新失败：{{platformTodos.refreshError}}</text><button class="fin-text" bindtap="refreshFinanceTasks">重试</button></view>
  </view>
  <view class="fin-card fin-home-shortcuts wb-tools"><view class="fin-heading"><text class="fin-title">常用办理</text></view><view class="fin-shortcuts {{desk.hq?'fin-shortcuts-three':''}}"><button class="fin-shortcut" wx:for="{{desk.shortcuts}}" wx:key="label" data-type="{{item.type}}" data-url="{{item.url}}" bindtap="openFinanceShortcut"><image src="{{item.icon}}" mode="aspectFit"/><text>{{item.label}}</text></button></view></view>
  <view class="fin-card fin-home-list fin-home-progress"><view class="fin-heading"><text class="fin-title">正在办理</text><button class="fin-text" data-url="{{desk.focusUrl}}" bindtap="go">查看全部<image class="fin-chevron" src="/assets/creation-chevron-muted.png"/></button></view><button wx:for="{{desk.focus}}" wx:key="id" class="fin-link-row" data-key="{{item.id}}" data-url="{{item.url}}" bindtap="openFinanceTask"><view class="fin-grow"><text class="fin-name">{{item.name}}</text><text class="fin-muted">{{item.status}} · {{item.amount}}</text></view><image class="fin-chevron" src="/assets/creation-chevron-muted.png"/></button><view wx:if="{{!desk.focus.length}}" class="fin-empty fin-home-empty"><image src="/assets/house.png" mode="aspectFit"/><text>暂无进行中事项</text></view></view>
 </view>
</view>
</template>
