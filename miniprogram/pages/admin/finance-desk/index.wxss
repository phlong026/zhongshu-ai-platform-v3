@import '../../../styles/finance-desk.wxss';

.fin-content{padding-top:20rpx}.fin-desk-tools{margin-bottom:20rpx}.fin-desk-tools .fin-search{margin:0 0 12rpx}.fin-desk-context{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:0 6rpx 14rpx;color:var(--zs-text-3);font-size:var(--zs-font-meta);line-height:36rpx}.fin-desk-period{color:var(--zs-brand);min-height:52rpx;display:flex;align-items:center}.fin-desk-tools .fin-segments{margin-bottom:0}.fin-card{box-shadow:none}.fin-filter-row picker{border:1rpx solid #e6dfd5;border-radius:12rpx}.fin-flow-row{padding:23rpx 0}.fin-flow-detail{align-items:flex-end}.fin-list-empty>image{width:76rpx;height:76rpx;border-radius:18rpx;margin-bottom:4rpx;opacity:.8}.fin-list-empty>text{display:block}
