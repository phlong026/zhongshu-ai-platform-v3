@import '../../../styles/finance-desk.wxss';

.fin-content{padding-top:20rpx}.fin-desk-tools{margin-bottom:20rpx}.fin-desk-tools .fin-search{margin:0 0 12rpx}.fin-desk-context{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:0 6rpx 14rpx;color:var(--zs-text-3);font-size:var(--zs-font-meta);line-height:36rpx}.fin-desk-period{color:var(--zs-brand);min-height:52rpx;display:flex;align-items:center}.fin-desk-tools .fin-segments{margin-bottom:0}.fin-card{box-shadow:none}.fin-filter-row picker{border:1rpx solid var(--zs-line);border-radius:12rpx}.fin-flow-row{padding:23rpx 0}.fin-flow-detail{align-items:flex-end}.fin-list-empty>image{width:76rpx;height:76rpx;border-radius:18rpx;margin-bottom:4rpx;opacity:.8}.fin-list-empty>text{display:block}

.fin-home .fin-content{padding-top:20rpx}.fin-home-intro{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;padding:0 2rpx 20rpx}.fin-home-greeting{display:block;font-size:var(--zs-font-heading);line-height:52rpx;font-weight:600;margin-bottom:6rpx}.fin-home-period{color:var(--zs-brand);font-size:var(--zs-font-meta);line-height:36rpx;min-height:56rpx;display:flex;align-items:center;padding:0 8rpx}.fin-home-summary{padding:8rpx 22rpx}.fin-home-metrics{display:grid;grid-template-columns:1fr 1fr}.fin-home .fin-home-metric{min-width:0;min-height:112rpx;padding:18rpx 12rpx;text-align:center;border-bottom:1rpx solid var(--zs-line)}.fin-home .fin-home-metric:nth-child(odd){border-right:1rpx solid var(--zs-line)}.fin-home .fin-home-metric:nth-last-child(-n+2){border-bottom:0}.fin-home-metric text{display:block}.fin-home-metric text:first-child{font-size:var(--zs-font-meta);line-height:36rpx;color:var(--zs-text-3)}.fin-home-metric text:last-child{font-size:var(--zs-font-heading);line-height:50rpx;color:var(--zs-brand);font-weight:600;white-space:nowrap}.fin-home-shortcuts .fin-shortcuts button{background:var(--zs-bg);min-height:112rpx;justify-content:center}.fin-home-shortcuts .fin-shortcuts image{width:48rpx;height:48rpx}.fin-home-list .fin-link-row{padding:21rpx 2rpx}.fin-home .fin-small-primary{background:var(--zs-card);color:var(--zs-brand);border:1rpx solid var(--zs-brand);border-radius:10rpx}.fin-home-empty>image{width:72rpx;height:72rpx;border-radius:16rpx;opacity:.8}.fin-home-empty>text{display:block}
.fin-home-metrics.is-hq{grid-template-columns:repeat(3,minmax(0,1fr))}.fin-home-metrics.is-hq .fin-home-metric{border-bottom:0;border-right:1rpx solid var(--zs-line)}.fin-home-metrics.is-hq .fin-home-metric:last-child{border-right:0}

.fin-home-shortcuts .fin-shortcuts-three{grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}
