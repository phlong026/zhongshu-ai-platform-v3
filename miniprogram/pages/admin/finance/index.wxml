<view class="owner-page"><owner-header title="经营"/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-period"><text class="owner-muted">{{desk.company}}</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<view wx:if="{{!desk.business.available}}" class="owner-card"><view class="owner-heading"><text>经营数据</text></view><text class="owner-muted">{{desk.business.message}}</text></view>
<block wx:else>
<view class="biz-headline"><view wx:for="{{desk.business.summary}}" wx:key="key" class="biz-headline-item"><text class="biz-headline-label">{{item.label}}</text><text class="biz-headline-value">{{item.value}}</text><text class="biz-headline-note">{{item.note}}</text></view></view>
<view class="owner-card"><view class="owner-heading"><text>近 6 个月收支趋势</text><text class="owner-muted">实收 / 实付 / 净流入</text></view><view wx:for="{{desk.business.trend}}" wx:key="period" class="biz-trend-row"><text class="biz-trend-label">{{item.label}}</text><view class="owner-grow"><text>收 {{item.income}}</text><text class="owner-muted">付 {{item.paid}} · 净 {{item.net}}</text></view></view><view wx:if="{{!desk.business.trend.length}}" class="owner-empty">暂无趋势数据</view></view>
<view class="owner-card"><view class="owner-heading"><text>收支构成</text></view><view class="biz-composition"><view class="biz-composition-column"><text class="owner-name">收入</text><view wx:for="{{desk.business.incomeComposition}}" wx:key="key" class="biz-analysis-row"><text class="owner-muted owner-grow">{{item.label}}</text><text>{{item.value}}</text></view><text wx:if="{{!desk.business.incomeComposition.length}}" class="owner-muted">暂无收入记录</text></view><view class="biz-composition-column"><text class="owner-name">实际支出</text><view wx:for="{{desk.business.paidComposition}}" wx:key="key" class="biz-analysis-row"><text class="owner-muted owner-grow">{{item.label}}</text><text>{{item.value}}</text></view><text wx:if="{{!desk.business.paidComposition.length}}" class="owner-muted">暂无支出记录</text></view></view></view>
<view class="owner-card"><view class="owner-heading"><text>应收 / 应付账龄</text><text class="owner-muted">月末余额</text></view><view class="biz-aging"><view wx:for="{{desk.business.aging}}" wx:key="key" class="biz-aging-item"><text>{{item.label}}</text><text class="owner-muted">应收 {{item.receivable}}</text><text class="owner-muted">应付 {{item.payable}}</text></view></view></view>
<button class="owner-card home-brief-entry" data-url="/pages/admin/brief/index?period={{desk.period}}" bindtap="go"><view class="owner-grow"><text class="owner-name">经营简报与归档</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button>
</block></block></view><owner-nav id="owner-navigation" active="finance"/></view>
