<view class="owner-page"><owner-header title="经营"/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-period"><text class="owner-muted">{{desk.company}} · 按有效核算统计 <text wx:if="{{desk.sample}}" class="owner-badge">示例数据</text></text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<view class="biz-summary"><view class="biz-summary-row"><view class="biz-summary-cell"><text class="biz-summary-label">收入</text><text class="biz-summary-value">{{desk.business.summary.income}}<text class="biz-summary-unit">万</text></text><text class="biz-summary-note">{{desk.business.summary.incomeChange}}</text></view><view class="biz-summary-cell"><text class="biz-summary-label">支出</text><text class="biz-summary-value">{{desk.business.summary.paid}}<text class="biz-summary-unit">万</text></text><text class="biz-summary-note">{{desk.business.summary.paidChange}}</text></view><view class="biz-summary-cell"><text class="biz-summary-label">结余</text><text class="biz-summary-value">{{desk.business.summary.net}}<text class="biz-summary-unit">万</text></text><text class="biz-summary-note">结余不等于利润</text></view></view>
<button wx:if="{{!desk.business.historical}}" class="biz-balance" data-action="funds" bindtap="go"><text class="biz-balance-label">账户余额</text><text wx:if="{{desk.business.balance.value!==null}}" class="biz-balance-value">{{desk.business.balance.value}}万</text><text class="biz-balance-note">{{desk.business.balance.value===null?desk.business.balance.label:desk.business.balance.note}}</text><text class="biz-balance-arrow">›</text></button><view wx:else class="biz-history-note">历史月份仅展示当月收支，当前余额、应收应付和待办请切回本月查看。</view></view>
<block wx:if="{{!desk.business.historical}}"><view class="owner-card"><view class="owner-heading"><text>应收账款</text><button class="owner-link" data-action="receivables" bindtap="go">全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="biz-total"><text class="biz-total-value">{{desk.business.receivable.total}}万</text><text class="owner-muted">共 {{desk.business.receivable.count}} 笔 · {{desk.business.receivable.overdue==='0'?'暂无逾期':'其中逾期 '}}<text wx:if="{{desk.business.receivable.overdue!=='0'}}" class="biz-overdue">{{desk.business.receivable.overdue}}万</text></text></view>
<button wx:for="{{desk.business.receivable.rows}}" wx:key="key" class="biz-row" data-key="{{item.key}}" bindtap="openRow"><view class="biz-dot {{item.tone}}"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.meta}}</text></view><view class="biz-right"><text class="biz-amount">{{item.amount}}万</text><text class="biz-tag {{item.tone}}">{{item.tag}}</text></view></button><view wx:if="{{!desk.business.receivable.rows.length}}" class="owner-empty">当前没有未收款项</view></view>
<view class="owner-card"><view class="owner-heading"><text>应付账款</text><button class="owner-link" data-action="payments" bindtap="go">全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="biz-total"><text class="biz-total-value">{{desk.business.payable.total}}万</text><text class="owner-muted">共 {{desk.business.payable.count}} 笔 · 7 天内到期 {{desk.business.payable.dueSoon}}万</text></view>
<button wx:for="{{desk.business.payable.rows}}" wx:key="key" class="biz-row" data-key="{{item.key}}" bindtap="openRow"><view class="biz-dot {{item.tone}}"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.due}}</text></view><view class="biz-right"><text class="biz-amount">{{item.amount}}万</text><text class="biz-tag {{item.tone}}">{{item.tag}}</text></view></button><view wx:if="{{!desk.business.payable.rows.length}}" class="owner-empty">当前没有已批准未付的应付款</view></view>
<button class="owner-card biz-pending" data-action="financeProgress" bindtap="go"><text class="owner-name">财务待处理</text><text class="owner-muted owner-grow biz-pending-meta">待核算 {{desk.business.pending.reconcile}} 笔 · 待付款复核 {{desk.business.pending.review}} 笔</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></block>
</block></view><owner-nav id="owner-navigation" active="finance"/></view>
