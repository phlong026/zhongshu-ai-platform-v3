<view class="owner-page"><owner-header title="经营"/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-period"><text class="owner-muted">{{desk.company}}</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<view class="biz-summary"><view class="biz-summary-row"><view class="biz-summary-cell"><text class="biz-summary-label">收入</text><text class="biz-summary-value">{{desk.business.summary.income}}<text class="biz-summary-unit">万</text></text><text class="biz-summary-note">{{desk.business.summary.incomeChange}}</text></view><view class="biz-summary-cell"><text class="biz-summary-label">支出</text><text class="biz-summary-value">{{desk.business.summary.paid}}<text class="biz-summary-unit">万</text></text><text class="biz-summary-note">{{desk.business.summary.paidChange}}</text></view><view class="biz-summary-cell"><text class="biz-summary-label">结余</text><text class="biz-summary-value">{{desk.business.summary.net}}<text class="biz-summary-unit">万</text></text><text class="biz-summary-note">结余不等于利润</text></view></view>
<button wx:if="{{!desk.business.historical}}" class="biz-balance" data-action="funds" bindtap="go"><text class="biz-balance-label">账户余额</text><text wx:if="{{desk.business.balance.value!==null}}" class="biz-balance-value">{{desk.business.balance.value}}万</text><text class="biz-balance-note">{{desk.business.balance.value===null?desk.business.balance.label:desk.business.balance.note}}</text><text class="biz-balance-arrow">›</text></button><view wx:else class="biz-history-note"><text>{{desk.business.balance.value===null?desk.business.balance.label:'月末账户余额 '+desk.business.balance.value+'万'}}</text><text class="biz-history-sub">{{desk.business.snapshotInfo.note}}</text></view></view>
<view class="owner-card"><view class="owner-heading"><text>近 6 个月收支趋势</text><text class="owner-muted">单位：万</text></view><view wx:for="{{desk.business.analytics.trend}}" wx:key="period" class="biz-trend-row"><text class="biz-trend-label">{{item.label}}</text><view class="biz-trend-bars"><view class="biz-trend-line"><view class="biz-trend-fill income" style="width:{{item.incomeWidth}}%"/><text>收 {{item.income}}</text></view><view class="biz-trend-line"><view class="biz-trend-fill paid" style="width:{{item.paidWidth}}%"/><text>支 {{item.paid}}</text></view></view></view></view>
<view class="owner-card"><view class="owner-heading"><text>收支构成</text><button class="owner-link" data-action="promotion" bindtap="go">推广费用 ›</button></view><view class="biz-composition"><view class="biz-composition-column"><text class="owner-name">收入</text><view wx:for="{{desk.business.analytics.incomeComposition}}" wx:key="key" class="biz-analysis-row"><text class="owner-muted owner-grow">{{item.label}}</text><text>{{item.value}}万 · {{item.percent}}%</text></view><text wx:if="{{!desk.business.analytics.incomeComposition.length}}" class="owner-muted">本月暂无有效收入</text></view><view class="biz-composition-column"><text class="owner-name">实际支出</text><view wx:for="{{desk.business.analytics.paidComposition}}" wx:key="key" class="biz-analysis-row"><text class="owner-muted owner-grow">{{item.label}}</text><text>{{item.value}}万 · {{item.percent}}%</text></view><text wx:if="{{!desk.business.analytics.paidComposition.length}}" class="owner-muted">本月暂无有效支出</text></view></view></view>
<view class="biz-metrics"><view class="owner-card biz-metric"><text class="owner-muted">工程回款率</text><text wx:if="{{desk.business.analytics.collectionRate.available}}" class="biz-metric-value">{{desk.business.analytics.collectionRate.value}}</text><text wx:else class="biz-metric-empty">{{desk.business.analytics.collectionRate.note}}</text><text wx:if="{{desk.business.analytics.collectionRate.available}}" class="owner-muted">实收 {{desk.business.analytics.collectionRate.received}}万 / 到期 {{desk.business.analytics.collectionRate.due}}万</text></view><view class="owner-card biz-metric"><text class="owner-muted">资金覆盖</text><text wx:if="{{desk.business.analytics.coverage.available}}" class="biz-metric-value">{{desk.business.analytics.coverage.value}}</text><text wx:else class="biz-metric-empty">{{desk.business.analytics.coverage.note}}</text><text wx:if="{{desk.business.analytics.coverage.available}}" class="owner-muted">余额 {{desk.business.analytics.coverage.cash}}万 / 应付 {{desk.business.analytics.coverage.payable}}万</text></view><view class="owner-card biz-metric"><text class="owner-muted">项目预计毛利</text><text wx:if="{{desk.business.analytics.profit.available}}" class="biz-metric-value">{{desk.business.analytics.profit.value}}万</text><text wx:else class="biz-metric-empty">{{desk.business.analytics.profit.note}}</text><text wx:if="{{desk.business.analytics.profit.available}}" class="owner-muted">预计毛利率 {{desk.business.analytics.profit.margin}}</text></view><view class="owner-card biz-metric"><text class="owner-muted">获客成本</text><text wx:if="{{desk.business.analytics.acquisition.available}}" class="biz-metric-value">{{desk.business.analytics.acquisition.value}}元</text><text wx:else class="biz-metric-empty">{{desk.business.analytics.acquisition.note}}</text><text wx:if="{{desk.business.analytics.acquisition.available}}" class="owner-muted">推广 {{desk.business.analytics.acquisition.promotion}}万 / 有效客户 {{desk.business.analytics.acquisition.customers}}人</text></view></view>
<view wx:if="{{!desk.business.historical || desk.business.snapshotInfo.available}}" class="owner-card"><view class="owner-heading"><text>应收账款</text><button class="owner-link" data-action="receivables" bindtap="go">全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="biz-total"><text class="biz-total-value">{{desk.business.receivable.total}}万</text><text class="owner-muted">共 {{desk.business.receivable.count}} 笔 · {{desk.business.receivable.overdue==='0'?'暂无逾期':'其中逾期 '}}<text wx:if="{{desk.business.receivable.overdue!=='0'}}" class="biz-overdue">{{desk.business.receivable.overdue}}万</text></text></view><view class="biz-aging"><view wx:for="{{desk.business.analytics.receivableAging}}" wx:key="key" class="biz-aging-item"><text>{{item.label}}</text><text>{{item.value}}万</text></view></view><button wx:for="{{desk.business.receivable.rows}}" wx:key="key" class="biz-row" data-key="{{item.key}}" bindtap="openRow"><view class="biz-dot {{item.tone}}"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.meta}}</text></view><view class="biz-right"><text class="biz-amount">{{item.amount}}万</text><text class="biz-tag {{item.tone}}">{{item.tag}}</text></view></button><view wx:if="{{!desk.business.receivable.rows.length}}" class="owner-empty">当前没有未收款项</view></view>
<view wx:if="{{!desk.business.historical || desk.business.snapshotInfo.available}}" class="owner-card"><view class="owner-heading"><text>应付账款</text><button class="owner-link" data-action="payments" bindtap="go">全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="biz-total"><text class="biz-total-value">{{desk.business.payable.total}}万</text><text class="owner-muted">共 {{desk.business.payable.count}} 笔<text wx:if="{{!desk.business.historical}}"> · 7 天内到期 {{desk.business.payable.dueSoon}}万</text></text></view><view class="biz-aging"><view wx:for="{{desk.business.analytics.payableAging}}" wx:key="key" class="biz-aging-item"><text>{{item.label}}</text><text>{{item.value}}万</text></view></view><button wx:for="{{desk.business.payable.rows}}" wx:key="key" class="biz-row" data-key="{{item.key}}" bindtap="openRow"><view class="biz-dot {{item.tone}}"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.due}}</text></view><view class="biz-right"><text class="biz-amount">{{item.amount}}万</text><text class="biz-tag {{item.tone}}">{{item.tag}}</text></view></button><view wx:if="{{!desk.business.payable.rows.length}}" class="owner-empty">当前没有已批准未付的应付款</view></view>
<button wx:if="{{!desk.business.historical}}" class="owner-card biz-pending" data-action="financeProgress" bindtap="go"><text class="owner-name">财务待处理</text><text class="owner-muted owner-grow biz-pending-meta">待核算 {{desk.business.pending.reconcile}} 笔 · 待付款复核 {{desk.business.pending.review}} 笔</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button>
<view wx:if="{{desk.business.historical}}" class="owner-card biz-snapshot"><view><text class="owner-name">月度结账</text><text class="owner-muted">{{desk.business.snapshotInfo.note}}</text></view><button class="owner-primary" bindtap="archiveOperating">{{desk.business.snapshotInfo.available?'重新核对':'确认结账'}}</button></view>
</block></view><owner-nav id="owner-navigation" active="finance"/></view>
