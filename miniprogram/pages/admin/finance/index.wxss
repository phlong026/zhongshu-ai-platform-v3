@import "../owner.wxss";
.biz-headline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin-bottom:20rpx}.biz-headline-item{min-width:0;padding:22rpx 18rpx;border-radius:18rpx;background:var(--zs-brand);color:var(--zs-card);text-align:left}.biz-headline-item:nth-child(2){background:var(--zs-brand-press)}.biz-headline-item:nth-child(3){background:var(--zs-warning)}.biz-headline-label,.biz-headline-note{display:block;font-size:var(--zs-font-caption);line-height:32rpx;color:rgba(255,255,255,.78)}.biz-headline-value{display:block;margin:8rpx 0;font-size:var(--zs-font-heading);line-height:48rpx;font-weight:700;white-space:nowrap}.biz-headline-unit{font-size:var(--zs-font-caption);font-weight:400;margin-left:4rpx}.biz-headline-note{min-height:64rpx}
.biz-alert-grid{display:flex;flex-direction:column;gap:12rpx}.biz-alert{display:flex;align-items:center;gap:10rpx;min-width:0;padding:16rpx;border-radius:14rpx;background:#f4f1ed;text-align:left}.biz-alert.warn{background:#fbf1e0}.biz-alert.pending{background:#f1f0ee}.biz-alert>view{min-width:0;flex:1}.biz-alert{min-height:112rpx;gap:20rpx}.biz-alert .owner-name{font-size:var(--zs-font-emphasis);line-height:40rpx}.biz-alert .owner-muted{line-height:36rpx}.biz-alert-count{flex-shrink:0}.biz-alert text{display:block}.biz-alert-count{font-size:var(--zs-font-title);font-weight:700;color:var(--zs-warning);white-space:nowrap}.biz-alert.ok .biz-alert-count{color:var(--zs-success)}.biz-alert.pending .biz-alert-count{font-size:var(--zs-font-body);color:var(--zs-text-3)}.biz-alert .owner-arrow{width:20rpx;height:20rpx}
.biz-level-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.biz-level-card{min-width:0;padding:18rpx;border-radius:16rpx;background:#f7f3ed;text-align:left}.biz-level-card.is-material{background:#f1f5ed;border:1rpx solid #dbe7d4}.biz-level-card text{display:block}.biz-level-value{margin:6rpx 0;font-size:var(--zs-font-heading);line-height:46rpx;font-weight:700;color:var(--boss-brown)}.biz-level-note{font-size:var(--zs-font-caption);line-height:32rpx;color:var(--boss-muted)}
.biz-total{display:flex;align-items:baseline;gap:14rpx;flex-wrap:wrap;margin-bottom:6rpx}.biz-total-value{font-size:var(--zs-font-heading);line-height:58rpx;font-weight:700;color:var(--boss-brown)}.biz-overdue{color:#c4472a}.biz-row{width:100%;display:flex;align-items:center;gap:18rpx;padding:22rpx 0;text-align:left;border-bottom:1rpx solid #ebe5dc}.biz-row:last-of-type{border-bottom:0;padding-bottom:0}.biz-dot{width:14rpx;height:14rpx;border-radius:50%;flex-shrink:0;background:#3f8a5a}.biz-dot.overdue{background:#c4472a}.biz-dot.soon{background:#c98a2b}.biz-right{display:flex;flex-direction:column;align-items:flex-end;gap:6rpx;flex-shrink:0}.biz-amount{font-size:var(--zs-font-title);line-height:44rpx;font-weight:700}.biz-tag{border-radius:9rpx;padding:2rpx 12rpx;font-size:var(--zs-font-caption);line-height:34rpx;color:var(--zs-text-3);background:#f1f0ee;white-space:nowrap}.biz-tag.overdue{color:#c4472a;background:#fdece6}.biz-tag.soon{color:var(--zs-warning);background:#fbf1e0}.biz-pending{display:flex;align-items:center;gap:16rpx;width:100%;text-align:left}.biz-pending-meta{text-align:right}
.biz-trend-row{display:flex;gap:16rpx;align-items:center;margin-top:16rpx}.biz-trend-label{width:58rpx;font-size:var(--zs-font-meta);color:#777}.biz-trend-bars{flex:1;min-width:0}.biz-trend-line{position:relative;height:34rpx;margin:5rpx 0;border-radius:8rpx;background:#f4f0ea;overflow:hidden}.biz-trend-line text{position:absolute;left:10rpx;top:0;font-size:var(--zs-font-caption);line-height:34rpx;color:#45372b}.biz-trend-fill{height:100%;min-width:2rpx}.biz-trend-fill.income{background:#dcebdc}.biz-trend-fill.paid{background:#f2dfd5}.biz-composition{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.biz-composition-column{min-width:0}.biz-analysis-row{display:flex;gap:10rpx;margin-top:14rpx;font-size:var(--zs-font-meta);line-height:34rpx}.biz-aging{display:flex;gap:10rpx;overflow-x:auto;margin:16rpx 0}.biz-aging-item{min-width:150rpx;padding:12rpx;border-radius:12rpx;background:#f7f3ed}.biz-aging-item text{display:block;font-size:var(--zs-font-caption);line-height:34rpx}.biz-aging-item text:last-child{font-weight:700}.biz-snapshot{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.biz-snapshot view{flex:1}.biz-snapshot text{display:block}.biz-snapshot button{flex-shrink:0}
@media(max-width:360px){.biz-headline,.biz-alert-grid{grid-template-columns:1fr}.biz-headline-note{min-height:0}}
