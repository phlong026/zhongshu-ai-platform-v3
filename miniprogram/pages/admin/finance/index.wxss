@import "../owner.wxss";
.biz-summary{background:linear-gradient(160deg,#8d5631,#6b3f20);border-radius:24rpx;padding:30rpx 26rpx 26rpx;margin-bottom:20rpx;color:#fff8ee}.biz-summary-row{display:flex}.biz-summary-cell{flex:1;min-width:0;padding:0 14rpx;border-right:1rpx solid rgba(255,248,238,.28)}.biz-summary-cell:first-child{padding-left:0}.biz-summary-cell:last-child{border-right:0}.biz-summary-label,.biz-summary-note{display:block;font-size:24rpx;line-height:36rpx;color:rgba(255,248,238,.78)}.biz-summary-value{display:block;font-size:46rpx;line-height:64rpx;font-weight:700;margin:8rpx 0;white-space:nowrap}.biz-summary-unit{font-size:24rpx;font-weight:400;margin-left:4rpx}
.biz-balance{display:flex;align-items:center;gap:14rpx;margin-top:26rpx;padding:20rpx 22rpx;border-radius:18rpx;background:rgba(255,248,238,.14);color:#fff8ee;text-align:left}.biz-balance-label{font-size:26rpx;line-height:38rpx;flex-shrink:0}.biz-balance-value{font-size:32rpx;line-height:44rpx;font-weight:700;flex-shrink:0}.biz-balance-note{flex:1;min-width:0;font-size:24rpx;line-height:36rpx;color:rgba(255,248,238,.78)}.biz-balance-arrow{font-size:30rpx;color:rgba(255,248,238,.78)}
.biz-history-note{margin-top:26rpx;padding:20rpx 22rpx;border-radius:18rpx;background:rgba(255,248,238,.14);font-size:24rpx;line-height:38rpx;color:rgba(255,248,238,.82)}
.biz-history-note text{display:block}.biz-history-sub{margin-top:6rpx;color:rgba(255,248,238,.68)}
.biz-total{display:flex;align-items:baseline;gap:14rpx;flex-wrap:wrap;margin-bottom:6rpx}.biz-total-value{font-size:42rpx;line-height:58rpx;font-weight:700;color:var(--boss-brown)}.biz-overdue{color:#c4472a}.biz-row{width:100%;display:flex;align-items:center;gap:18rpx;padding:22rpx 0;text-align:left;border-bottom:1rpx solid #ebe5dc}.biz-row:last-of-type{border-bottom:0;padding-bottom:0}.biz-dot{width:14rpx;height:14rpx;border-radius:50%;flex-shrink:0;background:#3f8a5a}.biz-dot.overdue{background:#c4472a}.biz-dot.soon{background:#c98a2b}.biz-right{display:flex;flex-direction:column;align-items:flex-end;gap:6rpx;flex-shrink:0}.biz-amount{font-size:30rpx;line-height:44rpx;font-weight:700}.biz-tag{border-radius:9rpx;padding:2rpx 12rpx;font-size:22rpx;line-height:34rpx;color:#9a9187;background:#f1f0ee;white-space:nowrap}.biz-tag.overdue{color:#c4472a;background:#fdece6}.biz-tag.soon{color:#8a5a12;background:#fbf1e0}.biz-pending{display:flex;align-items:center;gap:16rpx;width:100%;text-align:left}.biz-pending-meta{text-align:right}
.biz-trend-row{display:flex;gap:16rpx;align-items:center;margin-top:16rpx}.biz-trend-label{width:58rpx;font-size:24rpx;color:#777}.biz-trend-bars{flex:1;min-width:0}.biz-trend-line{position:relative;height:34rpx;margin:5rpx 0;border-radius:8rpx;background:#f4f0ea;overflow:hidden}.biz-trend-line text{position:absolute;left:10rpx;top:0;font-size:21rpx;line-height:34rpx;color:#45372b}.biz-trend-fill{height:100%;min-width:2rpx}.biz-trend-fill.income{background:#dcebdc}.biz-trend-fill.paid{background:#f2dfd5}.biz-composition{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.biz-composition-column{min-width:0}.biz-analysis-row{display:flex;gap:10rpx;margin-top:14rpx;font-size:23rpx;line-height:34rpx}.biz-metrics{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.biz-metric{margin-bottom:0;min-width:0}.biz-metric text{display:block}.biz-metric-value{margin:10rpx 0;font-size:36rpx;line-height:48rpx;font-weight:700;color:var(--boss-brown)}.biz-metric-empty{margin:10rpx 0;font-size:25rpx;line-height:38rpx;color:#a06a3c}.biz-aging{display:flex;gap:10rpx;overflow-x:auto;margin:16rpx 0}.biz-aging-item{min-width:150rpx;padding:12rpx;border-radius:12rpx;background:#f7f3ed}.biz-aging-item text{display:block;font-size:22rpx;line-height:34rpx}.biz-aging-item text:last-child{font-weight:700}.biz-snapshot{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.biz-snapshot view{flex:1}.biz-snapshot text{display:block}.biz-snapshot button{flex-shrink:0}
