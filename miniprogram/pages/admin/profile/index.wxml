<view class="owner-page"><owner-header title="我的"/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-card"><button class="owner-person" data-action="profile" bindtap="go"><image class="owner-avatar" src="{{desk.avatar}}" mode="aspectFill"/><view class="owner-grow"><text class="owner-title">{{desk.name}}</text><text class="owner-muted">{{desk.company}} · {{desk.role}}</text></view><text class="owner-link">个人资料<image class="owner-arrow" src="/assets/creation-chevron.png"/></text></button></view>
<view class="owner-card"><button class="owner-row" data-action="messages" bindtap="go"><image class="owner-menu-icon" src="/assets/account-message.jpg" mode="aspectFit"/><text class="owner-name owner-grow">消息通知</text><text class="owner-amount">{{desk.unread}}</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view>
<view class="owner-card"><view class="owner-heading"><text>常用管理</text></view><view class="owner-quick-grid"><button class="owner-quick" data-action="staff" bindtap="go"><image src="/assets/team.png" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">成员与权限</text><text class="owner-muted">在岗{{desk.staff.length}}人</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-quick" data-action="settings" bindtap="go"><image src="/assets/management-payment.jpg" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">审批设置</text><text class="owner-muted">金额事项与团队分工</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-quick" data-action="handover" bindtap="go"><image src="/assets/folder.png" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">项目经理交接</text><text class="owner-muted">离岗与项目接续</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-quick" data-action="company" bindtap="go"><image src="/assets/account-shop.jpg" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">门店资料</text><text class="owner-muted">机构信息</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view></view>
<view class="owner-card"><view class="owner-heading"><text>最近操作</text><button class="owner-link" data-action="activity" bindtap="go">查看全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><button wx:for="{{desk.recentEvents}}" wx:key="key" class="owner-row" data-key="{{item.key}}" bindtap="go"><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.status}}</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><view wx:if="{{!desk.recentEvents.length}}" class="owner-empty">当前暂无可查看的操作记录</view></view>
<view class="owner-card"><view class="owner-heading"><text>服务与设置</text></view><button class="owner-row" data-action="learning" bindtap="go"><image class="owner-menu-icon" src="/assets/graduate.png" mode="aspectFit"/><text class="owner-grow owner-name">众墅学堂</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="services" bindtap="go"><image class="owner-menu-icon" src="/assets/account-shop.jpg" mode="aspectFit"/><text class="owner-grow owner-name">展陈设计</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="selection" bindtap="go"><image class="owner-menu-icon" src="/assets/account-bag.jpg" mode="aspectFit"/><text class="owner-grow owner-name">众墅甄选</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="help" bindtap="go"><image class="owner-menu-icon" src="/assets/account-headset.jpg" mode="aspectFit"/><text class="owner-grow owner-name">帮助与反馈</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="privacy" bindtap="go"><image class="owner-menu-icon" src="/assets/account-shield.jpg" mode="aspectFit"/><text class="owner-grow owner-name">账号与隐私</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view>
<view class="owner-card"><button class="owner-row" bindtap="openDesignPolicy"><text class="owner-grow owner-name">标准设计费用与授权</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><button class="profile-logout" bindtap="logout">退出登录</button></block></view><owner-nav id="owner-navigation" active="profile"/></view>
