<template name="owner-company-settings">
<view class="owner-card management-company"><view class="owner-heading"><text>门店资料</text></view>
<view class="owner-readonly-row"><text class="owner-muted">组织编号</text><text>{{managementSettings.company.companyId}}</text></view>
<block wx:if="{{managementSettings.canEdit}}">
<view class="owner-form-row"><text>门店名称</text><input class="management-input" value="{{companyForm.displayName}}" data-field="displayName" bindinput="companyInput" maxlength="50"/></view>
<view class="owner-form-row"><text>联系人</text><input class="management-input" value="{{companyForm.contact}}" data-field="contact" bindinput="companyInput" maxlength="30"/></view>
<view class="owner-form-row"><text>联系电话</text><input class="management-input" value="{{companyForm.phone}}" data-field="phone" bindinput="companyInput" maxlength="13"/></view>
<view class="owner-form-row"><text>门店地址</text><input class="management-input" value="{{companyForm.address}}" data-field="address" bindinput="companyInput" maxlength="120"/></view>
<button class="owner-primary owner-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveCompany">保存门店资料</button>
</block>
<block wx:else><view class="owner-readonly-row"><text>门店名称</text><text>{{managementSettings.company.displayName}}</text></view><view class="owner-readonly-row"><text>联系人</text><text>{{managementSettings.company.contact||'待登记'}}</text></view><view class="owner-readonly-row"><text>联系电话</text><text>{{managementSettings.company.phone||'待登记'}}</text></view><view class="owner-readonly-row"><text>门店地址</text><text>{{managementSettings.company.address||'待登记'}}</text></view><text class="owner-note">请由本组织老板维护资料。</text></block>

</view>
</template>
<template name="owner-assignment-settings">
<view class="owner-card"><view class="owner-heading"><text>审批规则</text></view><view wx:for="{{managementSettings.fixedRules}}" wx:key="id" class="owner-readonly-row"><text class="owner-muted">{{item.label}}</text><text>{{item.value}}</text></view></view>
<view class="owner-card"><view class="owner-heading"><text>当前职责分工</text></view><view wx:for="{{managementSettings.assignmentFields}}" wx:key="id" class="owner-form-row"><text>{{item.label}}</text><picker wx:if="{{managementSettings.canEdit&&item.options.length}}" range="{{item.options}}" range-key="name" data-field="{{item.id}}" bindchange="assignmentChange"><view class="owner-link">{{item.selectedName}}<image class="owner-arrow" src="/assets/creation-chevron.png"/></view></picker><text wx:else class="owner-muted">{{item.options.length?item.selectedName:'暂无在岗人员'}}</text></view><button wx:if="{{managementSettings.canEdit}}" class="owner-primary owner-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveAssignments">保存职责分工</button><text class="owner-note">新事项优先分给以上经办人。</text></view>
</template>

<template name="owner-rules-settings">
<view class="owner-card"><view class="owner-heading"><text>费用线</text></view>
<block wx:if="{{managementSettings.canEdit}}">
<view class="owner-form-row"><text>单笔费用超过（元）</text><input class="management-input" type="digit" value="{{rulesForm.expenseLine}}" data-field="expenseLine" bindinput="rulesInput" placeholder="例如 5000"/></view>
<button class="owner-primary owner-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveRules">保存费用线</button>
<text class="owner-note">适用于全部项目。限额内直接生成应付，超额需老板确认；填 0 则全部需确认。</text>
</block>
<block wx:else>
<view class="owner-readonly-row"><text class="owner-muted">单笔费用超过（元）</text><text>{{rulesForm.expenseLine}}</text></view>
<text class="owner-note">请由本组织老板维护。</text>
</block>
</view>
<view class="owner-card"><view class="owner-heading"><text>报价规则</text></view>
<view class="owner-readonly-row"><text class="owner-muted">价目表内报价</text><text>自动通过，无需逐单审批</text></view>
<view class="owner-readonly-row"><text class="owner-muted">价目表外报价</text><text>需老板确认</text></view>
<button class="owner-link" bindtap="openDesignPolicy">历史设计费用规则<image class="owner-arrow" src="/assets/creation-chevron.png"/></button>
</view>
<view class="owner-card"><view class="owner-heading"><text>资金闸门</text></view>
<view class="owner-readonly-row"><text class="owner-muted">钱没到不开工</text><text>开启：开工款收齐才可登记开工</text></view>
<view class="owner-readonly-row"><text class="owner-muted">封顶款与交付</text><text>开启：按约定收齐才可交付，例外由老板限期批准</text></view>
<text class="owner-note">闸门是工程资金安全底线，不提供关闭入口；赶工期请在「合同应收与催收」办理例外放行。</text>
</view>
</template>
