@import "../owner.wxss";
.commission-intro{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:0 0 24rpx;color:var(--zs-text-3);font-size:26rpx;line-height:40rpx}.commission-project-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;font-size:32rpx;line-height:46rpx;font-weight:600}.commission-project-heading>text:first-child{min-width:0;overflow-wrap:anywhere}.commission-state{flex-shrink:0;font-size:24rpx;line-height:36rpx;padding:4rpx 12rpx;background:#f4efe7;color:#79654f;border-radius:8rpx;font-weight:400}.commission-unset-label{display:block;margin-top:14rpx;font-size:27rpx;line-height:40rpx;color:var(--zs-text-3)}.commission-policy{display:flex;align-items:flex-end;justify-content:space-between;gap:24rpx;margin:24rpx 0}.commission-label{display:block;color:var(--zs-text-3);font-size:25rpx;line-height:36rpx}.commission-total{display:block;color:var(--zs-brand);font-size:42rpx;line-height:56rpx;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}.commission-assignee{font-size:26rpx;line-height:38rpx;text-align:right;overflow-wrap:anywhere}.commission-stage{border-top:1rpx solid var(--zs-line);padding:24rpx 0}.commission-stage:last-child{padding-bottom:0}.commission-stage-heading,.commission-stage-amount{display:flex;justify-content:space-between;align-items:center;gap:16rpx;font-size:28rpx;line-height:42rpx}.commission-stage-heading{font-weight:600}.commission-stage-amount{margin-top:20rpx;color:var(--zs-text-3)}.commission-stage-amount>text:last-child{font-size:34rpx;line-height:48rpx;font-weight:600;color:var(--zs-text);font-variant-numeric:tabular-nums}.commission-money-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20rpx;margin:16rpx 0}.commission-money{display:block;font-size:30rpx;line-height:44rpx;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}.commission-collection{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8rpx 20rpx;color:var(--zs-text-3);font-size:24rpx;line-height:36rpx}.commission-state.warning{color:var(--zs-danger);background:#fff0e9}
.ops-field{display:block;width:100%;box-sizing:border-box;margin:14rpx 0;padding:18rpx 20rpx;border:1rpx solid #e5ddd3;border-radius:12rpx;background:var(--zs-bg);font-size:var(--zs-font-emphasis);line-height:42rpx}.ops-note{height:130rpx}.ops-check{padding:20rpx 0;font-size:var(--zs-font-body);line-height:40rpx;color:var(--boss-brown)}input.ops-field{height:88rpx;min-height:88rpx}.commission-actions{display:flex;flex-direction:column;align-items:flex-end;gap:8rpx}.commission-reason{display:block;margin-top:8rpx;color:#8a633d;font-size:var(--zs-font-meta);line-height:35rpx}.commission-reason.warning{color:var(--zs-danger)}
