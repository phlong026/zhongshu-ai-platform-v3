.admin,.sheet{font-family:sans-serif;font-size:27rpx;font-weight:400;line-height:40rpx;letter-spacing:0}
.admin button,.admin input,.admin textarea,.sheet button{font-family:inherit}
.admin .heading,.admin .hero-money,.admin .stat-value,.admin .large,.admin .value.money-value{font-family:sans-serif;font-weight:700}
.admin .heading{font-size:30rpx;line-height:42rpx}
.admin .hero-title,.admin .strong,.admin .item-title{font-family:sans-serif;font-weight:500}
.admin .hero-title{font-size:29rpx;line-height:42rpx}
.admin .hint{font-size:24rpx;line-height:36rpx}
.admin .label{font-size:26rpx;line-height:38rpx}
.admin .value{font-size:27rpx;line-height:40rpx}
.admin .row input,.admin .row picker,.admin .textarea{font-size:27rpx;line-height:40rpx}
.admin .solid,.admin .outline,.sheet .solid,.sheet .outline{font-size:28rpx;line-height:44rpx;font-weight:500}
.admin .tabs button{font-size:27rpx;line-height:40rpx}
.admin .item-title{font-size:27rpx;line-height:40rpx}
.admin .item-link .hint{font-size:23rpx;line-height:34rpx}
.admin .value.money-value{font-size:34rpx;line-height:44rpx}
.admin .hero-money{font-size:44rpx;line-height:54rpx}
.admin .check-row{font-size:24rpx;line-height:36rpx}
.admin .notice{font-size:23rpx;line-height:36rpx}
.admin .meta{font-size:23rpx;line-height:34rpx;font-weight:400}
.admin .radio{font-size:27rpx;line-height:40rpx}

.admin .picture>text{border:1rpx solid #ab7248;border-radius:6rpx;padding:10rpx 12rpx;white-space:nowrap}.admin.view-reconcile .notice{background:transparent;color:#9a9187;padding:3rpx 0;margin:5rpx 0}

.admin.view-reconcile .notice{padding:0;line-height:32rpx}.admin.view-reconcile .card{margin-bottom:21rpx}

.admin .finance-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;padding:14rpx}.fund-card{display:flex;gap:12rpx;align-items:center;text-align:left;background:#fbf9f5;min-height:136rpx;padding:14rpx;border-radius:10rpx}.fund-card>image{width:48rpx;height:54rpx;flex-shrink:0}.fund-status{display:block;font-size:22rpx;line-height:32rpx}.fund-amount{display:block;font-size:30rpx;line-height:42rpx;font-weight:700;color:#89512a}

.month-picker{margin-left:auto;font-size:22rpx;font-weight:400;line-height:34rpx;color:#8992a4}

.admin.view-project .card{padding:20rpx;margin-bottom:20rpx}.admin.view-project .hero{min-height:124rpx}.view-project .hero-icon{display:none}.view-project .hero-title{font-size:30rpx;font-weight:700}.view-project .hero .hint{font-size:21rpx;line-height:30rpx}.admin.view-project .finance-grid{padding:14rpx}.fund-card.wide{grid-column:1 / -1;min-height:116rpx}.fund-note{font-size:23rpx;font-weight:400}.view-project .section-1 .item-link{min-height:64rpx;padding:8rpx 10rpx;margin:0;border-radius:0;gap:20rpx}.view-project .section-1 .item-link>image{width:44rpx;height:46rpx}.view-project .section-2 .notice{padding:0;margin:0;background:transparent;line-height:34rpx}.view-project .section-3 .item-link{min-height:90rpx;padding:10rpx;margin:0}.view-project .footer .solid{background:#fff;color:#89512a;border:1rpx solid #ac794b}

.view-project .meta{color:#89512a}.estimate-row{display:flex;align-items:center;gap:24rpx;padding:0 0 8rpx;color:#9a9187;font-size:24rpx;line-height:36rpx}.estimate-row>image{width:50rpx;height:54rpx;flex-shrink:0}
