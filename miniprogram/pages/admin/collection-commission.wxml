<template name="collection-commission">
  <view wx:if="{{commissionReview}}" class="owner-card">
    <view class="owner-heading"><text>核对退款后的提成</text></view>
    <view class="commission-project-heading">{{commissionReview.projectName}} · {{commissionReview.label}}</view>
    <block wx:if="{{commissionReview.settled}}">
      <view class="commission-stage-amount"><text>业主净回款</text><text>{{commissionReview.received}}</text></view>
      <view class="commission-stage-amount"><text>业主待补回款</text><text>{{commissionReview.gapText}}</text></view>
      <view class="commission-money-grid"><view><text class="commission-label">本期约定提成</text><text class="commission-money">{{commissionReview.agreedText}}</text></view><view><text class="commission-label">已付提成</text><text class="commission-money">{{commissionReview.paidText}}</text></view></view>
      <view class="commission-stage-amount"><text>提成差额（已付减约定）</text><text>{{commissionReview.diffText}}</text></view>
      <text class="owner-note">保存核对意见后，保留原付款记录。</text>
    </block>
    <block wx:else>
      <view class="commission-collection"><text>净回款 {{commissionReview.received}}</text><text>未付提成 {{commissionReview.outstanding}}</text></view>
      <text class="owner-note">{{commissionReview.eligible?'核对后，财务可按原应付余额办理。':'本期回款尚未补齐，保存后继续暂停付款。'}}</text>
    </block>
    <textarea class="ops-field ops-note" data-key="note" value="{{commissionReview.note}}" placeholder="填写退款影响及处理意见" bindinput="commissionInput"/>
    <button class="owner-outline" bindtap="commissionUpload">{{commissionReview.file?'已选择：'+commissionReview.file.name:'上传核对依据'}}</button>
    <button class="owner-primary owner-save" data-action="commission-reconcile" data-confirmed="{{true}}" data-id="{{commissionReview.projectId}}" data-stage="{{commissionReview.stage}}" bindtap="commissionAction" loading="{{busy}}" disabled="{{busy}}">保存核对记录</button>
    <button class="owner-link" bindtap="cancelCommissionReview">取消核对</button>
  </view>
  <view wx:elif="{{canEditPolicy}}" class="owner-card">
    <view class="owner-heading"><text>设置提成</text></view>
    <text class="owner-note">老板确认绩效调整后的提成金额，阶段款收齐后由财务登记付款。</text>
    <picker range="{{commissionProjects}}" range-key="name" value="{{commissionProjectIndex}}" bindchange="commissionProject"><view class="ops-field">项目：{{commissionProjects[commissionProjectIndex].name||'请选择项目'}}</view></picker>
    <picker range="{{commissionStaff}}" range-key="name" value="{{commissionStaffIndex}}" bindchange="commissionStaff"><view class="ops-field">提成归属：{{commissionStaff[commissionStaffIndex].name||'请选择在岗人员'}}</view></picker>
    <text class="commission-label">绩效确认后的提成总额（元）</text>
    <input class="ops-field" type="digit" data-key="amount" value="{{commissionForm.amount}}" placeholder="已确认提成总额（元）" bindinput="commissionInput"/>
    <text class="commission-label">签约后提成（元）</text>
    <input class="ops-field" type="digit" data-key="signAfter" value="{{commissionForm.signAfter}}" placeholder="签约后提成（元，未约定填0）" bindinput="commissionInput"/>
    <text class="commission-label">基础完成后提成（元）</text>
    <input class="ops-field" type="digit" data-key="baseDone" value="{{commissionForm.baseDone}}" placeholder="基础完成后提成（元，未约定填0）" bindinput="commissionInput"/>
    <text class="commission-label">封顶后提成（元）</text>
    <input class="ops-field" type="digit" data-key="capDone" value="{{commissionForm.capDone}}" placeholder="封顶后提成（元，未约定填0）" bindinput="commissionInput"/>
    <textarea class="ops-field ops-note" data-key="note" value="{{commissionForm.note}}" placeholder="绩效调整依据及最终金额说明" bindinput="commissionInput"/>
    <button class="owner-outline" bindtap="commissionUpload">{{commissionForm.file?'已选择：'+commissionForm.file.name:'上传提成确认依据'}}</button>
    <button class="ops-check" bindtap="commissionToggle">{{commissionForm.checked?'☑':'☐'}} 已核对项目、固定总额、归属人和依据</button>
    <button class="owner-primary owner-save commission-save" data-action="commission-policy" bindtap="commissionAction" loading="{{busy}}" disabled="{{busy}}">保存提成规则</button>
  </view>
  <view wx:else class="commission-intro"><text>提成规则由老板设置</text><text class="owner-badge">规则只读</text></view>
  <view wx:for="{{commissionRows}}" wx:key="projectId" class="owner-card commission-card {{item.noPolicy?'commission-unset':''}}">
    <view class="commission-project-heading"><text>{{item.project}}</text><text wx:if="{{item.noPolicy}}" class="commission-state">待设置</text></view>
    <block wx:if="{{!item.noPolicy}}">
    <button wx:if="{{item.evidenceId}}" class="owner-link" data-id="{{item.evidenceId}}" bindtap="openCommissionEvidence">查看提成依据</button>
    <view class="commission-policy"><view><text class="commission-label">提成总额</text><text class="commission-total">{{item.totalText}}</text></view><text class="commission-assignee">归属 · {{item.assignee||'待确认'}}</text></view>
    <view wx:for="{{item.stages}}" wx:for-item="stage" wx:key="stage" class="commission-stage">
      <view class="commission-stage-heading"><text>{{stage.label}}</text><text class="commission-state {{stage.reviewDue?'warning':''}}">{{stage.status}}</text></view>
      <view class="commission-stage-amount"><text>本期提成</text><text>{{stage.amountText}}</text></view>
      <view class="commission-money-grid"><view><text class="commission-label">{{stage.paymentReturned?'净已付':'已付'}}</text><text class="commission-money">{{stage.paidText}}</text></view><view><text class="commission-label">{{stage.paymentReturned?'差额':'未付'}}</text><text class="commission-money">{{stage.outstandingText}}</text></view></view>
      <view class="commission-collection"><text>阶段应收 {{stage.requiredText}}</text><text>净实收 {{stage.receivedText}}</text></view>
      <text wx:if="{{stage.reason}}" class="commission-reason {{stage.reviewDue?'warning':''}}">{{stage.reason}}</text>
      <button wx:for="{{stage.evidenceIds}}" wx:for-item="fileId" wx:key="*this" class="owner-link" data-id="{{fileId}}" bindtap="openCommissionEvidence">查看核对凭据 {{index+1}}</button>
      <view class="commission-actions"><button wx:if="{{stage.canRelease}}" class="owner-link" data-action="commission-release" data-id="{{item.projectId}}" data-stage="{{stage.stage}}" data-version="{{item.version}}" bindtap="commissionAction">生成应付</button><button wx:if="{{stage.canPay}}" class="owner-link" data-payable="{{stage.payableId}}" bindtap="commissionPay">登记付款</button><button wx:if="{{stage.canReconcile}}" class="owner-link" data-action="commission-reconcile" data-id="{{item.projectId}}" data-stage="{{stage.stage}}" data-version="{{item.version}}" bindtap="commissionAction">人工核对</button></view>
    </view>
    </block>
  </view>
  <view wx:if="{{!commissionRows.length}}" class="owner-card owner-empty">暂无已确认的项目提成。</view>
</template>
