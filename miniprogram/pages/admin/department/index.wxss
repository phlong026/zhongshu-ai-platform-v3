@import '../../../styles/role-home.wxss';
page{background:#f7f5f1;color:#181510;font-family:var(--zs-font-family)}
button{display:block;background:transparent;border:0;padding:0;margin:0;width:auto;text-align:left;font-family:inherit;font-size:26rpx;font-weight:400;color:inherit;line-height:1.4;border-radius:0}button::after{border:0}
.section,.sheet{background:#fff;border-radius:24rpx;padding:22rpx 24rpx;margin-bottom:22rpx}.head,.person,.record,.hero,.tiles,.filters,.project-line,.label,.month{display:flex;align-items:center}.head{font-size:34rpx;font-weight:700;line-height:48rpx;min-height:48rpx;justify-content:space-between}.link,.month,.all,.pill,.count{color:#87491c}.link,.month{font-size:24rpx;font-weight:450;line-height:36rpx}.head .link{display:flex;align-items:center;min-height:48rpx;line-height:36rpx}.month{border:1rpx solid #dedbd6;border-radius:30rpx;padding:3rpx 15rpx;gap:12rpx;color:#28201c}.month image{width:16rpx;height:12rpx}.label{font-size:25rpx;font-weight:500;line-height:36rpx;white-space:nowrap;gap:6rpx}.arrow{width:12rpx;height:21rpx;flex-shrink:0}
.hero{padding:26rpx 0 22rpx}.hero button{width:50%;min-width:0;display:flex;align-items:center;gap:10rpx;box-sizing:border-box;padding-left:5rpx}.hero button+button{border-left:1rpx solid #e3ded8;padding-left:17rpx}.hero-icon{width:65rpx;height:75rpx;flex-shrink:0}.hero-copy{min-width:0}.big,.value,.count{font-weight:750;color:#86481e;font-variant-numeric:tabular-nums}.big{font-family:Arial,"PingFang SC",sans-serif;font-size:68rpx;line-height:1.15;margin-top:6rpx;white-space:nowrap;letter-spacing:-1.4rpx}.big.long{font-size:48rpx}.unit{font-size:29rpx;margin-left:4rpx;font-weight:500;letter-spacing:0}.tiles{border-top:1rpx solid #ece7e2;padding-top:22rpx}.tiles button{flex:1;min-width:0;padding-left:18rpx;box-sizing:border-box;display:flex;flex-direction:column;align-items:flex-start}.tiles button:first-child{padding-left:7rpx}.tiles button+button{border-left:1rpx solid #e6e1dd}.tile-icon{width:67rpx;height:58rpx;margin-bottom:7rpx}.tiles .label{font-size:25rpx;gap:4rpx}.tiles .arrow{width:10rpx;height:16rpx}.value{font-family:Arial,"PingFang SC",sans-serif;font-size:46rpx;line-height:1.15}.value .unit{font-size:27rpx}.team .head,.focus .head{padding-bottom:10rpx}.record,.person{border-top:1rpx solid #ece8e3;width:100%;gap:14rpx}.person{padding:8rpx 0}.avatar{width:70rpx;height:70rpx;flex-shrink:0;border-radius:50%}.person .name,.grow{flex:1;min-width:0}.name{display:block;font-size:28rpx;line-height:40rpx;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.person-stat{font-size:23rpx;white-space:nowrap}.count{font-size:33rpx}.last{padding:0 7rpx 0 21rpx;margin-left:4rpx;position:relative}.last::before{content:"";display:block;position:absolute;left:0;top:22%;height:56%;border-left:1rpx solid #d4cfcb}.all{background:#f8f2ea;border-radius:32rpx;text-align:center;font-size:25rpx;margin-top:5rpx;width:100%;padding:5rpx 0}.record{padding:12rpx 0}.record:last-child{padding-bottom:0}.record-note,.muted{display:block;font-size:24rpx;color:#6f665a;line-height:36rpx}.record-note{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.muted{padding:10rpx 0}.pill{font-size:22rpx;padding:2rpx 10rpx;background:#f8f2eb;border-radius:26rpx;max-width:42%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.thumb{position:relative;width:139rpx;height:139rpx;flex-shrink:0}.thumb image{width:100%;height:100%;border-radius:15rpx}.thumb text{position:absolute;bottom:3rpx;right:4rpx;font-size:15rpx;color:#fff;background:#463c3066;border-radius:3rpx;padding:0 4rpx}.project-line{justify-content:space-between;gap:5rpx}.project-owner{font-size:21rpx;flex-shrink:0}.track{display:flex;margin-top:11rpx}.stop{position:relative;text-align:center;flex:1;min-width:0;display:flex;align-items:center;flex-direction:column;gap:4rpx}.stop text{display:block;max-width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:19rpx}.dot{position:relative;border-radius:50%;border:2rpx solid #d3cec7;background:#fff;width:19rpx;height:19rpx;font-size:16rpx;line-height:19rpx;color:#fff}.done .dot{background:#895023;border-color:#895023}.now .dot{border-color:#895023;box-shadow:inset 0 0 0 3rpx #fff;background:#895023}.rail{position:absolute;border-top:2rpx solid #d3cec7;top:11rpx;right:50%;width:100%}.stop:first-child .rail{display:none}.done .rail,.now .rail{border-color:#895023}
.shade{position:fixed;inset:0;z-index:300;background:#0005;display:flex;align-items:flex-end}.sheet{width:100%;box-sizing:border-box;max-height:78vh;margin:0;padding:25rpx 24rpx calc(40rpx + env(safe-area-inset-bottom))}.filters{gap:10rpx;margin:12rpx 0}.filters button{padding:9rpx 14rpx}.active{background:#f6eee4;color:#8b522b;border-radius:18rpx}

.department-status{height:44rpx;display:flex;align-items:center;overflow:hidden}
.department-status > button,
.department-status > text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
