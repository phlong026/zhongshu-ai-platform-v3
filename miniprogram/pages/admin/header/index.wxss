:host{display:block}.header{position:fixed;top:0;left:0;right:0;z-index:90;background:#fdfcf9}.nav{height:82rpx;display:flex;align-items:center;justify-content:center;position:relative;font-size:34rpx;font-weight:700;color:#0b0b0b}.back{position:absolute;left:12rpx;top:0;width:76rpx;height:82rpx;display:flex;align-items:center;justify-content:center;background:transparent}.back image{width:23rpx;height:34rpx}.back::after{border:0}
