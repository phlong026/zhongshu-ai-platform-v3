<view class="owner-page owner-brief">
<owner-header id="brief-header" title="经营简报" back/>
<view class="owner-content">
<view class="owner-period"><text class="owner-muted">金额单位：元</text><picker mode="date" fields="month" value="{{period}}" bindchange="month"><view>{{periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<text wx:if="{{error}}" class="owner-error">{{error}}</text>
<view wx:if="{{brief}}" class="owner-card brief-mode"><view class="owner-heading"><text>{{brief.modeText}}</text><text class="owner-muted">{{brief.periodLabel}}</text></view><text class="owner-muted">{{brief.modeNote}}</text></view>
<block wx:if="{{ready&&brief}}">
<view wx:if="{{brief.degraded}}" class="owner-card"><view class="owner-heading"><text>经营数据</text></view><text class="owner-muted">{{brief.degradedText}}</text><view class="brief-actions"><button class="owner-outline" bindtap="retry">重新加载</button></view></view>
<block wx:else>
<view class="owner-card"><view class="owner-heading"><text>本月概览</text><text class="owner-muted">元</text></view><view class="brief-metrics"><view wx:for="{{brief.metrics}}" wx:key="key" class="brief-metric"><text class="owner-muted">{{item.label}}</text><text class="brief-metric-value">{{item.value}}</text><text class="owner-muted brief-metric-sub">{{item.sub}}</text></view></view></view>
<view class="owner-card"><view class="owner-heading"><text>近 6 月收支趋势</text><text class="owner-muted">元 · 实收/支出</text></view><view wx:for="{{brief.trend}}" wx:key="key" class="brief-trend-row"><text class="brief-trend-label">{{item.label}}</text><view class="brief-trend-bars"><view class="brief-trend-line"><view class="brief-trend-fill income" style="width:{{item.incomeWidth}}%"/><text>收 {{item.incomeText}}</text></view><view class="brief-trend-line"><view class="brief-trend-fill paid" style="width:{{item.paidWidth}}%"/><text>支 {{item.paidText}}</text></view></view></view><view wx:if="{{!brief.trend.length}}" class="owner-empty">暂无趋势数据</view></view>
<view class="owner-card"><view class="owner-heading"><text>收支构成</text><text class="owner-muted">元</text></view><view class="brief-columns"><view class="brief-col"><text class="owner-name">收入 {{brief.income.totalText}}</text><view wx:for="{{brief.income.rows}}" wx:key="key" class="brief-row"><text class="owner-muted owner-grow">{{item.label}}</text><text>{{item.valueText}}</text><text wx:if="{{item.percentText}}" class="owner-muted brief-percent">{{item.percentText}}</text></view><text wx:if="{{brief.income.empty}}" class="owner-muted">暂无收入记录</text></view><view class="brief-col"><text class="owner-name">支出 {{brief.paid.totalText}}</text><view wx:for="{{brief.paid.rows}}" wx:key="key" class="brief-row"><text class="owner-muted owner-grow">{{item.label}}</text><text class="{{item.negative?'brief-negative':''}}">{{item.valueText}}</text></view><text wx:if="{{brief.paid.empty}}" class="owner-muted">暂无支出记录</text></view></view><text class="owner-note">支出合计为净支出：客户退款计入流出，支出退回以负值冲减。</text></view>
<view class="owner-card"><view class="owner-heading"><text>应收应付账龄</text><text class="owner-muted">元</text></view><view class="brief-aging-head"><text>账龄桶</text><text class="brief-num">应收</text><text class="brief-num">应付</text></view><view wx:for="{{brief.aging.rows}}" wx:key="key" class="brief-aging-row"><text class="owner-muted">{{item.label}}</text><text class="brief-num">{{item.receivableText}}</text><text class="brief-num">{{item.payableText}}</text></view><view class="brief-aging-row brief-aging-total"><text>合计</text><text class="brief-num">{{brief.aging.receivableTotalText}}</text><text class="brief-num">{{brief.aging.payableTotalText}}</text></view></view>
<view class="owner-card"><view class="owner-heading"><text>归档快照</text><text class="owner-muted">{{brief.snapshots.countText}}</text></view><text wx:if="{{brief.snapshots.status==='loading'}}" class="owner-muted">{{brief.snapshots.message}}</text><view wx:elif="{{brief.snapshots.status==='error'}}" class="brief-actions"><text class="owner-muted">{{brief.snapshots.message}}</text><button class="owner-outline" bindtap="retry">重新加载</button></view><block wx:else><view wx:for="{{brief.snapshots.rows}}" wx:key="key" class="brief-snapshot"><view class="owner-grow"><text class="owner-name">{{item.versionText}} · {{item.relationText}}</text><text class="owner-muted">截止 {{item.asOfText}} · {{item.noteText}}</text></view><text class="owner-badge">已归档</text></view><view wx:if="{{brief.snapshots.empty}}" class="owner-empty">该月暂无归档快照</view></block><button class="owner-primary brief-archive" bindtap="archive" loading="{{archiveBusy}}" disabled="{{brief.archive.disabled}}">{{brief.archive.label}}</button><text wx:if="{{brief.archive.reason}}" class="owner-muted brief-archive-reason">{{brief.archive.reason}}</text><view wx:if="{{archiveError}}" class="owner-error brief-archive-error">{{archiveError}}</view><text wx:if="{{archiveNotice}}" class="owner-note">{{archiveNotice}}</text><text class="owner-note">{{brief.snapshots.cutoffNote}}</text></view>
</block>
</block>
</view>
</view>
