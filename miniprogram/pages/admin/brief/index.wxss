@import "../owner.wxss";

.brief-mode .owner-heading{justify-content:flex-start;gap:12rpx}
.brief-metrics{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}
.brief-metric{min-width:0;padding:18rpx;border-radius:16rpx;background:#f7f3ed}
.brief-metric text{display:block}
.brief-metric-value{margin:6rpx 0;font-size:var(--zs-font-heading);line-height:48rpx;font-weight:700;color:var(--boss-brown);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brief-metric-sub{font-size:var(--zs-font-caption);line-height:32rpx}
.brief-trend-row{display:flex;gap:16rpx;align-items:center;margin-top:16rpx}
.brief-trend-label{width:64rpx;flex-shrink:0;font-size:var(--zs-font-meta);color:var(--zs-text-3)}
.brief-trend-bars{flex:1;min-width:0}
.brief-trend-line{position:relative;height:36rpx;margin:6rpx 0;border-radius:8rpx;background:#f4f0ea;overflow:hidden}
.brief-trend-line text{position:absolute;left:10rpx;top:0;font-size:var(--zs-font-caption);line-height:36rpx;color:#45372b}
.brief-trend-fill{height:100%;min-width:2rpx}
.brief-trend-fill.income{background:#dcebdc}
.brief-trend-fill.paid{background:#f2dfd5}
.brief-columns{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}
.brief-col{min-width:0}
.brief-row{display:flex;align-items:center;gap:10rpx;margin-top:14rpx;font-size:var(--zs-font-meta);line-height:34rpx}
.brief-percent{flex-shrink:0}
.brief-negative{color:#c4472a}
.brief-aging-head,.brief-aging-row{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:10rpx;align-items:center;padding:12rpx 0;border-bottom:1rpx solid #ebe5dc;font-size:var(--zs-font-meta);line-height:34rpx}
.brief-aging-head{color:var(--zs-text-3)}
.brief-aging-row:last-child{border-bottom:0}
.brief-aging-total{font-weight:600;border-top:1rpx solid #e3ded6}
.brief-num{display:block;text-align:right;font-variant-numeric:tabular-nums}
.brief-snapshot{display:flex;align-items:center;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid #ebe5dc}
.brief-snapshot:last-child{border-bottom:0}
.brief-snapshot text{display:block}
.brief-archive{width:100%;margin-top:20rpx}
.brief-archive-reason{margin-top:10rpx}
.brief-archive-error{margin-top:16rpx}
.brief-actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:16rpx}
@media(max-width:360px){.brief-metrics,.brief-columns{grid-template-columns:1fr}}
