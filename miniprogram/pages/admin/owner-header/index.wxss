:host{display:block}.boss-header{background:#faf8f4;font-family:sans-serif;color:#30291f}.boss-header-row{height:90rpx;display:flex;align-items:center;gap:24rpx;padding:0 28rpx}.boss-brand{width:242rpx;height:62rpx;flex-shrink:0}.boss-divider{height:36rpx;width:1rpx;background:#b68d55}.boss-header-title{font-size:32rpx;line-height:46rpx;font-weight:700;white-space:nowrap}.boss-back{display:flex;align-items:center;justify-content:center;width:54rpx;height:82rpx;margin:0;background:transparent;padding:0}.boss-back::after{border:0}.boss-back image{width:23rpx;height:34rpx}

.boss-back{min-width:44px;min-height:44px;width:88rpx}.boss-workbench{font-family:inherit;min-width:44px;min-height:44px;padding:0 8rpx;background:transparent;color:#89512a;font-size:22rpx;flex-shrink:0}.boss-workbench::after{border:0}.boss-header-title{overflow:hidden;text-overflow:ellipsis}.boss-header-row{gap:8rpx}

.boss-subpage{position:fixed;top:0;left:0;right:0;z-index:100}

.boss-subpage{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:#141312}.boss-subpage .boss-header-row{position:relative;height:87rpx;padding:0}.boss-subpage .boss-back{position:absolute;left:0;top:0;height:87rpx}.boss-subpage .boss-workbench{position:absolute;left:92rpx;top:0;width:88rpx;height:87rpx;padding:0;font-size:22rpx;font-weight:400;line-height:32rpx}.boss-subpage .boss-header-title{position:absolute;left:185rpx;right:185rpx;text-align:center;font-size:30rpx;font-weight:600;line-height:40rpx}

.boss-header{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.boss-header-title{font-size:30rpx;line-height:40rpx;font-weight:600}
