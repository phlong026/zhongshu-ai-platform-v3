<view wx:if="{{back}}" class="subpage-spacer zs-theme" style="height:calc({{statusHeight}}px + 90rpx)"/><view class="boss-header zs-theme {{back?'boss-subpage subpage-shell':''}}" style="padding-top:{{statusHeight}}px"><view class="boss-header-row {{back?'subpage-nav':''}}"><button wx:if="{{back}}" class="boss-back subpage-back" bindtap="back" aria-label="返回"><image src="/assets/creation-back.png" mode="aspectFit"/></button><image wx:else class="boss-brand" src="/assets/brand.png" mode="aspectFit"/><view wx:if="{{!back}}" class="boss-divider"/><button wx:if="{{back}}" class="boss-workbench" bindtap="workbench" aria-label="返回工作台">工作台</button><text class="boss-header-title {{back?'subpage-title':''}}">{{title}}</text></view></view>
