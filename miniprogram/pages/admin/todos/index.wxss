page{background:#f7f5f1;color:#191713}
.owner-todo-page{padding:24rpx 24rpx calc(30rpx + env(safe-area-inset-bottom))}
.owner-todo-page button{box-sizing:border-box;margin:0;font-family:inherit}
.owner-todo-page button::after{border:0}
.tabs{display:flex;gap:8rpx;margin-bottom:22rpx}
.tabs button{flex:1;min-height:88rpx;padding:0;background:none;border-radius:0;color:#776e64;font-size:28rpx}
.tabs button.active{color:#8b522b;border-bottom:4rpx solid #8b522b;font-weight:650}
.filter,.task{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:20rpx 24rpx;background:#fff;border-radius:24rpx}
.filter{font-size:28rpx;margin-bottom:16rpx}
.owner-todo-page .task{width:100%;min-height:104rpx;margin:10rpx 0;text-align:left}
.copy{flex:1;min-width:0;font-size:28rpx;font-weight:650;overflow-wrap:anywhere}
.meta,.hint{display:block;font-size:24rpx;font-weight:400;color:#776e64;line-height:1.5}
.hint{margin:12rpx 0}
.hint button,.action{color:#8b522b;font-size:24rpx;white-space:nowrap}
