<view class="owner-page"><owner-header id="subpage-header" title="{{title}}" back/><view class="owner-content">
<text wx:if="{{error}}" class="owner-error" role="alert">{{error}}</text>
<block wx:if="{{ready}}">
 <view wx:if="{{view==='desk'}}" class="owner-card"><view class="owner-heading"><text>本组织资金与往来</text><picker mode="date" fields="month" value="{{periodText}}" bindchange="month"><text class="owner-muted">{{periodText}}</text></picker></view><view class="owner-statistics"><view class="owner-stat"><text class="owner-stat-label">本月有效实收</text><text class="ops-number">{{incomeText}}</text></view><view class="owner-stat"><text class="owner-stat-label">本月有效已付</text><text class="ops-number">{{paidText}}</text></view></view><view class="ops-menu"><button data-view="receivables" bindtap="go"><text>客户未收</text><text>{{summary.receivableText}}</text></button><button data-view="payables" bindtap="go"><text>剩余应付</text><text>{{summary.payableText}}</text></button><button data-view="funds" bindtap="go"><text>可核对资金</text><text>{{summary.cashText}}</text></button><button data-view="costs" bindtap="go"><text>合同预计毛利</text><text>{{summary.profitText}}</text></button></view><text class="owner-note">未来7天约定应付 {{summary.payableDueText}}，{{summary.payableUndated}}笔待约定付款到期日。本期公司日常费用与已核准绩效结算 {{summary.overheadText}}。资金须核对期初；合同预计毛利尚未扣公司费用，不等于公司净利润。{{summary.unplanned}}个项目待确认分期，{{summary.incompleteCost}}个项目成本待完善。</text></view>
 <view wx:if="{{view==='desk'}}" class="owner-card"><view class="owner-heading"><text>今日待办 {{tasks.length}}</text></view><todo-preview id="today-todos" rows="{{tasks}}" bind:activate="go"/><text wx:if="{{!tasks.length}}" class="owner-muted">今日暂无待办</text></view>
 <view wx:if="{{view==='desk'}}" class="owner-card"><view class="owner-heading"><text>账务办理</text></view><view class="ops-menu"><button data-url="/pages/admin/index?view=finance" bindtap="go">收支明细</button><button data-url="/pages/admin/index?view=todos" bindtap="go">原单办理</button><button data-view="expenses" bindtap="go">项目费用</button><button data-view="expenses" data-id="company:{{actor.companyId}}" bindtap="go">公司日常费用</button><button data-view="receivables" bindtap="go">合同应收与催收</button><button data-view="direct" bindtap="go">业主直付核对</button><button data-view="intercompany" bindtap="go">总部门店材料往来</button></view></view>
 <picker wx:if="{{view!=='desk' && view!=='funds'}}" range="{{projectNames}}" bindchange="project"><view class="ops-select {{view==='receivables'?'ar-project-select':''}}">{{selected?selected.name:'选择需要办理的项目'}} ›</view></picker>
 <view wx:if="{{view!=='desk' && view!=='funds' && view!=='payables' && view!=='direct' && view!=='intercompany' && !selected}}" class="owner-card"><list-row wx:for="{{rows}}" wx:key="id" custom-class="ops-link" data-view="{{view}}" data-id="{{item.id}}" bind:activate="go"><text slot="title">{{item.name}} · {{item.stage}}</text><text slot="detail" class="owner-muted">合同 {{item.totalText}} · 未收 {{item.remainingText}} · 责任人 {{item.owner||'待核对'}}</text></list-row><text wx:if="{{!rows.length}}" class="owner-muted">暂无本人授权项目，请先完成合同或工程建档。</text></view>
 <view wx:if="{{view==='payables'}}" class="owner-card"><text class="owner-name">原单应付与实际已付</text><block wx:for="{{payables}}" wx:key="id"><list-row wx:if="{{item.url}}" custom-class="ops-link" data-url="{{item.url}}" bind:activate="go"><text slot="title">{{item.customer}} · {{item.name}}</text><text slot="detail" class="owner-muted">约定 {{item.totalText}} · 已付 {{item.paidText}} · 剩余 {{item.remainingText}}</text><text slot="extra" class="owner-muted">{{item.status}} · 付款到期 {{item.due||'未约定'}}</text></list-row><list-row wx:else interactive="{{false}}" custom-class="ops-link"><text slot="title">{{item.customer}} · {{item.name}}</text><text slot="detail" class="owner-muted">约定 {{item.totalText}} · 已付 {{item.paidText}} · 剩余 {{item.remainingText}}</text><text slot="extra" class="owner-muted">{{item.status}} · 付款到期 {{item.due||'未约定'}}</text></list-row></block><text wx:if="{{!payables.length}}" class="owner-muted">当前没有应付事项</text></view>
 <view wx:if="{{view==='intercompany'}}" class="owner-card"><text class="owner-name">总部代垫与门店归还</text><view wx:for="{{accounts}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.name}} · {{item.origin}}</text><text class="owner-muted">总部已垫 {{item.advancedText}} · 门店已还 {{item.repaidText}} · 未还 {{item.remainingText}}</text><text class="owner-muted">总部实际核收 {{item.receivedText}} · 在途待核 {{item.unconfirmedText}}</text><button wx:if="{{actor.orgType!=='headquarters' && item.remaining>0 && isFinance}}" class="owner-outline" data-url="{{item.url}}" bindtap="go">从原代垫清算单办理归还</button></view><text wx:if="{{!accounts.length}}" class="owner-muted">当前没有总部代垫材料事项</text></view>
 <view wx:if="{{view==='direct'}}" class="owner-card"><text class="owner-name">业主直接支付原单</text><view wx:for="{{direct}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.name}}</text><text class="owner-muted">约定 {{item.totalText}} · 已核实 {{item.paidText}} · 剩余可登记 {{item.remainingText}}</text><button wx:if="{{isFinance && item.reserved<item.total}}" class="owner-primary" data-action="direct-register" data-id="{{item.id}}" bindtap="perform">登记本笔业主实际直付</button><view wx:for="{{item.records}}" wx:for-item="record" wx:key="id" class="ops-parts"><text class="owner-muted">{{record.date}} · {{record.amountText}} · {{record.status}}</text></view></view><block wx:if="{{isFinance}}"><input class="ops-field ops-expense-amount" data-key="amount" value="{{form.amount}}" type="digit" bindinput="input" placeholder="本次实际直付金额（元）"/><input class="ops-field" data-key="transaction" value="{{form.transaction}}" bindinput="input" placeholder="业主向供应商支付的唯一流水"/><picker mode="date" data-key="date" bindchange="input"><view class="ops-field">实际直付日：{{form.date}}</view></picker></block><text wx:if="{{!direct.length}}" class="owner-muted">当前没有业主直付事项</text></view>
  <block wx:if="{{view==='receivables' && selected}}">
 <view class="owner-card ar-summary-card"><view class="ar-summary-heading"><view class="ar-summary-title"><text class="owner-name">{{selected.name}}</text><text class="owner-muted">{{receivable.caption}}</text></view><text class="ar-status ar-status-{{receivable.statusTone}}">{{receivable.status}}</text></view><view class="ar-balance"><text class="ar-label">当前待收</text><text class="ar-balance-value">{{receivable.remainingText}}</text></view><view class="ar-summary-metrics"><view class="ar-summary-metric"><text class="ar-label">合同应收</text><text class="ar-metric-value">{{receivable.totalText}}</text></view><view class="ar-summary-metric"><text class="ar-label">累计已收</text><text class="ar-metric-value">{{receivable.receivedText}}</text></view></view><view class="ar-owner-line"><text>业务责任人</text><text>{{receivable.owner||'待核对原业务负责人'}}</text></view></view>
 <view wx:for="{{receivable.rows}}" wx:key="id" class="owner-card ar-stage-card"><view class="ar-stage-heading"><view class="ar-stage-title"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.stageLabel}}</text></view><text class="ar-status ar-status-{{item.statusTone}}">{{item.status}}</text></view><view class="ar-stage-metrics"><view><text class="ar-label">本期应收</text><text class="ar-stage-amount">{{item.amountText}}</text></view><view><text class="ar-label">本期已收</text><text class="ar-stage-amount">{{item.paidText}}</text></view><view><text class="ar-label">本期待收</text><text class="ar-stage-amount ar-stage-remaining">{{item.remainingText}}</text></view></view><view class="ar-due-line"><text>约定到期</text><text>{{item.due||'待约定'}}</text></view><button wx:if="{{item.actionUrl}}" class="owner-primary ar-stage-action" data-url="{{item.actionUrl}}" bindtap="go">{{item.actionLabel}}</button></view>
 <view wx:if="{{!receivable.rows.length}}" class="owner-card ar-empty-card"><text>{{receivable.emptyText}}</text></view>
 <view wx:if="{{receivable.contractFile}}" class="owner-card ar-reference-card"><view><text class="owner-name">已签合同依据</text><text class="owner-muted">{{receivable.contractFileName}} · 收款计划 V{{receivable.planVersion}}</text></view><button class="ar-reference-link" data-file="{{receivable.contractFile}}" bindtap="previewFile">预览凭据 ›</button></view>
 <view wx:if="{{canPlan}}" class="owner-card ar-editor-card"><view class="owner-heading"><text>补录合同付款约定</text></view><text class="owner-muted ar-editor-note">仅补录历史项目缺少的分期，保存即生效。</text><view wx:for="{{installments}}" wx:key="index" class="ar-editor-row"><text class="ar-editor-index">第{{index+1}}期</text><label class="ar-field-label">款项名称<input class="ops-field" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="installment" placeholder="例如开工款"/></label><label class="ar-field-label">本期金额<input class="ops-field" type="digit" value="{{item.amount}}" data-index="{{index}}" data-key="amount" bindinput="installment" placeholder="请输入金额（元）"/></label><label class="ar-field-label">约定到期日<picker mode="date" value="{{item.due}}" data-index="{{index}}" data-key="due" bindchange="installment"><view class="ops-field">{{item.due||'请选择到期日'}}</view></picker></label><label class="ar-field-label">推进条件<picker range="{{stageNames}}" data-index="{{index}}" bindchange="installmentStage"><view class="ops-field">需在{{item.stageName}}前满足</view></picker></label><button class="owner-link ar-remove-link" data-index="{{index}}" bindtap="remove">移除此期</button></view><view class="ar-legacy-evidence"><text class="ar-field-label">合同依据（沿用已签合同或补充凭据）</text><button class="owner-outline" bindtap="upload">{{form.file?'重新选择合同依据':'选择合同依据'}}</button><button wx:if="{{sampleEnabled}}" class="owner-outline" data-sample-key="file" bindtap="useSampleFile">{{sampleLabel}}</button><button wx:if="{{form.file}}" class="owner-link" bindtap="previewFile">预览合同依据</button></view><view class="ops-actions ar-editor-actions"><button class="owner-outline" bindtap="add">增加一期</button><button class="owner-primary" data-action="plan-submit" bindtap="perform" loading="{{busy}}" disabled="{{busy}}">保存付款约定</button></view></view>
 <view class="ar-bottom-links"><button wx:if="{{isFinance || isBoss}}" data-url="{{selected.financeUrl}}" bindtap="go">收款流水 ›</button><button data-view="credit" bindtap="go">收款条件与放行 ›</button></view>
 </block>
 <block wx:if="{{view==='expenses' && selected}}"><view class="owner-card"><view class="owner-heading"><text>费用与应付</text></view><view wx:for="{{expenses}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.name}} · {{item.amountText}}</text><text class="owner-muted">{{item.category}} · {{item.purposeText}} · 发生{{item.date}} · 到期{{item.due}} · {{item.statusText}}</text><text wx:if="{{item.approval.note}}" class="owner-muted">意见：{{item.approval.note}}</text><button wx:if="{{canTransfer && (item.status==='pending'||item.status==='returned')}}" class="owner-link" data-id="{{item.id}}" data-action="expense-transfer" bindtap="perform">将本原费用交接给所选在岗财务</button><button wx:if="{{(item.status==='pending'||item.status==='returned') && (item.custodianPersonId||item.applicantPersonId)===actor.personId}}" class="owner-link" data-id="{{item.id}}" data-action="expense-cancel" bindtap="perform">说明原因并撤回未批准费用</button><button wx:if="{{item.status==='returned' && (item.custodianId||item.applicantId)===actor.staffId}}" class="owner-outline" data-id="{{item.id}}" bindtap="editExpense">补充原费用重新提交</button><view wx:if="{{canApprove && item.status==='pending'}}" class="ops-actions"><button class="owner-primary" data-id="{{item.id}}" data-action="expense-approve" bindtap="perform">批准费用</button><button class="owner-outline" data-id="{{item.id}}" data-action="expense-return" bindtap="perform">退回补充</button></view></view><button class="owner-outline" data-url="/pages/admin/index?view=todos" bindtap="go">进入原单付款办理</button></view>
 <view wx:if="{{canSubmitExpense}}" class="owner-card"><text class="owner-name">{{selected.operatingOnly?'提交公司已发生费用':'提交项目已发生费用'}}</text><picker wx:if="{{expenseNodes.length}}" range="{{expenseNodes}}" range-key="name" value="{{expenseNodeIndex}}" data-key="nodeId" bindchange="pick"><view class="ops-field">施工节点：{{expenseNodes[expenseNodeIndex].name}}</view></picker><picker range="{{categories}}" data-key="category" bindchange="pick"><view class="ops-field">费用类别：{{form.category}}</view></picker><picker range="{{purposes}}" data-key="purpose" bindchange="pick"><view class="ops-field">经营用途：{{form.purpose||'请选择'}}</view></picker><input class="ops-field ops-expense-name" data-key="name" bindinput="input" value="{{form.name}}" placeholder="费用事项，例如短视频推广"/><input class="ops-field ops-expense-amount" data-key="amount" bindinput="input" value="{{form.amount}}" type="digit" placeholder="金额（元）"/><input class="ops-field" data-key="reference" bindinput="input" value="{{form.reference}}" placeholder="唯一费用凭据编号"/><input class="ops-field" data-key="recipient" bindinput="input" value="{{form.recipient}}" placeholder="实际收款方"/><picker mode="date" data-key="date" bindchange="input"><view class="ops-field">发生日：{{form.date}}</view></picker><picker mode="date" data-key="due" bindchange="input"><view class="ops-field">付款到期：{{form.due||'请选择'}}</view></picker></view></block>
 <block wx:if="{{view==='costs' && selected}}"><view class="owner-card"><text class="owner-name">{{selected.name}}</text><text class="ops-number">已发生成本 {{selected.costText}}</text><text class="owner-name">合同预计毛利 {{selected.profitText}}</text><view wx:for="{{selected.costRows}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.category}} · {{item.name}}</text><text class="owner-muted">已发生 {{item.amountText}} · 已约定 {{item.committedText}} · {{item.payer}}</text></view></view></block>
 <view wx:if="{{view==='credit' && selected}}" class="owner-card"><text class="owner-name">合同收款条件与放行</text><view wx:for="{{selected.gates}}" wx:key="stage" class="ops-parts"><text class="owner-name">{{item.name}} · {{item.allowed?'可推进':'待补足收款或放行'}}</text><text class="owner-muted">{{item.configured?'约定累计需收 '+item.requiredText+' · 已核实 '+item.receivedText+' · 差额 '+item.shortageText:item.note}}</text><text wx:if="{{item.exception}}" class="owner-muted">已放行：{{item.exception.note}}（{{item.exception.by}}）</text></view><text class="owner-muted">项目负责人：{{selected.owner||'待核对'}}，差额与催收请线下跟进，系统只留痕。</text><picker wx:if="{{canApprove}}" range="{{stageNames}}" data-key="stage" bindchange="pick"><view class="ops-field">放行阶段：{{form.stage}}</view></picker><button wx:if="{{canApprove}}" class="owner-primary" data-action="credit-exception" bindtap="perform">一键放行登记</button><text wx:else class="owner-muted">放行登记由本组织老板办理，请从合同应收核对原款项。</text></view>
 <view wx:if="{{view==='funds'}}" class="owner-card"><text class="owner-name">公司资金核对</text><text class="ops-number">{{summary.cashText}}</text><block wx:if="{{canConfirm}}"><picker mode="date" data-key="date" bindchange="input"><view class="ops-field">期初日：{{form.date}}</view></picker><input class="ops-field" type="digit" data-key="amount" bindinput="input" value="{{form.amount}}" placeholder="该日开始前的可核对余额（元）"/><button class="owner-primary" data-action="funds-confirm" bindtap="perform">确认资金期初及依据</button></block></view>
 <view wx:if="{{view!=='desk' && view!=='receivables' && (selected || view==='funds' || view==='direct') && (view!=='costs'||canConfirm) && (view!=='settlement'||canClose&&selected.settlement.ready&&!selected.settlement.closed)}}" class="owner-card"><text class="owner-name">本次办理依据</text><picker wx:if="{{view==='expenses' && canTransfer}}" range="{{handoverStaff}}" range-key="name" data-key="assignee" bindchange="pick"><view class="ops-field">原经办离岗或交接时选择接替财务：{{form.assignee||'请选择'}}</view></picker><textarea class="ops-field ops-note" data-key="note" value="{{form.note}}" bindinput="input" placeholder="核对意见、例外原因或补充说明"/><button class="owner-outline" bindtap="upload">{{form.file?'重新选择实际依据':'上传实际依据'}}</button><button wx:if="{{sampleEnabled}}" class="owner-outline" data-sample-key="file" bindtap="useSampleFile">{{sampleLabel}}</button><button wx:if="{{form.file}}" class="owner-outline" bindtap="previewFile">预览已选依据{{form.file.sample?' · 体验模拟资料':''}}</button><button class="ops-check" bindtap="toggle">{{form.checked?'☑':'☐'}} 已核对本项目、当前版本、金额和依据</button></view>
 <view wx:if="{{samplePreview}}" class="owner-card"><text class="owner-name">{{samplePreview.name}}</text><text class="owner-muted">{{samplePreview.sample?'体验模拟资料':'文件说明'}}</text><text class="owner-note">{{samplePreview.text}}</text><button class="owner-outline" bindtap="closeSamplePreview">关闭预览</button></view>
<view wx:if="{{view==='expenses'&&canSubmitExpense}}" class="owner-card ops-final-actions"><text class="owner-note">超出门店费用线需老板确认。</text><button wx:if="{{view==='expenses'&&canSubmitExpense}}" class="owner-primary owner-save" data-action="expense-submit" bindtap="perform" loading="{{busy}}">提交费用</button></view></block></view><owner-nav wx:if="{{isBoss}}" active="finance"/><custom-tab-bar wx:elif="{{isFinance}}" active-index="17" nested="{{true}}"/></view>
