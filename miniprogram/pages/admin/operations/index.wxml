<view class="owner-page"><owner-header title="{{title}}"/><view class="owner-content">
<button class="owner-link" bindtap="back">返回上一页</button><text wx:if="{{error}}" class="owner-error" role="alert">{{error}}</text>
<block wx:if="{{ready}}">
 <view wx:if="{{view==='desk'}}" class="owner-card"><view class="owner-heading"><text>本组织资金与往来</text><picker mode="date" fields="month" value="{{period}}" bindchange="month"><text class="owner-muted">{{period}}</text></picker></view><view class="owner-statistics"><view class="owner-stat"><text class="owner-stat-label">本月有效实收</text><text class="ops-number">{{incomeText}}</text></view><view class="owner-stat"><text class="owner-stat-label">本月有效已付</text><text class="ops-number">{{paidText}}</text></view></view><view class="ops-menu"><button data-view="receivables" bindtap="go"><text>客户未收</text><text>{{summary.receivableText}}</text></button><button data-view="payables" bindtap="go"><text>剩余应付</text><text>{{summary.payableText}}</text></button><button data-view="funds" bindtap="go"><text>可核对资金</text><text>{{summary.cashText}}</text></button><button data-view="costs" bindtap="go"><text>合同预计毛利</text><text>{{summary.profitText}}</text></button></view><text class="owner-note">未来7天约定应付 {{summary.payableDueText}}，{{summary.payableUndated}}笔待约定付款到期日。本期公司日常费用与已核准绩效结算 {{summary.overheadText}}。资金须核对期初；合同预计毛利尚未扣公司费用，不等于公司净利润。{{summary.unplanned}}个项目待确认分期，{{summary.incompleteCost}}个项目成本待完善。</text></view>
 <view wx:if="{{view==='desk'}}" class="owner-card"><view class="owner-heading"><text>待我办理 {{tasks.length}}</text></view><button wx:for="{{tasks}}" wx:key="key" class="ops-link" data-url="{{item.url}}" bindtap="go"><text>{{item.name}}</text><text class="owner-muted">{{item.status}} · {{item.amount}}</text></button><text wx:if="{{!tasks.length}}" class="owner-muted">当前没有本人可办事项</text></view>
 <view wx:if="{{view==='desk'}}" class="owner-card"><view class="owner-heading"><text>项目账目与业务办理</text></view><view class="ops-menu"><button data-url="/pages/admin/index?view=finance" bindtap="go">收支明细</button><button data-url="/pages/admin/index?view=todos" bindtap="go">原单办理</button><button data-view="expenses" bindtap="go">项目费用申请与审批</button><button data-view="expenses" data-id="company:{{actor.companyId}}" bindtap="go">公司日常费用</button><button data-view="payroll" bindtap="go">绩效金额结算</button><button data-view="receivables" bindtap="go">合同应收与催收</button><button data-view="direct" bindtap="go">业主直付核对</button><button data-view="intercompany" bindtap="go">总部门店材料往来</button></view></view>
 <picker wx:if="{{view!=='desk' && view!=='funds' && view!=='payroll'}}" range="{{projectNames}}" bindchange="project"><view class="ops-select">{{selected?selected.name:'选择需要办理的项目'}} ›</view></picker>
 <view wx:if="{{view!=='desk' && view!=='funds' && view!=='payables' && view!=='direct' && view!=='intercompany' && view!=='payroll' && !selected}}" class="owner-card"><button wx:for="{{rows}}" wx:key="id" class="ops-link" data-view="{{view}}" data-id="{{item.id}}" bindtap="go"><text>{{item.name}} · {{item.stage}}</text><text class="owner-muted">合同 {{item.totalText}} · 未收 {{item.remainingText}} · 责任人 {{item.owner||'待核对'}}</text></button><text wx:if="{{!rows.length}}" class="owner-muted">暂无本人授权项目，请先完成合同或工程建档。</text></view>
 <view wx:if="{{view==='payables'}}" class="owner-card"><text class="owner-name">原单应付与实际已付</text><button wx:for="{{payables}}" wx:key="id" class="ops-link" data-url="{{item.url}}" bindtap="go"><text>{{item.customer}} · {{item.name}}</text><text class="owner-muted">约定 {{item.totalText}} · 已付 {{item.paidText}} · 剩余 {{item.remainingText}}</text><text class="owner-muted">{{item.status}} · 付款到期 {{item.due||'未约定'}}</text></button><text wx:if="{{!payables.length}}" class="owner-muted">当前没有应付事项</text></view>
 <view wx:if="{{view==='payroll'}}" class="owner-card"><text class="owner-name">从已归档绩效到财务发放</text><text class="owner-note">由老板按实际制度配置本期固定绩效金额、指标和单价；签约指标的单价填写百分比。没有规则时不编造提成。财务生成后由老板核准，继续从同一原单登记实际付款。工资、税费等另按公司制度办理。</text><view wx:for="{{payroll}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.name}} · {{item.period}} · {{item.amountText}}</text><text class="owner-muted">{{item.metric}} · 数量/分值 {{item.quantity}} · {{item.statusText}}</text><button wx:if="{{canApprove && (!item.settlement || item.settlement.status==='returned')}}" class="owner-outline" data-id="{{item.id}}" data-action="payroll-policy" bindtap="perform">确认本期计费规则</button><button wx:if="{{isFinance && item.policy && (!item.settlement || item.settlement.status==='returned')}}" class="owner-primary" data-id="{{item.id}}" data-action="payroll-submit" bindtap="perform">按归档结果生成结算</button><view wx:if="{{canApprove && item.settlement.status==='pending'}}" class="ops-actions"><button class="owner-primary" data-id="{{item.id}}" data-action="payroll-approve" bindtap="perform">核准结算金额</button><button class="owner-outline" data-id="{{item.id}}" data-action="payroll-return" bindtap="perform">退回核对</button></view><button wx:if="{{item.settlement.status==='approved' && isFinance}}" class="owner-outline" data-url="{{item.payableUrl}}" bindtap="go">办理本期实际发放</button></view><text wx:if="{{!payroll.length}}" class="owner-muted">本期尚无已归档个人绩效，请先完成来源核对、复核和归档。</text><block wx:if="{{canApprove}}"><input class="ops-field" data-key="base" value="{{form.base}}" type="digit" bindinput="input" placeholder="本期固定绩效金额（元，无则填0）"/><picker range="{{payrollMetrics}}" range-key="name" data-key="metric" bindchange="pick"><view class="ops-field">指标：{{form.metric||'请选择实际制度规定的指标'}}</view></picker><input class="ops-field" data-key="rate" value="{{form.rate}}" type="digit" bindinput="input" placeholder="单价（元/项）或签约比例（%）"/></block></view>
 <view wx:if="{{view==='intercompany'}}" class="owner-card"><text class="owner-name">总部代垫与门店归还</text><text class="owner-note">总部向供应商支付记总部现金；项目仍按原材料计成本。门店归还后，总部须单独查实到账，双方以同一原单勾稽。</text><view wx:for="{{accounts}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.name}} · {{item.origin}}</text><text class="owner-muted">总部已垫 {{item.advancedText}} · 门店已还 {{item.repaidText}} · 未还 {{item.remainingText}}</text><text class="owner-muted">总部实际核收 {{item.receivedText}} · 在途待核 {{item.unconfirmedText}}</text><button wx:if="{{actor.orgType!=='headquarters' && item.remaining>0 && isFinance}}" class="owner-outline" data-url="{{item.url}}" bindtap="go">从原代垫清算单办理归还</button></view><text wx:if="{{!accounts.length}}" class="owner-muted">当前没有总部代垫材料事项</text></view>
 <view wx:if="{{view==='direct'}}" class="owner-card"><text class="owner-name">业主直接支付原单</text><text class="owner-note">先由老板确认原供应约定，再由财务核实业主付款；与公司银行收支分别展示，不冲抵客户合同款。</text><view wx:for="{{direct}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.name}}</text><text class="owner-muted">约定 {{item.totalText}} · 已核实 {{item.paidText}} · 剩余可登记 {{item.remainingText}}</text><button wx:if="{{canApprove && !item.approval}}" class="owner-primary" data-action="direct-approve" data-id="{{item.id}}" bindtap="perform">确认本版业主直付约定</button><button wx:if="{{isFinance && item.approval && item.reserved<item.total}}" class="owner-primary" data-action="direct-register" data-id="{{item.id}}" bindtap="perform">登记本笔业主实际直付</button><view wx:for="{{item.records}}" wx:for-item="record" wx:key="id" class="ops-parts"><text class="owner-muted">{{record.date}} · {{record.amountText}} · {{record.status}}</text><view wx:if="{{actor.role==='finance-lead' && record.status==='待复核' && record.registrarPersonId!==actor.personId}}" class="ops-actions"><button class="owner-primary" data-action="direct-review" data-id="{{record.id}}" bindtap="perform">独立核实本笔直付</button><button class="owner-outline" data-action="direct-return" data-id="{{record.id}}" bindtap="perform">退回重新核查</button></view></view></view><block wx:if="{{isFinance}}"><input class="ops-field" data-key="amount" value="{{form.amount}}" type="digit" bindinput="input" placeholder="本次实际直付金额（元）"/><input class="ops-field" data-key="transaction" value="{{form.transaction}}" bindinput="input" placeholder="业主向供应商支付的唯一流水"/><picker mode="date" data-key="date" bindchange="input"><view class="ops-field">实际直付日：{{form.date}}</view></picker></block><text wx:if="{{!direct.length}}" class="owner-muted">当前没有业主直付事项</text></view>
 <block wx:if="{{view==='receivables' && selected}}">
 <view class="owner-card"><view class="owner-heading"><text>{{selected.name}} · 合同应收</text></view><text class="owner-name">合同 {{selected.totalText}} · 未收 {{selected.remainingText}}</text><text class="owner-muted">催收责任：{{selected.owner||'待核对原业务负责人'}}</text><button wx:if="{{isFinance || isBoss}}" class="owner-outline" data-url="/pages/admin/index?view=finance&id={{selected.id}}" bindtap="go">核对同项目实际收款与凭据</button><text class="owner-note">{{selected.unplanned?'尚未批准本版分期，未擅自设置首款比例；请业务提交后交老板确认。':'已按本版合同约定核对，实收按到期顺序覆盖各期。'}}</text><view wx:for="{{selected.installments}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.name}} · {{item.due}}</text><text class="owner-muted">约定 {{item.amountText}} · 已收 {{item.paidText}} · 未收 {{item.remainingText}}{{item.overdue?' · 已逾期':''}}</text></view><button class="owner-outline" data-view="credit" bindtap="go">查看阶段收款条件与例外</button></view>
 <view wx:if="{{canPlan}}" class="owner-card"><view class="owner-heading"><text>按合同填写付款约定</text></view><text class="owner-note">每期合计必须等于有效合同额，不改变已批准合同金额。合同变更后重新提交本版约定。</text><view wx:for="{{installments}}" wx:key="index" class="ops-parts"><input class="ops-field" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="installment" placeholder="款项名称"/><input class="ops-field" type="digit" value="{{item.amount}}" data-index="{{index}}" data-key="amount" bindinput="installment" placeholder="本期金额（元）"/><picker mode="date" value="{{item.due}}" data-index="{{index}}" data-key="due" bindchange="installment"><view class="ops-field">到期日：{{item.due||'请选择'}}</view></picker><picker range="{{stageNames}}" data-index="{{index}}" bindchange="installmentStage"><view class="ops-field">需在{{item.stageName}}前满足</view></picker><button class="owner-link" data-index="{{index}}" bindtap="remove">移除此期</button></view><view class="ops-actions"><button class="owner-outline" bindtap="add">增加一期</button><button class="owner-primary" data-action="plan-submit" bindtap="perform" loading="{{busy}}">提交老板确认</button></view></view>
 <view wx:if="{{plan}}" class="owner-card"><text class="owner-name">付款约定 V{{plan.version}} · {{plan.status==='approved'?'已批准':plan.status==='returned'?'已退回':'待老板处理'}}</text><view wx:if="{{canApprove && plan.status==='pending'}}" class="ops-actions"><button class="owner-primary" data-action="plan-approve" bindtap="perform">批准本版约定</button><button class="owner-outline" data-action="plan-return" bindtap="perform">退回补充</button></view></view>
 </block>
 <block wx:if="{{view==='expenses' && selected}}"><view class="owner-card"><view class="owner-heading"><text>费用与应付</text></view><text class="owner-note">费用发生、付款申请、实际支付分别记录。费用经老板批准后进入成本及原单应付，财务继续登记真实支付。</text><view wx:for="{{expenses}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.name}} · {{item.amountText}}</text><text class="owner-muted">{{item.category}} · 发生{{item.date}} · 到期{{item.due}} · {{item.statusText}}</text><text wx:if="{{item.approval.note}}" class="owner-muted">意见：{{item.approval.note}}</text><button wx:if="{{canTransfer && (item.status==='pending'||item.status==='returned')}}" class="owner-link" data-id="{{item.id}}" data-action="expense-transfer" bindtap="perform">将本原费用交接给所选在岗财务</button><button wx:if="{{(item.status==='pending'||item.status==='returned') && (item.custodianPersonId||item.applicantPersonId)===actor.personId}}" class="owner-link" data-id="{{item.id}}" data-action="expense-cancel" bindtap="perform">说明原因并撤回未批准费用</button><button wx:if="{{item.status==='returned' && (item.custodianId||item.applicantId)===actor.staffId}}" class="owner-outline" data-id="{{item.id}}" bindtap="editExpense">补充原费用重新提交</button><view wx:if="{{canApprove && item.status==='pending'}}" class="ops-actions"><button class="owner-primary" data-id="{{item.id}}" data-action="expense-approve" bindtap="perform">批准费用</button><button class="owner-outline" data-id="{{item.id}}" data-action="expense-return" bindtap="perform">退回补充</button></view></view><button class="owner-outline" data-url="/pages/admin/index?view=todos" bindtap="go">进入原单付款办理</button></view>
 <view wx:if="{{canSubmitExpense}}" class="owner-card"><text class="owner-name">提交项目已发生费用</text><picker range="{{categories}}" data-key="category" bindchange="pick"><view class="ops-field">{{form.category}}</view></picker><input class="ops-field" data-key="name" bindinput="input" value="{{form.name}}" placeholder="费用事项，例如基础施工劳务"/><input class="ops-field" data-key="amount" bindinput="input" value="{{form.amount}}" type="digit" placeholder="金额（元）"/><input class="ops-field" data-key="reference" bindinput="input" value="{{form.reference}}" placeholder="唯一费用凭据编号"/><input class="ops-field" data-key="recipient" bindinput="input" value="{{form.recipient}}" placeholder="实际收款方"/><picker mode="date" data-key="date" bindchange="input"><view class="ops-field">发生日：{{form.date}}</view></picker><picker mode="date" data-key="due" bindchange="input"><view class="ops-field">付款到期：{{form.due||'请选择'}}</view></picker><button class="owner-primary" data-action="expense-submit" bindtap="perform" loading="{{busy}}">提交老板审批</button></view></block>
 <block wx:if="{{view==='costs' && selected}}"><view class="owner-card"><text class="owner-name">{{selected.name}}</text><text class="ops-number">已发生成本 {{selected.costText}}</text><text class="owner-name">合同预计毛利 {{selected.profitText}}</text><text class="owner-note">现场直供材料按合格实收计项目成本，未付款也属于已发生成本。缺少成本核对、费用尚未批准或退料待结算时不输出确定毛利。</text><view wx:for="{{selected.costRows}}" wx:key="id" class="ops-parts"><text class="owner-name">{{item.category}} · {{item.name}}</text><text class="owner-muted">已发生 {{item.amountText}} · 已约定 {{item.committedText}} · {{item.payer}}</text></view></view><view wx:if="{{canConfirm}}" class="owner-card"><text class="owner-name">逐类核对剩余预计成本</text><text class="owner-note">没有剩余也需明确填写0；费用或材料事实变化后重新核对。</text><input wx:for="{{categories}}" wx:key="*this" class="ops-field" type="digit" data-key="remaining.{{item}}" value="{{form.remaining[item]}}" bindinput="input" placeholder="{{item}}剩余预计成本（元）"/><button class="owner-primary" data-action="cost-confirm" bindtap="perform">确认成本完整度与预测</button></view></block>
 <view wx:if="{{view==='credit' && selected}}" class="owner-card"><text class="owner-name">合同收款条件</text><view wx:for="{{selected.gates}}" wx:key="stage" class="ops-parts"><text class="owner-name">{{item.name}} · {{item.allowed?'可推进':'待补足收款或老板特批'}}</text><text class="owner-muted">{{item.configured?'约定累计需收 '+item.requiredText+' · 已核实 '+item.receivedText+' · 差额 '+item.shortageText:item.note}}</text><text wx:if="{{item.exception}}" class="owner-muted">本阶段例外有效至 {{item.exception.until}}</text></view><text class="owner-note">已批准的分期决定各阶段是否可推进。缺款时保留原款项及催收责任，老板可登记限额限期的阶段例外。</text><picker range="{{stageNames}}" data-key="stage" bindchange="pick"><view class="ops-field">阶段：{{form.stage}}</view></picker><input wx:if="{{canApprove}}" class="ops-field" type="digit" data-key="amount" bindinput="input" value="{{form.amount}}" placeholder="本次允许暂欠额度（元）"/><picker wx:if="{{canApprove}}" mode="date" data-key="until" bindchange="input"><view class="ops-field">例外到期：{{form.until||'请选择'}}</view></picker><button wx:if="{{canApprove}}" class="owner-primary" data-action="credit-exception" bindtap="perform">老板确认本阶段例外</button><text wx:else class="owner-muted">例外由本组织老板办理，请从合同应收核对原款项。</text></view>
 <view wx:if="{{view==='funds'}}" class="owner-card"><text class="owner-name">公司资金核对</text><text class="ops-number">{{summary.cashText}}</text><text class="owner-note">按已核对期初加实际收付款计算；没有期初时显示待完善，不把本月净额当银行余额。请用全部资金账户对账依据核对，受限资金需在说明中明确。</text><block wx:if="{{canConfirm}}"><picker mode="date" data-key="date" bindchange="input"><view class="ops-field">期初日：{{form.date}}</view></picker><input class="ops-field" type="digit" data-key="amount" bindinput="input" value="{{form.amount}}" placeholder="该日开始前的可核对余额（元）"/><button class="owner-primary" data-action="funds-confirm" bindtap="perform">确认资金期初及依据</button></block></view>
 <view wx:if="{{view!=='desk' && (selected || view==='funds' || view==='direct' || view==='payroll')}}" class="owner-card"><text class="owner-name">本次办理依据</text><picker wx:if="{{view==='expenses' && canTransfer}}" range="{{handoverStaff}}" range-key="name" data-key="assignee" bindchange="pick"><view class="ops-field">原经办离岗或交接时选择接替财务：{{form.assignee||'请选择'}}</view></picker><textarea class="ops-field ops-note" data-key="note" value="{{form.note}}" bindinput="input" placeholder="核对意见、例外原因或补充说明"/><button class="owner-outline" bindtap="upload">{{form.file?'已选择：'+form.file.name:'上传实际依据或示例凭据'}}</button><button class="ops-check" bindtap="toggle">{{form.checked?'☑':'☐'}} 已核对本项目、当前版本、金额和依据</button></view>
</block></view><owner-nav wx:if="{{isBoss}}" active="finance"/><custom-tab-bar wx:elif="{{isFinance}}" active-index="{{14}}" nested="{{true}}"/></view>
