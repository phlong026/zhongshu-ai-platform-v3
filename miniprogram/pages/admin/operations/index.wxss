@import "../owner.wxss";
.ops-field{display:block;margin:14rpx 0;padding:18rpx 20rpx;border:1rpx solid #e5ddd3;border-radius:12rpx;font-size:28rpx;line-height:42rpx;background:#fff;box-sizing:border-box;width:100%}.ops-note{height:130rpx}.ops-link{padding:20rpx 0;background:transparent;text-align:left;border-bottom:1rpx solid #eee7de;font-size:28rpx;line-height:42rpx}.ops-link text{display:block}.ops-actions{display:flex;gap:16rpx;margin-top:18rpx;flex-wrap:wrap}.ops-actions button{flex:1;min-width:200rpx}.ops-select{padding:20rpx;background:#fff;border-radius:18rpx;margin-bottom:20rpx}.ops-check{padding:20rpx 0;font-size:26rpx;color:#75451f}.ops-parts{padding:18rpx 0;border-bottom:1rpx solid #eee7de}.ops-number{font-size:36rpx;line-height:54rpx;font-weight:700;color:#75451f}.ops-menu{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.ops-menu button{padding:22rpx 12rpx;background:#f5eee4;font-size:28rpx;line-height:42rpx}.ops-menu button text{display:block}.owner-error{white-space:pre-wrap}

input.ops-field{height:88rpx;min-height:88rpx;line-height:48rpx}picker{display:block}

.ar-project-select{border:1rpx solid #eadfd1;box-shadow:0 8rpx 24rpx rgba(88,55,29,.05)}
.ar-summary-card{padding:28rpx;background:linear-gradient(145deg,#fff 0%,#fdf9f3 100%);border:1rpx solid #eee3d6}
.ar-summary-heading,.ar-stage-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.ar-summary-title,.ar-stage-title{min-width:0;flex:1}.ar-summary-title .owner-name{font-size:32rpx;line-height:46rpx;font-weight:700}.ar-status{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;max-width:220rpx;padding:5rpx 14rpx;border-radius:999rpx;background:#f4eee6;color:#89512a;font-size:22rpx;line-height:32rpx;text-align:center;overflow-wrap:anywhere}.ar-status-success,.ar-status-done,.ar-status-paid{background:#edf6ef;color:#3f7750}.ar-status-warning,.ar-status-pending,.ar-status-overdue{background:#fff0e6;color:#a55234}.ar-status-muted{background:#f2f1ef;color:#77746e}
.ar-balance{margin:28rpx 0 22rpx;padding-bottom:22rpx;border-bottom:1rpx solid #eee5db}.ar-label{display:block;color:#8c847b;font-size:23rpx;line-height:34rpx}.ar-balance-value{display:block;margin-top:4rpx;color:#7c431e;font-size:52rpx;line-height:66rpx;font-weight:700;overflow-wrap:anywhere}.ar-summary-metrics{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14rpx}.ar-summary-metric{min-width:0;padding:18rpx 20rpx;border-radius:16rpx;background:#f8f3ec}.ar-metric-value{display:block;margin-top:5rpx;font-size:28rpx;line-height:42rpx;font-weight:600;overflow-wrap:anywhere}.ar-owner-line,.ar-due-line{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin-top:22rpx;color:#766e65;font-size:24rpx;line-height:36rpx}.ar-owner-line text:last-child,.ar-due-line text:last-child{max-width:64%;color:#312a23;text-align:right;overflow-wrap:anywhere}
.ar-stage-card{padding:26rpx;border:1rpx solid #eee7de}.ar-stage-title .owner-name{font-size:30rpx;line-height:44rpx;font-weight:700}.ar-stage-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rpx;margin-top:24rpx;border-radius:16rpx;overflow:hidden;background:#eae1d7}.ar-stage-metrics>view{min-width:0;padding:18rpx 12rpx;background:#faf6f0;text-align:center}.ar-stage-amount{display:block;margin-top:5rpx;font-size:25rpx;line-height:38rpx;font-weight:600;overflow-wrap:anywhere}.ar-stage-remaining{color:#8b4b22}.ar-stage-action{width:100%;min-height:88rpx;margin-top:24rpx}.ar-empty-card{padding:36rpx 24rpx;color:#8b837a;text-align:center}
.ar-reference-card{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:22rpx 26rpx}.ar-reference-card>view{min-width:0;flex:1}.ar-reference-link{display:flex;align-items:center;justify-content:center;min-height:88rpx;flex-shrink:0;padding:12rpx 8rpx;color:#89512a;font-size:25rpx;line-height:38rpx}
.ar-editor-card{border:1rpx dashed #dac6b0;background:#fffcf8}.ar-editor-note{margin:-4rpx 0 18rpx}.ar-editor-row{padding:22rpx 0;border-top:1rpx solid #eee6dc}.ar-editor-index{display:block;margin-bottom:12rpx;color:#89512a;font-size:26rpx;line-height:38rpx;font-weight:600}.ar-field-label{display:block;margin-top:14rpx;color:#6f675f;font-size:24rpx;line-height:36rpx}.ar-field-label .ops-field{margin-top:7rpx}.ar-remove-link{min-height:88rpx;margin-left:auto}.ar-editor-actions button{min-height:88rpx}
.ar-review-card{border:2rpx solid #ead5bf}.ar-review-note{margin-top:20rpx}.ar-review-check{width:100%;min-height:88rpx;text-align:left}.ar-review-actions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.ar-review-actions button{min-width:0;min-height:88rpx}.ar-review-actions button[disabled],.ar-review-check[disabled]{opacity:.48}
.ar-bottom-links{display:flex;align-items:center;justify-content:flex-end;gap:8rpx;margin:-4rpx 0 24rpx}.ar-bottom-links button{min-height:72rpx;padding:10rpx 14rpx;color:#89512a;font-size:24rpx;line-height:36rpx}

@import "../../../styles/project-flow.wxss";
