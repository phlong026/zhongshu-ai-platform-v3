@import "../owner.wxss";
.ops-field{display:block;margin:14rpx 0;padding:18rpx 20rpx;border:1rpx solid #e5ddd3;border-radius:12rpx;font-size:28rpx;line-height:42rpx;background:#fff;box-sizing:border-box;width:100%}.ops-note{height:130rpx}.ops-link{padding:20rpx 0;background:transparent;text-align:left;border-bottom:1rpx solid #eee7de;font-size:28rpx;line-height:42rpx}.ops-link text{display:block}.ops-actions{display:flex;gap:16rpx;margin-top:18rpx;flex-wrap:wrap}.ops-actions button{flex:1;min-width:200rpx}.ops-select{padding:20rpx;background:#fff;border-radius:18rpx;margin-bottom:20rpx}.ops-check{padding:20rpx 0;font-size:26rpx;color:#75451f}.ops-parts{padding:18rpx 0;border-bottom:1rpx solid #eee7de}.ops-number{font-size:36rpx;line-height:54rpx;font-weight:700;color:#75451f}.ops-menu{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.ops-menu button{padding:22rpx 12rpx;background:#f5eee4;font-size:28rpx;line-height:42rpx}.ops-menu button text{display:block}.owner-error{white-space:pre-wrap}

input.ops-field{height:88rpx;min-height:88rpx;line-height:48rpx}picker{display:block}

