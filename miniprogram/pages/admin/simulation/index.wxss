.page{min-height:100vh;background:#f5f7f9;padding:24rpx;box-sizing:border-box;color:#1c2b2a}.notice,.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx;box-shadow:0 8rpx 30rpx rgba(21,55,51,.06)}.notice{background:#eaf5f1;border:1rpx solid #c7e4da}.notice-title,.title{display:block;font-size:32rpx;font-weight:700}.notice-text,.meta{display:block;margin-top:10rpx;color:#60716f;font-size:24rpx;line-height:1.55}.label{display:block;margin:22rpx 0 8rpx;color:#526462;font-size:24rpx}.input,.select{min-height:76rpx;background:#f3f6f5;border-radius:12rpx;padding:0 20rpx;font-size:28rpx;box-sizing:border-box}.select{display:flex;align-items:center;margin-top:18rpx}.note{height:140rpx;padding-top:18rpx}.primary{margin-top:28rpx;background:#176c5b;color:#fff;border-radius:12rpx}.check{margin-top:18rpx;background:#fff;border:1rpx solid #cbd8d5;color:#334d49;font-size:24rpx}.policy{padding:20rpx 0;border-bottom:1rpx solid #edf1f0}.policy:last-child{border-bottom:0}.policy-name{display:block;font-size:28rpx;font-weight:600}.grid{display:grid;grid-template-columns:1fr 1fr;gap:0 18rpx}.actions{display:flex;gap:12rpx;margin-top:22rpx}.actions button{margin:0}.dot{display:inline-block;width:16rpx;height:16rpx;background:#26a269;border-radius:50%;margin-right:12rpx}.error{position:sticky;bottom:24rpx;background:#fff0ed;color:#a13b2c;padding:20rpx 24rpx;border-radius:14rpx;font-size:24rpx}
