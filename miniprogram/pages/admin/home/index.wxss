@import "../owner.wxss";
.home-page .owner-hello{margin-bottom:24rpx}
.home-page .owner-card{border:1rpx solid #eee7de}
.home-page .owner-heading{margin-bottom:16rpx}
.home-finance-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:20rpx}
.home-finance-tabs{display:flex;align-items:center;gap:28rpx;flex-shrink:0}
.home-finance-tab{position:relative;margin:0;padding:4rpx 10rpx 16rpx;min-height:64rpx;background:transparent;color:var(--boss-muted);font-size:var(--zs-font-title)!important;line-height:44rpx!important}
.home-finance-tab.selected{color:var(--boss-brown);font-weight:600}
.home-finance-tab.selected::before{content:"";position:absolute;bottom:0;left:6rpx;right:6rpx;height:4rpx;background:var(--boss-brown);border-radius:4rpx}
.home-period{display:flex;align-items:center;justify-content:flex-end;gap:8rpx;min-height:64rpx;color:var(--boss-muted);font-size:var(--zs-font-meta);line-height:36rpx;white-space:nowrap}
.home-six,.home-ledger-stats,.home-counts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4rpx}
.home-six-item,.home-ledger-stat,.home-metric{min-width:0;background:#fcf8f2!important;border-radius:14rpx!important;text-align:center;padding:20rpx 4rpx!important;margin:0!important;box-sizing:border-box}
.home-six-item{display:block;border:0!important;line-height:normal!important}
.home-six-label,.home-ledger-k,.home-metric-label{display:block;font-size:var(--zs-font-meta);line-height:36rpx;color:#74695c;white-space:nowrap}
.home-six-value,.home-ledger-v,.home-metric-value{display:block;font-size:var(--zs-font-heading);line-height:56rpx;font-weight:600;color:var(--boss-brown);margin-top:6rpx;white-space:nowrap}
.home-ledger-v{font-size:var(--zs-font-title)}
.home-six-value.compact,.home-metric-value.compact{font-size:26rpx}
.home-ledger-v.compact{font-size:var(--zs-font-caption)}
.home-page .owner-unit{font-size:var(--zs-font-caption);margin-left:3rpx}
.home-metric{display:flex;flex-direction:column;align-items:center;border:1rpx solid transparent!important;line-height:normal!important}
.home-metric.selected{border-color:var(--boss-brown)!important;background:#f8efe3!important}
.home-metric[disabled]{opacity:1}
.home-chevron{width:10rpx;height:10rpx;border-right:2rpx solid var(--boss-brown);border-bottom:2rpx solid var(--boss-brown);transform:rotate(45deg);margin:8rpx auto 4rpx;flex-shrink:0}
.home-chevron.expanded{transform:rotate(225deg);margin-top:14rpx;margin-bottom:-2rpx}
.home-detail{margin-top:18rpx;padding-top:14rpx;border-top:1rpx solid #eee7de;animation:home-reveal .18s ease-out}
@keyframes home-reveal{from{opacity:0;transform:translateY(-8rpx)}to{opacity:1;transform:translateY(0)}}
.home-detail-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:var(--zs-font-body);font-weight:500;line-height:42rpx}
.home-collapse{display:flex;align-items:center;justify-content:flex-end;gap:12rpx;background:transparent;margin:0;padding:0 4rpx;min-height:56rpx;color:var(--boss-muted);font-size:var(--zs-font-meta)!important;font-weight:400!important}
.home-collapse .home-chevron{margin:8rpx 2rpx 0}
.home-detail-empty{background:#fcf8f2;border-radius:12rpx;padding:24rpx 12rpx;margin-top:8rpx;text-align:center;color:var(--boss-muted);font-size:var(--zs-font-meta);line-height:38rpx}
.home-detail-row{display:flex;align-items:center;gap:14rpx;width:100%;text-align:left;margin:0;background:transparent;border-bottom:1rpx solid #eee7de;padding:18rpx 0}
.home-detail-row:last-child{border-bottom:0}
.home-detail-amount{color:var(--boss-brown);font-size:var(--zs-font-meta);white-space:nowrap}
.home-detail-more{display:flex;align-items:center;justify-content:center;gap:10rpx;margin:12rpx 0 0;padding:6rpx 0;min-height:64rpx;background:transparent;color:var(--boss-brown);font-size:var(--zs-font-meta)!important}
.home-module-state{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:16rpx;color:var(--boss-muted);font-size:var(--zs-font-meta);line-height:38rpx}
.home-retry,.pt-retry{background:#f4ede3;color:var(--boss-brown);font-size:var(--zs-font-meta)!important;line-height:56rpx!important;min-height:56rpx;padding:0 20rpx;border-radius:10rpx!important;margin:0;flex-shrink:0}
.pt-retry{margin-top:10rpx}
.pt-warning{display:block;color:#b0563f;font-size:var(--zs-font-caption);padding-bottom:10rpx}
.pt-row{display:flex;align-items:center;gap:14rpx;width:100%;text-align:left;background:transparent;padding:16rpx 0;border-bottom:1rpx solid #f0e9df}
.pt-row-disabled{opacity:.55}
.pt-copy{display:flex;flex-direction:column;gap:4rpx;flex:1;min-width:0}
.pt-title{font-size:var(--zs-font-body);color:#322c26}
.pt-meta{font-size:var(--zs-font-meta);color:#9c8e80}
.pt-amount{flex-shrink:0;font-size:var(--zs-font-body);font-weight:600;color:var(--boss-brown)}
