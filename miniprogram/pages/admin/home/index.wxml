<view class="owner-page"><owner-header title="首页"/><view class="owner-content">
<text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-hello"><text class="owner-title">你好，{{desk.name}}</text></view><text class="owner-muted owner-date">{{desk.company}} · {{desk.date}}</text>
<view class="owner-card"><view class="owner-heading"><text>本月经营</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><text class="home-period">{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></text></picker></view><view class="home-six"><button wx:for="{{desk.home.six}}" wx:key="key" class="home-six-item" data-key="{{item.key}}" bindtap="go"><text class="home-six-label">{{item.label}}</text><text class="home-six-value">{{item.value}}<text class="owner-unit">{{item.unit}}</text></text><text class="home-six-sub">{{item.sub}}</text></button></view></view>
<view class="owner-card"><view class="owner-heading"><text>待我办理 {{desk.home.groups[0].count}}</text></view><view class="home-chips"><button wx:for="{{desk.home.groups}}" wx:key="key" class="home-chip {{todoTab===item.key?'selected':''}}" data-tab="{{item.key}}" bindtap="todoTab"><text>{{item.label}}</text><text>{{item.count}}</text></button></view><view wx:for="{{homeTodos}}" wx:key="key" class="owner-row home-todo"><view class="owner-grow"><view class="home-todo-name"><text class="owner-name">{{item.name}}</text><text class="owner-badge">{{item.tag}}</text></view><text class="owner-muted">{{item.detail}}</text></view><button wx:if="{{index===0}}" class="owner-primary" data-key="{{item.key}}" bindtap="go">{{item.action}}</button><button wx:else class="owner-link" data-key="{{item.key}}" bindtap="go">{{item.action}}<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view wx:if="{{!homeTodos.length}}" class="owner-empty">当前没有需要本人审批、复核或交接的事项</view><button wx:if="{{homeTodoTotal>homeTodos.length}}" class="owner-link home-all" data-action="todos" bindtap="go">查看全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view>
<view class="owner-card"><view class="owner-heading"><text>当前业务</text><button class="owner-link" data-action="business" bindtap="go">业务概览<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="home-counts home-business-counts"><view wx:for="{{desk.home.business.stages}}" wx:key="label"><text class="home-count-value">{{item.value}}<text class="owner-unit">{{item.unit}}</text></text><text class="owner-muted">{{item.label}}</text></view></view><view class="home-business-signals"><button class="home-business-signal" data-key="{{desk.home.business.appointments.key}}" bindtap="go"><view><text class="owner-name">{{desk.home.business.appointments.label}}</text><text class="owner-muted">明确预约到店</text></view><text class="home-signal-value">{{desk.home.business.appointments.value}}<text class="owner-unit">{{desk.home.business.appointments.unit}}</text></text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="home-business-signal" data-key="{{desk.home.business.acquisition.key}}" bindtap="go"><view><text class="owner-name">{{desk.home.business.acquisition.label}}</text><text class="owner-muted">发布与有效咨询</text></view><text class="home-signal-value">{{desk.home.business.acquisition.value}}<text class="owner-unit">{{desk.home.business.acquisition.unit}}</text></text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><button wx:for="{{desk.home.business.notes}}" wx:key="key" class="home-note" data-key="{{item.key}}" bindtap="go"><view class="home-dot {{item.level}}"/><text class="owner-grow">{{item.text}}</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view>
<view class="owner-card"><view class="owner-heading"><text>当前工程</text><button class="owner-link" data-action="engineering" bindtap="go">工程概览<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="home-counts"><view wx:for="{{desk.home.engineering.counts}}" wx:key="label"><text class="home-count-value {{item.label==='延期'&&item.value?'late':''}}">{{item.value}}<text class="owner-unit">个</text></text><text class="owner-muted">{{item.label}}</text></view></view><button wx:for="{{desk.home.engineering.sites}}" wx:key="key" class="owner-row home-site" data-key="{{item.key}}" bindtap="go"><image class="home-site-image" src="{{item.image}}" mode="aspectFill"/><view class="owner-grow"><view class="owner-keyline"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.stage}}</text></view><view class="home-nodes"><view wx:for="{{item.nodes}}" wx:for-item="node" wx:key="index" class="{{node}}"/></view><view class="home-pays"><text wx:for="{{item.pays}}" wx:for-item="pay" wx:key="text" class="home-pay {{pay.level}}">{{pay.text}}</text><text wx:if="{{item.late}}" class="home-pay amber">节点延期</text></view></view></button><view wx:if="{{!desk.home.engineering.sites.length}}" class="owner-empty">当前没有在建工地，可在工程概览查看交接与开工准备</view></view>
</block></view><owner-nav id="owner-navigation" active="home"/></view>
