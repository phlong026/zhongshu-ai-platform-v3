<view class="wb-root owner-page home-page">
 <brand-header branded divider account-font title="老板工作台"/>
 <view class="owner-content wb-content">
  <view class="owner-hello wb-greeting"><text class="owner-title">你好，{{desk.name||'同事'}}</text></view>
  <home-overview id="role-overview" role="owner" period="{{desk.period}}" bind:monthchange="month"/>
  <view class="home-todo-section wb-todos"><text wx:if="{{platformTodos.warning}}" class="owner-muted">{{platformTodos.warning}}</text><todo-preview wx:if="{{platformTodos.status==='ready'||platformTodos.status==='partial'||platformTodos.rows.length}}" appearance="home" title="待我决策" id="today-todos" rows="{{platformTodos.rows}}" scope="{{platformTodos.sessionGen+':'+platformTodos.postKey}}" bind:activate="openPlatformTodo"/><text wx:if="{{platformTodos.status==='loading'}}" class="owner-muted">待办加载中…</text><view wx:if="{{platformTodos.status==='degraded'||platformTodos.status==='partial-empty'}}" class="home-error"><text>{{platformTodos.message||'待办暂时无法完整加载'}}</text><button bindtap="retryPlatformTodos">重新加载</button></view><view wx:if="{{platformTodos.refreshError}}" class="home-error"><text>待办更新失败：{{platformTodos.refreshError}}</text><button bindtap="retryPlatformTodos">重试</button></view></view>
  <view class="home-project-section"><view class="home-section-heading"><text>重点项目</text><button data-url="/pages/build/projects/index" bindtap="go">全部<image src="/assets/creation-chevron.png"/></button></view><view class="home-project-card"><button wx:for="{{desk.home.engineering.sites}}" wx:key="key" class="home-project-row" data-url="{{item.url}}" bindtap="go"><image class="home-project-photo" src="{{item.image}}" mode="aspectFill"/><view><text>{{item.name}}</text><text>{{item.stage}}</text><text wx:if="{{item.date}}">开工 {{item.date}}</text></view><image class="home-arrow" src="/assets/creation-chevron.png"/></button><text wx:if="{{!desk.home.engineering.sites.length}}" class="home-empty">{{desk.home.engineering.message||'当前暂无在办项目'}}</text></view></view>
 </view><owner-nav id="owner-navigation" active="home"/>
</view>
