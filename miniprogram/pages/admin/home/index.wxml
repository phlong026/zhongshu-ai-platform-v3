<view class="owner-page"><owner-header title="首页"/><view class="owner-content">
<view wx:if="{{error}}" class="owner-error"><text>{{error}}</text><button class="owner-link" bindtap="retryHome">重新加载</button></view><block wx:if="{{ready}}">
<view class="owner-hello"><text class="owner-title">你好，{{desk.name}}</text></view><text class="owner-muted owner-date">{{desk.company}} · {{desk.date}}</text>
<view wx:if="{{platformTodos&&platformTodos.status!=='idle'}}" class="owner-card"><view class="owner-heading"><text>平台待办</text><text wx:if="{{platformTodos.status==='ready'||platformTodos.status==='partial'}}" class="owner-muted">已加载可办理 {{platformTodos.count}} 件</text></view><text wx:if="{{platformTodos.warning}}" class="owner-muted pt-warning">{{platformTodos.warning}}</text><block wx:if="{{platformTodos.status==='loading'}}"><text class="owner-muted">待办加载中…</text></block><block wx:elif="{{platformTodos.status==='degraded'}}"><text class="owner-muted">{{platformTodos.message||'待办暂时无法加载'}}</text><button class="pt-retry" bindtap="retryPlatformTodos">重新加载</button></block><block wx:elif="{{platformTodos.status==='ready'&&platformTodos.rows.length===0}}"><text class="owner-muted">暂无待办</text></block><block wx:elif="{{platformTodos.status==='partial-empty'}}"><text class="owner-muted">已加载部分暂无待办</text><button class="pt-retry" bindtap="retryPlatformTodos">重新加载</button></block><block wx:else><button wx:for="{{platformTodos.rows}}" wx:key="key" class="pt-row {{item.clickable?'':'pt-row-disabled'}}" data-path="{{item.path}}" data-clickable="{{item.clickable}}" bindtap="openPlatformTodo" hover-class="pressed"><view class="pt-copy"><text class="pt-title">{{item.title}}</text><text class="pt-meta">{{item.typeLabel}} · {{item.actionHint}}</text></view><text wx:if="{{item.amount}}" class="pt-amount">{{item.amount}}</text></button></block></view><view class="owner-card"><view class="owner-heading"><text>本月经营</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><text class="home-period">{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></text></picker></view><view class="home-six"><button wx:for="{{desk.home.six}}" wx:key="key" class="home-six-item" data-action="{{item.action}}" data-url="{{item.url}}" bindtap="go"><text class="home-six-label">{{item.label}}</text><text class="home-six-value">{{item.value}}<text class="owner-unit">{{item.unit}}</text></text><text class="home-six-sub">{{item.sub}}</text></button></view></view>
<view class="owner-card"><view class="owner-heading"><text>本月账本</text><text class="home-ledger-date">{{desk.periodLabel}}</text></view>
<view class="home-ledger-stats"><view class="home-ledger-stat"><text class="home-ledger-k">本月已收</text><text class="home-ledger-v">{{desk.ledger.inTotal}}</text></view><view class="home-ledger-stat"><text class="home-ledger-k">本月已付</text><text class="home-ledger-v">{{desk.ledger.payTotal}}</text></view><view class="home-ledger-stat"><text class="home-ledger-k">待收</text><text class="home-ledger-v">{{desk.ledger.receivableTotal}}</text></view><view class="home-ledger-stat"><text class="home-ledger-k">待付</text><text class="home-ledger-v">{{desk.ledger.payableTotal}}</text></view></view>
<view class="home-ledger-month"><text>来自财务登记与经营分析实时汇总</text></view>
</view>
<button class="owner-card home-brief-entry" data-url="/pages/admin/brief/index" bindtap="go"><view class="owner-grow"><text class="owner-name">经营简报</text><text class="owner-muted">当月实时口径、历史月可归档：趋势 / 收支构成 / 账龄六桶</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button>
<button class="owner-card home-web-entry" bindtap="copyFrLink"><view class="owner-grow"><text class="owner-name">在浏览器打开财务核对页</text><text class="owner-muted">复制 /fr/finance 链接（不含登录凭据），在 PC 浏览器登录后查看大表</text></view><text class="owner-badge">复制链接</text></button>
<view class="owner-card"><view class="owner-heading"><text>当前业务</text><button class="owner-link" data-url="/pages/customers/index" bindtap="go">客户与跟进<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="home-counts home-business-counts"><view wx:for="{{desk.home.business.stages}}" wx:key="label"><text class="home-count-value">{{item.value}}<text class="owner-unit">{{item.unit}}</text></text><text class="owner-muted">{{item.label}}</text></view></view><view class="home-business-signals"><button class="home-business-signal" data-url="{{desk.home.business.appointments.url}}" bindtap="go"><view><text class="owner-name">{{desk.home.business.appointments.label}}</text><text class="owner-muted">查看预约客户</text></view><text class="home-signal-value">{{desk.home.business.appointments.value}}</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="home-business-signal" data-url="{{desk.home.business.acquisition.url}}" bindtap="go"><view><text class="owner-name">{{desk.home.business.acquisition.label}}</text><text class="owner-muted">本月平台实绩</text></view><text class="home-signal-value">{{desk.home.business.acquisition.value}}<text class="owner-unit">{{desk.home.business.acquisition.unit}}</text></text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view></view>
<view class="owner-card"><view class="owner-heading"><text>当前工程</text><button class="owner-link" data-url="/pages/build/projects/index" bindtap="go">工程项目<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="home-counts"><view wx:for="{{desk.home.engineering.counts}}" wx:key="label"><text class="home-count-value">{{item.value}}<text wx:if="{{item.value!=='—'}}" class="owner-unit">个</text></text><text class="owner-muted">{{item.label}}</text></view></view><button wx:for="{{desk.home.engineering.sites}}" wx:key="key" class="owner-row home-site" data-url="{{item.url}}" bindtap="go"><image class="home-site-image" src="{{item.image}}" mode="aspectFill"/><view class="owner-grow"><view class="owner-keyline"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.stage}}</text></view><text wx:if="{{item.date}}" class="owner-muted">开工日期 {{item.date}}</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><view wx:if="{{!desk.home.engineering.sites.length}}" class="owner-empty">{{desk.home.engineering.message}}</view></view>
</block></view><owner-nav id="owner-navigation" active="home"/></view>
