<view class="owner-page"><owner-header title="首页"/><view class="owner-content">
<text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-hello"><text class="owner-title">你好，{{desk.name}}</text><text wx:if="{{desk.sample}}" class="owner-badge">示例数据</text></view><text class="owner-muted owner-date">{{desk.company}} · {{desk.date}}</text>
<view class="owner-card"><view class="owner-heading"><text>本月经营</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><text class="owner-heading-meta">{{desk.periodLabel}}</text></picker></view><view class="owner-statistics"><view class="owner-stat"><text class="owner-stat-label">本月签约</text><text class="owner-number">{{desk.sales}}<text class="owner-unit">万</text></text></view><view class="owner-stat"><text class="owner-stat-label">有效实收</text><text class="owner-number">{{desk.income}}<text class="owner-unit">万</text></text></view><view class="owner-stat"><text class="owner-stat-label">在建项目</text><text class="owner-number">{{desk.activeCount}}<text class="owner-unit">个</text></text></view></view></view>
<view class="owner-card"><view class="owner-heading"><text>经营风险与资金</text><button class="owner-link" data-action="operating" bindtap="go">查看原单</button></view><view class="owner-statistics"><button class="owner-stat" data-action="receivables" bindtap="go"><text class="owner-stat-label">客户未收</text><text class="owner-name">{{desk.operating.receivable}}</text></button><button class="owner-stat" data-action="operating" bindtap="go"><text class="owner-stat-label">剩余应付</text><text class="owner-name">{{desk.operating.payable}}</text></button></view><view class="owner-statistics"><button class="owner-stat" data-action="funds" bindtap="go"><text class="owner-stat-label">可核对资金</text><text class="owner-name">{{desk.operating.cash}}</text></button><button class="owner-stat" data-action="costs" bindtap="go"><text class="owner-stat-label">合同预计毛利</text><text class="owner-name">{{desk.operating.profit}}</text></button></view><text class="owner-note">逾期未收 {{desk.operating.overdue}}；未来7天约定应付 {{desk.operating.payableDue}}；{{desk.operating.unplanned}}个项目分期待确认，{{desk.operating.incompleteCost}}个项目成本待完善。合同毛利为项目累计预测，未扣本期公司费用 {{desk.operating.overhead}}。</text></view><view class="owner-card owner-tools"><button class="owner-tool" data-action="business" bindtap="go"><view class="owner-tool-icon"><image src="/assets/folder.png" mode="aspectFit"/></view><text>业务概览</text></button><button class="owner-tool" data-action="engineering" bindtap="go"><view class="owner-tool-icon"><image src="/assets/house.png" mode="aspectFit"/></view><text>工程概览</text></button><button class="owner-tool" data-action="approvals" bindtap="go"><view class="owner-tool-icon"><image src="/assets/management-payment.jpg" mode="aspectFit"/></view><text>金额审批</text></button><button class="owner-tool" data-action="reports" bindtap="go"><view class="owner-tool-icon"><image src="/assets/chart.png" mode="aspectFit"/></view><text>经营报表</text></button></view>
<view class="owner-card"><view class="owner-heading"><text>待我审批 <text class="owner-count">{{desk.approvalCount}}</text></text><button class="owner-link" data-action="approvals" bindtap="go">查看全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view wx:for="{{desk.previewApprovals}}" wx:key="key" class="owner-row"><image class="owner-thumb" src="{{item.image}}" mode="aspectFill"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-amount">{{item.amount}}</text><text class="owner-muted">{{item.status}}</text></view><button class="{{index===0?'owner-primary':'owner-outline'}}" data-key="{{item.key}}" bindtap="go">去审批</button></view><view wx:if="{{!desk.approvals.length}}" class="owner-empty">当前没有待本人审批的金额事项</view></view>
<view class="owner-card"><view class="owner-heading"><text>重点项目</text><button class="owner-link" data-action="engineering" bindtap="go">查看全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view wx:for="{{desk.focus}}" wx:key="key" class="owner-row"><image class="owner-thumb" src="{{item.image}}" mode="aspectFill"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.stage}} · 进度{{item.progress}}%</text><text class="owner-muted">{{item.status}}</text><view class="owner-progress"><view style="width:{{item.progress}}%"/></view></view><button class="owner-outline" data-key="{{item.key}}" bindtap="go">查看项目</button></view><view wx:if="{{!desk.focus.length}}" class="owner-empty">当前没有在建项目，可在工程概览查看交接与开工准备</view></view>
</block></view><owner-nav id="owner-navigation" active="home"/></view>
