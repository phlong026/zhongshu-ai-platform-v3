@import "../owner.wxss";
.task-page{min-height:100vh;background:var(--zs-bg);padding-bottom:calc(36rpx + env(safe-area-inset-bottom));color:var(--zs-text)}.task-content{padding:24rpx 28rpx}.error{display:block;background:var(--zs-danger-bg);color:var(--zs-danger);padding:16rpx 20rpx;border-radius:16rpx;margin-bottom:18rpx}.period-row,.list-head,.task-top,.sheet-head,.archive-total,.archive-line{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.period-row{font-size:var(--zs-font-meta);color:var(--zs-text-2);margin-bottom:18rpx}.period-picker,.picker{border:1rpx solid var(--zs-line);border-radius:14rpx;background:var(--zs-card);padding:16rpx 20rpx;min-height:68rpx}.tabs{display:flex;gap:10rpx;background:var(--zs-line);border-radius:18rpx;padding:8rpx;margin-bottom:22rpx}.tabs button{flex:1;min-height:64rpx;border-radius:13rpx;color:var(--zs-text-2);font-size:var(--zs-font-meta)}.tabs button.active{background:var(--zs-card);color:var(--zs-brand-press);font-weight:600;box-shadow:0 4rpx 12rpx rgba(48,41,31,.08)}.card{background:var(--zs-card);border-radius:24rpx;padding:24rpx;margin-bottom:18rpx;box-shadow:0 6rpx 18rpx rgba(48,41,31,.06)}.heading{font-size:var(--zs-font-title);font-weight:700;margin-bottom:20rpx}.task-form label{display:grid;grid-template-columns:150rpx 1fr;align-items:center;gap:16rpx;margin-bottom:16rpx;font-size:var(--zs-font-meta)}.task-form input,.task-form textarea,.sheet textarea{width:100%;min-height:68rpx;background:var(--zs-bg);border:1rpx solid var(--zs-line);border-radius:14rpx;padding:14rpx 18rpx}.task-form textarea,.sheet textarea{min-height:130rpx}.primary,.archive{width:100%;min-height:82rpx;border-radius:18rpx;background:var(--zs-brand);color:var(--zs-card);margin-top:20rpx}.hint,.history{display:block;color:var(--zs-text-3);font-size:var(--zs-font-caption);line-height:34rpx}.list-head{margin:26rpx 4rpx 14rpx;font-size:var(--zs-font-body)}.list-head text:last-child{color:var(--zs-text-3)}.task-top{align-items:flex-start}.task-top>view{display:flex;flex-direction:column;min-width:0}.task-title{font-size:var(--zs-font-emphasis);font-weight:700}.meta{font-size:var(--zs-font-caption);color:var(--zs-text-3);margin-top:8rpx}.status{flex-shrink:0;border-radius:999rpx;padding:7rpx 13rpx;background:var(--zs-warning-bg);color:var(--zs-warning);font-size:var(--zs-font-caption)}.status.done{background:var(--zs-success-bg);color:var(--zs-success)}.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx;margin:20rpx 0}.facts>view{display:flex;flex-direction:column;gap:7rpx;background:var(--zs-bg);border-radius:14rpx;padding:14rpx;font-size:var(--zs-font-meta)}.facts>view text:first-child{color:var(--zs-text-3);font-size:var(--zs-font-caption)}.sources{border-top:1rpx solid var(--zs-line);margin-top:16rpx}.sources button{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16rpx;text-align:left;padding:14rpx 0;color:var(--zs-brand-press)}.sources button>view{display:flex;flex-direction:column;min-width:0;color:var(--zs-text)}.sources button>view text:last-child{color:var(--zs-text-3);font-size:var(--zs-font-caption)}.sources button>text{flex-shrink:0;font-size:var(--zs-font-caption)}.task-actions{display:flex;justify-content:flex-end;margin-top:14rpx}.task-actions button,.warning button{color:var(--zs-brand-press);font-size:var(--zs-font-meta);padding:12rpx 18rpx}.archive{margin:8rpx 0 24rpx}.archive-total{background:var(--zs-bg);border-radius:18rpx;padding:20rpx;margin-bottom:15rpx}.archive-total text:last-child{color:var(--zs-text-3)}.archive-line{border-bottom:1rpx solid var(--zs-line);padding:15rpx 0}.archive-line>view{display:flex;flex-direction:column;gap:4rpx}.archive-line>view text:last-child{color:var(--zs-text-3);font-size:var(--zs-font-caption)}.warning{background:var(--zs-warning-bg);color:var(--zs-warning);border-radius:14rpx;padding:16rpx;margin-top:18rpx;line-height:36rpx}.warning button{display:inline;color:var(--zs-warning)}.overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:100;display:flex;align-items:flex-end}.sheet{width:100%;max-height:88vh;overflow-y:auto;background:var(--zs-card);border-radius:28rpx 28rpx 0 0;padding:30rpx 32rpx calc(36rpx + env(safe-area-inset-bottom))}.sheet-head{font-size:var(--zs-font-emphasis);font-weight:700;margin-bottom:22rpx}.sheet-head button{font-size:var(--zs-font-heading);color:var(--zs-text-3)}.sheet .picker,.sheet textarea{margin-bottom:18rpx}.photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}.photos button{height:170rpx;border:1rpx dashed #d8d0c5;border-radius:14rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--zs-brand-press);font-size:var(--zs-font-caption);overflow:hidden}.photos image{width:100%;height:128rpx}.photos button text{margin-top:4rpx}@media(max-width:360px){.facts{grid-template-columns:1fr}.task-form label{grid-template-columns:1fr}}

/* Each goal retains its own unit; the two half circles render the actual ratio. */
.goal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32rpx 20rpx;margin-top:28rpx}
.goal-summary{display:flex;flex-direction:column;align-items:center;min-width:0;text-align:center}
.goal-ring{position:relative;width:144rpx;height:144rpx;border-radius:50%;background:var(--zs-line);overflow:hidden;flex-shrink:0}
.goal-half{position:absolute;top:0;width:50%;height:100%;overflow:hidden}
.goal-half-right{right:0}.goal-half-left{left:0}
.goal-arc{position:absolute;top:0;width:100%;height:100%;background:var(--zs-brand)}
.goal-arc-right{left:-100%;border-radius:144rpx 0 0 144rpx;transform-origin:100% 50%}
.goal-arc-left{left:100%;border-radius:0 144rpx 144rpx 0;transform-origin:0 50%}
.goal-ring-center{position:absolute;inset:12rpx;border-radius:50%;background:var(--zs-card);display:flex;flex-direction:column;align-items:center;justify-content:center}
.goal-percent{font-size:var(--zs-font-title);font-weight:600;color:var(--zs-brand);line-height:1.3}
.goal-caption{font-size:var(--zs-font-caption);color:var(--zs-text-3);margin-top:4rpx}
.goal-title{font-size:var(--zs-font-body);font-weight:600;line-height:1.5;margin-top:16rpx;overflow-wrap:anywhere}
.goal-target,.goal-collected{font-size:var(--zs-font-meta);line-height:1.6;color:var(--zs-text-3);overflow-wrap:anywhere}
.goal-collected{color:var(--zs-brand)}
