.task-page{min-height:100vh;padding-bottom:calc(36rpx + env(safe-area-inset-bottom));background:var(--zs-bg);color:var(--zs-text);font-family:var(--zs-font-family);font-size:var(--zs-font-body);line-height:42rpx}
.task-content{padding:24rpx var(--zs-space-page)}
.task-page .error{display:block;background:var(--zs-danger-bg);color:var(--zs-danger);padding:16rpx 20rpx;border-radius:14rpx;margin-bottom:20rpx;overflow-wrap:anywhere}
.period-row,.list-head,.task-top,.sheet-head,.archive-total,.archive-line{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.period-row{margin-bottom:20rpx;color:var(--zs-text-2)}
.period-row>picker{flex:0 0 auto}
.period-picker{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-width:200rpx;min-height:88rpx;padding:16rpx 20rpx;background:var(--zs-card);border:1rpx solid var(--zs-line);border-radius:14rpx;color:var(--zs-brand)}
.period-picker image{width:14rpx;height:24rpx;transform:rotate(90deg);flex-shrink:0}
.tabs{display:flex;gap:8rpx;padding:6rpx;background:var(--zs-line);border-radius:14rpx;margin-bottom:24rpx}
.tabs button{display:flex;flex:1;min-width:0;align-items:center;justify-content:center;min-height:88rpx;padding:12rpx 8rpx;line-height:40rpx;font-size:var(--zs-font-body);border-radius:10rpx;color:var(--zs-text-2)}
.tabs button.active{background:var(--zs-card);color:var(--zs-brand);font-weight:600}
.task-page .card{display:block;width:100%;background:var(--zs-card);border:1rpx solid var(--zs-line);border-radius:var(--zs-radius);padding:var(--zs-space-card);margin-bottom:var(--zs-space-section)}
.task-page .heading{font-size:var(--zs-font-title);font-weight:600;line-height:46rpx;margin-bottom:16rpx}
.task-form-body,.task-sheet-form{display:block;width:100%;min-width:0}
.task-field{display:block;width:100%;margin-bottom:24rpx}
.task-label{display:block;line-height:40rpx;margin-bottom:10rpx;color:var(--zs-text-2)}
.task-input,.task-select,.task-page .picker,.task-textarea{display:block;width:100%;min-width:0;font-family:inherit;font-size:var(--zs-font-body);color:var(--zs-text);box-sizing:border-box}
/* Native inputs have an intrinsic height: vertical padding otherwise clips their text. */
.task-input{height:88rpx;min-height:44px;padding:0 20rpx;line-height:42rpx;background:var(--zs-bg);border:1rpx solid var(--zs-line);border-radius:14rpx}
.task-page .picker{display:flex;align-items:center;min-height:88rpx;padding:18rpx 20rpx;line-height:42rpx;background:var(--zs-bg);border:1rpx solid var(--zs-line);border-radius:14rpx;overflow-wrap:anywhere}
.task-page .primary,.task-page .secondary,.task-page .archive{display:flex;align-items:center;justify-content:center;gap:10rpx;width:100%;min-height:88rpx;padding:20rpx;line-height:42rpx;font-size:var(--zs-font-emphasis);font-weight:500;white-space:normal;overflow-wrap:anywhere;text-align:center;border-radius:var(--zs-control-radius);margin-top:20rpx}
.task-page .primary{background:var(--zs-brand);color:var(--zs-card)}
.task-page .secondary,.task-page .archive{background:var(--zs-card);color:var(--zs-brand);border:1rpx solid var(--zs-brand)}
.task-page .primary[disabled],.task-page .secondary[disabled],.task-page .archive[disabled]{background:var(--zs-line);border-color:var(--zs-line);color:var(--zs-text-3)}
.task-page .hint,.history{display:block;color:var(--zs-text-3);font-size:var(--zs-font-meta);line-height:36rpx;overflow-wrap:anywhere}
.list-head{margin:28rpx 4rpx 16rpx;font-size:var(--zs-font-title);font-weight:600}
.list-head text:last-child{font-size:var(--zs-font-meta);font-weight:400;color:var(--zs-text-3)}
.task-top{align-items:flex-start}
.task-copy{flex:1;min-width:0}
.task-title{display:block;font-size:var(--zs-font-emphasis);font-weight:600;line-height:42rpx;overflow-wrap:anywhere}
.meta{display:block;font-size:var(--zs-font-meta);line-height:36rpx;color:var(--zs-text-3);margin-top:8rpx;overflow-wrap:anywhere}
.status,.archive-status{flex-shrink:0;white-space:nowrap;font-size:var(--zs-font-caption);line-height:34rpx}
.status{border-radius:8rpx;padding:4rpx 12rpx;background:var(--zs-warning-bg);color:var(--zs-warning)}
.status.done{background:var(--zs-success-bg);color:var(--zs-success)}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin:20rpx 0}
.facts>view{display:flex;min-width:0;flex-direction:column;gap:8rpx;background:var(--zs-bg);border-radius:12rpx;padding:16rpx;font-size:var(--zs-font-body);overflow-wrap:anywhere}
.facts>view text:first-child{color:var(--zs-text-3);font-size:var(--zs-font-meta)}
.sources{border-top:1rpx solid var(--zs-line);margin-top:16rpx}
.sources button{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16rpx;text-align:left;padding:16rpx 0;min-height:88rpx;color:var(--zs-brand)}
.source-copy{display:flex;flex:1;flex-direction:column;min-width:0;color:var(--zs-text);overflow-wrap:anywhere}
.source-copy text:last-child{color:var(--zs-text-3);font-size:var(--zs-font-meta);line-height:36rpx}
.sources button>text{flex-shrink:0;font-size:var(--zs-font-meta)}
.task-actions{display:flex;justify-content:flex-end;margin-top:12rpx}
.task-actions button,.warning button{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:16rpx 20rpx;border:1rpx solid var(--zs-line);border-radius:12rpx;color:var(--zs-brand);font-size:var(--zs-font-body);line-height:40rpx}
.task-page .archive{margin:8rpx 0 24rpx}
.archive-total{background:var(--zs-bg);border-radius:14rpx;padding:20rpx;margin-bottom:16rpx;flex-wrap:wrap}
.archive-total text:last-child{color:var(--zs-text-3)}
.archive-line{align-items:flex-start;border-bottom:1rpx solid var(--zs-line);padding:18rpx 0}
.archive-line:last-child{border-bottom:0}
.archive-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:6rpx;overflow-wrap:anywhere}
.archive-copy text:last-child{color:var(--zs-text-3);font-size:var(--zs-font-meta);line-height:36rpx}
.warning{background:var(--zs-warning-bg);color:var(--zs-warning);border-radius:14rpx;padding:16rpx;margin-top:20rpx;line-height:36rpx}
.warning button{margin-top:12rpx;color:var(--zs-warning);border-color:var(--zs-warning)}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:200;display:flex;align-items:flex-end}
.task-page .sheet{width:100%;max-height:85vh;overflow-y:auto;background:var(--zs-card);border-radius:24rpx 24rpx 0 0;padding:24rpx var(--zs-space-page) calc(24rpx + env(safe-area-inset-bottom))}
.sheet-head{align-items:flex-start;margin-bottom:20rpx}
.sheet-title{flex:1;min-width:0;align-self:center;font-size:var(--zs-font-title);font-weight:600;line-height:46rpx;overflow-wrap:anywhere}
.sheet-close{display:flex;align-items:center;justify-content:center;flex:0 0 auto;width:88rpx;min-width:44px;height:88rpx;min-height:44px;font-size:var(--zs-font-heading);line-height:46rpx;color:var(--zs-text-3)}
.task-textarea{height:176rpx;min-height:88px;line-height:42rpx;padding:18rpx 20rpx;background:var(--zs-bg);border:1rpx solid var(--zs-line);border-radius:14rpx;margin-top:20rpx}
.photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:20rpx}
.photos button{height:176rpx;min-width:0;border:1rpx dashed var(--zs-line);border-radius:14rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--zs-brand);font-size:var(--zs-font-meta);line-height:36rpx;overflow:hidden}
.photos image{width:100%;height:128rpx}
.photos button text{margin-top:4rpx}
@media(max-width:360px){.facts{grid-template-columns:1fr}.task-page .primary,.task-page .secondary,.task-page .archive,.tabs button,.task-page .picker,.task-actions button{min-height:44px}.sheet-title{font-size:var(--zs-font-emphasis)}}

/* Each goal retains its own unit; the two half circles render the actual ratio. */
.goal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32rpx 20rpx;margin-top:28rpx}
.goal-summary{display:flex;flex-direction:column;align-items:center;min-width:0;text-align:center}
.goal-ring{position:relative;width:144rpx;height:144rpx;border-radius:50%;background:var(--zs-line);overflow:hidden;flex-shrink:0}
.goal-half{position:absolute;top:0;width:50%;height:100%;overflow:hidden}
.goal-half-right{right:0}.goal-half-left{left:0}
.goal-arc{position:absolute;top:0;width:100%;height:100%;background:var(--zs-brand)}
.goal-arc-right{left:-100%;border-radius:144rpx 0 0 144rpx;transform-origin:100% 50%}
.goal-arc-left{left:100%;border-radius:0 144rpx 144rpx 0;transform-origin:0 50%}
.goal-ring-center{position:absolute;inset:12rpx;border-radius:50%;background:var(--zs-card);display:flex;flex-direction:column;align-items:center;justify-content:center}
.goal-percent{font-size:var(--zs-font-title);font-weight:600;color:var(--zs-brand);line-height:1.3}
.goal-caption{font-size:var(--zs-font-caption);color:var(--zs-text-3);margin-top:4rpx}
.goal-title{font-size:var(--zs-font-body);font-weight:600;line-height:1.5;margin-top:16rpx;overflow-wrap:anywhere}
.goal-target,.goal-collected{font-size:var(--zs-font-meta);line-height:1.6;color:var(--zs-text-3);overflow-wrap:anywhere}
.goal-collected{color:var(--zs-brand)}

.task-combobox{display:flex;align-items:center;min-height:88rpx;min-width:0;background:var(--zs-bg);border:1rpx solid var(--zs-line);border-radius:14rpx}
.task-combobox .task-title-input{flex:1;width:0;min-width:0;border:0;background:transparent}
.task-dropdown-toggle{display:flex;align-items:center;justify-content:center;width:88rpx;min-width:44px;height:88rpx;min-height:44px;padding:0;flex-shrink:0}
.task-dropdown-toggle image{width:14rpx;height:24rpx;transform:rotate(90deg)}.task-dropdown-toggle image.expanded{transform:rotate(-90deg)}
.task-options{margin-top:10rpx;border:1rpx solid var(--zs-line);border-radius:14rpx;overflow:hidden;background:var(--zs-card)}
.task-options-scroll{max-height:400rpx}
.task-option{display:flex;flex-direction:column;align-items:flex-start;width:100%;min-height:88rpx;padding:16rpx 20rpx;text-align:left;font-size:var(--zs-font-body);line-height:40rpx;border-radius:0;border-bottom:1rpx solid var(--zs-line);overflow-wrap:anywhere}
.task-option .hint{margin-top:2rpx}.task-custom-option{color:var(--zs-brand);background:#fcfaf6}
.task-options-hint{padding:16rpx 20rpx}.task-options-retry{display:flex;align-items:center;gap:12rpx;padding:10rpx 20rpx}.task-options-retry .hint{flex:1}.task-options-retry button{min-width:88rpx;min-height:88rpx;color:var(--zs-brand);font-size:var(--zs-font-meta);padding:12rpx}
.task-options-close{display:flex;align-items:center;justify-content:center;width:100%;min-height:80rpx;color:var(--zs-text-3);font-size:var(--zs-font-meta)}
.selected-task-type{margin:-8rpx 0 24rpx;color:var(--zs-brand);font-size:var(--zs-font-meta);line-height:36rpx}
