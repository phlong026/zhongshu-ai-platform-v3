<import src="../performance/settings.wxml"/>
<import src="../management-settings.wxml"/>
<view class="owner-page owner-detail"><owner-header id="subpage-header" title="{{title}}" back/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-period"><text class="owner-muted">{{desk.company}}</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<block wx:if="{{view==='targets'}}"><text class="owner-note">旧目标仅供历史核对，新周期请使用绩效任务。</text><template is="owner-performance-settings" data="{{performanceSettings:performanceSettings,saving:saving,readonly:true}}"/><button class="owner-link" data-action="rules" bindtap="go">查看已有考核方案<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></block>
<block wx:elif="{{view==='company'}}"><template is="owner-company-settings" data="{{managementSettings:managementSettings,companyForm:companyForm,saving:saving}}"/><view class="owner-card"><text class="owner-name">在岗成员 {{desk.staff.length}} 人</text><button class="owner-row" data-action="staff" bindtap="go"><text class="owner-name owner-grow">管理本店成员与权限</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view></block>
<view wx:elif="{{view==='receivable'||view==='payable'}}" class="owner-card"><view class="owner-heading"><text>{{title}}</text><text class="owner-badge">只读</text></view><view wx:if="{{record}}"><view class="owner-readonly-row"><text class="owner-muted">原单编号</text><text>{{record.id}}</text></view><view class="owner-readonly-row"><text class="owner-muted">原事项</text><text>{{record.name}}</text></view><view class="owner-readonly-row"><text class="owner-muted">当前未结</text><text>¥ {{record.amount/100}}</text></view><view class="owner-readonly-row"><text class="owner-muted">原约定金额</text><text>¥ {{record.total/100}}</text></view><view class="owner-readonly-row"><text class="owner-muted">已登记金额</text><text>¥ {{record.paid/100}}</text></view><view class="owner-readonly-row"><text class="owner-muted">状态</text><text>{{record.status}}</text></view><view class="owner-readonly-row"><text class="owner-muted">约定日期</text><text>{{record.due}}</text></view><view class="owner-readonly-row"><text class="owner-muted">来源</text><text>{{record.source}}</text></view><block wx:if="{{record.reminder}}"><view wx:if="{{record.reminder.ready}}" class="owner-note">{{record.reminder.text}}</view><text wx:else class="owner-note">{{record.reminder.reason}}</text><button wx:if="{{record.reminder.ready}}" class="owner-primary owner-save owner-reminder-copy" bindtap="copyReminder">复制催款话术</button><button wx:if="{{record.reminder.file}}" class="owner-link" bindtap="openReminderFile">查看原现场资料 {{record.reminder.file.name}}<image class="owner-arrow" src="/assets/creation-chevron.png"/></button><text wx:else class="owner-note">暂无可引用的实际现场照片</text></block><view wx:if="{{record.dunning}}"><view class="owner-readonly-row"><text class="owner-muted">工程催收</text><text>{{record.dunning.status}}</text></view><text class="owner-note">{{record.dunning.note}}</text><button class="owner-link owner-dunning-link" data-url="{{record.dunning.url}}" bindtap="go">查看催收记录与跟进<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view></view><view wx:else class="owner-empty">原记录不存在或已超出本组织范围</view></view>
<block wx:elif="{{view==='settings'}}"><template is="owner-assignment-settings" data="{{managementSettings:managementSettings,assignmentForm:assignmentForm,saving:saving}}"/><view class="owner-card"><view class="owner-heading"><text>人员与岗位分工</text></view><button class="owner-row" data-action="businessTeam" bindtap="go"><text class="owner-name owner-grow">业务团队</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="engineeringTeam" bindtap="go"><text class="owner-name owner-grow">工程团队</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="financeTeam" bindtap="go"><text class="owner-name owner-grow">财务团队</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view></block>
<block wx:elif="{{view==='rules'}}"><template is="owner-rules-settings" data="{{managementSettings:managementSettings,rulesForm:rulesForm,saving:saving}}"/></block>
<block wx:else><view class="owner-search"><image src="/assets/search.png" mode="aspectFit"/><input value="{{keyword}}" placeholder="搜索事项、项目或人员" bindinput="search"/><button wx:if="{{keyword}}" bindtap="clear">清空</button></view><view class="owner-card"><view class="owner-heading"><text>{{title}}</text><text class="owner-heading-meta">共{{total}}项</text></view><block wx:for="{{rows}}" wx:key="key"><button class="owner-row" data-key="{{item.key}}" bindtap="go"><image wx:if="{{item.image}}" class="owner-thumb" src="{{item.image}}" mode="aspectFill"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.status||item.detail||item.meta||item.due}}</text><text wx:if="{{item.amount===0||item.amount}}" class="owner-amount">{{view==='metric'?item.amount/100:item.amount}}{{view==='metric'?'元':view==='receivables'||view==='payables'?'万':''}}</text></view><text class="owner-link">{{item.action||(view==='approvals'?'去审批':'查看')}}<image class="owner-arrow" src="/assets/creation-chevron.png"/></text></button><button wx:if="{{view==='handover'&&item.workId&&!item.marked}}" class="owner-link" data-id="{{item.workId}}" bindtap="markHandover">标记需交接</button></block><view wx:if="{{!rows.length}}" class="owner-empty">{{keyword?'没有找到匹配内容':'当前暂无对应记录'}}</view><button wx:if="{{rows.length<total}}" class="owner-link owner-save" bindtap="loadMore">加载更多（已显示 {{rows.length}} / {{total}}）</button></view></block>
</block></view></view>
