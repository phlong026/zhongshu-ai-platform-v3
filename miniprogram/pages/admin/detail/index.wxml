<view class="owner-page owner-detail"><owner-header id="subpage-header" title="{{title}}" back/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-period"><text class="owner-muted">{{desk.company}}</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<block wx:if="{{view==='targets'}}"><view class="owner-card"><view class="owner-heading"><text>门店月度目标</text></view><view class="owner-form-row"><text>设计委托目标（元）</text><input type="digit" value="{{form.sales}}" data-field="sales" bindinput="input" placeholder="未设置"/></view><view class="owner-form-row"><text>回款目标（元）</text><input type="digit" value="{{form.collections}}" data-field="collections" bindinput="input" placeholder="未设置"/></view><view class="owner-form-row"><text>有效客户（个）</text><input type="number" value="{{form.effective}}" data-field="effective" bindinput="input" placeholder="未设置"/></view><view class="owner-form-row"><text>新增客户（位）</text><input type="number" value="{{form.customers}}" data-field="customers" bindinput="input" placeholder="未设置"/></view><view class="owner-form-row"><text>工程节点（项）</text><input type="number" value="{{form.nodes}}" data-field="nodes" bindinput="input" placeholder="未设置"/></view><text class="owner-note">目标用于本月进度对照，实际完成量继续取自原业务记录。</text></view><view class="owner-card"><view class="owner-heading"><text>人员月度目标</text></view><view wx:for="{{desk.team}}" wx:key="id" class="owner-form-row"><view><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.business?'设计委托金额（元）':'完成数量（项）'}}</text></view><input type="{{item.business?'digit':'number'}}" value="{{form.staff[item.id]}}" data-person="{{item.id}}" bindinput="input" placeholder="未设置"/></view><view wx:if="{{!desk.team.length}}" class="owner-empty">当前没有可配置目标的成员</view></view><button class="owner-primary owner-save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存本月目标</button><button class="owner-link" data-action="rules" bindtap="go">查看已有考核方案<image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-link" data-action="payroll" bindtap="go">绩效金额结算与发放<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></block>
<view wx:elif="{{view==='company'}}" class="owner-card"><view class="owner-heading"><text>当前门店</text></view><view class="owner-readonly-row"><text class="owner-muted">门店名称</text><text>{{desk.company}}</text></view><view class="owner-readonly-row"><text class="owner-muted">组织编号</text><text>{{desk.actor.companyId}}</text></view><view class="owner-readonly-row"><text class="owner-muted">当前人员</text><text>{{desk.name}} · {{desk.role}}</text></view><view class="owner-readonly-row"><text class="owner-muted">在岗成员</text><text>{{desk.staff.length}}人</text></view><button class="owner-row" data-action="staff" bindtap="go"><text class="owner-name owner-grow">管理本店成员与权限</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view>
<view wx:elif="{{view==='receivable'||view==='payable'}}" class="owner-card"><view class="owner-heading"><text>{{title}}</text><text class="owner-badge">只读</text></view><view wx:if="{{record}}"><view class="owner-readonly-row"><text class="owner-muted">原单编号</text><text>{{record.id}}</text></view><view class="owner-readonly-row"><text class="owner-muted">原事项</text><text>{{record.name}}</text></view><view class="owner-readonly-row"><text class="owner-muted">当前未结</text><text>¥ {{record.amount/100}}</text></view><view class="owner-readonly-row"><text class="owner-muted">原约定金额</text><text>¥ {{record.total/100}}</text></view><view class="owner-readonly-row"><text class="owner-muted">已登记金额</text><text>¥ {{record.paid/100}}</text></view><view class="owner-readonly-row"><text class="owner-muted">状态</text><text>{{record.status}}</text></view><view class="owner-readonly-row"><text class="owner-muted">约定日期</text><text>{{record.due}}</text></view><view class="owner-readonly-row"><text class="owner-muted">来源</text><text>{{record.source}}</text></view></view><view wx:else class="owner-empty">原记录不存在或已超出本组织范围</view></view>
<block wx:elif="{{view==='settings'}}"><view class="owner-card"><view class="owner-heading"><text>审批规则</text></view><view class="owner-readonly-row"><text class="owner-muted">金额事项</text><text>本组织老板审批</text></view><view class="owner-readonly-row"><text class="owner-muted">设计成果及施工图</text><text>线下专业审核，行政登记下发</text></view><view class="owner-readonly-row"><text class="owner-muted">阶段验收</text><text>工程人员记录实际节点与交付</text></view><view class="owner-readonly-row"><text class="owner-muted">收付款登记</text><text>财务登记实际收付，总部另核实设计款到账</text></view></view><view class="owner-card"><view class="owner-heading"><text>人员与岗位分工</text></view><button class="owner-row" data-action="businessTeam" bindtap="go"><text class="owner-name owner-grow">业务团队</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="engineeringTeam" bindtap="go"><text class="owner-name owner-grow">工程团队</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="financeTeam" bindtap="go"><text class="owner-name owner-grow">财务团队</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view></block>
<block wx:else><view wx:if="{{view==='business'||view==='engineering'||view==='team'||view==='todos'||view==='receivables'||view==='payables'}}" class="owner-search"><image src="/assets/search.png" mode="aspectFit"/><input value="{{keyword}}" placeholder="搜索客户、项目或人员" bindinput="search"/><button wx:if="{{keyword}}" bindtap="clear">清空</button></view><view class="owner-card"><view class="owner-heading"><text>{{title}}</text><text class="owner-heading-meta">共{{total}}项</text></view><button wx:for="{{rows}}" wx:key="key" class="owner-row" data-key="{{item.key}}" bindtap="go"><image wx:if="{{item.image}}" class="owner-thumb" src="{{item.image}}" mode="aspectFill"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.status||item.meta||item.due}}</text><text wx:if="{{item.amount}}" class="owner-amount">{{item.amount}}{{view==='receivables'||view==='payables'?'万':''}}</text></view><text class="owner-link">{{view==='approvals'?'去审批':'查看'}}<image class="owner-arrow" src="/assets/creation-chevron.png"/></text></button><view wx:if="{{!rows.length}}" class="owner-empty">{{keyword?'没有找到匹配内容':'当前暂无对应记录'}}</view><button wx:if="{{rows.length<total}}" class="owner-link owner-save" bindtap="loadMore">加载更多（已显示 {{rows.length}} / {{total}}）</button></view></block>
</block></view></view>
