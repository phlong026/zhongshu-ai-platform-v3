page{background:#f7f5f0;color:#302d29}.accounting-body{padding:28rpx 28rpx 80rpx}.accounting-heading,.accounting-history-top,.accounting-history-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:10rpx 0 24rpx}.accounting-name{display:block;font-size:36rpx;font-weight:600;margin-bottom:12rpx}.accounting-state{font-size:23rpx;color:#5c7664}.accounting-warning{color:#a16928}.accounting-card{background:#fff;border:1rpx solid #ece7de;border-radius:20rpx;padding:30rpx;margin-bottom:24rpx}.accounting-caption{font-size:26rpx;color:#6d6257}.accounting-profit{font-size:54rpx;font-weight:600;color:#714d32;line-height:1.5;margin:10rpx 0}.accounting-muted{display:block;font-size:23rpx;color:#8d867d;line-height:1.65}.accounting-cash{display:flex;justify-content:space-between;font-size:29rpx;padding-top:28rpx;margin:26rpx 0 10rpx;border-top:1rpx solid #eee9e0}.accounting-metrics{padding-top:24rpx}.accounting-metrics>view{display:flex;justify-content:space-between;gap:20rpx;padding:13rpx 0;font-size:26rpx}.accounting-metrics>view>text:first-child{color:#81796f}.accounting-title{font-size:30rpx;font-weight:600;display:block;margin-bottom:10rpx}.accounting-note{padding:0 6rpx 28rpx;font-size:25rpx;line-height:1.8}.accounting-note>.accounting-muted{margin-top:12rpx}.accounting-error{display:block;background:#fff0e9;color:#95533a;border-radius:12rpx;padding:22rpx;margin-bottom:24rpx;font-size:25rpx;line-height:1.7}.accounting-link{font-size:25rpx;color:#80512e;background:transparent;line-height:1.7;padding:8rpx 0;margin:0;white-space:nowrap}.accounting-link::after{border:none}.accounting-primary,.accounting-secondary{font-size:28rpx;padding:6rpx 24rpx;border-radius:12rpx;margin-top:22rpx;background:#80512e;color:#fff}.accounting-secondary{background:#eee7dd;color:#6c503b}.accounting-check{display:flex;gap:12rpx;align-items:flex-start;font-size:26rpx;line-height:1.7;margin:28rpx 0 20rpx}.accounting-check checkbox{transform:scale(.83);transform-origin:left top;flex:none}.accounting-input{box-sizing:border-box;background:#f8f6f2;border-radius:12rpx;width:100%;padding:22rpx;font-size:26rpx;min-height:150rpx;line-height:1.6}.accounting-empty{display:block;padding:70rpx 30rpx;text-align:center;font-size:26rpx;color:#8e867d;line-height:1.9}.accounting-history-heading{margin-top:38rpx}.accounting-history .accounting-metrics{padding-top:0}.accounting-record-note{display:block;border-top:1rpx solid #eee9e0;padding-top:20rpx;margin-top:16rpx;font-size:25rpx;line-height:1.7;color:#6a6258;white-space:pre-wrap}.accounting-more{margin:auto}.accounting-history-top>text:first-child{font-size:28rpx;font-weight:600}button[disabled]{opacity:.55}
