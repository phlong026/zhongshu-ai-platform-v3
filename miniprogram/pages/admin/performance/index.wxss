@import "../owner.wxss";
.perf-targets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.perf-target{background:#fcf8f2;border-radius:18rpx;padding:20rpx 22rpx}.perf-figure{display:flex;align-items:baseline;margin-top:6rpx}.perf-value{font-size:var(--zs-font-heading);line-height:56rpx;font-weight:700;color:var(--boss-brown)}.perf-goal{font-size:var(--zs-font-meta);line-height:36rpx;color:var(--boss-muted);margin-left:6rpx}.perf-filters{width:100%;margin:4rpx 0 20rpx}.perf-filter-row{display:flex;gap:12rpx;width:max-content;padding:0 2rpx}.perf-filter{min-width:108rpx;padding:14rpx 28rpx;border-radius:999rpx;background:#f1ece5;color:var(--boss-muted);font-size:var(--zs-font-meta);line-height:36rpx}.perf-filter.is-active{background:var(--boss-brown);color:var(--zs-card)}.perf-department-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.perf-department-card{padding:20rpx;border-radius:18rpx;background:#fcf8f2}.perf-department-card.is-business{grid-column:1/-1}.perf-department-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:24rpx}.perf-department-title{display:block;font-size:var(--zs-font-emphasis);font-weight:700;color:var(--boss-brown);margin-bottom:12rpx}.perf-department-metric{display:flex;flex-direction:column;gap:4rpx;margin-top:12rpx;font-size:var(--zs-font-meta)}.perf-group{display:flex;justify-content:space-between;gap:20rpx;color:var(--boss-muted);font-size:var(--zs-font-meta);line-height:36rpx;padding:18rpx 0 6rpx}.perf-group text:last-child{text-align:right}.perf-person-wrap{border-bottom:1rpx solid #ebe5dc}.perf-person{width:100%;display:flex;align-items:center;gap:18rpx;padding:18rpx 0;text-align:left}.perf-percent{min-width:96rpx;text-align:right;flex-shrink:0}.perf-person-metrics{display:flex;flex-direction:column;gap:4rpx;margin:6rpx 0}.perf-person .owner-arrow.is-expanded{transform:rotate(90deg)}.perf-records{padding:0 0 16rpx 72rpx}.perf-record{width:100%;display:flex;align-items:center;gap:12rpx;padding:14rpx 0;text-align:left;border-top:1rpx solid #f1ece5}.perf-record .owner-name{font-size:var(--zs-font-meta)}.perf-record .owner-link{white-space:nowrap}@media(max-width:360px){.perf-department-grid,.perf-department-metrics{grid-template-columns:1fr}}
