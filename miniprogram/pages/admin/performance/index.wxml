<view class="owner-page">
<owner-header title="历史绩效指标"/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}"><button class="owner-primary owner-save" data-action="tasks" bindtap="go">进入绩效任务</button><text class="owner-note">本页仅查看旧目标与历史指标，不再新建目标或薪酬规则。</text>
<view class="owner-period"><text class="owner-muted">{{desk.company}} · 在岗 {{desk.performance.headcount}} 人 · {{desk.performance.cutoff}} </text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<view class="owner-card"><view class="owner-heading"><text>历史公司目标</text><text class="owner-heading-meta">只读</text></view><view class="perf-targets"><view wx:for="{{desk.performance.targets}}" wx:key="label" class="perf-target"><text class="owner-muted">{{item.label}}</text><view class="perf-figure"><text class="perf-value">{{item.value}}</text><text class="perf-goal">{{item.unit}} / {{item.target?item.target+item.unit:'未设置'}}</text></view><view class="owner-progress"><view style="width:{{item.width}}%"/></view></view></view></view>
<text wx:if="{{desk.performance.unassignedCommissions}}" class="owner-note">{{desk.performance.unassignedCommissions}}笔历史委托缺少责任证据，暂未分配到个人。</text><text wx:if="{{desk.performance.undatedDesign}}" class="owner-note">{{desk.performance.undatedDesign}}套成果缺少原约定日期，未计入按期或逾期。</text>
<scroll-view class="perf-filters" scroll-x="true" show-scrollbar="false"><view class="perf-filter-row"><button wx:for="{{desk.performance.filterOptions}}" wx:key="id" class="perf-filter {{desk.performance.selectedDepartment===item.id?'is-active':''}}" data-department="{{item.id}}" bindtap="departmentFilter">{{item.label}}</button></view></scroll-view>
<view class="owner-card"><view class="owner-heading"><text>部门指标</text><text class="owner-heading-meta">业务统一考核</text></view><view class="perf-department-grid"><view wx:for="{{desk.performance.departmentCards}}" wx:key="key" class="perf-department-card {{item.key==='business'?'is-business':''}}"><text class="perf-department-title">{{item.label}}</text><view class="perf-department-metrics"><view wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="id" class="perf-department-metric"><text class="owner-muted">{{metric.label}}</text><text>{{metric.display}}{{metric.displayUnit}}<text class="owner-muted"> / {{metric.targetDisplay?metric.targetDisplay+metric.displayUnit:'待设置'}}</text></text><view class="owner-progress"><view style="width:{{metric.width}}%"/></view></view></view></view></view></view>
<view class="owner-card"><view class="owner-heading"><text>团队</text><text class="owner-heading-meta">点成员查看办理记录</text></view><block wx:for="{{desk.performance.groups}}" wx:for-item="group" wx:key="key"><view class="perf-group"><text>{{group.label}}</text><text>{{group.metric}}</text></view><view wx:for="{{group.rows}}" wx:for-item="person" wx:key="key" class="perf-person-wrap"><view class="perf-person" data-person="{{person.id}}" data-department="{{person.department}}" bindtap="togglePerson"><view class="owner-initial">{{person.initial}}</view><view class="owner-grow"><text class="owner-name">{{person.name}} <text class="owner-badge">{{person.role}}</text></text><view class="perf-person-metrics"><text wx:for="{{person.metrics}}" wx:for-item="metric" wx:key="id" class="owner-muted">{{metric.label}} {{metric.display}}{{metric.displayUnit}}{{metric.targetDisplay?' / '+metric.targetDisplay+metric.displayUnit:''}}</text></view><view class="owner-progress"><view style="width:{{person.width}}%"/></view></view><text class="owner-percent perf-percent">{{person.percent===null?'待设置':person.percent+'%'}}</text><image class="owner-arrow {{person.expanded?'is-expanded':''}}" src="/assets/creation-chevron.png"/></view><view wx:if="{{person.expanded}}" class="perf-records"><button wx:for="{{person.recentRecords}}" wx:key="key" class="perf-record" data-url="{{item.url}}" catchtap="openSource"><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.meta}} · {{item.sourceId}}</text></view><text class="owner-link">查看<image class="owner-arrow" src="/assets/creation-chevron.png"/></text></button><view wx:if="{{!person.recentRecords.length}}" class="owner-empty">本月暂无办理记录</view></view></view></block><empty-state wx:if="{{!desk.performance.groups.length}}" custom-class="owner-empty" message="当前筛选暂无在岗成员"/></view>
</block></view><owner-nav id="owner-navigation" active="performance"/></view>
