<view class="owner-page"><owner-header title="绩效"/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-period"><text class="owner-muted">{{desk.company}} · 在岗 {{desk.performance.headcount}} 人 · {{desk.performance.cutoff}} </text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<view class="owner-card"><view class="owner-heading"><text>公司目标</text><button class="owner-link" data-action="goals" bindtap="go">去设置<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="perf-targets"><view wx:for="{{desk.performance.targets}}" wx:key="label" class="perf-target"><text class="owner-muted">{{item.label}}</text><view class="perf-figure"><text class="perf-value">{{item.value}}</text><text class="perf-goal"> / {{item.target?item.target+item.unit:'待设置'}}</text></view><view class="owner-progress"><view style="width:{{item.width}}%"/></view></view></view></view>
<view class="owner-card"><view class="owner-heading"><text>团队</text><text class="owner-heading-meta">点人看原记录</text></view><block wx:for="{{desk.performance.groups}}" wx:for-item="group" wx:key="key"><view class="perf-group"><text>{{group.label}}</text><text>{{group.metric}}</text></view><button wx:for="{{group.rows}}" wx:key="key" class="perf-person" data-key="{{item.key}}" bindtap="openRow"><view class="owner-initial">{{item.initial}}</view><view class="owner-grow"><text class="owner-name">{{item.name}} <text class="owner-badge">{{item.role}}</text></text><text class="owner-muted">{{item.result}}</text><view class="owner-progress"><view style="width:{{item.width}}%"/></view></view><text class="owner-percent perf-percent">{{item.percent===null?'待设置':item.percent+'%'}}</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></block><view wx:if="{{!desk.performance.groups.length}}" class="owner-empty">当前暂无在岗成员</view></view>
</block></view><owner-nav id="owner-navigation" active="performance"/></view>
