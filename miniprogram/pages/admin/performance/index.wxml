<view class="owner-page"><owner-header title="绩效"/><view class="owner-content"><button class="owner-outline" data-action="payroll" bindtap="go">绩效金额结算与发放</button><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-period"><text class="owner-muted">{{desk.company}}</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<view class="owner-card"><view class="owner-heading"><text>目标总览</text></view><view class="owner-target"><view class="owner-keyline"><text class="owner-name">本月目标</text><text class="owner-muted">截至{{desk.dateShort}}</text></view><text class="owner-name">业务签约</text><view class="owner-keyline"><view><text class="owner-figure">{{desk.metrics[0].value}}</text><text class="owner-denominator">{{desk.salesTargetLabel}}</text></view><text class="owner-percent">{{desk.metrics[0].percent===null?'目标待设置':desk.metrics[0].percent+'%'}}</text></view><view wx:if="{{desk.metrics[0].percent!==null}}" class="owner-progress"><view style="width:{{desk.metrics[0].width}}%"/></view>
<view wx:for="{{desk.secondaryMetrics}}" wx:key="label" class="owner-metric"><view class="owner-keyline"><view><text class="owner-name">{{item.label}}</text><text class="owner-muted">{{item.value}} / {{item.target||'目标待设置'}} {{item.unit}}</text></view><text class="owner-percent">{{item.percent===null?'待设置':item.percent+'%'}}</text></view><view wx:if="{{item.percent!==null}}" class="owner-progress"><view style="width:{{item.width}}%"/></view></view></view>
<view class="owner-tools owner-review-link"><button class="owner-tool" data-action="goals" bindtap="go"><view class="owner-tool-icon"><image src="/assets/settings.png" mode="aspectFit"/></view><text>目标设置</text></button><button class="owner-tool" data-action="team" bindtap="go"><view class="owner-tool-icon"><image src="/assets/team.png" mode="aspectFit"/></view><text>团队绩效</text></button><button class="owner-tool" data-action="reviews" bindtap="go"><view class="owner-tool-icon"><image src="/assets/management-appeal.jpg" mode="aspectFit"/></view><text>结果复核 {{desk.reviewTotal}}</text></button></view></view>
<view class="owner-card"><view class="owner-heading"><text>团队进展</text><button class="owner-link" data-action="team" bindtap="go">查看全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><button wx:for="{{desk.previewTeam}}" wx:key="key" class="owner-row" data-key="{{item.key}}" bindtap="go"><view class="owner-initial">{{item.initial}}</view><view class="owner-grow"><view class="owner-keyline"><text class="owner-name">{{item.name}} <text class="owner-badge">{{item.kind}}</text></text><text class="owner-percent">{{item.percent===null?'':item.percent+'%'}}</text></view><text class="owner-muted">{{item.metric}} {{item.value}}{{item.unit}}{{item.target?' / 目标'+item.target+item.unit:' · 个人目标待设置'}}</text><view wx:if="{{item.percent!==null}}" class="owner-progress"><view style="width:{{item.width}}%"/></view></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><view wx:if="{{!desk.team.length}}" class="owner-empty">当前暂无在岗业务或工程成员</view></view>
</block></view><owner-nav id="owner-navigation" active="performance"/></view>
