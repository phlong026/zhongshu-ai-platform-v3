<brand-header title="{{admin?'加盟商地图':'门店地图'}}" back="{{true}}" hide-home="{{true}}"/>
<view class="map-page">
  <view wx:if="{{loading}}" class="map-message">正在读取地图与地区资料…</view>
  <view wx:elif="{{error}}" class="map-message"><text>{{error}}</text><button bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="map-search">
      <image src="/assets/search.png" mode="aspectFit"/>
      <input value="{{query}}" placeholder="{{admin?'搜索省/市/区县或门店名称':'搜索区县或门店名称'}}" maxlength="80" confirm-type="search" bindinput="searchInput" bindconfirm="confirmSearch" aria-label="搜索地区或加盟商"/>
      <button wx:if="{{query||keyword}}" bindtap="clearSearch">清除</button>
    </view>
    <view wx:if="{{searchOpen}}" class="search-results">
      <button wx:for="{{suggestions}}" wx:key="code" class="search-result" data-code="{{item.code}}" bindtap="chooseSearchRegion">
        <image src="/assets/icons/map-pin.svg" mode="aspectFit"/><text>{{item.label}}</text><image class="result-chevron" src="/assets/creation-chevron.png" mode="aspectFit"/>
      </button>
      <button class="name-search" bindtap="searchName">按门店名称、地址或地区查询“{{query}}”</button>
    </view>
    <view class="map-overview">
      <view class="overview-item">
        <view class="metric-icon"><image src="/assets/account-shop.jpg" mode="aspectFit"/></view>
        <view><text class="metric-label">{{admin?'加盟商总数':'本品牌加盟商'}}</text><view class="metric-value"><text>{{overview.franchiseCount}}</text><text class="metric-unit">家</text></view></view>
      </view>
      <view class="overview-item">
        <view class="metric-icon"><image src="/assets/icons/map-pin.svg" mode="aspectFit"/></view>
        <view><text class="metric-label">覆盖区县</text><view class="metric-value"><text>{{overview.districtCount}}</text><text class="metric-unit">个</text></view></view>
      </view>
      <text wx:if="{{overview.coverageRecordCount}}" class="overview-note">另有 {{overview.coverageRecordCount}} 条品牌覆盖记录，单独统计</text>
    </view>
    <view class="regions {{admin?'regions-admin':''}}">
      <view wx:if="{{admin}}" class="region-field brand-filter">
        <text class="picker-label">品牌</text>
        <picker range="{{brands}}" range-key="name" value="{{brandIndex}}" bindchange="changeBrand">
          <view class="picker-value"><text>{{selectedBrand?brands[brandIndex].name:'全部'}}</text><image src="/assets/creation-chevron.png" mode="aspectFit"/></view>
        </picker>
      </view>
      <view wx:for="{{pickers}}" wx:key="key" class="region-field">
        <text class="picker-label">{{item.title}}</text>
        <picker range="{{item.choices}}" range-key="name" value="{{item.index}}" disabled="{{item.disabled}}" data-index="{{index}}" bindchange="changeRegion">
          <view class="picker-value {{item.disabled?'disabled':''}}"><text>{{item.choices[item.index].name}}</text><image src="/assets/creation-chevron.png" mode="aspectFit"/></view>
        </picker>
      </view>
    </view>
    <map id="stores" class="map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" bindupdated="fitMarkers" bindregionchange="onRegionChange" bindmarkertap="selectMarker" bindcallouttap="selectMarker" enable-zoom="{{true}}" enable-scroll="{{true}}">
      <cover-view slot="callout">
        <cover-view wx:for="{{callouts}}" wx:key="id" marker-id="{{item.id}}" data-marker-id="{{item.id}}" bindtap="selectMarker" class="county-callout">
          <cover-view wx:if="{{item.selected}}" class="callout-detail">
            <cover-view class="callout-title">{{item.heading}}</cover-view>
            <cover-view wx:for="{{item.brands}}" wx:for-item="brand" wx:key="id" class="callout-brand">
              <cover-view class="callout-dot" style="background-color:{{brand.color}}"/>
              <cover-view class="callout-name">{{brand.name}}</cover-view><cover-view class="callout-count">{{brand.detail}}</cover-view>
            </cover-view>
          </cover-view>
          <cover-view class="pin-count" style="background-color:{{item.pinColor}}">{{item.pinText}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view class="zoom-actions">
        <cover-view class="zoom-button" data-delta="1" bindtap="zoom" aria-label="放大地图">＋</cover-view>
        <cover-view class="zoom-button zoom-out" data-delta="-1" bindtap="zoom" aria-label="缩小地图">−</cover-view>
      </cover-view>
    </map>
    <view wx:if="{{upperCoverageLabel}}" class="area-coverage-label">{{upperCoverageLabel}} · 不计入加盟商家数</view>
    <view wx:if="{{admin&&brandCounts.length&&(mode==='region'||(!viewportLoading&&!viewportError&&summary.status!=='loading'))}}" class="map-legend">
      <view wx:for="{{brandCounts}}" wx:key="id" class="legend-item"><text class="dot" style="background:{{item.color}}"/><text>{{item.name}} ({{item.franchiseCount}})</text></view>
    </view>
    <view wx:if="{{focusNote}}" class="focus-note">{{focusNote}}</view>
    <view class="area-summary">
      <view class="summary-heading area-quick-status">
        <view class="summary-icon"><image src="/assets/icons/map-pin.svg" mode="aspectFit"/></view><text class="summary-title">{{summary.title}}</text>
        <text class="status status-{{summary.status}}">{{mode==='viewport'&&viewportError?'范围读取失败':mode==='viewport'&&viewportLoading?'正在更新':summary.statusText}}</text>
      </view>
      <view wx:if="{{mode==='viewport'&&viewportError}}" class="viewport-error"><text>{{viewportError}}</text><button bindtap="refreshViewport">重试</button></view>
      <view wx:elif="{{summary.status!=='loading'&&(mode==='region'||!viewportLoading)}}" class="summary-metrics {{admin?'summary-admin':'summary-store'}}">
        <view><text wx:if="{{!admin}}" class="store-metric-label">本品牌加盟商</text><view class="summary-number">{{summary.franchiseCount}}<text>家</text></view><text wx:if="{{admin}}">加盟商总数</text></view>
        <view wx:if="{{admin}}"><view class="summary-number">{{summary.brandCount}}<text>个</text></view><text>覆盖品牌</text></view>
        <view wx:if="{{!admin&&summary.franchiseCount&&brandName}}" class="summary-brand"><text class="dot"/><text>覆盖门店（{{brandName}}）</text></view>
      </view>
      <text wx:if="{{summary.coverageRecordCount&&(mode==='region'||(!viewportError&&!viewportLoading))}}" class="coverage-note">另有 {{summary.coverageRecordCount}} 条覆盖记录</text>
      <text wx:if="{{summary.pendingCount}}" class="pending-note">{{summary.pendingCount}} 条资料尚待确认区县，见下方名单</text>
      <text wx:if="{{summary.offMapPendingCount}}" class="pending-note">另有 {{summary.offMapPendingCount}} 条资料未完整定位，不计入未确认地区的视野统计</text>
    </view>
    <block wx:if="{{mode==='region'||(!viewportError&&!viewportLoading&&summary.status!=='loading')}}">
    <block wx:if="{{admin&&brandCounts.length}}">
      <view class="section-heading map-section-heading"><text class="section-title">品牌分布</text><text class="section-meta">{{mode==='region'?'当前行政区域':'当前地图视野'}}</text></view>
      <view class="brand-list">
        <button wx:for="{{brandCounts}}" wx:key="id" class="brand-row {{item.franchiseCount||item.coverageRecordCount||item.pendingCount?'':'brand-empty'}}" data-id="{{item.id}}" bindtap="changeBrand">
          <text class="dot" style="background:{{item.color}}"/><text class="brand-name">{{item.name}}</text>
          <view class="brand-amount"><text>{{item.franchiseCount}} 家</text><text wx:if="{{item.coverageRecordCount}}" class="brand-extra">覆盖记录 {{item.coverageRecordCount}} 条</text><text wx:if="{{item.pendingCount}}" class="brand-extra">待确认 {{item.pendingCount}} 条</text></view>
        </button>
      </view>
    </block>
    </block>
    <block wx:if="{{pinned||keyword||mode==='region'||(!viewportError&&!viewportLoading&&summary.status!=='loading')}}">
    <view class="section-heading map-section-heading list-head">
      <text class="section-title">{{pinned?'该点资料':keyword?'名称查询结果':mode==='region'&&summary.shortTitle!=='全国已登记范围'?summary.shortTitle+' · 加盟商列表':'加盟商列表'}}（{{total}} {{pinned||keyword||summary.coverageRecordCount||summary.pendingCount?'条':'家'}}）</text>
      <button wx:if="{{pinned}}" bindtap="showAll">查看全部</button>
    </view>
    <view wx:if="{{keyword}}" class="query-note"><text>名称搜索（跨地区）匹配 {{searchMatchCount}} 条资料：{{keyword}}</text><button bindtap="clearSearch">取消查询</button></view>
    <view class="stores">
      <button wx:for="{{rows}}" wx:key="id" class="store" data-id="{{item.id}}" bindtap="toggleRecord">
        <view class="record-icon"><image src="{{item.recordType==='FRANCHISE'?'/assets/account-shop.jpg':'/assets/icons/map-pin.svg'}}" mode="aspectFit"/></view>
        <view class="record-content">
          <view class="record-heading"><text class="name">{{item.name}}</text><text wx:if="{{item.pending}}" class="record-status">{{item.upperCoverageLabel?item.upperCoverageLabel+' · 区县待确认':'待确认'}}</text></view>
          <view wx:if="{{admin||item.recordType==='COVERAGE'}}" class="record-brand"><text class="dot" style="background:{{item.color}}"/><text>{{item.brandName}} · {{item.typeLabel}}</text></view>
          <view class="record-address"><image src="/assets/icons/map-pin.svg" mode="aspectFit"/><text>{{item.publicAddress||item.regionText}}</text></view>
          <text wx:if="{{item.districtCount>1}}" class="record-coverage">已确认覆盖 {{item.districtCount}} 个区县</text>
          <text wx:if="{{expandedId===item.id&&item.districtNames}}" class="record-detail">{{item.districtNames}}</text>
          <text wx:if="{{expandedId===item.id}}" class="record-detail">{{item.pending?'区县归属尚未完整确认':'登记地区已确认'}} · {{item.recordType==='FRANCHISE'?'按加盟商去重统计':'覆盖记录不计入加盟商家数'}}</text>
        </view>
        <image class="record-chevron {{expandedId===item.id?'expanded':''}}" src="/assets/creation-chevron.png" mode="aspectFit"/>
      </button>
      <view wx:if="{{!total}}" class="map-message">{{keyword?'未找到匹配的门店名称、地址或地区':mode==='viewport'?'当前视野暂无可定位记录':'当前区域暂无已登记记录'}}</view>
      <button wx:if="{{total>rows.length}}" class="more" bindtap="more">查看更多记录</button>
    </view>
    </block>
    <view class="map-options">
      <view class="count-tabs">
        <button class="{{mode==='region'?'active':''}}" data-mode="region" bindtap="changeMode">按行政区域统计</button>
        <button class="{{mode==='viewport'?'active':''}}" data-mode="viewport" bindtap="changeMode">按地图视野统计</button>
      </view>
      <text class="summary-note">{{mode==='region'?'按所选行政区域统计，拖动地图不改变区域数据':'按地图视野统计，不随名称搜索变化；同一加盟商跨县只计一次'}}</text>
      <text class="summary-note">地图点位按区县中心展示</text>
    </view>
  </block>
</view>
