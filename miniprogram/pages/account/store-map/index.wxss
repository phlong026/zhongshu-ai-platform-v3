.map-page {
  padding: 12rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  color: var(--zs-text);
}
.map-context {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx 16rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  background: #f3ebe1;
  border-radius: 24rpx;
}
.scope { flex: 1; min-width: 0; }
.scope-title, .scope-label { display: block; }
.scope-title {
  color: var(--zs-ink);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.scope-label { margin-top: 4rpx; font-size: 23rpx; line-height: 30rpx; color: var(--zs-text-2); }
.map-overview { display: flex; flex: none; }
.overview-item { display: flex; flex-direction: column; min-width: 104rpx; padding: 0 18rpx; text-align: center; }
.overview-item + .overview-item { border-left: 1rpx solid #dfd2c4; padding-right: 4rpx; }
.metric-value { color: var(--zs-brand-press); font-size: 40rpx; font-weight: 700; line-height: 44rpx; font-variant-numeric: tabular-nums; }
.metric-label { color: var(--zs-text-2); font-size: 21rpx; line-height: 32rpx; white-space: nowrap; }
.overview-note { width: 100%; color: var(--zs-text-2); font-size: 22rpx; line-height: 30rpx; }
.map-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: var(--zs-control-height);
  margin: 18rpx 0;
  padding: 0 22rpx;
  border: 1rpx solid var(--zs-line);
  border-radius: 18rpx;
  background: var(--zs-card);
}
.map-search > image { width: 32rpx; height: 32rpx; flex: none; }
.map-search input { flex: 1; width: 0; min-width: 0; height: var(--zs-control-height); font-size: var(--zs-font-body); }
.map-search button, .name-search, .query-note button { flex: none; padding: 12rpx 0; color: var(--zs-brand-press); font-size: var(--zs-font-meta); }
.search-results { margin: -6rpx 0 18rpx; padding: 0 20rpx; border: 1rpx solid var(--zs-line); border-radius: 18rpx; background: var(--zs-card); }
.search-result { display: flex; align-items: center; gap: 14rpx; width: 100%; min-height: 80rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--zs-line); text-align: left; font-size: var(--zs-font-body); }
.search-result > image { width: 28rpx; height: 28rpx; flex: none; }
.search-result > text { flex: 1; line-height: 40rpx; }
.search-result .result-chevron { width: 12rpx; height: 20rpx; }
.name-search { width: 100%; min-height: 80rpx; text-align: left; }
.map-frame {
  overflow: hidden;
  border: 1rpx solid var(--zs-line);
  border-radius: 24rpx;
  background: var(--zs-card);
}
.map {
  display: block;
  width: 100%;
  height: 580rpx;
  min-height: 250px;
  max-height: 370px;
  background: #edece7;
}
.map-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 8rpx 20rpx; color: var(--zs-text-3); font-size: 22rpx; line-height: 32rpx; }
.map-footer > text { flex: 1; min-width: 0; }
.zoom-actions { display: flex; gap: 12rpx; flex: none; }
.zoom-actions button { min-width: 76rpx; min-height: 58rpx; padding: 6rpx 14rpx; border-radius: 12rpx; background: #f4eee7; color: var(--zs-brand-press); font-size: 23rpx; }
.filter-panel { margin: 20rpx 0 16rpx; padding: 18rpx 20rpx 20rpx; border: 1rpx solid var(--zs-line); border-radius: 24rpx; background: var(--zs-card); }
.filter-heading { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.filter-title { font-size: 27rpx; font-weight: 700; line-height: 38rpx; white-space: nowrap; }
.count-tabs { display: flex; flex: none; gap: 3rpx; padding: 4rpx; border-radius: 14rpx; background: #f1ece6; }
.count-tabs button { min-height: 55rpx; padding: 0 19rpx; border-radius: 11rpx; color: var(--zs-text-2); font-size: 23rpx; line-height: 55rpx; white-space: nowrap; }
.count-tabs .active { background: var(--zs-card); color: var(--zs-brand-press); font-weight: 700; }
.brand-filter { display: flex; align-items: center; gap: 16rpx; margin-top: 14rpx; font-size: var(--zs-font-meta); }
.brand-filter > picker { flex: 1; min-width: 0; }
.brand-filter .picker-value > text { flex: 1; }
.regions { display: flex; gap: 10rpx; margin-top: 14rpx; }
.region-field { flex: 1; min-width: 0; }
.picker-label { display: block; margin: 0 2rpx 5rpx; color: var(--zs-text-3); font-size: 21rpx; }
.picker-value { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; min-height: 64rpx; padding: 10rpx 12rpx; border: 1rpx solid var(--zs-line); border-radius: 11rpx; background: var(--zs-card); font-size: 24rpx; }
.picker-value > text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-value > image { width: 11rpx; height: 17rpx; flex: none; transform: rotate(90deg); }
.picker-value.disabled { background: #f7f5f1; color: var(--zs-text-3); }
.county-callout { min-width: 176rpx; max-width: 322rpx; padding: 10rpx 13rpx; border: 1rpx solid #dfd2c4; border-radius: 13rpx; background: var(--zs-card); color: var(--zs-text); font-size: 22rpx; }
.callout-selected { border: 2rpx solid #af774e; background: #fffaf5; }
.callout-title { margin-bottom: 3rpx; font-weight: 700; line-height: 32rpx; white-space: normal; }
.callout-brand { display: flex; align-items: center; min-height: 30rpx; line-height: 30rpx; }
.callout-dot { width: 12rpx; height: 12rpx; min-width: 12rpx; margin-right: 7rpx; border-radius: 6rpx; }
.callout-name { max-width: 150rpx; margin-right: 10rpx; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }
.callout-count { color: var(--zs-text-2); white-space: nowrap; }
.map-load-error { margin-top: 28rpx; border: 1rpx solid var(--zs-line); border-radius: 24rpx; background: var(--zs-card); }
.load-title { margin-bottom: 8rpx; color: var(--zs-ink); font-size: 30rpx; font-weight: 700; }
.map-load-error button { min-width: 200rpx; min-height: 76rpx; border-radius: 14rpx; background: #f3ebe1; }
.focus-note{margin:0 0 16rpx;padding:14rpx 18rpx;border-radius:var(--zs-control-radius);background:var(--zs-champagne-soft);font-size:var(--zs-font-meta);line-height:36rpx;color:var(--zs-brand-press)}.record-coverage{display:block;margin-top:8rpx;font-size:var(--zs-font-caption);line-height:32rpx;color:var(--zs-brand-press)}
.map-legend{display:flex;flex-wrap:wrap;gap:12rpx 22rpx;padding:12rpx 4rpx 18rpx}.legend-item{display:flex;align-items:center;gap:8rpx;font-size:var(--zs-font-caption);line-height:32rpx}.dot{display:inline-block;flex:none;width:17rpx;height:17rpx;border-radius:50%}
.area-summary,.brand-list,.stores{background:var(--zs-card);border:1rpx solid var(--zs-line);border-radius:24rpx}
.area-summary{padding:22rpx 24rpx}.summary-heading{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx 12rpx}.summary-heading>image{width:30rpx;height:30rpx;flex:none}.summary-title{flex:1;min-width:190rpx;font-size:var(--zs-font-body);font-weight:600;line-height:42rpx}.status{display:inline-flex;align-items:center;border-radius:8rpx;padding:6rpx 10rpx;font-size:var(--zs-font-caption);line-height:30rpx;max-width:100%;background:var(--zs-bg);color:var(--zs-text-2)}.status-registered{background:var(--zs-success-bg);color:var(--zs-success)}.status-pending{background:var(--zs-warning-bg);color:var(--zs-warning)}
.summary-metrics{display:flex;gap:20rpx;padding:20rpx 0 4rpx}.summary-metrics>view{flex:1;min-width:0;font-size:var(--zs-font-caption);color:var(--zs-text-2)}.summary-metrics>view+view{border-left:1rpx solid var(--zs-line);padding-left:20rpx}.summary-number{display:flex;align-items:baseline;gap:8rpx;font-size:var(--zs-font-metric);font-weight:700;color:var(--zs-champagne);line-height:58rpx}.summary-number>text{font-size:var(--zs-font-meta);font-weight:400;color:var(--zs-text)}
.summary-note,.pending-note{display:block;margin-top:14rpx;font-size:var(--zs-font-caption);line-height:34rpx;color:var(--zs-text-3)}.pending-note{padding:12rpx 14rpx;background:var(--zs-warning-bg);color:var(--zs-warning);border-radius:10rpx}
.viewport-error{padding:18rpx 0;font-size:var(--zs-font-meta);color:var(--zs-text-2)}.viewport-error button{display:inline-block;color:var(--zs-brand-press);margin-left:16rpx}
.map-section-heading{gap:12rpx;margin-top:24rpx;min-height:66rpx}.map-section-heading .section-title{font-weight:700;font-size:var(--zs-font-body);line-height:36rpx}.section-meta{font-size:var(--zs-font-caption);color:var(--zs-text-3);flex:none}.list-head .section-title{flex:1}.list-head button{color:var(--zs-brand-press);font-size:var(--zs-font-caption);padding:12rpx 0}
.brand-list{padding:0 22rpx}.brand-row{display:flex;align-items:center;gap:14rpx;width:100%;padding:20rpx 0;min-height:80rpx;text-align:left;border-bottom:1rpx solid var(--zs-line)}.brand-row:last-child{border-bottom:0}.brand-name{flex:1;font-size:var(--zs-font-body);font-weight:500;min-width:0}.brand-amount{font-size:var(--zs-font-body);font-weight:600;text-align:right}.brand-extra{display:block;margin-top:5rpx;font-size:var(--zs-font-caption);font-weight:400;color:var(--zs-text-3)}
.query-note{display:flex;align-items:center;gap:14rpx;margin-bottom:10rpx;font-size:var(--zs-font-meta);color:var(--zs-text-2)}.query-note>text{flex:1;min-width:0;overflow-wrap:anywhere}
.stores{padding:0 20rpx}.store{display:flex;align-items:flex-start;gap:16rpx;width:100%;padding:23rpx 0;text-align:left;border-bottom:1rpx solid var(--zs-line)}.store:last-child{border-bottom:0}.record-icon{display:flex;align-items:center;justify-content:center;flex:none;width:60rpx;height:60rpx;border-radius:16rpx;background:#f3ebe1}.record-icon image{width:36rpx;height:36rpx}.record-content{flex:1;min-width:0}.record-heading{display:flex;align-items:flex-start;gap:10rpx}.name{flex:1;min-width:0;font-size:var(--zs-font-body);font-weight:600;line-height:42rpx;overflow-wrap:anywhere}.record-status{flex:none;padding:3rpx 7rpx;border-radius:6rpx;background:var(--zs-warning-bg);color:var(--zs-warning);font-size:var(--zs-font-caption);line-height:30rpx}.record-brand{display:flex;align-items:center;gap:8rpx;margin-top:6rpx;font-size:var(--zs-font-caption);color:var(--zs-text-2);line-height:32rpx}.record-brand .dot{width:12rpx;height:12rpx}.record-region{display:block;margin-top:6rpx;font-size:var(--zs-font-meta);line-height:36rpx;color:var(--zs-text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.record-region.expanded{white-space:normal;overflow-wrap:anywhere}.record-detail{display:block;margin-top:12rpx;font-size:var(--zs-font-caption);line-height:34rpx;color:var(--zs-text-3)}.record-chevron{width:12rpx;height:22rpx;margin-top:18rpx;flex:none}.record-chevron.expanded{transform:rotate(90deg)}
.map-message{padding:48rpx 20rpx;text-align:center;font-size:var(--zs-font-body);color:var(--zs-text-3);line-height:44rpx}.map-message>text{display:block}.more,.map-message button{margin:16rpx auto 0;padding:14rpx;color:var(--zs-brand-press);font-size:var(--zs-font-meta)}
@media (max-width:350px) {
  .map-page { padding-right: 22rpx; padding-left: 22rpx; }
  .overview-item { min-width: 96rpx; padding-right: 13rpx; padding-left: 13rpx; }
  .count-tabs button { padding-right: 13rpx; padding-left: 13rpx; }
  .region-field .picker-value { padding-right: 8rpx; padding-left: 8rpx; }
  .summary-metrics { gap: 12rpx; }
  .summary-metrics > view + view { padding-left: 12rpx; }
}
