.map-page { padding: 12rpx 26rpx calc(36rpx + env(safe-area-inset-bottom)); color: #32251e; }
.map-search, .map-overview, .area-summary, .brand-list, .stores {
  border-radius: 20rpx;
  background: var(--zs-card);
  box-shadow: 0 4rpx 16rpx rgba(71, 48, 32, .07);
}
.map-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 68rpx;
  margin-bottom: 17rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e9ddd1;
  border-radius: 38rpx;
}
.map-search > image { width: 31rpx; height: 31rpx; flex: none; }
.map-search input { flex: 1; width: 0; min-width: 0; height: 67rpx; font-size: 28rpx; }
.map-search button, .name-search, .query-note button { flex: none; padding: 12rpx 0; color: var(--zs-brand-press); font-size: 24rpx; }
.search-results { margin: -7rpx 0 14rpx; padding: 0 20rpx; border-radius: 18rpx; background: var(--zs-card); }
.search-result {
  display: flex;
  align-items: center;
  gap: 13rpx;
  width: 100%;
  min-height: 76rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f0e8df;
  text-align: left;
  font-size: 25rpx;
}
.search-result > image { width: 28rpx; height: 28rpx; flex: none; }
.search-result > text { flex: 1; line-height: 38rpx; }
.search-result .result-chevron { width: 12rpx; height: 18rpx; }
.name-search { width: 100%; min-height: 70rpx; text-align: left; }
.map-overview { display: flex; flex-wrap: wrap; align-items: center; padding: 14rpx 6rpx; }
.overview-item { display: flex; align-items: center; justify-content: center; gap: 16rpx; width: 50%; min-width: 0; }
.overview-item + .overview-item { border-left: 1rpx solid #ede2d6; }
.metric-icon, .record-icon, .summary-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 67rpx;
  height: 67rpx;
  border-radius: 50%;
  background: #f6eee4;
}
.metric-icon image { width: 42rpx; height: 42rpx; }
.metric-label { display: block; font-size: 25rpx; font-weight: 600; line-height: 32rpx; }
.metric-value { display: flex; align-items: baseline; gap: 8rpx; color: #322018; font-size: 42rpx; font-weight: 750; line-height: 48rpx; }
.metric-unit { font-size: 24rpx; font-weight: 400; }
.overview-note { width: 100%; padding: 8rpx 16rpx 0; color: var(--zs-text-3); font-size: 22rpx; }
.regions { display: flex; align-items: center; gap: 10rpx; margin: 21rpx 0; }
.region-field { display: flex; align-items: center; flex: 1; min-width: 0; gap: 8rpx; }
.region-field > picker { flex: 1; min-width: 0; }
.picker-label { flex: none; color: #392a22; font-size: 24rpx; font-weight: 600; white-space: nowrap; }
.picker-value { display: flex; align-items: center; justify-content: space-between; gap: 5rpx; min-height: 53rpx; padding: 8rpx 11rpx; border: 1rpx solid #eae0d6; border-radius: 16rpx; background: var(--zs-card); font-size: 23rpx; line-height: 34rpx; }
.picker-value > text { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.picker-value > image { flex: none; width: 9rpx; height: 14rpx; transform: rotate(90deg); }
.picker-value.disabled { background: #f7f4f1; color: var(--zs-text-3); }
.regions-admin { gap: 7rpx; }
.regions-admin .region-field { gap: 5rpx; }
.regions-admin .picker-label, .regions-admin .picker-value { font-size: 21rpx; }
.regions-admin .picker-value { padding-right: 7rpx; padding-left: 7rpx; }
.map { display: block; width: 100%; height: 410rpx; min-height: 195px; border-radius: 18rpx; overflow: hidden; background: #f0ece5; }
.zoom-actions { position: absolute; right: 14rpx; bottom: 36rpx; width: 66rpx; border: 1rpx solid #e9ded1; border-radius: 13rpx; background: #fff; color: #30231c; text-align: center; }
.zoom-button { width: 66rpx; height: 62rpx; color: #30231c; font-size: 40rpx; font-weight: 600; line-height: 62rpx; text-align: center; }
.zoom-out { border-top: 1rpx solid #eee6dd; }
.county-callout { padding: 4rpx; }
.pin-count {
  width: 68rpx;
  height: 64rpx;
  margin: 0 auto;
  border: 2rpx solid #fff7ee;
  border-radius: 34rpx;
  color: #fff;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 62rpx;
}
.callout-detail { min-width: 157rpx; max-width: 300rpx; margin-bottom: 6rpx; padding: 9rpx 12rpx; border: 1rpx solid #e4d2c0; border-radius: 12rpx; background: #fff; color: #32251e; font-size: 21rpx; }
.callout-title { margin-bottom: 4rpx; font-weight: 700; line-height: 30rpx; }
.callout-brand { display: flex; align-items: center; min-height: 28rpx; line-height: 28rpx; }
.callout-dot { width: 11rpx; height: 11rpx; min-width: 11rpx; margin-right: 7rpx; border-radius: 6rpx; }
.callout-name { max-width: 144rpx; margin-right: 9rpx; overflow: hidden; text-overflow: ellipsis; }
.callout-count { color: var(--zs-text-2); white-space: nowrap; }
.map-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 16rpx; padding: 15rpx 3rpx 0; }
.legend-item { display: flex; align-items: center; gap: 7rpx; font-size: 22rpx; line-height: 32rpx; }
.dot { display: inline-block; flex: none; width: 19rpx; height: 19rpx; border-radius: 50%; }
.area-summary { margin-top: 17rpx; padding: 15rpx 19rpx 17rpx; }
.summary-heading { display: flex; align-items: center; gap: 12rpx; }
.summary-icon { width: 51rpx; height: 51rpx; }
.summary-icon image { width: 30rpx; height: 30rpx; }
.summary-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 700; line-height: 38rpx; overflow-wrap: anywhere; }
.status { flex: none; padding: 4rpx 9rpx; border-radius: 7rpx; background: #f3eee8; color: var(--zs-text-2); font-size: 20rpx; line-height: 29rpx; white-space: nowrap; }
.status-registered { background: #4e933a; color: #fff; }
.status-pending { background: var(--zs-warning-bg); color: var(--zs-warning); }
.summary-metrics { display: flex; align-items: center; gap: 14rpx; padding: 11rpx 4rpx 0; }
.summary-metrics > view { flex: 1; min-width: 0; font-size: 23rpx; color: var(--zs-text-2); }
.summary-metrics > view + view { padding-left: 13rpx; border-left: 1rpx solid #ede1d6; }
.summary-number { display: flex; align-items: baseline; gap: 7rpx; color: #9c622b; font-size: 44rpx; font-weight: 750; line-height: 46rpx; }
.summary-number > text { color: #38271e; font-size: 24rpx; font-weight: 400; }
.summary-store > view { display: flex; align-items: center; gap: 10rpx; }
.summary-store .summary-number { flex: none; }
.summary-store .summary-brand { font-size: 21rpx; line-height: 30rpx; }
.summary-brand > .dot { width: 17rpx; height: 17rpx; background: #a86c2c; }
.coverage-note, .pending-note, .summary-note, .focus-note { display: block; color: var(--zs-text-3); font-size: 22rpx; line-height: 32rpx; }
.coverage-note, .pending-note { margin-top: 8rpx; }
.pending-note, .focus-note { padding: 9rpx 13rpx; border-radius: 10rpx; background: #f7eee2; color: var(--zs-brand-press); }
.focus-note { margin-top: 12rpx; }
.viewport-error { padding: 15rpx 0; color: var(--zs-text-2); font-size: 24rpx; }
.viewport-error button { display: inline-block; margin-left: 12rpx; color: var(--zs-brand-press); }
.map-section-heading { min-height: 58rpx; margin: 17rpx 0 6rpx; gap: 9rpx; }
.map-section-heading .section-title { flex: 1; padding-left: 13rpx; border-left: 6rpx solid #a66a2f; color: #39261d; font-size: 28rpx; font-weight: 700; line-height: 30rpx; }
.section-meta { flex: none; color: var(--zs-text-3); font-size: 20rpx; }
.list-head button { flex: none; color: var(--zs-brand-press); font-size: 22rpx; }
.brand-list, .stores { padding: 0 19rpx; }
.brand-row, .store { display: flex; align-items: center; gap: 13rpx; width: 100%; min-height: 66rpx; padding: 13rpx 0; border-bottom: 1rpx solid #f0e8df; text-align: left; }
.brand-row:last-child, .store:last-child { border-bottom: 0; }
.brand-name { flex: 1; min-width: 0; color: #38251b; font-size: 27rpx; font-weight: 650; }
.brand-amount { color: #38251b; font-size: 27rpx; font-weight: 700; text-align: right; }
.brand-empty .brand-name, .brand-empty .brand-amount { color: var(--zs-text-3); }
.brand-extra { display: block; margin-top: 5rpx; color: var(--zs-text-3); font-size: 20rpx; font-weight: 400; }
.query-note { display: flex; align-items: center; gap: 10rpx; color: var(--zs-text-2); font-size: 22rpx; }
.query-note > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.store { min-height: 94rpx; padding: 12rpx 0; }
.record-icon { width: 67rpx; height: 67rpx; }
.record-icon image { width: 42rpx; height: 42rpx; }
.record-content { flex: 1; min-width: 0; }
.record-heading, .record-address, .record-brand { display: flex; align-items: center; gap: 7rpx; }
.name { flex: 1; min-width: 0; color: #34251d; font-size: 28rpx; font-weight: 690; line-height: 35rpx; overflow-wrap: anywhere; }
.record-address, .record-brand { margin-top: 4rpx; color: var(--zs-text-2); font-size: 22rpx; line-height: 31rpx; }
.record-address > image { flex: none; width: 20rpx; height: 23rpx; }
.record-address > text { min-width: 0; overflow-wrap: anywhere; }
.record-brand .dot { width: 12rpx; height: 12rpx; }
.record-status { flex: none; padding: 3rpx 6rpx; border-radius: 6rpx; background: var(--zs-warning-bg); color: var(--zs-warning); font-size: 20rpx; }
.record-detail, .record-coverage { display: block; margin-top: 5rpx; color: var(--zs-text-3); font-size: 21rpx; line-height: 30rpx; }
.record-chevron { flex: none; width: 12rpx; height: 20rpx; }
.record-chevron.expanded { transform: rotate(90deg); }
.map-options { margin-top: 20rpx; }
.count-tabs { display: flex; gap: 3rpx; padding: 4rpx; border-radius: 12rpx; background: #f1e9df; }
.count-tabs button { flex: 1; min-height: 60rpx; border-radius: 8rpx; color: var(--zs-text-2); font-size: 23rpx; line-height: 60rpx; }
.count-tabs .active { background: var(--zs-card); color: var(--zs-brand-press); font-weight: 650; }
.summary-note { margin: 4rpx 3rpx 0; }
.map-message { padding: 40rpx 18rpx; text-align: center; color: var(--zs-text-3); font-size: 25rpx; line-height: 39rpx; }
.map-message > text { display: block; }
.more, .map-message button { margin: 11rpx auto 0; padding: 12rpx; color: var(--zs-brand-press); font-size: 24rpx; }
@media (max-width: 350px) {
  .map-page { padding-left: 20rpx; padding-right: 20rpx; }
  .regions { gap: 6rpx; }
  .region-field { gap: 5rpx; }
  .regions-admin .region-field { display: block; }
  .regions-admin .picker-label { display: block; margin-bottom: 4rpx; }
  .summary-store > view { gap: 7rpx; }
  .summary-store .summary-brand { font-size: 19rpx; }
}

.area-coverage-label{margin:12rpx 0;padding:12rpx 18rpx;border-radius:12rpx;background:#f6eee3;color:#714a2e;font-size:23rpx;line-height:1.5}
