@import "./message-center.wxss";
@import "./layout.wxss";
@import "./typography.wxss";
.captcha-btn{flex-shrink:0;margin-left:16rpx;padding:0 20rpx;line-height:56rpx;min-height:56rpx;font-size:var(--zs-font-caption);color:#9b7b5e;background:#f4ede3;border-radius:10rpx}.captcha-btn.is-disabled{color:#b9ac9e}
/* 登录页品牌字标（横向 logo，替代旧盾牌图形）；微信官方一键登录样式：官方绿底 + 官方双气泡图标
   （实测 .solid 品牌渐变在高特异性下仍压过普通声明，背景用 !important 保底穿透） */
.login-brand{display:block;margin:0 auto 24rpx;width:440rpx;height:120rpx}
.wechat-actions{margin-top:40rpx}
.login-card .solid.wechat-login-btn{display:flex;align-items:center;justify-content:center;gap:12rpx;background:#07c160!important;color:#fff!important}
.wechat-login-icon{width:44rpx;height:44rpx;flex-shrink:0}
.account-search{margin-top:18rpx}.change-password-title{display:block;margin:24rpx 0 12rpx;font-weight:600;color:#824019}.remember-account{margin-top:20rpx}
.profile-hero .hint{margin-top:8rpx}
.demo-entry-row{display:flex;justify-content:center;padding-top:8rpx}
.demo-entry{background:transparent;font-size:var(--zs-font-caption);color:#9b7b5e;padding:10rpx 0}
.mini-action{flex-shrink:0;margin-left:12rpx;padding:0 18rpx;line-height:52rpx;min-height:52rpx;font-size:var(--zs-font-caption);color:#9b7b5e;background:#f4ede3;border-radius:10rpx}.mini-action.warn{color:#b0563f}
.payment-message{display:block;width:100%;text-align:left}.payment-message-heading{display:flex;align-items:center;gap:14rpx;font-size:var(--zs-font-body);padding-bottom:18rpx;border-bottom:1rpx solid #efe8de}.payment-message-success{color:#6e9879;font-size:var(--zs-font-caption);margin-left:auto}.payment-message-amount{font-size:var(--zs-font-metric);font-weight:600;display:block;margin:20rpx 0;color:#322c26}.payment-message-customer{display:flex;align-items:center;justify-content:space-between;gap:18rpx;font-size:var(--zs-font-body)}.payment-message-customer>text:last-child{font-size:var(--zs-font-meta);color:#9b7b5e}.payment-message-time{display:block;color:#a49a90;font-size:var(--zs-font-caption);margin-top:16rpx}.payment-mini-brand{width:44rpx;height:44rpx;position:relative;overflow:hidden;flex-shrink:0}.payment-mini-brand image{position:absolute;max-width:none}.payment-mini-brand.wx image{width:154rpx;height:62.5625rpx;left:0;top:0}.payment-mini-brand.ali image{width:215rpx;height:161.25rpx;left:-85.5rpx;top:-58rpx}.payment-receipt-mask{position:fixed;inset:0;z-index:180;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center}.payment-receipt-panel{position:relative;background:var(--zs-card);border-radius:24rpx;padding:52rpx 30rpx 28rpx;width:calc(100% - 52rpx);box-sizing:border-box;max-height:calc(100vh - 190rpx);overflow:auto;text-align:center}.payment-receipt-close{position:absolute;right:16rpx;top:16rpx;background:transparent;color:#a08b79;font-size:var(--zs-font-meta);padding:5rpx 12rpx}.payment-receipt-check{width:86rpx;height:86rpx;line-height:86rpx;border-radius:50%;background:#07c160;color:var(--zs-card);font-size:var(--zs-font-metric);text-align:center;margin:0 auto 20rpx}.payment-receipt-check.ali{background:#1677ff}.payment-receipt-title{font-size:var(--zs-font-title);font-weight:600;display:block}.payment-receipt-amount{font-size:var(--zs-font-display);font-weight:600;display:block;margin:20rpx 0 10rpx}.payment-receipt-merchant{font-size:var(--zs-font-meta);color:#9a8e83;display:block;margin-bottom:28rpx}.payment-receipt-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;text-align:left;font-size:var(--zs-font-meta);border-top:1rpx solid #eee7df;padding:20rpx 0;line-height:1.6}.payment-receipt-row>text:first-child{flex-shrink:0;color:#9c8e80}.payment-receipt-row>text:last-child{text-align:right;word-break:break-all}.payment-receipt-note{font-size:var(--zs-font-caption);color:#b0a59a;display:block;margin:22rpx 0}

.login-card .login-password-input{letter-spacing:0!important;text-align:left;font-variant-numeric:normal;font-family:var(--zs-font-family);font-size:30rpx;line-height:normal}
.login-password-row .label{min-width:112rpx}.login-password-row{gap:12rpx}
.password-visibility{flex-shrink:0;min-width:76rpx;min-height:76rpx;padding:0 8rpx;line-height:76rpx;color:var(--zs-brand);font-size:26rpx;background:transparent}

.login-consent-mask{position:fixed;inset:0;z-index:250;background:rgba(0,0,0,.48);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}
.login-consent-panel{width:100%;max-width:650rpx;max-height:85vh;box-sizing:border-box;border-radius:24rpx;background:var(--zs-card);padding:32rpx;color:var(--zs-text);overflow:hidden}
.login-consent-heading{font-size:34rpx;line-height:48rpx;font-weight:600}.login-consent-links{display:flex;flex-wrap:wrap;gap:8rpx}.login-consent-links button{background:transparent;color:var(--zs-brand);font-size:28rpx;padding:8rpx 0;margin:0}
.login-consent-check{margin:28rpx 0;font-size:27rpx;min-height:72rpx;white-space:normal}.login-consent-actions{display:flex;gap:16rpx}.login-consent-actions button{flex:1;font-size:28rpx;min-width:0}.login-consent-actions .solid[disabled]{opacity:.45}
.login-document-scroll{height:58vh;margin:20rpx 0}.login-document-scroll .card{padding:16rpx 0;margin:0;box-shadow:none;border-radius:0}.login-document-scroll .heading{font-size:30rpx}.login-document-scroll .body-text{font-size:27rpx;line-height:42rpx}

.login-remember-row{margin-top:20rpx;justify-content:space-between}.login-remember-row .remember-account{margin:0;flex:1;text-align:left}.login-remember-row .mini-action{font-size:var(--zs-font-caption)}
