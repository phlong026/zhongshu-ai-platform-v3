ile.jpg"/><text class="grow">服务报价</text><text class="brown">查看报价记录 ›</text></button><button class="card row" data-view="delivery" data-id="{{order.id}}" data-handler="go" bindtap="go"><image class="row-icon" src="/assets/account-order.jpg"/><view class="grow"><text>交付记录</text><text class="hint">{{order.delivery?'查看当前版本交付文件':'方案确认后按约定交付'}}</text></view><text class="pill">{{order.delivery?order.delivery.received?'已接收':'待接收':'尚未交付'}}</text></button><view class="card"><view class="heading">服务动态</view><view wx:for="{{order.events}}" wx:key="at" class="event"><text class="brown">•</text><text class="hint">{{item.at}}　{{item.text}}</text></view></view><view class="page-actions"><button wx:if="{{isServiceProvider&&(order.status==='待沟通'||order.status==='进行中'&&!order.confirmation)}}" class="outline" data-action="demo-plan" data-handler="orderAction" bindtap="orderAction">体验服务方提交方案</button><button wx:if="{{isServiceProvider&&order.status==='进行中'&&order.confirmation}}" class="outline" data-action="demo-delivery" data-handler="orderAction" bindtap="orderAction">体验服务方交付成果</button><button wx:if="{{isServiceProvider&&order.status==='交付待修正'}}" class="outline" data-action="demo-redelivery" data-handler="orderAction" bindtap="orderAction">体验服务方补交文件</button><button wx:if="{{!isServiceProvider&&(order.status==='待沟通'||order.status==='待确认'||order.status==='进行中')}}" class="outline" data-action="cancel" data-handler="orderAction" bindtap="orderAction">申请取消</button><button wx:if="{{order.cancel}}" class="outline" data-view="cancel" data-id="{{order.id}}" data-handler="go" bindtap="go">查看取消进度</button><button class="solid bottom-inline" data-key="contact" data-handler="notice" bindtap="notice">联系服务方</button></view><text class="hint center">确认操作由门店负责人处理</text></block>
