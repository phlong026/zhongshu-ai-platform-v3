 <block wx:elif="{{view==='login'}}"><view class="login-intro"><image class="login-symbol" src="/pages/account/assets/login-shield.jpg" mode="aspectFit"/><text class="large">登录后继续</text><text class="hint">登录成功后返回原访问页面</text></view><view class="card login-card"><view class="heading">本地模拟账号</view><picker class="demo-user-picker" data-handler="selectDemoUser" range="{{demoUsers}}" range-key="label" bindchange="selectDemoUser"><view class="row inset"><text>{{demoUserLabel}}</text><text class="brown">选择人员 ›</text></view></picker><text class="hint">不同人员使用独立身份与授权；仅供本机流程验证。</text><view class="row"><text class="strong">手机号</text><input class="input" placeholder="请输入手机号" type="number" maxlength="11" data-key="phone" bindinput="input"/></view><view class="row"><text class="strong">验证码</text><input class="input" placeholder="请输入验证码" data-key="code" bindinput="input"/><button class="pill" data-key="sms" data-handler="notice" bindtap="notice">获取验证码</button></view><view class="page-actions"><button class="solid" data-handler="login" bindtap="login">登录并继续</button></view><view class="row agreement-row"><button class="check-row" data-handler="toggle" bindtap="toggle"><text class="checkbox {{checked?'selected':''}}">{{checked?'✓':''}}</text>我已阅读并同意</button><button class="brown" data-view="agreement" data-handler="go" bindtap="go">《用户协议》</button><text>和</text><button class="brown" data-view="policy" data-handler="go" bindtap="go">《隐私政策》</button></view><button class="outline" data-key="wechat" data-handler="notice" bindtap="notice"><image class="wechat-button-icon" src="/pages/account/assets/privacy-wechat.jpg" mode="aspectFit"/>微信登录</button></view></block>
 <block wx:elif="{{view==='identity'}}"><view class="card row"><image class="avatar-small" src="{{profile.avatar}}" mode="aspectFill"/><view><text class="large">{{profile.name}}</text><text class="hint">当前账号 · 本地演示</text></view></view><view class="card"><view class="heading">当前公司</view><view class="row inset"><image class="symbol-image" src="/pages/account/assets/identity-company.jpg"/><text class="strong grow">{{company.name}}</text><button class="brown" data-key="companies" data-handler="notice" bindtap="notice">切换公司 ›</button></view><text class="hint">仅可选择已加入的公司</text></view><view class="card"><view class="heading">已授权工作身份</view><button wx:for="{{roleOptions}}" wx:key="id" class="identity-option {{selectedRole===item.id?'selected-option':''}}" data-role="{{item.id}}" data-handler="selectRole" bindtap="selectRole"><image class="symbol-image" src="/pages/account/assets/{{item.id==='engineer'||item.id==='project-manager'?'identity-manager':'identity-sales'}}.jpg"/><view class="grow"><text class="strong">{{item.name}}</text><text class="hint">{{item.description}}</text></view><text class="brown">{{selectedRole===item.id?'●':'○'}}</text></button><text class="hint">仅显示管理员已分配的身份</text></view><view class="card"><view class="heading">切换后</view><text class="body-text">进入对应工作台</text><text class="body-text">按当前身份查看可用内容</text></view><view class="page-actions"><button class="solid" data-handler="switchRole" bindtap="switchRole">确认切换</button></view></block>
 <block wx:elif="{{view==='access'}}"><view class="access-intro"><image class="lock-symbol" src="/pages/account/assets/access-lock.jpg" mode="aspectFit"/><text class="large">暂时没有访问权限</text><text class="hint">当前身份未获此功能授权</text><text class="hint">如需使用，请联系公司管理员</text></view><view class="card"><view class="row"><text class="label grow">当前公司</text><text>{{company.name}}</text></view><view class="row"><text class="label grow">当前身份</text><text>{{role}}</text></view><view class="row"><text class="label grow">访问内容</text><text>{{accessLabel}}</text></view></view><view class="page-actions"><button class="solid" data-handler="backHome" bindtap="backHome">返回工作台</button><button class="outline" data-view="identity" data-handler="go" bindtap="go">切换工作身份</button></view><text class="divider">权限开通后，可重新进入</text></block>
 <block wx:elif="{{view==='resource'}}"><view wx:if="{{resource}}" class="card"><view class="heading">{{resource.name}}</view><text class="hint">{{resource.type}} · {{resource.category}} · {{resource.version}} · {{resource.date}}</text><view class="document-preview"><image src="/pages/account/assets/file.jpg"/><text class="strong">{{resource.name}}</text><text class="hint">图稿示例资料，尚未配置真实文档。</text></view><view class="page-actions"><button class="outline" data-handler="favorite" bindtap="favorite">{{resourceFavorite?'取消收藏':'收藏资料'}}</button></view></view><view wx:else class="card empty">资料不存在</view></block>
 <block wx:elif="{{view==='personal-performance'}}"><view class="card"><view class="heading">{{profile.name}} · 我的绩效</view><text class="hint">通知周期：2026年9月 · 历史结果</text><text class="body-text">与工程组王经理2026年10月的进行中考核分别记录。</text><view class="page-actions"><button class="solid" data-view="admin-target" data-handler="go" bindtap="go">查看我的目标与来源</button></view></view></block>
 <block wx:elif="{{view==='policy'||view==='agreement'}}"><view class="card"><view class="heading">{{title}}</view><text class="body-text">当前为本地交互演示。您填写的资料、反馈、图片、服务订单和学习进度仅保存在当前设备，不会发送至业务服务端。示例订单与素材仅用于页面验证。</text><text class="body-text">正式上线前需由运营主体提供完整协议，说明个人信息处理、账号注销、服务交付、费用、售后及联系渠道，并接入真实身份验证与权限服务。</text><text class="hint">当前页面不构成正式运营服务协议。</text></view></block>
 <block wx:else><view class="card"><view class="heading">{{title}}</view><text class="body-text">{{view==='devices'?'当前为本机演示会话，未接入跨设备登录记录。':view==='permissions'?'可在微信设置中管理相册等系统权限。公司业务权限由管理员分配。':'手机号与微信绑定需要身份验证服务，当前尚未接入。'}}</text><view class="page-actions"><button class="outline" data-view="privacy" data-handler="go" bindtap="go">返回账号与隐私</button></view></view></block>
 <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
<view wx:if="{{modal}}" class="overlay" data-handler="closeModal" bindtap="closeModal"><view class="sheet" catchtap="noop"><button class="sheet-close" data-handler="closeModal" bindtap="closeModal">×</button><text class="large">{{modal.title}}</text><image wx:if="{{modal.image}}" class="modal-image" src="{{modal.image}}" mode="widthFix"/><text wx:if="{{modal.text}}" class="body-text">{{modal.text}}</text><block wx:if="{{modal.type==='lesson'}}"><image class="modal-image" src="{{courseImage}}" mode="widthFix"/><text class="body-text">本地课程体验，尚未配置实际教学视频。可标记本节体验完成并检查学习进度。</text></block><block wx:if="{{modal.type==='cancel-resolution'}}"><picker range="{{['核实未收款，取消','退回取消申请','款项待核实']}}" bindchange="pickCancel"><view class="outline">{{form.cancelResult||'选择核实结果'}}</view></picker><textarea class="textarea" placeholder="填写原渠道核实说明" data-key="note" bindinput="input"/><button class="outline" data-key="cancelProof" bindtap="photo">上传核实依据（{{form.cancelProof.length||0}}）</button><button class="outline" bindtap="toggle">{{checked?'☑':'□'}} 已核对原订单与原渠道款项</button></block><textarea wx:if="{{modal.type==='cancel'}}" class="textarea" placeholder="请填写取消原因，款项需另行核实" maxlength="300" value="{{form.note}}" data-key="note" bindinput="input"/><text wx:if="{{error}}" class="error">{{error}}</text><button class="solid" data-handler="confirmModal" bindtap="confirmModal">{{modal.type==='login-demo'?'使用示例账号':modal.type==='lesson'?'标记本节体验完成':modal.type==='cancel'?'提交取消申请':'确认'}}</button></view></view>
