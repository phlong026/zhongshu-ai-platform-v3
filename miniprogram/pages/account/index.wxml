<account-header id="account-subpage-header" id="subpage-header" title="{{title}}"/>
<view class="account view-{{view}}" style="padding-top:calc({{statusHeight}}px + 92rpx)">
 <view wx:if="{{missing}}" class="card empty-state"><text class="large">内容不存在或暂无访问权限</text><view class="page-actions"><button class="solid" data-view="orders" data-handler="go" bindtap="go">返回我的服务订单</button></view></view>
 <block wx:elif="{{view==='selection'}}"><input class="search" placeholder="⌕ 搜索材料、规格" bindinput="search"/><view class="line-tabs"><button wx:for="{{['全部','外墙','门窗','屋面']}}" wx:key="*this" class="{{category===item?'active':''}}" data-key="category" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><image class="service-banner" src="/pages/account/assets/selection-banner.jpg" mode="aspectFill"/><view class="service-grid"><button wx:for="{{filteredProducts}}" wx:key="id" class="card" data-view="product" data-id="{{item.id}}" data-handler="go" bindtap="go"><image src="{{item.image}}" mode="aspectFill"/><text class="strong">{{item.name}}</text><text class="hint">{{item.spec}}</text><text class="product-inquiry">按需询价</text></button></view><text class="hint center">具体供货及报价以确认方案为准。</text></block>
 <block wx:elif="{{view==='product'}}"><block wx:if="{{product}}"><image class="service-hero" src="{{product.image}}" mode="aspectFill"/><view class="card"><view class="heading">{{product.name}}<text class="pill link">按需询价</text></view><text class="hint">{{product.spec}}</text></view><view class="card"><view class="heading">商品规格</view><view class="row"><text class="label">规格</text><text>{{product.spec}}</text></view><view class="row"><text class="label">计量单位</text><text>{{product.unit}}</text></view><view class="row"><text class="label">适用部位</text><text>{{product.category}}</text></view></view><view class="card"><view class="heading">供货说明</view><view class="row"><text class="label">报价方式</text><text>按数量与配送地点报价</text></view><view class="row"><text class="label">供货周期</text><text>询价后确认</text></view><view class="row"><text class="label">运费与卸货</text><text>报价时列明</text></view></view></block><view wx:else class="card empty">商品不存在</view></block>
 <block wx:elif="{{view==='procure'}}"><view class="card row"><image class="thumb" src="{{product.image}}" mode="aspectFill"/><view><text class="strong">{{product.name}}</text><text class="hint">{{product.spec}}</text></view></view><view class="card"><view class="heading">项目信息</view><view class="row"><text class="label">关联项目</text><picker range="{{projects}}" range-key="name" bindchange="pickProject"><text>{{selectedProjectName||'张先生 · 红安乡墅'}} ›</text></picker></view><view class="row"><text class="label">对应节点</text><text>{{product.category==='屋面'?'屋面施工':'外墙施工'}}</text></view><view class="row"><text class="label">采购范围</text><text>原合同范围</text></view></view><view class="card"><view class="heading">采购明细</view><view class="row"><text class="label">需求数量</text><input type="digit" placeholder="输入需求数量" value="{{form.quantity}}" data-key="quantity" bindinput="input"/><text>{{product.unit}}</text></view><view class="row"><text class="label">期望到货</text><picker mode="date" value="{{form.date}}" data-key="date" bindchange="input">{{form.date}} ›</picker></view></view><view class="card"><view class="heading">配送与费用</view><view class="row"><text class="label">地址</text><input value="{{form.address}}" data-key="address" bindinput="input"/></view><view class="row"><text class="label">收货人</text><input value="{{form.contact}}" data-key="contact" bindinput="input"/></view><view class="row"><text class="label">费用承担</text><text>加盟商</text></view></view><view class="card"><view class="heading">补充要求（选填）</view><textarea class="textarea" placeholder="请填写包装、卸货或其他要求" maxlength="200" value="{{form.note}}" data-key="note" bindinput="input"/></view><text class="hint center">提交后等待报价，不产生付款。</text><view class="page-actions"><button class="solid" data-handler="submitProcure" bindtap="submitProcure">提交采购需求</button></view></block>
 <block wx:elif="{{view==='purchases'}}"><input class="search" placeholder="⌕ 搜索项目或材料" bindinput="search"/><view class="line-tabs"><button wx:for="{{['全部','待报价','待确认','供货中','已完成']}}" wx:key="*this" class="{{orderTab===item?'active':''}}" data-key="orderTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><button wx:for="{{filteredPurchases}}" wx:key="id" class="card purchase-list" data-view="purchase" data-id="{{item.id}}" data-handler="go" bindtap="go"><view class="row"><text class="strong grow">{{item.project.name}}</text><text class="pill">{{item.status}}</text></view><view class="row"><image class="thumb" src="{{item.product.image}}" mode="aspectFill"/><view><text class="strong">{{item.product.name}}</text><text class="hint">{{item.product.spec}}</text><text class="hint">需求数量 {{item.quantity}}{{item.product.unit}}</text></view></view><view class="row"><text class="label">期望到货</text><text>{{item.date}}</text></view><text class="brown">{{item.quote?'报价 V'+item.quote.version+' · ¥'+item.quote.total:item.status==='供货中'?'供货安排已确认':'等待供应报价'}}　查看 ›</text></button><button class="card row" data-view="selection" data-handler="go" bindtap="go">浏览众墅甄选 ›</button></block>
 <block wx:elif="{{view==='purchase'}}"><button wx:if="{{purchase&&canPurchaseEngineering&&purchaseProject.engineeringId}}" class="card row" bindtap="openPurchaseProject">进入关联工程材料与供货流程 ›</button><view wx:if="{{!purchase}}" class="card empty">采购单不存在或无权访问</view><block wx:else><view class="card"><view class="heading">{{purchaseProject.name}}<text class="pill link">{{purchase.status}}</text></view><text class="hint">{{product.category==='屋面'?'屋面施工':'外墙施工'}} · 原合同范围 · {{purchase.id}}</text><view class="row"><image class="thumb" src="{{product.image}}" mode="aspectFill"/><view><text class="strong">{{product.name}}</text><text class="hint">{{product.spec}}</text><text class="hint">需求数量 {{purchase.quantity}}{{product.unit}}</text></view></view></view><view class="card"><view class="heading">供货报价 <text class="pill link">{{purchase.quote?'报价 V'+purchase.quote.version:'待报价'}}</text></view><block wx:if="{{purchase.quote}}"><view class="row"><text class="label">单价</text><text>¥{{purchase.quote.unitPrice}}/{{product.unit}}（含税）</text></view><view class="row"><text class="label">材料金额</text><text>¥{{purchase.quote.material}}</text></view><view class="row"><text class="label">运费</text><text>¥{{purchase.quote.freight}}（含卸货）</text></view><view class="row"><text class="label">合计</text><text class="strong brown">¥{{purchase.quote.total}}</text></view></block><text wx:else class="hint">等待供应方确认规格、税费和运费后报价。</text></view><view class="card"><view class="heading">到货安排</view><view class="row"><text class="label">约定到货</text><text>{{purchase.date}}</text></view><view class="row"><text class="label">收货地点</text><text>{{purchase.address||purchaseProject.address}}</text></view><view class="row"><text class="label">费用承担</text><text>加盟商</text></view><view class="row"><text class="label">确认人</text><text>{{purchaseProject.manager}}（项目联系人）</text></view></view><view class="card"><view class="heading">采购进度</view><view class="steps"><view wx:for="{{['需求已提交','报价待确认','待安排供货']}}" wx:key="*this"><text class="step-circle">{{index+1}}</text><text>{{item}}</text></view></view></view><block wx:if="{{purchase.status==='待确认'}}"><button class="check-row" data-handler="toggle" bindtap="toggle"><text class="checkbox {{checked?'selected':''}}">{{checked?'✓':''}}</text>已核对当前报价、数量与配送安排</button><view wx:if="{{canPurchaseQuote}}" class="page-actions"><button class="solid" data-handler="confirmPurchase" bindtap="confirmPurchase">确认采购方案</button></view></block><text class="hint center">确认仅记录采购方案，不发起付款。</text></block></block>
 <block wx:elif="{{view==='profile'}}">
  <view class="card profile-hero"><button open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar"><image src="{{profile.avatar}}" mode="aspectFill"/><image class="avatar-camera" src="/pages/account/assets/profile-camera.png" mode="aspectFit"/></button><text>{{profile.name}}</text><text class="hint">点击头像可使用微信头像或相册照片</text></view>
  <view class="card"><view class="heading">基本信息</view><view class="inset"><view class="row"><text class="label">姓名</text><input type="nickname" value="{{form.name}}" maxlength="20" data-key="name" bindinput="input"/><image class="profile-field-icon" src="/pages/account/assets/profile-edit.png"/></view><button class="row" data-view="binding" data-handler="go" bindtap="go"><text class="label">联系手机</text><text class="grow">{{maskedPhone}}</text><text class="pill">更换 ›</text></button><view class="row"><text class="label">公司</text><text class="grow">{{company.name}}</text><image class="profile-field-icon" src="/pages/account/assets/profile-lock.png"/></view><view class="row"><text class="label">岗位</text><text class="grow">{{role}}</text><image class="profile-field-icon" src="/pages/account/assets/profile-lock.png"/></view></view><text class="hint">公司与岗位由管理员维护。</text></view>
  <view class="card"><button class="heading full" data-view="identity" data-handler="go" bindtap="go">我的工作身份 <text class="link">切换 ›</text></button><view class="inset"><view class="row"><text class="label">所属部门</text><text>{{role==='业务员'||role==='业务负责人'?'业务部':role==='工程人员'||role==='工程师'||role==='工程负责人'?'工程部':'管理部'}}</text></view><view class="row"><text class="label">服务区域</text><text>湖北</text></view><view class="row"><text class="label">权限范围</text><text>{{role==='业务员'?'本人负责的客户':role==='工程师'?'负责的项目':'本店已授权业务'}}</text></view></view></view>
  <view class="card compact"><view class="heading">资料使用说明</view><view class="inset hint">联系方式仅用于业务沟通与账号验证。</view></view><view class="page-actions"><button class="solid bottom-inline" data-handler="saveProfile" bindtap="saveProfile">保存修改</button></view>
 </block>
 <block wx:elif="{{view==='learning'}}">
  <input class="search" placeholder="⌕  搜索课程、资料" value="{{keyword}}" bindinput="search"/><view class="seg"><button wx:for="{{['课程','资料']}}" wx:key="*this" class="{{tab===item?'active':''}}" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view>
  <view class="categories"><button wx:for="{{categories}}" wx:key="*this" class="{{category===item?'active':''}}" data-key="category" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view>
  <block wx:if="{{tab==='课程'}}"><view class="card"><view class="heading">继续学习</view><button class="course-row continue-row" data-view="course" data-handler="go" bindtap="go"><image src="/pages/account/assets/course-continue.jpg" mode="aspectFill"/><view class="grow"><text class="strong">AI短视频获客实战</text><text class="hint">已完成 {{progress.completed}} / 8 节</text><view class="progress-track"><view style="width:{{progress.percent}}%"/></view></view><text class="pill">继续学习 ›</text><text class="course-percent">{{progress.percent}}%</text></button></view><view class="card"><view class="heading">精选课程 <text class="link">我的学习 ›</text></view><button wx:for="{{filteredCourses}}" wx:key="id" class="course-row" data-id="{{item.id}}" data-handler="openCourse" bindtap="openCourse"><image src="{{item.image}}" mode="aspectFill"/><view class="grow"><text class="strong">{{item.name}}</text><text class="hint">{{item.category}} · {{item.lessons}}节课</text></view><text class="arrow">›</text></button><text wx:if="{{!filteredCourses.length}}" class="empty">暂无匹配课程，试试其他分类或关键词</text></view></block>
  <block wx:else><view class="card"><view class="heading">常用资料 <text class="link">最近更新 ›</text></view><button wx:for="{{filteredResources}}" wx:key="id" class="resource-row" data-id="{{item.id}}" data-handler="previewResource" bindtap="previewResource"><image src="/pages/account/assets/file.jpg"/><view class="grow"><text class="strong">{{item.name}}</text><text class="hint">{{item.type}} · {{item.category}} · {{item.version}} · {{item.date}}</text></view><text class="brown">预览 ›</text></button><text wx:if="{{!filteredResources.length}}" class="empty">暂无匹配资料</text></view><button class="card row" data-handler="favorites" bindtap="favorites"><image class="row-icon" src="/pages/account/assets/star.jpg"/><view class="grow"><text class="strong">{{favoritesOnly?'全部资料':'我的收藏'}}</text><text class="hint">常用资料，随时查阅</text></view><text class="arrow">›</text></button></block>
 </block>
 <block wx:elif="{{view==='course'}}">
  <button class="course-cover" data-handler="continueCourse" bindtap="continueCourse"><image src="{{courseImage}}" mode="aspectFill"/><text class="play">▶</text></button><view class="card course-summary"><text class="large">{{currentCourse.name}}</text><text class="pill">{{currentCourse.category}} · 共{{progress.total}}节</text><view class="row"><text>已完成 <text class="brown strong">{{progress.completed}}</text> / {{progress.total}} 节</text><text class="link">{{progress.percent}}%</text></view><view class="progress-track"><view style="width:{{progress.percent}}%"/></view><button class="row inset" data-handler="continueCourse" bindtap="continueCourse"><text class="brown">◷</text><text class="grow hint">上次学到：第{{progress.current+1}}节 {{progress.chapter}}</text><text class="arrow">›</text></button></view>
  <view class="seg"><button wx:for="{{['课程目录','配套资料']}}" wx:key="*this" class="{{courseTab===item?'active':''}}" data-key="courseTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><view wx:if="{{courseTab==='课程目录'}}" class="card chapter-card"><button wx:for="{{chapters}}" wx:key="*this" wx:if="{{index<6||expanded}}" class="row" data-index="{{index}}" data-handler="lesson" bindtap="lesson"><text class="brown number">0{{index+1}}</text><text class="grow">{{item}}</text><view class="chapter-status {{index<=progress.completed?'brown':''}}"><text class="lesson-badge {{index<=progress.completed?'completed':''}}">{{index<progress.completed?'✓':'▶'}}</text><text wx:if="{{index<=progress.completed}}">{{index<progress.completed?'已完成':'待继续'}}</text></view></button><button class="hint center" data-handler="expand" bindtap="expand">{{expanded?'收起':'展开全部'+progress.total+'节'}} ﹀</button></view><view class="card compact"><view class="heading">配套资料</view><button class="row inset" data-id="{{currentCourse.id==='engineering'?'brief':'script'}}" data-handler="previewResource" bindtap="previewResource"><image class="row-icon" src="/pages/account/assets/file.jpg"/><text class="grow">{{currentCourse.id==='engineering'?'乡墅开工交底清单':'短视频选题与文案模板'}}</text><text class="arrow">›</text></button></view><view class="page-actions"><button class="solid bottom-inline" data-handler="continueCourse" bindtap="continueCourse">{{progress.completed===progress.total?'回顾课程':'继续学习第'+(progress.current+1)+'节'}}</button></view>
 </block>
 <block wx:elif="{{view==='messages'}}"><view class="seg"><button wx:for="{{messageTabs}}" wx:key="*this" class="{{messageTab===item?'active':''}}" data-key="messageTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><button class="read-all" data-handler="readAll" bindtap="readAll">☑ 全部已读</button><button wx:for="{{messages}}" wx:key="id" class="card message" data-customer="{{item.payment?item.objectId:''}}" data-id="{{item.id}}" data-handler="read" bindtap="read"><block wx:if="{{item.payment}}"><view class="payment-message"><view class="payment-message-heading"><view class="payment-mini-brand {{item.payment.channel==='alipay'?'ali':'wx'}}"><image src="/pages/account/assets/{{item.payment.channel==='alipay'?'alipay.png':'wechat-pay.png'}}"/></view><text>{{item.payment.channelName}} · 设计费</text><text class="payment-message-success">支付成功</text></view><text class="payment-message-amount">{{item.payment.amount}}</text><view class="payment-message-customer"><text>{{item.payment.customerName}}</text><text>{{item.payment.area}}㎡ · 查看付款凭据 ›</text></view><text class="payment-message-time">{{item.date}} · 模拟支付记录</text></view></block><block wx:else><view class="unread {{item.read?'read':''}}"/><view class="message-symbol"><image src="{{item.type==='学习'?'/assets/graduate.png':item.route==='personal-performance'?'/assets/account-chart.jpg':item.type==='系统'?'/assets/book.png':'/assets/person-filled.png'}}" mode="aspectFit"/></view><view class="grow"><text class="strong">{{item.title}}</text><text class="hint">{{item.description}}</text><text class="hint time">{{item.date}}</text></view><text class="pill">{{item.route==='course'?'继续学习':'查看详情'}} ›</text></block></button><text wx:if="{{!messages.length}}" class="empty">暂无此类消息</text><text class="divider">仅展示与你相关的消息 · 状态随业务进度自动更新</text></block>
 <block wx:elif="{{view==='help'}}"><view class="seg"><button wx:for="{{['提交反馈','我的反馈']}}" wx:key="*this" class="{{feedbackTab===item?'active':''}}" data-key="feedbackTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><block wx:if="{{feedbackTab==='提交反馈'}}"><view class="card"><view class="heading">客服与帮助</view><view class="two-grid"><button class="inset row" data-key="contact" data-handler="notice" bindtap="notice"><image class="row-icon" src="/assets/account-headset.jpg"/>在线客服 ›</button><button class="inset row" data-key="faq" data-handler="notice" bindtap="notice"><image class="row-icon" src="/pages/account/assets/file.jpg"/>常见问题 ›</button></view></view><view class="card"><view class="heading">问题反馈</view><view class="seg"><button wx:for="{{['使用问题','功能建议','其他']}}" wx:key="*this" class="{{feedbackType===item?'active':''}}" data-key="feedbackType" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><text class="field-title">问题描述</text><textarea class="textarea feedback-text" placeholder="请描述遇到的问题" maxlength="300" value="{{form.feedback}}" data-key="feedback" bindinput="input"/><text class="counter">{{form.feedback.length||0}}/300</text><text class="field-title">截图上传</text><view class="photo-list"><button wx:for="{{form.screenshots}}" wx:key="*this" data-key="screenshots" data-index="{{index}}" data-handler="removePhoto" bindtap="removePhoto"><image src="{{item}}" mode="aspectFill"/><text>×</text></button><button class="upload" data-key="screenshots" data-handler="photo" bindtap="photo"><text>＋</text>添加截图</button></view><text class="hint">{{form.screenshots.length||0}}/3</text><text class="field-title">联系方式</text><input class="input" type="number" maxlength="11" placeholder="{{maskedPhone}}" value="{{form.contact}}" data-key="contact" bindinput="input"/><text class="hint">ⓘ 请勿上传密码等敏感信息。</text></view><view class="page-actions"><button class="solid bottom-inline" data-handler="submitFeedback" bindtap="submitFeedback">提交反馈</button></view></block><block wx:else><view wx:for="{{feedbacks}}" wx:key="id" class="card"><text class="strong">{{item.type}} · {{item.status}}</text><text class="body-text">{{item.text}}</text><text class="hint">{{item.date}}</text></view><view wx:if="{{!feedbacks.length}}" class="card empty">暂无反馈记录</view></block></block>
 <block wx:elif="{{view==='privacy'}}"><view class="card"><view class="heading">隐私与协议</view><button wx:for="{{[{name:'个人信息使用说明',view:'policy'},{name:'隐私政策',view:'policy'},{name:'用户协议',view:'agreement'},{name:'隐私授权管理',view:'permissions'}]}}" wx:key="name" class="row" data-view="{{item.view}}" data-handler="go" bindtap="go"><image class="row-icon" src="/pages/account/assets/{{index===0?'privacy-doc':index===1?'privacy-shield':index===2?'privacy-agreement':'privacy-permission'}}.jpg"/><text class="grow">{{item.name}}</text><text class="arrow">›</text></button></view><view class="card"><view class="heading">账号管理</view><button class="row" data-view="devices" data-handler="go" bindtap="go"><image class="symbol-image" src="/pages/account/assets/privacy-device.jpg" mode="aspectFit"/><text class="grow">登录设备</text><text class="arrow">›</text></button><button class="row" data-key="delete" data-handler="notice" bindtap="notice"><image class="symbol-image" src="/pages/account/assets/privacy-delete.jpg" mode="aspectFit"/><text class="grow">注销账号</text><text class="arrow">›</text></button><text class="hint">当前账号：{{profile.name}}</text></view></block>
 <block wx:elif="{{view==='services'}}"><input class="search" placeholder="⌕  搜索门店服务" value="{{keyword}}" bindinput="search"/><image class="service-banner" src="/pages/account/assets/service-banner.jpg" mode="aspectFill"/><view class="card three-grid"><button wx:for="{{['店招设计','展厅设计','品牌物料']}}" wx:key="*this" data-view="service" data-service="{{index===0?'store':index===1?'showroom':'brand'}}" data-handler="go" bindtap="go"><image class="service-category-icon" src="{{index===0?'/assets/account-shop.jpg':index===1?'/assets/house.png':'/assets/account-order.jpg'}}" mode="aspectFit"/>{{item}}</button></view><view class="card"><view class="heading">门店形象服务 <text class="link">查看全部 ›</text></view><view class="service-grid"><button wx:for="{{filteredServices}}" wx:key="id" wx:if="{{index<2}}" data-view="service" data-service="{{item.id}}" data-handler="go" bindtap="go"><image src="{{item.image}}" mode="aspectFill"/><text class="strong">{{item.name}}</text><text class="hint">{{item.desc}} ›</text></button></view><text wx:if="{{!filteredServices.length}}" class="empty">暂无匹配服务</text></view><button class="card row" data-view="service" data-service="brand" data-handler="go" bindtap="go"><image class="thumb" src="/pages/account/assets/service-brand.jpg" mode="aspectFill"/><view class="grow"><text class="strong">品牌物料</text><text class="hint">宣传册 · 名片 · 海报</text></view><text class="arrow">›</text></button><button class="card row" data-view="procurement" data-handler="go" bindtap="go"><image class="thumb" src="/pages/account/assets/service-material.jpg" mode="aspectFill"/><view class="grow"><text class="strong">众墅甄选</text><text class="hint">建材与配套采购</text></view><text class="pill">去逛逛 ›</text></button></block>
 <block wx:elif="{{view==='service'}}"><image class="service-hero" src="{{service.image}}" mode="aspectFill"/><view class="card"><view class="heading">{{service.name}}<text class="pill link">按需求报价 ›</text></view><text class="hint">统一品牌形象，适配门店现场。</text></view><view class="card"><view class="heading">服务内容</view><view wx:for="{{service.items}}" wx:key="*this" class="row"><image class="row-icon" src="/pages/account/assets/file.jpg"/><view class="grow"><text class="strong">{{item}}</text><text class="hint">{{index===0?'设计方向结合需求确定':index===1?'结合门店现场条件提供建议':'交付文件范围沟通确认'}}</text></view><text class="arrow">›</text></view></view><view class="card"><view class="heading">交付说明</view><view class="row"><text class="label">制作与安装</text><text>另行确认</text></view><view class="row"><text class="label">交付周期</text><text>需求沟通后确认</text></view></view><view class="card row"><text class="brown">适用门店</text><text>新店开业 · 门店焕新</text></view></block>
 <block wx:elif="{{view==='request'}}"><view class="card row service-summary"><image class="thumb" src="{{service.image}}" mode="aspectFill"/><view><text class="strong">{{service.name}}</text><text class="hint">按需求报价</text></view></view><view class="card"><view class="heading">门店信息</view><view class="row"><text class="label">门店名称 <text class="required">*</text></text><text>{{company.store}}</text></view><view class="row"><text class="label">门店地址 <text class="required">*</text></text><input placeholder="请填写门店详细地址" value="{{form.address}}" data-key="address" bindinput="input"/></view></view><view class="card"><view class="heading">现场信息</view><view class="two-grid"><button class="photo-box" data-key="photos" data-handler="photo" bindtap="photo"><image wx:if="{{form.photos.length}}" src="{{form.photos[0]}}" mode="aspectFill"/><image wx:else class="symbol camera-image" src="/pages/account/assets/camera.jpg" mode="aspectFit"/><text>{{service.photoLabel}} <text class="required">*</text></text></button><button class="photo-box" data-key="sizePhotos" data-handler="photo" bindtap="photo"><image wx:if="{{form.sizePhotos.length}}" src="{{form.sizePhotos[0]}}" mode="aspectFill"/><image wx:else class="symbol camera-image" src="/pages/account/assets/camera.jpg" mode="aspectFit"/><text>尺寸照片</text></button></view><view class="row size-input"><text>{{service.id==='store'?'门头尺寸':'设计尺寸'}}</text><input placeholder="宽度（米）" type="digit" value="{{form.width}}" data-key="width" bindinput="input"/><text>×</text><input placeholder="高度（米）" type="digit" value="{{form.height}}" data-key="height" bindinput="input"/></view><text class="hint center">暂不清楚可在沟通时补充</text></view><view class="card"><view class="heading">补充需求</view><textarea class="textarea" placeholder="请描述门店现状、风格偏好及其他要求" maxlength="300" value="{{form.note}}" data-key="note" bindinput="input"/><text class="counter">{{form.note.length||0}}/300</text></view><view class="card"><view class="heading">联系人信息</view><view class="row"><text class="label">联系人</text><input value="{{form.contact}}" data-key="contact" bindinput="input"/></view><view class="row"><text class="label">联系电话 <text class="required">*</text></text><input placeholder="请填写联系电话" type="number" maxlength="11" value="{{form.phone}}" data-key="phone" bindinput="input"/></view></view><view class="page-actions"><button class="solid bottom-inline {{!form.address||!form.phone||!form.photos.length?'is-disabled':''}}" loading="{{busy}}" disabled="{{!form.address||!form.phone||!form.photos.length}}" data-handler="submitRequest" bindtap="submitRequest">提交需求</button></view><text class="hint center">{{!form.address||!form.phone||!form.photos.length?'请补充必填信息':'当前需求已保存在本机订单中'}}</text></block>
 <block wx:elif="{{view==='orders'}}"><input class="search" placeholder="⌕  搜索服务名称" value="{{keyword}}" bindinput="search"/><view class="inset order-scope">♙ {{company.store}} · {{profile.name}}<text class="hint">本人提交及授权订单</text></view><view class="line-tabs"><button wx:for="{{orderTabs}}" wx:key="*this" class="{{orderTab===item?'active':''}}" data-key="orderTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><button wx:for="{{orders}}" wx:key="id" class="card order-row" data-view="order" data-id="{{item.id}}" data-handler="go" bindtap="go"><image src="{{item.image}}" mode="aspectFill"/><view class="grow"><text class="strong">{{item.name}}</text><text class="hint">{{item.store}}　{{item.submitted}}提交</text><text class="hint">{{item.status==='待确认'?'方案待负责人确认':item.status==='已完成'?'交付文件可查看':item.status==='取消处理中'?'取消处理中，款项待核实':'服务方将与你联系'}}</text><view class="order-button">查看{{item.status==='已完成'?'交付':'详情'}}</view></view><text class="pill">{{item.status}}</text></button><view wx:if="{{!orders.length}}" class="card empty">暂无订单，先从加盟商服务选择所需服务</view><text class="divider">已展示全部匹配订单</text></block>
 <block wx:elif="{{view==='order'}}"><view class="card order-state"><text class="symbol">◷</text><view><text class="strong brown">{{order.status==='待确认'?'方案待负责人确认':order.status}}</text><text class="hint">{{order.plan?'已提交方案 V'+order.plan.version:'等待需求沟通'}}</text></view><view class="steps"><view wx:for="{{['需求沟通','方案设计','方案确认','文件交付']}}" wx:key="*this"><text class="step-circle">{{index+1}}</text><text>{{item}}</text></view></view></view><view class="card row"><view class="grow"><text class="strong">{{order.name}}</text><text class="hint">服务门店　{{order.store}}</text><text class="hint">提交人　{{order.applicant}}</text><text class="hint">订单号　{{order.id}}</text></view><image class="thumb" src="{{order.service==='showroom'?'/pages/account/assets/service-showroom.jpg':order.service==='brand'?'/pages/account/assets/service-brand.jpg':'/pages/account/assets/service-store.jpg'}}" mode="aspectFill"/></view><view wx:if="{{order.plan}}" class="card"><text class="strong">最新方案</text><button class="plan-preview" data-handler="previewPlan" bindtap="previewPlan"><image src="{{order.plan.image}}" mode="aspectFill"/></button><button class="row" data-view="plan" data-id="{{order.id}}" data-handler="go" bindtap="go"><view class="grow"><text class="strong">{{order.plan.name}}</text><text class="hint">更新于 {{order.plan.date}}</text></view><text class="brown">查看方案 ›</text></button></view><button class="card row" data-key="quote" data-handler="notice" bindtap="notice"><image class="row-icon" src="/pages/account/assets/file.jpg"/><text class="grow">服务报价</text><text class="brown">查看报价记录 ›</text></button><button class="card row" data-view="delivery" data-id="{{order.id}}" data-handler="go" bindtap="go"><image class="row-icon" src="/assets/account-order.jpg"/><view class="grow"><text>交付记录</text><text class="hint">{{order.delivery?'查看当前版本交付文件':'方案确认后按约定交付'}}</text></view><text class="pill">{{order.delivery?order.delivery.received?'已接收':'待接收':'尚未交付'}}</text></button><view class="card"><view class="heading">服务动态</view><view wx:for="{{order.events}}" wx:key="at" class="event"><text class="brown">•</text><text class="hint">{{item.at}}　{{item.text}}</text></view></view><view class="page-actions"><button wx:if="{{isServiceProvider&&(order.status==='待沟通'||order.status==='进行中'&&!order.confirmation)}}" class="outline" data-action="demo-plan" data-handler="orderAction" bindtap="orderAction">提交方案</button><button wx:if="{{isServiceProvider&&order.status==='进行中'&&order.confirmation}}" class="outline" data-action="demo-delivery" data-handler="orderAction" bindtap="orderAction">提交成果</button><button wx:if="{{isServiceProvider&&order.status==='交付待修正'}}" class="outline" data-action="demo-redelivery" data-handler="orderAction" bindtap="orderAction">补交文件</button><button wx:if="{{!isServiceProvider&&(order.status==='待沟通'||order.status==='待确认'||order.status==='进行中')}}" class="outline" data-action="cancel" data-handler="orderAction" bindtap="orderAction">申请取消</button><button wx:if="{{order.cancel}}" class="outline" data-view="cancel" data-id="{{order.id}}" data-handler="go" bindtap="go">查看取消进度</button><button class="solid bottom-inline" data-key="contact" data-handler="notice" bindtap="notice">联系服务方</button></view><text class="hint center">确认操作由门店负责人处理</text></block>
 <block wx:elif="{{view==='plan'}}"><view wx:if="{{!order.plan}}" class="card empty">方案尚未提交</view><block wx:else><view class="card row inset"><text class="symbol">◷</text><view><text class="strong brown">{{order.confirmation?'方案已确认':'方案待确认'}}</text><text class="hint">当前身份：{{role}}</text></view></view><view class="card"><view class="row"><text class="strong grow">{{order.plan.name}}</text><button class="brown" data-handler="previewPlan" bindtap="previewPlan">查看完整方案 ›</button></view><text class="hint">更新时间 {{order.plan.date}}</text><button class="plan-preview" data-handler="previewPlan" bindtap="previewPlan"><image src="{{order.plan.image}}" mode="aspectFill"/></button></view><view class="card"><view class="heading">方案信息</view><view class="row"><text class="label">设计范围</text><text>{{order.name}}</text></view><view class="row"><text class="label">服务门店</text><text>{{order.store}}</text></view><view class="row"><text class="label">提交人</text><text>{{order.applicant}}</text></view></view><button class="card row" data-key="quote" data-handler="notice" bindtap="notice"><text class="grow">服务报价</text><text class="brown">查看报价记录 ›</text></button><view wx:if="{{canConfirmService&&order.status==='待确认'}}" class="card"><view class="heading">修改意见 <text class="link muted">选填</text></view><textarea class="textarea" maxlength="500" placeholder="请填写需要调整的内容" value="{{form.note}}" data-key="note" bindinput="input"/></view><button wx:if="{{canConfirmService&&order.status==='待确认'}}" class="check-row" data-handler="toggle" bindtap="toggle"><text class="checkbox {{checked?'selected':''}}">{{checked?'✓':''}}</text><text>已查看并核对当前 V{{planVersion}} 方案文件</text></button><view wx:if="{{canConfirmService&&order.status==='待确认'}}" class="page-actions"><button class="outline" data-action="return-plan" data-handler="orderAction" bindtap="orderAction">返回修改</button><button class="solid" data-action="confirm-plan" data-handler="orderAction" bindtap="orderAction">确认此方案</button></view><text class="hint center">确认后进入文件交付，不发起付款。</text></block></block>
 <block wx:elif="{{view==='delivery'}}"><view wx:if="{{!order.delivery}}" class="card empty">尚未交付，方案确认后按约定交付文件。</view><block wx:else><view class="card inset"><view class="row"><text class="symbol">◷</text><view><text class="strong brown">{{order.delivery.received?'成果已接收':'成果已交付 · 待接收'}}</text><text class="hint">方案 V{{order.delivery.version}} 已确认</text></view></view><view class="row"><text>服务门店　{{order.store}}</text><text>提交人　{{order.applicant}}</text></view></view><view class="card"><view class="heading">项目预览</view><image class="delivery-preview" src="{{order.plan.image}}" mode="aspectFill"/></view><view class="card"><view class="heading">交付成果</view><button wx:for="{{order.delivery.files}}" wx:key="name" class="row" data-index="{{index}}" data-handler="previewDelivery" bindtap="previewDelivery"><image class="row-icon" src="/pages/account/assets/{{index===0?'pdf':'zip'}}.jpg"/><text class="grow strong">{{item.name}}</text><text class="pill">{{index===0?'可预览':'电脑端下载'}}</text></button></view><view class="card"><view class="heading">交付记录</view><text class="hint">服务方已上传　{{order.delivery.at||order.submitted}}</text><button class="row" data-view="plan" data-id="{{order.id}}" data-handler="go" bindtap="go"><text class="grow">方案确认记录</text><text class="arrow">›</text></button></view><view wx:if="{{order.status==='交付待修正'}}" class="card"><text class="brown">已提出交付问题，等待服务方修正。</text><view class="page-actions"><button class="outline" data-view="order" data-id="{{order.id}}" data-handler="go" bindtap="go">返回订单跟进</button></view></view><view wx:if="{{!isServiceProvider&&!order.delivery.received&&order.status!=='交付待修正'}}" class="card"><textarea class="textarea" placeholder="如有问题，请说明具体缺失或需调整的文件" maxlength="500" value="{{form.note}}" data-key="note" bindinput="input"/><button class="check-row" data-handler="toggle" bindtap="toggle"><text class="checkbox {{checked?'selected':''}}">{{checked?'✓':''}}</text>已核对交付文件完整性</button><view class="page-actions"><button class="outline" data-action="delivery-issue" data-handler="orderAction" bindtap="orderAction">提出问题</button><button wx:if="{{canConfirmService}}" class="solid" data-action="receive" data-handler="orderAction" bindtap="orderAction">确认接收</button></view></view></block></block>
 <block wx:elif="{{view==='cancel'}}"><view wx:if="{{!order.cancel}}" class="card empty">该订单尚无取消申请</view><block wx:else><view class="card inset"><text class="strong brown">{{order.status}}</text><text class="hint">{{order.cancel.paymentStatus}}</text></view><view class="card cancel-order"><view class="heading">订单信息</view><image wx:if="{{order.plan}}" class="cancel-thumb" src="{{order.plan.image}}" mode="aspectFill"/><view class="row"><text class="label">服务门店</text><text>{{order.store}}</text></view><view class="row"><text class="label">服务内容</text><text>{{order.name}}</text></view><view class="row"><text class="label">提交人</text><text>{{order.applicant}}</text></view></view><view class="card"><view class="heading">取消详情</view><text class="body-text">取消原因　{{order.cancel.reason}}</text><text class="hint">申请时间　{{order.cancel.at}}</text></view><view class="card"><view class="heading">处理进度</view><text class="event">✓ 取消申请已提交</text><text class="event brown">{{order.cancel.status}}</text><text class="hint">{{order.status==='已取消'?'取消核实已完成':'原订单与核实依据保留'}}</text></view><view class="card"><view class="heading">款项处理</view><view class="row"><text class="label">已付款情况</text><text class="pill">{{order.cancel.paymentStatus}}</text></view><view class="row"><text class="label">退款处理</text><text class="pill">{{order.cancel.refundStatus}}</text></view><text class="hint">款项核实后再办理，不自动退款。</text></view><view class="page-actions"><button class="outline" data-view="order" data-id="{{order.id}}" data-handler="go" bindtap="go">查看原订单</button><button wx:if="{{isServiceProvider&&order.status==='取消处理中'}}" class="solid" data-action="cancel-resolve" bindtap="orderAction">核实取消申请</button><button wx:else class="solid" data-key="contact" data-handler="notice" bindtap="notice">联系服务方</button></view></block></block>
 <block wx:elif="{{view==='login'}}"><view class="login-intro"><image class="login-brand" src="/assets/brand.png" mode="aspectFit"/><text class="hint">员工账号由门店负责人开通</text></view><view class="card login-card"><view class="seg"><button wx:for="{{['手机号登录','微信一键登录']}}" wx:key="*this" class="{{loginMode===(index===0?'sms':'wechat')?'active':''}}" data-mode="{{index===0?'sms':'wechat'}}" data-handler="selectLoginMode" bindtap="selectLoginMode">{{item}}</button></view><block wx:if="{{loginMode==='sms'}}"><view class="row inset"><text class="label">手机号</text><input class="grow" type="number" maxlength="11" placeholder="请输入手机号" value="{{form.mobile}}" data-key="mobile" bindinput="input"/></view><view class="row inset"><text class="label">验证码</text><input class="grow" type="number" maxlength="6" placeholder="6位验证码" value="{{form.captcha}}" data-key="captcha" bindinput="input"/><button class="captcha-btn {{countdown||loginBusy?'is-disabled':''}}" disabled="{{countdown>0||loginBusy}}" data-handler="sendCaptcha" bindtap="sendCaptcha">{{countdown?countdown+'s后重发':'获取验证码'}}</button></view><view class="page-actions"><button class="solid {{loginBusy?'is-disabled':''}}" loading="{{loginBusy}}" disabled="{{loginBusy}}" data-handler="smsLogin" bindtap="smsLogin">登录</button></view><text class="hint center">验证码5分钟内有效，60秒后可重新获取。</text></block><block wx:else><view class="page-actions wechat-actions"><button class="solid wechat-login-btn {{loginBusy?'is-disabled':''}}" open-type="getPhoneNumber" bindgetphonenumber="wechatLogin" loading="{{loginBusy}}" disabled="{{loginBusy}}"><image class="wechat-login-icon" src="/pages/account/assets/wechat-logo.png" mode="aspectFit"/><text>微信一键登录</text></button></view></block></view><view class="agreement-row login-agreement"><button class="check-row" data-handler="toggle" bindtap="toggle"><text class="checkbox {{checked?'selected':''}}">{{checked?'✓':''}}</text>我已阅读并同意</button><button class="brown" data-view="agreement" data-handler="go" bindtap="go">《用户协议》</button><text>和</text><button class="brown" data-view="policy" data-handler="go" bindtap="go">《隐私政策》</button></view></block>
 <block wx:elif="{{view==='identity'}}"><view class="card row"><image class="avatar-small" src="{{profile.avatar}}" mode="aspectFill"/><view><text class="large">{{profile.name}}</text><text wx:if="{{apiLoggedIn}}" class="hint">当前身份：{{apiCurrentName}}</text></view></view><block wx:if="{{apiLoggedIn}}"><view class="card"><view class="heading">后端授权岗位</view><button wx:for="{{apiRoleOptions}}" wx:key="postId" class="identity-option {{item.selected?'selected-option':''}}" data-post-id="{{item.postId}}" data-handler="selectApiPost" bindtap="selectApiPost"><image class="symbol-image" src="/pages/account/assets/identity-company.jpg"/><view class="grow"><text class="strong">{{item.name}} {{item.lead}}</text><text class="hint">{{item.orgType}} · 点击切换并进入对应工作台</text></view><text class="brown">{{item.selected?'●':'○'}}</text></button><text class="hint">来自门店负责人在后台的任职分配；底部导航与首页随当前岗位切换。</text></view><view class="page-actions"><button wx:if="{{apiCanManage}}" class="solid" data-view="api-members" data-handler="go" bindtap="go">管理本店成员与权限 ›</button><button class="outline" data-handler="logoutApi" bindtap="logoutApi">退出后端账号</button></view></block><block wx:else><view class="card"><view class="heading">当前公司</view><view class="row inset"><image class="symbol-image" src="/pages/account/assets/identity-company.jpg"/><text class="strong grow">{{company.name}}</text><button class="brown" data-key="companies" data-handler="notice" bindtap="notice">切换公司 ›</button></view><text class="hint">仅可选择已加入的公司</text></view><view class="card"><view class="heading">已授权工作身份</view><button wx:for="{{roleOptions}}" wx:key="id" class="identity-option {{selectedRole===item.id?'selected-option':''}}" data-role="{{item.id}}" data-handler="selectRole" bindtap="selectRole"><image class="symbol-image" src="/pages/account/assets/{{item.id==='engineer'||item.id==='project-manager'?'identity-manager':'identity-sales'}}.jpg"/><view class="grow"><text class="strong">{{item.name}}</text><text class="hint">{{item.description}}</text></view><text class="brown">{{selectedRole===item.id?'●':'○'}}</text></button><text class="hint">仅显示管理员已分配的身份</text></view><view class="card"><view class="heading">切换后</view><text class="body-text">进入对应工作台</text><text class="body-text">按当前身份查看可用内容</text></view><view class="page-actions"><button class="solid" data-handler="switchRole" bindtap="switchRole">确认切换</button></view></block></block>
 <block wx:elif="{{view==='api-members'}}"><view class="card"><view class="heading">添加成员</view><text class="hint">管理员指派制：由你把成员关联到部门与岗位，员工登录后自动发现身份。</text><view class="row inset"><text class="label">部门</text><picker class="grow" range="{{apiTeamOptions}}" range-key="name" data-key="teamIndex" bindchange="pickMemberField"><view>{{apiTeamOptions.length?apiTeamOptions[form.teamIndex].name+' ›':'全店（不分组） ›'}}</view></picker></view><view class="row inset"><text class="label">岗位</text><picker class="grow" range="{{apiRoleOptionsForAdd}}" range-key="name" data-key="roleIndex" bindchange="pickMemberField"><view>{{apiRoleOptionsForAdd[form.roleIndex].name}} ›</view></picker></view><view class="row inset"><text class="label">姓名</text><input class="grow" value="{{form.memberName}}" maxlength="20" placeholder="员工姓名" data-key="memberName" bindinput="input"/></view><view class="row inset"><text class="label">手机号</text><input class="grow" type="number" maxlength="11" placeholder="登录凭证（11位手机号）" value="{{form.memberMobile}}" data-key="memberMobile" bindinput="input"/></view><view class="page-actions"><button class="solid {{apiMembersBusy?'is-disabled':''}}" loading="{{apiMembersBusy}}" disabled="{{apiMembersBusy}}" data-handler="addMember" bindtap="addMember">加入并指派岗位</button></view><text class="hint center">员工用手机号验证码或微信一键登录即可发现此身份；选择「业务负责人」即拥有本部门管理范围。</text></view><view class="card"><view class="heading">在岗成员 {{apiStaffRows.length}} 人</view><view wx:for="{{apiStaffRows}}" wx:key="postId" class="row inset"><view class="grow"><text class="strong">{{item.roleName}}</text><text class="hint">{{item.name}} · {{item.mobile}} · {{item.teamName||'全店'}}</text></view><button class="mini-action" data-post-id="{{item.postId}}" data-name="{{item.name}}" data-handler="revokeRow" bindtap="revokeRow">撤销</button><button class="mini-action {{item.active?'':'warn'}}" data-user-id="{{item.userId}}" data-name="{{item.name}}" data-active="{{item.active}}" data-handler="toggleActiveRow" bindtap="toggleActiveRow">{{item.active?'停用':'启用'}}</button></view><text wx:if="{{!apiStaffRows.length}}" class="empty">暂无成员，先用上方表单添加</text></view><block wx:if="{{apiCanManage}}"><view wx:if="{{apiLeavers.length||handoverSource}}" class="card"><view class="heading">离职交接</view><text class="hint">正常交接：先核对接收人，逐域批量转移在途客户、委托、工程与账款，再撤销任职；失败整体回滚可重试。</text><view class="row inset"><text class="label">离职成员</text><picker class="grow" range="{{apiLeavers}}" range-key="name" bindchange="pickHandoverLeaver"><view>{{handoverSource?handoverSource.name+'（'+handoverSource.roleName+'）':'请选择 ›'}}</view></picker></view><view class="row inset"><text class="label">接收人</text><picker class="grow" range="{{apiReceivers}}" range-key="name" bindchange="pickHandoverTarget"><view>{{handoverTargetIndex>=0&&apiReceivers[handoverTargetIndex]?apiReceivers[handoverTargetIndex].name+' ›':(apiReceivers.length?'请选择接收人 ›':'本组织无其他在岗成员 ›')}}</view></picker></view><view class="page-actions"><button class="solid {{handoverBusy||apiMembersBusy?'is-disabled':''}}" loading="{{handoverBusy}}" disabled="{{handoverBusy||apiMembersBusy}}" bindtap="confirmHandover">发起正常交接</button><button class="outline" disabled="{{handoverBusy||apiMembersBusy}}" bindtap="confirmEmergency">紧急撤权（不等待交接）</button></view><text class="hint">紧急撤权仅用于突发离职等必须立即收权的情形：立即撤销任职与钱包会话，在途事项转入下方待分配清单，可事后补交接。</text><text wx:if="{{reassignHint}}" class="hint">{{reassignHint}}</text></view><view wx:if="{{handoverResult}}" class="card"><view class="heading">{{handoverResult.title}}</view><view wx:for="{{handoverResult.items}}" wx:key="label" class="row inset"><view class="grow"><text class="strong">{{item.label}}</text><text class="hint">{{item.inFlightText}} · 已转移 {{item.transferred}} 项</text></view><text class="{{item.statusText==='转待分配'?'warn':''}}">{{item.statusText}}</text></view><text wx:if="{{handoverResult.openCount}}" class="hint">存在转待分配事项时，请在下方清单对相应域发起补交接。</text></view><view wx:if="{{apiPendingRows.length}}" class="card"><view class="heading">待分配在途事项 {{apiPendingRows.length}} 组</view><text class="hint">紧急撤权后未交接的在途对象；补交接将移交该成员的全部在途事项（含各域），完成后此处行自动关闭。</text><text wx:if="{{handoverPendingError}}" class="warn">待分配清单刷新失败，以下为上次结果，请下拉重试。</text><view wx:for="{{apiPendingRows}}" wx:key="id" class="row inset"><view class="grow"><text class="strong">{{item.fromName}} · {{item.domainLabel}}</text><text class="hint">{{item.inFlightText}} · {{item.createTime}}</text></view><button class="mini-action {{handoverBusy||apiMembersBusy?'is-disabled':''}}" data-user-id="{{item.fromUserId}}" data-name="{{item.fromName}}" disabled="{{handoverBusy||apiMembersBusy}}" bindtap="reassignRow">补交接（移交全部在途）</button></view></view></block></block>
 <block wx:elif="{{view==='access'}}"><view class="access-intro"><image class="lock-symbol" src="/pages/account/assets/access-lock.jpg" mode="aspectFit"/><text class="large">暂时没有访问权限</text><text class="hint">当前身份未获此功能授权</text><text class="hint">如需使用，请联系公司管理员</text></view><view class="card"><view class="row"><text class="label grow">当前公司</text><text>{{company.name}}</text></view><view class="row"><text class="label grow">当前身份</text><text>{{role}}</text></view><view class="row"><text class="label grow">访问内容</text><text>{{accessLabel}}</text></view></view><view class="page-actions"><button class="solid" data-handler="backHome" bindtap="backHome">返回工作台</button><button class="outline" data-view="identity" data-handler="go" bindtap="go">切换工作身份</button></view><text class="divider">权限开通后，可重新进入</text></block>
 <block wx:elif="{{view==='resource'}}"><view wx:if="{{resource}}" class="card"><view class="heading">{{resource.name}}</view><text class="hint">{{resource.type}} · {{resource.category}} · {{resource.version}} · {{resource.date}}</text><view class="document-preview"><image src="/pages/account/assets/file.jpg"/><text class="strong">{{resource.name}}</text></view><view class="page-actions"><button class="outline" data-handler="favorite" bindtap="favorite">{{resourceFavorite?'取消收藏':'收藏资料'}}</button></view></view><view wx:else class="card empty">资料不存在</view></block>
 <block wx:elif="{{view==='policy'}}">
  <view class="card"><view class="heading">隐私政策</view><text class="hint">生效日期：【上线日期】　本政策适用于「众墅之家」小程序及配套服务（运营主体：【公司全称】，下称"我们"）。</text></view>
  <view class="card"><view class="heading">一、我们收集的信息</view><text class="body-text">1. 登录信息：手机号码（用于验证码登录）及微信登录授权信息。</text><text class="body-text">2. 个人资料：微信头像与昵称、姓名、所属公司与岗位（由所在公司管理员指派维护）。</text><text class="body-text">3. 业务素材：你在办理业务中上传的照片与文件（如头像、现场照片、往来凭据等）。</text><text class="body-text">4. 使用信息：设备信息、操作日志，用于保障服务安全与排查故障。</text></view>
  <view class="card"><view class="heading">二、我们如何使用信息</view><text class="body-text">上述信息仅用于：账号验证与岗位身份识别、业务办理与消息通知、内容安全审核、服务运行维护。我们不会将你的个人信息用于上述目的之外的场景。</text></view>
  <view class="card"><view class="heading">三、信息的共享与存储</view><text class="body-text">我们委托腾讯云提供短信验证码、对象存储（存储于中国境内）与内容安全审核服务，仅共享完成对应功能所必需的信息。除法律法规要求或你的明确同意外，我们不向其他第三方提供你的个人信息。</text></view>
  <view class="card"><view class="heading">四、你的权利</view><text class="body-text">你可以在"我的"页面查看、更正个人资料；可以联系所在公司管理员更正公司与岗位信息；可以通过"账号与隐私 → 注销账号"申请注销账号。注销后我们将依法删除或匿名化你的个人信息（法律法规要求留存的业务记录除外）。</text></view>
  <view class="card"><view class="heading">五、联系我们</view><text class="body-text">如对本政策有任何疑问、意见或投诉，请联系：【客服邮箱 / 客服电话】。我们将在 15 个工作日内答复。</text></view>
 </block>
 <block wx:elif="{{view==='agreement'}}">
  <view class="card"><view class="heading">用户协议</view><text class="hint">生效日期：【上线日期】　本协议是你与【公司全称】（下称"我们"）之间就使用「众墅之家」小程序服务所订立的协议。</text></view>
  <view class="card"><view class="heading">一、服务说明</view><text class="body-text">本服务面向企业内部协作：员工账号由所在公司管理员开通并指派岗位，你按被授予的岗位权限使用客户、工程、财务、内容等工作台功能。</text></view>
  <view class="card"><view class="heading">二、账号与安全</view><text class="body-text">账号仅限本人使用，请妥善保管登录凭证，不得转借。人员离职或调岗时，由管理员通过系统完成岗位交接与权限回收。</text></view>
  <view class="card"><view class="heading">三、用户行为规范</view><text class="body-text">你承诺不上传违法违规、侵犯他人权益的内容；上传的素材将经过内容安全审核。你在工作中录入的业务数据应真实、准确。</text></view>
  <view class="card"><view class="heading">四、数据归属</view><text class="body-text">你在服务中形成的客户、项目、财务等业务数据归你所在公司所有；我们按法律法规及与公司的约定进行存储与保护。</text></view>
  <view class="card"><view class="heading">五、服务变更与免责</view><text class="body-text">我们可能因系统维护、升级等原因暂停服务，并将提前通知。因不可抗力或非我们过错造成的损失，我们不承担责任。</text></view>
  <view class="card"><view class="heading">六、协议更新与联系我们</view><text class="body-text">我们可能适时修订本协议并在应用内公示，继续使用即视为接受修订。如有疑问请联系：【客服邮箱 / 客服电话】。</text></view>
 </block>
 <block wx:else><view class="card"><view class="heading">{{title}}</view><text class="body-text">{{view==='devices'?'当前仅记录本设备的登录。':'可在微信设置中管理相册等系统权限。公司业务权限由管理员分配。'}}</text><view class="page-actions"><button class="outline" data-view="privacy" data-handler="go" bindtap="go">返回账号与隐私</button></view></view></block>
 <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
<action-panel wx:if="{{modal&&(modal.type==='notice'||modal.type==='preview'||modal.type==='logout'||modal.type==='demo')}}" workbench="{{true}}" panel="{{modal}}" bind:close="closeModal" bind:submit="confirmModal"/><view wx:elif="{{modal}}" class="overlay" data-handler="closeModal" bindtap="closeModal"><view class="sheet" catchtap="noop"><button class="sheet-close" data-handler="closeModal" bindtap="closeModal">×</button><text class="large">{{modal.title}}</text><image wx:if="{{modal.image}}" class="modal-image" src="{{modal.image}}" mode="widthFix"/><text wx:if="{{modal.text}}" class="body-text">{{modal.text}}</text><block wx:if="{{modal.type==='lesson'}}"><image class="modal-image" src="{{courseImage}}" mode="widthFix"/><text class="body-text">视频准备中，可先查看配套资料。</text></block><block wx:if="{{modal.type==='cancel-resolution'}}"><picker range="{{['核实未收款，取消','退回取消申请','款项待核实']}}" bindchange="pickCancel"><view class="outline">{{form.cancelResult||'选择核实结果'}}</view></picker><textarea class="textarea" placeholder="填写原渠道核实说明" data-key="note" bindinput="input"/><button class="outline" data-key="cancelProof" bindtap="photo">上传核实依据（{{form.cancelProof.length||0}}）</button><button class="outline" bindtap="toggle">{{checked?'☑':'□'}} 已核对原订单与原渠道款项</button></block><textarea wx:if="{{modal.type==='cancel'}}" class="textarea" placeholder="请填写取消原因，款项需另行核实" maxlength="300" value="{{form.note}}" data-key="note" bindinput="input"/><text wx:if="{{error}}" class="error">{{error}}</text><button class="solid" data-handler="confirmModal" bindtap="confirmModal">{{modal.type==='lesson'?'标记本节学习完成':modal.type==='cancel'?'提交取消申请':'确认'}}</button></view></view>

<view wx:if="{{paymentReceipt}}" class="payment-receipt-mask"><view class="payment-receipt-panel"><button class="payment-receipt-close" bindtap="closePaymentReceipt">关闭</button><view class="payment-receipt-check {{paymentReceipt.channel==='alipay'?'ali':''}}">✓</view><text class="payment-receipt-title">付款已完成</text><text class="payment-receipt-amount">{{paymentReceipt.amount}}</text><text class="payment-receipt-merchant">{{paymentReceipt.recipient}}</text><view class="payment-receipt-row"><text>项目客户</text><text>{{paymentReceipt.customerName}}</text></view><view class="payment-receipt-row"><text>计费依据</text><text>{{paymentReceipt.area}}㎡ × {{paymentReceipt.rate}}/㎡</text></view><view class="payment-receipt-row"><text>付款方式</text><text>{{paymentReceipt.channelName}} · {{paymentReceipt.method}}</text></view><view class="payment-receipt-row"><text>订单编号</text><text>{{paymentReceipt.number}}</text></view><view class="payment-receipt-row"><text>支付时间</text><text>{{paymentReceipt.paidAt}}</text></view><text class="payment-receipt-note">模拟支付 · 不计入正式实收实付</text><button class="solid" bindtap="closePaymentReceipt">完成</button></view></view>
