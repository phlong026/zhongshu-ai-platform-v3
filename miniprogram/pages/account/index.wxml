<account-header id="account-subpage-header" id="subpage-header" title="{{title}}"/>
<view class="account view-{{view}}" style="padding-top:calc({{statusHeight}}px + 92rpx)">
 <view wx:if="{{missing}}" class="card empty-state"><text class="large">内容不存在或暂无访问权限</text><view class="page-actions"><button class="solid" data-view="orders" data-handler="go" bindtap="go">返回我的服务订单</button></view></view>
 <block wx:elif="{{view==='selection'}}"><input class="search" placeholder="⌕ 搜索材料、规格" bindinput="search"/><view class="line-tabs"><button wx:for="{{['全部','外墙','门窗','屋面']}}" wx:key="*this" class="{{category===item?'active':''}}" data-key="category" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><image class="service-banner" src="/pages/account/assets/selection-banner.jpg" mode="aspectFill"/><view class="service-grid"><button wx:for="{{filteredProducts}}" wx:key="id" class="card" data-view="product" data-id="{{item.id}}" data-handler="go" bindtap="go"><image src="{{item.image}}" mode="aspectFill"/><text class="strong">{{item.name}}</text><text class="hint">{{item.spec}}</text><text class="product-inquiry">按需询价</text></button></view><button class="card row" data-view="purchases" data-handler="go" bindtap="go"><image class="row-icon" src="/assets/account-order.jpg"/><text class="grow">我的采购单</text><text class="arrow">›</text></button><text class="hint center">具体供货及报价以确认方案为准。</text></block>
 <block wx:elif="{{view==='product'}}"><block wx:if="{{product}}"><image class="service-hero" src="{{product.image}}" mode="aspectFill"/><view class="card"><view class="heading">{{product.name}}<text class="pill link">按需询价</text></view><text class="hint">{{product.spec}}</text></view><view class="card"><view class="heading">商品规格</view><view class="row"><text class="label">规格</text><text>{{product.spec}}</text></view><view class="row"><text class="label">计量单位</text><text>{{product.unit}}</text></view><view class="row"><text class="label">适用部位</text><text>{{product.category}}</text></view></view><view class="card"><view class="heading">供货说明</view><view class="row"><text class="label">报价方式</text><text>按数量与配送地点报价</text></view><view class="row"><text class="label">供货周期</text><text>询价后确认</text></view><view class="row"><text class="label">运费与卸货</text><text>报价时列明</text></view></view><view class="card"><view class="heading">项目应用</view><image class="thumb" src="/pages/account/assets/selection-banner.jpg"/><text class="hint">可关联项目材料计划</text></view><view class="footer page-actions"><button class="outline" data-key="contact" data-handler="notice" bindtap="notice">联系供应服务</button><button class="solid" data-view="procure" data-id="{{product.id}}" data-handler="go" bindtap="go">提交采购需求</button></view></block><view wx:else class="card empty">商品不存在</view></block>
 <block wx:elif="{{view==='procure'}}"><view class="card row"><image class="thumb" src="{{product.image}}" mode="aspectFill"/><view><text class="strong">{{product.name}}</text><text class="hint">{{product.spec}}</text></view></view><view class="card"><view class="heading">项目信息</view><view class="row"><text class="label">关联项目</text><picker range="{{projects}}" range-key="name" bindchange="pickProject"><text>{{selectedProjectName||'张先生 · 红安乡墅'}} ›</text></picker></view><view class="row"><text class="label">对应节点</text><text>{{product.category==='屋面'?'屋面施工':'外墙施工'}}</text></view><view class="row"><text class="label">采购范围</text><text>原合同范围</text></view></view><view class="card"><view class="heading">采购明细</view><view class="row"><text class="label">需求数量</text><input type="digit" placeholder="输入需求数量" value="{{form.quantity}}" data-key="quantity" bindinput="input"/><text>{{product.unit}}</text></view><view class="row"><text class="label">期望到货</text><picker mode="date" value="{{form.date}}" data-key="date" bindchange="input">{{form.date}} ›</picker></view></view><view class="card"><view class="heading">配送与费用</view><view class="row"><text class="label">地址</text><input value="{{form.address}}" data-key="address" bindinput="input"/></view><view class="row"><text class="label">收货人</text><input value="{{form.contact}}" data-key="contact" bindinput="input"/></view><view class="row"><text class="label">费用承担</text><text>加盟商</text></view></view><view class="card"><view class="heading">补充要求（选填）</view><textarea class="textarea" placeholder="请填写包装、卸货或其他要求" maxlength="200" value="{{form.note}}" data-key="note" bindinput="input"/></view><text class="hint center">提交后等待报价，不产生付款。</text><view class="page-actions"><button class="solid" data-handler="submitProcure" bindtap="submitProcure">提交采购需求</button></view></block>
 <block wx:elif="{{view==='purchases'}}"><input class="search" placeholder="⌕ 搜索项目或材料" bindinput="search"/><view class="line-tabs"><button wx:for="{{['全部','待报价','待确认','供货中','已完成']}}" wx:key="*this" class="{{orderTab===item?'active':''}}" data-key="orderTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><button wx:for="{{filteredPurchases}}" wx:key="id" class="card purchase-list" data-view="purchase" data-id="{{item.id}}" data-handler="go" bindtap="go"><view class="row"><text class="strong grow">{{item.project.name}}</text><text class="pill">{{item.status}}</text></view><view class="row"><image class="thumb" src="{{item.product.image}}" mode="aspectFill"/><view><text class="strong">{{item.product.name}}</text><text class="hint">{{item.product.spec}}</text><text class="hint">需求数量 {{item.quantity}}{{item.product.unit}}</text></view></view><view class="row"><text class="label">期望到货</text><text>{{item.date}}</text></view><text class="brown">{{item.quote?'报价 V'+item.quote.version+' · ¥'+item.quote.total:item.status==='供货中'?'供货安排已确认':'等待供应报价'}}　查看 ›</text></button><button class="card row" data-view="selection" data-handler="go" bindtap="go">浏览众墅甄选 ›</button></block>
 <block wx:elif="{{view==='purchase'}}"><view wx:if="{{purchase&&canPurchaseQuote&&state.session.demo&&purchase.status==='待报价'}}" class="card"><text class="hint">本地模拟供应报价，不向供应商下单。</text><button class="outline demo-quote" bindtap="demoPurchaseQuote">载入模拟供应方报价</button></view><button wx:if="{{purchase&&canPurchaseEngineering&&purchaseProject.engineeringId}}" class="card row" bindtap="openPurchaseProject">进入关联工程材料与供货流程 ›</button><view wx:if="{{!purchase}}" class="card empty">采购单不存在或无权访问</view><block wx:else><view class="card"><view class="heading">{{purchaseProject.name}}<text class="pill link">{{purchase.status}}</text></view><text class="hint">{{product.category==='屋面'?'屋面施工':'外墙施工'}} · 原合同范围 · {{purchase.id}}</text><view class="row"><image class="thumb" src="{{product.image}}" mode="aspectFill"/><view><text class="strong">{{product.name}}</text><text class="hint">{{product.spec}}</text><text class="hint">需求数量 {{purchase.quantity}}{{product.unit}}</text></view></view></view><view class="card"><view class="heading">供货报价 <text class="pill link">{{purchase.quote?'报价 V'+purchase.quote.version:'待报价'}}</text></view><block wx:if="{{purchase.quote}}"><view class="row"><text class="label">单价</text><text>¥{{purchase.quote.unitPrice}}/{{product.unit}}（含税）</text></view><view class="row"><text class="label">材料金额</text><text>¥{{purchase.quote.material}}</text></view><view class="row"><text class="label">运费</text><text>¥{{purchase.quote.freight}}（含卸货）</text></view><view class="row"><text class="label">合计</text><text class="strong brown">¥{{purchase.quote.total}}</text></view></block><text wx:else class="hint">等待供应方确认规格、税费和运费后报价。</text></view><view class="card"><view class="heading">到货安排</view><view class="row"><text class="label">约定到货</text><text>{{purchase.date}}</text></view><view class="row"><text class="label">收货地点</text><text>{{purchase.address||purchaseProject.address}}</text></view><view class="row"><text class="label">费用承担</text><text>加盟商</text></view><view class="row"><text class="label">确认人</text><text>{{purchaseProject.manager}}（项目联系人）</text></view></view><view class="card"><view class="heading">采购进度</view><view class="steps"><view wx:for="{{['需求已提交','报价待确认','待安排供货']}}" wx:key="*this"><text class="step-circle">{{index+1}}</text><text>{{item}}</text></view></view><text class="hint">已关联工程的采购方案，可进入工程材料计划安排供货、登记收货并处理差异。</text></view><block wx:if="{{purchase.status==='待确认'}}"><button class="check-row" data-handler="toggle" bindtap="toggle"><text class="checkbox {{checked?'selected':''}}">{{checked?'✓':''}}</text>已核对当前报价、数量与配送安排</button><view wx:if="{{canPurchaseQuote}}" class="page-actions"><button class="solid" data-handler="confirmPurchase" bindtap="confirmPurchase">确认采购方案</button></view></block><text class="hint center">确认仅记录采购方案，不发起付款。</text></block></block>
 <block wx:elif="{{view==='profile'}}">
  <view class="card profile-hero"><button data-handler="avatar" bindtap="avatar"><image src="{{profile.avatar}}" mode="aspectFill"/><image class="avatar-camera" src="/pages/account/assets/profile-camera.png" mode="aspectFit"/></button><text>{{profile.name}}</text></view>
  <view class="card"><view class="heading">基本信息</view><view class="inset"><view class="row"><text class="label">姓名</text><input value="{{form.name}}" maxlength="20" data-key="name" bindinput="input"/><image class="profile-field-icon" src="/pages/account/assets/profile-edit.png"/></view><button class="row" data-view="binding" data-handler="go" bindtap="go"><text class="label">联系手机</text><text class="grow">{{maskedPhone}}</text><text class="pill">更换 ›</text></button><view class="row"><text class="label">公司</text><text class="grow">{{company.name}}</text><image class="profile-field-icon" src="/pages/account/assets/profile-lock.png"/></view><view class="row"><text class="label">岗位</text><text class="grow">{{role}}</text><image class="profile-field-icon" src="/pages/account/assets/profile-lock.png"/></view></view><text class="hint">公司与岗位由管理员维护。</text></view>
  <view class="card"><button class="heading full" data-view="identity" data-handler="go" bindtap="go">我的工作身份 <text class="link">切换 ›</text></button><view class="inset"><view class="row"><text class="label">所属部门</text><text>{{role==='业务员'?'业务部':role==='工程师'?'工程部':'管理部'}}</text></view><view class="row"><text class="label">服务区域</text><text>湖北</text></view><view class="row"><text class="label">权限范围</text><text>{{role==='业务员'?'本人负责的客户':role==='工程师'?'负责的项目':'本店已授权业务'}}</text></view></view></view>
  <view class="card compact"><view class="heading">资料使用说明</view><view class="inset hint">联系方式仅用于业务沟通与账号验证。</view></view><view class="page-actions"><button class="solid bottom-inline" data-handler="saveProfile" bindtap="saveProfile">保存修改</button></view>
 </block>
 <block wx:elif="{{view==='learning'}}">
  <input class="search" placeholder="⌕  搜索课程、资料" value="{{keyword}}" bindinput="search"/><view class="seg"><button wx:for="{{['课程','资料']}}" wx:key="*this" class="{{tab===item?'active':''}}" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view>
  <view class="categories"><button wx:for="{{categories}}" wx:key="*this" class="{{category===item?'active':''}}" data-key="category" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view>
  <block wx:if="{{tab==='课程'}}"><view class="card"><view class="heading">继续学习</view><button class="course-row continue-row" data-view="course" data-handler="go" bindtap="go"><image src="/pages/account/assets/course-continue.jpg" mode="aspectFill"/><view class="grow"><text class="strong">AI短视频获客实战</text><text class="hint">已完成 {{progress.completed}} / 8 节</text><view class="progress-track"><view style="width:{{progress.percent}}%"/></view></view><text class="pill">继续学习 ›</text><text class="course-percent">{{progress.percent}}%</text></button></view><view class="card"><view class="heading">精选课程 <text class="link">我的学习 ›</text></view><button wx:for="{{filteredCourses}}" wx:key="id" class="course-row" data-id="{{item.id}}" data-handler="openCourse" bindtap="openCourse"><image src="{{item.image}}" mode="aspectFill"/><view class="grow"><text class="strong">{{item.name}}</text><text class="hint">{{item.category}} · {{item.lessons}}节课</text></view><text class="arrow">›</text></button><text wx:if="{{!filteredCourses.length}}" class="empty">暂无匹配课程，试试其他分类或关键词</text></view></block>
  <block wx:else><view class="card"><view class="heading">常用资料 <text class="link">最近更新 ›</text></view><button wx:for="{{filteredResources}}" wx:key="id" class="resource-row" data-id="{{item.id}}" data-handler="previewResource" bindtap="previewResource"><image src="/pages/account/assets/file.jpg"/><view class="grow"><text class="strong">{{item.name}}</text><text class="hint">{{item.type}} · {{item.category}} · {{item.version}} · {{item.date}}</text></view><text class="brown">预览 ›</text></button><text wx:if="{{!filteredResources.length}}" class="empty">暂无匹配资料</text></view><button class="card row" data-handler="favorites" bindtap="favorites"><image class="row-icon" src="/pages/account/assets/star.jpg"/><view class="grow"><text class="strong">{{favoritesOnly?'全部资料':'我的收藏'}}</text><text class="hint">常用资料，随时查阅</text></view><text class="arrow">›</text></button></block>
 </block>
 <block wx:elif="{{view==='course'}}">
  <button class="course-cover" data-handler="continueCourse" bindtap="continueCourse"><image src="{{courseImage}}" mode="aspectFill"/><text class="play">▶</text></button><view class="card course-summary"><text class="large">{{currentCourse.name}}</text><text class="pill">{{currentCourse.category}} · 共{{progress.total}}节</text><view class="row"><text>已完成 <text class="brown strong">{{progress.completed}}</text> / {{progress.total}} 节</text><text class="link">{{progress.percent}}%</text></view><view class="progress-track"><view style="width:{{progress.percent}}%"/></view><button class="row inset" data-handler="continueCourse" bindtap="continueCourse"><text class="brown">◷</text><text class="grow hint">上次学到：第{{progress.current+1}}节 {{progress.chapter}}</text><text class="arrow">›</text></button></view>
  <view class="seg"><button wx:for="{{['课程目录','配套资料']}}" wx:key="*this" class="{{courseTab===item?'active':''}}" data-key="courseTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><view wx:if="{{courseTab==='课程目录'}}" class="card chapter-card"><button wx:for="{{chapters}}" wx:key="*this" wx:if="{{index<6||expanded}}" class="row" data-index="{{index}}" data-handler="lesson" bindtap="lesson"><text class="brown number">0{{index+1}}</text><text class="grow">{{item}}</text><view class="chapter-status {{index<=progress.completed?'brown':''}}"><text class="lesson-badge {{index<=progress.completed?'completed':''}}">{{index<progress.completed?'✓':'▶'}}</text><text wx:if="{{index<=progress.completed}}">{{index<progress.completed?'已完成':'待继续'}}</text></view></button><button class="hint center" data-handler="expand" bindtap="expand">{{expanded?'收起':'展开全部'+progress.total+'节'}} ﹀</button></view><view class="card compact"><view class="heading">配套资料</view><button class="row inset" data-id="{{currentCourse.id==='engineering'?'brief':'script'}}" data-handler="previewResource" bindtap="previewResource"><image class="row-icon" src="/pages/account/assets/file.jpg"/><text class="grow">{{currentCourse.id==='engineering'?'乡墅开工交底清单':'短视频选题与文案模板'}}</text><text class="arrow">›</text></button></view><view class="page-actions"><button class="solid bottom-inline" data-handler="continueCourse" bindtap="continueCourse">{{progress.completed===progress.total?'回顾课程':'继续学习第'+(progress.current+1)+'节'}}</button></view>
 </block>
 <block wx:elif="{{view==='messages'}}"><view class="seg"><button wx:for="{{messageTabs}}" wx:key="*this" class="{{messageTab===item?'active':''}}" data-key="messageTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><button class="read-all" data-handler="readAll" bindtap="readAll">☑ 全部已读</button><button wx:for="{{messages}}" wx:key="id" class="card message" data-id="{{item.id}}" data-handler="read" bindtap="read"><view class="unread {{item.read?'read':''}}"/><view class="message-symbol"><image src="{{item.type==='学习'?'/assets/graduate.png':item.route==='personal-performance'?'/assets/account-chart.jpg':item.type==='系统'?'/assets/book.png':'/assets/person-filled.png'}}" mode="aspectFit"/></view><view class="grow"><text class="strong">{{item.title}}</text><text class="hint">{{item.description}}</text><text class="hint time">{{item.date}}</text></view><text class="pill">{{item.route==='course'?'继续学习':'查看详情'}} ›</text></button><text wx:if="{{!messages.length}}" class="empty">暂无此类消息</text><text class="divider">仅展示与你相关的消息 · 2026-10-18快照</text></block>
 <block wx:elif="{{view==='help'}}"><view class="seg"><button wx:for="{{['提交反馈','我的反馈']}}" wx:key="*this" class="{{feedbackTab===item?'active':''}}" data-key="feedbackTab" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><block wx:if="{{feedbackTab==='提交反馈'}}"><view class="card"><view class="heading">客服与帮助</view><view class="two-grid"><button class="inset row" data-key="contact" data-handler="notice" bindtap="notice"><image class="row-icon" src="/assets/account-headset.jpg"/>在线客服 ›</button><button class="inset row" data-key="faq" data-handler="notice" bindtap="notice"><image class="row-icon" src="/pages/account/assets/file.jpg"/>常见问题 ›</button></view></view><view class="card"><view class="heading">问题反馈</view><view class="seg"><button wx:for="{{['使用问题','功能建议','其他']}}" wx:key="*this" class="{{feedbackType===item?'active':''}}" data-key="feedbackType" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view><text class="field-title">问题描述</text><textarea class="textarea feedback-text" placeholder="请描述遇到的问题" maxlength="300" value="{{form.feedback}}" data-key="feedback" bindinput="input"/><text class="counter">{{form.feedback.length||0}}/300</text><text class="field-title">截图上传</text><view class="photo-list"><button wx:for="{{form.screenshots}}" wx:key="*this" data-key="screenshots" data-index="{{index}}" data-handler="removePhoto" bindtap="removePhoto"><image src="{{item}}" mode="aspectFill"/><text>×</text></button><button class="upload" data-key="screenshots" data-handler="photo" bindtap="photo"><text>＋</text>添加截图</button></view><text class="hint">{{form.screenshots.length||0}}/3</text><text class="field-title">联系方式</text><input class="input" type="number" maxlength="11" placeholder="{{maskedPhone}}" value="{{form.contact}}" data-key="contact" bindinput="input"/><text class="hint">ⓘ 请勿上传密码等敏感信息。</text></view><view class="page-actions"><button class="solid bottom-inline" data-handler="submitFeedback" bindtap="submitFeedback">提交反馈</button></view></block><block wx:else><view wx:for="{{feedbacks}}" wx:key="id" class="card"><text class="strong">{{item.type}} · {{item.status}}</text><text class="body-text">{{item.text}}</text><text class="hint">{{item.date}}</text></view><view wx:if="{{!feedbacks.length}}" class="card empty">暂无反馈记录</view></block></block>
 <block wx:elif="{{view==='privacy'}}"><view class="card"><view class="heading">账号绑定</view><button class="row" data-key="binding" data-handler="notice" bindtap="notice"><image class="symbol-image" src="/pages/account/assets/privacy-phone.jpg" mode="aspectFit"/><view class="grow"><text>手机号</text><text class="hint">{{maskedPhone}}</text></view><text class="arrow">›</text></button><button class="row" data-key="binding" data-handler="notice" bindtap="notice"><image class="symbol-image" src="/pages/account/assets/privacy-wechat.jpg" mode="aspectFit"/><view class="grow"><text>微信</text><text class="hint">已绑定（示例）</text></view><text class="arrow">›</text></button></view><view class="card"><view class="heading">隐私与协议</view><button wx:for="{{[{name:'个人信息使用说明',view:'policy'},{name:'隐私政策',view:'policy'},{name:'用户协议',view:'agreement'},{name:'隐私授权管理',view:'permissions'}]}}" wx:key="name" class="row" data-view="{{item.view}}" data-handler="go" bindtap="go"><image class="row-icon" src="/pages/account/assets/{{index===0?'privacy-doc':index===1?'privacy-shield':index===2?'privacy-agreement':'privacy-permission'}}.jpg"/><text class="grow">{{item.name}}</text><text class="arrow">›</text></button></view><view class="card"><view class="heading">账号管理</view><button class="row" data-view="devices" data-handler="go" bindtap="go"><image class="symbol-image" src="/pages/account/assets/privacy-device.jpg" mode="aspectFit"/><text class="grow">登录设备</text><text class="arrow">›</text></button><button class="row" data-key="delete" data-handler="notice" bindtap="notice"><image class="symbol-image" src="/pages/account/assets/privacy-delete.jpg" mode="aspectFit"/><text class="grow">注销账号</text><text class="arrow">›</text></button><text class="hint">当前账号：{{profile.name}}</text></view></block>
