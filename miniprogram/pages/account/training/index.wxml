<account-header title="{{title}}" statusHeight="{{statusHeight}}" />
<view class="training-shell" style="padding-top:{{statusHeight+54}}px">
 <view wx:if="{{error}}" class="error-note"><text>{{error}}</text><button bindtap="refresh">重试加载</button></view>
 <view wx:if="{{loading}}" class="empty-state">正在加载课程…</view>
 <block wx:elif="{{!courseId&&!course}}">
  <input class="training-search" placeholder="搜索课程、资料" value="{{keyword}}" bindinput="search" />
  <view class="training-tabs"><button wx:for="{{['课程','资料']}}" wx:key="*this" class="{{tab===item?'active':''}}" data-value="{{item}}" bindtap="tab">{{item}}</button></view>
  <text class="role-note">当前岗位：{{roleLabel}}</text>
  <scroll-view class="category-strip" scroll-x><button wx:for="{{categories}}" wx:key="*this" class="{{category===item?'active':''}}" data-value="{{item}}" bindtap="category">{{item}}</button></scroll-view>
  <block wx:if="{{tab==='课程'}}"><view wx:if="{{resumeCourse}}" class="learning-section"><view class="section-title">{{resumeCourse.completed?'继续学习':'开始岗位学习'}}</view><button class="resume-row" data-id="{{resumeCourse.id}}" bindtap="openCourse"><image src="{{resumeCourse.image}}" mode="aspectFill"/><view class="course-copy"><text class="course-name">{{resumeCourse.title}}</text><text class="course-meta">已完成 {{resumeCourse.completed}}/{{resumeCourse.lessons}} 节 · {{resumeCourse.percent}}%</text><view class="progress-track"><view style="width:{{resumeCourse.percent}}%"/></view><text class="continue-action">{{resumeCourse.completed?'继续学习':'开始学习'}}</text></view></button></view><view class="learning-section"><view class="section-title">岗位推荐</view><button wx:for="{{visibleCourses}}" wx:key="id" class="course-row" data-id="{{item.id}}" bindtap="openCourse"><image src="{{item.image}}" mode="aspectFill"/><view class="course-copy"><text class="course-name">{{item.title}}</text><text class="course-meta">{{item.category}} · {{item.lessons}}节</text><text wx:if="{{item.completed}}" class="course-meta">已完成 {{item.percent}}%</text></view><image class="arrow-icon" src="/assets/creation-back.png"/></button><text wx:if="{{coursesEmpty}}" class="empty-state">{{keyword?'暂无匹配课程，试试其他关键词':'当前岗位暂无已开放课程'}}</text></view></block>
  <view wx:else class="learning-section"><view class="section-title">岗位资料</view><view wx:for="{{visibleResources}}" wx:key="rowKey" class="resource-row"><image class="file-icon" src="/pages/account/assets/file.jpg"/><view class="resource-copy"><text class="course-name">{{item.name}}</text><text class="course-meta">{{item.extension}} · V{{item.version}} · {{item.courseTitle}}</text><view class="resource-actions"><button wx:if="{{item.preview}}" data-id="{{item.versionId}}" data-course="{{item.courseId}}" data-ext="{{item.extension}}" bindtap="resource">预览</button><button wx:if="{{item.download}}" data-id="{{item.versionId}}" data-course="{{item.courseId}}" data-ext="{{item.extension}}" data-download="{{true}}" bindtap="resource">下载原件</button></view></view></view><text wx:if="{{resourcesEmpty}}" class="empty-state">暂无可查看的资料</text></view>
 </block>
 <block wx:elif="{{course}}">
  <view class="player-area"><video wx:if="{{mediaUrl&&!document&&activeLesson.extension!=='mp3'&&activeLesson.extension!=='m4a'}}" id="training-video" src="{{mediaUrl}}" initial-time="{{startPosition}}" autoplay controls show-mute-btn bindtimeupdate="timeupdate" bindpause="paused" bindended="ended" binderror="playbackError" /><view wx:elif="{{mediaUrl&&!document}}" class="audio-player"><text>{{activeLesson.title}}</text><text>{{audioPosition||'0:00'}} / {{activeLesson.durationText}}</text><button bindtap="toggleAudio">{{audioPlaying?'暂停音频':'播放音频'}}</button></view><button wx:else class="player-placeholder" loading="{{busy}}" bindtap="startLesson"><image src="/assets/account-course.jpg" mode="aspectFill"/><text>{{document?'重新打开讲义':'开始学习本节'}}</text></button></view>
  <view class="course-heading"><text class="detail-title">{{course.title}}</text><text class="course-meta">{{course.category}} · 共{{course.lessons.length}}节 · 已完成{{course.percent}}%</text><view class="progress-track"><view style="width:{{course.percent}}%"/></view><text wx:if="{{course.objective}}" class="objective">{{course.objective}}</text></view>
  <view class="training-tabs"><button wx:for="{{['目录','配套资料']}}" wx:key="*this" class="{{courseTab===item?'active':''}}" data-value="{{item}}" bindtap="courseTab">{{item}}</button></view>
  <view wx:if="{{courseTab==='目录'}}" class="lesson-section"><block wx:for="{{course.lessons}}" wx:key="id"><text wx:if="{{index===0||course.lessons[index-1].chapter!==item.chapter}}" class="chapter-label">{{item.chapter}}</text><button class="lesson-row {{activeLesson.id===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="selectLesson"><text class="lesson-number">{{index+1}}</text><text class="lesson-name">{{item.title}}</text><text class="lesson-duration">{{item.durationText}}</text><text class="lesson-state {{item.completed?'completed':''}}">{{item.completed?'已完成':activeLesson.id===item.id?'学习中':'待学习'}}</text></button></block></view>
  <view class="learning-section"><view class="section-title">{{courseTab==='目录'?'本节资料':'配套资料'}}</view><view wx:for="{{courseTab==='目录'?activeLesson.attachments:course.allAttachments}}" wx:key="versionId" class="resource-row"><image class="file-icon" src="/pages/account/assets/file.jpg"/><view class="resource-copy"><text class="course-name">{{item.name}}</text><text class="course-meta">{{item.extension}} · V{{item.version}}</text><view class="resource-actions"><button wx:if="{{item.preview}}" data-id="{{item.versionId}}" data-ext="{{item.extension}}" bindtap="resource">预览</button><button wx:if="{{item.download}}" data-id="{{item.versionId}}" data-ext="{{item.extension}}" data-download="{{true}}" bindtap="resource">下载原件</button></view></view></view><text wx:if="{{courseTab==='目录'&&!activeLesson.attachments.length||courseTab==='配套资料'&&!course.allAttachments.length}}" class="empty-state">暂无{{courseTab==='目录'?'本节':'课程'}}资料</text></view>
  <view class="fixed-action"><button wx:if="{{document}}" class="primary" disabled="{{!readAllowed||busy}}" bindtap="confirmRead">{{readAllowed?'确认已读':'阅读至少30秒后可确认已读'}}</button><button wx:else class="primary" loading="{{busy}}" bindtap="startLesson">{{activeLesson.completed?'回顾本节':'继续学习：'+activeLesson.title}}</button></view>
 </block>
</view>
