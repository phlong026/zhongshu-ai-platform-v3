@import "../../../styles/tokens.wxss";
page{background:var(--zs-bg);color:var(--zs-text)}button::after{border:0}button{line-height:1.5;margin:0;text-align:left;font-weight:400} .training-shell{padding:0 28rpx 190rpx;min-height:100vh;box-sizing:border-box}.training-search{height:82rpx;box-sizing:border-box;padding:0 24rpx;background:#f2eee7;border-radius:14rpx;font-size:28rpx;margin:20rpx 0}.training-tabs{display:flex;gap:8rpx;background:#f3eee7;border-radius:14rpx;padding:6rpx;margin:18rpx 0}.training-tabs button{flex:1;text-align:center;padding:19rpx 8rpx;background:transparent;color:var(--zs-text-2);font-size:28rpx}.training-tabs .active{background:white;color:var(--zs-brand);font-weight:600;border-radius:10rpx}.role-note{display:block;font-size:24rpx;color:var(--zs-text-2);margin:20rpx 0}.category-strip{white-space:nowrap;margin:20rpx 0}.category-strip button{display:inline-block;padding:12rpx 24rpx;font-size:24rpx;background:#f3eee7;color:var(--zs-text-2);border-radius:10rpx;margin-right:12rpx}.category-strip .active{background:#f3e3cc;color:var(--zs-brand)}.learning-section{background:#fff;padding:24rpx;border-radius:18rpx;margin:24rpx 0}.section-title{font-size:32rpx;font-weight:600;margin-bottom:22rpx}.resume-row,.course-row{display:flex;align-items:center;gap:22rpx;width:100%;padding:18rpx 0;background:transparent}.resume-row image{width:240rpx;height:172rpx;border-radius:12rpx;flex-shrink:0}.course-row>image{width:200rpx;height:126rpx;border-radius:10rpx;flex-shrink:0}.course-copy{flex:1;min-width:0}.course-name{display:block;font-size:28rpx;line-height:1.5;font-weight:600;overflow-wrap:anywhere}.course-meta{display:block;font-size:23rpx;line-height:1.6;color:var(--zs-text-2);margin-top:8rpx}.progress-track{height:8rpx;background:#eee8df;border-radius:6rpx;margin:18rpx 0;overflow:hidden}.progress-track view{height:100%;background:var(--zs-success);border-radius:6rpx}.continue-action{display:block;background:var(--zs-brand);color:white;border-radius:10rpx;padding:10rpx 18rpx;text-align:center;font-size:24rpx;margin-top:16rpx}.course-row+.course-row{border-top:1rpx solid var(--zs-line)}.course-row>.arrow-icon{width:24rpx;height:24rpx;transform:rotate(180deg);object-fit:contain}.empty-state{display:block;padding:32rpx 0;text-align:center;color:var(--zs-text-2);font-size:26rpx;line-height:1.8}.resource-row{display:flex;align-items:flex-start;gap:18rpx;border-bottom:1rpx solid var(--zs-line);padding:22rpx 0}.file-icon{width:56rpx;height:64rpx;flex-shrink:0}.resource-copy{flex:1;min-width:0}.resource-actions{display:flex;gap:20rpx;margin-top:10rpx}.resource-actions button{background:transparent;color:var(--zs-brand);font-size:24rpx;padding:12rpx 8rpx;min-height:64rpx}.player-area{margin:22rpx -28rpx}.player-area video{width:100%;height:422rpx}.player-area audio{display:block;width:100%}.player-placeholder{position:relative;width:100%;height:390rpx;padding:0;background:#eee8df;text-align:center}.player-placeholder image{width:100%;height:100%;filter:brightness(.7)}.player-placeholder text{position:absolute;left:0;right:0;top:44%;color:white;font-weight:600;font-size:32rpx}.course-heading{padding:10rpx 0 20rpx}.detail-title{font-size:38rpx;font-weight:600;display:block;line-height:1.5}.objective{display:block;color:var(--zs-text-2);font-size:25rpx;line-height:1.8;margin-top:20rpx}.lesson-section{background:#fff;padding:12rpx 18rpx;border-radius:14rpx}.chapter-label{display:block;font-size:26rpx;font-weight:600;margin:20rpx 0 10rpx;color:var(--zs-text-2)}.lesson-row{display:flex;align-items:center;gap:14rpx;background:transparent;width:100%;padding:24rpx 4rpx;border-bottom:1rpx solid var(--zs-line);font-size:26rpx}.lesson-row.selected{background:#faf0df;border-radius:8rpx}.lesson-number{color:var(--zs-brand);min-width:30rpx;text-align:center}.lesson-name{flex:1;min-width:0;line-height:1.6;overflow-wrap:anywhere}.lesson-duration{font-size:22rpx;color:var(--zs-text-2);flex-shrink:0}.lesson-state{font-size:21rpx;color:var(--zs-brand);flex-shrink:0}.lesson-state.completed{color:var(--zs-success)}.fixed-action{position:fixed;bottom:0;left:0;right:0;background:white;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--zs-line);z-index:8}.primary{padding:23rpx 20rpx;text-align:center;font-size:28rpx;background:var(--zs-brand);color:white;border-radius:14rpx}.primary[disabled]{background:#c9bbae;color:white}.error-note{padding:20rpx;background:var(--zs-danger-bg);color:var(--zs-danger);font-size:25rpx;margin:20rpx 0;line-height:1.7;border-radius:12rpx}.error-note button{display:inline-block;background:transparent;font-size:24rpx;color:var(--zs-brand);padding:12rpx}

.audio-player{padding:42rpx 32rpx;background:#f3eee7;display:flex;flex-direction:column;gap:22rpx}.audio-player text{font-size:28rpx}.audio-player button{background:var(--zs-brand);color:white;padding:20rpx;text-align:center;border-radius:12rpx;font-size:28rpx}
