.account,.sheet{font-family:var(--zs-font-family);font-size:var(--zs-font-emphasis);font-weight:400;line-height:40rpx;letter-spacing:0}
.account button,.account input,.account textarea,.sheet button{font-family:var(--zs-font-family)}
.account .heading,.account .large,.account .chapter-card .number{font-family:var(--zs-font-family);font-weight:600}
.account .heading{font-size:var(--zs-font-title);line-height:46rpx}
.account .strong{font-family:var(--zs-font-family);font-weight:500}
.account .hint{font-size:var(--zs-font-meta);line-height:36rpx}
.account .label{font-size:var(--zs-font-body);line-height:38rpx}
.account .row input,.account .input,.account .textarea{font-size:var(--zs-font-emphasis);line-height:40rpx}
.account .solid,.account .outline,.sheet .solid,.sheet .outline{font-size:var(--zs-font-emphasis);line-height:44rpx;font-weight:500}
.account .seg button{font-size:var(--zs-font-body);line-height:40rpx}
.account .categories button{font-size:var(--zs-font-meta);line-height:34rpx}
.account .link{font-size:var(--zs-font-meta);font-weight:400}
.account .course-row .strong{font-size:var(--zs-font-emphasis);line-height:40rpx}
.account .course-row image{width:288rpx;height:158rpx}
.account .course-row{gap:22rpx;padding:12rpx 0;background:#fbf9f5;border-radius:12rpx;margin-bottom:12rpx}
.account .continue-row{padding:16rpx;margin-bottom:0}
.account .continue-row image{width:244rpx;height:174rpx}
.account .continue-row .progress-track{max-width:267rpx;margin-top:50rpx}
.account .continue-row .pill{right:6rpx;margin-top:40rpx}
.account .course-percent{position:absolute;right:10rpx;bottom:14rpx;font-size:var(--zs-font-caption);line-height:30rpx;color:var(--zs-text-3)}
.account .service-grid .strong{font-size:var(--zs-font-emphasis);line-height:40rpx}
.account .service-grid .hint{font-size:var(--zs-font-meta);line-height:34rpx}
.account .order-row .hint,.account .order-scope .hint{font-size:var(--zs-font-meta);line-height:34rpx}
.account .order-row .pill{font-size:var(--zs-font-caption);line-height:30rpx}
.account .chapter-status{font-size:var(--zs-font-meta);line-height:34rpx}
.account .chapter-card .row{font-size:var(--zs-font-emphasis);line-height:40rpx}
.account .course-summary .large{font-weight:700;line-height:52rpx}
.account .profile-hero>text{font-weight:700;line-height:50rpx}
.account .event{font-size:var(--zs-font-meta);line-height:36rpx}
.account .check-row{font-size:var(--zs-font-meta);line-height:36rpx}
.account .resource-row>text{font-size:var(--zs-font-meta);line-height:34rpx}
.account .resource-row .hint{font-size:var(--zs-font-caption);line-height:32rpx}

.account .profile-field-icon{width:34rpx;height:36rpx;flex-shrink:0}.account .profile-hero .avatar-camera{width:61rpx;height:61rpx;border-radius:50%;position:absolute;right:0;bottom:0}

.account .symbol-image{width:78rpx;height:80rpx;flex-shrink:0;object-fit:contain}.account.view-privacy .row-icon{width:78rpx;height:80rpx}

.wechat-button-icon{width:40rpx;height:40rpx;vertical-align:middle;margin-right:10rpx}

.account.view-privacy .row{min-height:108rpx}
