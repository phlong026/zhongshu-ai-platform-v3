.announcement-page{padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));font-size:var(--zs-font-body);line-height:42rpx}
.announcement-search{display:flex;align-items:center;gap:16rpx;min-height:88rpx;margin-bottom:24rpx;padding:16rpx 22rpx;background:var(--zs-card);border:1rpx solid var(--zs-line);border-radius:var(--zs-control-radius)}
.announcement-search input{flex:1;min-width:0;height:52rpx;font-size:var(--zs-font-body)}
.search-submit,.search-clear{flex-shrink:0;padding:8rpx 0;font-size:var(--zs-font-body);color:var(--zs-brand)}
.search-clear{color:var(--zs-text-3);font-size:var(--zs-font-meta)}
.announcement-card{display:block;width:100%;padding:28rpx 24rpx;margin-bottom:22rpx;background:var(--zs-card);border:1rpx solid var(--zs-line);border-radius:var(--zs-radius);text-align:left}
.announcement-row:active{background:var(--zs-champagne-soft)}
.announcement-heading{display:flex;align-items:flex-start;gap:12rpx}
.announcement-title{flex:1;min-width:0;font-size:var(--zs-font-title);font-weight:600;line-height:46rpx;overflow-wrap:anywhere}
.announcement-heading .chevron{margin-top:16rpx}
.announcement-pin{display:inline-block;flex-shrink:0;padding:2rpx 10rpx;margin-top:4rpx;border-radius:8rpx;background:var(--zs-champagne-soft);color:var(--zs-brand);font-size:var(--zs-font-caption);font-weight:400;line-height:32rpx}
.announcement-summary{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;margin-top:16rpx;color:var(--zs-text-2);line-height:42rpx;overflow-wrap:anywhere}
.announcement-date{display:block;margin-top:18rpx;color:var(--zs-text-3);font-size:var(--zs-font-meta);line-height:34rpx}
.announcement-state{padding:48rpx 24rpx;background:var(--zs-card);border-radius:var(--zs-radius);text-align:center;color:var(--zs-text-3)}
.announcement-error>text{display:block;overflow-wrap:anywhere}
.announcement-actions{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:20rpx;margin-top:24rpx}
.announcement-button{padding:18rpx 28rpx;border:1rpx solid var(--zs-brand);border-radius:var(--zs-control-radius);color:var(--zs-brand);line-height:42rpx}
.announcement-text-button{padding:18rpx 8rpx;color:var(--zs-brand);font-size:var(--zs-font-meta);line-height:38rpx}
.announcement-more{width:100%;padding:20rpx;color:var(--zs-brand);line-height:44rpx}
.announcement-end{display:block;margin-top:28rpx;text-align:center;color:var(--zs-text-3);font-size:var(--zs-font-meta)}
.announcement-detail-title{display:block;margin-top:10rpx;font-size:var(--zs-font-heading);line-height:58rpx;font-weight:600;overflow-wrap:anywhere}
.announcement-content{display:block;margin-top:30rpx;padding-top:28rpx;border-top:1rpx solid var(--zs-line);white-space:pre-wrap;overflow-wrap:anywhere;line-height:48rpx}
