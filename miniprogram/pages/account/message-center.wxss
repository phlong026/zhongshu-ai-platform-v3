.mc{padding-bottom:48rpx}.mc-tabs{margin-bottom:24rpx}.mc-search{display:flex;align-items:center;background:#fff;border:1rpx solid #e9e2da;border-radius:14rpx;padding:4rpx 6rpx 4rpx 22rpx;margin-bottom:20rpx}.mc-search input{flex:1;min-width:0;font-size:26rpx;height:76rpx}.mc-search button{margin:0;padding:0 20rpx;font-size:26rpx;color:#89552f;line-height:68rpx;background:transparent}.mc-filters{display:flex;gap:14rpx}.mc .mc-chip{margin:0;padding:0 24rpx;min-height:64rpx;line-height:64rpx;background:#f0ede8;color:#655e56;font-size:26rpx;border-radius:32rpx}.mc .mc-chip.selected{background:#6d4327;color:#fff}.mc-chip text{margin-left:8rpx;font-size:24rpx}.mc-toolbar{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.mc-module{padding:18rpx 0;font-size:25rpx;color:#5f544a}.mc-toolbar button{margin:0;padding:12rpx 0 12rpx 20rpx;min-height:64rpx;line-height:40rpx;font-size:24rpx;background:none;color:#93603e}.mc-toolbar button[disabled]{color:#b1a79d}.mc-explain{display:block;font-size:23rpx;color:#81766a;margin-bottom:20rpx;line-height:1.6}.mc-card{background:#fff;border:1rpx solid #ece6df;border-radius:22rpx;padding:26rpx 28rpx;margin-bottom:20rpx;overflow:hidden}.mc-card.is-unread{border-left:5rpx solid #b17b4b;padding-left:24rpx}.mc-card-top{display:flex;align-items:center;gap:12rpx;margin-bottom:18rpx}.mc-category{color:#88725e;font-size:23rpx;line-height:1.6}.mc-state{margin-left:auto;border-radius:8rpx;padding:5rpx 12rpx;background:#f3f1ed;color:#7c7166;font-size:22rpx}.mc-state.todo{color:#8d4c1c;background:#fff0db}.mc-state.exception{background:#fff0eb;color:#ae4934}.mc-dot{height:10rpx;width:10rpx;border-radius:50%;background:#b17b4b;flex-shrink:0}.mc-subject{display:block;font-size:34rpx;font-weight:600;color:#30271f;line-height:1.45;margin-bottom:8rpx;overflow-wrap:anywhere}.mc-title{display:block;font-size:28rpx;color:#50483f;line-height:1.6;margin-bottom:16rpx}.mc-amount{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin:14rpx 0 18rpx}.mc-amount text:first-child{font-size:24rpx;color:#887c70}.mc-amount text:last-child{font-size:34rpx;font-weight:600;color:#744623}.mc-field{display:flex;gap:24rpx;font-size:25rpx;line-height:1.7;margin:8rpx 0}.mc-field text:first-child{color:#8b8075;flex-shrink:0;max-width:168rpx}.mc-field text:last-child{color:#53493e;flex:1;min-width:0;overflow-wrap:anywhere;text-align:right}.mc-number,.mc-description{display:block;overflow-wrap:anywhere;font-size:23rpx;line-height:1.65;color:#9a8e82;margin:12rpx 0}.mc-description{color:#756b60;font-size:25rpx}.mc-notice{background:#faf4e9;border-radius:10rpx;color:#8b6944;font-size:23rpx;line-height:1.6;padding:14rpx 18rpx;margin:16rpx 0}.mc-card-bottom{display:flex;align-items:flex-end;gap:18rpx;border-top:1rpx solid #f0ece7;margin-top:20rpx;padding-top:18rpx}.mc-foot{flex:1;min-width:0;font-size:22rpx;line-height:1.6;color:#998c7e}.mc-foot text{display:block;overflow-wrap:anywhere}.mc .mc-action{margin:0;flex-shrink:0;max-width:250rpx;padding:0 20rpx;background:#f8efe5;color:#8b542d;border-radius:12rpx;line-height:64rpx;min-height:64rpx;font-size:24rpx;font-weight:500}.mc .mc-action.primary{color:#fff;background:#855a38}.mc-detail-link{font-size:23rpx;color:#937251;flex-shrink:0;line-height:48rpx}.mc-empty{padding:90rpx 20rpx;text-align:center;color:#8d8175;font-size:28rpx}.mc-empty text{display:block;line-height:2}.mc-empty text+text{font-size:24rpx;color:#a09385}.mc-error,.mc-warning{font-size:25rpx;line-height:1.6;color:#a2523d;background:#fff1e9;padding:20rpx;border-radius:12rpx;margin-bottom:20rpx}.mc-error button{font-size:24rpx;background:transparent;color:#a2523d}.mc-warning text{display:block;text-decoration:underline;margin-top:8rpx}.mc-mask{position:fixed;inset:0;background:rgba(35,27,20,.4);z-index:80}.mc-sheet{position:fixed;left:0;right:0;bottom:0;z-index:81;background:#fffaf5;border-radius:28rpx 28rpx 0 0;padding:28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom))}.mc-sheet-head{display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600;margin-bottom:24rpx}.mc-sheet-head button{margin:0;padding:0 18rpx;line-height:64rpx;font-size:26rpx;background:transparent;color:#856043}.mc-sheet-body{max-height:64vh}.mc-sheet .solid{margin-top:24rpx}.mc-sheet .mc-category{display:block;margin-bottom:16rpx}
