<view class="page workbench-page sales-page sales-profile-page"><view class="workbench-header"><brand-header title="我的" divider/></view><view class="content">
 <view class="section sales-profile-hero"><button class="sales-profile-person" data-action="profile" bindtap="open"><image class="sales-profile-avatar" src="{{avatar}}" mode="aspectFill"/><view><text class="sales-profile-name">{{name}}</text><text class="hint">{{company}}</text><text class="sales-profile-role">{{role}}</text></view><text class="sales-profile-edit">个人资料</text><view class="chevron"/></button><view class="sales-profile-quick"><button data-action="messages" bindtap="open"><image src="/assets/account-message.jpg"/><text>消息通知</text><text class="sales-profile-count">{{unread}}</text><view class="chevron"/></button><button data-action="performance" bindtap="open"><image src="/assets/account-chart.jpg"/><text>我的绩效</text><view class="chevron"/></button></view></view>
 <view class="section"><view class="section-heading"><text class="section-title">众墅学堂</text><button class="text-link" data-action="learning" bindtap="open">全部课程<view class="chevron"/></button></view><button class="sales-profile-course" data-action="course" bindtap="open"><image src="{{courseImage}}" mode="aspectFill"/><view><text class="sales-profile-course-tag">学习进度</text><text>AI短视频获客实战</text><text class="hint">已学{{progress.completed}}/{{progress.total}}节</text><view class="sales-profile-progress"><view style="width:{{progress.percent}}%"/></view><text class="sales-profile-continue">继续学习</text></view></button><view class="sales-profile-learning"><button class="sales-profile-learning-action" data-action="resources" bindtap="open"><text>学习资料</text><view class="chevron"/></button><button class="sales-profile-learning-action" data-action="learning" bindtap="open"><text>课程中心</text><view class="chevron"/></button></view></view>
 <view class="section sales-profile-services"><view class="section-heading"><text class="section-title">账号与服务</text></view><button class="sales-profile-row" data-action="identity" bindtap="open"><image src="/assets/account-shop.jpg"/><text>组织与身份</text><view class="chevron"/></button><button class="sales-profile-row" data-action="help" bindtap="open"><image src="/assets/account-headset.jpg"/><text>帮助与反馈</text><view class="chevron"/></button><button class="sales-profile-row" data-action="privacy" bindtap="open"><image src="/assets/account-shield.jpg"/><text>账号与隐私</text><view class="chevron"/></button></view>
 </view></view><workspace-nav id="sales-profile-nav" active-index="{{4}}" nested/>
