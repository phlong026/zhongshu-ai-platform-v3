@import "../../../styles/workbench.wxss";
@import "../../../styles/sales.wxss";
.sales-page.sales-page .sales-profile-hero{padding:28rpx 24rpx;background:#f4e9d9;border:1rpx solid #e5d4bd}.sales-profile-person{display:flex;align-items:center;gap:18rpx;width:100%;text-align:left}.sales-profile-avatar{width:104rpx;height:104rpx;border-radius:50%;border:3rpx solid #fff;flex-shrink:0}.sales-profile-person>view:not(.chevron){flex:1;min-width:0}.sales-profile-person>view>text{display:block}.sales-profile-name{font-size:34rpx;font-weight:600;line-height:48rpx}.sales-profile-role{display:inline-flex!important;padding:0 12rpx;margin-top:8rpx;background:#fff8ef;color:#89512a;border-radius:8rpx;font-size:22rpx;line-height:34rpx}.sales-profile-edit{font-size:22rpx;color:#89512a}.sales-profile-quick{display:flex;margin-top:26rpx;padding-top:22rpx;border-top:1rpx solid #e4d6c4}.sales-profile-quick>button{display:flex;align-items:center;gap:12rpx;flex:1;font-size:26rpx;text-align:left}.sales-profile-quick>button+button{border-left:1rpx solid #e4d6c4;padding-left:24rpx}.sales-profile-quick image{width:36rpx;height:36rpx}.sales-profile-quick .chevron{margin-left:auto;margin-right:12rpx}.sales-profile-count{color:#89512a;font-size:24rpx}.sales-profile-course{display:flex;align-items:center;gap:22rpx;width:100%;text-align:left}.sales-profile-course>image{width:200rpx;height:200rpx;border-radius:16rpx;flex-shrink:0}.sales-profile-course>view{flex:1;min-width:0}.sales-profile-course>view>text{display:block;font-size:28rpx;line-height:42rpx}.sales-profile-course>view>text.sales-profile-course-tag{font-size:22rpx;line-height:34rpx;color:#89512a;margin-bottom:6rpx}.sales-profile-course .sales-profile-continue{font-size:24rpx;color:#89512a;margin-top:12rpx}.sales-profile-progress{width:100%;height:8rpx;background:#eee5d9;border-radius:8rpx;margin-top:12rpx;overflow:hidden}.sales-profile-progress>view{height:100%;background:#89512a;border-radius:8rpx}.sales-profile-learning{display:flex;border-top:1rpx solid #eee8df;margin-top:24rpx;padding-top:18rpx;gap:20rpx}.sales-profile-learning>button{display:flex;align-items:center;gap:12rpx;flex:1;font-size:24rpx;min-height:56rpx}.sales-profile-learning>button+button{border-left:1rpx solid #eee8df;padding-left:24rpx}.sales-profile-row{display:flex;align-items:center;gap:18rpx;width:100%;padding:23rpx 0;border-bottom:1rpx solid #eee8df;text-align:left;font-size:28rpx}.sales-profile-row:last-child{border:0;padding-bottom:8rpx}.sales-profile-row>image{width:38rpx;height:38rpx}.sales-profile-row>text{flex:1}
