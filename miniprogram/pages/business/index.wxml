<view class="page business-page workbench-page {{isSalesHome?'sales-page':''}}">
  <view class="workbench-header"><brand-header divider="{{true}}" account-font="{{!isSalesHome}}" id="business-workbench-header" title="{{isSalesHome?'首页':deskTitle||'业务工作台'}}" /></view>
  <view wx:if="{{isSalesHome}}" class="content sales-home-content">
    <view class="sales-greeting"><text>你好，{{salesName}}</text><text class="hint">{{salesDate}}</text></view>
    <view class="sales-summary"><view class="sales-stats"><button class="sales-stat sales-stat-total" data-focus="all" bindtap="openSalesMetric" hover-class="pressed" aria-label="查看全部客户"><view class="sales-stat-top"><image src="/assets/person-filled.png" mode="aspectFit"/><image class="sales-stat-arrow" src="/assets/creation-chevron-muted.png"/></view><text class="sales-stat-label">总客户</text><view class="sales-stat-number"><text class="sales-stat-value">{{salesCounts.all}}</text><text class="sales-stat-unit">人</text></view></button><button class="sales-stat" data-focus="due" bindtap="openSalesMetric" hover-class="pressed" aria-label="查看今日待跟进客户"><view class="sales-stat-top"><image src="/assets/studio-clock.png" mode="aspectFit"/><image class="sales-stat-arrow" src="/assets/creation-chevron-muted.png"/></view><text class="sales-stat-label">今日待跟进</text><view class="sales-stat-number"><text class="sales-stat-value">{{todayCount}}</text><text class="sales-stat-unit">人</text></view></button><button class="sales-stat" data-focus="appointments" bindtap="openSalesMetric" hover-class="pressed" aria-label="查看预约到店客户"><view class="sales-stat-top"><image src="/assets/home-design-icon.png" mode="aspectFit"/><image class="sales-stat-arrow" src="/assets/creation-chevron-muted.png"/></view><text class="sales-stat-label">预约到店</text><view class="sales-stat-number"><text class="sales-stat-value">{{appointmentCount}}</text><text class="sales-stat-unit">人</text></view></button></view></view>
    <view class="section sales-today"><view class="section-heading"><text class="section-title">待我办理 {{flowPending.length}}</text></view><view wx:for="{{flowPending}}" wx:key="id" class="sales-task"><view class="sales-task-heading"><text class="sales-task-name">{{item.name}}</text></view><text class="hint">{{item.state}}</text><button class="primary sales-task-action" data-id="{{item.id}}" bindtap="openFlowTask">{{item.action}}</button></view><view wx:if="{{!flowPending.length}}" class="sales-empty">当前没有需要本人办理的事项。</view></view>
    <view wx:if="{{flowWaiting.length}}" class="section"><view class="section-heading"><text class="section-title">办理中 {{flowWaiting.length}}</text></view><view wx:for="{{flowWaiting}}" wx:key="id" class="sales-task"><text class="sales-task-name">{{item.name}}</text><text class="hint">{{item.state}}</text><text wx:if="{{item.owner}}" class="hint">当前办理：{{item.owner}}</text><button class="outline sales-task-action" data-id="{{item.id}}" bindtap="openFlowTask">{{item.action}}</button></view></view>
    <view class="section"><view class="section-heading"><text class="section-title">常用功能</text></view><view class="sales-home-tools"><button wx:for="{{salesShortcuts}}" wx:key="action" data-action="{{item.action}}" bindtap="openSalesShortcut"><image src="/assets/{{item.icon}}.png" mode="aspectFit" /><text>{{item.title}}</text></button></view></view>
    <view class="section sales-recent"><view class="section-heading"><text class="section-title">最近办理</text></view><button wx:if="{{recentCustomer}}" class="sales-recent-row" bindtap="continueSalesCustomer"><view class="sales-person-initial">{{recentCustomer.initial}}</view><view class="sales-recent-copy"><text>{{recentCustomer.name}}</text><text class="hint">{{recentCustomer.stage}}</text></view><text class="sales-recent-action">继续办理</text><view class="chevron" /></button><button wx:if="{{recentCreation}}" class="sales-recent-row" bindtap="continueSalesCreation"><image src="{{recentCreation.image}}" mode="aspectFill"/><view class="sales-recent-copy"><text>{{recentCreation.title}}</text><text class="hint">{{recentCreation.badge}}</text></view><text class="sales-recent-action">继续创作</text><view class="chevron" /></button><view wx:if="{{!recentCustomer&&!recentCreation}}" class="sales-empty">登记客户或开始创作后，可在这里继续办理。</view></view>
    <view wx:if="{{staffTodos.length}}" class="section"><view class="section-heading"><text class="section-title">岗位待办</text></view><button wx:for="{{staffTodos}}" wx:key="key" class="sales-recent-row" data-view="{{item.view}}" data-id="{{item.id}}" data-area="{{item.area}}" data-record="{{item.record}}" bindtap="goAdmin"><view class="sales-recent-copy"><text>{{item.name}}</text><text class="hint">{{item.status}}</text></view><view class="chevron" /></button></view>
  </view>
  <view wx:else class="content"><view wx:if="{{!canBusiness}}" class="section workbench-denied"><text class="section-title">{{active?'当前身份无业务办理权限':'登录后查看业务工作台'}}</text><text>客户跟进、设计和移交按岗位分工办理。请使用本人已授权的工作台。</text><button wx:if="{{active}}" class="primary return-workbench" data-tab="{{homeTab}}" bindtap="goTab">返回{{homeTitle}}</button><button wx:else class="primary" data-action="login" bindtap="openAction">登录后继续</button></view><block wx:else>
    <view class="search-box"><image src="/assets/search.png" class="search-icon" /><input placeholder="搜索客户、项目或方案" placeholder-class="search-placeholder" value="{{keyword}}" bindinput="search" confirm-type="search" /></view>
    <view class="section todo-section">
      <view class="section-heading"><text class="section-title">客户跟进</text><button wx:if="{{canSalesWrite}}" class="primary" data-action="customer" bindtap="openAction" hover-class="pressed"><text class="plus">＋</text>客户</button></view>
      <view class="customer-card">
        <view wx:for="{{filteredCustomers}}" wx:key="id" class="customer-row">
          <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view class="customer-info"><text class="customer-name">{{item.name}}</text><text class="customer-desc">{{item.desc}}</text></view>
          <button class="outline" data-action="{{item.action}}" data-customer="{{item.id}}" bindtap="openAction" hover-class="pressed">{{item.button}}</button>
        </view>
        <view wx:if="{{!filteredCustomers.length}}" class="empty">当前没有需要本人办理的事项</view>
        <button wx:if="{{canBrowseCustomers}}" class="customer-footer" data-action="customers" bindtap="openAction">{{isDesign?'设计任务列表':'客户与预约'}}<view class="chevron" /></button>
      </view>
    </view>
    <view wx:if="{{canCreate}}" class="section video-section">
      <view class="section-heading"><text class="section-title">视频创作</text><button class="text-link" data-action="works" bindtap="openAction">我的作品<view class="chevron" /></button></view>
      <view class="video-content">
        <button class="video-preview" data-action="works" bindtap="openAction" hover-class="pressed"><image src="/assets/business-video.jpg" mode="aspectFill" /></button>
        <view class="creation-actions"><button wx:for="{{creation}}" wx:key="action" class="creation-action" data-action="{{item.action}}" bindtap="openAction" hover-class="pressed"><image class="creation-icon" src="/assets/{{item.icon}}.png" mode="aspectFit" /><text>{{item.title}}</text><view class="chevron" /></button></view>
      </view>
    </view>
    <view wx:if="{{canSalesWrite}}" class="section design-section">
      <view class="section-heading"><text class="section-title">方案设计</text><button class="primary" data-action="autonomous" bindtap="openAction" hover-class="pressed"><text class="plus">＋</text>自主设计</button></view>
      <view class="design-cards">
        <button class="design-card" data-action="planSearch" bindtap="openAction" hover-class="pressed"><image src="/assets/plan-search-cover.jpg" mode="aspectFill" /><view class="design-caption"><text>户型检索</text><view class="chevron" /></view></button>
        <button class="design-card" data-action="plan" bindtap="openAction" hover-class="pressed"><image src="/assets/floor-plan.png" mode="aspectFill" /><view class="design-caption"><text>平面方案</text><view class="chevron" /></view></button>
        <button class="design-card" data-action="facade" bindtap="openAction" hover-class="pressed"><image src="/assets/facade.jpg" mode="aspectFill" /><view class="design-caption"><text>立面方案</text><view class="chevron" /></view></button>
        <button class="design-card" data-action="budget" bindtap="openAction" hover-class="pressed"><image src="/assets/quote-estimate-cover.jpg" mode="aspectFill" /><view class="design-caption"><text>参考预算</text><view class="chevron" /></view></button>
      </view>
    </view>
    <view wx:if="{{staffTodos.length}}" class="section"><text class="section-title">审批待办</text><button wx:for="{{staffTodos}}" wx:key="key" class="customer-footer" data-view="{{item.view}}" data-id="{{item.id}}" data-area="{{item.area}}" data-record="{{item.record}}" bindtap="goAdmin">{{item.name}} · {{item.status}} ›</button></view><button wx:if="{{!active}}" class="primary guest-login-button" data-action="login" bindtap="openAction">登录后查看本人工作台</button><button wx:if="{{showServices}}" class="customer-footer" data-action="serviceOrders" bindtap="openAction">门店服务订单 ›</button>
  </block></view>
</view>
<action-panel workbench="{{true}}" id="dashboard-action-panel" panel="{{panel}}" bindclose="closePanel" bindsubmit="submitPanel" />
