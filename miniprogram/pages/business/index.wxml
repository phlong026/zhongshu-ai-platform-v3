<template name="businessTodos">
  <view wx:if="{{!guest&&platformTodos&&platformTodos.status!=='idle'}}" class="section platform-todos-section">

    <view class="business-todo-content">
      <text wx:if="{{platformTodos.warning}}" class="hint">{{platformTodos.warning}}</text>
      <block wx:if="{{platformTodos.status==='loading'}}"><text class="hint">待办加载中…</text></block>
      <block wx:elif="{{platformTodos.status==='degraded'}}"><text class="hint">{{platformTodos.message||'待办暂时无法加载'}}</text><button class="text-link" bindtap="retryPlatformTodos">重新加载<view class="chevron" /></button></block>
      <block wx:elif="{{platformTodos.status==='partial-empty'}}"><text class="hint">已加载部分暂无待办</text><button class="text-link" bindtap="retryPlatformTodos">重新加载<view class="chevron" /></button></block>
      <block wx:else><todo-preview appearance="home" id="today-todos" rows="{{platformTodos.rows}}" scope="{{platformTodos.postKey}}" bind:activate="openPlatformTodo"/></block>
    </view>
  </view>
</template>
<view class="wb-root page business-page workbench-page {{isSalesHome?'sales-page':''}}">
  <view class="workbench-header"><brand-header divider="{{true}}" account-font="{{!isSalesHome}}" id="business-workbench-header" title="{{isSalesHome?'业务工作台':deskTitle||'业务工作台'}}" /></view>
  <view wx:if="{{isSalesHome}}" class="content sales-home-content wb-content">
    <view class="sales-greeting wb-greeting"><text>你好，{{salesName}}</text></view>
    <home-overview id="role-overview" role="business"/>
    <template is="businessTodos" data="{{guest:guest,platformTodos:platformTodos}}"/>
    <view wx:if="{{platformError}}" class="section"><text class="hint">{{platformError}}</text><button class="text-link" bindtap="loadPlatformHome">重新加载</button></view>
    <view class="section sales-shortcuts wb-tools"><view class="section-heading"><text class="section-title">常用功能</text></view><view class="sales-home-tools"><button wx:for="{{salesShortcuts}}" wx:key="action" data-action="{{item.action}}" data-url="{{item.url}}" bindtap="openSalesShortcut"><image src="/assets/{{item.icon}}.png" mode="aspectFit" /><text>{{item.title}}</text></button></view></view>
    <view class="section sales-recent"><view class="section-heading"><text class="section-title">最近办理</text></view><button wx:if="{{recentCustomer}}" class="sales-recent-row" bindtap="continueSalesCustomer"><view class="sales-person-initial">{{recentCustomer.initial}}</view><view class="sales-recent-copy"><text>{{recentCustomer.name}}</text><text class="hint">{{recentCustomer.stage}}</text></view><text class="sales-recent-action">继续办理</text><view class="chevron" /></button><button wx:if="{{recentCreation}}" class="sales-recent-row" bindtap="continueSalesCreation"><image src="{{recentCreation.image}}" mode="aspectFill"/><view class="sales-recent-copy"><text>{{recentCreation.title}}</text><text class="hint">{{recentCreation.badge}}</text></view><text class="sales-recent-action">继续创作</text><view class="chevron" /></button><view wx:if="{{!recentCustomer&&!recentCreation}}" class="sales-empty">暂无最近办理记录</view></view>
  </view>
  <view wx:elif="{{isBossBiz}}" class="content boss-biz-content">
    <view class="sales-greeting"><text>业务情况</text></view>
    <empty-state wx:if="{{!bossBiz}}" custom-class="empty" message="{{platformError||'登录后查看业务总览'}}"/>
    <block wx:if="{{bossBiz}}">
    <view class="boss-biz-card boss-biz-hero"><text class="boss-biz-k">本月设计委托</text><view class="boss-biz-hero-row"><view class="boss-biz-v">{{bossBiz.commission.value}}<text class="boss-biz-unit">{{bossBiz.commission.unit}}</text></view><text class="boss-biz-count">{{bossBiz.commissionCount}} 单</text></view>
      <view class="boss-biz-quad"><view class="boss-biz-quad-item"><text class="boss-biz-n">{{bossBiz.leads}}</text><text class="boss-biz-l">新增线索</text></view><view class="boss-biz-quad-item"><text class="boss-biz-n">{{bossBiz.following}}</text><text class="boss-biz-l">跟进中</text></view><view class="boss-biz-quad-item"><text class="boss-biz-n">{{bossBiz.converted}}</text><text class="boss-biz-l">内容转化</text></view><view class="boss-biz-quad-item"><text class="boss-biz-n">{{bossBiz.conversion===null?'—':bossBiz.conversion+'%'}}</text><text class="boss-biz-l">线索→委托</text></view></view>
    </view>
    <template is="businessTodos" data="{{guest:guest,platformTodos:platformTodos}}"/>
    <view class="section"><view class="section-heading"><text class="section-title">客户转化</text></view>
      <view class="boss-biz-card"><view wx:for="{{bossBiz.funnel}}" wx:key="label" class="boss-biz-frow"><text class="boss-biz-fk">{{item.label}}</text><view class="boss-biz-bar"><view class="boss-biz-fill {{item.strong?'strong':''}}" style="width:{{item.width}}%"/></view><text class="boss-biz-fv">{{item.value}}</text><text wx:if="{{item.source}}" class="boss-biz-fc">{{item.source}}</text></view></view>
    </view>
    <view class="section"><view class="section-heading"><text class="section-title">今天要留意</text></view>
      <view class="boss-biz-card">
        <view class="boss-biz-alert"><view class="boss-biz-dot {{bossBiz.staleCount?'red':'green'}}"/><text>{{bossBiz.staleCount?bossBiz.staleCount+' 个客户超 7 天没跟进'+(bossBiz.staleNames?' · '+bossBiz.staleNames:''):'没有超 7 天未跟进的客户'}}</text></view>
        <view class="boss-biz-alert"><view class="boss-biz-dot amber"/><text>今日待跟进 {{bossBiz.due}} 人 · 预约到店 {{bossBiz.appointments}} 人</text></view>
        <view class="boss-biz-alert"><view class="boss-biz-dot green"/><text>价目表内报价自动通过，政策外才需要你确认</text></view>
      </view>
    </view>
    </block>
    <button class="boss-biz-entry" data-url="/pages/customers/index" bindtap="openBossLink">客户列表与跟进<view class="chevron"/></button>
  </view>
  <view wx:else class="content"><login-guide wx:if="{{guest}}" title="业务工作台" description="客户跟进、方案设计、视频创作与工程移交按岗位分工办理，登录后查看本人工作台。" /><workbench-denied wx:elif="{{!canBusiness}}" title="{{active?'当前身份无业务办理权限':'登录后查看业务工作台'}}" lines="{{['客户跟进、设计和移交按岗位分工办理。请使用本人已授权的工作台。']}}" home-title="{{homeTitle||''}}" active="{{active}}" bind:home="goTab" bind:identity="openAction"/><block wx:else>
    <template is="businessTodos" data="{{guest:guest,platformTodos:platformTodos}}"/>
    <empty-state wx:if="{{platformStatus==='degraded'}}" custom-class="empty" message="{{platformError||'数据加载失败，请稍后重试'}}"/>
    <search-box variant="business" clearable="{{false}}" value="{{keyword}}" placeholder="搜索客户、项目或方案" aria-label="搜索客户、项目或方案" bind:input="search"/>
    <view class="section todo-section">
      <view class="section-heading"><text class="section-title">客户跟进</text><button wx:if="{{canSalesWrite}}" class="primary" data-action="customer" bindtap="openAction" hover-class="pressed"><text class="plus">＋</text>客户</button></view>
      <view class="customer-card">
        <view wx:for="{{filteredCustomers}}" wx:key="id" class="customer-row">
          <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view class="customer-info"><text class="customer-name">{{item.name}}</text><text class="customer-desc">{{item.desc}}</text></view>
          <button class="outline" data-action="{{item.action}}" data-customer="{{item.id}}" bindtap="openAction" hover-class="pressed">{{item.button}}</button>
        </view>
        <empty-state wx:if="{{!filteredCustomers.length}}" custom-class="empty" message="当前暂无符合条件的客户"/>
        <button wx:if="{{canBrowseCustomers}}" class="customer-footer" data-action="customers" bindtap="openAction">{{isDesign?'设计任务列表':'客户与预约'}}<view class="chevron" /></button>
      </view>
    </view>
    <view wx:if="{{canCreate}}" class="section video-section">
      <view class="section-heading"><text class="section-title">视频创作</text><button class="text-link" data-action="works" bindtap="openAction">我的作品<view class="chevron" /></button></view>
      <view class="video-content">
        <button class="video-preview" data-action="works" bindtap="openAction" hover-class="pressed"><image src="/assets/business-video.jpg" mode="aspectFill" /></button>
        <view class="creation-actions"><button wx:for="{{creation}}" wx:key="action" class="creation-action" data-action="{{item.action}}" bindtap="openAction" hover-class="pressed"><image class="creation-icon" src="/assets/{{item.icon}}.png" mode="aspectFit" /><text>{{item.title}}</text><view class="chevron" /></button></view>
      </view>
    </view>
    <view wx:if="{{canSalesWrite}}" class="section design-section">
      <view class="section-heading"><text class="section-title">方案设计</text><button class="primary" data-action="autonomous" bindtap="openAction" hover-class="pressed"><text class="plus">＋</text>自主设计</button></view>
      <view class="design-cards">
        <button class="design-card" data-action="planSearch" bindtap="openAction" hover-class="pressed"><image src="/assets/plan-search-cover.jpg" mode="aspectFill" /><view class="design-caption"><text>户型检索</text><view class="chevron" /></view></button>
        <button class="design-card" data-action="plan" bindtap="openAction" hover-class="pressed"><image src="/assets/floor-plan.png" mode="aspectFill" /><view class="design-caption"><text>平面方案</text><view class="chevron" /></view></button>
        <button class="design-card" data-action="facade" bindtap="openAction" hover-class="pressed"><image src="/assets/facade.jpg" mode="aspectFill" /><view class="design-caption"><text>立面方案</text><view class="chevron" /></view></button>
        <button class="design-card" data-action="budget" bindtap="openAction" hover-class="pressed"><image src="/assets/quote-estimate-cover.jpg" mode="aspectFill" /><view class="design-caption"><text>参考预算</text><view class="chevron" /></view></button>
      </view>
    </view>
    <button wx:if="{{showServices}}" class="customer-footer" data-action="serviceOrders" bindtap="openAction">门店服务订单 ›</button>
  </block></view>
</view>
<action-panel workbench="{{true}}" id="dashboard-action-panel" panel="{{panel}}" bindclose="closePanel" bindsubmit="submitPanel" />
