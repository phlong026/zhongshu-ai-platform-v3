<import src="./finance-home.wxml"/>
<template wx:if="{{financeDesk}}" is="financeHome" data="{{desk:financeDesk}}"/>
<view wx:else class="page management-page workbench-page"><view class="workbench-header"><brand-header id="management-workbench-header" divider="{{true}}" account-font="{{true}}" title="{{deskTitle}}"/></view><view class="content">
<block wx:if="{{guest}}">
<login-guide title="管理工作台" description="经营数据、财务收支、团队绩效与组织管理按岗位授权开放，登录后查看本人工作台。" />
</block>
<block wx:elif="{{allowed}}">
<view class="guest-search-box staff-search-box"><image src="/assets/search.png" mode="aspectFit"/><input value="{{staffKeyword}}" bindinput="searchStaff" placeholder="搜索待办、项目或办理事项" placeholder-class="guest-search-placeholder" confirm-type="search" maxlength="60" aria-label="搜索本人待办与办理事项"/><button wx:if="{{staffKeyword}}" class="guest-search-clear" bindtap="clearStaffSearch" aria-label="清空搜索"><image src="/assets/studio-clear.png" mode="aspectFit"/></button></view>
<view wx:if="{{staffHasSearch&&!staffResultCount}}" class="section guest-search-empty"><text>没有找到匹配内容</text><text class="hint">试试客户、款项或功能名称</text><button class="outline" bindtap="clearStaffSearch">重置搜索</button></view>
<view wx:if="{{!staffHasSearch||visibleFinanceTodos.length}}" class="section staff-todos"><view class="section-heading"><text class="section-title">今日待办</text><button class="guest-section-link" data-view="todos" bindtap="go">查看全部</button></view><button wx:for="{{visibleFinanceTodos}}" wx:key="key" class="todo finance-todo" data-url="{{item.url}}" data-view="{{item.view}}" data-id="{{item.id}}" data-area="{{item.area}}" data-record="{{item.record}}" bindtap="go"><image src="/assets/management-receipt.jpg"/><view class="grow"><text>{{item.name}}</text><text class="amount">{{item.amount}}</text><text class="hint">{{item.status}}</text></view><text class="mini-solid">去办理</text></button><text wx:if="{{!visibleFinanceTodos.length}}" class="hint">今日暂无待办</text></view>
<view wx:if="{{!staffHasSearch}}" class="section staff-summary"><view class="section-heading"><text class="section-title">经营摘要</text><button class="guest-section-link" data-view="finance" bindtap="go">收支明细 ›</button></view><text class="guest-period">{{monthText}}</text><view class="guest-stats"><view><text class="guest-stat-label">有效已收</text><text class="guest-stat-value">{{displaySummary.income}}<text>万</text></text></view><view><text class="guest-stat-label">有效已付</text><text class="guest-stat-value">{{displaySummary.paid}}<text>万</text></text></view><view><text class="guest-stat-label">收支结余</text><text class="guest-stat-value">{{displaySummary.balance}}<text>万</text></text></view></view><text class="hint">待核算、待复核与退回补证中的款项不计入有效累计。收支结余不代表项目利润。</text></view>
<view wx:if="{{!staffHasSearch||visibleMenu.length}}" class="section staff-common"><view class="section-heading"><text class="section-title">常用功能</text></view><view class="menu-grid staff-menu"><button wx:for="{{visibleMenu}}" wx:key="key" data-url="{{item.url}}" data-view="{{item.view}}" data-task-type="{{item.taskType}}" data-area="{{item.area}}" bindtap="go"><image src="/assets/{{item.icon}}.png"/><view class="grow"><text class="staff-menu-title">{{item.label}}</text><text wx:if="{{item.description}}" class="hint">{{item.description}}</text></view><text wx:if="{{item.count}}" class="staff-menu-count">{{item.count}}</text><text class="brown">›</text></button></view></view>
</block>
<workbench-denied wx:else title="{{loggedIn?'当前身份无管理工作台权限':'登录后查看管理工作台'}}" lines="{{['当前身份：'+(role||'访客'),'团队经营数据、财务汇总和管理审批按岗位授权开放。本人客户及移交进度请在业务工作台查看。']}}" home-title="{{homeTitle}}" active="{{active}}" login-label="{{loggedIn?'选择有效工作身份':'登录后继续'}}" bind:home="goHome" bind:identity="identity"/><text wx:if="{{allowed}}" class="snapshot"><text bindtap="identity">工作身份 ›</text></text></view></view>
