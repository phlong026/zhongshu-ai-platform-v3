@import "../../styles/workbench.wxss";
.management-page{background:#fcfbf8}.management-page .content{padding:22rpx 29rpx 0}.section{border-radius:20rpx;background:#fff;padding:20rpx;margin-bottom:25rpx}.section-heading{height:43rpx;padding-left:21rpx;margin-bottom:16rpx}.section-heading::before{height:31rpx;top:6rpx;background:#89512a}.section-title{font-family:inherit;font-size:29rpx;letter-spacing:0}.todo{display:flex;align-items:center;gap:24rpx;text-align:left;padding:19rpx 15rpx;background:#fcfaf5;border-radius:12rpx;margin-bottom:14rpx;min-height:105rpx;font-size:25rpx}.todo>image{width:62rpx;height:65rpx;flex-shrink:0}.grow{flex:1;min-width:0}.hint{display:block;font-size:21rpx;line-height:33rpx;color:#9a9187}.mini-solid{font-size:22rpx;line-height:36rpx;padding:5rpx 21rpx;border-radius:10rpx;white-space:nowrap;flex-shrink:0}.mini-solid{background:#89512a;color:#fff}.brown{color:#965323}.menu-grid{display:grid;grid-template-columns:1fr 1fr;gap:10rpx}.menu-grid button{display:flex;align-items:center;min-height:119rpx;gap:25rpx;background:#fbf9f5;border-radius:10rpx;padding:15rpx 25rpx;font-size:23rpx;text-align:left}.menu-grid image{width:57rpx;height:61rpx}.menu-grid button>text:last-child{margin-left:auto;color:#965323;font-size:30rpx}.finance-todo{min-height:126rpx}.amount{display:block;font-size:34rpx;font-weight:600;color:#98511f;line-height:49rpx}.snapshot{display:block;font-size:18rpx;text-align:center;color:#a4a1a0;margin:0 0 12rpx}.management-page{font-family:sans-serif}.section-title{font-size:30rpx}.todo{font-size:27rpx}.hint{font-size:23rpx}.mini-solid{font-size:25rpx;line-height:38rpx;padding:6rpx 20rpx}.menu-grid button{font-size:25rpx}.finance-todo{gap:14rpx}.finance-todo .grow>text:first-child{font-size:26rpx;line-height:36rpx;display:block}.finance-todo>image{width:65rpx;height:65rpx}.amount{font-size:40rpx;line-height:49rpx}.finance-todo .mini-solid{font-size:24rpx;padding:6rpx 16rpx}.management-page{font-weight:400;line-height:40rpx;letter-spacing:0}.management-page button{font-family:inherit}.section-title{font-weight:700;line-height:40rpx}.amount{font-weight:700}.todo .grow>text:first-child{font-weight:500}.todo .hint{font-weight:400;line-height:34rpx}.mini-solid{font-weight:500;line-height:38rpx}
.guest-section-link{font-size:23rpx;line-height:38rpx;color:#915124;font-weight:400}.guest-period{display:block;font-size:21rpx;line-height:32rpx;color:#897f73;font-weight:400}.guest-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:16rpx 0 14rpx;padding:18rpx 0;background:#fcf9f4;border-radius:12rpx}.guest-stats>view{text-align:center;min-width:0;border-right:1rpx solid #eae2d7}.guest-stats>view:last-child{border-right:0}.guest-stat-label{display:block;font-size:23rpx;line-height:36rpx;color:#6d6b65}.guest-stat-value{display:block;font-size:40rpx;line-height:56rpx;color:#965323;font-weight:700}.guest-stat-value>text{font-size:22rpx;font-weight:400;margin-left:5rpx}

.guest-search-box{display:flex;align-items:center;gap:16rpx;height:74rpx;border:1rpx solid #e7e5e1;border-radius:40rpx;background:#fff;padding:0 22rpx;margin-bottom:20rpx;box-sizing:border-box}.guest-search-box>image{width:34rpx;height:34rpx;flex-shrink:0}.guest-search-box input{flex:1;min-width:0;font-size:26rpx;line-height:40rpx;font-weight:400}.guest-search-placeholder{color:#9a9187}.guest-search-clear{display:flex;align-items:center;justify-content:center;width:52rpx;height:60rpx;flex-shrink:0}.guest-search-clear image{width:26rpx;height:26rpx}.guest-search-empty{text-align:center;padding:36rpx 20rpx!important}.guest-search-empty>text{display:block}.guest-search-empty .hint{margin:12rpx 0 24rpx}

.staff-menu button{gap:12rpx;padding:18rpx 14rpx;min-height:140rpx}.staff-menu image{width:46rpx;height:46rpx;flex-shrink:0}.staff-menu-title{display:block;font-size:25rpx;line-height:38rpx;font-weight:500}.staff-menu .hint{font-size:20rpx;line-height:30rpx}.staff-menu-count{font-size:21rpx;line-height:30rpx;color:#89512a;flex-shrink:0}.staff-summary>.guest-period{padding-left:20rpx}.staff-summary .guest-stats{margin-top:12rpx}.staff-summary>.hint{font-size:22rpx;line-height:34rpx}
@import '../../styles/finance-desk.wxss';

.fin-home .fin-content{padding-top:20rpx}.fin-home-intro{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;padding:0 2rpx 20rpx}.fin-home-greeting{display:block;font-size:36rpx;line-height:52rpx;font-weight:600;margin-bottom:6rpx}.fin-home-period{color:#89512a;font-size:24rpx;line-height:36rpx;min-height:56rpx;display:flex;align-items:center;padding:0 8rpx}.fin-home-summary{padding:8rpx 22rpx}.fin-home-metrics{display:grid;grid-template-columns:1fr 1fr}.fin-home .fin-home-metric{min-width:0;min-height:112rpx;padding:18rpx 12rpx;text-align:center;border-bottom:1rpx solid #eee8df}.fin-home .fin-home-metric:nth-child(odd){border-right:1rpx solid #eee8df}.fin-home .fin-home-metric:nth-last-child(-n+2){border-bottom:0}.fin-home-metric text{display:block}.fin-home-metric text:first-child{font-size:23rpx;line-height:36rpx;color:#9a9187}.fin-home-metric text:last-child{font-size:38rpx;line-height:50rpx;color:#89512a;font-weight:600;white-space:nowrap}.fin-home-shortcuts .fin-shortcuts button{background:#faf8f4;min-height:112rpx;justify-content:center}.fin-home-shortcuts .fin-shortcuts image{width:48rpx;height:48rpx}.fin-home-list .fin-link-row{padding:21rpx 2rpx}.fin-home .fin-small-primary{background:#fff;color:#89512a;border:1rpx solid #89512a;border-radius:10rpx}.fin-home-empty>image{width:72rpx;height:72rpx;border-radius:16rpx;opacity:.8}.fin-home-empty>text{display:block}
.fin-home-metrics.is-hq{grid-template-columns:repeat(3,minmax(0,1fr))}.fin-home-metrics.is-hq .fin-home-metric{border-bottom:0;border-right:1rpx solid #eee8df}.fin-home-metrics.is-hq .fin-home-metric:last-child{border-right:0}
