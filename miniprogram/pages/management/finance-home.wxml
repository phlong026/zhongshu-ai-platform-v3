<template name="financeHome">
<view class="fin-page fin-home"><brand-header divider account-font title="{{desk.title}}"/>
 <view class="fin-content">
  <view class="fin-home-intro"><view><text class="fin-home-greeting">你好，{{desk.name}}</text><text class="fin-muted">{{desk.periodText}}</text></view><picker mode="date" fields="month" value="{{desk.period}}" bindchange="financeMonth"><view class="fin-home-period">切换月份</view></picker></view>
  <view class="fin-card fin-home-summary"><view class="fin-home-metrics {{desk.hq?'is-hq':''}}"><button wx:for="{{desk.metrics}}" wx:key="label" class="fin-home-metric {{item.tone}}" data-index="{{index}}" bindtap="financeMetric"><text>{{item.label}}</text><text>{{item.value}}</text></button></view></view>
  <view class="fin-card staff-todos fin-home-list"><view class="fin-heading"><text class="fin-title">今日待办</text><button class="fin-text" data-url="{{desk.tasksUrl}}" bindtap="financeGo">查看全部 {{desk.taskCount}}<image class="fin-chevron" src="/assets/creation-chevron-muted.png"/></button></view>
   <button wx:for="{{desk.previewTasks}}" wx:key="key" class="fin-task finance-todo" data-url="{{item.url}}" bindtap="financeGo"><image class="fin-row-icon" src="{{item.icon}}" mode="aspectFit"/><view class="fin-grow"><text class="fin-name">{{item.company?item.company+' · ':''}}{{item.name}}</text><text class="fin-amount">{{item.amount}}</text><text class="fin-status">{{item.status}}</text></view><text class="fin-small-primary">{{item.label}}</text></button>
   <view wx:if="{{!desk.previewTasks.length}}" class="fin-empty fin-home-empty"><image src="/assets/management-schedule.jpg" mode="aspectFit"/><text>今日暂无待办</text></view>
  </view>
  <view class="fin-card staff-common fin-home-shortcuts"><view class="fin-heading"><text class="fin-title">常用快捷办理</text></view><view class="fin-shortcuts"><button wx:for="{{desk.shortcuts}}" wx:key="label" data-url="{{item.url}}" bindtap="financeGo"><image src="{{item.icon}}" mode="aspectFit"/><text>{{item.label}}</text></button></view></view>
  <view class="fin-card fin-home-list fin-home-progress"><view class="fin-heading"><text class="fin-title">正在办理</text><button class="fin-text" data-url="{{desk.focusUrl}}" bindtap="financeGo">查看全部<image class="fin-chevron" src="/assets/creation-chevron-muted.png"/></button></view><button wx:for="{{desk.focus}}" wx:key="id" class="fin-link-row" data-url="{{item.url}}" bindtap="financeGo"><view class="fin-grow"><text class="fin-name">{{item.name}}</text><text class="fin-muted">{{item.status}} · {{item.amount}}</text></view><image class="fin-chevron" src="/assets/creation-chevron-muted.png"/></button><view wx:if="{{!desk.focus.length}}" class="fin-empty fin-home-empty"><image src="/assets/house.png" mode="aspectFit"/><text>当前暂无正在办理的{{desk.hq?'设计费用':'项目收款'}}</text></view></view>
 </view>
</view>
</template>
