<view class="characters-page">
  <creation-header id="characters-header" title="{{pageTitle}}" intercept-back="{{view!=='home'}}" bind:back="back"/>
  <view class="character-content {{view==='home'?'':'with-footer'}}">
    <block wx:if="{{view==='home'}}">
      <view class="character-tools">
        <button class="character-tool" data-kind="AVATAR" bindtap="openCloneEntry" disabled="{{loading||saving||cloneBusy||cloneRetry}}"><image src="/assets/video-filled.png"/>口播分身</button>
        <button class="character-tool" data-kind="VOICE" bindtap="openCloneEntry" disabled="{{loading||saving||cloneBusy||cloneRetry}}"><image src="/pages/studio/assets/studio-voice.png"/>语音克隆</button>
      </view>
      <view class="search-row"><view class="search-field"><image src="/assets/search.png"/><input value="{{keyword}}" bindinput="search" placeholder="搜索人物"/></view><button wx:if="{{canCreate}}" class="add-button" bindtap="edit" disabled="{{loading||saving}}">＋ 添加人物</button></view>
      <view wx:if="{{loading}}" class="empty-card">加载中…</view>
      <view wx:elif="{{!filtered.length&&!error}}" class="empty-card">{{keyword?'暂无匹配人物':'暂无人物'}}</view>
      <view wx:for="{{filtered}}" wx:key="id" class="person-card" data-id="{{item.id}}" bindtap="detail">
        <view class="person-heading"><view class="person-avatar"><image src="/assets/person-filled.png"/></view><view class="person-name"><text class="name">{{item.name}}</text><text class="secondary">{{item.who||'身份待补充'}}</text></view><text class="badge {{!item.enabled?'muted':''}}">{{!item.enabled?'已停用':item.who&&item.sell&&item.audience?'IP已完善':'待完善'}}</text></view>
        <text wx:if="{{item.sell}}" class="person-service">{{item.sell}}</text><view class="card-link">查看定位 <image src="/assets/creation-chevron.png"/></view>
      </view>
    </block>
    <block wx:elif="{{view==='edit'}}">
      <view class="form-card character-editor">
        <view wx:for="{{fields}}" wx:key="key" class="form-field"><text class="field-label">{{item.label}}</text><view wx:if="{{item.multiline}}" class="creation-resizable"><textarea style="height:{{textHeights[item.key]||96}}px" class="field-input short-textarea" value="{{form[item.key]}}" data-key="{{item.key}}" maxlength="{{item.max}}" placeholder="{{item.example}}" placeholder-class="field-example" bindinput="input" disabled="{{saving||draftConfirming}}"/><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="{{item.key}}" data-normal="96" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded[item.key]?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view><input wx:else class="field-input" value="{{form[item.key]}}" data-key="{{item.key}}" maxlength="{{item.max}}" placeholder="{{item.example}}" placeholder-class="field-example" bindinput="input" disabled="{{saving||draftConfirming}}"/><view wx:if="{{item.key==='expressionStyle'}}" class="style-tags"><button wx:for="{{expressionTags}}" wx:for-item="tag" wx:key="label" class="{{tag.selected?'selected':''}}" data-value="{{tag.label}}" bindtap="toggleStyle" disabled="{{saving||draftConfirming}}">{{tag.label}}</button></view></view>
        <view class="supplement-link" bindtap="supplement"><text>补充定位</text><image src="/assets/creation-chevron.png"/></view>
        <view wx:if="{{editId}}" class="enabled-row"><text>启用人物</text><switch checked="{{form.enabled}}" color="#824019" bindchange="enabled" disabled="{{saving||draftConfirming}}"/></view>
      </view>
    </block>
    <block wx:elif="{{view==='supplement'}}">
      <view class="form-card"><view wx:for="{{extraFields}}" wx:key="key" class="form-field"><text class="field-label">{{item.label}}</text><view class="creation-resizable"><textarea style="height:{{textHeights[item.key]||160}}px" class="field-input extra-textarea" value="{{form[item.key]}}" data-key="{{item.key}}" maxlength="{{item.max}}" placeholder="{{item.example}}" placeholder-class="field-example" bindinput="input" disabled="{{saving||draftConfirming}}"/><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="{{item.key}}" data-normal="160" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded[item.key]?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view></view></view>
    </block>
    <block wx:elif="{{view==='detail'&&digitalPersona}}">
      <view class="person-card detail-heading"><view class="person-heading"><view class="person-avatar"><image src="/assets/person-filled.png"/></view><view class="person-name"><text class="name">{{digitalPersona.name}}</text><text class="secondary">{{digitalPersona.who||'身份待补充'}}</text></view></view></view>
      <view class="detail-tabs"><button class="active">IP定位</button><button data-kind="AVATAR" bindtap="openDigital">口播分身</button><button data-kind="VOICE" bindtap="openDigital">语音克隆</button></view>
      <view class="form-card profile-values"><view wx:for="{{fields}}" wx:key="key" wx:if="{{item.key!=='name'}}" class="profile-value"><text class="field-label">{{item.label}}</text><text>{{digitalPersona[item.key]||'待补充'}}</text></view><view class="supplement-link" bindtap="toggleProfile"><text>补充定位</text><image src="{{profileExpanded?'/assets/creation-down.png':'/assets/creation-chevron.png'}}"/></view><view wx:for="{{extraFields}}" wx:key="key" wx:if="{{profileExpanded&&digitalPersona[item.key]}}" class="profile-value extra-value"><text class="field-label">{{item.label}}</text><text>{{digitalPersona[item.key]}}</text></view></view>
    </block>
    <block wx:elif="{{(view==='avatar'||view==='voice')&&digitalPersona}}">
      <view id="digital-assets" class="form-card">
        <view class="form-field inline-field"><text class="field-label">所属人物</text><picker range="{{digitalPeople}}" range-key="name" value="{{digitalPersonIndex}}" bindchange="chooseDigitalPerson" disabled="{{cloneBusy||cloneRetry}}"><view class="field-input picker-value"><text>{{digitalPersona.name}}</text><image src="/assets/creation-down.png"/></view></picker></view>
        <view class="form-field inline-field"><text class="field-label">资源名称</text><input class="field-input" value="{{cloneTitle}}" bindinput="cloneTitle" maxlength="20" disabled="{{cloneBusy||cloneRetry}}"/></view>
        <view class="form-field"><text class="field-label">{{view==='avatar'?'人物视频':'声音样本'}}</text><view wx:if="{{view==='avatar'&&cloneVideoPath}}" class="clone-video-preview"><video id="clone-source-video" class="clone-source-video" src="{{cloneVideoPath}}" poster="{{cloneVideoPoster}}" controls show-center-play-btn show-fullscreen-btn="{{false}}" object-fit="contain" binderror="cloneVideoError"/><view class="clone-video-caption"><view><text>{{cloneUploadId?'已上传视频':'所选视频'}}</text><text class="secondary">{{cloneFileMeta}}</text></view><button class="small-button" bindtap="previewCloneVideo">打开播放</button></view><text wx:if="{{clonePreviewError}}" class="error-text">{{clonePreviewError}}</text></view><view wx:if="{{view==='voice'&&cloneAudioPath}}" class="clone-audio-preview">
          <view class="audio-preview-heading"><view><text class="audio-file-name">{{cloneFileName||'声音样本'}}</text><text class="secondary">{{cloneFileMeta}}</text></view><button class="audio-play-button" bindtap="toggleSourceAudio" aria-label="{{previewAudioId==='upload'&&previewAudioPlaying?'暂停音频':'播放音频'}}">{{previewAudioId==='upload'&&previewAudioPlaying?'暂停':'播放'}}</button></view>
          <slider class="audio-seek" min="0" max="100" value="{{previewAudioId==='upload'?previewAudioProgress:0}}" activeColor="#824019" backgroundColor="#e7ddd2" block-color="#824019" block-size="16" data-id="upload" bindchange="seekAudioPreview" disabled="{{previewAudioId!=='upload'}}"/>
          <view class="audio-time"><text>{{previewAudioId==='upload'?previewAudioPosition:'00:00'}}</text><text>{{previewAudioId==='upload'&&previewAudioLoading?'正在加载…':previewAudioId==='upload'?previewAudioDuration:'点击播放预览'}}</text></view>
          <text wx:if="{{previewAudioId==='upload'&&previewAudioError}}" class="error-text">{{previewAudioError}}</text>
        </view><view wx:if="{{cloneUploadId&&!cloneUploading}}" class="clone-upload-success" role="status"><text class="upload-success-icon">✓</text><view><text class="upload-success-title">客户端已上传</text><text class="upload-success-note">提交制作后，由飞影处理并确认就绪</text></view></view><view wx:elif="{{cloneUploading}}" class="clone-upload-state" role="status"><view class="clone-upload-heading"><text>{{cloneUploadStatus}}</text><text>已用 {{cloneUploadElapsed}} 秒</text></view><view class="clone-transfer-track"><view class="clone-transfer-activity"/></view><view class="clone-upload-steps"><view wx:for="{{cloneUploadSteps}}" wx:key="*this" class="upload-step {{index<cloneUploadPhase?'done':index===cloneUploadPhase?'current':''}}"><view class="upload-step-dot"/><text>{{item}}</text></view></view></view><view wx:elif="{{cloneUploadStatus}}" class="clone-upload-failed" role="status">上传未完成，请重新选择素材</view><button class="upload-box {{cloneVideoPath||cloneAudioPath?'upload-replace':''}}" bindtap="uploadClone" disabled="{{cloneBusy||cloneRetry}}"><image src="/assets/creation-upload.png"/><text>{{cloneUploading?'上传中…':cloneVideoPath?'重新选择视频':cloneAudioPath?'重新选择音频':cloneUploadId?cloneFileName||'素材已上传':view==='avatar'?'上传人物视频':'上传声音样本'}}</text></button><text class="file-spec">{{view==='avatar'?'MP4/MOV · H.264 · 360p～4K · 5秒至30分钟 · ≤20MB':'MP3/M4A/WAV · 5秒至3分钟 · ≤20MB'}}</text></view>
        <checkbox-group bindchange="consent"><label class="consent-row"><checkbox value="authorized" checked="{{cloneConsented}}" disabled="{{cloneBusy||cloneRetry}}" color="#824019"/><text>本人素材或已授权</text></label></checkbox-group>
        <view class="price-row"><text class="field-label">制作积分</text><text>{{cloneQuote&&cloneQuote.available?cloneQuote.credits+' 积分':cloneQuote?'暂不可用':'获取中…'}}</text></view>
        <text wx:if="{{cloneQuote&&!cloneQuote.available&&cloneQuote.message}}" class="error-text">{{cloneQuote.message}}</text>
      </view>
      <button class="resource-link" bindtap="resources">查看人物资源 <image src="/assets/creation-chevron.png"/></button>
    </block>
    <block wx:elif="{{view==='resources'&&digitalPersona}}">
      <view class="resource-person-card"><text class="resource-person-label">当前人物</text><picker class="person-name" range="{{digitalPeople}}" range-key="name" value="{{digitalPersonIndex}}" bindchange="chooseDigitalPerson" disabled="{{cloneBusy||cloneRetry}}"><view class="resource-person-value"><image class="resource-person-icon" src="/assets/person-filled.png"/><text>{{digitalPersona.name}}</text><image class="resource-person-arrow" src="/assets/creation-down.png"/></view></picker></view>
      <view wx:if="{{canCreate}}" class="resource-actions resource-create-grid">
       <button class="resource-create-card" data-kind="AVATAR" bindtap="addClone" disabled="{{cloneBusy||cloneRetry}}"><view class="resource-create-icon"><image src="/assets/video-filled.png"/><text>＋</text></view><text class="resource-create-title">创建口播分身</text><text class="resource-create-note">上传视频，复用形象</text></button>
       <button class="resource-create-card" data-kind="VOICE" bindtap="addClone" disabled="{{cloneBusy||cloneRetry}}"><view class="resource-create-icon"><image src="/pages/studio/assets/studio-voice.png"/><text>＋</text></view><text class="resource-create-title">克隆声音</text><text class="resource-create-note">上传音频，复用声音</text></button>
      </view>
      <view class="resource-section-heading"><text>人物资源</text><button class="refresh-button" bindtap="refreshAll" disabled="{{cloneBusy||cloneLoading}}"><image src="/pages/studio/assets/studio-refresh.png"/>刷新</button></view>
      <view class="resource-filters"><button class="{{resourceFilter==='ALL'?'active':''}}" data-kind="ALL" bindtap="changeResourceFilter">全部 {{cloneRows.length}}</button><button class="{{resourceFilter==='AVATAR'?'active':''}}" data-kind="AVATAR" bindtap="changeResourceFilter">视频分身 {{avatarCount}}</button><button class="{{resourceFilter==='VOICE'?'active':''}}" data-kind="VOICE" bindtap="changeResourceFilter">克隆声音 {{voiceCount}}</button></view>
      <view wx:if="{{cloneCreatedNotice}}" class="resource-created" role="status">{{cloneCreatedNotice}}</view>
      <view wx:if="{{cloneLoading&&cloneRows.length===0}}" class="empty-card">正在读取资源…</view>
      <view wx:elif="{{!cloneLoading&&visibleCloneRows.length===0}}" class="resource-empty"><view class="resource-empty-icon"><image src="{{resourceFilter==='VOICE'?'/pages/studio/assets/studio-voice.png':'/assets/video-filled.png'}}"/></view><text class="resource-empty-title">{{resourceFilter==='AVATAR'?'还没有视频分身':resourceFilter==='VOICE'?'还没有克隆声音':'还没有口播资源'}}</text><text class="resource-empty-note">{{canCreate?'从上方选择一种资源开始创建':'当前人物暂无可用资源'}}
同一人物可保存多个，制作口播时自由选择</text></view>
      <view wx:for="{{visibleCloneRows}}" wx:key="id" class="resource-card resource-item">
        <view class="resource-card-main"><view class="resource-icon"><image src="{{item.kind==='AVATAR'?'/assets/video-filled.png':'/pages/studio/assets/studio-voice.png'}}"/></view><view class="resource-info"><view class="resource-title-row"><text class="resource-title">{{item.title}}</text><text wx:if="{{item.isDefault}}" class="resource-default-badge">默认</text></view><text class="secondary">{{item.kind==='AVATAR'?'视频分身':'克隆声音'}} · {{item.ready?'已就绪':item.status==='READY'?'结算确认中':cloneStatus[item.status]||'状态待核实'}}</text><text wx:if="{{item.failureReason}}" class="error-text">{{item.failureReason}}</text></view><view class="resource-controls"><button wx:if="{{canManage&&digitalPersona.enabled&&item.ready&&!item.isDefault}}" class="small-button default-action" data-id="{{item.id}}" bindtap="setDefaultClone" disabled="{{cloneBusy||cloneLoading||cloneRetry}}">设为默认</button><button wx:if="{{item.kind==='VOICE'&&item.ready&&item.demoUrl}}" class="small-button" data-id="{{item.id}}" bindtap="audition">{{previewAudioId==='clone-'+item.id&&previewAudioPlaying?'暂停':'播放'}}</button><button wx:elif="{{!item.ready&&item.status!=='FAILED'}}" class="small-button" data-id="{{item.id}}" bindtap="refreshClone" disabled="{{cloneBusy}}">查询</button></view></view>
        <view wx:if="{{previewAudioId==='clone-'+item.id}}" class="resource-audio-progress"><slider class="audio-seek" min="0" max="100" value="{{previewAudioProgress}}" activeColor="#824019" backgroundColor="#e7ddd2" block-color="#824019" block-size="16" data-id="clone-{{item.id}}" bindchange="seekAudioPreview"/><view class="audio-time"><text>{{previewAudioPosition}}</text><text>{{previewAudioLoading?'正在加载…':previewAudioDuration}}</text></view><text wx:if="{{previewAudioError}}" class="error-text">{{previewAudioError}}</text></view>
      </view>
    </block>
    <button wx:if="{{editing&&draftStatus}}" class="draft-status" bindtap="retryDraft" disabled="{{saving}}">{{draftStatus}}</button>
    <view wx:if="{{error}}" class="error-card"><text>{{error}}</text><button wx:if="{{view==='home'}}" class="small-button" bindtap="load">重试</button></view>
    <view wx:if="{{cloneError&&(view==='avatar'||view==='voice'||view==='resources')}}" class="error-card">{{cloneError}}</view>
  </view>
  <view wx:if="{{view!=='home'&&(view!=='resources'||canUseDigital)}}" class="character-footer">
    <button wx:if="{{view==='edit'||view==='supplement'}}" class="primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{view==='supplement'?'保存':'保存定位'}}</button>
    <block wx:elif="{{view==='detail'}}"><button wx:if="{{canManage}}" class="outline-button" data-id="{{digitalPersona.id}}" bindtap="edit">编辑定位</button><button class="primary-button" data-id="{{digitalPersona.id}}" bindtap="use" disabled="{{!digitalPersona.enabled}}">用于二创</button></block>
    <button wx:elif="{{view==='avatar'||view==='voice'}}" class="primary-button" bindtap="createClone" loading="{{cloneBusy}}" disabled="{{cloneBusy||(!cloneRetry&&(!cloneUploadId||!cloneConsented||!cloneQuote.available))}}">{{cloneRetry?'确认提交结果':view==='avatar'?'确认制作':'确认克隆'}}</button>
    <button wx:elif="{{view==='resources'}}" class="primary-button" bindtap="useDigital" disabled="{{!canUseDigital||cloneLoading||cloneBusy}}">用于口播</button>
  </view>
</view>

<view wx:if="{{clonePreviewOpen}}" class="clone-preview-overlay" catchtouchmove="preventPreviewScroll"><view class="clone-preview-header" style="padding-top:{{clonePreviewTop}}px"><button class="clone-preview-back" bindtap="closeClonePreview" aria-label="返回上传页面"><text class="clone-preview-arrow">‹</text><text>返回上传页面</text></button></view><view class="clone-preview-body"><video id="clone-preview-player" class="clone-preview-player" src="{{cloneVideoPath}}" poster="{{cloneVideoPoster}}" autoplay controls show-center-play-btn show-fullscreen-btn="{{false}}" object-fit="contain" binderror="cloneVideoError"/><text wx:if="{{clonePreviewError}}" class="clone-preview-message">{{clonePreviewError}}</text></view></view>
