<view class="creation-page studio-page view-{{view}}">
  <creation-header id="creation-page-header" title="{{pageTitle}}" />
  <view class="creation-body studio-body"><text wx:if="{{operationError && view !== 'remix'}}" class="operation-error" role="alert">{{operationError}}</text>
    <block wx:if="{{invalidMessage}}"><view class="creation-card creation-empty"><text>{{invalidMessage}}</text><view class="page-actions"><button class="studio-outline" bindtap="returnToList">返回列表</button></view></view></block><block wx:elif="{{view === 'remix'}}">
      <view class="creation-card studio-card original-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>原文</text></view><text wx:if="{{extraction}}" class="studio-muted">模拟来源：{{extraction.sourceTitle}} · {{extraction.sourceUrl}}</text><textarea class="studio-bordered original-text" value="{{original}}" bindinput="inputOriginal" maxlength="5000" auto-height aria-label="参考原文" placeholder="粘贴或填写需要二创的原文"/></view>
      <view class="creation-card studio-card rewrite-card">
        <view class="studio-tabs rewrite-tabs"><button class="{{rewriteMode === 0 ? 'active' : ''}}" data-index="0" bindtap="switchRewrite">按我的IP</button><button class="{{rewriteMode === 1 ? 'active' : ''}}" data-index="1" bindtap="switchRewrite">自定义</button></view>
        <view class="studio-bordered rewrite-settings"><text class="studio-muted input-label">{{rewriteMode === 0 ? '现有IP' : '创作身份'}}</text><picker wx:if="{{rewriteMode === 0}}" range="{{ipOptions}}" value="{{ipIndex}}" bindchange="changeIp"><view class="studio-bordered ip-select"><image src="/pages/studio/assets/studio-ip.png" /><text>{{ipOptions[ipIndex]}}</text><image class="ip-down" src="/assets/creation-down.png" /></view></picker><input wx:else class="studio-bordered custom-ip" placeholder="描述你的创作身份和受众" value="{{customIp}}" bindinput="inputCustomIp" maxlength="100" /><view class="requirement-label"><text class="studio-muted">补充要求</text><text class="optional">可选</text></view><textarea cursor-spacing="24" class="studio-bordered requirement" value="{{requirement}}" bindinput="inputRequirement" maxlength="1000" aria-label="补充要求" /></view>
      </view>
      <view class="creation-card studio-card rewritten-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>二创文案{{rewriteVersion ? ' · 模拟V'+rewriteVersion : ''}}</text><button class="soft-text-button copy-optimize" bindtap="openOptimization" disabled="{{!script}}" aria-label="AI优化二创文案"><image src="/pages/studio/assets/studio-refresh.png" /><text>AI优化</text></button></view><text wx:if="{{operationError}}" class="operation-error" role="alert">{{operationError}}</text><view class="studio-bordered rewritten-text"><block wx:if="{{script}}"><text class="rewritten-title">{{title}}</text><text class="script-copy">{{script}}</text></block><view wx:else class="rewrite-empty"><text>二创文案将在这里生成</text><text>设置创作身份与要求后，点击左下方“生成二创”</text></view></view></view>
      <view class="page-actions studio-bottom-pair"><button class="studio-outline rewrite-generate" bindtap="regenerate" loading="{{rewriting}}" disabled="{{rewriting}}"><image src="/pages/studio/assets/studio-refresh.png" /><text>{{rewriting ? '生成中…' : (rewriteVersion ? '重新生成（模拟）' : '生成二创（模拟）')}}</text></button><button class="studio-primary" disabled="{{!script}}" bindtap="makeDigital"><text>制作数字人口播</text></button></view>
    </block>
    <block wx:elif="{{view === 'digital'}}">
      <view class="creation-card studio-card speech-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>口播文案</text><button class="soft-text-button" bindtap="editScript"><image src="/pages/studio/assets/studio-edit.png" /><text>编辑</text></button></view><view class="studio-bordered speech-text"><text class="speech-title">{{title}}</text><text class="speech-copy">{{script}}</text></view></view>
      <text class="script-length creation-muted">全文 {{scriptLength}} 字 · 预计约 {{estimatedSeconds}} 秒，生成将使用完整文案</text><view class="creation-card studio-card actor-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>出镜人物</text></view><view class="actor-box"><view class="actor-image-box"><image class="actor-image" src="/pages/studio/assets/studio-digital-presenter.jpg" mode="aspectFill" /></view><view class="actor-footer"><text>{{actor}}</text><button class="studio-outline change-actor" bindtap="changeActor"><text>更换人物</text><image class="studio-chevron" src="/assets/creation-chevron.png" /></button></view></view></view>
      <view class="creation-card studio-card voice-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>口播声音</text></view><view class="voice-box"><image class="voice-icon" src="/pages/studio/assets/studio-voice.png" /><text class="voice-name">{{voice}}</text><button class="voice-preview" bindtap="audition"><image src="/pages/studio/assets/studio-play.png" /><text>试听</text></button><button class="voice-change" bindtap="changeVoice"><text>更换</text><image src="/assets/creation-chevron.png" class="studio-chevron" /></button></view></view>
      <view class="page-actions"><button class="studio-primary digital-generate" bindtap="generateDigital"><text>创建口播任务</text></button></view>
    </block>
    <block wx:elif="{{view === 'tasks'}}">
      <view class="studio-tabs filter-tabs"><button wx:for="{{taskTabs}}" wx:key="*this" class="{{taskFilter === index ? 'active' : ''}}" data-index="{{index}}" bindtap="changeTaskFilter">{{item}}</button></view>
      <view wx:for="{{tasks}}" wx:key="id" class="creation-card task-card"><image class="task-cover" src="{{item.image}}" mode="aspectFill" /><view class="task-info"><view class="task-title"><image src="/pages/studio/assets/studio-section-mark.png" /><text>{{item.title}}</text></view><text class="task-subtitle studio-muted">{{item.kindLabel}} · 演示</text><view class="task-badges"><view class="task-badge {{item.status === 'generating' ? 'warm' : 'green'}}"><image src="/pages/studio/assets/studio-{{item.status === 'generating' ? 'spinner' : 'task-success'}}.png" /><text>{{item.status === 'generating' ? '生成中' : '生成完成'}}</text></view><view wx:if="{{item.status !== 'generating'}}" class="task-badge {{item.status === 'save-failed' ? 'red' : 'warm'}}"><image src="/pages/studio/assets/studio-{{item.status === 'save-failed' ? 'task-error' : 'save'}}.png" /><text>{{item.status === 'save-failed' ? '保存失败' : (item.saved ? '已保存' : '未保存')}}</text></view></view><view wx:if="{{item.status === 'generating'}}" class="task-progress"><view style="width: {{item.progress}}%;" /></view><text wx:if="{{item.status === 'save-failed'}}" class="task-failure-note studio-muted">视频已生成，无需重新生成。</text><button class="studio-primary task-action" data-id="{{item.id}}" bindtap="taskAction"><text>{{item.status === 'generating' ? '查看进度' : (item.status === 'save-failed' ? '重试保存' : '查看结果')}}</text></button></view></view>
      <view wx:if="{{!tasks.length}}" class="empty">暂无相关任务</view><view class="page-actions"><button class="studio-outline refresh-button" bindtap="refreshTasks"><image src="/pages/studio/assets/studio-refresh.png" /><text>刷新状态</text></button></view>
    </block>
    <block wx:elif="{{view === 'result'}}">
      <view class="creation-card result-card"><button class="video-stage" bindtap="playVideo" aria-label="播放预览"><image class="video-poster" src="{{activeTask.kind === 'ai' ? '/assets/creation-house.jpg' : '/pages/studio/assets/studio-portrait.jpg'}}" mode="aspectFit" /></button><view class="result-status"><image src="/pages/studio/assets/studio-success.png" /><text>生成完成</text><text class="studio-muted saved-state">{{saved ? '已保存' : '未保存'}}</text></view><view class="result-divider" /><view class="result-title-row"><text>{{activeTask.title}}</text><button bindtap="editResult"><image src="/pages/studio/assets/studio-edit.png" /><text>返回修改</text><image class="studio-chevron" src="/assets/creation-chevron.png" /></button></view><view class="result-configuration"><view wx:for="{{resultInfo}}" wx:key="label"><text class="studio-muted">{{item.label}}</text><text>{{item.value}}</text></view></view></view>
      <view class="page-actions studio-bottom-pair result-actions"><button class="studio-outline" bindtap="saveResult">{{saved ? '已保存到我的作品' : '保存到我的作品'}}</button><button class="studio-primary" bindtap="publishResult"><text>去发布</text></button></view><text class="studio-footer-note studio-muted">去发布前将先保存作品。</text>
    </block>
    <block wx:elif="{{view === 'publish'}}">
      <view class="creation-card studio-card publish-preview"><button bindtap="playVideo" aria-label="预览作品"><image src="{{cover}}" class="publish-cover" mode="aspectFill" /></button><view class="publish-preview-info"><text class="publish-preview-title">{{title}}</text><view class="publish-saved-line"><text class="studio-muted">已保存至我的作品</text><button class="soft-text-button" bindtap="changeCover"><image src="/pages/studio/assets/studio-image.png" /><text>更换封面</text></button></view></view></view>
      <view class="creation-card studio-card account-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>发布账号</text><button class="studio-text-link" bindtap="switchAccount"><text>更换账号</text><image src="/assets/creation-chevron.png" class="studio-chevron" /></button></view><view class="studio-bordered account-options"><button wx:for="{{['众墅之家 · 建房顾问', '众墅之家 · 乡墅设计']}}" wx:key="*this" class="account-option" data-index="{{index}}" bindtap="selectAccount"><image class="platform-icon" src="/pages/studio/assets/studio-{{index === 0 ? 'douyin' : 'channels'}}.jpg" /><text>{{item}}</text><image class="account-check" src="/pages/studio/assets/studio-{{selectedAccount === index ? 'check-brown' : 'check-empty'}}.png" /></button></view></view>
      <view class="creation-card studio-card publish-title-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>标题</text></view><view class="studio-bordered publish-title-input"><input class="publish-title-text" value="{{title}}" bindinput="inputTitle" maxlength="80" aria-label="发布标题" placeholder="请输入标题" /><button bindtap="clearTitle" aria-label="清空标题"><image src="/pages/studio/assets/studio-clear.png" /></button></view></view>
      <view class="creation-card studio-card publish-copy-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>发布文案</text></view><view class="studio-bordered publish-copy-input"><textarea cursor-spacing="24" value="{{publishText}}" bindinput="inputPublishText" maxlength="2000" aria-label="发布文案" /><input class="hashtag" value="{{tags}}" bindinput="inputTags" maxlength="300" aria-label="发布话题" placeholder="添加话题，例如 #乡墅设计" /></view></view>
      <button class="creation-card studio-card publish-row" bindtap="chooseSchedule"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>发布时间</text></view><text class="studio-brown schedule-label">{{scheduled || '立即发布'}}</text><image class="studio-chevron" src="/assets/creation-chevron.png" /></button>
      <button class="creation-card studio-card publish-row" bindtap="moreSettings"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>更多设置</text></view><image class="studio-chevron" src="/assets/creation-chevron.png" /></button>
      <view class="page-actions"><button class="studio-primary publish-submit" bindtap="submitPublish"><text class="publish-label">确认发布</text></button></view><text class="studio-footer-note studio-muted">发布后填写作品链接，其他信息自动关联到发布记录。</text>
    </block>
    <block wx:elif="{{view === 'receipt'}}">
      <view class="creation-card studio-card receipt-link-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png"/><text>发布后的作品链接</text><text class="receipt-required">必填</text></view><textarea class="studio-bordered receipt-url" value="{{publishedUrlInput}}" bindinput="inputPublishedUrl" maxlength="2000" placeholder="在平台发布完成后，粘贴该作品的分享链接" aria-label="发布后的作品链接"/><text wx:if="{{receiptError}}" class="receipt-error">{{receiptError}}</text></view>
      <view class="creation-card studio-card receipt-work"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png"/><text>发布信息</text><text class="receipt-auto">自动带入</text></view><view class="detail-work"><image src="{{detail.cover}}" mode="aspectFill"/><view><text class="detail-work-title">{{detail.title}}</text><text class="studio-muted">{{detail.kindLabel}}</text></view></view><view class="detail-line"><text class="studio-muted">发布平台</text><text>{{detail.platform==='douyin'?'抖音':'视频号'}}</text></view><view class="detail-line"><text class="studio-muted">发布账号</text><text>{{detail.account}}</text></view><view class="detail-line"><text class="studio-muted">发布人员</text><text>{{detail.authorName||'原作品作者'}}</text></view><view class="detail-line"><text class="studio-muted">作品编号</text><text>{{detail.workId||detail.taskId}}</text></view><text class="detail-copy">{{detail.publishText}}</text><text class="detail-copy studio-brown">{{detail.tags}}</text></view><view class="page-actions"><button class="studio-primary receipt-save" bindtap="savePublicationLink" loading="{{receiptSaving}}" disabled="{{receiptSaving}}">{{receiptSaving ? '保存中…' : '保存并返回首页'}}</button></view>
    </block>
    <block wx:elif="{{view === 'records'}}">
      <view class="studio-tabs filter-tabs"><button wx:for="{{recordTabs}}" wx:key="*this" class="{{recordFilter === index ? 'active' : ''}}" data-index="{{index}}" bindtap="changeRecordFilter">{{item}}</button></view>
      <view wx:for="{{records}}" wx:key="id" class="creation-card record-card"><button class="record-cover-button" bindtap="playVideo"><image class="record-cover" src="{{item.cover}}" mode="aspectFill" /></button><view class="record-info"><text class="record-title">{{item.title}}</text><view class="record-platform"><image src="/pages/studio/assets/studio-{{item.platform}}.jpg" /><text>{{item.platform === 'douyin' ? '抖音' : '视频号'}} · {{item.account}}</text></view><text class="record-time studio-muted">{{item.time}}</text><view class="record-bottom"><view class="record-status {{item.tone}}"><image src="/pages/studio/assets/studio-{{item.icon}}.png" /><text>{{item.label}}</text></view><button class="studio-primary record-action" data-id="{{item.id}}" bindtap="openRecord"><text>{{item.action}}</text></button></view><text wx:if="{{item.note}}" class="record-note studio-muted">{{item.note}}</text></view></view>
      <view wx:if="{{!records.length}}" class="empty">暂无相关发布记录</view><view class="page-actions"><button class="studio-outline refresh-button" bindtap="refreshRecords"><image src="/pages/studio/assets/studio-refresh.png" /><text>刷新状态</text></button></view>
    </block>
    <block wx:elif="{{view === 'detail'}}">
      <view class="publication-result"><image class="publication-result-icon" src="/pages/studio/assets/studio-{{detail.status === 'published' ? 'success-large' : detail.icon}}.png" /><text class="publication-result-title">{{detail.label}}</text><text class="studio-muted publication-result-caption">{{detail.status === 'published' ? '已登记发布链接与作品信息' : (detail.note || '查看当前发布进度')}}</text></view>
      <view class="creation-card studio-card detail-information"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>作品信息</text></view><view class="detail-work"><image src="{{detail.cover}}" mode="aspectFill" /><view><text class="detail-work-title">{{detail.title}}</text><text class="studio-muted">{{detail.kindLabel}}</text></view></view><view class="detail-line"><text class="studio-muted">平台</text><text>{{detail.platform === 'douyin' ? '抖音' : '视频号'}}</text></view><view class="detail-line"><text class="studio-muted">发布账号</text><text>{{detail.account}}</text></view><view class="detail-line"><text class="studio-muted">{{detail.timeLabel}}</text><text>{{detail.displayTime}}</text></view><view class="detail-line"><text class="studio-muted">作品标识</text><text>{{detail.identifier}}</text></view></view>
      <view class="creation-card studio-card"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>提交内容</text></view><text class="detail-copy">{{detail.publishText || '未保存发布文案'}}</text><text wx:if="{{detail.tags}}" class="detail-copy studio-brown">{{detail.tags}}</text></view><view class="creation-card studio-card publication-progress"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png" /><text>发布进度</text></view><view class="timeline"><view wx:for="{{timeline}}" wx:key="label"><text class="timeline-dot" /><text>{{item.label}}</text><text class="studio-muted">{{item.time}}</text></view></view></view>
      <button wx:if="{{detail.status==='published'&&detail.contentId}}" class="studio-outline consultation-entry" bindtap="registerConsultation">登记咨询客资</button>
      <view class="creation-card studio-card publication-link"><view class="studio-heading"><image class="studio-mark" src="/pages/studio/assets/studio-section-mark.png"/><text>发布链接与回采</text><button wx:if="{{detail.status === 'published'}}" class="soft-text-button publication-edit" bindtap="advancePublication">修改链接</button></view><button wx:if="{{detail.publishedUrl}}" class="saved-publication-url" bindtap="copyPublishedUrl">{{detail.publishedUrl}}</button><text wx:else class="studio-muted">待填写发布后的作品链接</text><text class="studio-muted receipt-help">{{detail.publishedUrl?'待回采 · 已关联该作品的发布信息':'填写链接后进入待回采记录'}}</text></view><view class="page-actions"><button class="studio-outline detail-return" bindtap="returnRecords">返回发布记录</button><button wx:if="{{detail.status === 'published'}}" class="studio-primary detail-primary detail-home" bindtap="returnHome">返回首页</button><button wx:else class="studio-primary detail-primary" bindtap="advancePublication"><text>{{detail.status === 'failed' ? '查看失败原因' : '填写发布链接'}}</text></button></view>
    </block>
    <block wx:elif="{{view === 'works'}}"><button wx:for="{{works}}" wx:key="id" class="creation-card saved-work" data-task="{{item.taskId}}" bindtap="openWork"><image src="{{item.image}}" mode="aspectFill" /><view><text>{{item.title}}</text><text class="studio-muted">已保存 · 查看结果</text></view><image class="studio-chevron" src="/assets/creation-chevron.png" /></button><view wx:if="{{!works.length}}" class="empty">暂无已保存作品，可从任务中心查看结果并保存。</view><view class="page-actions"><button class="studio-outline refresh-button" bindtap="openTasks">前往任务中心</button></view></block>
    <block wx:elif="{{view === 'recent'}}"><button wx:for="{{recent}}" wx:key="id" class="creation-card saved-work" data-id="{{item.id}}" bindtap="openRecent"><image src="{{item.image}}" mode="aspectFill" /><view><text>{{item.title}}</text><text class="studio-muted">{{item.badge}} · {{item.action}}</text></view><image class="studio-chevron" src="/assets/creation-chevron.png" /></button><view wx:if="{{!recent.length}}" class="creation-empty">暂无创作内容，可返回创作中心新建。</view></block><block wx:elif="{{view === 'library'}}"><view class="demo-label studio-muted">创作素材</view><button wx:for="{{libraryAssets}}" wx:key="id" class="creation-card saved-work" data-path="{{item.path}}" bindtap="previewLibrary"><image src="{{item.path}}" mode="aspectFill" /><text>{{item.name}}</text></button></block>
  </view>
</view>
<view wx:if="{{sheet}}" class="creation-sheet-overlay" bindtap="closeSheet" catchtouchmove="noop"><view class="creation-sheet" catchtap="noop"><view class="creation-sheet-header"><text>{{sheetTitle}}</text><button class="creation-sheet-close" bindtap="closeSheet">关闭</button></view>
  <block wx:if="{{sheet === 'optimize'}}"><text class="creation-sheet-text">保留当前文案的建房信息，优化表达与结尾互动。</text><view class="copy-optimize-options"><button wx:for="{{['口语自然','重点清晰','精简表达']}}" wx:key="*this" class="copy-optimize-option {{optimizeRequirement===item?'selected':''}}" data-value="{{item}}" bindtap="inputOptimization">{{item}}</button></view><button class="studio-primary sheet-confirm" bindtap="optimizeScript">确认AI优化</button></block>
  <block wx:elif="{{sheet === 'editor'}}"><text class="creation-sheet-text">修改会暂存；点击保存文案后用于生成。</text><textarea cursor-spacing="24" class="creation-sheet-input" value="{{editingText}}" bindinput="inputEdit" maxlength="7000" aria-label="编辑口播文案" /><button class="studio-primary sheet-confirm" bindtap="saveScript">保存文案</button></block>
  <block wx:elif="{{sheet === 'actor' || sheet === 'voice'}}"><button class="creation-sheet-row" bindtap="{{sheet === 'actor' ? 'selectActor' : 'selectVoice'}}"><image class="creation-sheet-thumb" src="/pages/studio/assets/studio-portrait-wide.jpg" mode="aspectFill" /><text>{{sheet === 'actor' ? '李顾问' : '李顾问原声'}} · 已选</text></button></block>
  <block wx:elif="{{sheet === 'cover'}}"><button wx:for="{{['/pages/studio/assets/studio-portrait-wide.jpg', '/assets/creation-house.jpg', '/assets/creation-courtyard.jpg']}}" wx:key="*this" class="creation-sheet-row" data-path="{{item}}" bindtap="selectCover"><image src="{{item}}" class="creation-sheet-thumb" mode="aspectFill" /><text>选择此封面</text></button></block>
  <block wx:elif="{{sheet === 'accounts'}}"><button wx:for="{{['众墅之家 · 建房顾问', '众墅之家 · 乡墅设计']}}" wx:key="*this" class="creation-sheet-row" data-index="{{index}}" bindtap="selectAccount"><image class="platform-icon" src="/pages/studio/assets/studio-{{index === 0 ? 'douyin' : 'channels'}}.jpg" /><text>{{item}}</text><text>{{selectedAccount === index ? '已选' : '选择'}}</text></button></block>
  <block wx:elif="{{sheet === 'schedule'}}"><button class="creation-sheet-row" bindtap="immediate">立即发布</button><picker mode="date" bindchange="scheduleDate"><view class="creation-sheet-row">{{scheduleDay || '选择发布日期'}}</view></picker><picker mode="time" bindchange="scheduleTime"><view class="creation-sheet-row">{{scheduleClock || '选择发布时间'}}</view></picker><text class="creation-sheet-text">定时需至少提前1分钟。</text><button class="studio-primary sheet-confirm" bindtap="saveSchedule">确认定时</button></block>
  
</view></view>
