<view class="creation-page studio-page view-{{view}}">

  <creation-header id="creation-page-header" title="{{pageTitle}}" />
  <view class="creation-body studio-body"><text wx:if="{{operationError && view !== 'remix' && view !== 'digital'}}" class="operation-error" role="alert">{{operationError}}</text>
    <block wx:if="{{invalidMessage}}"><view class="creation-card creation-empty"><text>{{invalidMessage}}</text><view class="page-actions"><button class="studio-outline" bindtap="returnToList">返回列表</button></view></view></block><block wx:elif="{{view === 'remix'}}">
      <view class="creation-card studio-card original-card"><view class="studio-heading"><text>原文</text></view><text wx:if="{{extraction}}" class="studio-muted">参考来源：{{extraction.sourceTitle}} · {{extraction.sourceUrl}}</text><view class="creation-resizable"><textarea style="height:{{textHeights.original||160}}px" class="studio-bordered original-text" value="{{original}}" bindinput="inputOriginal" maxlength="5000" aria-label="参考原文" placeholder="粘贴或填写需要二创的原文"/><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="original" data-normal="160" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded.original?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view></view>
      <view class="creation-card studio-card rewrite-card">
        <view class="studio-bordered rewrite-settings"><text class="studio-muted input-label">选择人物</text><picker range="{{ipOptions}}" value="{{ipIndex}}" bindchange="changeIp"><view class="studio-bordered ip-select"><image src="/pages/studio/assets/studio-ip.png" /><text>{{ipOptions[ipIndex]}}</text><image class="ip-down" src="/assets/creation-down.png" /></view></picker><view class="requirement-label"><text class="studio-muted">补充要求</text><text class="optional">可选</text></view><view class="creation-resizable"><textarea style="height:{{textHeights.requirement||96}}px" cursor-spacing="24" class="studio-bordered requirement" value="{{requirement}}" bindinput="inputRequirement" maxlength="1000" aria-label="补充要求" /><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="requirement" data-normal="96" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded.requirement?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view></view>
      </view>
      <view class="creation-card studio-card rewritten-card"><view class="studio-heading"><text>二创文案{{rewriteVersion ? ' · V'+rewriteVersion : ''}}</text><button class="soft-text-button copy-optimize" bindtap="openOptimization" disabled="{{optimizing||rewriting||(!script&&!optimizationRetry)}}" aria-label="AI优化二创文案"><image src="/pages/studio/assets/studio-refresh.png" /><text>{{optimizing?'优化中…':(optimizationRetry?'确认优化结果':'AI优化')}}</text></button></view><text wx:if="{{operationError}}" class="operation-error" role="alert">{{operationError}}</text><view class="creation-resizable"><textarea style="height:{{textHeights.rewrittenScript||220}}px" class="studio-bordered rewritten-text script-copy" value="{{script}}" bindinput="inputRewrittenScript" maxlength="-1" cursor-spacing="24" aria-label="二创文案正文，可直接编辑" placeholder="待生成二创文案"/><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="rewrittenScript" data-normal="220" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded.rewrittenScript?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view></view>
      <view class="page-actions studio-bottom-pair"><button class="studio-outline rewrite-generate" bindtap="regenerate" loading="{{rewriting}}" disabled="{{rewriting||optimizing||optimizationRetry}}"><image wx:if="{{!rewriting}}" src="/pages/studio/assets/studio-refresh.png" /><text>{{rewriting ? '生成中…' : (rewriteVersion ? '重新生成' : '生成二创')}}</text></button><button class="studio-primary" disabled="{{!script}}" bindtap="makeDigital"><text>制作数字人口播</text></button></view>
    </block>
    <block wx:elif="{{view === 'digital'}}">
      <view class="creation-card digital-form">
        <view class="digital-field"><text class="digital-label">口播人物</text><picker range="{{digitalPersonas}}" range-key="name" value="{{digitalPersonaIndex}}" bindchange="changeDigitalPersona" disabled="{{digitalLoading||digitalSubmitting||digitalRetry}}"><view class="digital-select"><text>{{digitalPersonas[digitalPersonaIndex].name||'请选择人物'}}</text><image src="/assets/creation-down.png"/></view></picker></view>
        <view class="digital-field"><text class="digital-label">口播分身</text><button class="digital-select" bindtap="changeActor" disabled="{{digitalLoading||digitalSubmitting||digitalRetry}}"><text>{{actor||'请选择分身'}}{{actor&&actorIsDefault?'（默认）':''}}</text><image src="/assets/creation-down.png"/></button></view>
        <view class="digital-field"><text class="digital-label">口播声音</text><view class="digital-voice-row"><button class="digital-select" bindtap="changeVoice" disabled="{{digitalLoading||digitalSubmitting||digitalRetry}}"><text>{{voice||'请选择声音'}}{{voice&&voiceIsDefault?'（默认）':''}}</text><image src="/assets/creation-down.png"/></button></view></view>
        <button class="digital-library-link" bindtap="openCharacters">人物资源 <image src="/assets/creation-chevron.png"/></button>
      </view>
      <view class="creation-card digital-form"><text class="digital-label">口播文案</text><view class="creation-resizable"><textarea style="height:{{textHeights.digitalScript||220}}px" class="digital-script" value="{{script}}" bindinput="inputDigitalScript" maxlength="10000" disabled="{{digitalSubmitting||digitalRetry}}" cursor-spacing="24" placeholder="填写口播文案"/><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="digitalScript" data-normal="220" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded.digitalScript?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view><text class="digital-count">{{scriptLength}} 字</text></view>
      <view class="list-feedback studio-muted">{{digitalResourceError || (digitalLoading ? '正在更新人物资源…' : '')}}</view><button wx:if="{{digitalResourceError}}" class="studio-outline refresh-button" bindtap="refreshDigitalResources" disabled="{{digitalLoading}}">重新加载资源</button><text wx:if="{{operationError}}" class="operation-error" role="alert">{{operationError}}</text>
      <view class="digital-footer"><button class="studio-outline" bindtap="openTasks">查看任务</button><button class="studio-primary digital-generate" bindtap="generateDigital" loading="{{digitalSubmitting}}" disabled="{{digitalSubmitting||(!digitalRetry&&(digitalLoading||!script||!avatarCloneId||!voiceCloneId))}}">{{digitalRetry?'确认提交结果':'生成口播'}}</button></view>
    </block>
    <block wx:elif="{{view === 'tasks'}}">
      <view class="studio-tabs filter-tabs"><button wx:for="{{taskTabs}}" wx:key="*this" class="{{taskFilter === index ? 'active' : ''}}" data-index="{{index}}" bindtap="changeTaskFilter">{{item}}</button></view>
      <view wx:if="{{!tasksLoaded && tasksLoading}}" class="empty">正在加载任务…</view><view wx:elif="{{!tasksLoaded && tasksError}}" class="empty">{{tasksError}}</view>
      <block wx:elif="{{taskCount > 0}}"><view wx:for="{{tasks}}" wx:key="id" class="task-swipe-shell {{item.swiped?'is-swiped':''}}"><view wx:if="{{item.canDismiss}}" class="task-swipe-action"><button class="task-dismiss-button" data-id="{{item.id}}" catchtap="dismissTaskTap" disabled="{{item.dismissing}}">{{item.dismissing?'移除中…':'移除'}}</button></view><view class="creation-card task-card" data-id="{{item.id}}" bindtouchstart="onTaskTouchStart" bindtouchmove="onTaskTouchMove" bindtouchend="onTaskTouchEnd" bindlongpress="onTaskLongPress"><view class="task-type-icon"><image src="{{item.image}}" mode="aspectFit"/></view><view class="task-info"><view class="task-title"><text>{{item.title}}</text></view><text class="task-subtitle studio-muted">{{item.kindLabel}}</text><view class="task-badges"><view class="task-badge {{item.status==='completed'?'green':item.status==='failed'?'red':'warm'}}"><text>{{item.stageLabel}}</text></view></view><text wx:if="{{item.status==='failed'}}" class="task-failure-note studio-muted">{{item.failedReason||'处理失败，请查看详情后重试。'}}</text><text wx:elif="{{item.status==='uncertain'}}" class="task-failure-note studio-muted">提交结果确认中，请稍后刷新查看。</text><button class="studio-primary task-action" data-id="{{item.id}}" bindtap="taskAction"><text>{{item.saveRetryable?'重试保存':item.status==='generating'?'查看进度':item.status==='completed'?'查看结果':'查看详情'}}</text></button></view></view></view>
      </block><view wx:elif="{{tasksLoaded}}" class="empty">暂无相关任务</view><view class="list-feedback studio-muted"><text wx:if="{{tasksLoaded}}">{{tasksError || (tasksLoading ? '正在更新任务…' : '')}}</text></view><view class="page-actions"><button class="studio-outline refresh-button" bindtap="refreshTasks" loading="{{tasksLoading}}" disabled="{{tasksLoading}}"><image src="/pages/studio/assets/studio-refresh.png"/><text>{{tasksError ? '重新加载' : '刷新状态'}}</text></button></view>
    </block>
    <block wx:elif="{{view === 'result'}}">
      <view wx:if="{{resultLoading}}" class="empty">正在读取成果…</view>
      <view wx:if="{{resultError}}" class="creation-card" role="alert"><text>{{resultError}}</text><button class="studio-outline" bindtap="retryResult" disabled="{{resultLoading}}">重新读取</button></view>
      <view wx:if="{{activeTask}}" class="creation-card result-card">
        <text class="studio-heading">{{activeTask.title}}</text>
        <block wx:if="{{activeTask.outputType==='text'}}"><text class="result-text" selectable>{{activeTask.resultText}}</text><button class="studio-primary" bindtap="useTextResult" disabled="{{!activeTask.resultText}}">用于文案二创</button></block>
        <block wx:elif="{{activeTask.outputType==='source'}}"><text>{{activeTask.sourceTitle}}</text><video wx:if="{{activeTask.sourceVideoUrl}}" src="{{activeTask.sourceVideoUrl}}" controls object-fit="contain"/><text class="studio-muted">已解析，可回创作页提取文案</text></block>
        <block wx:else><video wx:if="{{activeTask.videoReady}}" id="digital-result" class="result-video" style="height:{{resultVideoHeight}}rpx" src="{{activeTask.resultUrl}}" controls object-fit="contain" bindloadedmetadata="videoMetadata" binderror="videoError"/><view class="result-status"><text>{{activeTask.videoReady?'生成完成':'成果待读取'}}</text><text wx:if="{{activeTask.videoReady}}">{{saved?'已保存':'未保存'}}</text></view><button wx:if="{{activeTask.videoReady}}" bindtap="editResult">返回修改</button></block>
      </view>
      <view wx:if="{{activeTask.outputType==='video'}}" class="page-actions studio-bottom-pair result-actions"><button class="studio-outline" disabled="{{!activeTask.videoReady||resultLoading||resultSaving}}" bindtap="saveResult">{{saved?'已保存到我的作品':'保存到我的作品'}}</button><button class="studio-primary" disabled="{{!activeTask.videoReady||resultLoading||resultSaving}}" loading="{{resultSaving}}" bindtap="publishResult">回填发布链接</button></view>
    </block>
    <block wx:elif="{{view === 'publish'}}">
      <view wx:if="{{publicationPending}}" class="creation-card studio-card" role="status"><text class="studio-heading">有一条登记待确认</text><text class="studio-muted">{{publicationPendingPlatform}} · {{publicationPendingTitle}}。本页修改会保留。</text><button class="studio-outline" bindtap="resumePublication" loading="{{publishSubmitting}}" disabled="{{publishSubmitting}}">核对上次登记</button></view>
      <view wx:if="{{publicationExistingId}}" class="creation-card studio-card"><button class="studio-outline" bindtap="openExistingPublication">查看已有登记</button></view>
      <view class="creation-card studio-card publish-preview"><image wx:if="{{cover}}" src="{{cover}}" class="publish-cover" mode="aspectFill" binderror="publicationCoverError"/><view wx:else class="publish-cover publication-cover-empty">作品</view><view class="publish-preview-info"><text class="publish-preview-title">{{title||'已保存的作品'}}</text><text class="studio-muted publish-preview-note">先在外部平台完成发布，再把作品链接回填到这里。</text></view></view>
      <view class="creation-card studio-card"><view class="studio-heading"><text>发布链接</text><text class="receipt-required">必填</text></view><textarea class="studio-bordered publish-link-url" value="{{publishedUrlInput}}" bindinput="inputPublishedUrl" maxlength="2000" placeholder="粘贴已发布作品的分享链接" aria-label="发布后的作品链接"/><text class="studio-muted publish-help">支持抖音、视频号等平台的 http/https 作品链接。</text></view>
      <view class="creation-card studio-card account-card">
        <view class="studio-heading"><text>发布平台</text></view>
        <view class="publication-platforms"><button wx:for="{{publicationPlatforms}}" wx:key="platform" class="{{selectedAccount===index?'is-selected':''}}" data-index="{{index}}" bindtap="selectAccount"><image class="platform-icon" src="/pages/studio/assets/studio-{{item.platform}}.jpg"/><text>{{item.name}}</text></button></view>
        <view class="studio-heading"><text>发布账号</text><button class="studio-text-link" bindtap="managePublisherAccounts">管理账号</button></view>
        <view wx:if="{{publisherAccountsLoading}}" class="publication-account-feedback studio-muted">正在读取账号…</view>
        <view wx:elif="{{publisherAccountsError}}" class="publication-account-feedback"><text class="operation-error" role="alert">{{publisherAccountsError}}</text><button class="studio-outline" bindtap="loadPublisherAccounts">重新加载账号</button></view>
        <view wx:elif="{{!publisherAccounts.length}}" class="publication-account-feedback"><text class="studio-muted">此平台暂无可用账号</text><button class="studio-outline" bindtap="editPublisherAccount">添加账号</button></view>
        <block wx:else><button wx:for="{{publisherAccounts}}" wx:key="id" class="publication-account-option {{publisherAccountId===item.id?'is-selected':''}}" data-id="{{item.id}}" bindtap="selectPublisherAccount"><view class="publication-account-label"><text>{{item.displayName}}</text><text class="studio-muted">{{item.identifier}}</text></view><image class="account-check" src="/pages/studio/assets/studio-{{publisherAccountId===item.id?'check-brown':'check-empty'}}.png"/></button></block>
      </view>
      <button class="creation-card studio-card publish-row" bindtap="toggleLead"><view class="studio-heading"><text>登记本次咨询客资</text><text class="optional">选填</text></view><image class="studio-chevron" src="/assets/creation-chevron.png" /></button>
      <view wx:if="{{leadOpen}}" class="creation-card studio-card lead-form"><input class="studio-bordered lead-input" value="{{leadName}}" bindinput="inputLeadName" maxlength="20" placeholder="客户称呼" /><input class="studio-bordered lead-input" type="number" value="{{leadPhone}}" bindinput="inputLeadPhone" maxlength="11" placeholder="手机号" /><textarea class="studio-bordered lead-need" value="{{leadNeed}}" bindinput="inputLeadNeed" maxlength="500" placeholder="咨询需求，例如：想了解二层户型或预算"/><text class="studio-muted publish-help">填写后与发布链接一起保存；不填则只保存链接。</text></view>
      <view class="page-actions"><button class="studio-primary publish-submit" bindtap="submitLinkAndLead" loading="{{linkSubmitting}}" disabled="{{linkSubmitting||linkSaved||publicationPending||publicationExistingId}}">{{linkSubmitting ? '正在保存…' : (linkSaved ? '已保存' : '保存链接并登记')}}</button></view>
      <text class="studio-footer-note studio-muted">请先在外部平台完成发布，再回填作品链接；客资可在本次或稍后登记。</text>
    </block>
    <block wx:elif="{{view === 'receipt'}}">
      <view wx:if="{{receiptLoading}}" class="empty">发布记录加载中…</view><block wx:elif="{{detail}}"><view wx:if="{{detail.status === 'published'}}" class="creation-card studio-card receipt-link-card"><view class="studio-heading"><text>已登记发布链接</text><text class="receipt-auto">只读</text></view><button wx:if="{{detail.publishedUrl}}" class="saved-publication-url" bindtap="copyPublishedUrl">{{detail.publishedUrl}}</button><text wx:else class="studio-muted">链接未返回，请从发布记录刷新。</text></view><view wx:elif="{{detail.status === 'scheduled'}}" class="creation-card creation-empty"><text>历史定时记录暂不支持登记链接，请返回发布记录查看。</text></view><view wx:elif="{{detail.status === 'publishing' || detail.status === 'verify'}}" class="creation-card studio-card receipt-link-card"><view class="studio-heading"><text>发布后的作品链接</text><text class="receipt-required">必填</text></view><view class="creation-resizable"><textarea style="height:{{textHeights.receiptUrl||100}}px" class="studio-bordered receipt-url" value="{{publishedUrlInput}}" bindinput="inputPublishedUrl" maxlength="2000" placeholder="在平台发布完成后，粘贴该作品的分享链接" aria-label="发布后的作品链接"/><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="receiptUrl" data-normal="100" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded.receiptUrl?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view><text wx:if="{{receiptError}}" class="receipt-error">{{receiptError}}</text></view><view wx:else class="creation-card creation-empty"><text>当前发布状态不可登记链接，请返回发布记录查看。</text></view>
      <view class="creation-card studio-card receipt-work"><view class="studio-heading"><text>发布信息</text><text class="receipt-auto">自动带入</text></view><view class="detail-work"><image wx:if="{{detail.cover}}" src="{{detail.cover}}" mode="aspectFill"/><view wx:else class="publication-detail-cover publication-cover-empty">{{detail.coverError?'封面读取失败':'封面'}}</view><view><text class="detail-work-title">{{detail.title}}</text><text class="studio-muted">{{detail.kindLabel}}</text></view></view><view class="detail-line"><text class="studio-muted">发布平台</text><text>{{detail.platform==='douyin'?'抖音':'视频号'}}</text></view><view class="detail-line"><text class="studio-muted">发布账号</text><text>{{detail.account}}</text></view><view class="detail-line"><text class="studio-muted">发布人员</text><text>{{detail.authorName||'原作品作者'}}</text></view><view class="detail-line"><text class="studio-muted">作品编号</text><text>{{detail.workId||detail.taskId}}</text></view><text class="detail-copy">{{detail.publishText}}</text><text class="detail-copy studio-brown">{{detail.tags}}</text></view><view class="page-actions"><button wx:if="{{detail.status === 'publishing' || detail.status === 'verify'}}" class="studio-primary receipt-save" bindtap="savePublicationLink" loading="{{receiptSaving}}" disabled="{{receiptSaving || receiptLoading}}">{{receiptSaving ? '保存中…' : '保存并返回首页'}}</button><button wx:else class="studio-outline" bindtap="returnRecords">返回发布记录</button></view></block><view wx:else class="empty">发布记录尚未加载，请返回重试。</view>
    </block>
    <block wx:elif="{{view === 'records'}}">
      <view class="studio-tabs filter-tabs"><button wx:for="{{recordTabs}}" wx:key="*this" class="{{recordFilter === index ? 'active' : ''}}" data-index="{{index}}" bindtap="changeRecordFilter">{{item}}</button></view>
      <view wx:if="{{!recordsLoaded && recordsLoading}}" class="empty">发布记录加载中…</view><view wx:elif="{{!recordsLoaded && recordsError}}" class="empty"><text>{{recordsError}}</text></view>
      <view wx:for="{{records}}" wx:key="id" class="creation-card record-card"><button class="record-cover-button" data-id="{{item.id}}" bindtap="openPublicationVideo"><image wx:if="{{item.cover}}" class="record-cover" src="{{item.cover}}" mode="aspectFill"/><view wx:else class="record-cover publication-cover-empty">{{item.coverError?'封面读取失败':'封面'}}</view></button><view class="record-info"><text class="record-title">{{item.title}}</text><view class="record-platform"><image src="/pages/studio/assets/studio-{{item.platform}}.jpg" /><text>{{item.platform === 'douyin' ? '抖音' : '视频号'}} · {{item.account}}</text></view><text class="record-time studio-muted">{{item.time}}</text><view class="record-bottom"><view class="record-status {{item.tone}}"><image src="/pages/studio/assets/studio-{{item.icon}}.png" /><text>{{item.label}}</text></view><button class="studio-primary record-action" data-id="{{item.id}}" bindtap="openRecord"><text>{{item.action}}</text></button></view><text wx:if="{{item.note}}" class="record-note studio-muted">{{item.note}}</text></view></view>
      <view wx:if="{{recordsLoaded && !records.length}}" class="empty">暂无相关发布记录</view><view class="list-feedback studio-muted"><text wx:if="{{recordsLoaded}}">{{recordsError || (recordsLoading ? '正在更新发布记录…' : '')}}</text></view><view class="page-actions"><button class="studio-outline refresh-button" bindtap="refreshRecords" loading="{{recordsLoading}}" disabled="{{recordsLoading}}"><image src="/pages/studio/assets/studio-refresh.png" /><text>{{recordsError ? '重新加载' : '刷新状态'}}</text></button></view>
    </block>
    <block wx:elif="{{view === 'detail'}}">
      <view wx:if="{{!recordsLoaded && recordsLoading}}" class="empty">发布记录加载中…</view><view wx:elif="{{!recordsLoaded && recordsError}}" class="empty">{{recordsError}}</view><block wx:if="{{detail}}">
      <view class="publication-result"><image class="publication-result-icon" src="/pages/studio/assets/studio-{{detail.status === 'published' ? 'success-large' : detail.icon}}.png" /><text class="publication-result-title">{{detail.label}}</text><text class="studio-muted publication-result-caption">{{detail.status === 'published' ? '已登记发布链接与作品信息' : (detail.note || '查看当前发布进度')}}</text></view>
      <view class="creation-card studio-card detail-information"><view class="studio-heading"><text>作品信息</text><button wx:if="{{detail.status==='published' && detail.workId}}" class="soft-text-button" bindtap="openPublicationVideo">查看原片</button></view><view class="detail-work"><image wx:if="{{detail.cover}}" src="{{detail.cover}}" mode="aspectFill"/><view wx:else class="publication-detail-cover publication-cover-empty">{{detail.coverError?'封面读取失败':'封面'}}</view><view><text class="detail-work-title">{{detail.title}}</text><text class="studio-muted">{{detail.kindLabel}}</text></view></view><view class="detail-line"><text class="studio-muted">平台</text><text>{{detail.platform === 'douyin' ? '抖音' : '视频号'}}</text></view><view class="detail-line"><text class="studio-muted">发布账号</text><text>{{detail.account}}</text></view><view class="detail-line"><text class="studio-muted">{{detail.timeLabel}}</text><text>{{detail.displayTime}}</text></view><view class="detail-line"><text class="studio-muted">作品标识</text><text>{{detail.identifier}}</text></view></view>
      <view class="creation-card studio-card"><view class="studio-heading"><text>提交内容</text></view><text class="detail-copy">{{detail.publishText || '未保存发布文案'}}</text><text wx:if="{{detail.tags}}" class="detail-copy studio-brown">{{detail.tags}}</text></view><view class="creation-card studio-card publication-progress"><view class="studio-heading"><text>发布进度</text></view><view class="timeline"><view wx:for="{{timeline}}" wx:key="label"><text class="timeline-dot" /><text>{{item.label}}</text><text class="studio-muted">{{item.time}}</text></view></view></view>
      <button wx:if="{{detail.status==='published'&&detail.id}}" class="studio-outline consultation-entry" bindtap="registerConsultation">登记咨询客资</button>
      <view class="creation-card studio-card publication-link"><view class="studio-heading"><text>发布链接与回采</text></view><button wx:if="{{detail.publishedUrl}}" class="saved-publication-url" bindtap="copyPublishedUrl">{{detail.publishedUrl}}</button><text wx:else class="studio-muted">待填写发布后的作品链接</text><text class="studio-muted receipt-help">{{detail.publishedUrl?'待回采 · 已关联该作品的发布信息':'填写链接后进入待回采记录'}}</text></view><view class="page-actions"><button class="studio-outline detail-return" bindtap="returnRecords">返回发布记录</button><button wx:if="{{detail.status === 'published'}}" class="studio-primary detail-primary detail-home" bindtap="returnHome">返回首页</button><button wx:else class="studio-primary detail-primary" bindtap="advancePublication"><text>{{detail.status === 'failed' ? '查看失败原因' : '填写发布链接'}}</text></button></view>
      </block><view class="list-feedback studio-muted"><text wx:if="{{recordsLoaded}}">{{recordsError || (recordsLoading ? '正在更新发布记录…' : '')}}</text></view><button wx:if="{{recordsError}}" class="studio-outline refresh-button" bindtap="refreshRecords" loading="{{recordsLoading}}" disabled="{{recordsLoading}}">重新加载</button>
    </block>
    <block wx:elif="{{view === 'works'}}"><view wx:if="{{!worksLoaded && worksLoading}}" class="empty">作品加载中…</view><view wx:elif="{{!worksLoaded && worksError}}" class="empty">{{worksError}}</view><button wx:for="{{works}}" wx:key="id" class="creation-card saved-work" data-task="{{item.taskId}}" bindtap="openWork"><image src="{{item.image}}" mode="aspectFill" /><view><text>{{item.title}}</text></view><image class="studio-chevron" src="/assets/creation-chevron.png" /></button><view wx:if="{{worksLoaded && !works.length}}" class="empty">暂无已保存作品</view><view class="list-feedback studio-muted"><text wx:if="{{worksLoaded}}">{{worksError || (worksLoading ? '正在更新作品…' : '')}}</text></view><view class="page-actions"><button class="studio-outline refresh-button" bindtap="refreshData" loading="{{worksLoading}}" disabled="{{worksLoading}}">{{worksError ? '重新加载' : '刷新作品'}}</button><button class="studio-outline refresh-button" bindtap="openTasks">前往任务中心</button></view></block>
    <block wx:elif="{{view === 'recent'}}"><button wx:for="{{recent}}" wx:key="id" class="creation-card saved-work" data-id="{{item.id}}" bindtap="openRecent"><image src="{{item.image}}" mode="aspectFill" /><view><text>{{item.title}}</text><text class="studio-muted">{{item.badge}} · {{item.action}}</text></view><image class="studio-chevron" src="/assets/creation-chevron.png" /></button><view wx:if="{{!recent.length}}" class="creation-empty">暂无最近创作</view></block><block wx:elif="{{view === 'library'}}"><include src="./material-library.wxml" /></block>
  </view>
</view>
<view wx:if="{{sheet}}" class="creation-sheet-overlay" style="bottom:{{sheet==='editor'?editorKeyboardBottom||0:0}}px" bindtap="closeSheet" catchtouchmove="noop"><view class="creation-sheet {{sheet==='editor'?'creation-editor-sheet':''}} {{editorKeyboardOpen?'keyboard-open':''}}" style="{{sheet==='editor'?'height:'+editorSheetHeight+'px':''}}" catchtap="noop"><view class="creation-sheet-header"><text>{{sheetTitle}}</text><button class="creation-sheet-close" bindtap="closeSheet">关闭</button></view>
  <block wx:if="{{sheet === 'optimize'}}"><text class="creation-sheet-text">{{optimizationRetry?'继续确认上次优化结果；已修改的稿件会保留。':'保留当前文案的建房信息，优化表达与结尾互动。'}}</text><view class="copy-optimize-options"><button wx:for="{{['口语自然','重点清晰','精简表达']}}" wx:key="*this" class="copy-optimize-option {{optimizeRequirement===item?'selected':''}}" data-value="{{item}}" bindtap="inputOptimization" disabled="{{optimizing||optimizationRetry}}">{{item}}</button></view><button class="studio-primary sheet-confirm" bindtap="optimizeScript" loading="{{optimizing}}" disabled="{{optimizing||rewriting}}">{{optimizing?'优化中…':(optimizationRetry?'继续确认优化结果':'确认AI优化')}}</button></block>
  <block wx:elif="{{sheet === 'editor'}}"><text class="creation-sheet-text">草稿自动暂存，保存后用于生成。</text><view class="creation-resizable"><textarea style="height:{{editorInputHeight}}px" class="creation-sheet-input" adjust-position="{{false}}" cursor-spacing="16" bindkeyboardheightchange="editorKeyboardChange" show-confirm-bar="{{true}}" value="{{editingText}}" bindinput="inputEdit" maxlength="7000" aria-label="编辑口播文案" /><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="editor" data-normal="220" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded.editor?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view><button class="studio-primary sheet-confirm" bindtap="saveScript">保存文案</button></block>
  <block wx:elif="{{sheet === 'actor' || sheet === 'voice'}}"><button wx:for="{{sheet==='actor'?avatarOptions:voiceOptions}}" wx:key="id" class="creation-sheet-row" data-id="{{item.id}}" bindtap="{{sheet==='actor'?'selectActor':'selectVoice'}}"><text>{{item.title}}{{item.isDefault?'（默认）':''}}</text><text>{{(sheet==='actor'?avatarCloneId:voiceCloneId)===item.id?'已选':'选择'}}</text></button><text wx:if="{{sheet==='actor'?!avatarOptions.length:!voiceOptions.length}}" class="studio-muted">暂无已就绪资源，请到人物库制作。</text></block>
  <block wx:elif="{{sheet === 'cover'}}"><button class="creation-sheet-row" bindtap="uploadPublicationCover" disabled="{{coverUploading||coverGenerating||coverUsing}}"><text>上传封面</text><text class="studio-muted">JPG / PNG</text></button><button class="creation-sheet-row" bindtap="openCoverTemplates"><text>模板生成封面</text><text class="studio-muted">选择模板与标题</text></button><button wx:if="{{coverAssetId}}" class="creation-sheet-row" bindtap="removePublicationCover" disabled="{{coverUploading||coverUsing}}">移除封面</button></block>
  <block wx:elif="{{sheet === 'cover-templates'}}"><include src="./publication-cover-templates.wxml"/></block>
  <block wx:elif="{{sheet === 'publisher-accounts'}}">
    <text class="studio-muted">{{publicationPlatforms[selectedAccount].name}} · 账号用于发布登记</text>
    <text wx:if="{{publisherAccountsLoading}}" class="studio-muted">正在读取账号…</text>
    <view wx:elif="{{publisherAccountsError}}"><text class="operation-error">{{publisherAccountsError}}</text><button class="studio-outline" bindtap="loadPublisherAccounts">重新加载</button></view>
    <view wx:for="{{publisherAccountsAll}}" wx:key="id" class="publication-account-manage-row"><view class="publication-account-label"><text>{{item.displayName}}{{item.enabled?'':' · 已停用'}}</text><text class="studio-muted">{{item.identifier}}</text></view><view class="publication-account-actions"><button data-id="{{item.id}}" bindtap="editPublisherAccount" disabled="{{publisherAccountBusy}}">改名</button><button data-id="{{item.id}}" bindtap="togglePublisherAccount" disabled="{{publisherAccountBusy}}">{{item.enabled?'停用':'启用'}}</button></view></view>
    <text wx:if="{{publisherAccountEditError}}" class="operation-error" role="alert">{{publisherAccountEditError}}</text>
    <button class="studio-primary sheet-confirm" bindtap="editPublisherAccount" disabled="{{publisherAccountBusy}}">添加账号</button>
  </block>
  <block wx:elif="{{sheet === 'publisher-account-edit'}}"><view class="publication-account-form"><text>账号名称</text><input value="{{publisherAccountNameInput}}" bindinput="inputPublisherAccountName" maxlength="64" placeholder="填写账号名称" disabled="{{publisherAccountBusy}}"/><text>平台账号标识</text><input wx:if="{{!publisherAccountEditingId}}" value="{{publisherAccountIdentifierInput}}" bindinput="inputPublisherAccountIdentifier" maxlength="100" placeholder="填写抖音号或视频号唯一标识" disabled="{{publisherAccountBusy}}"/><text wx:else class="studio-muted">{{publisherAccountIdentifierInput}}</text><text class="studio-muted">仅用于登记，不会自动获得平台发布授权。</text><text wx:if="{{publisherAccountEditError}}" class="operation-error" role="alert">{{publisherAccountEditError}}</text><button class="studio-primary" bindtap="savePublisherAccount" loading="{{publisherAccountBusy}}" disabled="{{publisherAccountBusy}}">保存账号</button></view></block>
  <block wx:elif="{{sheet === 'accounts'}}"><button wx:for="{{publicationPlatforms}}" wx:key="platform" class="creation-sheet-row" data-index="{{index}}" bindtap="selectAccount"><image class="platform-icon" src="/pages/studio/assets/studio-{{item.platform}}.jpg" /><text>{{item.name}}</text><text>{{selectedAccount === index ? '已选' : '选择'}}</text></button></block>

</view></view>
