.publication-platforms { display:flex; gap:16rpx; margin-bottom:24rpx; }
.publication-platforms button { flex:1; min-width:0; min-height:88rpx; display:flex; align-items:center; justify-content:center; gap:12rpx; border:2rpx solid var(--creation-border); border-radius:16rpx; font-size:var(--zs-font-body); }
.publication-platforms button.is-selected { border-color:var(--creation-brand); background:var(--creation-soft); color:var(--creation-brand); }
.publication-account-option { width:100%; min-height:100rpx; display:flex; align-items:center; gap:16rpx; padding:16rpx; text-align:left; border:1rpx solid var(--creation-border); border-radius:16rpx; margin-top:12rpx; }
.publication-account-option.is-selected { border-color:var(--creation-brand); background:var(--creation-soft); }
.publication-account-label { flex:1; min-width:0; display:flex; flex-direction:column; gap:6rpx; overflow-wrap:anywhere; }
.publication-account-label > text:first-child { font-size:var(--zs-font-emphasis); }
.publication-account-option .account-check { margin-left:auto; width:32rpx; height:32rpx; }
.publication-account-feedback { padding:24rpx 0; display:flex; flex-direction:column; gap:16rpx; }
.publication-account-manage-row { padding:20rpx 0; border-bottom:1rpx solid var(--creation-border); }
.publication-account-actions { display:flex; gap:16rpx; margin-top:12rpx; }
.publication-account-actions button { flex:1; min-width:0; min-height:80rpx; font-size:var(--zs-font-body); border:1rpx solid var(--creation-border); border-radius:12rpx; }
.publication-account-form { display:flex; flex-direction:column; gap:16rpx; }
.publication-account-form input { box-sizing:border-box; width:100%; min-height:88rpx; padding:16rpx; border:1rpx solid var(--creation-border); border-radius:12rpx; }
.publish-preview-note { display:block; margin-top:12rpx; font-size:var(--zs-font-meta); line-height:36rpx; }
.publish-link-url { display:block; width:100%; height:180rpx; min-height:180rpx; box-sizing:border-box; padding:20rpx; font-size:var(--zs-font-emphasis); line-height:42rpx; word-break:break-all; }
.publish-help { display:block; margin-top:16rpx; font-size:var(--zs-font-meta); line-height:36rpx; }
.lead-form { padding:var(--zs-space-card); }
.lead-input { display:block; width:100%; min-height:44px; margin-bottom:16rpx; padding:16rpx; font-size:var(--zs-font-emphasis); box-sizing:border-box; }
.lead-need { display:block; width:100%; height:160rpx; min-height:160rpx; margin-bottom:16rpx; padding:16rpx; font-size:var(--zs-font-emphasis); line-height:42rpx; box-sizing:border-box; }

.publication-cover-empty { display:flex; align-items:center; justify-content:center; background:var(--creation-soft); color:var(--creation-muted); font-size:var(--zs-font-meta); text-align:center; }
.publication-cover-feedback { display:flex; flex-direction:column; gap:12rpx; margin-bottom:24rpx; }
.publication-detail-cover { width:120rpx; height:120rpx; border-radius:12rpx; flex-shrink:0; }
.publication-cover-template-scroll { height:66vh; }
.publication-cover-generation-status,.publication-cover-candidate,.publication-cover-template-form { display:flex; flex-direction:column; gap:20rpx; padding:12rpx 0 28rpx; }
.publication-cover-generation-status { padding:24rpx; margin-bottom:16rpx; border-radius:16rpx; background:var(--creation-soft); }
.publication-cover-generated-image { width:100%; height:560rpx; background:var(--creation-soft); border-radius:16rpx; }
.publication-cover-generated-empty { min-height:240rpx; display:flex; align-items:center; justify-content:center; }
.publication-cover-field-label { font-size:var(--zs-font-emphasis); font-weight:600; }
.publication-cover-template-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; }
.publication-cover-template { position:relative; min-width:0; width:100%; padding:12rpx; display:flex; flex-direction:column; gap:8rpx; border:2rpx solid var(--creation-border); border-radius:16rpx; text-align:left; font-size:var(--zs-font-body); }
.publication-cover-template.is-selected,.publication-cover-presets .is-selected { border-color:var(--creation-brand); background:var(--creation-soft); color:var(--creation-brand); }
.publication-cover-template image,.publication-cover-template-empty { width:100%; height:260rpx; border-radius:8rpx; }
.publication-cover-template-empty { display:flex; align-items:center; justify-content:center; }
.publication-cover-template-selected { position:absolute; top:20rpx; right:20rpx; padding:4rpx 12rpx; border-radius:8rpx; background:var(--creation-brand); color:#fff; }
.publication-cover-template-form input { box-sizing:border-box; width:100%; min-height:88rpx; padding:16rpx; border:1rpx solid var(--creation-border); border-radius:12rpx; }
.publication-cover-presets { display:flex; gap:16rpx; }
.publication-cover-presets button { flex:1; min-height:80rpx; border:2rpx solid var(--creation-border); border-radius:12rpx; }
