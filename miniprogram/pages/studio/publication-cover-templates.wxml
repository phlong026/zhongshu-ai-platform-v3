<scroll-view scroll-y class="publication-cover-template-scroll">
  <view wx:if="{{coverGenerationPending}}" class="publication-cover-generation-status">
    <text>{{coverGenerationMessage}}</text>
    <text class="studio-muted">{{coverGenerationRequestTitle}}</text>
    <button wx:if="{{!coverGenerationTerminal}}" class="studio-primary" bindtap="resumeCoverGeneration" loading="{{coverGenerating}}" disabled="{{coverGenerating}}">{{coverGenerating?'正在核对…':'继续核对上次结果'}}</button>
  </view>
  <text wx:if="{{coverGenerationError}}" class="operation-error" role="alert">{{coverGenerationError}}</text>
  <view wx:if="{{coverGenerationStatus==='READY'}}" class="publication-cover-candidate">
    <image wx:if="{{coverGeneratedPreview}}" class="publication-cover-generated-image" src="{{coverGeneratedPreview}}" mode="aspectFit" binderror="generatedCoverPreviewError"/>
    <view wx:elif="{{coverGeneratedPreviewLoading}}" class="publication-cover-generated-empty studio-muted">正在读取生成封面…</view>
    <view wx:else class="publication-cover-feedback"><text class="operation-error">{{coverGeneratedPreviewError || '封面预览暂不可用'}}</text><button class="studio-outline" bindtap="reloadGeneratedCover">重新读取预览</button></view>
    <text class="studio-muted">生成文字可能有所调整，使用前请核对。</text>
    <button class="studio-primary" bindtap="useGeneratedCover" loading="{{coverUsing}}" disabled="{{coverUsing||coverGenerating||!coverGeneratedPreview||coverGeneratedPreviewLoading}}">使用此封面</button>
    <button class="studio-outline" bindtap="resetCoverGeneration" disabled="{{coverUsing||coverGenerating}}">重新选择模板</button>
  </view>
  <view wx:if="{{!coverGenerationLocked}}" class="publication-cover-template-form">
    <text class="publication-cover-field-label">选择模板</text>
    <text wx:if="{{coverTemplatesLoading&&!coverTemplates.length}}" class="studio-muted">正在加载模板…</text>
    <view wx:if="{{coverTemplatesError}}" class="publication-cover-feedback"><text class="operation-error">{{coverTemplatesError}}</text><button class="studio-outline" bindtap="loadCoverTemplates" disabled="{{coverTemplatesLoading}}">重新加载模板</button></view>
    <text wx:elif="{{coverTemplatesLoaded&&!coverTemplates.length&&!coverTemplatesLoading}}" class="studio-muted">暂无可用封面模板</text>
    <view class="publication-cover-template-grid">
      <button wx:for="{{coverTemplates}}" wx:key="id" class="publication-cover-template {{coverTemplateId===item.id?'is-selected':''}}" data-id="{{item.id}}" bindtap="selectCoverTemplate" disabled="{{coverGenerating}}">
        <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFit"/>
        <view wx:else class="publication-cover-template-empty studio-muted">模板预览暂不可用</view>
        <text>{{item.title}}</text><text wx:if="{{coverTemplateId===item.id}}" class="publication-cover-template-selected">已选</text>
      </button>
    </view>
    <button wx:if="{{coverTemplatesHasMore}}" class="studio-outline" bindtap="moreCoverTemplates" loading="{{coverTemplatesLoading}}" disabled="{{coverTemplatesLoading}}">更多模板</button>
    <text class="publication-cover-field-label">封面标题</text>
    <input value="{{coverGenerationTitle}}" bindinput="inputCoverGenerationTitle" maxlength="200" placeholder="填写封面要表达的标题" disabled="{{coverGenerating}}"/>
    <text class="publication-cover-field-label">封面比例</text>
    <view class="publication-cover-presets"><button wx:for="{{['9:16','3:4']}}" wx:key="*this" class="{{coverCanvasPreset===item?'is-selected':''}}" data-value="{{item}}" bindtap="selectCoverCanvas" disabled="{{coverGenerating}}">{{item}}</button></view>
    <text class="studio-muted">生成后先确认预览，再用于发布。</text>
    <button class="studio-primary" bindtap="generatePublicationCover" loading="{{coverGenerating}}" disabled="{{coverGenerating||!coverTemplateId||!coverGenerationTitle}}">生成封面</button>
  </view>
</scroll-view>
