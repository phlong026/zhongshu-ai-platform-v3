<view class="plan-page">
  <business-header title="{{creating?'新建合同':'付款计划'}}" />
  <view wx:if="{{!ready}}" class="plan-empty"><text>{{loading?'正在加载付款计划…':error||'付款计划暂不可用'}}</text><view wx:if="{{!loading}}" class="plan-actions"><button class="plan-secondary" bindtap="load">重新加载</button><button class="plan-secondary" bindtap="chooseIdentity">登录／切换身份</button></view></view>
  <view wx:else class="plan-body">
    <view class="plan-card plan-summary">
      <view class="plan-heading"><text>{{customerName||'合同付款计划'}}</text><text class="plan-badge">{{creating?'待签合同':context.statusLabel}}</text></view>
      <text wx:if="{{context}}" class="plan-muted">付款计划 V{{context.planVersion||1}}</text>
      <text wx:if="{{creating&&quoteSource}}" class="plan-muted">已带入{{quoteSource}}，请按正式约定填写付款节点。</text>
      <view wx:if="{{!editing}}" class="plan-total">¥ {{context.totalText}}</view>
      <view class="plan-summary-actions"><text class="plan-muted">{{refreshing?'正在更新…':context&&!context.canEdit?'只读查看':''}}</text><button wx:if="{{context}}" class="plan-link" bindtap="toggleHistory" disabled="{{busy}}">{{showHistory?'返回付款计划':'变更记录'}}</button></view>
    </view>
    <view wx:if="{{error}}" class="plan-error"><text>{{error}}</text><button wx:if="{{uncertain}}" class="plan-link" bindtap="runPending" disabled="{{busy}}" loading="{{busy}}">重试核对</button><button wx:elif="{{!busy}}" class="plan-link" bindtap="reloadLatest">载入最新</button></view>
    <view wx:if="{{conflict}}" class="plan-error"><text>{{creating?'所选报价已变化，请返回客户页面重新选择或手动办理。':'合同已有更新，请载入最新版本后调整。'}}</text><button class="plan-link" bindtap="reloadLatest">载入最新</button></view>
    <view wx:if="{{showHistory}}" class="plan-card">
      <button wx:for="{{history}}" wx:key="version" class="plan-history" data-version="{{item.version}}" bindtap="viewVersion"><view class="plan-heading"><text>付款计划 V{{item.version}}</text><text>¥ {{item.totalText}}</text></view><text class="plan-muted">{{item.createdOn}} {{item.actorName}}</text><text class="plan-note">{{item.reason||'创建付款计划'}}</text></button>
      <text wx:if="{{historyLoading}}" class="plan-state">正在加载变更记录…</text><view wx:elif="{{historyError}}" class="plan-state"><text>{{historyError}}</text><button class="plan-link" bindtap="loadHistory">重新加载</button></view><text wx:elif="{{!history.length}}" class="plan-state">暂无付款计划变更记录</text>
    </view>
    <block wx:else>
      <view wx:if="{{editing}}" class="plan-card">
        <view class="plan-field"><text class="plan-label">合同总额</text><view class="plan-input-unit"><input class="plan-input" type="digit" value="{{form.total}}" data-key="total" bindinput="input" maxlength="14" disabled="{{busy||uncertain||conflict}}" placeholder="填写合同总额"/><text>元</text></view></view>
        <view class="plan-modes"><button class="{{form.mode==='RATIO'?'selected':''}}" data-mode="RATIO" bindtap="chooseMode" disabled="{{busy||uncertain||conflict}}">按比例</button><button class="{{form.mode==='AMOUNT'?'selected':''}}" data-mode="AMOUNT" bindtap="chooseMode" disabled="{{busy||uncertain||conflict}}">按金额</button></view>
        <view class="plan-allocation"><text>已分配 {{summary.allocatedText}}</text><text class="{{summary.valid?'complete':''}}">{{summary.balanceText}}</text></view>
        <text wx:if="{{form.mode==='RATIO'}}" class="plan-muted">按合同总额换算，分币尾差计入最后一期。</text>
      </view>
      <view class="plan-section-heading"><text>付款节点</text><text class="plan-muted">{{form.rows.length}}期</text></view>
      <view wx:for="{{summary.rows}}" wx:key="key" class="plan-card plan-stage">
        <view class="plan-heading"><text>第{{item.number}}期</text><view wx:if="{{editing}}" class="plan-row-tools"><button class="plan-link" data-row="{{item.key}}" data-direction="-1" bindtap="moveRow" disabled="{{index===0||busy||uncertain||conflict}}">上移</button><button class="plan-link" data-row="{{item.key}}" data-direction="1" bindtap="moveRow" disabled="{{index===form.rows.length-1||busy||uncertain||conflict}}">下移</button><button class="plan-link" data-row="{{item.key}}" bindtap="removeRow" disabled="{{!item.removable||busy||uncertain||conflict}}">删除</button></view></view>
        <block wx:if="{{editing}}">
          <view class="plan-field"><text class="plan-label">节点名称</text><input class="plan-input" value="{{item.label}}" data-key="label" data-row="{{item.key}}" bindinput="input" maxlength="64" disabled="{{busy||uncertain||conflict}}" placeholder="如：签约款、主体封顶款"/></view>
          <view class="plan-field"><text class="plan-label">{{form.mode==='RATIO'?'付款比例':'约定金额'}}</text><view class="plan-input-unit"><input class="plan-input" type="digit" value="{{form.mode==='RATIO'?item.ratio:item.amount}}" data-key="{{form.mode==='RATIO'?'ratio':'amount'}}" data-row="{{item.key}}" bindinput="input" maxlength="14" disabled="{{busy||uncertain||conflict}}" placeholder="{{form.mode==='RATIO'?'填写比例':'填写金额'}}"/><text>{{form.mode==='RATIO'?'%':'元'}}</text></view><text wx:if="{{form.mode==='RATIO'&&item.amountText}}" class="plan-muted plan-converted">约定金额 ¥{{item.amountText}}</text></view>
          <text wx:if="{{item.stageId&&item.amount==='0.00'}}" class="plan-validation">原计划未约定此期金额，请填写金额或删除此期。已有财务记录的节点须保留。</text>
          <view class="plan-field"><text class="plan-label">到期条件</text><picker range="{{item.triggerChoices}}" range-key="label" value="{{item.triggerIndex}}" data-row="{{item.key}}" bindchange="trigger" disabled="{{busy||uncertain||conflict}}"><view class="plan-input plan-picker"><text>{{item.triggerLabel}}</text><text>⌄</text></view></picker></view>
          <view wx:if="{{item.trigger==='NODE_COMPLETED'}}" class="plan-field"><text class="plan-label">工程节点序号</text><input class="plan-input" type="number" value="{{item.nodeIndex}}" data-key="nodeIndex" data-row="{{item.key}}" bindinput="input" maxlength="3" disabled="{{busy||uncertain||conflict}}" placeholder="填写工程计划中的节点序号（1–100）"/></view>
          <view class="plan-field"><view class="plan-label-row"><text class="plan-label">到期日期{{item.trigger==='DATE'?'':'（选填）'}}</text><button wx:if="{{item.dueDate}}" class="plan-link" data-key="dueDate" data-row="{{item.key}}" bindtap="clearDate" disabled="{{busy||uncertain||conflict}}">清除</button></view><picker mode="date" value="{{item.dueDate}}" data-key="dueDate" data-row="{{item.key}}" bindchange="input" disabled="{{busy||uncertain||conflict}}"><view class="plan-input plan-picker"><text>{{item.dueDate||'选择到期日期'}}</text><text>⌄</text></view></picker></view>
        </block>
        <block wx:else><text class="plan-stage-label">{{item.label}}</text><view class="plan-amount-line"><text class="plan-stage-amount">¥ {{item.amount}}</text><text wx:if="{{item.ratio}}" class="plan-muted">{{item.ratio}}%</text></view><view class="plan-fact"><text>到期条件</text><text>{{item.triggerLabel}}{{item.trigger==='NODE_COMPLETED'?' · 第'+item.nodeIndex+'个节点':''}}</text></view><view wx:if="{{item.dueDate}}" class="plan-fact"><text>到期日期</text><text>{{item.dueDate}}</text></view></block>
        <view wx:if="{{item.collectedCents}}" class="plan-collected">已确认净收款 ¥{{item.collectedText}}</view>
      </view>
      <button wx:if="{{editing}}" class="plan-secondary plan-add" bindtap="addRow" disabled="{{form.rows.length>=20||busy||uncertain||conflict}}">＋ 添加付款节点</button>
      <view wx:if="{{editing}}" class="plan-card">
        <view wx:if="{{creating}}" class="plan-field"><view class="plan-label-row"><text class="plan-label">签约日期（选填）</text><button wx:if="{{form.signedDate}}" class="plan-link" data-key="signedDate" bindtap="clearDate" disabled="{{busy||uncertain||conflict}}">清除</button></view><picker mode="date" end="{{today}}" value="{{form.signedDate}}" data-key="signedDate" bindchange="input" disabled="{{busy||uncertain||conflict}}"><view class="plan-input plan-picker"><text>{{form.signedDate||'选择签约日期'}}</text><text>⌄</text></view></picker></view>
        <view wx:else class="plan-field"><text class="plan-label">调整原因</text><textarea class="plan-input plan-textarea" value="{{form.reason}}" data-key="reason" bindinput="input" maxlength="500" auto-height disabled="{{busy||uncertain||conflict}}" placeholder="填写与客户确认的调整内容及原因"/></view>
        <text wx:if="{{dirty&&!summary.valid}}" class="plan-validation">{{summary.errors[0]}}</text>
      </view>
      <button wx:elif="{{context.canEdit}}" class="plan-primary plan-edit" bindtap="startEdit">调整付款计划</button>
    </block>
  </view>
  <view wx:if="{{ready&&editing&&!showHistory}}" class="plan-footer"><view><text>{{summary.balanceText}}</text><text class="plan-muted">{{form.rows.length}}期 · 合同总额 ¥{{summary.totalText||'—'}}</text></view><button class="plan-primary" bindtap="submit" loading="{{busy}}" disabled="{{busy||uncertain||conflict}}">{{creating?'创建待签合同':'保存调整'}}</button></view>
  <view wx:if="{{selectedVersion}}" class="plan-sheet-mask" catchtap="closeVersion"><view class="plan-sheet" catchtap="noop"><view class="plan-heading"><text>付款计划 V{{selectedVersion.version}}</text><button class="plan-link" bindtap="closeVersion">关闭</button></view><scroll-view scroll-y class="plan-sheet-content"><text class="plan-muted">{{selectedVersion.createdOn}} {{selectedVersion.actorName}}</text><view class="plan-total">¥ {{selectedVersion.totalText}}</view><text class="plan-note">{{selectedVersion.reason}}</text><view wx:for="{{selectedVersion.rows}}" wx:key="key" class="plan-version-row"><view class="plan-fact"><text>{{item.label}}</text><text>¥ {{item.amountText}}</text></view><text class="plan-muted">{{item.triggerLabel}}{{item.dueDate?' · '+item.dueDate:''}}</text></view></scroll-view></view></view>
</view>
