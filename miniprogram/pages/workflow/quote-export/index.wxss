page{background:#faf8f4;color:#24211f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.export-content{padding:28rpx 28rpx 64rpx}.export-summary,.export-card{padding:28rpx;margin-bottom:24rpx;background:#fff;border:1rpx solid #e8e0d8;border-radius:20rpx}.export-title,.export-total,.export-hint{display:block}.export-title,.export-card-title{font-size:32rpx;font-weight:600;margin-bottom:18rpx}.export-total{font-size:48rpx;color:#81522e;margin:16rpx 0}.export-hint{font-size:24rpx;line-height:1.7;color:#77716c}.export-fields{display:flex;flex-wrap:wrap;gap:20rpx;margin-top:22rpx}.export-fields label{width:calc(50% - 10rpx);font-size:25rpx;line-height:40rpx}.export-fields input,.export-select{font-size:26rpx;height:72rpx;line-height:72rpx;border:1rpx solid #ded7d0;padding:0 14rpx;border-radius:10rpx;margin-top:6rpx;box-sizing:border-box}.export-options{display:flex;flex-wrap:wrap;gap:14rpx;margin:26rpx 0}.export-options button{font-size:24rpx;line-height:56rpx;padding:0 18rpx;margin:0;background:#f7f3ee;color:#655a50;border:1rpx solid #e9e1d8}.export-options .selected{color:#81522e;border-color:#81522e}.export-refresh,.export-share{font-size:27rpx;background:#f5efe8;color:#81522e;line-height:80rpx}.quote-sheet-preview{display:block;width:100%;height:auto;background:#fff;border:1rpx solid #eee}.export-actions{display:flex;gap:20rpx}.export-actions button{flex:1;font-size:28rpx;line-height:88rpx;margin:0;background:#81522e;color:#fff}.export-actions .export-png{background:#fff;color:#81522e;border:1rpx solid #81522e}.export-error{color:#9b3e20;background:#fff1e9;border-radius:12rpx;padding:24rpx;margin-bottom:24rpx;font-size:26rpx;line-height:1.6}.export-share{margin-top:20rpx}.quote-export-canvas{position:fixed;left:-4000px;top:0;width:794px;height:1123px;pointer-events:none}

.export-total{font-weight:700}
