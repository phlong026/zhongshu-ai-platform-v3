page{background:var(--zs-bg);color:#24211f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.export-content{padding:28rpx 28rpx 64rpx}.export-summary,.export-card{padding:28rpx;margin-bottom:24rpx;background:var(--zs-card);border:1rpx solid #e8e0d8;border-radius:20rpx}.export-title,.export-total,.export-hint{display:block}.export-title,.export-card-title{font-size:var(--zs-font-title);font-weight:600;margin-bottom:18rpx}.export-total{font-size:var(--zs-font-metric);color:var(--zs-brand);margin:16rpx 0}.export-hint{font-size:var(--zs-font-meta);line-height:1.7;color:#77716c}.export-fields{display:flex;flex-wrap:wrap;gap:20rpx;margin-top:22rpx}.export-fields label{width:calc(50% - 10rpx);font-size:var(--zs-font-body);line-height:40rpx}.export-fields input,.export-select{font-size:var(--zs-font-body);height:72rpx;line-height:72rpx;border:1rpx solid #ded7d0;padding:0 14rpx;border-radius:10rpx;margin-top:6rpx;box-sizing:border-box}.export-options{display:flex;flex-wrap:wrap;gap:14rpx;margin:26rpx 0}.export-options button{font-size:var(--zs-font-meta);line-height:56rpx;padding:0 18rpx;margin:0;background:#f7f3ee;color:#655a50;border:1rpx solid #e9e1d8}.export-options .selected{color:var(--zs-brand);border-color:var(--zs-brand)}.export-refresh,.export-share{font-size:var(--zs-font-emphasis);background:#f5efe8;color:var(--zs-brand);line-height:80rpx}.quote-sheet-preview{display:block;width:100%;height:auto;background:var(--zs-card);border:1rpx solid #eee}.export-actions{display:flex;gap:20rpx}.export-actions button{flex:1;font-size:var(--zs-font-emphasis);line-height:88rpx;margin:0;background:var(--zs-brand);color:var(--zs-card)}.export-actions .export-png{background:var(--zs-card);color:var(--zs-brand);border:1rpx solid var(--zs-brand)}.export-error{color:#9b3e20;background:#fff1e9;border-radius:12rpx;padding:24rpx;margin-bottom:24rpx;font-size:var(--zs-font-body);line-height:1.6}.export-share{margin-top:20rpx}.quote-export-canvas{position:fixed;left:-4000px;top:0;width:794px;height:1123px;pointer-events:none}

.export-total{font-weight:700}
