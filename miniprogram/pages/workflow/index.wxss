/* The four design entries share the business workbench's typography and copper palette. */
.design-flow{--biz:#89512a;--muted:var(--business-muted);--soft:#f7f3ed;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:26rpx;font-weight:400;line-height:1.5;color:#141312}
.workflow.design-flow{background:#faf8f4}
.design-flow button,.design-flow input,.design-flow textarea{font-family:inherit}
.design-flow .heading{font-family:"Songti SC","STSong","SimSun",serif;font-size:36rpx;font-weight:700;line-height:1.2;letter-spacing:1rpx}
.design-flow .heading>.muted,.design-flow .heading>.link,.design-flow .heading>.amount,.design-flow .heading>.success-text{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;letter-spacing:0}
.design-flow .btn{font-size:26rpx;font-weight:400;line-height:36rpx;letter-spacing:0;border-radius:20rpx;min-height:88rpx;color:#fffaf3}
.design-flow .outline.btn{color:var(--biz);background:transparent}
.design-flow .page-actions>.btn{line-height:36rpx}
.design-flow .input,.design-flow .input input,.design-flow .search input,.design-flow .textarea,.design-flow .dimension-row,.design-flow .input-row{font-size:26rpx;font-weight:400;line-height:36rpx}
.design-flow .tabs button{font-size:26rpx;line-height:36rpx;font-weight:400}
.design-flow .tabs button.active,.design-flow .option.selected{background:#f7eee4;color:var(--biz);font-weight:500}
.design-flow .plan-choice.chosen{border-color:var(--biz);background:#fffaf5}
.design-flow .sheet-head{font-family:"Songti SC","STSong","SimSun",serif;font-size:36rpx;font-weight:700;line-height:1.2;letter-spacing:1rpx}
.design-flow .operation-identity{color:var(--biz);background:var(--soft)}

/* Unified sales typography and rhythm; existing workflow states and controls remain intact. */
.workflow.workflow{--biz:var(--business-brand);--muted:var(--business-muted);--soft:#f7f3ed;--line:#eee8df;background:#faf8f4;color:#141312;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:42rpx;letter-spacing:0}
.workflow.workflow button,.workflow.workflow input,.workflow.workflow textarea{font-family:inherit;letter-spacing:0}.workflow.workflow .body{padding-left:28rpx;padding-right:28rpx}.workflow.workflow .card{border-color:#eee8df;border-radius:22rpx}.workflow.workflow .heading,.workflow.workflow .sheet-head{font-family:inherit;font-size:32rpx;font-weight:600;line-height:46rpx;letter-spacing:0}.workflow.workflow .heading>.muted,.workflow.workflow .heading>.link{font-size:24rpx;line-height:36rpx;font-weight:400;letter-spacing:0}.workflow.workflow .muted,.workflow.workflow .hint{font-size:24rpx;line-height:36rpx;color:#9a9187}.workflow.workflow .name{font-size:30rpx;line-height:44rpx;font-weight:500}.workflow.workflow .btn{font-family:inherit;font-size:28rpx;font-weight:500;line-height:42rpx;border-radius:14rpx}.workflow.workflow .page-actions>.btn{line-height:42rpx}.workflow.workflow .input,.workflow.workflow .input input,.workflow.workflow .textarea,.workflow.workflow .input-row,.workflow.workflow .block-text,.workflow.workflow .row-title{font-family:inherit;font-size:28rpx;font-weight:400;line-height:42rpx}.workflow.workflow .sheet{border-radius:24rpx 24rpx 0 0}.workflow.workflow .sheet .input-row>.label{font-size:26rpx;line-height:40rpx}.workflow.workflow .badge{font-size:22rpx;line-height:32rpx}.workflow.workflow .operation-identity{background:#f7f3ed;color:#89512a;font-size:24rpx;line-height:36rpx}

.workflow .plan-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.workflow .plan-pair>view:only-child{grid-column:1 / -1}.workflow .budget-next{margin-top:24rpx;width:100%}

.journey-steps{gap:4rpx;margin:16rpx 0 4rpx}.journey-steps .flow-step{font-size:21rpx;line-height:30rpx;gap:8rpx}
.progress-now{margin-top:18rpx}.progress-now text{display:block}.progress-now .muted{margin-top:6rpx}
.workflow .list-title .customer-register{flex:0 0 auto;min-height:88rpx;padding:14rpx 24rpx;color:#fffaf3}

/* Keep the follow action at the page bottom without covering long records. */
.workflow.customer-workspace{display:flex;flex-direction:column;box-sizing:border-box}
.customer-workspace>business-header{flex-shrink:0}
.customer-workspace>.body{display:flex;flex:1;flex-direction:column}
.customer-workspace>.body>view{flex-shrink:0}
.customer-workspace .customer-follow-actions{margin-top:auto}
