/* Supplemental business pages reuse the existing cards, fields and status surfaces. */



.operation-identity{font-size:var(--zs-font-meta);color:#995627;background:#fcf5e9;padding:13rpx 20rpx;border-radius:10rpx;margin-bottom:16rpx}.operation-identity text{font-size:var(--zs-font-caption);color:#9299a5}

/* Unified sales typography and rhythm; existing workflow states and controls remain intact. */.workflow.workflow{--biz:var(--business-brand);--muted:var(--business-muted);--soft:#f7f3ed;--line:var(--zs-line);background:var(--zs-bg);color:var(--zs-ink);font-family:var(--zs-font-family);font-size:var(--zs-font-emphasis);line-height:42rpx;letter-spacing:0}
.workflow.workflow button,.workflow.workflow input,.workflow.workflow textarea{font-family:var(--zs-font-family);letter-spacing:0}.workflow.workflow .body{padding-left:var(--zs-space-page);padding-right:var(--zs-space-page)}.workflow.workflow .card{border-color:var(--zs-line);border-radius:22rpx}.workflow.workflow .heading,.workflow.workflow .sheet-head{font-family:var(--zs-font-family);font-size:var(--zs-font-title);font-weight:600;line-height:46rpx;letter-spacing:0}.workflow.workflow .heading>.muted,.workflow.workflow .heading>.link{font-size:var(--zs-font-meta);line-height:36rpx;font-weight:400;letter-spacing:0}.workflow.workflow .muted,.workflow.workflow .hint{font-size:var(--zs-font-meta);line-height:36rpx;color:var(--zs-text-3)}.workflow.workflow .name{font-size:var(--zs-font-title);line-height:44rpx;font-weight:500}.workflow.workflow .btn{font-family:var(--zs-font-family);font-size:var(--zs-font-emphasis);font-weight:500;line-height:42rpx;border-radius:14rpx}.workflow.workflow .page-actions>.btn{line-height:42rpx}.workflow.workflow .input,.workflow.workflow .input input,.workflow.workflow .textarea,.workflow.workflow .input-row,.workflow.workflow .row-title{font-family:var(--zs-font-family);font-size:var(--zs-font-emphasis);font-weight:400;line-height:42rpx}.workflow.workflow .sheet{border-radius:24rpx 24rpx 0 0}.workflow.workflow .sheet .input-row>.label{font-size:var(--zs-font-body);line-height:40rpx}.workflow.workflow .badge{font-size:var(--zs-font-caption);line-height:32rpx}.workflow.workflow .operation-identity{background:#f7f3ed;color:var(--zs-brand);font-size:var(--zs-font-meta);line-height:36rpx}.workflow .budget-next{margin-top:24rpx;width:100%}

.journey-steps{gap:4rpx;margin:16rpx 0 4rpx}.journey-steps .flow-step{font-size:var(--zs-font-caption);line-height:30rpx;gap:8rpx}
.progress-now{margin-top:18rpx}.progress-now text{display:block}.progress-now .muted{margin-top:6rpx}
.workflow .list-title .customer-register{flex:0 0 auto;min-height:88rpx;padding:14rpx 24rpx;color:#fffaf3}

/* Keep the follow action at the page bottom without covering long records. */.workflow.customer-workspace{display:flex;flex-direction:column;box-sizing:border-box}
.customer-workspace>business-header{flex-shrink:0}
.customer-workspace>.body{display:flex;flex:1;flex-direction:column}
.customer-workspace>.body>view{flex-shrink:0}
.customer-workspace .customer-follow-actions{margin-top:auto}
/* 客户与交易页的窄屏卡片按行排布，避免姓名、电话及摘要在 compact 横排中溢出。 */.customer-workspace .customer-banner.compact .banner-info,.view-requirement .customer-banner.compact .banner-info,.view-budget .customer-banner.compact .banner-info,.view-contract .customer-banner.compact .banner-info,.view-progress .customer-banner.compact .banner-info,.view-delivery .customer-banner.compact .banner-info{display:block;min-width:0}
.customer-workspace .customer-banner .name,.view-requirement .customer-banner .name,.view-budget .customer-banner .name,.view-contract .customer-banner .name,.view-progress .customer-banner .name,.view-delivery .customer-banner .name{white-space:normal;flex-wrap:wrap}
.customer-workspace .customer-banner .customer-name,.view-requirement .customer-banner .customer-name,.view-budget .customer-banner .customer-name,.view-contract .customer-banner .customer-name,.view-progress .customer-banner .customer-name,.view-delivery .customer-banner .customer-name{min-width:0;overflow-wrap:anywhere}
.customer-workspace .customer-banner .banner-line,.view-requirement .customer-banner .banner-line,.view-budget .customer-banner .banner-line,.view-contract .customer-banner .banner-line,.view-progress .customer-banner .banner-line,.view-delivery .customer-banner .banner-line{white-space:normal;overflow-wrap:anywhere;margin-top:6rpx}

/* 进度合同按期逐行展示，避免 follow-record 的横排挤压期次和金额。 */.view-progress .progress-contract-card{display:block}
.view-progress .progress-contract-card>.flex{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.view-progress .progress-contract-card>.flex+.flex{margin-top:16rpx}
.view-progress .progress-contract-card .amount{flex-shrink:0;white-space:nowrap}

/* Form height follows the visible viewport; only the fields scroll. */.sheet.keyboard-sheet{display:flex;flex-direction:column;max-height:100%;box-sizing:border-box;padding:0;overflow:hidden}.keyboard-sheet .sheet-head{flex-shrink:0;margin:0;padding:24rpx 36rpx 16rpx}.keyboard-sheet .sheet-fields{flex:1;height:0;min-height:0;box-sizing:border-box;width:100%;padding:0 36rpx}.keyboard-sheet .sheet-actions{flex-shrink:0;padding:12rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));background:#fffefc}.keyboard-sheet .sheet-save{margin-top:0}.keyboard-sheet .sheet-actions .error{margin:0 0 10rpx;max-height:80rpx;overflow-y:auto}.keyboard-sheet .input-row{margin:20rpx 0}.keyboard-sheet .input-row>.label{width:216rpx;white-space:normal}.keyboard-sheet .field-label{margin-top:24rpx}.keyboard-sheet .textarea{box-sizing:border-box;height:180rpx;min-height:140rpx;margin-bottom:24rpx}.keyboard-sheet .contact-hint{margin:0}.customer-address-text{overflow-wrap:anywhere;white-space:normal}

/* 登记/编辑客户：压缩表头、字段间距与输入框高度，让整张表单尽量一屏完成。 */.sheet-register .sheet-head,.sheet-edit .sheet-head{padding:16rpx 32rpx 6rpx}
.sheet-register .sheet-fields,.sheet-edit .sheet-fields{padding:0 32rpx}
.sheet-register .input-row,.sheet-edit .input-row{min-height:64rpx;margin:8rpx 0}
.sheet-register .input-row>.label,.sheet-edit .input-row>.label{width:190rpx;line-height:40rpx}
.sheet-register .input,.sheet-edit .input{min-height:64rpx;padding:8rpx 18rpx}
.sheet-register .field-label,.sheet-edit .field-label{margin:10rpx 0 6rpx;line-height:36rpx}
.sheet-register .textarea,.sheet-edit .textarea{height:112rpx;min-height:112rpx;margin:4rpx 0 8rpx;padding:12rpx 18rpx;line-height:38rpx}
.sheet-register .contact-hint,.sheet-edit .contact-hint{margin:0 0 4rpx 190rpx}
.sheet-register .sheet-actions,.sheet-edit .sheet-actions{padding:8rpx 32rpx calc(16rpx + env(safe-area-inset-bottom))}

/* 跟进页四项设计入口：单行排布，减小卡片占用。 */.design-tools .heading{margin-bottom:10rpx}
.design-tools .tool-grid{gap:8rpx}
.design-tools .tool-grid>button{min-height:132rpx;gap:8rpx;padding:12rpx 6rpx}
.design-tools .tool-grid>button>image:first-child{width:64rpx;height:64rpx}
/* Contract collections keep reasons and amounts readable on narrow screens. */.sales-contract-stage{padding:22rpx 0;border-bottom:1rpx solid #eee7df;}
.sales-stage-heading,.sales-declaration-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;}
.sales-stage-heading>view{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;min-width:0;}
.sales-stage-status{font-size:22rpx;color:#81786e;}
.sales-stage-action{flex-shrink:0;white-space:nowrap;margin:0;font-size:24rpx;}
.sales-stage-amounts{display:flex;flex-wrap:wrap;gap:8rpx 24rpx;margin-top:12rpx;font-size:24rpx;color:#575149;font-variant-numeric:tabular-nums;}
.sales-stage-amounts text{white-space:nowrap;}
.sales-declaration{display:flex;flex-direction:column;align-items:stretch;gap:14rpx;padding:22rpx;margin-top:20rpx;background:#faf6f0;border-radius:12rpx;}
.sales-declaration-heading{font-weight:600;font-size:26rpx;}
.sales-declaration .error{display:block;padding:0;background:transparent;line-height:1.6;word-break:break-all;}
.sales-declaration .link{align-self:flex-end;margin:0;white-space:nowrap;}

/* ================= 客户跟进（八步流程为唯一事实） ================= */.cw-prog-top,.cw-prog-next{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.cw-prog-label{font-size:var(--zs-font-meta);font-weight:600;color:#635244}
.cw-prog-score{display:flex;align-items:baseline;line-height:44rpx;color:#81532f}
.cw-prog-score{font-size:35rpx;font-weight:650;font-variant-numeric:tabular-nums}
.cw-prog-frac,.cw-prog-pct{font-size:25rpx;color:#91765e}
.cw-prog-frac{margin-left:2rpx}
.cw-prog-sep{display:block;width:1rpx;height:23rpx;align-self:center;background:#eaddcf;margin:0 12rpx}
.cw-prog-pct{font-weight:600}
.cw-prog-next{margin-top:14rpx;font-size:23rpx;line-height:32rpx;color:#8d7864}
.cw-prog-next .cw-late{color:var(--zs-danger);font-weight:600}
.cw-prog-step{color:#664b37;font-weight:600;white-space:nowrap}
.cw-rail{display:flex;align-items:center;margin:14rpx 0 4rpx;min-height:56rpx}
.cw-node{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:43rpx;height:43rpx;border:1rpx solid #e2d4c5;border-radius:999rpx;background:#fcf8f3;color:#92795e;font-size:20rpx;font-weight:600}
.cw-node-done{border-color:#e5d3be;background:#efe1d0;color:#815436}
.cw-node-active{width:auto;gap:8rpx;height:56rpx;padding:0 13rpx 0 9rpx;border:0;background:var(--zs-brand);color:#fff;box-shadow:0 4rpx 10rpx rgba(116,69,37,.2)}
.cw-node-name{font-size:23rpx;font-weight:600;white-space:nowrap;line-height:34rpx}
.cw-conn{flex:1;min-width:6rpx;height:2rpx;background:#e9ddd0}
.cw-conn-done{background:#c8a484}
.cw-tl{position:relative;padding:0 0 26rpx 46rpx}
.cw-tl::before{content:"";position:absolute;left:9rpx;top:26rpx;bottom:-4rpx;width:1px;background:var(--zs-line)}
.cw-tl:last-of-type{padding-bottom:8rpx}
.cw-tl:last-of-type::before{display:none}
.cw-tl-dot{position:absolute;left:0;top:7rpx;width:19rpx;height:19rpx;border-radius:50%;border:2rpx solid #d9c7b4;background:var(--zs-card);z-index:1}
.cw-tl.done .cw-tl-dot{background:var(--zs-brand);border-color:var(--zs-brand)}
.cw-tl.lead .cw-tl-dot{border-color:var(--zs-champagne)}
.cw-tl-head{display:flex;align-items:baseline;gap:12rpx;white-space:nowrap}
.cw-tl-time{font-size:var(--zs-font-meta);color:var(--muted);line-height:36rpx;font-variant-numeric:tabular-nums}
.cw-tl-title{flex:1;min-width:0;font-size:var(--zs-font-body);font-weight:600;color:var(--text);line-height:40rpx;overflow:hidden;text-overflow:ellipsis}
.cw-tl-who{font-size:var(--zs-font-meta);color:var(--muted);line-height:36rpx;flex-shrink:0}
.cw-tl-note,.cw-tl-next,.cw-tl-files{display:block;margin-top:4rpx;font-size:var(--zs-font-meta);line-height:38rpx}
.cw-tl-note{color:var(--zs-text-2)}
.cw-tl-next{color:var(--zs-brand)}
.cw-tl-files{color:var(--muted)}
.cw-actions>button{flex:1;min-width:0}
.cw-actions .cw-main{flex:1.4}
