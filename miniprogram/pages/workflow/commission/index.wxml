<wxs src="../../../utils/tone.wxs" module="st"/>
<view class="commission-page">
 <business-header title="{{title}}"/>
 <view class="commission-body">
  <view wx:if="{{error && !(primary||canReturn)}}" class="commission-error" role="alert">{{error}}</view>
  <button wx:if="{{error&&!customer&&!(primary||canReturn)}}" class="commission-secondary" bindtap="goHome">{{needsLogin?'登录后查看':'返回当前工作台'}}</button>
  <block>
   <view wx:if="{{customer&&view!=='receipt'}}" class="commission-card commission-summary"><view class="commission-summary-top"><text class="commission-heading">{{customer.name}}</text><text class="commission-chip {{st.tone(rows[0].value)}}">{{rows[0].value||(isComplete?'业务移交完成':'办理中')}}</text></view><text wx:if="{{customer.city||rows[1].value}}" class="commission-muted">{{customer.city}}<text wx:if="{{rows[1].value}}">{{customer.city?' · ':''}}当前办理：{{rows[1].value}}</text></text></view>
   <include src="./simulated-payment.wxml"/>
   <view wx:if="{{rows.length}}" class="commission-card"><block wx:for="{{rows}}" wx:key="index"><view wx:if="{{index>1||view==='policy'||view==='pricing'}}" class="commission-row"><text class="commission-muted commission-key">{{item.label}}</text><button wx:if="{{item.file}}" class="commission-file" data-index="{{index}}" bindtap="preview">{{item.value}}</button><text wx:else class="commission-value">{{item.value}}</text></view></block></view>
   <include src="./order-sheet.wxml"/>
   <view wx:if="{{fields.length}}" class="commission-card">
    <view wx:for="{{fields}}" wx:key="key" class="commission-field">
     <text wx:if="{{item.kind!=='check'}}" class="commission-label">{{item.label}}</text>
     <textarea wx:if="{{item.kind==='textarea'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height maxlength="3000" placeholder="请填写{{item.label}}"/>
     <view wx:elif="{{item.kind==='file'}}"><view wx:if="{{!item.locked}}" class="commission-file-actions"><button class="commission-upload" data-key="{{item.key}}" bindtap="chooseFile">{{form[item.key]?'重新选择实际文件':'选择实际文件'}}</button></view><text wx:if="{{item.locked}}" class="commission-muted">总部设计已下发，本次移交不可替换</text><button wx:if="{{form[item.key]}}" class="commission-file" data-key="{{item.key}}" bindtap="preview">{{form[item.key].name}} · 点击预览</button></view>
     <checkbox-group wx:elif="{{item.kind==='check'}}" data-key="{{item.key}}" bindchange="check"><label class="commission-check"><checkbox value="yes" checked="{{form[item.key]}}" disabled="{{busy}}" color="#824019"/><text>{{item.label}}</text></label></checkbox-group>
     <picker wx:elif="{{item.kind==='date'}}" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="input"><view class="commission-input">{{form[item.key]||'请选择日期'}}</view></picker>
     <picker wx:elif="{{item.kind==='manager'}}" range="{{managerOptions}}" range-key="label" bindchange="chooseManager"><view class="commission-input">{{form.managerName||'请选择另一位有效工程人员'}}<text wx:if="{{!managerOptions.length}}">（暂无，需配置不同员工）</text></view></picker>
     <view wx:elif="{{item.locked}}" class="commission-input commission-locked">{{form[item.key]}}</view>
    </view>
   </view>
   <view wx:if="{{primary||canReturn}}" class="commission-action-panel"><view wx:if="{{error}}" class="commission-error" role="alert">{{error}}</view><view class="commission-actions"><button wx:if="{{canReturn}}" class="commission-secondary" bindtap="returnPacket">退回补充</button><button wx:if="{{primary}}" class="commission-primary" loading="{{busy}}" disabled="{{busy||platformStatus!=='ready'}}" bindtap="submit">{{primary}}</button></view></view>
  </block>
 </view>
 <view wx:if="{{preview}}" class="commission-mask" bindtap="closePreview"><view class="commission-card"><text class="commission-heading">{{preview.name}}</text><text class="commission-value">{{preview.text}}</text><button class="commission-primary" bindtap="closePreview">关闭预览</button></view></view>
</view>
