<view class="commission-page {{view==='admin'?'commission-admin':''}}">
 <business-header title="{{title}}"/>
 <view class="commission-body">
  <view wx:if="{{error}}" class="commission-error">{{error}}</view>
  <block wx:if="{{view==='admin'}}">
   <view class="commission-card"><text class="commission-heading">设计行政</text><text class="commission-muted">线下安排设计，完成后登记；尾款到账后登记正式成果下发。</text></view>
   <view wx:for="{{tasks}}" wx:key="key" class="commission-card"><text class="commission-heading">{{item.name}}</text><text class="commission-state">{{item.state}}</text><button class="commission-primary" data-url="{{item.url}}" bindtap="openTask">{{item.action}}</button></view>
   <view wx:if="{{!tasks.length}}" class="commission-card commission-muted">当前没有待办理的委托。首款足额确认后，设计任务会在这里出现。</view>
  </block>
  <block wx:else>
   <view wx:if="{{customer}}" class="commission-card"><text class="commission-heading">{{customer.name}}</text><text class="commission-muted">{{customer.city}} · {{isComplete?'业务移交完成':'按当前事项继续办理'}}</text></view>
   <view wx:if="{{rows.length}}" class="commission-card"><view wx:for="{{rows}}" wx:key="index" class="commission-row"><text class="commission-muted">{{item.label}}</text><button wx:if="{{item.file}}" class="commission-file" data-index="{{index}}" bindtap="preview">{{item.value}}</button><text wx:else class="commission-value">{{item.value}}</text></view></view>
   <view wx:if="{{fields.length}}" class="commission-card">
    <view wx:for="{{fields}}" wx:key="key" class="commission-field">
     <text wx:if="{{item.kind!=='check'}}" class="commission-label">{{item.label}}</text>
     <textarea wx:if="{{item.kind==='textarea'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height maxlength="3000" placeholder="请填写{{item.label}}"/>
     <view wx:elif="{{item.kind==='file'}}"><button class="commission-upload" data-key="{{item.key}}" bindtap="chooseFile">{{form[item.key]?'重新选择':'选择文件'}}</button><button wx:if="{{form[item.key]}}" class="commission-file" data-key="{{item.key}}" bindtap="preview">{{form[item.key].name}}</button></view>
     <checkbox-group wx:elif="{{item.kind==='check'}}" data-key="{{item.key}}" bindchange="check"><label class="commission-check"><checkbox value="yes" checked="{{form[item.key]}}" color="#824019"/><text>{{item.label}}</text></label></checkbox-group>
     <picker wx:elif="{{item.kind==='manager'}}" range="{{managerOptions}}" range-key="name" bindchange="chooseManager"><view class="commission-input">{{selectedManager||'请选择接收负责人'}}</view></picker>
     <picker wx:elif="{{item.kind==='date'}}" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="input"><view class="commission-input">{{form[item.key]||'请选择日期'}}</view></picker>
     <input wx:else value="{{form[item.key]}}" type="{{item.kind==='money'?'digit':'text'}}" data-key="{{item.key}}" bindinput="input" placeholder="请填写{{item.label}}"/>
    </view>
   </view>
   <view wx:if="{{primary||canDraft||canReturn}}" class="commission-actions"><button wx:if="{{canDraft}}" class="commission-secondary" bindtap="saveDraft">暂存资料</button><button wx:if="{{canReturn}}" class="commission-secondary" bindtap="returnPacket">退回补充</button><button wx:if="{{primary}}" class="commission-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{primary}}</button></view>
   <view wx:if="{{view==='handover'}}" class="commission-muted commission-note">收图、客户确认和交底集中在本页。资料可暂存，齐备后一次提交。</view>
   <button wx:if="{{canFeedback}}" class="commission-secondary" bindtap="openFeedback">客户需修改，登记意见</button>
  </block>
 </view>
 <view wx:if="{{preview}}" class="commission-mask" bindtap="closePreview"><view class="commission-card"><text class="commission-heading">{{preview.name}}</text><text class="commission-value">{{preview.text}}</text><button class="commission-primary" bindtap="closePreview">关闭预览</button></view></view>
</view>
<custom-tab-bar wx:if="{{view==='admin'}}" active-index="{{19}}" nested="{{true}}"/>
