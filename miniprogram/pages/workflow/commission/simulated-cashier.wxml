<view wx:if="{{simulationPhase}}" class="cashier-mask" catchtouchmove="paymentSheetNoop" catchtap="paymentSheetNoop">
 <view class="cashier-sheet cashier-mock" catchtap="paymentSheetNoop">
  <view class="cashier-top"><view class="cashier-brand"><view class="cashier-mock-mark">✓</view><text>众墅之家模拟收银台</text><text class="cashier-badge">模拟</text></view><button wx:if="{{!busy}}" class="cashier-close" bindtap="cancelSimulationPayment" aria-label="关闭模拟付款登记">×</button></view>
  <block wx:if="{{simulationPhase==='confirm'}}">
   <text class="cashier-merchant">{{paymentMerchant}}</text><text class="cashier-amount">{{paymentOrder.amountText}}</text><text class="cashier-customer">{{paymentOrder.customerName}} · 设计服务费</text>
   <view class="cashier-funding"><text>支付方式</text><text>模拟支付<text class="cashier-funding-note"> · 不扣款</text></text></view>
   <button class="cashier-confirm" bindtap="confirmSimulationPayment">确认模拟支付</button><button class="cashier-cancel" bindtap="cancelSimulationPayment">取消</button>
  </block>
  <view wx:elif="{{simulationPhase==='processing'}}" class="cashier-state"><view class="cashier-spinner"/><text class="cashier-state-title">{{simulationChecking?'正在核对支付结果':'模拟支付处理中'}}</text><text class="cashier-state-note">模拟支付 · 不发生真实扣款</text></view>
  <view wx:else class="cashier-state"><view class="cashier-state-icon">{{simulationPhase==='unknown'?'…':'!'}}</view><text class="cashier-state-title">{{simulationPhase==='unknown'?'支付结果待确认':'模拟支付未完成'}}</text><text class="cashier-state-note" role="alert">{{simulationError}}</text><button class="cashier-confirm" bindtap="retrySimulationPayment">{{simulationUncertain?'查询支付结果':'重新模拟支付'}}</button><button class="cashier-cancel" bindtap="cancelSimulationPayment">返回订单</button></view>
 </view>
</view>