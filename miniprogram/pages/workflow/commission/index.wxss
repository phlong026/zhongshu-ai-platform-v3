@import "../../../styles/project-flow.wxss";
page{background:var(--zs-bg);color:var(--zs-ink)}.commission-page{min-height:100vh;padding-bottom:calc(36rpx + env(safe-area-inset-bottom));font-size:var(--zs-font-emphasis)}.commission-body{padding:24rpx var(--zs-space-page)}.commission-card{background:var(--zs-card);border:1rpx solid var(--zs-line);border-radius:var(--zs-radius);padding:var(--zs-space-card);margin-bottom:var(--zs-space-section)}.commission-heading{display:block;font-size:var(--zs-font-title);font-weight:600;margin-bottom:16rpx}.commission-muted{display:block;color:#82756b;font-size:var(--zs-font-body);line-height:1.65}.commission-row{padding:14rpx 0;border-bottom:1rpx solid #f1eae3}.commission-row:last-child{border:0}.commission-value{display:block;line-height:1.7;white-space:pre-wrap;word-break:break-all;margin-top:6rpx}.commission-field{margin-bottom:30rpx}.commission-field:last-child{margin-bottom:0}.commission-label{display:block;margin-bottom:14rpx;line-height:1.5}.commission-field textarea,.commission-input{box-sizing:border-box;width:100%;min-height:86rpx;padding:20rpx;background:#fbf9f6;border:1rpx solid #e7dfd5;border-radius:12rpx;font-size:var(--zs-font-emphasis);line-height:1.6}.commission-field textarea{min-height:138rpx}.commission-check{display:flex;align-items:flex-start;line-height:1.7}.commission-check checkbox{flex-shrink:0;transform:scale(.85);transform-origin:top left;margin-top:4rpx}.commission-primary,.commission-secondary,.commission-upload{min-height:88rpx;border-radius:12rpx;font-size:var(--zs-font-emphasis);line-height:1.5;padding:22rpx 24rpx;white-space:normal}.commission-primary{background:var(--zs-brand);color:var(--zs-card)}.commission-secondary,.commission-upload{background:var(--zs-card);color:var(--zs-brand);border:1rpx solid #cfb9a4}.commission-primary::after,.commission-secondary::after,.commission-upload::after,.commission-file::after{border:0}.commission-primary[disabled]{opacity:.6}.commission-action-panel{padding-top:10rpx;background:#faf7f2}.commission-action-panel .commission-error{margin:0 0 8rpx;padding:16rpx 20rpx;font-size:var(--zs-font-body);line-height:1.5}.commission-actions{display:flex;gap:16rpx;padding:16rpx 0;background:#faf7f2}.commission-actions button{flex:1;margin:0}.commission-file{padding:10rpx 0;margin:0;background:none;color:var(--zs-brand);font-size:var(--zs-font-body);text-align:left;white-space:normal;word-break:break-all;line-height:1.6}.commission-error{color:var(--zs-danger);background:#fff0e9;border:1rpx solid #efc3b4;padding:22rpx;border-radius:12rpx;margin-bottom:20rpx;line-height:1.6}.commission-mask{position:fixed;inset:0;background:rgba(30,20,10,.4);display:flex;align-items:center;padding:32rpx;z-index:1000}.commission-mask .commission-card{width:100%;max-height:75vh;overflow:auto}


/* Summary header, status chip and two-column record rows (replaces the long label-over-value list). */.commission-summary{padding:24rpx var(--zs-space-page)}.commission-summary-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:8rpx}.commission-summary .commission-heading{margin:0;font-size:var(--zs-font-title);line-height:48rpx;flex:1;min-width:0}
.commission-chip{flex-shrink:0;max-width:56%;padding:6rpx 20rpx;border-radius:999rpx;background:#f7efe5;color:var(--zs-brand);font-size:var(--zs-font-meta);line-height:36rpx;font-weight:500;text-align:center}.commission-chip.done{background:var(--zs-success-bg);color:var(--zs-success)}
.commission-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:22rpx 0;min-height:88rpx;box-sizing:border-box}.commission-row .commission-key{flex:0 0 176rpx;display:block}.commission-row .commission-value{flex:1;margin:0;text-align:right;line-height:1.6}.commission-row .commission-file{flex:1;text-align:right;justify-content:flex-end}

.commission-file-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.commission-file-actions button{margin:0;min-height:76rpx;padding:14rpx 16rpx}

.commission-locked{color:#6f6258;background:#f4f0eb!important}


/* Keep the remaining textarea inside its native box. */

.commission-field textarea{height:176rpx;min-height:88px;padding:18rpx 20rpx;line-height:42rpx}

.payment-amount{display:block;font-size:52rpx;font-weight:700;text-align:center;margin:32rpx 0;color:#824019}
.payment-detail-toggle::after{border:0}.payment-detail-toggle{background:transparent;color:#824019;font-size:24rpx;line-height:1.5;padding:0;margin:0}.payment-detail-toggle{color:#8d8177;margin:8rpx auto 20rpx}.payment-disclaimer{display:block;text-align:center;color:#9a8c80;font-size:22rpx;margin-top:28rpx}

.order-toolbar{display:flex;align-items:center;justify-content:space-between;margin:28rpx 0 16rpx;color:#85776c;font-size:24rpx}.order-toolbar>view{display:flex;gap:24rpx}.order-toolbar button{margin:0;padding:0;background:transparent;color:#87502b;font-size:24rpx;line-height:1.6}.order-toolbar button::after{border:0}.order-sheet{background:#fff;padding:36rpx 30rpx;color:#24231f;margin-bottom:24rpx;border:1rpx solid #e5dfd7}.order-brand{display:flex;justify-content:space-between;gap:16rpx;font-size:17rpx;letter-spacing:2rpx;color:#87502b;margin-bottom:30rpx}.order-title{display:block;font-size:48rpx;font-weight:700;letter-spacing:3rpx}.order-project{display:block;font-size:30rpx;font-weight:600;margin:14rpx 0;line-height:1.6}.order-status{display:inline-block;color:#87502b;border:1rpx solid #b38e71;padding:5rpx 12rpx;font-size:21rpx}.order-meta{font-size:20rpx;color:#80776c;word-break:break-all;line-height:1.7;margin-top:20rpx}.order-metrics{display:flex;gap:12rpx;margin:28rpx 0 12rpx;padding:26rpx 0;border-top:1rpx solid #d8d2ca;border-bottom:1rpx solid #d8d2ca}.order-metrics>view{flex:1;min-width:0}.order-metrics>view>text:first-child{display:block;font-size:28rpx;font-weight:700;line-height:1.5}.order-metrics>view>text:last-child{display:block;font-size:19rpx;color:#827a70;margin-top:8rpx}.order-unit{font-size:20rpx;font-weight:400}.order-section{margin-top:30rpx}.order-section-title{display:block;font-size:28rpx;font-weight:600;border-left:7rpx solid #87502b;padding-left:14rpx;margin-bottom:16rpx}.order-row{display:flex;gap:24rpx;padding:16rpx 0;border-bottom:1rpx solid #eee9e2;font-size:23rpx;line-height:1.7}.order-row>text:first-child{flex:0 0 164rpx;color:#827a70}.order-row>text:last-child{flex:1;min-width:0;word-break:break-word;white-space:pre-wrap}.order-note{display:block;font-size:20rpx;line-height:1.8;color:#827a70;margin-top:32rpx}.order-export-canvas{position:fixed;left:-10000px;top:0;width:750px;height:1200px;pointer-events:none}
