@import "../../../styles/workbench.wxss";
@import "../../../styles/sales.wxss";
@import "../../../styles/project-flow.wxss";
page{background:var(--zs-bg);color:var(--zs-ink)}.commission-page{min-height:100vh;padding-bottom:calc(36rpx + env(safe-area-inset-bottom));font-size:var(--zs-font-emphasis)}.commission-body{padding:24rpx var(--zs-space-page)}.commission-card{background:var(--zs-card);border:1rpx solid var(--zs-line);border-radius:var(--zs-radius);padding:var(--zs-space-card);margin-bottom:var(--zs-space-section)}.commission-heading{display:block;font-size:var(--zs-font-title);font-weight:600;margin-bottom:16rpx}.commission-muted{display:block;color:#82756b;font-size:var(--zs-font-body);line-height:1.65}.commission-state{display:block;color:var(--zs-brand);font-weight:500;margin-bottom:20rpx}.commission-row{padding:14rpx 0;border-bottom:1rpx solid #f1eae3}.commission-row:last-child{border:0}.commission-value{display:block;line-height:1.7;white-space:pre-wrap;word-break:break-all;margin-top:6rpx}.commission-field{margin-bottom:30rpx}.commission-field:last-child{margin-bottom:0}.commission-label{display:block;margin-bottom:14rpx;line-height:1.5}.commission-field input,.commission-field textarea,.commission-input{box-sizing:border-box;width:100%;min-height:86rpx;padding:20rpx;background:#fbf9f6;border:1rpx solid #e7dfd5;border-radius:12rpx;font-size:var(--zs-font-emphasis);line-height:1.6}.commission-field textarea{min-height:138rpx}.commission-check{display:flex;align-items:flex-start;line-height:1.7}.commission-check checkbox{flex-shrink:0;transform:scale(.85);transform-origin:top left;margin-top:4rpx}.commission-primary,.commission-secondary,.commission-upload{min-height:88rpx;border-radius:12rpx;font-size:var(--zs-font-emphasis);line-height:1.5;padding:22rpx 24rpx;white-space:normal}.commission-primary{background:var(--zs-brand);color:var(--zs-card)}.commission-secondary,.commission-upload{background:var(--zs-card);color:var(--zs-brand);border:1rpx solid #cfb9a4}.commission-primary::after,.commission-secondary::after,.commission-upload::after,.commission-file::after{border:0}.commission-primary[disabled]{opacity:.6}.commission-action-panel{padding-top:10rpx;background:#faf7f2}.commission-action-panel .commission-error{margin:0 0 8rpx;padding:16rpx 20rpx;font-size:var(--zs-font-body);line-height:1.5}.commission-actions{display:flex;gap:16rpx;padding:16rpx 0;background:#faf7f2}.commission-actions button{flex:1;margin:0}.commission-file{padding:10rpx 0;margin:0;background:none;color:var(--zs-brand);font-size:var(--zs-font-body);text-align:left;white-space:normal;word-break:break-all;line-height:1.6}.commission-error{color:var(--zs-danger);background:#fff0e9;border:1rpx solid #efc3b4;padding:22rpx;border-radius:12rpx;margin-bottom:20rpx;line-height:1.6}.commission-note{padding:0 12rpx}.commission-mask{position:fixed;inset:0;background:rgba(30,20,10,.4);display:flex;align-items:center;padding:32rpx;z-index:1000}.commission-mask .commission-card{width:100%;max-height:75vh;overflow:auto}
.commission-admin{padding-bottom:calc(144rpx + env(safe-area-inset-bottom))}
.commission-admin .commission-body{padding:20rpx 28rpx 0}.admin-greeting{display:flex;align-items:center;gap:18rpx;padding:0 4rpx 22rpx;flex-wrap:wrap}.admin-greeting>text:first-child{font-size:var(--zs-font-title);font-weight:600;line-height:48rpx}.admin-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;margin-bottom:28rpx}.admin-metric{padding:20rpx;text-align:left;border:1rpx solid #eae3d9;border-radius:20rpx;background:var(--zs-card);box-shadow:0 8rpx 22rpx rgba(93,61,32,.045)}.admin-metric-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx}.admin-metric-top image{width:34rpx;height:34rpx;opacity:.85}.admin-metric-top .chevron{width:12rpx;height:12rpx}.admin-metric-label{display:block;color:#74695c;font-size:var(--zs-font-meta);line-height:36rpx;white-space:nowrap}.admin-metric-value{color:#74431f;font-size:var(--zs-font-heading);font-weight:600;line-height:54rpx}.admin-metric-unit{color:#978b7d;font-size:var(--zs-font-caption)}.commission-admin .admin-section{padding:22rpx;margin-bottom:24rpx;border:0}.admin-section .section-heading{padding-left:0;margin-bottom:8rpx}.admin-list-row{display:flex;align-items:center;gap:16rpx;width:100%;padding:18rpx 0;border-bottom:1rpx solid var(--zs-line);text-align:left}.admin-list-row:last-child{border:0}.admin-list-copy{flex:1;min-width:0}.admin-list-copy>text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.admin-list-name{font-size:var(--zs-font-emphasis);font-weight:600;line-height:42rpx}.admin-primary{min-height:64rpx;padding:12rpx 24rpx;border-radius:12rpx;font-size:var(--zs-font-body);line-height:40rpx;white-space:nowrap}.admin-light-action{color:var(--zs-brand);font-size:var(--zs-font-meta);white-space:nowrap}.admin-initial{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex-shrink:0;border-radius:50%;background:#faf1e5;color:var(--zs-brand);font-size:var(--zs-font-emphasis)}.admin-search{display:flex;align-items:center;gap:16rpx;height:76rpx;padding:0 24rpx;margin-bottom:18rpx;border:1rpx solid #e5ddd3;border-radius:40rpx;background:var(--zs-card)}.admin-search image{width:32rpx;height:32rpx}.admin-search input{flex:1;height:52rpx;font-size:var(--zs-font-body)}.admin-filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-bottom:20rpx}.admin-filters button{display:flex;align-items:center;justify-content:center;gap:8rpx;min-height:70rpx;padding:10rpx;border:1rpx solid #e5ddd3;border-radius:12rpx;background:var(--zs-card);color:#74695c;font-size:var(--zs-font-meta)}.admin-filters button.active{border-color:var(--zs-brand);background:#fffaf4;color:var(--zs-brand)}.admin-project-list{border:1rpx solid #ece3d9;border-radius:20rpx;background:var(--zs-card);overflow:hidden}.admin-project-row{display:flex;align-items:center;gap:18rpx;width:100%;padding:20rpx 22rpx;border-bottom:1rpx solid var(--zs-line);text-align:left}.admin-project-row:last-child{border:0}.admin-project-main{flex:1;min-width:0}.admin-project-main>text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.admin-project-main>text:last-child{overflow:visible;text-overflow:clip;white-space:normal}.admin-project-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:4rpx;font-size:var(--zs-font-emphasis);font-weight:600}.admin-project-heading>text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.admin-status{flex-shrink:0;padding:4rpx 14rpx;border-radius:999rpx;background:var(--zs-warning-bg);color:var(--zs-brand);font-size:var(--zs-font-caption);font-weight:500}.admin-status.done{background:var(--zs-success-bg);color:var(--zs-success)}.admin-status.waiting{background:var(--zs-warning-bg);color:#9a6a20}@media(max-width:360px){.admin-metrics{gap:10rpx}.admin-metric{padding:16rpx 12rpx}.admin-metric-label{font-size:var(--zs-font-caption)}.admin-filters{gap:8rpx}.admin-filters button{font-size:var(--zs-font-caption)}}

/* Summary header, status chip and two-column record rows (replaces the long label-over-value list). */
.commission-summary{padding:24rpx var(--zs-space-page)}.commission-summary-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:8rpx}.commission-summary .commission-heading{margin:0;font-size:var(--zs-font-title);line-height:48rpx;flex:1;min-width:0}
.commission-chip{flex-shrink:0;max-width:56%;padding:6rpx 20rpx;border-radius:999rpx;background:#f7efe5;color:var(--zs-brand);font-size:var(--zs-font-meta);line-height:36rpx;font-weight:500;text-align:center}.commission-chip.done{background:var(--zs-success-bg);color:var(--zs-success)}
.commission-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:22rpx 0;min-height:88rpx;box-sizing:border-box}.commission-row .commission-key{flex:0 0 176rpx;display:block}.commission-row .commission-value{flex:1;margin:0;text-align:right;line-height:1.6}.commission-row .commission-file{flex:1;text-align:right;justify-content:flex-end}
.admin-combined-filter{display:inline-flex;align-items:center;min-height:54rpx;padding:0 18rpx;margin:0 0 14rpx;border-radius:999rpx;background:#f7ebdc;color:var(--zs-brand);font-size:var(--zs-font-meta)}
.admin-load-more{display:flex;align-items:center;justify-content:center;width:100%;min-height:76rpx;margin:14rpx 0 0;color:var(--zs-brand);font-size:var(--zs-font-meta)}
.commission-file-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.commission-file-actions button{margin:0;min-height:76rpx;padding:14rpx 16rpx}.commission-sample-mark{display:inline-block;margin-top:12rpx;padding:4rpx 12rpx;border-radius:999rpx;background:var(--zs-warning-bg);color:var(--zs-brand);font-size:var(--zs-font-caption)}
.commission-budget-action{margin-top:18rpx}
.commission-section-title{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.commission-section-title .commission-heading{margin-bottom:12rpx}.commission-pricing-quote .commission-amount{color:var(--zs-brand);font-size:var(--zs-font-title);font-weight:600}.commission-payment-channels{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:24rpx}.commission-payment-channels button{margin:0;min-height:84rpx;padding:16rpx;border:1rpx solid #d9c7b7;border-radius:14rpx;background:var(--zs-card);color:#68452d;font-size:var(--zs-font-body)}.commission-payment-channels button.active{border-color:var(--zs-brand);background:#fff5e9;color:var(--zs-brand);font-weight:600}.commission-payment-attempts{display:flex;gap:14rpx;margin-top:16rpx}.commission-payment-attempts button{flex:1;margin:0;min-height:72rpx;padding:12rpx;font-size:var(--zs-font-meta)}.commission-locked{color:#6f6258;background:#f4f0eb!important}

@import "./journey.wxss";

/* Keep native input text inside its box instead of padding the intrinsic input height. */
.commission-field input{height:88rpx;min-height:44px;padding:0 20rpx;line-height:42rpx}
.commission-field textarea{height:176rpx;min-height:88px;padding:18rpx 20rpx;line-height:42rpx}
