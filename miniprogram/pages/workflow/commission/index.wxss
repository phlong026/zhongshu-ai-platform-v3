/* Summary header, status chip and two-column record rows (replaces the long label-over-value list). */
.commission-summary{padding:24rpx var(--zs-space-page)}.commission-summary-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:8rpx}.commission-summary .commission-heading{margin:0;font-size:var(--zs-font-title);line-height:48rpx;flex:1;min-width:0}
.commission-chip{flex-shrink:0;max-width:56%;padding:6rpx 20rpx;border-radius:999rpx;background:#f7efe5;color:var(--zs-brand);font-size:var(--zs-font-meta);line-height:36rpx;font-weight:500;text-align:center}.commission-chip.done{background:var(--zs-success-bg);color:var(--zs-success)}
.commission-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:22rpx 0;min-height:88rpx;box-sizing:border-box}.commission-row .commission-key{flex:0 0 176rpx;display:block}.commission-row .commission-value{flex:1;margin:0;text-align:right;line-height:1.6}.commission-row .commission-file{flex:1;text-align:right;justify-content:flex-end}
.admin-combined-filter{display:inline-flex;align-items:center;min-height:54rpx;padding:0 18rpx;margin:0 0 14rpx;border-radius:999rpx;background:#f7ebdc;color:var(--zs-brand);font-size:var(--zs-font-meta)}
.admin-load-more{display:flex;align-items:center;justify-content:center;width:100%;min-height:76rpx;margin:14rpx 0 0;color:var(--zs-brand);font-size:var(--zs-font-meta)}
.commission-file-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.commission-file-actions button{margin:0;min-height:76rpx;padding:14rpx 16rpx}.commission-sample-mark{display:inline-block;margin-top:12rpx;padding:4rpx 12rpx;border-radius:999rpx;background:var(--zs-warning-bg);color:var(--zs-brand);font-size:var(--zs-font-caption)}
.commission-budget-action{margin-top:18rpx}
.commission-section-title{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.commission-section-title .commission-heading{margin-bottom:12rpx}.commission-pricing-quote .commission-amount{color:var(--zs-brand);font-size:var(--zs-font-title);font-weight:600}.commission-payment-channels{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:24rpx}.commission-payment-channels button{margin:0;min-height:84rpx;padding:16rpx;border:1rpx solid #d9c7b7;border-radius:14rpx;background:var(--zs-card);color:#68452d;font-size:var(--zs-font-body)}.commission-payment-channels button.active{border-color:var(--zs-brand);background:#fff5e9;color:var(--zs-brand);font-weight:600}.commission-payment-attempts{display:flex;gap:14rpx;margin-top:16rpx}.commission-payment-attempts button{flex:1;margin:0;min-height:72rpx;padding:12rpx;font-size:var(--zs-font-meta)}.commission-locked{color:#6f6258;background:#f4f0eb!important}

