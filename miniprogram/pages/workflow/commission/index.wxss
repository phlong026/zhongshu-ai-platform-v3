page{background:#faf7f2;color:#35271f}.commission-page{min-height:100vh;padding-bottom:calc(36rpx + env(safe-area-inset-bottom));font-size:28rpx}.commission-body{padding:24rpx 28rpx}.commission-card{background:#fff;border:1rpx solid #ece3d9;border-radius:20rpx;padding:28rpx;margin-bottom:22rpx}.commission-heading{display:block;font-size:36rpx;font-weight:600;margin-bottom:16rpx}.commission-muted{display:block;color:#82756b;font-size:26rpx;line-height:1.65}.commission-state{display:block;color:#824019;font-weight:500;margin-bottom:20rpx}.commission-row{padding:14rpx 0;border-bottom:1rpx solid #f1eae3}.commission-row:last-child{border:0}.commission-value{display:block;line-height:1.7;white-space:pre-wrap;word-break:break-all;margin-top:6rpx}.commission-field{margin-bottom:30rpx}.commission-field:last-child{margin-bottom:0}.commission-label{display:block;margin-bottom:14rpx;line-height:1.5}.commission-field input,.commission-field textarea,.commission-input{box-sizing:border-box;width:100%;min-height:86rpx;padding:20rpx;background:#fbf9f6;border:1rpx solid #e7dfd5;border-radius:12rpx;font-size:28rpx;line-height:1.6}.commission-field textarea{min-height:138rpx}.commission-check{display:flex;align-items:flex-start;line-height:1.7}.commission-check checkbox{flex-shrink:0;transform:scale(.85);transform-origin:top left;margin-top:4rpx}.commission-primary,.commission-secondary,.commission-upload{min-height:88rpx;border-radius:12rpx;font-size:28rpx;line-height:1.5;padding:22rpx 24rpx;white-space:normal}.commission-primary{background:#824019;color:#fff}.commission-secondary,.commission-upload{background:#fff;color:#824019;border:1rpx solid #cfb9a4}.commission-primary::after,.commission-secondary::after,.commission-upload::after,.commission-file::after{border:0}.commission-primary[disabled]{opacity:.6}.commission-action-panel{position:sticky;bottom:calc(18rpx + env(safe-area-inset-bottom));padding-top:10rpx;background:#faf7f2}.commission-action-panel .commission-error{margin:0 0 8rpx;padding:16rpx 20rpx;font-size:26rpx;line-height:1.5}.commission-actions{display:flex;gap:16rpx;padding:16rpx 0;background:#faf7f2}.commission-actions button{flex:1;margin:0}.commission-file{padding:10rpx 0;margin:0;background:none;color:#824019;font-size:26rpx;text-align:left;white-space:normal;word-break:break-all;line-height:1.6}.commission-error{color:#923d2b;background:#fff0e9;border:1rpx solid #efc3b4;padding:22rpx;border-radius:12rpx;margin-bottom:20rpx;line-height:1.6}.commission-note{padding:0 12rpx}.commission-mask{position:fixed;inset:0;background:rgba(30,20,10,.4);display:flex;align-items:center;padding:32rpx;z-index:1000}.commission-mask .commission-card{width:100%;max-height:75vh;overflow:auto}
.commission-admin{padding-bottom:calc(144rpx + env(safe-area-inset-bottom))}

@import "../../../styles/project-flow.wxss";

/* Summary header, status chip and two-column record rows (replaces the long label-over-value list). */
.commission-summary{padding:24rpx 28rpx}.commission-summary-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:8rpx}.commission-summary .commission-heading{margin:0;font-size:34rpx;line-height:48rpx;flex:1;min-width:0}
.commission-chip{flex-shrink:0;max-width:56%;padding:6rpx 20rpx;border-radius:999rpx;background:#f7efe5;color:#89512a;font-size:24rpx;line-height:36rpx;font-weight:500;text-align:center}.commission-chip.done{background:#e8f4ec;color:#2e7d52}
.commission-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:22rpx 0;min-height:88rpx;box-sizing:border-box}.commission-row .commission-key{flex:0 0 176rpx;display:block}.commission-row .commission-value{flex:1;margin:0;text-align:right;line-height:1.6}.commission-row .commission-file{flex:1;text-align:right;justify-content:flex-end}
