.payment-options button{display:flex;align-items:center;justify-content:center;gap:14rpx}.payment-options image{width:42rpx;height:42rpx}.payment-success-mark{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;margin:32rpx auto 0;border-radius:50%;background:#e9f6ed;color:#08a74a;font-size:58rpx}.payment-notice{display:block;text-align:center;color:#8b7060;font-size:25rpx;margin:20rpx 0}
