<view wx:if="{{view==='submit'&&!submitPreview}}" class="commission-card order-context">
 <view class="commission-summary-top"><text class="commission-heading">{{orderCustomer.name||customer.name||'客户信息'}}</text><text wx:if="{{budgetReady}}" class="commission-chip">预算 V{{budgetBasis.version}}</text></view>
 <text wx:if="{{showCustomerPhone&&orderCustomer.phone}}" class="commission-muted">{{orderCustomer.phone}}</text>
 <text class="order-address">{{orderCustomer.address||customer.city||'建房地址待核对'}}</text>
 <view wx:if="{{budgetReady}}" class="budget-facts">
  <view><text>{{budgetBasis.width}} × {{budgetBasis.depth}}</text><text>面宽 × 进深（米）</text></view>
  <view><text>{{budgetBasis.floors}} 层</text><text>房屋层数</text></view>
  <view><text>{{budgetBasis.area}} ㎡</text><text>建筑面积</text></view>
 </view>
</view>
<block wx:if="{{view==='submit'&&designBriefEnabled&&!submitPreview}}">
 <view class="brief-heading"><text>补充设计需求</text><text>已有参数已带入</text></view>
 <view wx:for="{{briefSections}}" wx:key="title" wx:for-item="section" class="commission-card brief-section">
  <button class="brief-toggle" data-index="{{section.index}}" bindtap="toggleBrief"><view><text class="commission-heading">{{section.title}}</text><text wx:if="{{expandedBrief!==section.index}}" class="brief-section-summary">{{section.summary}}</text></view><text class="brief-chevron">{{expandedBrief===section.index?'−':'＋'}}</text></button>
  <view wx:if="{{expandedBrief===section.index}}" class="brief-section-body">
   <view wx:for="{{section.fields}}" wx:key="key" wx:for-item="field" wx:if="{{field.key!=='entranceDirection'||designBrief.entranceAligned==='不一致'}}" class="brief-field">
    <text class="commission-label">{{field.label}}</text>
    <scroll-view wx:if="{{field.key==='styleRefs'}}" scroll-x enhanced show-scrollbar="{{false}}" class="brief-style-scroll"><view class="brief-style-row"><button wx:for="{{field.options}}" wx:key="label" class="brief-chip {{item.selected?'selected':''}}" data-key="{{field.key}}" data-value="{{item.label}}" bindtap="briefChoice" disabled="{{busy}}">{{item.label}}</button></view></scroll-view>
    <view wx:elif="{{field.type==='checks'||field.type==='choices'}}" class="brief-options">
     <button wx:for="{{field.options}}" wx:key="label" class="brief-chip {{item.selected?'selected':''}}" data-key="{{field.key}}" data-value="{{item.label}}" bindtap="briefChoice" disabled="{{busy}}">{{item.label}}</button>
    </view>
    <textarea wx:elif="{{field.type==='textarea'}}" class="brief-input" value="{{field.value}}" data-key="{{field.key}}" bindinput="briefInput" maxlength="400" auto-height disabled="{{busy}}" placeholder="选填"/>
    <input wx:else class="brief-input" type="{{field.type==='number'?'number':'text'}}" value="{{field.value}}" data-key="{{field.key}}" bindinput="briefInput" maxlength="80" disabled="{{busy}}" placeholder="{{field.key==='projectName'||field.key==='householdMembers'?'请填写':'选填'}}"/>
   </view>
  </view>
 </view>
 <text wx:if="{{briefStorageError}}" class="commission-error">{{briefStorageError}}</text>
</block>
