<template name="journey-files">
 <view class="journey-files">
  <button wx:for="{{journey.files}}" wx:key="key" class="journey-file-card {{item.ready?'ready':''}}" data-preview-key="{{item.key}}" bindtap="previewJourneyFile" disabled="{{!item.ready}}">
   <view class="journey-file-cover"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><view wx:else class="journey-audit-cover"><text class="audit-lines"/><text class="audit-check">✓</text><text>审核记录</text></view><text class="journey-file-version">{{journey.version}}</text></view>
   <view class="journey-file-meta"><text>{{item.label}}</text><text class="journey-file-state">{{item.ready?'已就绪':'待生成'}}</text></view>
  </button>
 </view>
</template>
<template name="journey">
 <view class="design-journey">
  <view wx:if="{{view!=='paid'&&view!=='created'}}" class="journey-steps"><view wx:for="{{journey.steps}}" wx:key="label" class="journey-step {{item.active?'active':''}} {{item.done?'done':''}}"><text class="journey-step-dot">{{item.done?'✓':item.index}}</text><text>{{item.label}}</text></view></view>
  <block wx:if="{{view==='paid'||view==='created'}}">
   <view class="journey-success"><view class="journey-success-symbol {{view==='paid'&&journey.channel==='alipay'?'alipay':''}}">✓</view><text class="journey-success-title">{{view==='paid'?'支付成功':'工程项目已创建'}}</text><view wx:if="{{view==='paid'}}" class="journey-success-amount"><text>¥</text>{{journey.amount}}</view><text class="journey-subtle">{{view==='paid'?journey.recipient:journey.name+' · '+journey.city+'乡墅'}}</text><text class="journey-demo-note">体验演示{{view==='paid'?' · 不产生真实扣款':''}}</text></view>
   <view wx:if="{{view==='paid'}}" class="journey-card journey-receipt"><view class="journey-row"><text>支付方式</text><text>{{journey.channelName}} · {{journey.paymentMethod}}</text></view><view class="journey-row"><text>订单编号</text><text>{{journey.orderNumber}}</text></view><view class="journey-row"><text>支付时间</text><text>{{journey.paidAt}}</text></view></view>
   <view class="journey-card"><view class="journey-status-line"><view class="journey-state-icon">{{view==='paid'?'设':'工'}}</view><view><text class="journey-card-title">{{view==='paid'?'已交总部设计':'项目资料已同步'}}</text><text class="journey-subtle">{{view==='paid'?'需求与预算已送达 · 待开始设计':'设计成果 · 施工图 · 审核 · 客户确认 · 交底'}}</text></view></view><view wx:if="{{view==='paid'}}" class="journey-copy-row"><text>财务知会</text><text>门店财务 ✓</text><text>总部财务 ✓</text></view></view>
   <view class="journey-actions commission-actions"><button wx:if="{{view==='paid'}}" class="journey-primary journey-view-progress" bindtap="showJourneyProgress">查看设计进度</button><button wx:else class="journey-primary journey-open-project" bindtap="openEngineeringProject">进入工程项目</button><button class="journey-text-button" bindtap="returnWorkspace">返回工作台</button></view>
  </block>
  <block wx:else>
   <view class="journey-project"><view><text class="journey-project-name">{{journey.name}}</text><text class="journey-subtle">{{journey.city}} · {{journey.area}}㎡{{journey.floors?' · '+journey.floors+'层':''}}</text></view><text class="journey-status-tag">{{view==='submit'?'设计委托':view==='pay'?(journey.paid?'已付款':'待付款'):journey.state}}</text></view>
   <block wx:if="{{view==='submit'}}">
    <view class="journey-card journey-quote"><view class="journey-card-heading"><text class="journey-card-title">设计服务</text><text class="journey-subtle">一次付清</text></view><text class="journey-scope">{{journey.scope}}</text><view class="journey-price-block"><text class="journey-subtle">{{journey.area}}㎡ × ¥{{journey.rate}}/㎡</text><view class="journey-price"><text>¥</text>{{journey.amount}}</view></view></view>
    <view class="journey-card"><text class="journey-card-title">设计需求</text><textarea class="journey-demand" data-key="text" value="{{form.text}}" bindinput="input" placeholder="填写户型、房间及生活需求" maxlength="3000" auto-height/><button class="journey-attachment" data-key="attachment" bindtap="useSampleFile"><text class="journey-paper-icon">＋</text><text>{{journey.attachment?'需求资料已添加':'添加需求资料'}}</text><text class="journey-link">{{journey.attachment?'替换':'添加'}}</text></button><button wx:if="{{journey.attachment}}" class="journey-file-link" data-preview-key="attachment" bindtap="previewJourneyFile">{{journey.attachment.name}} ›</button></view>
    <checkbox-group data-key="checked" bindchange="check"><label class="journey-check"><checkbox value="yes" checked="{{form.checked}}" color="#824019"/><text>确认需求、计费面积与本次交付范围</text></label></checkbox-group>
    <view class="journey-actions commission-actions"><text wx:if="{{error}}" class="journey-error">{{error}}</text><button wx:if="{{!pricingQuote}}" class="journey-primary commission-primary journey-budget" bindtap="completeBudget" loading="{{busy}}" disabled="{{busy}}">保留资料并补齐预算</button><button wx:else class="journey-primary commission-primary journey-submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交委托 · ¥{{journey.amount}}</button><button wx:if="{{canDraft}}" class="journey-text-button" bindtap="saveDraft">保存草稿</button></view>
   </block>
   <block wx:elif="{{view==='pay'}}">
    <view class="journey-card journey-order"><text class="journey-subtle">设计服务费</text><view class="journey-order-amount"><text>¥</text>{{journey.amount}}</view><text>{{journey.scope}}</text><view class="journey-order-line"><text>收款方</text><text>{{journey.recipient}}</text></view></view>
    <view wx:if="{{canPay}}" class="journey-card journey-channels"><text class="journey-card-title">选择支付方式</text><button class="journey-channel {{form.channel==='wechat'?'selected':''}}" data-channel="wechat" bindtap="selectPaymentChannel"><view class="payment-brand-icon wechat-icon"><image src="/pages/workflow/assets/commission/wechat-pay.png"/></view><view class="journey-channel-copy"><text>微信支付</text><text class="journey-subtle">零钱、零钱通</text></view><text class="journey-radio">{{form.channel==='wechat'?'✓':''}}</text></button><button class="journey-channel {{form.channel==='alipay'?'selected alipay':''}}" data-channel="alipay" bindtap="selectPaymentChannel"><view class="payment-brand-icon alipay-icon"><image src="/pages/workflow/assets/commission/alipay.png"/></view><view class="journey-channel-copy"><text>支付宝</text><text class="journey-subtle">余额、余额宝</text></view><text class="journey-radio">{{form.channel==='alipay'?'✓':''}}</text></button></view>
    <view class="journey-actions commission-actions"><text wx:if="{{error}}" class="journey-error">{{error}}</text><button wx:if="{{canPay}}" class="journey-primary commission-primary journey-pay" bindtap="openCashier">立即付款 ¥{{journey.amount}}</button><button wx:else class="journey-primary" bindtap="showJourneyProgress">查看订单进度</button><text class="journey-demo-note">体验演示 · 不产生真实扣款</text></view>
   </block>
   <block wx:elif="{{view==='complete'||view==='dispatch'}}">
    <view class="journey-card"><view class="journey-card-heading"><text class="journey-card-title">设计任务</text><text class="journey-status-tag">{{view==='dispatch'?'设计已完成':'设计中'}}</text></view><text class="journey-scope">{{journey.scope}}</text><text class="journey-demand-summary">{{journey.demand}}</text><view class="journey-row"><text>尺寸依据</text><text>{{journey.width}}m × {{journey.depth}}m · {{journey.floors}}层</text></view></view>
    <view class="journey-card"><view class="journey-card-heading"><text class="journey-card-title">{{view==='complete'?'设计成果':'本次下发成果'}}</text><text class="journey-subtle">{{journey.version}}</text></view><view wx:if="{{generating}}" class="journey-generation"><view class="journey-spinner"/><text>正在整理本项目设计成果</text><progress percent="65" active stroke-width="4" activeColor="#824019"/></view><block wx:else><template is="journey-files" data="{{journey}}"/><button wx:if="{{!journey.allFilesReady}}" class="journey-secondary journey-generate" bindtap="generateDesignFiles" loading="{{busy}}" disabled="{{busy}}">{{view==='complete'?'生成设计成果':'添加本版成果'}}</button><text wx:else class="journey-asset-note">3份文件已就绪 · 点击预览</text></block></view>
    <view wx:if="{{view==='dispatch'}}" class="journey-card journey-deliver-to"><text class="journey-subtle">成果接收人</text><text>{{journey.owner}}</text><text class="journey-subtle">业务工作台 · 收图与移交</text></view>
    <checkbox-group data-key="checked" bindchange="check"><label class="journey-check"><checkbox value="yes" checked="{{form.checked}}" color="#824019"/><text>{{view==='complete'?'已完成本版设计及专业审核':'已核对下发版本与三份成果'}}</text></label></checkbox-group>
    <view class="journey-actions commission-actions"><text wx:if="{{error}}" class="journey-error">{{error}}</text><button class="journey-primary commission-primary {{view==='complete'?'journey-complete':'journey-dispatch'}}" bindtap="submit" loading="{{busy}}" disabled="{{busy||!journey.allFilesReady}}">{{view==='complete'?'确认设计完成':'下发给'+journey.owner}}</button></view>
   </block>
   <block wx:elif="{{view==='handover'||view==='receive'}}">
    <view class="journey-card"><view class="journey-card-heading"><text class="journey-card-title">{{view==='handover'?'项目成果包':'业务移交资料'}}</text><text class="journey-subtle">{{journey.version}}</text></view><template is="journey-files" data="{{journey}}"/></view>
    <view class="journey-card"><view class="journey-card-heading"><text class="journey-card-title">客户确认</text><text class="journey-status-tag">{{journey.confirmation?'已确认':'待确认'}}</text></view><button wx:if="{{journey.confirmation}}" class="journey-confirmed-client" data-preview-key="confirmationFile" bindtap="previewJourneyFile"><view class="journey-client-avatar">{{journey.name}}</view><view><text>{{journey.name}} · 已确认{{journey.version}}</text><text class="journey-subtle">查看确认凭据 ›</text></view><text class="journey-confirmed-mark">✓</text></button><button wx:elif="{{view==='handover'}}" class="journey-secondary journey-client-confirm" bindtap="openClientConfirmation">确认本版设计成果</button><text wx:else class="journey-subtle">暂无客户确认凭据</text></view>
    <view class="journey-card"><text class="journey-card-title">现场交底</text><textarea wx:if="{{view==='handover'}}" class="journey-demand" value="{{form.note}}" data-key="note" bindinput="input" maxlength="3000" auto-height placeholder="补充现场边界、道路及施工注意事项"/><text wx:else class="journey-demand-summary">{{journey.brief}}</text></view>
    <view wx:if="{{view==='receive'}}" class="journey-card"><text class="journey-card-title">退回补充</text><textarea class="journey-demand" value="{{form.note}}" data-key="note" bindinput="input" maxlength="3000" auto-height placeholder="资料需补充时填写具体原因"/></view>
    <checkbox-group wx:if="{{view==='handover'}}" data-key="received" bindchange="check"><label class="journey-check"><checkbox value="yes" checked="{{form.received}}" color="#824019"/><text>已核对本版成果、客户确认和交底资料</text></label></checkbox-group><checkbox-group wx:else data-key="checked" bindchange="check"><label class="journey-check"><checkbox value="yes" checked="{{form.checked}}" color="#824019"/><text>已核对5项资料，接收后创建工程项目</text></label></checkbox-group>
    <view class="journey-actions commission-actions"><text wx:if="{{error}}" class="journey-error">{{error}}</text><button wx:if="{{canReturn}}" class="journey-secondary commission-secondary" bindtap="returnPacket" disabled="{{busy}}">退回补充</button><button class="journey-primary commission-primary {{view==='handover'?'journey-handover':'journey-receive'}}" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{view==='handover'?'移交工程':'接收并创建项目'}}</button></view>
   </block>
   <block wx:else>
    <view wx:if="{{view==='feedback'}}" class="journey-card"><text class="journey-card-title">修改意见</text><textarea class="journey-demand" value="{{form.note}}" data-key="note" bindinput="input" maxlength="3000" auto-height placeholder="填写客户对本次成果的修改意见"/></view>
    <view class="journey-card journey-progress-card"><view class="journey-progress-art"><view class="journey-state-icon">{{journey.paid?'设':'付'}}</view><text>{{journey.state}}</text></view><text class="journey-subtle">{{journey.subtitle}}</text><view class="journey-row"><text>当前办理</text><text>{{journey.nextOwner}}</text></view><view class="journey-row"><text>设计服务费</text><text>¥{{journey.amount}} · {{journey.paid?'已支付':'待支付'}}</text></view></view>
    <view wx:if="{{journey.documentCount}}" class="journey-card"><view class="journey-card-heading"><text class="journey-card-title">设计成果</text><text class="journey-subtle">{{journey.version}}</text></view><template is="journey-files" data="{{journey}}"/></view>
    <view class="journey-card"><text class="journey-card-title">设计需求</text><text class="journey-demand-summary">{{journey.demand}}</text><view class="journey-row"><text>交付范围</text><text>{{journey.scope}}</text></view></view>
    <view wx:if="{{primary}}" class="journey-actions commission-actions"><text wx:if="{{error}}" class="journey-error">{{error}}</text><button class="journey-primary commission-primary" bindtap="submit">{{journey.nextAction}}</button></view>
   </block>
  </block>
 </view>
</template>
