<view wx:if="{{paymentOrder&&(view==='progress'||view==='receipt')}}" class="commission-card simulated-payment">
 <view class="commission-summary-top"><text class="commission-heading">历史模拟记录</text><text class="commission-chip">仅供查阅</text></view>
 <text wx:if="{{paymentOrder.amountText}}" class="payment-amount">{{paymentOrder.amountText}}</text>
 <view class="commission-row"><text class="commission-muted">记录状态</text><text>{{paymentOrder.status==='PAID'?'历史模拟已登记':'历史模拟未完成'}}</text></view>
 <button class="payment-detail-toggle" bindtap="togglePaymentDetails">记录详情 {{paymentDetails||view==='receipt'?'−':'＋'}}</button>
 <block wx:if="{{paymentDetails||view==='receipt'}}">
  <view class="commission-row"><text class="commission-muted">记录编号</text><text selectable>{{paymentOrder.number}}</text></view>
  <view class="commission-row"><text class="commission-muted">委托版本</text><text>V{{paymentOrder.submissionVersion}}</text></view>
  <view wx:if="{{paymentOrder.timeText}}" class="commission-row"><text class="commission-muted">历史登记时间</text><text>{{paymentOrder.timeText}}</text></view>
 </block>
 <text class="payment-disclaimer">模拟记录不计入实际收支。实际付款请由财务登记流水和凭证。</text>
</view>
