<import src="../budget-result.wxml"/>
<view class="page workbench-page sales-page explore-page">
 <business-header id="subpage-header" title="{{title}}" design-flow/>
 <view class="content">
 <view wx:if="{{pickingRef}}" class="explore-notice">从详情选作立面参考</view>
 <text wx:if="{{error||platformErr}}" class="explore-error">{{platformErr||error}}</text>
 <view wx:if="{{view==='inspiration'}}" class="section explore-projects-entry"><button class="text-link" bindtap="go" data-view="projects">我的方案（生成记录与恢复）<view class="chevron"/></button></view>
 <block wx:if="{{view==='inspiration'||view==='search'}}">
  <view wx:if="{{!platformMode}}" class="section"><view class="sales-search"><image src="/assets/search.png"/><input class="explore-input" value="{{keyword}}" bindinput="searchInput" placeholder="搜索名称或方案编号"/></view><view class="explore-filters"><picker class="explore-picker" range="{{styles}}" data-key="filterStyle" data-list="styles" bindchange="filterPick"><view class="explore-select">{{filterStyle}}<image src="/assets/creation-down.png"/></view></picker><picker class="explore-picker" range="{{floorFilters}}" data-key="floorFilter" data-list="floorFilters" bindchange="filterPick"><view class="explore-select">{{floorFilter}}<image src="/assets/creation-down.png"/></view></picker></view>
   <block wx:if="{{view==='search'}}"><view class="explore-pair"><label>开间（米）<input class="explore-input" type="digit" value="{{searchWidth}}" data-key="searchWidth" bindinput="searchDimension"/></label><label>进深（米）<input class="explore-input" type="digit" value="{{searchDepth}}" data-key="searchDepth" bindinput="searchDimension"/></label></view><button class="primary explore-wide explore-search-submit" bindtap="searchPlans">按尺寸检索平面</button></block><button wx:else class="text-link explore-search-open" bindtap="openSearch">按尺寸检索平面<view class="chevron"/></button>
  </view>
  <view wx:if="{{platformMode&&view==='search'}}" class="section explore-pair"><label>开间（米）<input class="explore-input" type="digit" value="{{platFilter.faceWidth}}" data-key="faceWidth" bindinput="platDimensionInput"/></label><label>进深（米）<input class="explore-input" type="digit" value="{{platFilter.depth}}" data-key="depth" bindinput="platDimensionInput"/></label></view>
  <button wx:if="{{platformMode&&view!=='search'}}" class="text-link explore-search-open" bindtap="openSearch">按尺寸检索平面<view class="chevron"/></button>
  <view wx:if="{{platformMode}}" class="explore-pair"><label>风格<picker class="explore-picker" range="{{platStyleOptions}}" range-key="label" data-key="styleCode" bindchange="platFilterPick"><view class="explore-select">{{platStyleLabel||'全部风格'}}<image src="/assets/creation-down.png"/></view></picker></label><label>层数<picker class="explore-picker" range="{{['全部','1层','2层','3层','4层']}}" data-key="floorCount" bindchange="platFilterPick"><view class="explore-select">{{platFloorLabel||'全部'}}<image src="/assets/creation-down.png"/></view></picker></label><label>关键词<input class="explore-input" value="{{keyword}}" bindinput="platSearchInput"/></label><button class="text-link explore-search-submit" bindtap="platSearch">检索</button><button wx:if="{{platCursor}}" class="text-link" bindtap="platLoadMore">加载更多</button></view>
  <view class="explore-grid"><button wx:if="{{!platformMode}}" wx:for="{{filteredCases}}" wx:key="id" class="explore-case" data-id="{{item.id}}" bindtap="openCase"><image src="{{item.image}}" mode="aspectFill"/><view><text>{{item.name}}</text><text class="hint">{{item.width}}×{{item.depth}}m · {{item.floors}}层</text><text class="hint">{{item.style}} · {{item.area}}㎡</text></view></button><view wx:if="{{platformMode}}" wx:for="{{platCases}}" wx:key="id" class="explore-case">
   <button class="explore-case-main" data-id="{{item.id}}" bindtap="platOpenCase">
    <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFit" data-id="{{item.id}}" binderror="platCoverError"/>
    <view wx:else class="explore-cover-placeholder"><text>{{item.coverLoading?'图片加载中…':item.coverError?'图片暂不可用':'暂无封面'}}</text></view>
    <view class="explore-case-copy"><text>{{item.title}}</text><text class="hint">{{item.faceWidth}}×{{item.depth}}m · {{item.floorCount}}层</text><text class="hint">{{item.styleLabel?item.styleLabel+' · ':''}}{{item.buildingArea}}㎡</text></view>
   </button><button wx:if="{{item.coverError}}" class="text-link explore-cover-retry" data-id="{{item.id}}" bindtap="platRetryCover">重试图片</button>
  </view></view><view wx:if="{{platformMode&&platLoading}}" class="section sales-empty">正在加载户型…</view>
  <view wx:if="{{platformMode&&platformErr&&!platLoading}}" class="section"><button class="outline" bindtap="platRetryCases">重新加载户型</button></view>
  <view wx:if="{{platformMode&&platStylesError}}" class="section"><text class="hint">{{platStylesError}}</text><button class="text-link" bindtap="platLoadStyles">重试风格筛选</button></view>
  <view wx:if="{{platformMode?(!platLoading&&!platformErr&&!platCases.length):!filteredCases.length}}" class="section sales-empty">暂无匹配灵感，请调整筛选条件。</view>
 </block>
 <block wx:elif="{{view==='case'}}"><view class="section"><view class="section-heading"><text class="section-title">{{platformMode?platCase.title:caseItem.name}}</text><button class="text-link" bindtap="favorite" disabled="{{platFavoriteLoading||platFavoriteSaving}}">{{platformMode?(platFavoriteLoading?'确认收藏中…':platFavoriteSaving?'正在保存…':platFavoriteError?'重试收藏状态':platCaseFav?'已收藏':'收藏灵感'):(favorite?'已收藏':'收藏灵感')}}</button></view><text class="hint" wx:if="{{!platformMode}}">{{caseItem.style}} · {{caseItem.width}}×{{caseItem.depth}}m · {{caseItem.floors}}层 · {{caseItem.area}}㎡</text><text class="hint" wx:if="{{platformMode}}">{{platCase.faceWidth}}×{{platCase.depth}}m · {{platCase.floorCount}}层 · {{platCase.buildingArea}}㎡{{platCase.styleLabel?' · '+platCase.styleLabel:''}}</text><view class="explore-tabs"><button wx:for="{{caseTabs}}" wx:key="*this" class="explore-case-tab {{caseTab===index?'selected':''}}" data-index="{{index}}" bindtap="caseTab">{{item}}</button></view><block wx:if="{{platformMode}}"><text wx:if="{{platCaseLoading||platCaseImageLoading}}" class="hint">户型图片加载中…</text><image wx:if="{{platCaseImages[caseTab]}}" class="explore-case-image" src="{{platCaseImages[caseTab]}}" mode="widthFix" data-image="{{platCaseImages[caseTab]}}" bindtap="preview" binderror="platCaseImageError"/><view wx:elif="{{!platCaseLoading&&!platCaseImageLoading}}" class="explore-cover-placeholder"><text>暂无可显示的户型图片</text></view><button wx:if="{{platCaseImagesError||platformErr}}" class="outline" bindtap="platRetryCaseImages">重新加载图片</button></block><image wx:else class="explore-case-image" src="{{caseImage}}" mode="widthFix" data-image="{{caseImage}}" bindtap="preview"/><text class="hint">{{platformMode?(platCase.version?'版本 '+platCase.version:'户型案例'):'案例 · '+caseItem.versionId}}，图像仅供沟通参考。</text></view><text wx:if="{{platformMode&&platCaseVerified&&!platCase.canDesign}}" class="hint">{{platCase.designUnavailableReason}}</text><view class="explore-action-pair"><button wx:if="{{!pickingRef&&!(platformMode&&platCase)}}" class="outline explore-use-case" data-kind="plan" bindtap="useCase">参考做AI平面</button><button wx:if="{{!platformMode||platCase}}" class="primary explore-use-case" disabled="{{platformMode&&(!platCaseVerified||!platCase.canDesign)}}" data-kind="facade" bindtap="useCase">用作立面参考</button></view></block>
 <block wx:elif="{{view==='ai-config'||view==='ai-facade'}}">
  <view class="section"><view class="section-heading"><text class="section-title">{{kind==='plan'?'建房需求':'立面需求'}}</text></view><view class="explore-pair"><label>开间（米）<input class="explore-input" type="digit" value="{{form.width}}" data-key="width" bindinput="input"/></label><label>进深（米）<input class="explore-input" type="digit" value="{{form.depth}}" data-key="depth" bindinput="input"/></label></view><view class="explore-pair"><label>建筑层数<input class="explore-input" type="number" value="{{form.floors}}" data-key="floors" bindinput="input"/></label><label>建筑风格<picker class="explore-picker" range="{{styleOptions}}" data-key="style" data-list="styleOptions" bindchange="pick"><view class="explore-select">{{form.style}}<image src="/assets/creation-down.png"/></view></picker></label></view>
   <label wx:if="{{kind==='facade'}}" class="explore-field">外观主色调<input class="explore-input" value="{{form.palette}}" data-key="palette" bindinput="input"/></label>
   <block wx:if="{{kind==='plan'}}"><view class="explore-pair"><label>主入口朝向<picker class="explore-picker" range="{{entranceOptions}}" range-key="label" data-key="entranceOrientation" data-list="entranceOptions" bindchange="platFormPickPicker"><view class="explore-select">{{entranceLabel||'默认（AI 安排）'}}<image src="/assets/creation-down.png"/></view></picker></label><label>家庭需求<picker class="explore-picker" range="{{familyOptions}}" data-key="family" bindchange="pick"><view class="explore-select">{{form.family||'默认'}}<image src="/assets/creation-down.png"/></view></picker></label></view><view class="explore-pair"><label>院落布局<picker class="explore-picker" range="{{courtyardOptions}}" range-key="label" data-key="courtyardLayout" data-list="courtyardOptions" bindchange="platFormPickPicker"><view class="explore-select">{{courtyardLabel||'AI 智能安排'}}<image src="/assets/creation-down.png"/></view></picker></label><label>图纸类型<picker class="explore-picker" range="{{drawingOptions}}" range-key="label" data-key="drawingType" data-list="drawingOptions" bindchange="platFormPickPicker"><view class="explore-select">{{drawingLabel||'默认'}}<image src="/assets/creation-down.png"/></view></picker></label></view></block>
   <view class="explore-field note-field"><label>家庭与设计要求<button class="text-link note-polish-btn" bindtap="notePolish" disabled="{{busy}}">AI 优化</button></label><textarea value="{{form.note}}" data-key="note" bindinput="input" maxlength="200"/></view>
   <view class="explore-reference"><text class="hint">参考灵感：{{form.referenceCaseId||(kind==='facade' && sourcePlanRef?'已选平面方案':'未选择')}}</text><button wx:if="{{kind==='facade'}}" class="text-link" bindtap="chooseReference">从灵感库选择<view class="chevron"/></button><button wx:else class="text-link explore-search-open" bindtap="openSearch">检索平面参考<view class="chevron"/></button></view>
   <view wx:if="{{kind==='facade'}}" class="explore-field"><view class="explore-ref-head"><text>自传参考图（≤3 张，与灵感参考可叠加）</text><button class="text-link" bindtap="addReference" disabled="{{busy}}">+ 添加图片</button></view><view wx:if="{{form.referenceAssetIds.length}}" class="explore-ref-list"><view wx:for="{{form.referenceAssetIds}}" wx:key="*this" class="explore-ref-item"><text>参考图{{index+1}}</text><button class="text-link" data-index="{{index}}" bindtap="removeReference">移除</button></view></view></view>
  </view><view class="section"><view class="section-heading"><text class="section-title">出图设置</text></view><view class="explore-pair"><label>候选数量<picker class="explore-picker" range="{{countOptions}}" data-key="count" data-list="countOptions" bindchange="pick"><view class="explore-select">{{form.count}}个<image src="/assets/creation-down.png"/></view></picker></label><label>清晰度<picker class="explore-picker" range="{{resolutions}}" data-key="resolution" data-list="resolutions" bindchange="pick"><view class="explore-select">{{form.resolution}}<image src="/assets/creation-down.png"/></view></picker></label><label wx:if="{{platformMode&&kind==='facade'}}">屋顶<picker class="explore-picker" range="{{roofPlatOptions}}" data-key="roof" data-list="roofPlatOptions" bindchange="pick"><view class="explore-select">{{form.roof||'请选择屋顶'}}<image src="/assets/creation-down.png"/></view></picker></label><label wx:if="{{platformMode&&kind==='facade'}}">材质<picker class="explore-picker" range="{{materialOptions}}" data-key="material" data-list="materialOptions" bindchange="pick"><view class="explore-select">{{form.material}}<image src="/assets/creation-down.png"/></view></picker></label><label wx:if="{{platformMode&&kind==='facade'}}">主色<picker class="explore-picker" range="{{colorOptions}}" data-key="color" data-list="colorOptions" bindchange="pick"><view class="explore-select">{{form.color}}<image src="/assets/creation-down.png"/></view></picker></label><label wx:if="{{platformMode}}">画面方向<picker class="explore-picker" range="{{orientationPlatOptions}}" data-key="orientation" data-list="orientationPlatOptions" bindchange="pick"><view class="explore-select">{{form.orientation||'默认'}}<image src="/assets/creation-down.png"/></view></picker></label></view><text class="hint">方案仅供参考，正式成果以设计为准。</text></view><button class="primary explore-wide generate-explore" loading="{{busy}}" disabled="{{busy}}" bindtap="generate">生成{{kind==='plan'?'平面':'立面'}}方案预览</button>
 <view wx:if="{{platPolling}}" class="section explore-generating"><view class="explore-gen-head"><text class="section-title">{{platStatusText||'AI 正在绘制方案…'}}</text><text class="hint">{{form.count}} 张 · 预计 {{platEstimateText}}</text></view><view class="explore-progress"><view class="explore-progress-bar" style="width:{{platProgress}}%"/></view><text class="hint">{{platProgress}}%{{platAccepted>0?' · 已生成 '+platAccepted+' 张':''}}</text><view class="explore-action-pair"><button class="outline" bindtap="refreshJob">刷新查看</button><button class="outline explore-cancel" bindtap="cancelJob">取消生成</button></view><text class="hint">取消后未完成部分自动退点，已生成候选保留。</text></view>
 <view wx:if="{{platCancelResult&&platCancelResult.status==='CANCELLED'}}" class="section"><text class="hint">已取消：扣除的 {{platCancelResult.refunded}} 点已退回。</text></view>
 </block>
 <block wx:elif="{{view==='projects'}}">
  <view class="section"><view wx:for="{{platProjects}}" wx:key="projectId" class="explore-project-card" data-id="{{item.projectId}}" bindtap="openProject"><view class="explore-project-main"><text class="explore-project-name">{{item.name}}</text><text class="hint">{{item.jobStatus||'—'}}{{item.pointsSpentText?' · 消耗 '+item.pointsSpentText+' 点':''}}{{item.createTime?' · '+item.createTime:''}}</text></view><text wx:if="{{item.resumeText}}" class="explore-resume-badge">{{item.resumeText}}</text></view><text wx:if="{{!platProjects.length&&!platProjLoading}}" class="hint">暂无生成记录</text><button wx:if="{{platProjCursor}}" class="text-link explore-wide" bindtap="loadMoreProjects">加载更多</button></view>
 </block>
 <block wx:elif="{{view==='project'}}">
  <view class="section"><view class="section-heading"><text class="section-title">{{platProjectDetail.name||'方案详情'}}</text></view><text class="hint">任务状态：{{platProjectDetail.status||platProjectDetail.jobStatus||'—'}}</text><text wx:if="{{platProjectDetail.resumeText||platProjectDetail.resumeAction}}" class="hint">可续做：{{platProjectDetail.resumeText||platProjectDetail.resumeAction}}</text><image wx:if="{{platProjectResultImage}}" class="explore-case-image" src="{{platProjectResultImage}}" mode="widthFix" bindtap="preview" data-image="{{platProjectResultImage}}"/><view class="explore-action-pair"><button class="primary" bindtap="resumeAction">继续办理</button><button class="outline" bindtap="go" data-view="projects">返回列表</button></view></view>
 </block>
 <block wx:elif="{{view==='plan-result'||view==='facade-result'}}">
  <block wx:if="{{platformMode&&platResult}}">
   <view class="section"><view class="section-heading"><text class="section-title">选择{{kind==='plan'?'平面':'立面'}}方案</text><text class="badge green">AI 生成</text></view><text class="hint">服务端核算 · 候选方案</text><view class="explore-tabs"><button wx:for="{{platResult.candidates}}" wx:key="candidateId" class="explore-candidate {{platResult.selected===index?'selected':''}}" data-index="{{index}}" bindtap="selectCandidate">方案{{index+1}}</button></view><image class="explore-case-image" src="{{platResult.candidates[platResult.selected].imageUrl}}" mode="widthFix" bindtap="preview" data-image="{{platResult.candidates[platResult.selected].imageUrl}}"/><text class="hint">AI 生成方案，建筑布局以正式设计为准。</text></view><text wx:if="{{platResult.refundedPointCost>0}}" class="hint">本次成功 {{platResult.candidates.length}}/{{platResult.candidateTotal||platResult.candidates.length}} 张，已自动退回 {{platResult.refundedPointCost}} 点。</text><view class="explore-action-pair"><button wx:if="{{kind==='plan'}}" class="outline explore-next-facade" bindtap="continueFacade">选用并继续立面</button><button class="primary explore-next-budget" bindtap="continueBudget">选用并测算预算</button></view><button class="outline explore-wide save-explore" bindtap="save">选择客户保存方案</button><view class="explore-action-pair"><button class="outline" bindtap="saveImage">保存到相册</button><button class="outline explore-revise" bindtap="platRevision">调整重生成</button></view>
  </block>
  <block wx:elif="{{platformMode}}"><view class="card empty">请先完成生成<button class="outline btn" bindtap="budgetShowForm">返回</button></view></block>
  <block wx:else><view class="section"><view class="section-heading"><text class="section-title">选择{{kind==='plan'?'平面':'立面'}}方案</text></view><text class="hint">目标{{result.parameters.width}}×{{result.parameters.depth}}m · {{result.parameters.floors}}层 · {{result.parameters.resolution}} · 候选方案</text><view class="explore-tabs"><button wx:for="{{result.candidates}}" wx:key="id" class="explore-candidate {{result.selected===index?'selected':''}}" data-index="{{index}}" bindtap="selectCandidate">方案{{index+1}}</button></view><view wx:if="{{kind==='plan'}}" class="explore-tabs"><button wx:for="{{result.candidates[result.selected].images}}" wx:key="index" class="explore-floor {{floor===index?'selected':''}}" data-index="{{index}}" bindtap="selectFloor">{{index+1}}层</button></view><image class="explore-case-image" src="{{result.candidates[result.selected].images[floor]}}" mode="widthFix" data-image="{{result.candidates[result.selected].images[floor]}}" bindtap="preview"/><text class="hint">方案为参数关联的本地示意，建筑布局以正式设计为准。</text></view><view class="explore-action-pair"><button wx:if="{{kind==='plan'}}" class="outline explore-next-facade" bindtap="continueFacade">选用并继续立面</button><button class="primary explore-next-budget" bindtap="continueBudget">选用并测算预算</button></view><button class="outline explore-wide save-explore" bindtap="save">选择客户保存方案</button></block>
 </block>
 <block wx:elif="{{view==='budget'}}"><view class="section"><view class="section-heading"><text class="section-title">建造规模</text></view><view class="explore-pair"><label>开间（米）<input class="explore-input" type="digit" value="{{form.width}}" data-key="width" bindinput="input"/></label><label>进深（米）<input class="explore-input" type="digit" value="{{form.depth}}" data-key="depth" bindinput="input"/></label><label>建筑层数<input class="explore-input" type="number" value="{{form.floors}}" data-key="floors" bindinput="input"/></label><label wx:if="{{!platformMode}}">占地面积（㎡）<input class="explore-input" type="digit" value="{{form.footprint}}" data-key="footprint" bindinput="input"/></label><label>建筑面积（㎡）<input class="explore-input" type="{{platformMode?'number':'digit'}}" value="{{form.area}}" data-key="area" bindinput="input"/></label><label wx:if="{{!platformMode}}">屋顶面积（㎡）<input class="explore-input" type="digit" value="{{form.roofArea}}" data-key="roofArea" bindinput="input"/></label><label wx:if="{{platformMode}}">区域代码<input class="explore-input" value="{{form.regionCode}}" data-key="regionCode" bindinput="input"/></label></view></view><view class="section"><view class="section-heading"><text class="section-title">建造配置</text></view><block wx:if="{{!platformMode}}"><label class="explore-field">基础<picker class="explore-picker" range="{{foundations}}" data-key="foundation" data-list="foundations" bindchange="pick"><view class="explore-select">{{form.foundation}}<image src="/assets/creation-down.png"/></view></picker></label><label class="explore-field">结构<picker class="explore-picker" range="{{structures}}" data-key="structure" data-list="structures" bindchange="pick"><view class="explore-select">{{form.structure}}<image src="/assets/creation-down.png"/></view></picker></label><label class="explore-field">屋顶<picker class="explore-picker" range="{{roofs}}" data-key="roof" data-list="roofs" bindchange="pick"><view class="explore-select">{{form.roof}}<image src="/assets/creation-down.png"/></view></picker></label><text class="explore-field">外装项目</text><view class="explore-choices"><button wx:for="{{exteriors}}" wx:key="key" class="{{form.exterior[item.key]?'selected':''}}" data-key="{{item.key}}" bindtap="toggleExterior">{{item.label}}</button></view></block><view wx:else class="soft"><view class="kv"><text class="label">结构类型</text><picker range="{{structurePlatOptions}}" data-key="structureType" data-list="structurePlatOptions" bindchange="pick"><view class="explore-select">{{form.structureType}}<image src="/assets/creation-down.png"/></view></picker></view><view class="kv"><text class="label">材质档位</text><picker range="{{gradePlatOptions}}" data-key="materialGrade" data-list="gradePlatOptions" bindchange="pick"><view class="explore-select">{{form.materialGrade}}<image src="/assets/creation-down.png"/></view></picker></view><view class="kv" wx:if="{{platRule.available}}"><text class="label">计价区间</text><text>¥{{platRule.lowText}} – ¥{{platRule.highText}} /㎡</text></view><text wx:if="{{!platRule.available}}" class="muted">当前区域暂无计价规则，无法估算。</text></view></view><button class="primary explore-wide calculate-explore" loading="{{busy}}" disabled="{{busy||(platformMode&&platRule&&!platRule.available)}}" bindtap="calculate">生成参考预算</button></block>
 <block wx:elif="{{view==='budget-result'}}">
  <block wx:if="{{platformMode&&platBudget}}">
   <view class="card section budget-summary"><view class="heading"><text>建造参考预算</text><text class="badge green">AI 区间估算</text></view><view class="budget-total">¥ {{platBudget.lowText}} – ¥ {{platBudget.highText}}</view><text class="muted centered">{{platBudget.disclaimer}}</text></view>
   <view class="explore-action-pair"><button class="outline btn" bindtap="budgetShowForm">调整参数</button><button class="btn primary-action" bindtap="save">选择客户保存方案</button></view>
  </block>
  <block wx:elif="{{platformMode}}"><view class="card empty">请先完成预算测算<button class="outline btn" bindtap="budgetShowForm">返回</button></view></block>
  <block wx:else><template is="budget-result" data="{{budget:budgetPresentation,linked:!!saved,customerName:saved.customerName,continueHandler:'continueFormal',adjustHandler:'adjustBudget',continueLabel:'发起／继续设计委托',canChoose:true}}"/></block>
 </block>
 <view wx:if="{{saved&&view!=='budget-result'}}" class="section explore-saved"><text>已保存至 {{saved.customerName}}</text><button class="text-link" bindtap="viewCustomer">查看客户方案<view class="chevron"/></button></view>
 </view>
 <view wx:if="{{sheet}}" class="explore-overlay" bindtap="closeSheet"><view class="explore-sheet" catchtap="noop"><view class="section-heading"><text class="section-title">选择客户保存</text><button class="text-link" bindtap="closeSheet">关闭</button></view><text class="hint">保存选定方案或预算，其他客户记录不变。</text><scroll-view scroll-y class="explore-customer-list"><button wx:for="{{saveCustomers}}" wx:key="id" class="explore-save-customer" data-id="{{item.id}}" bindtap="saveCustomer"><view><text>{{item.name}}</text><text class="hint">{{item.city}}</text></view><text class="text-link">保存<view class="chevron"/></text></button><text wx:if="{{!saveCustomers.length}}" class="sales-empty">暂无可由本人保存方案的客户</text></scroll-view><text wx:if="{{error||platformErr}}" class="explore-error">{{platformErr||error}}</text><button class="outline explore-wide" bindtap="register">登记新客户</button></view></view>
</view>
