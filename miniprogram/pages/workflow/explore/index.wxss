@import "../../../styles/business-controls.wxss";
@import "../../../styles/workbench.wxss";
@import "../../../styles/sales.wxss";
.explore-page .content{padding-bottom:32rpx}.explore-back{margin-bottom:12rpx}.explore-page .explore-wide{width:100%;margin-bottom:24rpx;min-height:84rpx}.explore-error{display:block;color:#a53124;font-size:var(--zs-font-body);line-height:40rpx;margin-bottom:18rpx;padding:16rpx;background:#fff1eb;border-radius:12rpx}.explore-notice{padding:18rpx;margin-bottom:20rpx;background:#f3e7d7;color:#74431f;border-radius:14rpx}.explore-filters,.explore-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;margin-top:20rpx}.explore-pair>label,.explore-field{display:block;min-width:0;font-size:var(--zs-font-body);line-height:40rpx;color:#5e554b}.explore-pair input,.explore-pair picker>view,.explore-field input,.explore-field picker>view{height:76rpx;margin-top:10rpx;background:var(--zs-bg);border:1rpx solid #e9e1d7;border-radius:12rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:space-between;font-size:var(--zs-font-emphasis);box-sizing:border-box}.explore-page picker image{width:22rpx;height:22rpx;flex-shrink:0}.explore-filters picker>view{display:flex;align-items:center;justify-content:space-between;padding:14rpx;background:var(--zs-bg);border-radius:12rpx;font-size:var(--zs-font-body)}.explore-field{margin-top:20rpx}.explore-field textarea{width:100%;height:160rpx;padding:18rpx;background:var(--zs-bg);border:1rpx solid #e9e1d7;border-radius:12rpx;box-sizing:border-box;margin-top:10rpx;font-size:var(--zs-font-emphasis);line-height:42rpx}.explore-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;margin-bottom:24rpx}.explore-case{background:var(--zs-card);border:1rpx solid var(--zs-line);border-radius:20rpx;overflow:hidden;text-align:left;min-width:0}.explore-case>image{display:block;width:100%;height:220rpx}.explore-case>view{padding:18rpx}.explore-case text{display:block;font-size:var(--zs-font-emphasis);line-height:42rpx}.explore-page .explore-case .hint{font-size:var(--zs-font-caption);line-height:34rpx}.explore-tabs{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0}.explore-tabs>button,.explore-choices>button{font-size:var(--zs-font-body);line-height:38rpx;padding:12rpx 20rpx;background:#f7f3ed;border:1rpx solid var(--zs-line);border-radius:12rpx;color:#74695c}.explore-tabs>button.selected,.explore-choices>button.selected{border-color:var(--zs-brand);color:var(--zs-brand);background:#f7ebdc}.explore-case-image{display:block;width:100%;border-radius:14rpx;margin-bottom:20rpx}.explore-action-pair{display:flex;gap:16rpx;margin-bottom:20rpx}.explore-action-pair>button{flex:1;min-width:0;min-height:84rpx!important;padding:12rpx!important;font-size:var(--zs-font-body)!important}.explore-reference{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:20rpx;flex-wrap:wrap}.explore-choices{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:14rpx}.explore-page .explore-budget-total{background:#f3e7d7;border:1rpx solid #e5d4bc;padding:32rpx}.explore-budget-total>view{display:flex;align-items:baseline;gap:12rpx;margin:20rpx 0}.explore-budget-total>view>text:first-child{font-size:var(--zs-font-metric);line-height:64rpx;font-weight:600;color:#74431f}.explore-budget-total>view>text:last-child{font-size:var(--zs-font-body);color:#74695c}.explore-cost{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid var(--zs-line)}.explore-cost>view>text{display:block}.explore-cost:last-of-type{margin-bottom:20rpx}.explore-saved>text{display:block;font-size:var(--zs-font-emphasis)}.explore-overlay{position:fixed;inset:0;background:rgba(25,19,14,.32);z-index:1000;display:flex;align-items:flex-end}.explore-sheet{background:var(--zs-card);border-radius:28rpx 28rpx 0 0;width:100%;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box}.explore-customer-list{max-height:55vh;margin:20rpx 0}.explore-save-customer{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;padding:24rpx 0;border-bottom:1rpx solid var(--zs-line)}.explore-save-customer>view>text{display:block}.explore-saved{margin-top:24rpx}

.explore-select{height:76rpx;margin-top:10rpx;background:var(--zs-bg);border:1rpx solid #e9e1d7;border-radius:12rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:space-between;font-size:var(--zs-font-emphasis);box-sizing:border-box;width:100%}.explore-select>image{width:22rpx;height:22rpx;flex-shrink:0}.explore-filters .explore-select{margin:0;height:70rpx}
