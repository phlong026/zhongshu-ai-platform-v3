      <view wx:elif="{{item.type==='links'}}" class="links"><button wx:for="{{item.values}}" wx:key="title" wx:for-item="link" data-view="{{link.view}}" data-action="{{link.action}}" data-record="{{link.record}}" bindtap="{{link.view?'go':'action'}}">{{link.title}}<image class="arrow" src="/assets/creation-chevron.png"/></button></view>
      <image wx:elif="{{item.type==='picture'}}" class="section-picture" src="{{item.src}}" mode="widthFix" data-src="{{item.src}}" bindtap="previewImage"/>
      <view wx:elif="{{item.type==='steps'}}" class="steps"><button wx:for="{{item.values}}" wx:key="view" wx:for-item="step" class="row" data-view="{{step.view}}" bindtap="go"><image src="/pages/workflow/assets/biz-{{step.done?'success':'document'}}.jpg" class="round-icon"/><text class="flex">{{step.title}}</text><text class="muted">{{step.done?'已完成':'待办理'}}</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view>
      <view wx:elif="{{item.type==='history'}}" class="kv"><text>{{item.label}}</text><text class="amount">{{item.value}}</text><text class="muted">{{item.date}}</text></view>
      <view wx:elif="{{item.type==='timeline'}}" class="timeline"><view wx:for="{{item.values}}" wx:key="label" wx:for-item="point" class="timeline-row"><image src="/pages/workflow/assets/biz-{{point.done?'timeline-dot':'info'}}.jpg"/><text>{{point.label}}</text><text class="muted right">{{point.date}}</text></view></view>
     </block>
    </view>
    <view wx:if="{{primary}}" class="footer page-actions"><button wx:if="{{secondary}}" class="outline btn" bindtap="secondary">{{secondary}}</button><button class="btn primary-action" bindtap="submit" loading="{{busy}}" disabled="{{view==='payment-first'&&!customer.firstPayment&&(!form.amount||!form.transaction||!form.paymentFile||!form.verified)}}">{{primary}}</button></view>
   </block>
  </block>
  </block><text wx:if="{{error}}" class="error" role="alert">{{error}}</text>
 </view>
</view>
 <view wx:if="{{modal}}" class="overlay {{designFlow?'design-flow':''}}" catchtap="closeModal"><view class="sheet sheet-{{modal}}" catchtap="noop"><view class="sheet-head"><text>{{modal==='register'?'登记客户':modal==='edit'?'编辑客户':modal==='follow'?(customer.follows.length?'记录跟进':'记录首次跟进'):modal==='assign'?'安排设计师':modal==='return'?'退回补充':modal==='receipt'?'新增收款':modal==='generate'?'体验示例方案':'外装配置'}}</text><button class="close" bindtap="closeModal" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view>
 <block wx:if="{{modal==='register'||modal==='edit'}}"><view wx:for="{{[{label:'客户称呼',key:'name',placeholder:'请输入客户称呼'},{label:'手机号',key:'phone',placeholder:'请输入手机号'},{label:'微信号（选填）',key:'wechat',placeholder:'请输入微信号'}]}}" wx:key="key" class="input-row"><text class="label">{{item.label}}</text><view class="input flex"><input data-key="{{item.key}}" value="{{form[item.key]}}" placeholder="{{item.placeholder}}" bindinput="input"/></view></view><text class="muted contact-hint">手机号或微信号至少填写一项</text><view class="input-row"><text class="label">来源</text><picker class="flex" range="{{sourceOptions}}" data-key="source" data-options="sourceOptions" bindchange="pick"><view class="input">{{form.source}}<image class="down" src="/assets/creation-down.png"/></view></picker></view><view class="input-row"><text class="label">建房地区</text><picker class="flex" range="{{provinceOptions}}" data-key="province" data-options="provinceOptions" bindchange="pick"><view class="input">{{form.province}}<image class="down" src="/assets/creation-down.png"/></view></picker><picker class="flex" range="{{cityOptions}}" data-key="city" data-options="cityOptions" bindchange="pick"><view class="input">{{form.city}}<image class="down" src="/assets/creation-down.png"/></view></picker></view><text class="field-label">需求摘要</text><textarea class="textarea" data-key="summary" value="{{form.summary}}" bindinput="input"/><text class="muted owner-note">负责人：我</text></block>
 <block wx:elif="{{modal==='follow'}}"><view class="mini-customer"><view class="initial mini">{{customerInitial}}</view><text>{{customer.name}} · {{city}}二层乡墅 · 演示数据</text></view><text class="field-label">沟通方式</text><view class="options"><button wx:for="{{methodOptions}}" wx:key="*this" class="option {{form.method===item?'selected':''}}" data-key="method" data-value="{{item}}" bindtap="select"><image class="method-icon" src="/pages/workflow/assets/biz-method-{{index===0?'phone':index===1?'wechat':'store'}}.jpg"/>{{item}}</button></view><text class="field-label">沟通结果</text><picker range="{{['已联系','未接通','待回复','已到店']}}" data-key="followResult" data-options="resultOptions" bindchange="pick"><view class="input">{{form.followResult}}<image class="down" src="/assets/creation-down.png"/></view></picker><text class="field-label">需求与沟通内容</text><textarea class="textarea" data-key="followContent" value="{{form.followContent}}" bindinput="input"/><text class="field-label">下次安排</text><view class="options"><button wx:for="{{nextOptions}}" wx:key="*this" class="option {{form.next===item?'selected':''}}" data-key="next" data-value="{{item}}" bindtap="select"><image class="method-icon" src="/pages/workflow/assets/biz-method-{{index===0?'phone':index===1?'wechat':'store'}}.jpg"/>{{item}}</button></view><text class="field-label">时间</text><view class="input"><input data-key="appointment" value="{{form.appointment}}" placeholder="例如：10月19日 15:00" bindinput="input"/><image class="date-icon" src="/assets/calendar.png"/></view><text class="muted owner-note">未保存</text></block>
 <block wx:elif="{{modal==='assign'}}"><text class="muted">{{customer.name}} · {{city}}二层乡墅</text><text class="field-label">设计师</text><picker range="{{designerOptions}}" data-key="designer" data-options="designerOptions" bindchange="pick"><view class="input">{{form.designer}}<image class="down" src="/assets/creation-down.png"/></view></picker><text class="field-label">计划完成日期</text><picker mode="date" data-key="dueDate" value="{{form.dueDate}}" bindchange="date"><view class="input">{{form.dueDate}}<image class="date-icon" src="/assets/calendar.png"/></view></picker><text class="muted owner-note">已受理 · {{customer.intake?customer.intake.date:''}}</text></block>
 <block wx:elif="{{modal==='return'}}"><text class="field-label">具体退回原因与需补事项</text><textarea class="textarea" data-key="returnReason" value="{{form.returnReason}}" placeholder="请说明需要补充的资料或信息" bindinput="input"/><text class="muted">保留原项目及历史记录，在原业务单据补充后重提。</text></block>
 <block wx:elif="{{modal==='generate'}}"><text class="block-text">按当前参数展示 {{form.count||2}} 套模拟方案，参考图和目标尺寸随方案保存，不调用真实AI。</text><button class="outline btn" bindtap="closeModal">返回调整</button></block>
 <block wx:elif="{{modal==='receipt'}}"><view wx:for="{{[{label:'款项用途',key:'receiptPurpose'},{label:'收款金额',key:'receiptAmount'},{label:'实际收款人',key:'receiptReceiver'},{label:'凭据编号',key:'receiptTransaction'}]}}" wx:key="key" class="input-row"><text class="label">{{item.label}}</text><view class="input"><input data-key="{{item.key}}" value="{{form[item.key]}}" bindinput="input" type="{{item.key==='receiptAmount'?'digit':'text'}}"/></view></view><view class="input-row"><text class="label">收款日期</text><picker mode="date" data-key="receiptDate" value="{{form.receiptDate}}" bindchange="date"><view class="input">{{form.receiptDate}}</view></picker></view><button class="upload" data-key="receiptFile" bindtap="upload"><image src="/pages/workflow/assets/biz-add.jpg"/><text>{{form.receiptFile?form.receiptFile.name:'上传客户收款凭证'}}</text></button><text class="muted hint">客户 → 门店，备案不代表银行核验。</text></block>
 <block wx:else><view wx:for="{{[{key:'window',name:'门窗'},{key:'paint',name:'墙漆'},{key:'stone',name:'文化石'},{key:'light',name:'灯光'},{key:'waterproof',name:'防水'},{key:'lightning',name:'防雷'},{key:'insurance',name:'保险'}]}}" wx:key="key" class="input-row"><text>{{item.name}}</text><switch checked="{{form.exterior[item.key]}}" data-key="{{item.key}}" bindchange="exteriorChange" color="{{designFlow?'#81522e':'#a64210'}}"/></view><text class="muted">当前为图稿示例配置，预算按演示单价测算。</text></block>
 <text wx:if="{{error}}" class="error">{{error}}</text><button class="btn sheet-save" bindtap="{{modal==='exterior'?'closeModal':'saveModal'}}">{{modal==='register'||modal==='edit'?'保存客户':modal==='follow'?'保存跟进':modal==='assign'?'确认派单':modal==='return'?'确认退回':modal==='receipt'?'保存收款备案':modal==='generate'?'查看示例':'完成配置'}}</button>
</view></view>
<view wx:if="{{preview}}" class="overlay {{designFlow?'design-flow':''}}" catchtap="closePreview"><view class="sheet" catchtap="noop"><view class="sheet-head"><text>{{preview.name}}</text><button class="close" bindtap="closePreview" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view><image wx:if="{{preview.image}}" class="section-picture" src="{{preview.image}}" mode="widthFix"/><text>{{preview.description}}</text><view wx:if="{{preview.quote}}" class="soft"><view class="money">￥{{fmt.money(preview.quote.total)}}</view><text>计价建筑面积 {{preview.quote.area}}㎡</text><text class="block-text">版本 V{{preview.quote.version}} · {{preview.quote.date}}</text></view><button class="btn sheet-save" bindtap="closePreview">返回</button></view></view>
