    <block wx:if="{{view==='facade-config'}}"><view class="card"><view class="heading">参考图片（选填）</view><view class="facade-references"><image src="/pages/workflow/assets/biz-facade-reference.jpg" mode="aspectFill"/><button wx:for="{{[1,2]}}" wx:key="*this" data-key="facadeReference" bindtap="upload"><image src="/pages/workflow/assets/biz-add.jpg"/>上传图片</button></view><view class="reference-hint"><text class="muted">可上传0–3张参考图。</text><button class="link workflow-nav" data-view="inspiration" bindtap="go">从灵感库选择 <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view><view class="card"><view class="heading">立面需求</view><view class="dimension-row"><text>建筑风格</text><picker class="flex" range="{{facadeStyleOptions}}" data-key="style" data-options="facadeStyleOptions" bindchange="pick"><view class="input">{{form.style}}<image class="down" src="/assets/creation-down.png"/></view></picker><text>建筑层数</text><view class="input"><input data-key="floors" value="{{form.floors}}" bindinput="input"/>层</view></view><view class="input-row"><text class="label">主色调</text><view class="input"><input data-key="palette" value="{{form.palette}}" bindinput="input"/></view></view></view><view class="card"><view class="heading">补充要求</view><textarea class="textarea short" data-key="facadeNotes" value="{{form.facadeNotes}}" bindinput="input"/></view><view class="card settings-card"><view class="heading">生成设置</view><view class="settings-row"><text class="muted">清晰度</text><button wx:for="{{resolutionOptions}}" wx:key="*this" class="option {{form.resolution===item?'selected':''}}" data-key="resolution" data-value="{{item}}" bindtap="select">{{item}}</button><text class="muted">画幅</text><button wx:for="{{aspectOptions}}" wx:key="*this" class="option {{form.aspect===item?'selected':''}}" data-key="aspect" data-value="{{item}}" bindtap="select">{{item}}</button></view><view class="settings-row"><text class="muted">生成张数</text><button wx:for="{{countOptions}}" wx:key="*this" class="option {{form.count===item?'selected':''}}" data-key="count" data-value="{{item}}" bindtap="select">{{item}}</button></view></view><view class="card"><view class="input-row"><text class="label">项目建筑面积</text><view class="input"><input data-key="facadeArea" value="{{form.facadeArea}}" bindinput="input" type="digit"/>㎡（待核定）</view></view><text class="muted hint">尺寸与面积以核定信息为准。</text></view><text class="muted hint">设计点将在提交前确认 · 仅供方案沟通，不作为施工图。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">生成立面方案</button></view></block>
    <block wx:else><view class="card reference-row"><image src="/pages/workflow/assets/biz-facade-1.jpg" mode="aspectFill"/><view class="flex"><text class="row-title">立面方案 · {{form.style}}</text><text class="muted">{{form.floors}}层 · {{form.palette}} · {{form.resolution}} · {{candidateIndexes.length}}张</text><button class="soft-link workflow-nav" data-view="facade-config" bindtap="go">调整参数 <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view><view class="card ai-results facade-candidates"><view class="heading">生成结果<text class="success-text">已完成 {{candidateIndexes.length}}/{{candidateIndexes.length}}</text></view><button wx:for="{{candidateIndexes}}" wx:key="*this" class="plan-choice {{selectedPlan===item?'chosen':''}}" data-index="{{item}}" bindtap="planSelect"><view class="plan-title"><text>方案{{item+1}}</text><view class="plan-select-state"><radio checked="{{selectedPlan===item}}" color="{{designFlow?'#81522e':'#a63f0b'}}"/><text class="copper">{{selectedPlan===item?'已选中':''}}</text></view></view><image src="/pages/workflow/assets/biz-facade-{{item%2+1}}.jpg" class="facade-candidate-image" mode="aspectFill"/></button></view><view class="notice"><text class="row-title copper">选中后，保存为方案版本</text><text class="muted">仅供方案沟通，不作为施工图</text></view><view class="footer page-actions"><button class="outline btn workflow-nav" data-view="facade-config" bindtap="go">重新生成</button><button class="btn primary-action" bindtap="submit">选用并保存</button></view></block>
   </block>
   <block wx:elif="{{view==='facade-result'}}"><view class="card"><view class="heading">正面效果</view><image class="facade-result-image" src="{{currentFacade?currentFacade.image:'/pages/workflow/assets/biz-facade-result.jpg'}}" mode="widthFix" data-src="{{currentFacade?currentFacade.image:'/pages/workflow/assets/biz-facade-result.jpg'}}" bindtap="previewImage"/></view><view class="card"><view class="heading">方案信息</view><view class="metric-inputs"><view wx:for="{{[{label:'建筑风格',value:currentFacade?currentFacade.style:'新中式'},{label:'建筑层数',value:(currentFacade?currentFacade.floors:customer.floors)+'层'},{label:'主色调',value:currentFacade?currentFacade.palette:'米白 + 深灰'},{label:'项目建筑面积',value:(currentFacade?currentFacade.area:form.facadeArea)+'㎡（待核定）'}]}}" wx:key="label" class="metric-input"><text class="muted">{{item.label}}</text><text class="stat-value block-text">{{item.value}}</text></view></view></view><view class="notice copper">仅供方案沟通，不作为施工图。</view><view class="footer page-actions"><button class="outline btn" bindtap="saveAlbum">保存到相册</button><button class="btn primary-action" bindtap="submit">报价测算</button></view></block>
   <block wx:else>
    <view wx:for="{{sections}}" wx:key="index" wx:for-item="section" class="card section-{{index}} {{section.tint?'tinted':''}}">
     <view wx:if="{{section.title}}" class="heading"><text>{{section.title}}</text><text wx:if="{{section.meta}}" class="muted meta">{{section.meta}}</text><text wx:if="{{section.badge}}" class="badge {{section.badgeGreen?'green':''}}">{{section.badge}}</text></view>
     <block wx:for="{{section.items}}" wx:key="index" wx:for-item="item">
      <view wx:if="{{item.type==='kv'}}" class="kv soft-kv"><text class="label">{{item.label}}</text><text class="flex">{{item.value}}</text></view>
      <text wx:elif="{{item.type==='text'}}" class="block-text {{item.style}}">{{item.value}}</text>
      <view wx:elif="{{item.type==='file'}}" class="file-row" data-key="{{item.key}}" data-name="{{item.name}}" data-file="{{item.file}}" bindtap="previewFile"><image src="{{item.icon==='image'?'/assets/studio-image.png':item.file.text?'/pages/workflow/assets/biz-document.jpg':'/pages/workflow/assets/biz-pdf.jpg'}}"/><view class="flex"><text class="file-name">{{item.file?item.file.name:(item.key&&form[item.key]?fileNames[item.key]:item.name)}}</text></view><text wx:if="{{item.badge}}" class="badge green">{{item.badge}}</text><text wx:else class="muted file-action">预览</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></view>
      <view wx:elif="{{item.type==='input'}}" class="input-row {{item.long?'stacked':''}}"><text class="label">{{item.label}}</text><picker wx:if="{{item.kind==='date'||item.key==='paymentDate'||item.key==='measurementDate'||item.key==='signedDate'||item.key==='receiveDate'||item.key==='confirmationDate'||item.key==='receiptDate'}}" class="flex" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="date"><view class="input">{{form[item.key]||item.placeholder}}<image class="date-icon" src="/assets/calendar.png"/></view></picker><picker wx:elif="{{item.key==='manager'}}" class="flex" range="{{managerOptions}}" data-key="{{item.key}}" data-options="managerOptions" bindchange="pick"><view class="input">{{form[item.key]||item.placeholder}}<image class="arrow" src="/assets/creation-chevron-muted.png"/></view></picker><view wx:else class="input flex"><input class="business-input" data-key="{{item.key}}" value="{{form[item.key]}}" placeholder="{{item.placeholder}}" bindinput="input" type="{{item.inputType||((item.key==='amount'||item.key==='receiptAmount')?'digit':'text')}}"/><text wx:if="{{item.unit}}" class="muted">{{item.unit}}</text></view></view>
      <view wx:elif="{{item.type==='choice'}}"><text class="field-label">{{item.label}}</text><view class="options"><button wx:for="{{item.values}}" wx:key="*this" wx:for-item="value" class="option {{form[item.key]===value?'selected':''}}" data-key="{{item.key}}" data-value="{{value}}" bindtap="select">{{value}}</button></view></view>
      <view wx:elif="{{item.type==='textarea'}}" class="textarea-field"><text wx:if="{{item.label}}" class="field-label">{{item.label}}</text><textarea class="textarea" placeholder="{{item.placeholder}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="2000"/></view>
      <view wx:elif="{{item.type==='upload'}}" class="upload-row"><button class="upload" data-key="{{item.key}}" bindtap="upload"><image src="/pages/workflow/assets/biz-add.jpg"/><text>{{form[item.key]?fileNames[item.key]:item.label}}</text><text class="muted">{{form[item.key]?'点击更换':'支持 PDF、图片'}}</text></button></view>
      <button wx:elif="{{item.type==='check'}}" class="check-row" aria-checked="{{form[item.key]}}" data-key="{{item.key}}" bindtap="toggle"><image class="checkbox-image" src="/pages/workflow/assets/biz-checkbox-{{form[item.key]?'checked':'empty'}}.jpg"/><text>{{item.label}}</text></button>
      <view wx:elif="{{item.type==='notice'}}" class="notice"><image src="/pages/workflow/assets/biz-info.jpg"/><text>{{item.value}}</text></view>
      <view wx:elif="{{item.type==='stats'}}" class="stats soft"><view wx:for="{{item.values}}" wx:key="label" wx:for-item="stat"><text class="muted">{{stat.label}}</text><text class="stat-value">{{stat.value}}</text></view></view>
      <view wx:elif="{{item.type==='links'}}" class="links"><button class="workflow-nav" wx:for="{{item.values}}" wx:key="title" wx:for-item="link" data-view="{{link.view}}" data-action="{{link.action}}" data-record="{{link.record}}" data-url="{{link.url}}" bindtap="{{link.url?'navTap':(link.view?'go':'action')}}">{{link.title}}<image class="arrow" src="/assets/creation-chevron.png"/></button></view>
     </block>
    </view>
    <view wx:if="{{primary}}" class="footer page-actions"><button wx:if="{{secondary}}" class="outline btn" bindtap="secondary">{{secondary}}</button><button class="btn primary-action" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{primary}}</button></view>
   </block>
  </block>
  </block><text wx:if="{{error}}" class="error" role="alert">{{error}}</text>
 </view>
</view>
 <view wx:if="{{modal&&modal!=='collect'}}" style="bottom:{{keyboardInset||0}}px" class="overlay business-surface {{designFlow?'design-flow':''}}" catchtap="closeModal"><view class="sheet sheet-{{modal}} keyboard-sheet" style="height:{{sheetHeight}}px" catchtap="noop"><view class="sheet-head"><text>{{modal==='register'?'登记客户':modal==='edit'?'编辑客户':modal==='follow'?(customer.follows.length?'记录跟进':'记录首次跟进'):modal==='assign'?'安排设计师':modal==='return'?'退回补充':modal==='receipt'?'新增收款':modal==='generate'?'预览方案':'外装配置'}}</text><button class="close" bindtap="closeModal" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view>
 <scroll-view class="sheet-fields" scroll-y enhanced scroll-top="{{sheetScrollTop}}" bindscroll="sheetScrolled" scroll-into-view="{{sheetFocusTarget}}" scroll-with-animation="{{false}}">
 <block wx:if="{{modal==='register'||modal==='edit'}}">
  <view class="input-row" id="customer-name-field"><text class="label">客户姓名</text><view class="input flex"><input class="business-input" data-key="name" data-field="customer-name-field" value="{{form.name}}" placeholder="请输入客户姓名" maxlength="64" disabled="{{busy||customerRetry}}" adjust-position="{{false}}" cursor-spacing="24" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view></view>
  <view class="input-row" id="customer-phone-field"><text class="label">手机号</text><view class="input flex"><input type="number" class="business-input" data-key="phone" data-field="customer-phone-field" value="{{form.phone}}" placeholder="请输入11位手机号" maxlength="11" disabled="{{busy||customerRetry||modal==='edit'}}" adjust-position="{{false}}" cursor-spacing="24" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view></view>
  <view wx:if="{{modal==='edit'}}" class="input-row" id="customer-wechat-field"><text class="label">微信号（选填）</text><view class="input flex"><input class="business-input" data-key="wechat" data-field="customer-wechat-field" value="{{form.wechat}}" placeholder="请输入微信号" maxlength="64" disabled="{{busy||customerRetry}}" adjust-position="{{false}}" cursor-spacing="24" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view></view>
  <text wx:if="{{modal==='edit'}}" class="muted contact-hint">手机号不可修改</text>
  <text class="field-label">地址</text>
  <view id="customer-address-field"><customer-address id="customer-address" value="{{form}}" disabled="{{busy||customerRetry}}" bindchange="customerAddressChanged" bindfieldfocus="formFieldFocus" bindfieldblur="formFieldBlur"/></view>
  <view class="input-row" id="customer-address-detail-field"><text class="label">详细地址（选填）</text><view class="input flex"><input class="business-input" data-key="addressDetail" data-field="customer-address-detail-field" value="{{form.addressDetail}}" placeholder="组、门牌号或建房位置" maxlength="200" disabled="{{busy||customerRetry}}" adjust-position="{{false}}" cursor-spacing="24" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view></view>
  <view class="input-row"><text class="label">来源</text><picker wx:if="{{modal==='register'}}" class="flex" range="{{sourceOptions}}" data-key="source" data-options="sourceOptions" disabled="{{busy||customerRetry}}" bindchange="pick"><view class="input">{{form.source||'请选择客户来源'}}<image class="down" src="/assets/creation-down.png"/></view></picker><text wx:else class="flex">{{form.source}}</text></view>
  <view id="customer-summary-field"><text class="field-label">需求摘要</text><textarea class="textarea" data-key="summary" data-field="customer-summary-field" value="{{form.summary}}" placeholder="请填写建房需求（500字以内）" maxlength="500" disabled="{{busy||customerRetry}}" adjust-position="{{false}}" cursor-spacing="24" show-confirm-bar="{{false}}" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view>
 </block>
 <block wx:elif="{{modal==='follow'}}"><view class="mini-customer"><view class="initial mini">{{customerInitial}}</view><text>{{customer.name}} · {{projectSummary}}</text></view><block wx:if="{{!platformMode}}"><text class="field-label">沟通方式</text><view class="options"><button wx:for="{{methodOptions}}" wx:key="*this" class="option {{form.method===item?'selected':''}}" data-key="method" data-value="{{item}}" bindtap="select"><image class="method-icon" src="/pages/workflow/assets/biz-method-{{index===0?'phone':index===1?'wechat':'store'}}.jpg"/>{{item}}</button></view><text class="field-label">沟通结果</text><picker range="{{['已联系','未接通','待回复','已到店']}}" data-key="followResult" data-options="resultOptions" bindchange="pick"><view class="input">{{form.followResult}}<image class="down" src="/assets/creation-down.png"/></view></picker></block><block wx:if="{{platformMode}}"><text class="field-label">本次记录</text><view class="options"><button class="option {{form.contactKind!=='VISIT'?'selected':''}}" data-key="contactKind" data-value="FOLLOW" disabled="{{busy}}" bindtap="select">普通跟进</button><button class="option {{form.contactKind==='VISIT'?'selected':''}}" data-key="contactKind" data-value="VISIT" disabled="{{busy}}" bindtap="select">实际接待</button></view><text class="field-label">发生日期</text><picker mode="date" end="{{todayStr}}" value="{{form.occurredOn||todayStr}}" data-key="occurredOn" bindchange="date" disabled="{{busy}}"><view class="input">{{form.occurredOn||todayStr}}</view></picker></block><text class="field-label">需求与沟通内容</text><textarea id="follow-content-field" disabled="{{busy}}" data-field="follow-content-field" adjust-position="{{false}}" cursor-spacing="24" show-confirm-bar="{{false}}" bindfocus="formFieldFocus" bindblur="formFieldBlur" class="textarea" data-key="followContent" value="{{form.followContent}}" bindinput="input"/><block wx:if="{{!platformMode}}"><text class="field-label">下次安排</text><view class="options"><button wx:for="{{nextOptions}}" wx:key="*this" class="option {{form.next===item?'selected':''}}" data-key="next" data-value="{{item}}" bindtap="select"><image class="method-icon" src="/pages/workflow/assets/biz-method-{{index===0?'phone':index===1?'wechat':'store'}}.jpg"/>{{item}}</button></view><text class="field-label">时间</text><view class="input"><input data-key="appointment" value="{{form.appointment}}" placeholder="例如：10月19日 15:00" bindinput="input"/><image class="date-icon" src="/assets/calendar.png"/></view></block><block wx:else><text class="field-label">下次回访日期</text><picker mode="date" start="{{todayStr}}" data-key="appointment" bindchange="date" disabled="{{busy}}"><view class="input">{{form.appointment||'选择日期'}}<image class="date-icon" src="/assets/calendar.png"/></view></picker></block><text wx:if="{{!platformMode}}" class="muted owner-note">未保存</text></block>
 <block wx:elif="{{modal==='generate'}}"><text class="block-text">按当前参数展示 {{form.count||2}} 套方案预览，参考图和目标尺寸随方案保存，不调用真实AI。</text><button class="outline btn" bindtap="closeModal">返回调整</button></block>
 <block wx:else><view wx:for="{{[{key:'window',name:'门窗'},{key:'paint',name:'墙漆'},{key:'stone',name:'文化石'},{key:'light',name:'灯光'},{key:'waterproof',name:'防水'},{key:'lightning',name:'防雷'},{key:'insurance',name:'保险'}]}}" wx:key="key" class="input-row"><text>{{item.name}}</text><switch checked="{{form.exterior[item.key]}}" data-key="{{item.key}}" bindchange="exteriorChange" color="{{designFlow?'#81522e':'#a64210'}}"/></view></block>
 </scroll-view><view class="sheet-actions"><text wx:if="{{error}}" class="error" role="alert">{{error}}</text><button loading="{{busy}}" disabled="{{busy}}" class="btn sheet-save" bindtap="{{modal==='exterior'?'closeModal':'saveModal'}}">{{customerRetry==='view'?'重试查看':customerRetry==='confirm'?'重试确认':modal==='register'||modal==='edit'?'保存客户':modal==='follow'?'保存跟进':modal==='assign'?'确认派单':modal==='return'?'确认退回':modal==='receipt'?'保存收款备案':modal==='generate'?'查看方案':'完成配置'}}</button></view>
</view></view>
<view wx:if="{{modal==='collect'}}" class="overlay business-surface {{designFlow?'design-flow':''}}" catchtap="closeModal"><view class="sheet sheet-collect" catchtap="noop"><view class="sheet-head"><text>办理回款</text><button class="close" bindtap="closeModal" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view><view wx:if="{{collectStageText}}" class="soft"><text class="muted">{{collectStageText}}</text></view><view class="input-row"><text class="label">本次金额</text><view class="input flex"><input type="digit" class="business-input" data-key="amount" value="{{collectForm.amount}}" placeholder="本次回款金额（元）" bindinput="platCollectInput"/></view></view><view class="input-row"><text class="label">收款方式</text><picker class="flex" range="{{['银行转账','现金']}}" value="{{collectForm.method==='cash'?1:0}}" bindchange="platCollectPick"><view class="input">{{collectForm.method==='cash'?'现金':'银行转账'}}<image class="down" src="/assets/creation-down.png"/></view></picker></view><view class="input-row"><text class="label">收款账户（选填）</text><view class="input flex"><input class="business-input" data-key="accountName" maxlength="100" value="{{collectForm.accountName}}" placeholder="公司收款账户名称" bindinput="platCollectInput"/></view></view><view class="input-row"><text class="label">流水号{{collectForm.method==='bank'?'':'（选填）'}}</text><view class="input flex"><input class="business-input" data-key="transactionNo" value="{{collectForm.transactionNo}}" placeholder="请输入银行流水号" bindinput="platCollectInput"/></view></view><view class="input-row"><text class="label">到账日期</text><view class="input flex"><input class="business-input" data-key="receivedDate" value="{{collectForm.receivedDate}}" placeholder="YYYY-MM-DD（不晚于今天）" bindinput="platCollectInput"/></view></view><text wx:if="{{error}}" class="error">{{error}}</text><view class="page-actions"><button class="btn bottom-inline" loading="{{busy}}" disabled="{{busy}}" bindtap="platCollectSubmit">确认办理回款</button></view></view></view>
<view wx:if="{{preview}}" class="overlay business-surface {{designFlow?'design-flow':''}}" catchtap="closePreview"><view class="sheet" catchtap="noop"><view class="sheet-head"><text>{{preview.name}}</text><button class="close" bindtap="closePreview" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view><image wx:if="{{preview.image}}" class="section-picture" src="{{preview.image}}" mode="widthFix"/><text>{{preview.description}}</text><view wx:if="{{preview.quote}}" class="soft"><view class="money">¥ {{fmt.money(preview.quote.total)}}</view><text>计价建筑面积 {{preview.quote.area}}㎡</text><text class="block-text">版本 V{{preview.quote.version}} · {{preview.quote.date}}</text></view><button class="btn sheet-save" bindtap="closePreview">返回</button></view></view>
