<wxs src="./format.wxs" module="fmt"></wxs>
<view class="workflow {{designFlow?'design-flow':''}} view-{{view}} {{caseTab?'has-plan':''}} {{extended?'extended':''}}">
 <business-header id="workflow-header" title="{{title}}" design-flow="{{designFlow}}"/><demo-guide id="demo-guide"/>
 <view wx:if="{{!customer&&view!=='customers'}}" class="body"><view class="card empty">{{error}}<view class="page-actions"><button class="btn" data-view="customers" bindtap="go">返回客户列表</button></view></view></view>
 <view wx:else class="body"><view wx:if="{{customer.contract}}" class="card"><button class="outline btn" data-view="receivables" bindtap="openOperating">合同应收与阶段付款条件</button><button class="outline btn" data-view="expenses" bindtap="openOperating">项目费用与原单办理</button></view>
  <view wx:if="{{blocked}}" class="card empty"><text>{{blocked.message}}</text><view class="page-actions"><button class="btn" data-view="{{blocked.target}}" bindtap="go">{{blocked.label}}</button></view></view><block wx:else>
  <block wx:if="{{view==='customers'}}">
   <view class="search"><image src="/assets/search.png"/><input placeholder="搜索姓名、手机号" value="{{keyword}}" bindinput="searchCustomers"/></view>
   <view class="list-title"><text>{{selectingCustomer?'选择本次办理的客户':'我的客户'}}</text><button wx:if="{{canRegister}}" data-modal="register" bindtap="modal">登记客户</button></view>
   <view class="tabs"><button wx:for="{{filters}}" wx:key="*this" class="{{filter===item?'active':''}}" data-value="{{item}}" bindtap="setFilter">{{item}}</button></view>
   <view wx:for="{{filteredCustomers}}" wx:key="id" class="card customer-list-row" data-id="{{item.id}}" bindtap="chooseCustomer"><view class="initial small">{{item.name[0]}}</view><view class="flex"><view class="name">{{item.name}} <text class="badge">{{item.status}}</text></view><text class="muted">{{item.phone || item.wechat}} · {{item.city}}</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></view>
   <view wx:if="{{!filteredCustomers.length}}" class="card empty">暂无符合条件的客户<button wx:if="{{canRegister}}" class="outline btn" data-modal="register" bindtap="modal">登记客户</button></view>
  </block>
  <block wx:else>
   <view wx:if="{{role}}" class="operation-identity">当前办理身份：{{role}} <text>· 客户角色与办理岗位分别显示</text></view>
   <view wx:if="{{view!=='transfer'}}" class="card customer-banner {{large?'large':'compact'}} {{view==='result'||view==='facade-result'?'result-banner':''}}">
    <view class="banner-main"><view class="initial {{large?'':'small'}}">{{customerInitial}}</view><view class="banner-info"><view class="name">{{view==='copies'?customer.name+'的乡墅':customer.name}}<text wx:if="{{view==='budget'}}" class="budget-city">· {{city}}</text><text wx:if="{{view==='contract'||view==='funds'}}" class="badge">演示数据</text><text wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="badge">{{customer.status}}</text></view>
     <view wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="banner-line"><image src="/pages/workflow/assets/biz-phone.jpg"/>{{phone || customer.wechat}}</view>
     <view wx:if="{{view!=='budget'}}" class="banner-line"><image wx:if="{{large}}" src="/pages/workflow/assets/biz-location.jpg"/>{{large?'':'· '}}{{city}}{{view==='ai-config'||view==='ai-results'||view==='result'||view==='facade-config'||view==='facade-candidates'||view==='facade-result'?'':' · 二层乡墅'}}{{view==='request'||view==='payment-first'||view==='intake'||view==='assign'||view==='deliverable'||view==='payment-tail'||view==='release'||view==='documents'||view==='copies'||view==='handover'||view==='receive'?' · '+(currentBudget?currentBudget.area:400)+'㎡':''}}</view>
     <text wx:if="{{view==='budget'||view==='budget-result'}}" class="muted">{{currentPlan?'平面方案 v'+currentPlan.version:currentFacade?'立面方案 v'+currentFacade.version:'未关联方案'}}</text>
    </view><text wx:if="{{badge}}" class="badge banner-badge">{{badge}}</text><text wx:if="{{view==='customer'||view==='quote'}}" class="demo-badge">演示数据</text><view wx:if="{{view==='quote'}}" class="quote-phone"><image src="/pages/workflow/assets/biz-phone.jpg"/>{{phone}}</view><text wx:if="{{view==='request'&&customer.contract}}" class="banner-date">{{customer.contract.date}}</text></view>
    <block wx:if="{{view==='result'||view==='facade-result'}}"><view class="result-name">{{view==='result'?'平面':'立面'}}方案 V{{view==='result'?(currentPlan?currentPlan.version:1):(currentFacade?currentFacade.version:1)}} <text class="badge green">已选用</text></view><text class="muted">方案版本已保存</text></block>
    <view wx:if="{{headerItems}}" class="soft"><view wx:for="{{headerItems}}" wx:key="label" class="kv"><text class="label">{{item.label}}</text><text>{{item.value}}</text></view></view>
   </view>
   <view wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="tabs customer-tabs"><button wx:for="{{['概况','跟进','项目进度']}}" wx:key="*this" class="{{activeCustomerTab===index?'active':''}}" data-index="{{index}}" bindtap="customerTab">{{item}}</button></view>
   <view wx:if="{{tabs.length}}" class="tabs"><button wx:for="{{tabs}}" wx:key="*this" class="{{activeTab===index?'active':''}}" data-index="{{index}}" bindtap="tabs">{{item}}</button></view>

   <block wx:if="{{view==='customer'||view==='arrival'}}">
    <view wx:if="{{activeCustomerTab===0}}" class="card"><view class="heading"><text>客户资料</text><button wx:if="{{canEditCustomer}}" class="link" data-modal="edit" bindtap="modal">编辑 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="soft"><view class="kv"><text class="label">来源</text><text>{{customer.source}}</text><text class="label owner">负责人</text><text>{{customer.owner||'我'}}</text></view><block wx:if="{{customer.status==='已到店'}}"><text class="muted">确认建房需求</text><view class="kv"><text class="label">建筑外轮廓</text><text>面宽 {{customer.width}}米 × 进深 {{customer.depth}}米</text></view><view class="kv"><text class="label">计划层数</text><text>{{customer.floors}}层</text></view></block><view class="kv summary"><text class="label">{{customer.status==='已到店'?'需求摘要':'需求'}}</text><text class="flex">{{customer.summary}}</text></view></view></view>
    <view wx:if="{{hasDesign||currentBudget}}" class="card"><view class="heading">设计协同</view><text class="row-title">{{coordination.state}}</text><text class="muted">当前责任：{{coordination.owner}}</text><button class="outline btn" data-view="delivery" bindtap="go">{{hasDesign?'继续设计协同':'发起设计委托'}}</button></view><view class="card follow-card"><view class="heading"><text>{{customer.follows.length?'沟通记录':'跟进记录'}}</text><button wx:if="{{canFollow && customer.follows.length}}" class="link" data-modal="follow" bindtap="modal">记录跟进 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view wx:if="{{!customer.follows.length}}" class="follow-empty"><image src="/pages/workflow/assets/biz-empty-follow.jpg"/><text class="empty-title">暂无跟进记录</text><text class="muted">记录首次沟通，完善客户需求。</text></view><view wx:for="{{customer.follows}}" wx:key="index" class="soft follow-record"><image src="/pages/workflow/assets/biz-record.jpg"/><view class="flex"><text class="row-title">{{item.method==='到店'?'到店沟通已完成':item.method+'沟通'}} <text class="badge">{{item.result}}</text></text><text class="muted">{{item.date}} {{item.appointment}}</text><text class="muted">{{item.content}}</text></view></view></view>
    <view class="card"><view class="heading">项目办理</view><view class="tool-grid"><button wx:for="{{[{name:'概念方案',icon:'document',view:'inspiration'},{name:'正式报价',icon:'book',view:'quote'},{name:'合同资金',icon:'money',view:'contract'},{name:'设计协同',icon:'house',view:'delivery'}]}}" wx:key="view" data-view="{{item.view}}" bindtap="go"><image src="/pages/workflow/assets/biz-{{item.icon}}.jpg"/><text>{{item.name}}</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view></view>
    <view wx:if="{{canFollow && !customer.follows.length && !hasDesign}}" class="page-actions"><button wx:if="{{canFollow}}" class="btn bottom-inline" data-modal="follow" bindtap="modal">记录首次跟进</button></view><view wx:else class="page-actions"><button class="btn bottom-inline" data-view="{{hasDesign?'delivery':'inspiration'}}" bindtap="go">{{hasDesign?'继续设计协同':'查找参考方案'}}</button></view>
   </block>
   <block wx:elif="{{view==='progress'}}">
    <view class="card"><view class="heading">当前阶段</view><view class="soft stage"><image src="/pages/workflow/assets/biz-document.jpg"/><text>{{stage}}</text><text class="badge">{{engineeringStatus||(customer.acceptance?'待开工':'待客户反馈')}}</text></view></view>
    <view class="card"><view class="heading">方案与预算</view><button class="soft archive-row" data-view="result" bindtap="go"><image class="thumb" src="/pages/workflow/assets/biz-formal-plan.jpg"/><view class="flex"><text class="row-title">平面方案 v{{currentPlan?currentPlan.version:1}} <text class="badge neutral">{{currentPlan?'已归档':'未保存'}}</text></text><text class="muted">{{customer.width}}m × {{customer.depth}}m · {{customer.floors}}层</text></view><text class="link">查看方案</text><image class="arrow" src="/assets/creation-chevron.png"/></button><button class="soft archive-row" data-view="budget-result" bindtap="go"><image class="round-icon" src="/pages/workflow/assets/biz-calculator.jpg"/><view class="flex"><text class="row-title">参考预算 版本{{currentBudget?currentBudget.version:1}}</text><text class="amount">{{currentBudget?'￥'+fmt.money(currentBudget.total):'暂无预算'}}</text><text class="muted">关联平面方案 v{{currentPlan?currentPlan.version:1}} · 演示金额</text></view><text class="link">查看预算</text><image class="arrow" src="/assets/creation-chevron.png"/></button></view>
    <view class="card"><view class="heading">继续完善</view><view class="tool-grid three"><button data-view="inspiration" bindtap="go"><image src="/assets/studio-image.png"/>找参考<image class="arrow" src="/assets/creation-chevron-muted.png"/></button><button data-view="ai-config" bindtap="go"><image src="/pages/workflow/assets/biz-document.jpg"/>生成方案<image class="arrow" src="/assets/creation-chevron-muted.png"/></button><button data-view="budget" bindtap="go"><image src="/pages/workflow/assets/biz-calculator.jpg"/>做预算<image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view></view>
    <view class="card"><view class="heading">跟进安排</view><button wx:if="{{canFollow}}" class="row" data-modal="follow" bindtap="modal"><image class="round-icon" src="/assets/studio-clock.png"/><view class="flex"><text class="row-title">与客户沟通方案及预算</text><text class="muted">记录反馈，继续完善建房需求</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="tool-grid"><button data-view="quote" bindtap="go">正式报价</button><button data-view="delivery" bindtap="go">设计协同进度</button></view><view class="page-actions"><button class="btn bottom-inline" data-modal="follow" bindtap="modal">记录沟通</button></view>
   </block>
   <block wx:elif="{{view==='inspiration'||view==='search'}}">
    <view wx:if="{{view==='inspiration'}}" class="search"><image src="/assets/search.png"/><input placeholder="输入案例编号或名称" bindinput="searchCases"/></view>
    <view class="card dimension-card"><view class="dimension-row"><text>面宽</text><view class="input"><input data-key="width" value="{{form.width}}" bindinput="input" type="digit"/><text>m</text></view><text>进深</text><view class="input"><input data-key="depth" value="{{form.depth}}" bindinput="input" type="digit"/><text>m</text></view></view><text class="muted hint">{{view==='search'?'按建筑外轮廓检索':'建筑尺寸3–40m，支持一位小数'}}</text><view wx:if="{{view==='inspiration'}}" class="dimension-row style-row"><text>风格</text><picker range="{{styleOptions}}" data-key="filterStyle" data-options="styleOptions" bindchange="pick"><view class="input">{{form.filterStyle||'全部风格'}}<image class="down" src="/assets/creation-down.png"/></view></picker><text>层数</text><picker range="{{floorOptions}}" data-key="floorFilter" data-options="floorOptions" bindchange="pick"><view class="input">{{form.floorFilter||'全部层数'}}<image class="down" src="/assets/creation-down.png"/></view></picker></view></view>
    <block wx:if="{{view==='search'}}"><button class="btn search-btn" bindtap="applySearch">检索平面方案</button><text class="muted hint outside">匹配范围±1m，最多50套，按尺寸差排序。</text></block>
    <view class="heading outside"><text>{{view==='search'?'匹配结果':'案例推荐'}}</text><text wx:if="{{view==='search'}}" class="muted">{{filteredCases.length}}套</text></view><view class="case-grid"><button wx:for="{{filteredCases}}" wx:key="id" class="case-card" data-id="{{item.id}}" bindtap="openCase"><image class="case-photo" src="{{item.image}}" mode="aspectFill"/><view class="case-copy"><text class="row-title">{{item.name}}</text><text class="muted">{{view==='search'?item.id:'编号 '+item.id+'　|　'+item.area+'㎡ · '+item.floors+'层'}}</text><text wx:if="{{view==='search'}}" class="muted">面宽 {{item.width}}m · 进深 {{item.depth}}m</text></view></button></view><view wx:if="{{!filteredCases.length}}" class="card empty">没有匹配方案，请调整尺寸或检索条件。</view>
   </block>
   <block wx:elif="{{view==='case'||view==='case-plan'}}">
    <view class="card case-detail {{caseTab?'plan-visible':''}}"><image class="hero" src="{{selectedCase.id==='ZS001'?(caseTab?'/pages/workflow/assets/biz-case-plan-hero.jpg':'/pages/workflow/assets/biz-case-hero.jpg'):selectedCase.image}}" mode="aspectFill" data-src="{{selectedCase.image}}" bindtap="previewImage"/><view class="case-detail-copy"><view class="case-name"><text>{{selectedCase.name}}</text><button class="link" bindtap="favorite"><image src="/pages/workflow/assets/biz-heart.jpg"/>{{favorite?'已收藏':'收藏'}}</button></view><text class="muted">编号 {{selectedCase.id}} · V1 · 本地模拟灵感</text><view class="stats"><view wx:for="{{[{label:'建筑面积',value:selectedCase.area+'㎡'},{label:'层数',value:selectedCase.floors+'层'},{label:'面宽',value:selectedCase.width+'m'},{label:'进深',value:selectedCase.depth+'m'}]}}" wx:key="label"><text class="muted">{{item.label}}</text><text class="stat-value copper">{{item.value}}</text></view></view></view></view><view class="tabs line-tabs"><button wx:for="{{caseTabs}}" wx:key="*this" data-index="{{index}}" bindtap="caseTab" class="{{caseTab===index?'active':''}}">{{item}}</button></view><image class="case-plan-picture" wx:if="{{caseTab&&!casePlanUnavailable}}" src="{{selectedCase.floorPlans[caseTab-1].image}}" mode="widthFix"/><view wx:elif="{{casePlanUnavailable}}" class="card empty">该案例尚未提供平面资料，请选择已有平面图的案例。<button class="outline btn" data-view="inspiration" bindtap="go">返回方案参考</button></view><image wx:else class="case-second" src="{{selectedCase.id==='ZS001'?(caseTab?'/pages/workflow/assets/biz-case-plan-hero.jpg':'/pages/workflow/assets/biz-case-hero.jpg'):selectedCase.image}}" mode="aspectFill"/><text class="muted centered">{{caseTab?'方案示意，非施工图。用整套案例作为设计参考。':'案例图片仅供方案参考'}}</text>
    <view class="footer page-actions"><button wx:if="{{!caseTab}}" class="outline btn" data-view="ai-facade" bindtap="go">AI立面设计</button><button class="btn" data-view="{{caseTab?'ai-config':'search'}}" bindtap="go">{{caseTab?'平面方案':'户型检索'}}</button></view>
   </block>
   <block wx:elif="{{view==='ai-config'||view==='ai-facade'||view==='ai-results'}}">
    <view class="tabs"><button class="{{view!=='ai-facade'?'active':''}}" data-view="ai-config" bindtap="go">平面方案</button><button class="{{view==='ai-facade'?'active':''}}" data-view="ai-facade" bindtap="go">立面方案</button></view>
    <view class="card reference-row"><image src="{{referenceImage}}" mode="aspectFit"/><image wx:if="{{view==='ai-config'}}" src="/pages/workflow/assets/biz-plan-2.jpg" mode="aspectFit"/><view class="flex"><text class="row-title">{{view==='ai-results'?'参考方案':'已选参考'}} · {{referenceCase?referenceCase.name:'当前客户方案'}} <text class="badge">{{referenceCase?'V1':'示意'}}</text></text><text class="muted">{{form.floors}}层 · 面宽{{form.width}}m · 进深{{form.depth}}m</text><button class="soft-link" data-view="{{view==='ai-results'?'ai-config':'inspiration'}}" bindtap="go">{{view==='ai-results'?'调整参数':'更换参考'}} <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view>
    <block wx:if="{{view!=='ai-results'}}">
     <view class="card"><view class="heading">尺寸与需求</view><view class="dimension-row"><text>面宽</text><view class="input"><input data-key="width" value="{{form.width}}" bindinput="input" type="digit"/><text>m</text></view><text>进深</text><view class="input"><input data-key="depth" value="{{form.depth}}" bindinput="input" type="digit"/><text>m</text></view></view><text class="muted hint">请核对尺寸口径。</text><view class="dimension-row"><text>建筑层数</text><view class="input"><input data-key="floors" value="{{form.floors}}" bindinput="input" type="number"/>层</view><text>入口朝向</text><picker range="{{orientationOptions}}" data-key="orientation" data-options="orientationOptions" bindchange="pick"><view class="input">{{form.orientation}}<image class="down" src="/assets/creation-down.png"/></view></picker></view></view>
     <view class="card"><view class="heading">家庭与房间需求</view><view class="chips"><button wx:for="{{requirements}}" wx:key="*this" class="chip" data-value="{{item}}" bindtap="requirement">{{item}} ×</button><button class="chip outline" bindtap="addRequirement">添加需求</button></view><view class="dimension-row"><text>院落布局</text><view class="input"><input data-key="courtyard" value="{{form.courtyard}}" bindinput="input"/></view><text>图纸类型</text><view class="input"><input data-key="drawingType" value="{{form.drawingType}}" bindinput="input"/></view></view></view>
     <view class="card"><view class="heading">补充要求</view><textarea class="textarea short" value="{{form.notes}}" data-key="notes" bindinput="input"/><button class="outline upload-small" data-key="sketchFile" bindtap="upload">上传草图（选填）</button></view>
     <view class="card settings-card"><view class="heading">生成设置</view><view class="settings-row"><text class="muted">清晰度</text><button wx:for="{{resolutionOptions}}" wx:key="*this" data-key="resolution" data-value="{{item}}" bindtap="select" class="option {{form.resolution===item?'selected':''}}">{{item}}</button><text class="muted">画幅</text><button wx:for="{{aspectOptions}}" wx:key="*this" data-key="aspect" data-value="{{item}}" bindtap="select" class="option {{form.aspect===item?'selected':''}}">{{item}}</button></view><view class="settings-row"><text class="muted">生成张数</text><button wx:for="{{countOptions}}" wx:key="*this" class="option {{form.count===item?'selected':''}}" data-key="count" data-value="{{item}}" bindtap="select">{{item}}</button></view><text class="muted hint">设计点将在提交前确认 · 仅供方案沟通，不作为施工图。</text></view><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">{{view==='ai-facade'?'生成立面方案':'生成平面方案'}}</button></view>
    </block>
    <block wx:else><view class="card ai-results"><view class="heading">生成结果<text class="success-text">已完成 {{candidateIndexes.length}}/{{candidateIndexes.length}}</text></view><button wx:for="{{planCandidates}}" wx:key="index" class="plan-choice {{selectedPlan===item.index?'chosen':''}}" data-index="{{item.index}}" bindtap="planSelect"><view class="plan-title"><text>方案{{item.index+1}}</text><view class="plan-select-state"><radio checked="{{selectedPlan===item.index}}" color="{{designFlow?'#81522e':'#a63f0b'}}"/><text class="copper">{{selectedPlan===item.index?'已选中':''}}</text></view></view><view class="plan-pair"><view wx:for="{{item.images}}" wx:key="index" wx:for-item="planImage" wx:for-index="level"><image src="{{planImage}}" mode="aspectFit"/><text>{{level+1}}层 · 模拟示意</text></view></view></button></view><view class="notice"><text class="row-title copper">选中后，保存为方案版本</text><text class="muted">仅供方案沟通，不作为施工图</text></view><view class="footer page-actions"><button class="outline btn" bindtap="secondary">重新生成</button><button class="btn primary-action" bindtap="submit">选用并保存</button></view></block>
   </block>
   <block wx:elif="{{view==='result'}}">
    <view class="card result-plan"><view class="tabs"><button wx:for="{{floorLabels}}" wx:key="*this" class="{{floor===index?'active':''}}" data-index="{{index}}" bindtap="floorTab">{{item}}</button></view><image class="result-image" src="{{currentPlan?currentPlan.images[floor]:(floor?'/pages/workflow/assets/biz-plan-2.jpg':'/pages/workflow/assets/biz-plan-result.jpg')}}" mode="widthFix" data-src="{{currentPlan?currentPlan.images[floor]:'/pages/workflow/assets/biz-plan-result.jpg'}}" bindtap="previewImage"/></view><view class="card"><view class="heading">方案信息</view><view class="stats"><view wx:for="{{[{label:'面宽',value:customer.width+'m'},{label:'进深',value:customer.depth+'m'},{label:'建筑层数',value:customer.floors+'层'}]}}" wx:key="label"><text class="muted">{{item.label}}</text><text class="stat-value">{{item.value}}</text></view></view><view class="chips"><text class="chip">三代同住</text><text class="chip">一层老人房</text></view></view><view class="notice copper">仅供方案沟通，不作为施工图。</view><view class="card muted">预算需核对建筑面积及建造参数。</view><view class="footer page-actions"><button class="outline btn" bindtap="secondary">保存到相册</button><button class="btn primary-action" bindtap="submit">报价测算</button></view>
   </block>
   <block wx:elif="{{view==='budget'}}">
