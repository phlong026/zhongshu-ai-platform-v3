<wxs src="../../utils/tone.wxs" module="st"/>
<import src="./budget-result.wxml"/>
<wxs src="./format.wxs" module="fmt"></wxs>
<view class="workflow {{designFlow?'design-flow':''}} view-{{view}} {{view==='customer'||view==='arrival'?'customer-workspace':''}} {{caseTab?'has-plan':''}} {{extended?'extended':''}}">
 <business-header id="workflow-header" title="{{title}}" design-flow="{{designFlow}}"/>
 <view wx:if="{{!customer&&view!=='customers'}}" class="body"><view class="card empty">{{error}}<view class="page-actions"><button class="btn workflow-nav" data-view="customers" bindtap="go">返回客户列表</button></view></view></view>
 <view wx:else class="body">
  <view wx:if="{{blocked}}" class="card empty"><text>{{blocked.message}}</text><view class="page-actions"><button class="btn workflow-nav" data-view="{{blocked.target}}" bindtap="go">{{blocked.label}}</button></view></view><block wx:else>
  <block wx:if="{{view==='customers'}}">
   <view class="search"><image src="/assets/search.png"/><input placeholder="搜索姓名、手机号" value="{{keyword}}" bindinput="searchCustomers"/></view>
   <view class="list-title"><text>{{selectingCustomer?'选择本次办理的客户':'我的客户'}}</text><button wx:if="{{canRegister}}" class="btn customer-register" data-modal="register" bindtap="modal">登记客户</button></view>
   <view class="tabs"><button wx:for="{{filters}}" wx:key="*this" class="{{filter===item?'active':''}}" data-value="{{item}}" bindtap="setFilter">{{item}}</button></view>
   <view wx:for="{{filteredCustomers}}" wx:key="id" class="card customer-list-row" data-id="{{item.id}}" bindtap="chooseCustomer"><view class="initial small">{{item.name[0]}}</view><view class="flex"><view class="name">{{item.name}} <text class="badge">{{item.status}}</text></view><text class="muted">{{item.phone || item.wechat}} · {{item.city}}</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></view>
   <view wx:if="{{!filteredCustomers.length}}" class="card empty">暂无符合条件的客户<button wx:if="{{canRegister}}" class="outline btn" data-modal="register" bindtap="modal">登记客户</button></view>
  </block>
  <block wx:else>
   <view wx:if="{{role}}" class="operation-identity">办理身份：{{role}}</view>
   <view wx:if="{{view!=='transfer'}}" class="card customer-banner {{large?'large':'compact'}} {{compactProject?'project-compact':''}} {{view==='result'||view==='facade-result'?'result-banner':''}}">
    <view class="banner-main"><view class="initial {{large?'':'small'}}">{{customerInitial}}</view><view class="banner-info"><view class="name"><text class="customer-name">{{customer.name}}</text><text wx:if="{{view==='budget'}}" class="budget-city">· {{city}}</text><text wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="badge {{st.tone(customer.status)}}">{{customer.status}}</text></view>
     <view wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="banner-line"><image src="/pages/workflow/assets/biz-phone.jpg"/>{{phone || customer.wechat}}</view>
     <view wx:if="{{view!=='budget'}}" class="banner-line">{{projectSummary}}</view>
     <text wx:if="{{view==='budget'||view==='budget-result'}}" class="muted">{{currentPlan?'平面方案 v'+currentPlan.version:currentFacade?'立面方案 v'+currentFacade.version:'未关联方案'}}</text>
    </view><text wx:if="{{badge}}" class="badge banner-badge {{st.tone(badge)}}">{{badge}}</text></view>
    <block wx:if="{{view==='result'||view==='facade-result'}}"><view class="result-name">{{view==='result'?'平面':'立面'}}方案 V{{view==='result'?(currentPlan?currentPlan.version:1):(currentFacade?currentFacade.version:1)}} <text class="badge green">已选用</text></view><text class="muted">方案版本已保存</text></block>
    <view wx:if="{{headerItems}}" class="soft"><view wx:for="{{headerItems}}" wx:key="label" class="kv"><text class="label">{{item.label}}</text><text>{{item.value}}</text></view></view>
   </view>
   <view wx:if="{{taskSummary}}" class="card task-summary"><view><text class="task-label">当前事项</text><text class="task-state">{{taskSummary.state}}</text></view><text class="muted">当前责任：{{taskSummary.owner}}</text></view>
   <view wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="tabs customer-tabs"><button wx:for="{{['概况','跟进','项目进度']}}" wx:key="*this" class="{{activeCustomerTab===index?'active':''}}" data-index="{{index}}" bindtap="customerTab">{{item}}</button></view>

   <block wx:if="{{view==='customer'||view==='arrival'}}">
    <view class="card"><view class="heading"><text>客户资料</text><button wx:if="{{canEditCustomer}}" class="link" data-modal="edit" bindtap="modal">编辑 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="soft"><view class="kv"><text class="label">来源</text><text>{{customer.source}}</text><text class="label owner">负责人</text><text>{{customer.owner||'我'}}</text></view><block wx:if="{{customer.status==='已到店'}}"><text class="muted">确认建房需求</text><view class="kv"><text class="label">建筑外轮廓</text><text>面宽 {{customer.width}}米 × 进深 {{customer.depth}}米</text></view><view class="kv"><text class="label">计划层数</text><text>{{customer.floors}}层</text></view></block><view class="kv summary"><text class="label">{{customer.status==='已到店'?'需求摘要':'需求'}}</text><text class="flex">{{customer.summary}}</text></view></view></view>
    <view wx:if="{{activeCustomerTab===1}}" class="card follow-card"><view class="heading"><text>沟通记录</text></view><view wx:if="{{!customer.follows.length}}" class="follow-empty"><image src="/pages/workflow/assets/biz-empty-follow.jpg"/><text class="empty-title">暂无跟进记录</text><text class="muted">记录首次沟通，完善客户需求。</text></view><view wx:for="{{customer.follows}}" wx:key="index" class="soft follow-record"><image src="/pages/workflow/assets/biz-record.jpg"/><view class="flex"><text class="row-title">{{item.method?(item.method==='到店'?'到店沟通已完成':item.method+'沟通'):'咨询登记'}} <text class="badge">{{item.result}}</text></text><text class="muted">{{item.date}} {{item.appointment}}</text><text class="muted">{{item.content||item.note}}</text></view></view></view>
    <view wx:if="{{simpleBusiness&&activeCustomerTab===1}}" class="card"><view class="heading">业务办理</view><view class="tool-grid"><button class="workflow-nav" data-view="search" bindtap="go"><image src="/pages/workflow/assets/biz-house.jpg"/><text>检索户型</text></button><button class="workflow-nav" data-view="ai-config" bindtap="go"><image src="/pages/workflow/assets/biz-document.jpg"/><text>AI设计</text></button><button class="workflow-nav" data-view="budget" bindtap="go"><image src="/pages/workflow/assets/biz-calculator.jpg"/><text>快速预算</text></button><button class="workflow-nav" data-view="request" bindtap="go"><image src="/pages/workflow/assets/biz-money.jpg"/><text>委托设计</text></button></view></view>
    <view wx:if="{{canFollow}}" class="page-actions customer-follow-actions"><button class="btn bottom-inline" data-modal="follow" bindtap="modal">{{customer.follows.length?'记录跟进':'记录首次跟进'}}</button></view><view wx:elif="{{hasDesign}}" class="page-actions customer-follow-actions"><button class="btn bottom-inline workflow-nav" data-view="delivery" bindtap="go">继续项目办理</button></view>
   </block>
   <block wx:elif="{{view==='progress'}}">
    <view class="card"><view class="heading">当前阶段</view><view class="flow-steps journey-steps"><view wx:for="{{stages}}" wx:key="*this" class="flow-step {{stageIndex>index?'done':index===stageIndex?'current':''}}"><text class="flow-step-index">{{stageIndex>index?'✓':index+1}}</text><text>{{item}}</text></view></view><view class="soft progress-now"><text class="row-title">{{progressInfo.title}}</text><text wx:if="{{progressInfo.owner||progressInfo.next}}" class="muted">{{progressInfo.owner?'负责人：'+progressInfo.owner:''}}{{progressInfo.owner&&progressInfo.next?' · ':''}}{{progressInfo.next?'下一步：'+progressInfo.next:''}}</text></view></view>
    <view wx:if="{{progressInfo.latest}}" class="card"><view class="heading"><text>最新进展</text><button class="link" data-index="1" bindtap="customerTab">全部记录 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="soft follow-record"><image src="{{progressInfo.latest.image||'/pages/workflow/assets/biz-record.jpg'}}" mode="aspectFill"/><view class="flex"><text class="row-title">{{progressInfo.latest.text}}</text><text class="muted">{{progressInfo.latest.date}}{{progressInfo.latest.by?' · '+progressInfo.latest.by:''}}</text></view></view></view>
    <view class="card"><view class="heading">方案与资料</view><button class="soft archive-row workflow-nav" data-view="result" bindtap="go"><image class="thumb" src="/pages/workflow/assets/biz-formal-plan.jpg"/><view class="flex"><text class="row-title">平面方案 v{{currentPlan?currentPlan.version:1}} <text class="badge neutral">{{currentPlan?'已归档':'未保存'}}</text></text><text class="muted">{{customer.width}}m × {{customer.depth}}m · {{customer.floors}}层</text></view><text class="link">查看方案</text><image class="arrow" src="/assets/creation-chevron.png"/></button><button class="soft archive-row workflow-nav" data-view="budget-result" bindtap="go"><image class="round-icon" src="/pages/workflow/assets/biz-calculator.jpg"/><view class="flex"><text class="row-title">参考预算 版本{{currentBudget?currentBudget.version:1}}</text><text class="amount">{{currentBudget?'¥ '+fmt.money(currentBudget.total):'暂无预算'}}</text><text class="muted">关联平面方案 v{{currentPlan?currentPlan.version:1}}</text></view><text class="link">查看预算</text><image class="arrow" src="/assets/creation-chevron.png"/></button><button wx:if="{{hasDesign}}" class="soft archive-row workflow-nav" data-view="delivery" bindtap="go"><image class="round-icon" src="/pages/workflow/assets/biz-money.jpg"/><view class="flex"><text class="row-title">委托与交付记录</text><text class="muted">{{coordination.state}}</text></view><text class="link">查看</text><image class="arrow" src="/assets/creation-chevron.png"/></button></view>
    
   </block>
   <block wx:elif="{{view==='inspiration'||view==='search'}}">
    <view wx:if="{{view==='inspiration'}}" class="search"><image src="/assets/search.png"/><input placeholder="输入案例编号或名称" bindinput="searchCases"/></view>
    <view class="card dimension-card"><view class="dimension-row"><text>面宽</text><view class="input"><input data-key="width" value="{{form.width}}" bindinput="input" type="digit"/><text>m</text></view><text>进深</text><view class="input"><input data-key="depth" value="{{form.depth}}" bindinput="input" type="digit"/><text>m</text></view></view><text class="muted hint">{{view==='search'?'按建筑外轮廓检索':'建筑尺寸3–40m，支持一位小数'}}</text><view wx:if="{{view==='inspiration'}}" class="dimension-row style-row"><text>风格</text><picker range="{{styleOptions}}" data-key="filterStyle" data-options="styleOptions" bindchange="pick"><view class="input">{{form.filterStyle||'全部风格'}}<image class="down" src="/assets/creation-down.png"/></view></picker><text>层数</text><picker range="{{floorOptions}}" data-key="floorFilter" data-options="floorOptions" bindchange="pick"><view class="input">{{form.floorFilter||'全部层数'}}<image class="down" src="/assets/creation-down.png"/></view></picker></view></view>
    <block wx:if="{{view==='search'}}"><button class="btn search-btn" bindtap="applySearch">检索平面方案</button><text class="muted hint outside">匹配范围±1m，最多50套，按尺寸差排序。</text></block>
    <view class="heading outside"><text>{{view==='search'?'匹配结果':'案例推荐'}}</text><text wx:if="{{view==='search'}}" class="muted">{{filteredCases.length}}套</text></view><view class="case-grid"><button wx:for="{{filteredCases}}" wx:key="id" class="case-card" data-id="{{item.id}}" bindtap="openCase"><image class="case-photo" src="{{item.image}}" mode="aspectFill"/><view class="case-copy"><text class="row-title">{{item.name}}</text><text class="muted">{{view==='search'?item.id:'编号 '+item.id+'　|　'+item.area+'㎡ · '+item.floors+'层'}}</text><text wx:if="{{view==='search'}}" class="muted">面宽 {{item.width}}m · 进深 {{item.depth}}m</text></view></button></view><view wx:if="{{!filteredCases.length}}" class="card empty">没有匹配方案，请调整尺寸或检索条件。</view>
   </block>
   <block wx:elif="{{view==='case'||view==='case-plan'}}">
    <view class="card case-detail {{caseTab?'plan-visible':''}}"><image class="hero" src="{{selectedCase.id==='ZS001'?(caseTab?'/pages/workflow/assets/biz-case-plan-hero.jpg':'/pages/workflow/assets/biz-case-hero.jpg'):selectedCase.image}}" mode="aspectFill" data-src="{{selectedCase.image}}" bindtap="previewImage"/><view class="case-detail-copy"><view class="case-name"><text>{{selectedCase.name}}</text><button class="link" bindtap="favorite"><image src="/pages/workflow/assets/biz-heart.jpg"/>{{favorite?'已收藏':'收藏'}}</button></view><text class="muted">编号 {{selectedCase.id}} · V1 · 方案灵感</text><view class="stats"><view wx:for="{{[{label:'建筑面积',value:selectedCase.area+'㎡'},{label:'层数',value:selectedCase.floors+'层'},{label:'面宽',value:selectedCase.width+'m'},{label:'进深',value:selectedCase.depth+'m'}]}}" wx:key="label"><text class="muted">{{item.label}}</text><text class="stat-value copper">{{item.value}}</text></view></view></view></view><view class="tabs line-tabs"><button wx:for="{{caseTabs}}" wx:key="*this" data-index="{{index}}" bindtap="caseTab" class="{{caseTab===index?'active':''}}">{{item}}</button></view><image class="case-plan-picture" wx:if="{{caseTab&&!casePlanUnavailable}}" src="{{selectedCase.floorPlans[caseTab-1].image}}" mode="widthFix"/><view wx:elif="{{casePlanUnavailable}}" class="card empty">该案例尚未提供平面资料，请选择已有平面图的案例。<button class="outline btn workflow-nav" data-view="inspiration" bindtap="go">返回方案参考</button></view><image wx:else class="case-second" src="{{selectedCase.id==='ZS001'?(caseTab?'/pages/workflow/assets/biz-case-plan-hero.jpg':'/pages/workflow/assets/biz-case-hero.jpg'):selectedCase.image}}" mode="aspectFill"/><text class="muted centered">{{caseTab?'方案示意，非施工图。用整套案例作为设计参考。':'案例图片仅供方案参考'}}</text>
    <view class="footer page-actions"><button wx:if="{{!caseTab}}" class="outline btn workflow-nav" data-view="ai-facade" bindtap="go">AI立面设计</button><button class="btn workflow-nav" data-view="{{caseTab?'ai-config':'search'}}" bindtap="go">{{caseTab?'平面方案':'户型检索'}}</button></view>
   </block>
   <block wx:elif="{{view==='ai-config'||view==='ai-facade'||view==='ai-results'}}">
    <view class="tabs"><button class="{{view!=='ai-facade'?'active':''}} workflow-nav" data-view="ai-config" bindtap="go">平面方案</button><button class="{{view==='ai-facade'?'active':''}} workflow-nav" data-view="ai-facade" bindtap="go">立面方案</button></view>
    <view class="card reference-row"><image src="{{referenceImage}}" mode="aspectFit"/><image wx:if="{{view==='ai-config'}}" src="/pages/workflow/assets/biz-plan-2.jpg" mode="aspectFit"/><view class="flex"><text class="row-title">{{view==='ai-results'?'参考方案':'已选参考'}} · {{referenceCase?referenceCase.name:'当前客户方案'}} <text class="badge">{{referenceCase?'V1':'示意'}}</text></text><text class="muted">{{form.floors}}层 · 面宽{{form.width}}m · 进深{{form.depth}}m</text><button class="soft-link workflow-nav" data-view="{{view==='ai-results'?'ai-config':'inspiration'}}" bindtap="go">{{view==='ai-results'?'调整参数':'更换参考'}} <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view>
    <block wx:if="{{view!=='ai-results'}}">
     <view class="card"><view class="heading">尺寸与需求</view><view class="dimension-row"><text>面宽</text><view class="input"><input data-key="width" value="{{form.width}}" bindinput="input" type="digit"/><text>m</text></view><text>进深</text><view class="input"><input data-key="depth" value="{{form.depth}}" bindinput="input" type="digit"/><text>m</text></view></view><text class="muted hint">请核对尺寸口径。</text><view class="dimension-row"><text>建筑层数</text><view class="input"><input data-key="floors" value="{{form.floors}}" bindinput="input" type="number"/>层</view><text>入口朝向</text><picker range="{{orientationOptions}}" data-key="orientation" data-options="orientationOptions" bindchange="pick"><view class="input">{{form.orientation}}<image class="down" src="/assets/creation-down.png"/></view></picker></view></view>
     <view class="card"><view class="heading">家庭与房间需求</view><view class="chips"><button wx:for="{{requirements}}" wx:key="*this" class="chip" data-value="{{item}}" bindtap="requirement">{{item}} ×</button><button class="chip outline" bindtap="addRequirement">添加需求</button></view><view class="dimension-row"><text>院落布局</text><view class="input"><input data-key="courtyard" value="{{form.courtyard}}" bindinput="input"/></view><text>图纸类型</text><view class="input"><input data-key="drawingType" value="{{form.drawingType}}" bindinput="input"/></view></view></view>
     <view class="card"><view class="heading">补充要求</view><textarea class="textarea short" value="{{form.notes}}" data-key="notes" bindinput="input"/><button class="outline upload-small" data-key="sketchFile" bindtap="upload">上传草图（选填）</button></view>
     <view class="card settings-card"><view class="heading">生成设置</view><view class="settings-row"><text class="muted">清晰度</text><button wx:for="{{resolutionOptions}}" wx:key="*this" data-key="resolution" data-value="{{item}}" bindtap="select" class="option {{form.resolution===item?'selected':''}}">{{item}}</button><text class="muted">画幅</text><button wx:for="{{aspectOptions}}" wx:key="*this" data-key="aspect" data-value="{{item}}" bindtap="select" class="option {{form.aspect===item?'selected':''}}">{{item}}</button></view><view class="settings-row"><text class="muted">生成张数</text><button wx:for="{{countOptions}}" wx:key="*this" class="option {{form.count===item?'selected':''}}" data-key="count" data-value="{{item}}" bindtap="select">{{item}}</button></view><text class="muted hint">设计点将在提交前确认 · 仅供方案沟通，不作为施工图。</text></view><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">{{view==='ai-facade'?'生成立面方案':'生成平面方案'}}</button></view>
    </block>
    <block wx:else><view class="card ai-results"><view class="heading">生成结果<text class="success-text">已完成 {{candidateIndexes.length}}/{{candidateIndexes.length}}</text></view><button wx:for="{{planCandidates}}" wx:key="index" class="plan-choice {{selectedPlan===item.index?'chosen':''}}" data-index="{{item.index}}" bindtap="planSelect"><view class="plan-title"><text>方案{{item.index+1}}</text><view class="plan-select-state"><radio checked="{{selectedPlan===item.index}}" color="{{designFlow?'#81522e':'#a63f0b'}}"/><text class="copper">{{selectedPlan===item.index?'已选中':''}}</text></view></view><view class="plan-pair"><view wx:for="{{item.images}}" wx:key="index" wx:for-item="planImage" wx:for-index="level"><image src="{{planImage}}" mode="aspectFit"/><text>{{level+1}}层 · 方案示意</text></view></view></button></view><view class="notice"><text class="row-title copper">选中后，保存为方案版本</text><text class="muted">仅供方案沟通，不作为施工图</text></view><view class="footer page-actions"><button class="outline btn" bindtap="secondary">重新生成</button><button class="btn primary-action" bindtap="submit">选用并保存</button></view></block>
   </block>
   <block wx:elif="{{view==='result'}}">
    <view class="card result-plan"><view class="tabs"><button wx:for="{{floorLabels}}" wx:key="*this" class="{{floor===index?'active':''}}" data-index="{{index}}" bindtap="floorTab">{{item}}</button></view><image class="result-image" src="{{currentPlan?currentPlan.images[floor]:(floor?'/pages/workflow/assets/biz-plan-2.jpg':'/pages/workflow/assets/biz-plan-result.jpg')}}" mode="widthFix" data-src="{{currentPlan?currentPlan.images[floor]:'/pages/workflow/assets/biz-plan-result.jpg'}}" bindtap="previewImage"/></view><view class="card"><view class="heading">方案信息</view><view class="stats"><view wx:for="{{[{label:'面宽',value:customer.width+'m'},{label:'进深',value:customer.depth+'m'},{label:'建筑层数',value:customer.floors+'层'}]}}" wx:key="label"><text class="muted">{{item.label}}</text><text class="stat-value">{{item.value}}</text></view></view><view class="chips"><text class="chip">三代同住</text><text class="chip">一层老人房</text></view></view><view class="notice copper">仅供方案沟通，不作为施工图。</view><view class="card muted">预算需核对建筑面积及建造参数。</view><view class="footer page-actions"><button class="outline btn" bindtap="secondary">保存到相册</button><button class="btn primary-action" bindtap="submit">报价测算</button></view>
   </block>
   <block wx:elif="{{view==='budget'}}">
    <view class="tabs"><button class="active">参数</button><button class="workflow-nav" data-view="budget-result" bindtap="go">结果</button></view><view class="card"><view class="heading">建筑信息</view><view class="soft"><view class="kv"><text>地区</text><text class="right">湖北 · {{city}}</text></view><view class="stats"><view wx:for="{{[{label:'建筑面宽',value:form.width+'m'},{label:'建筑进深',value:form.depth+'m'},{label:'层数',value:form.floors+'层'}]}}" wx:key="label"><text class="muted">{{item.label}}</text><text class="stat-value">{{item.value}}</text></view></view><view class="input-row"><text>建筑占地</text><view class="input"><input type="digit" data-key="footprint" value="{{form.footprint}}" bindinput="input"/><text>㎡</text></view></view><view class="input-row"><text>建筑面积</text><view class="input"><input type="digit" data-key="area" value="{{form.area}}" bindinput="input"/><text>㎡</text></view></view><text class="muted hint">按实际建筑面积核对，不含庭院。</text></view></view><view class="card"><view class="heading">主体配置</view><picker wx:for="{{[{label:'基础',key:'foundation',options:'foundationOptions',icon:'foundation'},{label:'结构',key:'structure',options:'structureOptions',icon:'structure'},{label:'屋顶',key:'roof',options:'roofOptions',icon:'roof'}]}}" wx:key="key" range="{{item.key==='foundation'?foundationOptions:(item.key==='structure'?structureOptions:roofOptions)}}" data-key="{{item.key}}" data-options="{{item.options}}" bindchange="pick"><view class="row outlined"><image class="round-icon" src="/pages/workflow/assets/biz-{{item.icon}}.jpg"/><text>{{item.label}}</text><text class="right">{{form[item.key]}}</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></view></picker><view class="soft"><view class="input-row"><text>屋顶面积</text><view class="input"><input type="digit" data-key="roofArea" value="{{form.roofArea}}" bindinput="input"/>㎡</view></view><button class="link" data-key="budgetChecked" bindtap="toggle">{{form.budgetChecked?'已人工核定。':'请人工核定屋顶面积'}}</button></view></view><view class="card"><view class="heading">外装配置<button class="link" data-modal="exterior" bindtap="modal">配置 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="tool-grid three"><button wx:for="{{[{name:'门窗',icon:'window'},{name:'墙漆',icon:'paint'},{name:'文化石',icon:'stone'},{name:'灯光',icon:'light'},{name:'防水',icon:'waterproof'},{name:'防雷',icon:'lightning'},{name:'保险',icon:'insurance'}]}}" wx:key="name" data-modal="exterior" bindtap="modal"><image src="/pages/workflow/assets/biz-{{item.icon}}.jpg"/>{{item.name}}<image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view></view><text class="muted hint">按参数测算，仅供前期参考。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">开始测算</button></view>
   </block>
   <block wx:elif="{{view==='budget-result'}}"><template is="budget-result" data="{{budget:budgetPresentation,linked:true,customerName:customer.name,continueHandler:'continueBudget',adjustHandler:'secondary',continueLabel:hasDesign?'继续项目办理':'发起设计委托',canChoose:false}}"/></block>
   <block wx:elif="{{view==='transfer'}}">
    <text class="muted role-note">当前身份：{{role}}</text>
    <view class="tabs"><button wx:for="{{['单条转交','批量转交']}}" wx:key="*this" class="{{transferMode===index?'active':''}}" data-index="{{index}}" bindtap="transferMode">{{item}}</button></view>
    <block wx:if="{{transferMode===1}}">
     <view class="card"><view class="heading">选择转交客户</view><button wx:for="{{filteredCustomers}}" wx:key="id" class="check-row" data-id="{{item.id}}" bindtap="toggleCustomer"><checkbox checked="{{selectedFlags[item.id]}}" color="{{designFlow?'#81522e':'#a64210'}}"/><text>{{item.name}} · {{item.owner||'我'}}</text></button></view>
     <view class="card"><view class="heading">当前负责人</view><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{customer.owner||'我'}} · <text class="muted">业务员</text></text></view></view><view class="card"><view class="heading">新负责人</view><picker range="{{ownerOptions}}" data-key="newOwner" data-options="ownerOptions" bindchange="pick"><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{form.newOwner}} · <text class="muted">业务员</text></text><image class="down" src="/assets/creation-down.png"/></view></picker></view>
     <view class="card"><view class="heading">转交原因</view><textarea class="textarea" data-key="transferReason" value="{{form.transferReason}}" bindinput="input" maxlength="200"/></view>
     <view class="card tinted preserve"><view class="heading">一并保留</view><view wx:for="{{['原始来源与历史作者','合同、款项与设计成果','未完成跟进事项']}}" wx:key="*this" class="condition"><image src="/pages/workflow/assets/biz-success.jpg"/>{{item}}</view></view><text class="muted hint">确认后新负责人立即生效，无需接收审批。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">确认转交</button></view>
    </block>
    <block wx:else>
     <view class="card transfer-customer"><view class="heading">客户信息</view><view class="banner-main"><view class="initial">{{customerInitial}}</view><view class="banner-info"><view class="name"><text class="customer-name">{{customer.name}}</text> </view><view class="banner-line"><image src="/pages/workflow/assets/biz-phone.jpg"/>{{phone}}</view><view class="banner-line"><image src="/pages/workflow/assets/biz-location.jpg"/>{{projectSummary}}</view></view></view></view>
     <view class="card"><view class="heading">当前负责人</view><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{customer.owner||'我'}} · <text class="muted">业务员</text></text></view></view><view class="card"><view class="heading">新负责人</view><picker range="{{ownerOptions}}" data-key="newOwner" data-options="ownerOptions" bindchange="pick"><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{form.newOwner}} · <text class="muted">业务员</text></text><image class="down" src="/assets/creation-down.png"/></view></picker></view>
     <view class="card"><view class="heading">转交原因</view><textarea class="textarea" data-key="transferReason" value="{{form.transferReason}}" bindinput="input" maxlength="200"/></view>
     <view class="card tinted preserve"><view class="heading">一并保留</view><view wx:for="{{['原始来源与历史作者','合同、款项与设计成果','未完成跟进事项']}}" wx:key="*this" class="condition"><image src="/pages/workflow/assets/biz-success.jpg"/>{{item}}</view></view><text class="muted hint">确认后新负责人立即生效，无需接收审批。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">确认转交</button></view>
    </block>
   </block>
   <block wx:elif="{{view==='facade-config'||view==='facade-candidates'}}">
    <view class="tabs"><button class="workflow-nav" data-view="ai-config" bindtap="go">平面方案</button><button class="active">立面方案</button></view>
    <block wx:if="{{view==='facade-config'}}"><view class="card"><view class="heading">参考图片（选填）</view><view class="facade-references"><image src="/pages/workflow/assets/biz-facade-reference.jpg" mode="aspectFill"/><button wx:for="{{[1,2]}}" wx:key="*this" data-key="facadeReference" bindtap="upload"><image src="/pages/workflow/assets/biz-add.jpg"/>上传图片</button></view><view class="reference-hint"><text class="muted">可上传0–3张参考图。</text><button class="link workflow-nav" data-view="inspiration" bindtap="go">从灵感库选择 <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view><view class="card"><view class="heading">立面需求</view><view class="dimension-row"><text>建筑风格</text><picker class="flex" range="{{facadeStyleOptions}}" data-key="style" data-options="facadeStyleOptions" bindchange="pick"><view class="input">{{form.style}}<image class="down" src="/assets/creation-down.png"/></view></picker><text>建筑层数</text><view class="input"><input data-key="floors" value="{{form.floors}}" bindinput="input"/>层</view></view><view class="input-row"><text class="label">主色调</text><view class="input"><input data-key="palette" value="{{form.palette}}" bindinput="input"/></view></view></view><view class="card"><view class="heading">补充要求</view><textarea class="textarea short" data-key="facadeNotes" value="{{form.facadeNotes}}" bindinput="input"/></view><view class="card settings-card"><view class="heading">生成设置</view><view class="settings-row"><text class="muted">清晰度</text><button wx:for="{{resolutionOptions}}" wx:key="*this" class="option {{form.resolution===item?'selected':''}}" data-key="resolution" data-value="{{item}}" bindtap="select">{{item}}</button><text class="muted">画幅</text><button wx:for="{{aspectOptions}}" wx:key="*this" class="option {{form.aspect===item?'selected':''}}" data-key="aspect" data-value="{{item}}" bindtap="select">{{item}}</button></view><view class="settings-row"><text class="muted">生成张数</text><button wx:for="{{countOptions}}" wx:key="*this" class="option {{form.count===item?'selected':''}}" data-key="count" data-value="{{item}}" bindtap="select">{{item}}</button></view></view><view class="card"><view class="input-row"><text class="label">项目建筑面积</text><view class="input"><input data-key="facadeArea" value="{{form.facadeArea}}" bindinput="input" type="digit"/>㎡（待核定）</view></view><text class="muted hint">尺寸与面积以核定信息为准。</text></view><text class="muted hint">设计点将在提交前确认 · 仅供方案沟通，不作为施工图。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">生成立面方案</button></view></block>
    <block wx:else><view class="card reference-row"><image src="/pages/workflow/assets/biz-facade-1.jpg" mode="aspectFill"/><view class="flex"><text class="row-title">立面方案 · {{form.style}}</text><text class="muted">{{form.floors}}层 · {{form.palette}} · {{form.resolution}} · {{candidateIndexes.length}}张</text><button class="soft-link workflow-nav" data-view="facade-config" bindtap="go">调整参数 <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view><view class="card ai-results facade-candidates"><view class="heading">生成结果<text class="success-text">已完成 {{candidateIndexes.length}}/{{candidateIndexes.length}}</text></view><button wx:for="{{candidateIndexes}}" wx:key="*this" class="plan-choice {{selectedPlan===item?'chosen':''}}" data-index="{{item}}" bindtap="planSelect"><view class="plan-title"><text>方案{{item+1}}</text><view class="plan-select-state"><radio checked="{{selectedPlan===item}}" color="{{designFlow?'#81522e':'#a63f0b'}}"/><text class="copper">{{selectedPlan===item?'已选中':''}}</text></view></view><image src="/pages/workflow/assets/biz-facade-{{item%2+1}}.jpg" class="facade-candidate-image" mode="aspectFill"/></button></view><view class="notice"><text class="row-title copper">选中后，保存为方案版本</text><text class="muted">仅供方案沟通，不作为施工图</text></view><view class="footer page-actions"><button class="outline btn workflow-nav" data-view="facade-config" bindtap="go">重新生成</button><button class="btn primary-action" bindtap="submit">选用并保存</button></view></block>
   </block>
   <block wx:elif="{{view==='facade-result'}}"><view class="card"><view class="heading">正面效果</view><image class="facade-result-image" src="{{currentFacade?currentFacade.image:'/pages/workflow/assets/biz-facade-result.jpg'}}" mode="widthFix" data-src="{{currentFacade?currentFacade.image:'/pages/workflow/assets/biz-facade-result.jpg'}}" bindtap="previewImage"/></view><view class="card"><view class="heading">方案信息</view><view class="metric-inputs"><view wx:for="{{[{label:'建筑风格',value:currentFacade?currentFacade.style:'新中式'},{label:'建筑层数',value:(currentFacade?currentFacade.floors:customer.floors)+'层'},{label:'主色调',value:currentFacade?currentFacade.palette:'米白 + 深灰'},{label:'项目建筑面积',value:(currentFacade?currentFacade.area:form.facadeArea)+'㎡（待核定）'}]}}" wx:key="label" class="metric-input"><text class="muted">{{item.label}}</text><text class="stat-value block-text">{{item.value}}</text></view></view></view><view class="notice copper">仅供方案沟通，不作为施工图。</view><view class="card muted">预算需核对建筑面积及建造参数。</view><view class="footer page-actions"><button class="outline btn" bindtap="saveAlbum">保存到相册</button><button class="btn primary-action" bindtap="submit">报价测算</button></view></block>
   <block wx:else>
    <view wx:for="{{sections}}" wx:key="index" wx:for-item="section" class="card section-{{index}} {{section.tint?'tinted':''}}">
     <view wx:if="{{section.title}}" class="heading"><text>{{section.title}}</text><text wx:if="{{section.meta}}" class="muted meta">{{section.meta}}</text><text wx:if="{{section.badge}}" class="badge {{section.badgeGreen?'green':''}}">{{section.badge}}</text></view>
     <block wx:for="{{section.items}}" wx:key="index" wx:for-item="item">
      <view wx:if="{{item.type==='kv'}}" class="kv soft-kv"><text class="label">{{item.label}}</text><text class="flex">{{item.value}}</text></view>
      <text wx:elif="{{item.type==='text'}}" class="block-text {{item.style}}">{{item.value}}</text>
      <view wx:elif="{{item.type==='file'}}" class="file-row" data-key="{{item.key}}" data-name="{{item.name}}" data-file="{{item.file}}" bindtap="previewFile"><image src="{{item.icon==='image'?'/assets/studio-image.png':item.file.text?'/pages/workflow/assets/biz-document.jpg':'/pages/workflow/assets/biz-pdf.jpg'}}"/><view class="flex"><text class="file-name">{{item.file?item.file.name:(item.key&&form[item.key]?fileNames[item.key]:item.name)}}</text></view><text wx:if="{{item.badge}}" class="badge green">{{item.badge}}</text><text wx:else class="muted file-action">预览</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></view>
      <view wx:elif="{{item.type==='input'}}" class="input-row {{item.long?'stacked':''}}"><text class="label">{{item.label}}</text><picker wx:if="{{item.kind==='date'||item.key==='paymentDate'||item.key==='measurementDate'||item.key==='signedDate'||item.key==='receiveDate'||item.key==='confirmationDate'||item.key==='receiptDate'}}" class="flex" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="date"><view class="input">{{form[item.key]||item.placeholder}}<image class="date-icon" src="/assets/calendar.png"/></view></picker><picker wx:elif="{{item.key==='manager'}}" class="flex" range="{{managerOptions}}" data-key="{{item.key}}" data-options="managerOptions" bindchange="pick"><view class="input">{{form[item.key]||item.placeholder}}<image class="arrow" src="/assets/creation-chevron-muted.png"/></view></picker><view wx:else class="input flex"><input class="business-input" data-key="{{item.key}}" value="{{form[item.key]}}" placeholder="{{item.placeholder}}" bindinput="input" type="{{item.inputType||((item.key==='amount'||item.key==='receiptAmount')?'digit':'text')}}"/><text wx:if="{{item.unit}}" class="muted">{{item.unit}}</text></view></view>
      <view wx:elif="{{item.type==='choice'}}"><text class="field-label">{{item.label}}</text><view class="options"><button wx:for="{{item.values}}" wx:key="*this" wx:for-item="value" class="option {{form[item.key]===value?'selected':''}}" data-key="{{item.key}}" data-value="{{value}}" bindtap="select">{{value}}</button></view></view>
      <view wx:elif="{{item.type==='textarea'}}" class="textarea-field"><text wx:if="{{item.label}}" class="field-label">{{item.label}}</text><textarea class="textarea" placeholder="{{item.placeholder}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="2000"/></view>
      <view wx:elif="{{item.type==='upload'}}" class="upload-row"><button class="upload" data-key="{{item.key}}" bindtap="upload"><image src="/pages/workflow/assets/biz-add.jpg"/><text>{{form[item.key]?fileNames[item.key]:item.label}}</text><text class="muted">{{form[item.key]?'点击更换':'支持 PDF、图片'}}</text></button></view>
      <button wx:elif="{{item.type==='check'}}" class="check-row" aria-checked="{{form[item.key]}}" data-key="{{item.key}}" bindtap="toggle"><image class="checkbox-image" src="/pages/workflow/assets/biz-checkbox-{{form[item.key]?'checked':'empty'}}.jpg"/><text>{{item.label}}</text></button>
      <view wx:elif="{{item.type==='notice'}}" class="notice"><image src="/pages/workflow/assets/biz-info.jpg"/><text>{{item.value}}</text></view>
      <view wx:elif="{{item.type==='stats'}}" class="stats soft"><view wx:for="{{item.values}}" wx:key="label" wx:for-item="stat"><text class="muted">{{stat.label}}</text><text class="stat-value">{{stat.value}}</text></view></view>
      <view wx:elif="{{item.type==='links'}}" class="links"><button class="workflow-nav" wx:for="{{item.values}}" wx:key="title" wx:for-item="link" data-view="{{link.view}}" data-action="{{link.action}}" data-record="{{link.record}}" data-url="{{link.url}}" bindtap="{{link.url?'navTap':(link.view?'go':'action')}}">{{link.title}}<image class="arrow" src="/assets/creation-chevron.png"/></button></view>
     </block>
    </view>
    <view wx:if="{{primary}}" class="footer page-actions"><button wx:if="{{secondary}}" class="outline btn" bindtap="secondary">{{secondary}}</button><button class="btn primary-action" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{primary}}</button></view>
   </block>
  </block>
  </block><text wx:if="{{error}}" class="error" role="alert">{{error}}</text>
 </view>
</view>
 <view wx:if="{{modal}}" class="overlay business-surface {{designFlow?'design-flow':''}}" catchtap="closeModal"><view class="sheet sheet-{{modal}}" catchtap="noop"><view class="sheet-head"><text>{{modal==='register'?'登记客户':modal==='edit'?'编辑客户':modal==='follow'?(customer.follows.length?'记录跟进':'记录首次跟进'):modal==='assign'?'安排设计师':modal==='return'?'退回补充':modal==='receipt'?'新增收款':modal==='generate'?'预览方案':'外装配置'}}</text><button class="close" bindtap="closeModal" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view>
 <block wx:if="{{modal==='register'||modal==='edit'}}"><view wx:for="{{[{label:'客户称呼',key:'name',placeholder:'请输入客户称呼'},{label:'手机号',key:'phone',placeholder:'请输入手机号'},{label:'微信号（选填）',key:'wechat',placeholder:'请输入微信号'}]}}" wx:key="key" class="input-row"><text class="label">{{item.label}}</text><view class="input flex"><input class="business-input" data-key="{{item.key}}" value="{{form[item.key]}}" placeholder="{{item.placeholder}}" bindinput="input"/></view></view><text class="muted contact-hint">手机号或微信号至少填写一项</text><view class="input-row"><text class="label">来源</text><picker class="flex" range="{{sourceOptions}}" data-key="source" data-options="sourceOptions" bindchange="pick"><view class="input">{{form.source}}<image class="down" src="/assets/creation-down.png"/></view></picker></view><view class="input-row"><text class="label">建房地区</text><picker class="flex" range="{{provinceOptions}}" data-key="province" data-options="provinceOptions" bindchange="pick"><view class="input">{{form.province}}<image class="down" src="/assets/creation-down.png"/></view></picker><picker class="flex" range="{{cityOptions}}" data-key="city" data-options="cityOptions" bindchange="pick"><view class="input">{{form.city}}<image class="down" src="/assets/creation-down.png"/></view></picker></view><text class="field-label">需求摘要</text><textarea class="textarea" data-key="summary" value="{{form.summary}}" bindinput="input"/><text class="muted owner-note">负责人：我</text></block>
 <block wx:elif="{{modal==='follow'}}"><view class="mini-customer"><view class="initial mini">{{customerInitial}}</view><text>{{customer.name}} · {{projectSummary}}</text></view><text class="field-label">沟通方式</text><view class="options"><button wx:for="{{methodOptions}}" wx:key="*this" class="option {{form.method===item?'selected':''}}" data-key="method" data-value="{{item}}" bindtap="select"><image class="method-icon" src="/pages/workflow/assets/biz-method-{{index===0?'phone':index===1?'wechat':'store'}}.jpg"/>{{item}}</button></view><text class="field-label">沟通结果</text><picker range="{{['已联系','未接通','待回复','已到店']}}" data-key="followResult" data-options="resultOptions" bindchange="pick"><view class="input">{{form.followResult}}<image class="down" src="/assets/creation-down.png"/></view></picker><text class="field-label">需求与沟通内容</text><textarea class="textarea" data-key="followContent" value="{{form.followContent}}" bindinput="input"/><text class="field-label">下次安排</text><view class="options"><button wx:for="{{nextOptions}}" wx:key="*this" class="option {{form.next===item?'selected':''}}" data-key="next" data-value="{{item}}" bindtap="select"><image class="method-icon" src="/pages/workflow/assets/biz-method-{{index===0?'phone':index===1?'wechat':'store'}}.jpg"/>{{item}}</button></view><text class="field-label">时间</text><view class="input"><input data-key="appointment" value="{{form.appointment}}" placeholder="例如：10月19日 15:00" bindinput="input"/><image class="date-icon" src="/assets/calendar.png"/></view><text class="muted owner-note">未保存</text></block>
 <block wx:elif="{{modal==='generate'}}"><text class="block-text">按当前参数展示 {{form.count||2}} 套方案预览，参考图和目标尺寸随方案保存，不调用真实AI。</text><button class="outline btn" bindtap="closeModal">返回调整</button></block>
 <block wx:else><view wx:for="{{[{key:'window',name:'门窗'},{key:'paint',name:'墙漆'},{key:'stone',name:'文化石'},{key:'light',name:'灯光'},{key:'waterproof',name:'防水'},{key:'lightning',name:'防雷'},{key:'insurance',name:'保险'}]}}" wx:key="key" class="input-row"><text>{{item.name}}</text><switch checked="{{form.exterior[item.key]}}" data-key="{{item.key}}" bindchange="exteriorChange" color="{{designFlow?'#81522e':'#a64210'}}"/></view></block>
 <text wx:if="{{error}}" class="error">{{error}}</text><button class="btn sheet-save" bindtap="{{modal==='exterior'?'closeModal':'saveModal'}}">{{modal==='register'||modal==='edit'?'保存客户':modal==='follow'?'保存跟进':modal==='assign'?'确认派单':modal==='return'?'确认退回':modal==='receipt'?'保存收款备案':modal==='generate'?'查看方案':'完成配置'}}</button>
</view></view>
<view wx:if="{{preview}}" class="overlay business-surface {{designFlow?'design-flow':''}}" catchtap="closePreview"><view class="sheet" catchtap="noop"><view class="sheet-head"><text>{{preview.name}}</text><button class="close" bindtap="closePreview" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view><image wx:if="{{preview.image}}" class="section-picture" src="{{preview.image}}" mode="widthFix"/><text>{{preview.description}}</text><view wx:if="{{preview.quote}}" class="soft"><view class="money">¥ {{fmt.money(preview.quote.total)}}</view><text>计价建筑面积 {{preview.quote.area}}㎡</text><text class="block-text">版本 V{{preview.quote.version}} · {{preview.quote.date}}</text></view><button class="btn sheet-save" bindtap="closePreview">返回</button></view></view>
