      <view wx:elif="{{item.type==='status'}}" class="status-row {{item.ok?'ok':''}}"><text class="muted">{{item.label}}</text><view><image src="/pages/workflow/assets/biz-{{item.ok?'success':'info'}}.jpg"/><text>{{item.value}}</text></view></view>
      <view wx:elif="{{item.type==='metric-inputs'}}" class="metric-inputs"><view wx:for="{{item.values}}" wx:key="key" wx:for-item="metric" class="metric-input"><text class="muted">{{metric.label}}</text><view><input data-key="{{metric.key}}" value="{{form[metric.key]}}" type="digit" bindinput="input"/><text class="muted">{{metric.unit}}</text></view></view></view>
      <view wx:elif="{{item.type==='photos'}}" class="photos"><view wx:for="{{form.sitePhotos}}" wx:key="*this" class="photo-item"><image src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage"/><button class="photo-remove" data-index="{{index}}" bindtap="removePhoto" aria-label="移除照片"><image src="/assets/studio-clear.png"/></button></view><button bindtap="addPhoto"><image src="/pages/workflow/assets/biz-camera.jpg"/>上传照片</button></view>
