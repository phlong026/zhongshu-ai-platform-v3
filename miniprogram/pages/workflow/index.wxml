<view class="heading">外装配置<button class="link" data-modal="exterior" bindtap="modal">配置 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="tool-grid three"><button wx:for="{{[{name:'门窗',icon:'window'},{name:'墙漆',icon:'paint'},{name:'文化石',icon:'stone'},{name:'灯光',icon:'light'},{name:'防水',icon:'waterproof'},{name:'防雷',icon:'lightning'},{name:'保险',icon:'insurance'}]}}" wx:key="name" data-modal="exterior" bindtap="modal"><image src="/pages/workflow/assets/biz-{{item.icon}}.jpg"/>{{item.name}}<image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view></view><text class="muted hint">按参数测算，仅供前期参考。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">开始测算</button></view>
   </block>
   <block wx:elif="{{view==='budget-result'}}">
    <view class="tabs"><button data-view="budget" bindtap="go">参数</button><button class="active">结果</button></view><view class="card budget-summary"><view class="heading">参考预算<text class="muted">演示测算</text></view><view class="money centered">￥{{fmt.money(currentBudget?currentBudget.total:600000)}}</view><text class="muted centered">主体 + 外装</text><view class="stats"><view><text class="muted">建筑面积</text><text>{{currentBudget?currentBudget.area:form.area}}㎡ · {{currentBudget&&currentBudget.parameters?currentBudget.parameters.floors:customer.floors}}层</text></view><view><text class="muted">预算版本</text><text>{{currentBudget?currentBudget.version:1}}</text></view></view></view><view class="card"><view class="heading">主体工程<text class="amount">￥{{fmt.money(currentBudget?currentBudget.main:480000)}}</text></view><view class="soft"><view wx:for="{{currentBudget.bodyRows}}" wx:key="label" class="kv"><text>{{item.label}}</text><text class="right">￥{{fmt.money(item.value)}}</text></view></view></view><view class="card"><view class="heading">外装工程<text class="amount">￥{{fmt.money(currentBudget?currentBudget.exterior:120000)}}</text></view><view class="soft"><view wx:for="{{currentBudget.exteriorRows}}" wx:key="label" class="kv"><text>{{item.label}}</text><text class="right">￥{{fmt.money(item.value)}}</text></view></view><text class="muted hint">按各项面积和模拟单价测算，不包含室内装修。价格版本 {{currentBudget.priceVersion}}。</text></view><view wx:if="{{currentBudget}}" class="card"><view class="heading">报价单导出</view><text class="muted">按客户报价表格式导出图片或PDF，金额沿用本版参考预算。</text><button class="outline btn quote-export-entry" data-kind="budget" bindtap="exportQuote">预览并导出图片 / PDF</button></view><view class="card"><view class="heading">继续设计委托</view><text class="muted">保存本次预算并发起设计委托，办理设计费、总部设计和收图确认后，再核算建造报价及签订建造合同。</text><button class="outline btn budget-next" bindtap="continueBudget">保存预算并发起设计委托</button></view><view class="footer page-actions"><button class="outline btn" bindtap="secondary">调整参数</button><button class="btn primary-action" bindtap="submit">保存预算并继续设计</button></view>
   </block>
   <block wx:elif="{{view==='transfer'}}">
    <text class="muted role-note">当前身份：{{role}}</text>
    <view class="tabs"><button wx:for="{{['单条转交','批量转交']}}" wx:key="*this" class="{{transferMode===index?'active':''}}" data-index="{{index}}" bindtap="transferMode">{{item}}</button></view>
    <block wx:if="{{transferMode===1}}">
     <view class="card"><view class="heading">选择转交客户</view><button wx:for="{{filteredCustomers}}" wx:key="id" class="check-row" data-id="{{item.id}}" bindtap="toggleCustomer"><checkbox checked="{{selectedFlags[item.id]}}" color="{{designFlow?'#81522e':'#a64210'}}"/><text>{{item.name}} · {{item.owner||'我'}}</text></button></view>
     <view class="card"><view class="heading">当前负责人</view><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{customer.owner||'我'}} · <text class="muted">业务员</text></text></view></view><view class="card"><view class="heading">新负责人</view><picker range="{{ownerOptions}}" data-key="newOwner" data-options="ownerOptions" bindchange="pick"><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{form.newOwner}} · <text class="muted">业务员</text></text><image class="down" src="/assets/creation-down.png"/></view></picker></view>
     <view class="card"><view class="heading">转交原因</view><textarea class="textarea" data-key="transferReason" value="{{form.transferReason}}" bindinput="input" maxlength="200"/></view>
     <view class="card tinted preserve"><view class="heading">一并保留</view><view wx:for="{{['原始来源与历史作者','合同、款项与设计成果','未完成跟进事项']}}" wx:key="*this" class="condition"><image src="/pages/workflow/assets/biz-success.jpg"/>{{item}}</view></view><text class="muted hint">确认后新负责人立即生效，无需接收审批。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">确认转交</button></view>
    </block>
    <block wx:else>
     <view class="card transfer-customer"><view class="heading">客户信息</view><view class="banner-main"><view class="initial">{{customerInitial}}</view><view class="banner-info"><view class="name">{{customer.name}} <text class="badge">演示数据</text></view><view class="banner-line"><image src="/pages/workflow/assets/biz-phone.jpg"/>{{phone}}</view><view class="banner-line"><image src="/pages/workflow/assets/biz-location.jpg"/>{{city}} · 二层乡墅</view></view></view></view>
     <view class="card"><view class="heading">当前负责人</view><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{customer.owner||'我'}} · <text class="muted">业务员</text></text></view></view><view class="card"><view class="heading">新负责人</view><picker range="{{ownerOptions}}" data-key="newOwner" data-options="ownerOptions" bindchange="pick"><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{form.newOwner}} · <text class="muted">业务员</text></text><image class="down" src="/assets/creation-down.png"/></view></picker></view>
     <view class="card"><view class="heading">转交原因</view><textarea class="textarea" data-key="transferReason" value="{{form.transferReason}}" bindinput="input" maxlength="200"/></view>
     <view class="card tinted preserve"><view class="heading">一并保留</view><view wx:for="{{['原始来源与历史作者','合同、款项与设计成果','未完成跟进事项']}}" wx:key="*this" class="condition"><image src="/pages/workflow/assets/biz-success.jpg"/>{{item}}</view></view><text class="muted hint">确认后新负责人立即生效，无需接收审批。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">确认转交</button></view>
    </block>
   </block>
   <block wx:elif="{{view==='facade-config'||view==='facade-candidates'}}">
    <view class="tabs"><button data-view="ai-config" bindtap="go">平面方案</button><button class="active">立面方案</button></view>
    <block wx:if="{{view==='facade-config'}}"><view class="card"><view class="heading">参考图片（选填）</view><view class="facade-references"><image src="/pages/workflow/assets/biz-facade-reference.jpg" mode="aspectFill"/><button wx:for="{{[1,2]}}" wx:key="*this" data-key="facadeReference" bindtap="upload"><image src="/pages/workflow/assets/biz-add.jpg"/>上传图片</button></view><view class="reference-hint"><text class="muted">可上传0–3张参考图。</text><button class="link" data-view="inspiration" bindtap="go">从灵感库选择 <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view><view class="card"><view class="heading">立面需求</view><view class="dimension-row"><text>建筑风格</text><picker class="flex" range="{{facadeStyleOptions}}" data-key="style" data-options="facadeStyleOptions" bindchange="pick"><view class="input">{{form.style}}<image class="down" src="/assets/creation-down.png"/></view></picker><text>建筑层数</text><view class="input"><input data-key="floors" value="{{form.floors}}" bindinput="input"/>层</view></view><view class="input-row"><text class="label">主色调</text><view class="input"><input data-key="palette" value="{{form.palette}}" bindinput="input"/></view></view></view><view class="card"><view class="heading">补充要求</view><textarea class="textarea short" data-key="facadeNotes" value="{{form.facadeNotes}}" bindinput="input"/></view><view class="card settings-card"><view class="heading">生成设置</view><view class="settings-row"><text class="muted">清晰度</text><button wx:for="{{resolutionOptions}}" wx:key="*this" class="option {{form.resolution===item?'selected':''}}" data-key="resolution" data-value="{{item}}" bindtap="select">{{item}}</button><text class="muted">画幅</text><button wx:for="{{aspectOptions}}" wx:key="*this" class="option {{form.aspect===item?'selected':''}}" data-key="aspect" data-value="{{item}}" bindtap="select">{{item}}</button></view><view class="settings-row"><text class="muted">生成张数</text><button wx:for="{{countOptions}}" wx:key="*this" class="option {{form.count===item?'selected':''}}" data-key="count" data-value="{{item}}" bindtap="select">{{item}}</button></view></view><view class="card"><view class="input-row"><text class="label">项目建筑面积</text><view class="input"><input data-key="facadeArea" value="{{form.facadeArea}}" bindinput="input" type="digit"/>㎡（待核定）</view></view><text class="muted hint">尺寸与面积以核定信息为准。</text></view><text class="muted hint">设计点将在提交前确认 · 仅供方案沟通，不作为施工图。</text><view class="page-actions"><button class="btn bottom-inline" bindtap="submit">生成立面方案</button></view></block>
    <block wx:else><view class="card reference-row"><image src="/pages/workflow/assets/biz-facade-1.jpg" mode="aspectFill"/><view class="flex"><text class="row-title">立面方案 · {{form.style}}</text><text class="muted">{{form.floors}}层 · {{form.palette}} · {{form.resolution}} · {{candidateIndexes.length}}张</text><button class="soft-link" data-view="facade-config" bindtap="go">调整参数 <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view><view class="card ai-results facade-candidates"><view class="heading">生成结果<text class="success-text">已完成 {{candidateIndexes.length}}/{{candidateIndexes.length}}</text></view><button wx:for="{{candidateIndexes}}" wx:key="*this" class="plan-choice {{selectedPlan===item?'chosen':''}}" data-index="{{item}}" bindtap="planSelect"><view class="plan-title"><text>方案{{item+1}}</text><view class="plan-select-state"><radio checked="{{selectedPlan===item}}" color="{{designFlow?'#81522e':'#a63f0b'}}"/><text class="copper">{{selectedPlan===item?'已选中':''}}</text></view></view><image src="/pages/workflow/assets/biz-facade-{{item%2+1}}.jpg" class="facade-candidate-image" mode="aspectFill"/></button></view><view class="notice"><text class="row-title copper">选中后，保存为方案版本</text><text class="muted">仅供方案沟通，不作为施工图</text></view><view class="footer page-actions"><button class="outline btn" data-view="facade-config" bindtap="go">重新生成</button><button class="btn primary-action" bindtap="submit">选用并保存</button></view></block>
   </block>
