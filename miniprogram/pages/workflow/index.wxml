   <block wx:else>
    <view wx:if="{{view==='quote'&&currentQuote}}" class="card"><view class="heading">报价单导出</view><button class="outline btn quote-export-entry" data-kind="quote" bindtap="exportQuote">预览并导出图片 / PDF</button></view><view wx:for="{{sections}}" wx:key="index" wx:for-item="section" class="card section-{{index}} {{section.tint?'tinted':''}}">
     <view wx:if="{{section.title}}" class="heading"><text>{{section.title}}</text><text wx:if="{{section.meta}}" class="muted meta">{{section.meta}}</text><text wx:if="{{section.badge}}" class="badge {{section.badgeGreen?'green':''}}">{{section.badge}}</text></view>
     <block wx:for="{{section.items}}" wx:key="index" wx:for-item="item">
      <view wx:if="{{item.type==='kv'}}" class="kv soft-kv"><text class="label">{{item.label}}</text><text class="flex">{{item.value}}</text></view>
      <text wx:elif="{{item.type==='text'}}" class="block-text {{item.style}}">{{item.value}}</text>
      <view wx:elif="{{item.type==='money'}}" class="money-block"><view class="money"><text wx:if="{{item.prefix}}" class="money-prefix">{{item.prefix}} </text>{{item.prefix?'':'￥'}}{{item.value}}</view><text wx:if="{{item.subtitle}}" class="muted">{{item.subtitle}}</text></view>
      <view wx:elif="{{item.type==='file'}}" class="file-row" data-key="{{item.key}}" data-name="{{item.name}}" data-file="{{item.file}}" bindtap="previewFile"><image src="{{item.icon==='image'?'/assets/studio-image.png':'/pages/workflow/assets/biz-pdf.jpg'}}"/><view class="flex"><text class="file-name">{{form[item.key]?form[item.key].name:item.name}}</text></view><text wx:if="{{item.badge}}" class="badge green">{{item.badge}}</text><text wx:else class="muted file-action">{{view==='intake'||view==='request'||view==='copies'?'查看':'预览'}}</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></view>
      <view wx:elif="{{item.type==='input'}}" class="input-row"><text class="label">{{item.label}}</text><picker wx:if="{{item.kind==='date'||item.key==='paymentDate'||item.key==='measurementDate'||item.key==='signedDate'||item.key==='receiveDate'||item.key==='confirmationDate'||item.key==='receiptDate'}}" class="flex" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="date"><view class="input">{{form[item.key]||item.placeholder}}<image class="date-icon" src="/assets/calendar.png"/></view></picker><picker wx:elif="{{item.key==='manager'}}" class="flex" range="{{managerOptions}}" data-key="manager" data-options="managerOptions" bindchange="pick"><view class="input">{{form.manager}}<image class="arrow" src="/assets/creation-chevron-muted.png"/></view></picker><view wx:else class="input flex"><input data-key="{{item.key}}" value="{{form[item.key]}}" placeholder="{{item.placeholder}}" bindinput="input" type="{{item.inputType||((item.key==='amount'||item.key==='receiptAmount')?'digit':'text')}}"/><text wx:if="{{item.unit}}" class="muted">{{item.unit}}</text></view></view>
      <view wx:elif="{{item.type==='choice'}}"><text class="field-label">{{item.label}}</text><view class="options"><button wx:for="{{item.values}}" wx:key="*this" wx:for-item="value" class="option {{form[item.key]===value?'selected':''}}" data-key="{{item.key}}" data-value="{{value}}" bindtap="select">{{value}}</button></view></view>
      <view wx:elif="{{item.type==='record-list'}}" class="record-list"><text wx:if="{{!item.values.length}}" class="block-text muted">暂无记录</text><view wx:for="{{item.values}}" wx:key="index" wx:for-item="record" class="record-row"><view class="record-main"><button wx:if="{{record.view}}" class="record-content" data-view="{{record.view}}" data-record="{{record.record}}" bindtap="go"><view><text class="row-title">{{record.title}}</text><text class="muted">{{record.subtitle}}</text></view><text wx:if="{{record.badge}}" class="badge">{{record.badge}}</text><image wx:if="{{record.view}}" class="arrow" src="/assets/creation-chevron-muted.png"/></button><view wx:else class="record-content"><view><text class="row-title">{{record.title}}</text><text class="muted">{{record.subtitle}}</text></view><text wx:if="{{record.badge}}" class="badge">{{record.badge}}</text><image wx:if="{{record.view}}" class="arrow" src="/assets/creation-chevron-muted.png"/></view></view><view wx:for="{{record.files}}" wx:key="index" wx:for-item="recordFile" class="file-row" data-file="{{recordFile}}" data-name="{{recordFile.name}}" bindtap="previewFile"><image src="/pages/workflow/assets/biz-pdf.jpg"/><text class="file-name flex">{{recordFile.name}}</text><text class="muted">预览</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></view></view></view>
      <textarea wx:elif="{{item.type==='textarea'}}" class="textarea" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="2000"/>
      <view wx:elif="{{item.type==='upload'}}" class="upload-row"><text wx:if="{{view==='payment-first'||view==='payment-tail'}}" class="upload-label">付款凭证</text><text wx:if="{{view==='documents'}}" class="upload-label">施工图文件</text><button wx:if="{{view==='documents'}}" class="drawing-upload" data-key="{{item.key}}" bindtap="upload"><image src="/pages/workflow/assets/biz-pdf.jpg"/><text>{{form[item.key]?form[item.key].name:'选择施工图文件'}}</text><text class="link">更换</text></button><button wx:else class="upload" data-key="{{item.key}}" bindtap="upload"><image src="/pages/workflow/assets/biz-add.jpg"/><text>{{form[item.key]?form[item.key].name:item.label}}</text><text class="muted">{{form[item.key]?'点击更换':'支持 PDF、图片'}}</text></button></view>
      <button wx:elif="{{item.type==='check'}}" class="check-row" aria-checked="{{form[item.key]}}" data-key="{{item.key}}" bindtap="toggle"><image class="checkbox-image" src="/pages/workflow/assets/biz-checkbox-{{form[item.key]?'checked':'empty'}}.jpg"/><text>{{item.label}}</text></button>
      <view wx:elif="{{item.type==='notice'}}" class="notice"><image src="/pages/workflow/assets/biz-info.jpg"/><text>{{item.value}}</text></view>
      <view wx:elif="{{item.type==='stats'}}" class="stats soft"><view wx:for="{{item.values}}" wx:key="label" wx:for-item="stat"><text class="muted">{{stat.label}}</text><text class="stat-value">{{stat.value}}</text></view></view>
