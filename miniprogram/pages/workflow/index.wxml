<wxs src="../../utils/tone.wxs" module="st"/>
<wxs src="./format.wxs" module="fmt"></wxs>
<view class="workflow view-{{view}} {{view==='customer'||view==='arrival'?'customer-workspace':''}}">
 <business-header id="workflow-header" title="{{title}}"/>
 <view wx:if="{{!customer&&view!=='customers'}}" class="body"><view class="card empty"><block wx:if="{{platformStatus==='loading'}}">正在加载客户资料…</block><block wx:elif="{{platformStatus==='degraded'}}">{{platformError||error}}</block><block wx:else>{{error||'客户资料暂不可用'}}</block><view class="page-actions"><button wx:if="{{platformStatus==='degraded'}}" class="outline btn" bindtap="retryPlatform">重试</button><button class="btn workflow-nav" data-view="customers" bindtap="go">返回客户列表</button></view></view></view>
 <view wx:else class="body">
  <view wx:if="{{blocked}}" class="card empty"><text>{{blocked.message}}</text><view class="page-actions"><button class="btn workflow-nav" data-view="{{blocked.target}}" bindtap="go">{{blocked.label}}</button></view></view><block wx:else>
  <block wx:if="{{view==='customers'}}">
   <view class="search"><image src="/assets/search.png"/><input placeholder="搜索姓名、手机号" value="{{keyword}}" bindinput="searchCustomers"/></view>
   <view class="list-title"><text>{{selectingCustomer?'选择本次办理的客户':'我的客户'}}</text><button wx:if="{{canRegister}}" class="btn customer-register" data-modal="register" bindtap="modal">登记客户</button></view>
   <view class="tabs"><button wx:for="{{filters}}" wx:key="*this" class="{{filter===item?'active':''}}" data-value="{{item}}" bindtap="setFilter">{{item}}</button></view>
   <view wx:for="{{filteredCustomers}}" wx:key="id" class="card customer-list-row" data-id="{{item.id}}" bindtap="chooseCustomer"><view class="initial small">{{item.name[0]}}</view><view class="flex"><view class="name">{{item.name}} <text class="badge">{{item.status}}</text></view><text class="muted">{{item.phoneText || item.phone || item.wechat}} · {{item.city}}</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></view>
   <view wx:if="{{platformMode&&platformStatus==='loading'}}" class="card empty">正在加载客户…</view>
   <view wx:elif="{{platformMode&&platformStatus==='degraded'}}" class="card empty">加载失败：{{platformError}}<button class="outline btn" bindtap="retryPlatform">重试</button></view>
   <view wx:elif="{{!filteredCustomers.length}}" class="card empty">暂无符合条件的客户</view>
  </block>
  <block wx:else>
   <view wx:if="{{role}}" class="operation-identity">办理身份：{{role}}</view>
   <view wx:if="{{view!=='transfer'}}" class="card customer-banner {{large?'large':'compact'}} {{compactProject?'project-compact':''}}">
    <view class="banner-main"><view class="initial {{large?'':'small'}}">{{customerInitial}}</view><view class="banner-info"><view class="name"><text class="customer-name">{{customer.name}}</text><text wx:if="{{view==='budget'}}" class="budget-city">· {{city}}</text><text wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="badge {{st.tone(customer.status)}}">{{customer.status}}</text></view>
     <view wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="banner-line"><image src="/pages/workflow/assets/biz-phone.jpg"/>{{phone || customer.wechat}}</view>
     <view wx:if="{{view!=='budget'}}" class="banner-line">{{projectSummary}}</view>
     <text wx:if="{{view==='budget'||view==='budget-result'}}" class="muted">{{currentPlan?'平面方案 v'+currentPlan.version:currentFacade?'立面方案 v'+currentFacade.version:'未关联方案'}}</text>
    </view><text wx:if="{{badge}}" class="badge banner-badge {{st.tone(badge)}}">{{badge}}</text></view>
    <view wx:if="{{headerItems}}" class="soft"><view wx:for="{{headerItems}}" wx:key="label" class="kv"><text class="label">{{item.label}}</text><text>{{item.value}}</text></view></view>
   </view>
   <view wx:if="{{(view==='requirement'||view==='budget'||view==='contract')&&requirementsStatus==='loading'}}" class="card empty">正在加载历史需求…</view>
   <view wx:elif="{{(view==='requirement'||view==='budget'||view==='contract')&&requirementsStatus==='error'}}" class="card empty">{{requirementsError}}<button class="outline btn" bindtap="retryRequirements">重试加载需求</button></view>
   <view wx:elif="{{(view==='requirement'||view==='budget'||view==='contract')&&requirementsStatus==='blocked'}}" class="card empty">{{requirementsError}}</view>
   <view wx:if="{{taskSummary}}" class="card task-summary"><view><text class="task-label">当前事项</text><text class="task-state">{{taskSummary.state}}</text></view><text class="muted">当前责任：{{taskSummary.owner}}</text></view>
   <view wx:if="{{platformMode&&view==='customer'}}" class="tabs customer-tabs"><button wx:for="{{customerTabs}}" wx:key="*this" class="{{activeCustomerTab===index?'active':''}}" data-index="{{index}}" bindtap="customerTab">{{item}}</button></view>
   <block wx:if="{{view==='customer'||view==='arrival'}}">
    <view wx:if="{{platformMode}}" class="card">
 <view class="heading"><text>客户跟进</text><button class="link" bindtap="openCustomerFlow">{{flow.status==='LOST'||flow.status==='PAUSED'?'查看进度':'继续跟进'}} <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view>
 <block wx:if="{{flow}}">
  <view class="cw-prog-top"><text class="cw-prog-label">跟进进度</text><text class="cw-prog-score">{{flow.completedCount}}<text class="cw-prog-frac">/8</text><text class="cw-prog-sep"></text><text class="cw-prog-pct">{{flow.progressPercent}}%</text></text></view>
  <view class="cw-prog-next"><text class="{{nextFollowLate?'cw-late':''}}">{{nextFollowText}}</text><text class="cw-prog-step">当前 {{currentStepName}}</text></view>
  <text wx:if="{{engineeringHint}}" class="muted">{{engineeringHint}}</text>
  <view class="cw-rail">
   <block wx:for="{{rail}}" wx:key="code">
    <view wx:if="{{index}}" class="cw-conn {{item.done?'cw-conn-done':''}}"></view>
    <view class="cw-node {{item.done?'cw-node-done':item.active?'cw-node-active':''}}" aria-label="{{item.number}} {{item.name}}"><text>{{item.done?'✓':item.number}}</text><text wx:if="{{item.active}}" class="cw-node-name">{{item.name}}</text></view>
   </block>
  </view>
 </block>
 <text wx:else class="muted">邀约、选型、报价、签约至开工</text>
</view>
    <view wx:if="{{activeCustomerTab===0}}" class="card"><view class="heading"><text>客户资料</text><button wx:if="{{canEditCustomer}}" class="link" data-modal="edit" bindtap="modal">编辑 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="soft"><view class="kv"><text class="label">来源</text><text>{{customer.source}}</text></view><block wx:if="{{showSizeBlock}}"><text class="muted">确认建房需求</text><view class="kv"><text class="label">建筑外轮廓</text><text>面宽 {{customer.width}}米 × 进深 {{customer.depth}}米</text></view><view class="kv"><text class="label">计划层数</text><text>{{customer.floors}}层</text></view></block><view wx:if="{{customer.address}}" class="kv summary"><text class="label">地址</text><text class="flex customer-address-text">{{customer.address}}</text></view><view class="kv summary"><text class="label">需求摘要</text><text class="flex">{{customer.summary}}</text></view></view></view>
    <view wx:if="{{activeCustomerTab===0 && contentSources.length}}" class="card content-source-card"><view class="heading">视频咨询来源</view><view wx:for="{{contentSources}}" wx:key="leadId" class="soft content-source-row"><view class="flex"><text class="row-title">{{item.title||'已发布视频'}}</text><text class="muted">{{item.createTime}}</text><text class="muted">{{item.need}}</text><text class="muted">咨询状态：{{item.status}}</text></view><button class="link" data-publication-id="{{item.publicationId}}" bindtap="openContentSource">查看来源视频 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view></view>
    <view wx:if="{{activeCustomerTab===1}}" class="card follow-card">
     <view class="heading"><text>跟进记录</text><text wx:if="{{timelineTotal}}" class="muted">共 {{timelineTotal}} 条</text></view>
     <view wx:if="{{!timeline.length&&!timelineError}}" class="follow-empty"><image src="/pages/workflow/assets/biz-empty-follow.jpg"/><text class="empty-title">暂无跟进记录</text><text class="muted">{{canChange?'从第 1 步「邀约进店」开始跟进':'负责人尚未跟进'}}</text></view>
     <view wx:for="{{timeline}}" wx:key="id" class="cw-tl {{item.kind}}">
      <view class="cw-tl-dot"></view>
      <view class="cw-tl-body">
       <view class="cw-tl-head"><text class="cw-tl-time">{{item.time}}</text><text class="cw-tl-title">{{item.title}}</text><text class="cw-tl-who">{{item.actor}}</text></view>
       <text wx:if="{{item.note}}" class="cw-tl-note">{{item.note}}</text>
       <text wx:if="{{item.next}}" class="cw-tl-next">{{item.next}}</text>
       <text wx:if="{{item.files}}" class="cw-tl-files">附件 {{item.files}} 个，可在八步跟进页查看</text>
      </view>
     </view>
     <text wx:if="{{timelineError}}" class="error" role="alert">{{timelineError}}</text>
     <button wx:if="{{timelineMore}}" class="link" bindtap="moreTimeline">加载更多记录</button>
    </view>
    <view wx:if="{{activeCustomerTab===1&&canDesign&&saleWrite}}" class="card design-tools"><view class="heading">业务办理</view><view class="tool-grid"><button class="workflow-nav" data-tool="inspiration" bindtap="openDesignTool"><image src="/pages/workflow/assets/biz-book.jpg"/><text>灵感检索</text></button><button class="workflow-nav" data-tool="budget" bindtap="openDesignTool"><image src="/pages/workflow/assets/biz-calculator.jpg"/><text>快速预算</text></button><button class="workflow-nav" data-tool="commission" bindtap="openDesignTool"><image src="/pages/workflow/assets/biz-house.jpg"/><text>委托设计</text></button></view></view>
    <view wx:if="{{platformMode&&schemesList&&schemesList.length}}" class="card"><view class="heading">方案版本</view><view wx:for="{{schemesList}}" wx:key="id" class="soft follow-record"><view class="flex"><text class="row-title">{{item.kindText}} V{{item.version}} <text wx:if="{{item.formal}}" class="badge green">正式</text></text><text class="muted">{{item.date}}</text></view><button wx:if="{{saleWrite&&!item.formal}}" class="link" data-scheme-id="{{item.id}}" bindtap="platformPromote">转正式</button></view></view>
    <view wx:if="{{platformMode&&isBossView}}" class="page-actions customer-follow-actions"><button class="outline btn bottom-inline workflow-nav" data-view="transfer" bindtap="go">责任转交</button></view><view wx:if="{{platformMode&&canChange&&flow}}" class="page-actions customer-follow-actions cw-actions"><block wx:if="{{flow.status==='ACTIVE'}}"><button class="outline btn bottom-inline" bindtap="openStatus" data-kind="paused">暂缓</button><button class="outline btn bottom-inline" bindtap="openStatus" data-kind="lost">标记流失</button><button class="btn bottom-inline cw-main" bindtap="openCustomerFlow">继续跟进</button></block><button wx:else class="btn bottom-inline cw-main" bindtap="openStatus" data-kind="resume">恢复跟进</button></view>
   </block>
   <block wx:elif="{{view==='progress'}}">
    <view wx:if="{{stages.length||progressInfo}}" class="card"><view class="heading">当前阶段</view><view class="flow-steps journey-steps"><view wx:for="{{stages}}" wx:key="*this" class="flow-step {{stageIndex>index?'done':index===stageIndex?'current':''}}"><text class="flow-step-index">{{stageIndex>index?'✓':index+1}}</text><text>{{item}}</text></view></view><view class="soft progress-now"><text class="row-title">{{progressInfo.title}}</text><text wx:if="{{progressInfo.owner||progressInfo.next}}" class="muted">{{progressInfo.owner?'负责人：'+progressInfo.owner:''}}{{progressInfo.owner&&progressInfo.next?' · ':''}}{{progressInfo.next?'下一步：'+progressInfo.next:''}}</text></view></view>
    <view wx:if="{{progressInfo}}" class="card"><view class="heading"><text>最新进展</text><button class="link" bindtap="toggleProgressRecords">{{showAllProgressRecords?'收起记录':'全部记录'}} <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view wx:if="{{progressInfo.latest}}" class="soft follow-record"><image src="{{progressInfo.latest.image||'/pages/workflow/assets/biz-record.jpg'}}" mode="aspectFill"/><view class="flex"><text class="row-title">{{progressInfo.latest.text}}</text><text class="muted">{{progressInfo.latest.date}}{{progressInfo.latest.by?' · '+progressInfo.latest.by:''}}</text></view></view><view wx:else class="soft"><text class="muted">暂无项目办理记录</text></view></view>
    <view wx:if="{{showAllProgressRecords}}" class="card"><view class="heading"><text>全流程记录</text><text class="muted">{{progressInfo.records.length}}条</text></view><view wx:for="{{visibleProgressRecords}}" wx:key="key" class="soft follow-record"><image src="{{item.image||'/pages/workflow/assets/biz-record.jpg'}}" mode="aspectFill"/><view class="flex"><text class="row-title">{{item.text}} <text class="badge neutral">{{item.badge}}</text></text><text class="muted">{{item.date}}{{item.by?' · '+item.by:''}}</text></view></view><button wx:if="{{visibleProgressRecords.length<progressInfo.records.length}}" class="outline btn" bindtap="loadMoreProgressRecords">加载更多记录</button><view wx:if="{{!progressInfo.records.length}}" class="soft"><text class="muted">暂无项目办理记录</text></view></view>
    <block wx:if="{{platformMode}}">
     <view wx:if="{{progressErr}}" class="card empty">{{progressErr}}<button class="outline btn" bindtap="customerTab" data-index="2">重试</button></view>
     <view class="card"><view class="heading">需求登记</view><view wx:if="{{!progressRequirements.length}}" class="soft"><text class="muted">暂无需求登记</text></view><view wx:for="{{progressRequirements}}" wx:key="id" class="soft follow-record"><view class="flex"><text class="row-title">V{{item.version}} {{item.style}}</text><text class="muted">{{item.sizeText}}</text></view><text class="muted">{{item.date}}</text></view></view>
     <view class="card"><view class="heading">报价记录</view><view wx:if="{{!progressQuotes.length}}" class="soft"><text class="muted">暂无报价</text></view><view wx:for="{{progressQuotes}}" wx:key="id" class="soft follow-record"><view class="flex"><text class="row-title">{{item.priceVersion}}</text><text class="amount">¥ {{item.totalText}}</text></view><text class="muted">{{item.date}}</text></view></view>
     <view class="card"><view class="heading">合同与回款</view><view wx:if="{{!progressContracts.length}}" class="soft"><text class="muted">暂无合同</text></view><view wx:for="{{progressContracts}}" wx:key="id" class="soft follow-record progress-contract-card"><view class="flex"><text class="row-title">合同 <text class="badge {{item.status==='SIGNED'?'green':''}}">{{item.statusText}}</text></text><text class="amount">¥ {{item.totalText}}</text></view><view wx:for="{{item.stages}}" wx:for-item="stageRow" wx:key="id" class="flex"><text class="muted">{{stageRow.stageText}} {{stageRow.statusText}}</text><text class="amount">¥ {{stageRow.amountText}}</text></view></view></view>
     <view class="card"><view class="heading">交付进度</view><view wx:if="{{!progressDelivery}}" class="soft"><text class="muted">尚未创建交付</text></view><view wx:else class="flow-steps journey-steps"><view wx:for="{{progressDelivery.nodes}}" wx:key="key" class="flow-step {{item.done?'done':index===progressDelivery.nextIndex?'current':''}}"><text class="flow-step-index">{{item.done?'✓':index+1}}</text><text>{{item.label}}{{item.atText?' '+item.atText:''}}</text></view></view></view>
    </block>
   </block>
   <block wx:elif="{{view==='budget'}}">
    <view class="tabs"><button class="{{platformMode&&view==='budget-result'?'':'active'}}" bindtap="{{platformMode?'budgetShowForm':''}}">参数</button><button wx:if="{{view==='budget-result'}}" class="active" bindtap="budgetShowResult">结果</button><button wx:else bindtap="budgetShowResult">结果（未测算）</button></view><view class="card"><view class="heading">建筑信息</view><view class="soft"><view class="kv"><text>地区</text><text class="right">湖北 · {{city}}</text></view><view wx:if="{{platformMode}}" class="soft"><view class="input-row"><text>建筑面宽</text><view class="input"><input type="digit" data-key="width" value="{{form.width}}" bindinput="input"/><text>m</text></view></view><view class="input-row"><text>建筑进深</text><view class="input"><input type="digit" data-key="depth" value="{{form.depth}}" bindinput="input"/><text>m</text></view></view><view class="input-row"><text>建筑层数</text><view class="input"><input type="number" data-key="floors" value="{{form.floors}}" bindinput="input"/><text>层</text></view></view></view><view class="input-row"><text>建筑占地</text><view class="input"><input type="digit" data-key="footprint" value="{{form.footprint}}" bindinput="input"/><text>㎡</text></view></view><view class="input-row"><text>建筑面积</text><view class="input"><input type="digit" data-key="area" value="{{form.area}}" bindinput="input"/><text>㎡</text></view></view><text class="muted hint">按实际建筑面积核对，不含庭院。</text></view></view><view class="card"><view class="heading">主体配置</view><picker wx:for="{{[{label:'基础',key:'foundation',options:'foundationOptions',icon:'foundation'},{label:'结构',key:'structure',options:'structureOptions',icon:'structure'},{label:'屋顶',key:'roof',options:'roofOptions',icon:'roof'}]}}" wx:key="key" range="{{item.key==='foundation'?foundationOptions:(item.key==='structure'?structureOptions:roofOptions)}}" data-key="{{item.key}}" data-options="{{item.options}}" bindchange="pick"><view class="row outlined"><image class="round-icon" src="/pages/workflow/assets/biz-{{item.icon}}.jpg"/><text>{{item.label}}</text><text class="right">{{form[item.key]}}</text><image class="arrow" src="/assets/creation-chevron-muted.png"/></view></picker><view class="soft"><view class="input-row"><text>屋顶面积</text><view class="input"><input type="digit" data-key="roofArea" value="{{form.roofArea}}" bindinput="input"/>㎡</view></view><button class="link" data-key="budgetChecked" bindtap="toggle">{{form.budgetChecked?'已人工核定。':'请人工核定屋顶面积'}}</button></view></view><text class="muted hint">按参数测算，仅供前期参考。</text><view class="page-actions"><button wx:if="{{saleWrite}}" class="btn bottom-inline" disabled="{{requirementsStatus!=='ready'||busy}}" bindtap="submit">开始测算</button></view>
   </block>
   <block wx:elif="{{view==='budget-result'}}">
    <block wx:if="{{platformMode&&budgetResult}}">
     <view class="card section budget-summary"><view class="heading"><text>建造参考预算</text><text class="badge green">已保存</text></view><view class="budget-total">¥ {{budgetResult.totalText}}</view><text class="muted centered">主体 + 外装 · 服务端核算</text></view>
     <view class="card section"><view class="heading"><text>主体工程</text><text class="amount">¥ {{budgetResult.mainTotalText}}</text></view><view wx:for="{{budgetResult.mainRows}}" wx:key="index" class="budget-cost"><view><text>{{item.label}}</text></view><text>¥ {{item.money}}</text></view></view>
     <view class="card section"><view class="heading"><text>外装工程</text><text class="amount">¥ {{budgetResult.decorTotalText}}</text></view><view wx:for="{{budgetResult.decorRows}}" wx:key="index" class="budget-cost"><view><text>{{item.label}}</text></view><text>¥ {{item.money}}</text></view></view>
     <view class="card section"><view class="heading">计价说明</view><text class="muted">分项核算 · 价格版本 {{budgetResult.priceVersion}}。</text></view>
     <view class="budget-action-bar"><button class="outline btn" bindtap="budgetShowForm">调整参数</button><button class="btn primary-action quote-export-entry" data-quote-id="{{budgetResult.quoteId}}" bindtap="exportPlatformQuote">导出参考预算图片 / PDF</button></view>
     <button wx:if="{{saleWrite&&!budgetResult.stale}}" class="btn workflow-nav" data-view="commission" bindtap="go">发起设计委托 / 查看进度</button>
    </block>
    <block wx:elif="{{platformMode}}">
     <view class="card empty">请先完成报价测算<button class="outline btn" bindtap="budgetShowForm">返回参数</button></view>
    </block>
   </block>
   <block wx:elif="{{view==='transfer'}}">
    <text class="muted role-note">当前身份：{{role}}</text>
    <block>
     <view class="card transfer-customer"><view class="heading">客户信息</view><view class="banner-main"><view class="initial">{{customerInitial}}</view><view class="banner-info"><view class="name"><text class="customer-name">{{customer.name}}</text> </view><view class="banner-line"><image src="/pages/workflow/assets/biz-phone.jpg"/>{{phone}}</view><view class="banner-line"><image src="/pages/workflow/assets/biz-location.jpg"/>{{projectSummary}}</view></view></view></view>
     <view class="card"><view class="heading">当前负责人</view><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{customer.ownerDisplay||'负责人待核'}}<text wx:if="{{customer.ownerRoleName}}" class="muted"> · {{customer.ownerRoleName}}</text></text></view></view><view class="card"><view class="heading">新负责人</view><picker disabled="{{busy||customerRetry}}" range="{{ownerOptions}}" value="{{form.newOwnerIndex}}" bindchange="pickTransferOwner"><view class="row outlined"><image class="round-icon" src="/assets/person-filled.png"/><text class="row-title">{{form.newOwner}} · <text class="muted">业务员</text></text><image class="down" src="/assets/creation-down.png"/></view></picker></view>
     <view class="card"><view class="heading">转交原因</view><textarea class="textarea" disabled="{{busy||customerRetry}}" data-key="transferReason" value="{{form.transferReason}}" bindinput="input" maxlength="200"/></view>
     <view class="card tinted preserve"><view class="heading">一并保留</view><view wx:for="{{['原始来源与历史作者','合同、款项与设计成果','未完成跟进事项']}}" wx:key="*this" class="condition"><image src="/pages/workflow/assets/biz-success.jpg"/>{{item}}</view></view><text class="muted hint">确认后新负责人立即生效，无需接收审批。</text><view class="page-actions"><button class="btn bottom-inline" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{customerRetry?'重试确认':'确认转交'}}</button></view>
    </block>
   </block>
   <block wx:elif="{{view==='requirement'}}">
    <text class="muted role-note">当前身份：{{role}}</text>
    <view class="card"><view class="heading">建筑信息</view><view class="soft"><view class="input-row"><text>建筑面宽</text><view class="input"><input type="digit" data-key="width" value="{{form.width}}" bindinput="input"/><text>m</text></view></view><view class="input-row"><text>建筑进深</text><view class="input"><input type="digit" data-key="depth" value="{{form.depth}}" bindinput="input"/><text>m</text></view></view><view class="input-row"><text>建筑层数</text><view class="input"><input type="number" data-key="floors" value="{{form.floors}}" bindinput="input"/><text>层</text></view></view><view class="input-row"><text>风格</text><picker range="{{requirementStyles}}" data-key="style" data-options="requirementStyles" bindchange="pick"><view class="input">{{form.style}}<image class="down" src="/assets/creation-down.png"/></view></picker></view></view></view>
    <view class="card"><view class="heading">需求与备注</view><textarea class="textarea" data-key="prompt" value="{{form.prompt}}" bindinput="input" placeholder="补充说明（选填）"/><textarea class="textarea" data-key="note" value="{{form.note}}" bindinput="input" placeholder="内部备注（选填）"/></view>
    <text class="muted hint">再次登记将生成新版本。</text>
    <view class="page-actions"><button wx:if="{{saleWrite}}" class="btn bottom-inline" disabled="{{requirementsStatus!=='ready'||busy}}" bindtap="submit">登记需求</button></view>
   </block>
   <block wx:elif="{{view==='contract'}}">
    <view wx:if="{{saleWrite}}" class="card page-actions"><button class="outline btn" bindtap="openPaymentDraft">付款草案</button></view>
    <text class="muted role-note">当前身份：{{role}}</text>
    <view class="card"><view class="heading">报价记录</view><view wx:if="{{quotesError}}" class="soft"><text class="muted">{{quotesError}}</text><button class="link" bindtap="customerTab" data-index="0">重试</button></view><view wx:elif="{{!salesQuotes.length}}" class="soft"><text class="muted">暂无报价，可根据外部报价填写合同</text></view><view wx:for="{{salesQuotes}}" wx:key="id" class="soft follow-record"><view class="flex"><text class="row-title">{{item.priceVersion}}</text><text class="amount">¥ {{item.totalText}}</text></view><text class="muted">{{item.date}}</text><button class="link" data-quote-id="{{item.id}}" bindtap="exportPlatformQuote">导出</button><button wx:if="{{saleWrite&&requirementsStatus==='ready'&&!contractsHasActive}}" class="link" disabled="{{busy}}" data-quote-id="{{item.id}}" bindtap="useContractQuote">用这份报价</button></view></view>
    <block wx:if="{{salesContracts&&salesContracts.length}}">
     <view wx:for="{{salesContracts}}" wx:key="id" class="card">
      <view class="heading"><text>合同</text><text class="badge {{item.status==='SIGNED'?'green':''}}">{{item.statusText}}</text></view>
      <view class="soft"><view class="kv"><text class="label">合同总额</text><text>¥ {{item.totalText}}</text></view><view wx:if="{{item.signedDate}}" class="kv"><text class="label">签订日期</text><text>{{item.signedDate}}</text></view></view>
      <view class="page-actions"><button class="link" data-id="{{item.id}}" bindtap="openPaymentPlan">付款计划与变更记录 ›</button></view><view class="sales-contract-stages"><view wx:for="{{item.stages}}" wx:for-item="stageRow" wx:key="id" class="sales-contract-stage"><view class="sales-stage-heading"><view><text>{{stageRow.stageText}}</text><text class="sales-stage-status">{{stageRow.statusText}}</text></view><button wx:if="{{canCollect&&stageRow.owing&&item.status==='SIGNED'}}" class="link sales-stage-action" data-stage-id="{{stageRow.id}}" bindtap="platCollect">办理回款</button></view><view class="sales-stage-amounts"><text>应收 ¥{{stageRow.amountText}}</text><text>已收 ¥{{stageRow.collectedText||'0.00'}}</text><text wx:if="{{stageRow.owing}}">待收 ¥{{stageRow.balanceText}}</text></view></view></view>
      <view wx:for="{{item.declarations}}" wx:for-item="declaration" wx:key="id" class="sales-declaration"><view class="sales-declaration-heading"><text>{{declaration.status==='RETURNED'?'收款资料待补充':'待财务核实'}}</text><text>¥ {{declaration.amountText}}</text></view><text class="muted">{{declaration.date}}</text><text wx:if="{{declaration.reason}}" class="error">{{declaration.reason}}</text><button wx:if="{{declaration.status==='RETURNED'&&canCollect}}" class="link" data-stage-id="{{declaration.stageId}}" data-declaration-id="{{declaration.id}}" bindtap="platCollect">补充后重新提交</button></view>
      <text wx:if="{{item.stages.length&&item.status==='SIGNED'&&!canCollect}}" class="muted hint">回款由业务负责人办理。</text>
      <view class="page-actions"><button wx:if="{{item.status==='WAIT_SIGN'&&saleWrite}}" class="btn bottom-inline" data-id="{{item.id}}" bindtap="platformContractSign">签订合同</button><button wx:if="{{item.status!=='WAIT_SIGN'}}" class="outline btn bottom-inline" data-id="{{item.id}}" bindtap="openContractEvidence">{{item.status==='SIGNED'?'查看／补录合同凭证':'查看合同凭证'}}</button><button wx:if="{{item.status!=='VOIDED'&&saleWrite}}" class="outline btn bottom-inline" data-id="{{item.id}}" bindtap="platformContractVoid">作废</button></view>
     </view>
    </block>
    <view wx:if="{{saleWrite&&requirementsStatus==='ready'&&!contractsHasActive}}" class="page-actions"><button class="outline btn bottom-inline" bindtap="openContractForm">新建合同</button></view>
    <text wx:if="{{contractError}}" class="error">{{contractError}}</text>
   </block>
   <block wx:elif="{{view==='delivery'}}">
    <text class="muted role-note">当前身份：{{role}}</text>
    <view wx:if="{{noSignedContract}}" class="card empty">该客户尚无已签订合同，请先完成签约。</view>
    <block wx:else>
     <view wx:if="{{noDelivery}}" class="card empty">尚未创建交付记录。<button wx:if="{{saleWrite}}" class="outline btn" bindtap="platformCreateDelivery">创建交付</button></view>
     <block wx:elif="{{delivery}}">
      <view class="card"><view class="heading">交付进度（登记即事实，按顺序推进）</view><view class="flow-steps journey-steps"><view wx:for="{{delivery.nodes}}" wx:key="key" class="flow-step {{item.done?'done':index===delivery.nextIndex?'current':''}}"><text class="flow-step-index">{{item.done?'✓':index+1}}</text><text>{{item.label}}{{item.atText?' · '+item.atText:''}}</text></view></view></view>
      <view wx:if="{{saleWrite&&delivery.nextIndex<4}}" class="page-actions"><button class="btn bottom-inline" data-node="{{delivery.nodes[delivery.nextIndex].key}}" bindtap="platformAdvanceDelivery">登记{{delivery.nodes[delivery.nextIndex].label}}</button></view>
      <view wx:if="{{delivery.allDone}}" class="card tinted preserve"><view class="heading">交付已完成</view><text class="muted">四节点已全部登记。</text></view>
     </block>
     <text wx:if="{{deliveryError}}" class="error">{{deliveryError}}</text>
    </block>
   </block>
  </block>
  </block><text wx:if="{{error}}" class="error" role="alert">{{error}}</text>
 </view>
</view>
 <view wx:if="{{modal&&modal!=='collect'}}" style="bottom:{{keyboardInset||0}}px" class="overlay business-surface" catchtap="closeModal"><view class="sheet sheet-{{modal}} keyboard-sheet" style="height:{{sheetHeight}}px" catchtap="noop"><view class="sheet-head"><text>{{modal==='register'?'登记客户':'编辑客户'}}</text><button class="close" bindtap="closeModal" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view>
 <scroll-view class="sheet-fields" scroll-y enhanced scroll-top="{{sheetScrollTop}}" bindscroll="sheetScrolled" scroll-into-view="{{sheetFocusTarget}}" scroll-with-animation="{{false}}">
 <block wx:if="{{modal==='register'||modal==='edit'}}">
  <view class="input-row" id="customer-name-field"><text class="label">客户姓名</text><view class="input flex"><input class="business-input" data-key="name" data-field="customer-name-field" value="{{form.name}}" placeholder="请输入客户姓名" maxlength="64" disabled="{{busy||customerRetry}}" adjust-position="{{false}}" cursor-spacing="24" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view></view>
  <view class="input-row" id="customer-phone-field"><text class="label">手机号</text><view class="input flex"><input type="number" class="business-input" data-key="phone" data-field="customer-phone-field" value="{{form.phone}}" placeholder="请输入11位手机号" maxlength="11" disabled="{{busy||customerRetry||modal==='edit'}}" adjust-position="{{false}}" cursor-spacing="24" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view></view>
  <view wx:if="{{modal==='edit'}}" class="input-row" id="customer-wechat-field"><text class="label">微信号（选填）</text><view class="input flex"><input class="business-input" data-key="wechat" data-field="customer-wechat-field" value="{{form.wechat}}" placeholder="请输入微信号" maxlength="64" disabled="{{busy||customerRetry}}" adjust-position="{{false}}" cursor-spacing="24" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view></view>
  <text wx:if="{{modal==='edit'}}" class="muted contact-hint">手机号不可修改</text>
  <text class="field-label">地址</text>
  <view id="customer-address-field"><customer-address id="customer-address" value="{{form}}" disabled="{{busy||customerRetry}}" bindchange="customerAddressChanged" bindfieldfocus="formFieldFocus" bindfieldblur="formFieldBlur"/></view>
  <view class="input-row" id="customer-address-detail-field"><text class="label">详细地址（选填）</text><view class="input flex"><input class="business-input" data-key="addressDetail" data-field="customer-address-detail-field" value="{{form.addressDetail}}" placeholder="组、门牌号或建房位置" maxlength="200" disabled="{{busy||customerRetry}}" adjust-position="{{false}}" cursor-spacing="24" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view></view>
  <view class="input-row"><text class="label">来源</text><picker wx:if="{{modal==='register'}}" class="flex" range="{{sourceOptions}}" data-key="source" data-options="sourceOptions" disabled="{{busy||customerRetry}}" bindchange="pick"><view class="input">{{form.source||'请选择客户来源'}}<image class="down" src="/assets/creation-down.png"/></view></picker><text wx:else class="flex">{{form.source}}</text></view>
  <view id="customer-summary-field"><text class="field-label">需求摘要</text><textarea class="textarea" data-key="summary" data-field="customer-summary-field" value="{{form.summary}}" placeholder="请填写建房需求（500字以内）" maxlength="500" disabled="{{busy||customerRetry}}" adjust-position="{{false}}" cursor-spacing="24" show-confirm-bar="{{false}}" bindfocus="formFieldFocus" bindblur="formFieldBlur" bindinput="input"/></view>
 </block>
 </scroll-view><view class="sheet-actions"><text wx:if="{{error}}" class="error" role="alert">{{error}}</text><button loading="{{busy}}" disabled="{{busy}}" class="btn sheet-save" bindtap="saveModal">{{customerRetry==='view'?'重试查看':customerRetry==='confirm'?'重试确认':'保存客户'}}</button></view>
</view></view>
<view wx:if="{{modal==='collect'}}" class="overlay business-surface" catchtap="closeModal"><view class="sheet sheet-collect" catchtap="noop"><view class="sheet-head"><text>办理回款</text><button class="close" bindtap="closeModal" aria-label="关闭"><image src="/pages/workflow/assets/biz-close.jpg"/></button></view><view wx:if="{{collectStageText}}" class="soft"><text class="muted">{{collectStageText}}</text></view><view class="input-row"><text class="label">本次金额</text><view class="input flex"><input type="digit" class="business-input" data-key="amount" value="{{collectForm.amount}}" placeholder="本次回款金额（元）" bindinput="platCollectInput"/></view></view><view class="input-row"><text class="label">收款方式</text><picker class="flex" range="{{['银行转账','现金']}}" value="{{collectForm.method==='cash'?1:0}}" bindchange="platCollectPick"><view class="input">{{collectForm.method==='cash'?'现金':'银行转账'}}<image class="down" src="/assets/creation-down.png"/></view></picker></view><view class="input-row"><text class="label">收款账户（选填）</text><view class="input flex"><input class="business-input" data-key="accountName" maxlength="100" value="{{collectForm.accountName}}" placeholder="公司收款账户名称" bindinput="platCollectInput"/></view></view><view class="input-row"><text class="label">流水号{{collectForm.method==='bank'?'':'（选填）'}}</text><view class="input flex"><input class="business-input" data-key="transactionNo" value="{{collectForm.transactionNo}}" placeholder="请输入银行流水号" bindinput="platCollectInput"/></view></view><view class="input-row"><text class="label">到账日期</text><view class="input flex"><input class="business-input" data-key="receivedDate" value="{{collectForm.receivedDate}}" placeholder="YYYY-MM-DD（不晚于今天）" bindinput="platCollectInput"/></view></view><text wx:if="{{error}}" class="error">{{error}}</text><view class="page-actions"><button class="btn bottom-inline" loading="{{busy}}" disabled="{{busy}}" bindtap="platCollectSubmit">确认办理回款</button></view></view></view>
