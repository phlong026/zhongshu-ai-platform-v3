<wxs src="../../utils/tone.wxs" module="st"/>
<import src="./budget-result.wxml"/>
<wxs src="./format.wxs" module="fmt"></wxs>
<view class="workflow {{designFlow?'design-flow':''}} view-{{view}} {{view==='customer'||view==='arrival'?'customer-workspace':''}} {{caseTab?'has-plan':''}} {{extended?'extended':''}}">
 <business-header id="workflow-header" title="{{title}}" design-flow="{{designFlow}}"/>
 <view wx:if="{{!customer&&view!=='customers'}}" class="body"><view class="card empty"><block wx:if="{{platformStatus==='loading'}}">正在加载客户资料…</block><block wx:elif="{{platformStatus==='degraded'}}">{{platformError||error}}</block><block wx:else>{{error||'客户资料暂不可用'}}</block><view class="page-actions"><button wx:if="{{platformStatus==='degraded'}}" class="outline btn" bindtap="retryPlatform">重试</button><button class="btn workflow-nav" data-view="customers" bindtap="go">返回客户列表</button></view></view></view>
 <view wx:else class="body">
  <view wx:if="{{blocked}}" class="card empty"><text>{{blocked.message}}</text><view class="page-actions"><button class="btn workflow-nav" data-view="{{blocked.target}}" bindtap="go">{{blocked.label}}</button></view></view><block wx:else>
  <block wx:if="{{view==='customers'}}">
   <view class="search"><image src="/assets/search.png"/><input placeholder="搜索姓名、手机号" value="{{keyword}}" bindinput="searchCustomers"/></view>
   <view class="list-title"><text>{{selectingCustomer?'选择本次办理的客户':'我的客户'}}</text><button wx:if="{{canRegister}}" class="btn customer-register" data-modal="register" bindtap="modal">登记客户</button></view>
   <view class="tabs"><button wx:for="{{filters}}" wx:key="*this" class="{{filter===item?'active':''}}" data-value="{{item}}" bindtap="setFilter">{{item}}</button></view>
   <view wx:for="{{filteredCustomers}}" wx:key="id" class="card customer-list-row" data-id="{{item.id}}" bindtap="chooseCustomer"><view class="initial small">{{item.name[0]}}</view><view class="flex"><view class="name">{{item.name}} <text class="badge">{{item.status}}</text></view><text class="muted">{{item.phoneText || item.phone || item.wechat}} · {{item.city}}</text></view><image class="arrow" src="/assets/creation-chevron-muted.png"/></view>
   <view wx:if="{{platformMode&&platformStatus==='loading'}}" class="card empty">正在加载客户…</view>
   <view wx:elif="{{platformMode&&platformStatus==='degraded'}}" class="card empty">加载失败：{{platformError}}<button class="outline btn" bindtap="retryPlatform">重试</button></view>
   <view wx:elif="{{!filteredCustomers.length}}" class="card empty">暂无符合条件的客户</view>
  </block>
  <block wx:else>
   <view wx:if="{{role}}" class="operation-identity">办理身份：{{role}}</view>
   <view wx:if="{{view!=='transfer'}}" class="card customer-banner {{large?'large':'compact'}} {{compactProject?'project-compact':''}} {{view==='result'||view==='facade-result'?'result-banner':''}}">
    <view class="banner-main"><view class="initial {{large?'':'small'}}">{{customerInitial}}</view><view class="banner-info"><view class="name"><text class="customer-name">{{customer.name}}</text><text wx:if="{{view==='budget'}}" class="budget-city">· {{city}}</text><text wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="badge {{st.tone(customer.status)}}">{{customer.status}}</text></view>
     <view wx:if="{{view==='customer'||view==='arrival'||view==='progress'}}" class="banner-line"><image src="/pages/workflow/assets/biz-phone.jpg"/>{{phone || customer.wechat}}</view>
     <view wx:if="{{view!=='budget'}}" class="banner-line">{{projectSummary}}</view>
     <text wx:if="{{view==='budget'||view==='budget-result'}}" class="muted">{{currentPlan?'平面方案 v'+currentPlan.version:currentFacade?'立面方案 v'+currentFacade.version:'未关联方案'}}</text>
    </view><text wx:if="{{badge}}" class="badge banner-badge {{st.tone(badge)}}">{{badge}}</text></view>
    <block wx:if="{{view==='result'||view==='facade-result'}}"><view class="result-name">{{view==='result'?'平面':'立面'}}方案 V{{view==='result'?(currentPlan?currentPlan.version:1):(currentFacade?currentFacade.version:1)}} <text class="badge green">已选用</text></view><text class="muted">方案版本已保存</text></block>
    <view wx:if="{{headerItems}}" class="soft"><view wx:for="{{headerItems}}" wx:key="label" class="kv"><text class="label">{{item.label}}</text><text>{{item.value}}</text></view></view>
   </view>
   <view wx:if="{{(view==='requirement'||view==='budget'||view==='contract')&&requirementsStatus==='loading'}}" class="card empty">正在加载历史需求…</view>
   <view wx:elif="{{(view==='requirement'||view==='budget'||view==='contract')&&requirementsStatus==='error'}}" class="card empty">{{requirementsError}}<button class="outline btn" bindtap="retryRequirements">重试加载需求</button></view>
   <view wx:elif="{{(view==='requirement'||view==='budget'||view==='contract')&&requirementsStatus==='blocked'}}" class="card empty">{{requirementsError}}</view>
   <view wx:if="{{taskSummary}}" class="card task-summary"><view><text class="task-label">当前事项</text><text class="task-state">{{taskSummary.state}}</text></view><text class="muted">当前责任：{{taskSummary.owner}}</text></view>
   <view wx:if="{{(view==='customer'||view==='arrival'||view==='progress')&&!platformMode}}" class="tabs customer-tabs"><button wx:for="{{customerTabs}}" wx:key="*this" class="{{activeCustomerTab===index?'active':''}}" data-index="{{index}}" bindtap="customerTab">{{item}}</button></view>
   <view wx:elif="{{platformMode&&view==='customer'}}" class="tabs customer-tabs"><button wx:for="{{customerTabs}}" wx:key="*this" class="{{activeCustomerTab===index?'active':''}}" data-index="{{index}}" bindtap="customerTab">{{item}}</button></view>

   <block wx:if="{{view==='customer'||view==='arrival'}}">
    <view wx:if="{{activeCustomerTab===0}}" class="card"><view class="heading"><text>客户资料</text><button wx:if="{{canEditCustomer}}" class="link" data-modal="edit" bindtap="modal">编辑 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view class="soft"><view class="kv"><text class="label">来源</text><text>{{customer.source}}</text><text wx:if="{{!platformMode}}" class="label owner">负责人</text><text wx:if="{{!platformMode}}">{{customer.owner||'我'}}</text></view><block wx:if="{{showSizeBlock}}"><text class="muted">确认建房需求</text><view class="kv"><text class="label">建筑外轮廓</text><text>面宽 {{customer.width}}米 × 进深 {{customer.depth}}米</text></view><view class="kv"><text class="label">计划层数</text><text>{{customer.floors}}层</text></view></block><view wx:if="{{customer.address}}" class="kv summary"><text class="label">地址</text><text class="flex customer-address-text">{{customer.address}}</text></view><view class="kv summary"><text class="label">{{platformMode||customer.status==='已到店'?'需求摘要':'需求'}}</text><text class="flex">{{customer.summary}}</text></view></view></view>
    <view wx:if="{{activeCustomerTab===0 && contentSources.length}}" class="card content-source-card"><view class="heading">视频咨询来源</view><view wx:for="{{contentSources}}" wx:key="leadId" class="soft content-source-row"><view class="flex"><text class="row-title">{{item.title||'已发布视频'}}</text><text class="muted">{{item.createTime}}</text><text class="muted">{{item.need}}</text><text class="muted">咨询状态：{{item.status}}</text></view><button class="link" data-publication-id="{{item.publicationId}}" bindtap="openContentSource">查看来源视频 <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view></view>
    <view wx:if="{{activeCustomerTab===1}}" class="card follow-card"><view class="heading"><text>沟通记录</text></view><view wx:if="{{!customer.follows.length}}" class="follow-empty"><image src="/pages/workflow/assets/biz-empty-follow.jpg"/><text class="empty-title">暂无跟进记录</text><text class="muted">记录首次沟通，完善客户需求。</text></view><view wx:for="{{customer.follows}}" wx:key="index" class="soft follow-record"><image src="/pages/workflow/assets/biz-record.jpg"/><view class="flex"><text class="row-title">{{item.method?(item.method==='到店'?'到店沟通已完成':item.method+'沟通'):(item.kind==='api'?'跟进记录':'咨询登记')}} <text class="badge">{{item.result}}</text></text><text class="muted">{{item.date}} {{item.appointment}}</text><text class="muted">{{item.content||item.note}}</text></view></view></view>
    <view wx:if="{{activeCustomerTab===1&&((platformMode&&canDesign&&saleWrite)||(!platformMode&&simpleBusiness))}}" class="card design-tools"><view class="heading">业务办理</view><view class="tool-grid"><button class="workflow-nav" data-tool="inspiration" bindtap="openDesignTool"><image src="/pages/workflow/assets/biz-book.jpg"/><text>灵感检索</text></button><button class="workflow-nav" data-tool="ai" bindtap="openDesignTool"><image src="/pages/workflow/assets/biz-document.jpg"/><text>AI设计</text></button><button class="workflow-nav" data-tool="budget" bindtap="openDesignTool"><image src="/pages/workflow/assets/biz-calculator.jpg"/><text>快速预算</text></button><button class="workflow-nav" data-tool="commission" bindtap="openDesignTool"><image src="/pages/workflow/assets/biz-house.jpg"/><text>委托设计</text></button></view></view>
    <view wx:if="{{platformMode&&schemesList&&schemesList.length}}" class="card"><view class="heading">方案版本</view><view wx:for="{{schemesList}}" wx:key="id" class="soft follow-record"><view class="flex"><text class="row-title">{{item.kindText}} V{{item.version}} <text wx:if="{{item.formal}}" class="badge green">正式</text></text><text class="muted">{{item.date}}</text></view><button wx:if="{{saleWrite&&!item.formal}}" class="link" data-scheme-id="{{item.id}}" bindtap="platformPromote">转正式</button></view></view>
    <view wx:if="{{platformMode&&isBossView}}" class="page-actions customer-follow-actions"><button class="outline btn bottom-inline workflow-nav" data-view="transfer" bindtap="go">责任转交</button></view><view wx:if="{{canFollow}}" class="page-actions customer-follow-actions"><button class="btn bottom-inline" data-modal="follow" bindtap="modal">{{customer.follows.length?'记录跟进':'记录首次跟进'}}</button></view><view wx:elif="{{hasDesign}}" class="page-actions customer-follow-actions"><button class="btn bottom-inline workflow-nav" data-view="delivery" bindtap="go">继续项目办理</button></view>
   </block>
   <block wx:elif="{{view==='progress'}}">
    <view wx:if="{{!platformMode||stages.length||progressInfo}}" class="card"><view class="heading">当前阶段</view><view class="flow-steps journey-steps"><view wx:for="{{stages}}" wx:key="*this" class="flow-step {{stageIndex>index?'done':index===stageIndex?'current':''}}"><text class="flow-step-index">{{stageIndex>index?'✓':index+1}}</text><text>{{item}}</text></view></view><view class="soft progress-now"><text class="row-title">{{progressInfo.title}}</text><text wx:if="{{progressInfo.owner||progressInfo.next}}" class="muted">{{progressInfo.owner?'负责人：'+progressInfo.owner:''}}{{progressInfo.owner&&progressInfo.next?' · ':''}}{{progressInfo.next?'下一步：'+progressInfo.next:''}}</text></view></view>
    <view wx:if="{{progressInfo}}" class="card"><view class="heading"><text>最新进展</text><button class="link" bindtap="toggleProgressRecords">{{showAllProgressRecords?'收起记录':'全部记录'}} <image class="arrow" src="/assets/creation-chevron-muted.png"/></button></view><view wx:if="{{progressInfo.latest}}" class="soft follow-record"><image src="{{progressInfo.latest.image||'/pages/workflow/assets/biz-record.jpg'}}" mode="aspectFill"/><view class="flex"><text class="row-title">{{progressInfo.latest.text}}</text><text class="muted">{{progressInfo.latest.date}}{{progressInfo.latest.by?' · '+progressInfo.latest.by:''}}</text></view></view><view wx:else class="soft"><text class="muted">暂无项目办理记录</text></view></view>
    <view wx:if="{{showAllProgressRecords}}" class="card"><view class="heading"><text>全流程记录</text><text class="muted">{{progressInfo.records.length}}条</text></view><view wx:for="{{visibleProgressRecords}}" wx:key="key" class="soft follow-record"><image src="{{item.image||'/pages/workflow/assets/biz-record.jpg'}}" mode="aspectFill"/><view class="flex"><text class="row-title">{{item.text}} <text class="badge neutral">{{item.badge}}</text></text><text class="muted">{{item.date}}{{item.by?' · '+item.by:''}}</text></view></view><button wx:if="{{visibleProgressRecords.length<progressInfo.records.length}}" class="outline btn" bindtap="loadMoreProgressRecords">加载更多记录</button><view wx:if="{{!progressInfo.records.length}}" class="soft"><text class="muted">暂无项目办理记录</text></view></view>
    <block wx:if="{{platformMode}}">
     <view wx:if="{{progressErr}}" class="card empty">{{progressErr}}<button class="outline btn" bindtap="customerTab" data-index="2">重试</button></view>
     <view class="card"><view class="heading">需求登记</view><view wx:if="{{!progressRequirements.length}}" class="soft"><text class="muted">暂无需求登记</text></view><view wx:for="{{progressRequirements}}" wx:key="id" class="soft follow-record"><view class="flex"><text class="row-title">V{{item.version}} {{item.style}}</text><text class="muted">{{item.sizeText}}</text></view><text class="muted">{{item.date}}</text></view></view>
     <view class="card"><view class="heading">报价记录</view><view wx:if="{{!progressQuotes.length}}" class="soft"><text class="muted">暂无报价</text></view><view wx:for="{{progressQuotes}}" wx:key="id" class="soft follow-record"><view class="flex"><text class="row-title">{{item.priceVersion}}</text><text class="amount">¥ {{item.totalText}}</text></view><text class="muted">{{item.date}}</text></view></view>
     <view class="card"><view class="heading">合同与回款</view><view wx:if="{{!progressContracts.length}}" class="soft"><text class="muted">暂无合同</text></view><view wx:for="{{progressContracts}}" wx:key="id" class="soft follow-record progress-contract-card"><view class="flex"><text class="row-title">合同 <text class="badge {{item.status==='SIGNED'?'green':''}}">{{item.statusText}}</text></text><text class="amount">¥ {{item.totalText}}</text></view><view wx:for="{{item.stages}}" wx:for-item="stageRow" wx:key="id" class="flex"><text class="muted">{{stageRow.stageText}} {{stageRow.statusText}}</text><text class="amount">¥ {{stageRow.amountText}}</text></view></view></view>
     <view class="card"><view class="heading">交付进度</view><view wx:if="{{!progressDelivery}}" class="soft"><text class="muted">尚未创建交付</text></view><view wx:else class="flow-steps journey-steps"><view wx:for="{{progressDelivery.nodes}}" wx:key="key" class="flow-step {{item.done?'done':index===progressDelivery.nextIndex?'current':''}}"><text class="flow-step-index">{{item.done?'✓':index+1}}</text><text>{{item.label}}{{item.atText?' '+item.atText:''}}</text></view></view></view>
    </block>
    <block wx:else>
    <view class="card"><view class="heading">方案与资料</view><button class="soft archive-row workflow-nav" data-view="result" bindtap="go"><image class="thumb" src="/pages/workflow/assets/biz-formal-plan.jpg"/><view class="flex"><text class="row-title">平面方案 v{{currentPlan?currentPlan.version:1}} <text class="badge neutral">{{currentPlan?'已归档':'未保存'}}</text></text><text class="muted">{{customer.width}}m × {{customer.depth}}m · {{customer.floors}}层</text></view><text class="link">查看方案</text><image class="arrow" src="/assets/creation-chevron.png"/></button><button class="soft archive-row workflow-nav" data-view="budget-result" bindtap="go"><image class="round-icon" src="/pages/workflow/assets/biz-calculator.jpg"/><view class="flex"><text class="row-title">参考预算 版本{{currentBudget?currentBudget.version:1}}</text><text class="amount">{{currentBudget?'¥ '+fmt.money(currentBudget.total):'暂无预算'}}</text><text class="muted">关联平面方案 v{{currentPlan?currentPlan.version:1}}</text></view><text class="link">查看预算</text><image class="arrow" src="/assets/creation-chevron.png"/></button><button wx:if="{{hasDesign}}" class="soft archive-row workflow-nav" data-view="delivery" bindtap="go"><image class="round-icon" src="/pages/workflow/assets/biz-money.jpg"/><view class="flex"><text class="row-title">委托与交付记录</text><text class="muted">{{coordination.state}}</text></view><text class="link">查看</text><image class="arrow" src="/assets/creation-chevron.png"/></button></view>
    </block>
   </block>
   <block wx:elif="{{view==='inspiration'||view==='search'}}">
    <view wx:if="{{view==='inspiration'}}" class="search"><image src="/assets/search.png"/><input placeholder="输入案例编号或名称" bindinput="searchCases"/></view>
    <view class="card dimension-card"><view class="dimension-row"><text>面宽</text><view class="input"><input data-key="width" value="{{form.width}}" bindinput="input" type="digit"/><text>m</text></view><text>进深</text><view class="input"><input data-key="depth" value="{{form.depth}}" bindinput="input" type="digit"/><text>m</text></view></view><text class="muted hint">{{view==='search'?'按建筑外轮廓检索':'建筑尺寸3–40m，支持一位小数'}}</text><view wx:if="{{view==='inspiration'}}" class="dimension-row style-row"><text>风格</text><picker range="{{styleOptions}}" data-key="filterStyle" data-options="styleOptions" bindchange="pick"><view class="input">{{form.filterStyle||'全部风格'}}<image class="down" src="/assets/creation-down.png"/></view></picker><text>层数</text><picker range="{{floorOptions}}" data-key="floorFilter" data-options="floorOptions" bindchange="pick"><view class="input">{{form.floorFilter||'全部层数'}}<image class="down" src="/assets/creation-down.png"/></view></picker></view></view>
    <block wx:if="{{view==='search'}}"><button class="btn search-btn" bindtap="applySearch">检索平面方案</button><text class="muted hint outside">匹配范围±1m，最多50套，按尺寸差排序。</text></block>
    <view class="heading outside"><text>{{view==='search'?'匹配结果':'案例推荐'}}</text><text wx:if="{{view==='search'}}" class="muted">{{filteredCases.length}}套</text></view><view class="case-grid"><button wx:for="{{filteredCases}}" wx:key="id" class="case-card" data-id="{{item.id}}" bindtap="openCase"><image class="case-photo" src="{{item.image}}" mode="aspectFill"/><view class="case-copy"><text class="row-title">{{item.name}}</text><text class="muted">{{view==='search'?item.id:'编号 '+item.id+'　|　'+item.area+'㎡ · '+item.floors+'层'}}</text><text wx:if="{{view==='search'}}" class="muted">面宽 {{item.width}}m · 进深 {{item.depth}}m</text></view></button></view><view wx:if="{{!filteredCases.length}}" class="card empty">无匹配方案，请调整筛选条件。</view>
   </block>
   <block wx:elif="{{view==='case'||view==='case-plan'}}">
    <view class="card case-detail {{caseTab?'plan-visible':''}}"><image class="hero" src="{{selectedCase.id==='ZS001'?(caseTab?'/pages/workflow/assets/biz-case-plan-hero.jpg':'/pages/workflow/assets/biz-case-hero.jpg'):selectedCase.image}}" mode="aspectFill" data-src="{{selectedCase.image}}" bindtap="previewImage"/><view class="case-detail-copy"><view class="case-name"><text>{{selectedCase.name}}</text><button class="link" bindtap="favorite"><image src="/pages/workflow/assets/biz-heart.jpg"/>{{favorite?'已收藏':'收藏'}}</button></view><text class="muted">编号 {{selectedCase.id}} · V1 · 方案灵感</text><view class="stats"><view wx:for="{{[{label:'建筑面积',value:selectedCase.area+'㎡'},{label:'层数',value:selectedCase.floors+'层'},{label:'面宽',value:selectedCase.width+'m'},{label:'进深',value:selectedCase.depth+'m'}]}}" wx:key="label"><text class="muted">{{item.label}}</text><text class="stat-value copper">{{item.value}}</text></view></view></view></view><view class="tabs line-tabs"><button wx:for="{{caseTabs}}" wx:key="*this" data-index="{{index}}" bindtap="caseTab" class="{{caseTab===index?'active':''}}">{{item}}</button></view><image class="case-plan-picture" wx:if="{{caseTab&&!casePlanUnavailable}}" src="{{selectedCase.floorPlans[caseTab-1].image}}" mode="widthFix"/><view wx:elif="{{casePlanUnavailable}}" class="card empty">该案例尚未提供平面资料，请选择已有平面图的案例。<button class="outline btn workflow-nav" data-view="inspiration" bindtap="go">返回方案参考</button></view><image wx:else class="case-second" src="{{selectedCase.id==='ZS001'?(caseTab?'/pages/workflow/assets/biz-case-plan-hero.jpg':'/pages/workflow/assets/biz-case-hero.jpg'):selectedCase.image}}" mode="aspectFill"/><text class="muted centered">{{caseTab?'方案示意，非施工图。用整套案例作为设计参考。':'案例图片仅供方案参考'}}</text>
    <view class="footer page-actions"><button wx:if="{{!caseTab}}" class="outline btn workflow-nav" data-view="ai-facade" bindtap="go">AI立面设计</button><button class="btn workflow-nav" data-view="{{caseTab?'ai-config':'search'}}" bindtap="go">{{caseTab?'平面方案':'户型检索'}}</button></view>
   </block>
   <block wx:elif="{{view==='ai-config'||view==='ai-facade'||view==='ai-results'}}">
    <view class="tabs"><button class="{{view!=='ai-facade'?'active':''}} workflow-nav" data-view="ai-config" bindtap="go">平面方案</button><button class="{{view==='ai-facade'?'active':''}} workflow-nav" data-view="ai-facade" bindtap="go">立面方案</button></view>
    <view class="card reference-row"><image src="{{referenceImage}}" mode="aspectFit"/><image wx:if="{{view==='ai-config'}}" src="/pages/workflow/assets/biz-plan-2.jpg" mode="aspectFit"/><view class="flex"><text class="row-title">{{view==='ai-results'?'参考方案':'已选参考'}} · {{referenceCase?referenceCase.name:'当前客户方案'}} <text class="badge">{{referenceCase?'V1':'示意'}}</text></text><text class="muted">{{form.floors}}层 · 面宽{{form.width}}m · 进深{{form.depth}}m</text><button class="soft-link workflow-nav" data-view="{{view==='ai-results'?'ai-config':'inspiration'}}" bindtap="go">{{view==='ai-results'?'调整参数':'更换参考'}} <image class="arrow" src="/assets/creation-chevron.png"/></button></view></view>
    <block wx:if="{{view!=='ai-results'}}">
     <view class="card"><view class="heading">尺寸与需求</view><view class="dimension-row"><text>面宽</text><view class="input"><input data-key="width" value="{{form.width}}" bindinput="input" type="digit"/><text>m</text></view><text>进深</text><view class="input"><input data-key="depth" value="{{form.depth}}" bindinput="input" type="digit"/><text>m</text></view></view><text class="muted hint">请核对尺寸口径。</text><view class="dimension-row"><text>建筑层数</text><view class="input"><input data-key="floors" value="{{form.floors}}" bindinput="input" type="number"/>层</view><text>入口朝向</text><picker range="{{orientationOptions}}" data-key="orientation" data-options="orientationOptions" bindchange="pick"><view class="input">{{form.orientation}}<image class="down" src="/assets/creation-down.png"/></view></picker></view></view>
     <view class="card"><view class="heading">家庭与房间需求</view><view class="chips"><button wx:for="{{requirements}}" wx:key="*this" class="chip" data-value="{{item}}" bindtap="requirement">{{item}} ×</button><button class="chip outline" bindtap="addRequirement">添加需求</button></view><view class="dimension-row"><text>院落布局</text><view class="input"><input data-key="courtyard" value="{{form.courtyard}}" bindinput="input"/></view><text>图纸类型</text><view class="input"><input data-key="drawingType" value="{{form.drawingType}}" bindinput="input"/></view></view></view>
     <view class="card"><view class="heading">补充要求</view><textarea class="textarea short" value="{{form.notes}}" data-key="notes" bindinput="input"/><button class="outline upload-small" data-key="sketchFile" bindtap="upload">上传草图（选填）</button></view>
