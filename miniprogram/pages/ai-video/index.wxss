@import '../../styles/creation.wxss';
.video-tabs { display: flex; border: 1rpx solid var(--creation-border); min-height: 44px; border-radius: 16rpx; overflow: hidden; margin-bottom: 24rpx; }
.video-tab { flex: 1; color: var(--creation-muted); font-size: 28rpx; padding: 16rpx 8rpx; display: flex; align-items: center; justify-content: center; min-height: 44px; }
.video-tab.active { background: var(--creation-soft); color: var(--creation-brand); font-weight: 600; }
.media-card, .description-card, .parameters-card { padding: 24rpx; margin-bottom: 24rpx; }
.frame-grid { display: flex; gap: 16rpx; margin-top: 16rpx; }
.frame-box { flex: 1; min-width: 0; height: 248rpx; background: var(--creation-bg); border: 1rpx dashed #c5b8a8; border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; }
.upload-plus { width: 56rpx; height: 56rpx; flex-shrink: 0; }
.frame-title { font-size: 28rpx; line-height: 44rpx; margin-top: 16rpx; }
.media-hint, .frame-footer { font-size: 24rpx; line-height: 36rpx; }
.frame-footer { display: block; text-align: center; margin-top: 16rpx; }
.frame-preview { width: 100%; height: 100%; }
.description-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.optimize-button { border: 1rpx solid var(--creation-border); border-radius: 16rpx; min-height: 44px; padding: 8rpx 16rpx; display: flex; align-items: center; gap: 8rpx; background: var(--creation-soft); font-size: 26rpx; }
.optimize-button image { width: 32rpx; height: 32rpx; }
.description-input { border: 1rpx solid var(--creation-border); border-radius: 16rpx; margin-top: 16rpx; }
.description-textarea { width: 100%; height: 240rpx; font-size: 28rpx; line-height: 44rpx; padding: 16rpx; }
.description-counter { display: block; text-align: right; font-size: 24rpx; line-height: 36rpx; margin-top: 8rpx; }
.parameter-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 16rpx; }
.parameter-label { display: block; font-size: 26rpx; line-height: 40rpx; margin-bottom: 8rpx; }
.parameter-select { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 16rpx; min-height: 44px; border: 1rpx solid var(--creation-border); border-radius: 16rpx; background: var(--creation-bg); font-size: 28rpx; gap: 8rpx; }
.parameter-select image { width: 24rpx; height: 20rpx; flex-shrink: 0; }
.generate-button { margin-top: 24rpx; }

.reference-upload { margin-top: 16rpx; min-height: 248rpx; padding: 24rpx 8rpx; border: 1rpx dashed #c5b8a8; border-radius: 16rpx; background: var(--creation-bg); display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; }
.library-button { border: 1rpx solid var(--creation-brand); border-radius: 16rpx; min-height: 44px; display: flex; align-items: center; justify-content: center; gap: 16rpx; font-size: 28rpx; margin-top: 16rpx; padding: 12rpx; width: 100%; }
.library-button image { width: 36rpx; height: 36rpx; }
.reference-limits { display: flex; align-items: center; font-size: 24rpx; line-height: 36rpx; margin-top: 8rpx; gap: 8rpx; }
.reference-limits text { flex: 1; }
.reference-limits button { min-width: 44px; min-height: 44px; display: flex; justify-content: center; align-items: center; }
.reference-limits image { width: 32rpx; height: 32rpx; }
.reference-items { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.reference-item { width: 144rpx; font-size: 24rpx; overflow-wrap: anywhere; }
.reference-item image { width: 144rpx; height: 96rpx; border-radius: 16rpx; }
.reference-item button { color: var(--creation-brand); font-size: 26rpx; min-height: 44px; width: 100%; }
