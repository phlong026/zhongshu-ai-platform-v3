<view class="creation-page video-page {{mode === 'reference' ? 'reference-mode' : ''}}">
  <creation-header id="creation-page-header" title="AI 视频" />
  <view class="creation-body video-body"><view wx:if="{{draftStatus}}" class="video-draft-status" bindtap="retryDraft">{{draftStatus}}</view><view wx:if="{{invalidMessage}}" class="creation-card creation-empty"><text>{{invalidMessage}}</text><view class="page-actions"><button class="studio-outline" bindtap="returnToTasks">返回任务中心</button></view></view><block wx:else><text wx:if="{{editingTaskId}}" class="creation-notice">正在编辑历史任务副本，当前草稿会保留。</text>
    <view class="video-tabs"><button class="video-tab {{mode === 'frames' ? 'active' : ''}}" data-mode="frames" bindtap="switchMode">文/图生视频</button><button class="video-tab {{mode === 'reference' ? 'active' : ''}}" data-mode="reference" bindtap="switchMode">参考生视频</button></view>
    <view class="creation-card media-card">
      <view class="creation-heading"><text class="creation-heading-title">{{mode === 'frames' ? '首尾帧' : '参考素材'}}</text></view>
      <block wx:if="{{mode === 'frames'}}">
        <view class="frame-grid"><button wx:for="{{['firstFrame', 'lastFrame']}}" wx:key="*this" class="frame-box" data-target="{{item}}" bindtap="chooseFrame" hover-class="pressed"><image wx:if="{{index === 0 ? firstFrame : lastFrame}}" class="frame-preview" src="{{index === 0 ? firstFrame : lastFrame}}" mode="aspectFill" /><block wx:else><image src="/assets/creation-plus.png" class="upload-plus" /><text class="frame-title">{{index === 0 ? '添加首帧' : '添加尾帧'}}</text><text class="media-hint creation-muted">选填</text></block></button></view>
        <text class="frame-footer creation-muted">从手机或素材库添加</text>
      </block>
      <block wx:else>
        <button class="reference-upload" bindtap="uploadReferences" hover-class="pressed"><image src="/assets/creation-plus.png" class="upload-plus" /><text class="frame-title">上传图片、视频或音频</text><text class="media-hint creation-muted">点击上传</text></button>
        <view wx:if="{{references.length}}" class="reference-items"><view wx:for="{{references}}" wx:key="id" class="reference-item"><image wx:if="{{item.type === 'image'}}" src="{{item.path}}" mode="aspectFill" /><text wx:else>{{item.name || item.type}}</text><button data-id="{{item.id}}" bindtap="removeReference">移除</button></view></view>
        <button class="library-button creation-brown" bindtap="openLibraryButton" hover-class="pressed"><image src="/assets/creation-upload.png" /><text>从素材库选择</text></button>
        <view class="reference-limits creation-muted"><text>图片≤8 · 视频≤3 · 音频≤3 · 合计≤12</text><button bindtap="help" aria-label="素材数量说明"><image src="/assets/creation-help.png" /></button></view>
      </block>
    </view>
    <view class="creation-card description-card">
      <view class="description-heading"><view class="creation-heading"><text class="creation-heading-title">画面描述</text></view><button class="optimize-button creation-brown" bindtap="optimize" hover-class="pressed"><image src="/assets/creation-sparkle.png" /><text>{{mode === 'frames' ? 'AI 优化' : '优化提示词'}}</text></button></view>
      <view class="description-input"><view class="creation-resizable"><textarea style="height:{{textHeights.description||160}}px" cursor-spacing="24" class="description-textarea" value="{{description}}" bindinput="inputDescription" placeholder="描述画面、动作与镜头" placeholder-class="creation-muted" maxlength="7000" aria-label="画面描述" /><view class="text-resize-footer"><view class="text-resize-grip" role="button" aria-label="拖动调整文本框高度，点击展开或收起" data-field="description" data-normal="160" catchtouchstart="startTextResize" catchtouchmove="moveTextResize" catchtouchend="endTextResize" catchtouchcancel="endTextResize" bindtap="toggleTextResize"><text>{{textExpanded.description?'收起':'展开'}}</text><view class="text-resize-corner"/></view></view></view></view>
      <text class="description-counter creation-muted">{{description.length}}/7000</text>
    </view>
    <view class="creation-card parameters-card">
      <view class="creation-heading"><text class="creation-heading-title">生成参数</text></view>
      <view class="parameter-grid"><view wx:for="{{parameters}}" wx:key="key" class="parameter"><text class="parameter-label">{{item.label}}</text><view wx:if="{{item.key==='duration'}}" class="parameter-select duration-input"><input type="number" value="{{durationInput}}" bindinput="inputDuration" maxlength="2" placeholder="4–15" aria-label="视频时长，4至15秒整数"/><text>秒</text></view><view wx:elif="{{item.key==='ratio'&&ratioAutomatic}}" class="parameter-select"><text>自动</text></view><picker wx:else range="{{item.options}}" value="{{item.value}}" data-index="{{index}}" bindchange="changeParameter" aria-label="{{item.label}}"><view class="parameter-select"><text>{{item.options[item.value]}}</text><image src="/assets/creation-down.png" /></view></picker></view></view>
      <text class="parameter-note {{durationError?'parameter-error':''}}">{{durationError||'时长支持 4–15 秒，可直接输入'}}</text>
    </view>
    <view class="page-actions"><button class="creation-primary generate-button" bindtap="generate" hover-class="pressed" loading="{{generating}}" disabled="{{generating}}"><text class="button-label">{{generating?'正在提交…':'创建任务'}}</text></button></view>
    </block>
  </view>
</view>
<view wx:if="{{libraryOpen}}" class="creation-sheet-overlay" bindtap="closeLibrary" catchtouchmove="noop"><view class="creation-sheet" catchtap="noop"><view class="creation-sheet-header"><text>从素材库选择</text><button class="creation-sheet-close" bindtap="closeLibrary">关闭</button></view><button wx:for="{{assets}}" wx:key="id" class="creation-sheet-row" data-id="{{item.id}}" bindtap="selectAsset"><image src="{{item.path}}" class="creation-sheet-thumb" mode="aspectFill" /><text class="creation-sheet-row-title">{{item.name}}</text></button></view></view>
