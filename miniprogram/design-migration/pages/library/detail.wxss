@import "/design-migration/styles/base.wxss";
page {
  min-height: 100%;
  background: #f7f4ee;
  color: #2f2925;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.v12-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f4ee;
  color: #2f2925;
}

.v12-content {
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.v12-content--tab {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.v12-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(232, 222, 209, 0.72);
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 30rpx rgba(72, 49, 32, 0.07);
}

.v12-primary-button,
.v12-secondary-button,
.v12-disabled-button {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 500;
}

.v12-primary-button::after,
.v12-secondary-button::after,
.v12-disabled-button::after {
  border: 0;
}

.v12-primary-button--md,
.v12-secondary-button--md,
.v12-disabled-button--md {
  height: 80rpx;
  font-size: 28rpx;
}

.v12-primary-button--sm,
.v12-secondary-button--sm,
.v12-disabled-button--sm {
  height: 68rpx;
  font-size: 28rpx;
}

.v12-primary-button[disabled] {
  color: #ffffff;
  background: #cfc5ba;
  box-shadow: none;
}

.v12-secondary-button[disabled] {
  color: #a89a8c;
  border-color: #cfc5ba;
}

.v12-primary-button {
  color: #ffffff;
  background: linear-gradient(100deg, #8b4818, #7b5532);
  box-shadow: 0 10rpx 24rpx rgba(106, 59, 27, 0.14);
}

.v12-secondary-button {
  color: #6a3b1b;
  border: 2rpx solid #6a3b1b;
  background: #fffdf8;
}

.v12-disabled-button {
  color: #ffffff;
  background: #cfc5ba;
}

.v12-section-title {
  display: block;
  color: #2f2925;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 600;
}

.v12-muted {
  color: #786858;
}

.v12-fixed-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 253, 248, 0.98);
  border-top: 1rpx solid #e8ded1;
}

.v12-safe-bottom {
  height: env(safe-area-inset-bottom);
}

@media (max-width: 350px) {
  .v12-content {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .v12-primary-button, .v12-secondary-button {
    font-size: 28rpx;
  }
}
.detail-page {
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.detail-hero {
  width: calc(100% - 36rpx);
  height: 560rpx;
  margin: 0 20rpx;
  border-radius: 24rpx;
  display: block;
}

.detail-summary {
  padding: 32rpx 44rpx 28rpx;
}

.detail-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}

.detail-source {
  display: block;
  width: fit-content;
  margin-top: 12rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  color: #8b4818;
  background: #f5e5d0;
  font-size: 22rpx;
}

.detail-meta {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
}

.detail-tabs {
  height: 92rpx;
  width: calc(100% - 44rpx);
  margin: 0 24rpx;
  white-space: nowrap;
  background: #fffdf8;
  border: 1rpx solid #e8ded1;
  border-radius: 24rpx;
}

.detail-tabs view {
  min-width: 180rpx;
  height: 90rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #786858;
  font-size: 28rpx;
  position: relative;
}

.detail-tabs .active {
  color: #8b4818;
  font-weight: 600;
}

.detail-tabs .active::after {
  content: "";
  position: absolute;
  bottom: 0;
  width: 68rpx;
  height: 5rpx;
  border-radius: 8rpx;
  background: #8b4818;
}

.plan-card {
  margin: 16rpx 24rpx 24rpx;
  min-height: 454rpx;
  padding: 24rpx;
  border: 1rpx solid #e8ded1;
  border-radius: 24rpx;
  background: #fffdf8;
  box-sizing: border-box;
  overflow: hidden;
}

.plan-card image {
  width: 100%;
  display: block;
}

.elevation-line {
  height: 330rpx;
}

.floor-plan {
  height: 420rpx;
}

.design-copy text {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.design-copy text + text {
  margin-top: 12rpx;
  color: #786858;
  font-size: 24rpx;
  font-weight: 400;
}

.detail-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  padding: 10rpx 32rpx calc(10rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 20rpx;
  background: #fffdf8;
  border-top: 1rpx solid #e8ded1;
}

.favorite {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8b4818;
  font-size: 22rpx;
}

.image-state {
  min-height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #786858;
  background: #f4f0e9;
}

.design-unavailable {
  margin: 20rpx 32rpx;
  font-size: 26rpx;
  color: #786858;
}