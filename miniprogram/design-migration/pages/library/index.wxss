@import "/design-migration/styles/base.wxss";
page {
  min-height: 100%;
  background: #f7f4ee;
  color: #2f2925;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.v12-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f4ee;
  color: #2f2925;
}

.v12-content {
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.v12-content--tab {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.v12-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(232, 222, 209, 0.72);
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 30rpx rgba(72, 49, 32, 0.07);
}

.v12-primary-button,
.v12-secondary-button,
.v12-disabled-button {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 500;
}

.v12-primary-button::after,
.v12-secondary-button::after,
.v12-disabled-button::after {
  border: 0;
}

.v12-primary-button--md,
.v12-secondary-button--md,
.v12-disabled-button--md {
  height: 80rpx;
  font-size: 28rpx;
}

.v12-primary-button--sm,
.v12-secondary-button--sm,
.v12-disabled-button--sm {
  height: 68rpx;
  font-size: 28rpx;
}

.v12-primary-button[disabled] {
  color: #ffffff;
  background: #cfc5ba;
  box-shadow: none;
}

.v12-secondary-button[disabled] {
  color: #a89a8c;
  border-color: #cfc5ba;
}

.v12-primary-button {
  color: #ffffff;
  background: linear-gradient(100deg, #8b4818, #7b5532);
  box-shadow: 0 10rpx 24rpx rgba(106, 59, 27, 0.14);
}

.v12-secondary-button {
  color: #6a3b1b;
  border: 2rpx solid #6a3b1b;
  background: #fffdf8;
}

.v12-disabled-button {
  color: #ffffff;
  background: #cfc5ba;
}

.v12-section-title {
  display: block;
  color: #2f2925;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 600;
}

.v12-muted {
  color: #786858;
}

.v12-fixed-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 253, 248, 0.98);
  border-top: 1rpx solid #e8ded1;
}

.v12-safe-bottom {
  height: env(safe-area-inset-bottom);
}

@media (max-width: 350px) {
  .v12-content {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .v12-primary-button, .v12-secondary-button {
    font-size: 28rpx;
  }
}
.library-content {
  padding-top: 32rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 600;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #786858;
  font-size: 26rpx;
}

.search {
  height: 84rpx;
  margin-top: 32rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e8ded1;
  border-radius: 16rpx;
  background: #fffdf8;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search input {
  flex: 1;
  font-size: 26rpx;
}

.source-tabs {
  height: 80rpx;
  margin-top: 24rpx;
  padding: 4rpx;
  border: 1rpx solid #e8ded1;
  border-radius: 16rpx;
  background: #fffdf8;
  display: flex;
}

.source-tabs view {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #a89a8c;
  font-size: 28rpx;
}

.source-tabs .active {
  background: linear-gradient(95deg, #8b4818, #7b5532);
  color: #ffffff;
  font-weight: 500;
}

.filters {
  margin-top: 24rpx;
  padding: 28rpx;
}

.filters > view {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.filters > view:first-child {
  margin-top: 0;
}

.filters > view > text {
  width: 128rpx;
  font-size: 24rpx;
  color: #786858;
}

.filter-pills {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-pills text {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f4f0e9;
  color: #786858;
  font-size: 22rpx;
  white-space: nowrap;
}

.filter-pills .selected {
  background: linear-gradient(95deg, #8b4818, #7b5532);
  color: #ffffff;
  font-weight: 500;
}

.dimension-inputs {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.dimension-field {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e8ded1;
  border-radius: 16rpx;
  background: #f4f0e9;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dimension-field input {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
}

.dimension-unit {
  color: #a89a8c;
  font-size: 22rpx;
}

.dimension-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e8ded1;
  color: #786858;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

.dimension-hint {
  margin-top: 16rpx !important;
}

.dimension-hint text {
  width: auto !important;
  color: #a89a8c;
  font-size: 20rpx;
}

.sort-row {
  margin: 28rpx 0 20rpx;
  display: flex;
  justify-content: space-between;
  color: #786858;
  font-size: 24rpx;
}

.sort-row view {
  display: flex;
  align-items: center;
}

.case-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.case-card {
  overflow: hidden;
}

.image-wrap {
  position: relative;
}

.image-wrap image {
  width: 100%;
  height: 220rpx;
  display: block;
}

.image-wrap text {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(71, 54, 42, 0.78);
  color: #ffffff;
  font-size: 20rpx;
}

.case-copy {
  padding: 20rpx;
}

.case-copy text {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.case-copy text + text {
  margin-top: 8rpx;
  color: #786858;
  font-size: 22rpx;
  font-weight: 400;
}
/* Fit full API-driven categories without clipping their labels. */
.library-content { padding-top: 24rpx; }
.search { margin-top: 0; }
.filters { padding: 24rpx; }
.filters > .filter-row { align-items: flex-start; gap: 16rpx; }
.filters > .filter-row > .filter-label { width: 100rpx; flex-shrink: 0; line-height: 64rpx; }
.filter-pills { min-width: 0; gap: 12rpx; }
.filter-pills text { box-sizing: border-box; padding: 12rpx 20rpx; line-height: 40rpx; font-size: 24rpx; }
.dimension-inputs { min-width: 0; gap: 12rpx; }
.dimension-field { min-width: 0; padding: 0 12rpx; }
.filters > .classification-error { display: block; color: #a23f34; font-size: 24rpx; margin-top: 12rpx; }
.case-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.case-copy { padding: 18rpx 16rpx; }
.case-copy text { line-height: 1.5; overflow-wrap: anywhere; }
.cover-state { height: 220rpx; display: flex; align-items: center; justify-content: center; background: #f0eae0; font-size: 24rpx; color: #8d7b68; }
.cover-retry { color: #8b4818; }
@media (max-width: 350px) {
  .filters > .filter-row { flex-direction: column; gap: 10rpx; }
  .filters > .filter-row > .filter-label { width: auto; line-height: 1.4; }
  .filter-pills, .dimension-inputs { width: 100%; }
}

/* Keep building styles on one horizontally scrollable row. */
.style-scroll { flex: 1; width: 0; min-width: 0; white-space: nowrap; }
.filter-pills.style-pills { display: inline-flex; flex-wrap: nowrap; width: max-content; padding: 2rpx 0 6rpx; }
.style-pills text { flex-shrink: 0; }
@media (max-width: 350px) { .style-scroll { flex: none; width: 100%; } }
