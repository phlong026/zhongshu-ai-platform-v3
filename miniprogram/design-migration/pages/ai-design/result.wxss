@import "/design-migration/styles/base.wxss";

page, .result-page { background: #faf8f4; }
.result-content { padding: 18rpx 28rpx calc(156rpx + env(safe-area-inset-bottom)); }
.panel { background: #fffdfa; border: 1rpx solid #ece4da; border-radius: 18rpx; margin-bottom: 16rpx; }
.result-header { padding: 14rpx 24rpx 22rpx; }
.header-line, .title-line { display: flex; align-items: center; gap: 18rpx; }
.project-name { flex: 1; min-width: 0; color: #765f4e; font-size: 25rpx; overflow-wrap: anywhere; }
.more-action, .zoom, .version-images button { margin: 0; padding: 0; font-weight: 500; }
.more-action::after, .zoom::after, .version-images button::after { border: 0; }
.more-action { margin-left: auto; padding: 6rpx 4rpx 6rpx 16rpx; color: #795c46; background: transparent; font-size: 26rpx; line-height: 1.5; }
.plan-title { font-size: 36rpx; font-weight: 650; line-height: 1.45; }
.status { padding: 4rpx 14rpx; background: #eaf2e8; color: #406247; border-radius: 40rpx; font-size: 22rpx; }
.status.is-history { background: #f1eee9; color: #73685e; }
.drawing-card { padding: 14rpx; }
.version-images { display: flex; gap: 10rpx; margin: 0 0 14rpx; }
.version-images button { flex: 1; background: #f5f1ed; font-size: 26rpx; line-height: 2.6; }
.version-images .active { color: #8b4818; background: #f8eadd; }
.drawing-frame { position: relative; overflow: hidden; border-radius: 10rpx; background: #faf8f5; }
.drawing { width: 100%; display: block; }
.zoom { position: absolute; bottom: 12rpx; right: 12rpx; height: 56rpx; padding: 0 18rpx; line-height: 56rpx; font-size: 23rpx; border-radius: 12rpx; color: #49382a; background: rgba(255,253,249,.94); }
.drawing-state, .state-panel { padding: 72rpx 20rpx; color: #796d60; font-size: 26rpx; text-align: center; }
.state-panel button, .drawing-state button { margin: 16rpx auto 0; width: 160rpx; font-size: 26rpx; }
.plan-info { padding: 22rpx; }
.section-title { display: block; padding-left: 14rpx; border-left: 5rpx solid #925423; font-size: 29rpx; font-weight: 600; line-height: 1.1; }
.facts { margin-top: 18rpx; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10rpx; }
.fact { display: flex; flex-direction: column; gap: 6rpx; padding: 12rpx; background: #f8f5f0; border-radius: 8rpx; }
.fact-label { font-size: 22rpx; color: #736457; }
.fact-value { font-size: 29rpx; color: #352d27; font-weight: 600; }
.plan-note { display: flex; gap: 10rpx; align-items: center; padding: 14rpx 18rpx; border-radius: 10rpx; background: #faf0e4; color: #865024; font-size: 23rpx; }
.result-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; box-sizing: border-box; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fffdfa; border-top: 1rpx solid #e9e1d7; }
.result-actions button { height: 84rpx; min-width: 0; border-radius: 12rpx; font-size: 29rpx; }
.result-actions .v12-primary-button { background: #934918; box-shadow: none; }
.result-actions .v12-secondary-button { color: #8b4818; border: 1rpx solid #9a623d; background: #fffdfa; }
.result-actions .v12-secondary-button[disabled] { color: #aa9f95; border-color: #d9d2cb; }
