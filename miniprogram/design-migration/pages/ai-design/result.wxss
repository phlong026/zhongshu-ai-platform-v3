@import "/design-migration/styles/base.wxss";
@charset "UTF-8";
page {
  min-height: 100%;
  background: #f7f4ee;
  color: #2f2925;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.v12-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f4ee;
  color: #2f2925;
}

.v12-content {
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.v12-content--tab {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.v12-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(232, 222, 209, 0.72);
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 30rpx rgba(72, 49, 32, 0.07);
}

.v12-primary-button,
.v12-secondary-button,
.v12-disabled-button {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 500;
}

.v12-primary-button::after,
.v12-secondary-button::after,
.v12-disabled-button::after {
  border: 0;
}

.v12-primary-button--md,
.v12-secondary-button--md,
.v12-disabled-button--md {
  height: 80rpx;
  font-size: 28rpx;
}

.v12-primary-button--sm,
.v12-secondary-button--sm,
.v12-disabled-button--sm {
  height: 68rpx;
  font-size: 28rpx;
}

.v12-primary-button[disabled] {
  color: #ffffff;
  background: #cfc5ba;
  box-shadow: none;
}

.v12-secondary-button[disabled] {
  color: #a89a8c;
  border-color: #cfc5ba;
}

.v12-primary-button {
  color: #ffffff;
  background: linear-gradient(100deg, #8b4818, #7b5532);
  box-shadow: 0 10rpx 24rpx rgba(106, 59, 27, 0.14);
}

.v12-secondary-button {
  color: #6a3b1b;
  border: 2rpx solid #6a3b1b;
  background: #fffdf8;
}

.v12-disabled-button {
  color: #ffffff;
  background: #cfc5ba;
}

.v12-section-title {
  display: block;
  color: #2f2925;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 600;
}

.v12-muted {
  color: #786858;
}

.v12-fixed-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 253, 248, 0.98);
  border-top: 1rpx solid #e8ded1;
}

.v12-safe-bottom {
  height: env(safe-area-inset-bottom);
}

@media (max-width: 350px) {
  .v12-content {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .v12-primary-button, .v12-secondary-button {
    font-size: 28rpx;
  }
}
/* 纵向弹性布局：内容不足一屏时把动作区压到页面底部（UX 整改：按钮太靠上） */
.result-page {
  padding: 28rpx 32rpx 44rpx;
  display: flex;
  flex-direction: column;
}

.result-page > v12-navbar {
  margin: -28rpx -32rpx 0;
}

.success-banner {
  height: 102rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.success-banner text {
  font-size: 32rpx;
}

.success-banner span {
  margin-left: auto;
  padding: 8rpx 20rpx;
  border: 1rpx solid #c8a679;
  border-radius: 8rpx;
  color: #8b4818;
  font-size: 24rpx;
}

.result-tabs {
  height: 100rpx;
  display: flex;
}

.result-tabs view {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #786858;
  font-size: 28rpx;
}

.result-tabs .active {
  color: #8b4818;
  font-weight: 600;
}

.result-tabs .active::after {
  content: "";
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 4rpx;
  background: #8b4818;
}

.result-main {
  overflow: hidden;
}

.image-wrap {
  position: relative;
}

.image-wrap image {
  width: 100%;
  height: 466rpx;
  display: block;
}

.image-wrap text {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(50, 50, 50, 0.55);
  color: #ffffff;
  font-size: 22rpx;
}

.image-wrap .image-zoom-hint {
  right: auto;
  top: auto;
  bottom: 16rpx;
  left: 16rpx;
  background: rgba(50, 50, 50, 0.38);
  font-size: 20rpx;
}

.result-copy {
  padding: 28rpx 40rpx;
}

.result-copy text {
  display: block;
  font-size: 28rpx;
}

.result-copy text + text {
  margin-top: 12rpx;
  color: #786858;
  font-size: 24rpx;
}

.files {
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
}

.files > text {
  font-size: 28rpx;
}

.files > view {
  height: 68rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid #e8ded1;
}

.files > view:last-child {
  border: 0;
}

.files > view text {
  flex: 1;
  font-size: 26rpx;
}

.result-actions {
  margin: auto 0 0;
  padding-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
}

.result-actions .disabled {
  opacity: 0.45;
}

.tool-row {
  margin-top: 20rpx;
  display: grid;
  gap: 16rpx;
}

.tool-row.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.tool-row.cols-1 {
  grid-template-columns: 1fr;
}

.tool-row view {
  height: 76rpx;
  border: 1rpx solid #e8ded1;
  border-radius: 16rpx;
  background: #fffdf8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 22rpx;
}

/* AI 生成内容免责脚注：随图展示（2026-10-11 从输入页顶横幅迁移至此——免责应贴着 AI 产出物） */
.ai-footnote {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8ded1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.ai-footnote text {
  font-size: 20rpx;
  color: #a89a8c;
}

.version-images {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.version-images button {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
}

.version-images .active {
  color: #7b5532;
  background: #f4ece3;
}