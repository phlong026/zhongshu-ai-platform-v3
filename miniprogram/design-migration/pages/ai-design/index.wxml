<view class="v12-page" wx:if="{{accessReady}}">
  <v12-navbar title="AI设计" show-back />
  <view class="v12-content v12-content--tab ai-content">

    <view class="mode-tabs">
      <view role="button" class="{{line === 'FLAT' ? 'active' : ''}}" data-line="FLAT" bindtap="selectLine">平面方案</view>
      <view role="button" class="{{line === 'ELEVATION' ? 'active' : ''}}" data-line="ELEVATION" bindtap="selectLine">立面方案</view>
    </view>

    <!-- ============ 线路一：平面方案 ============ -->
    <block wx:if="{{line === 'FLAT'}}">
      <view class="v12-card form-card">
        <view class="card-head"><text class="card-title">宅基地信息</text></view>
        <view class="case-strip" wx:if="{{refCase}}">
          <text class="case-strip-text">参考案例：<text class="case-name">{{refCase.title}}</text>{{refCaseText ? ' · ' + refCaseText : ''}}{{refCaseAuto ? '（按层数与面积自动匹配）' : ''}}</text>
          <view role="button" class="case-change" bindtap="chooseReference">更换参考</view>
        </view>
        <view class="size-row">
          <view><text>面宽</text><input type="digit" value="{{faceWidth}}" bindinput="onFaceWidthInput" placeholder="如 12.6" /><text>m</text></view>
          <view><text>进深</text><input type="digit" value="{{depth}}" bindinput="onDepthInput" placeholder="如 13.8" /><text>m</text></view>
        </view>
        <picker mode="selector" range="{{entranceLabels}}" value="{{entranceIndex}}" bindchange="onEntranceChange">
          <view class="form-row"><text>主入口朝向</text><view>{{entranceLabels[entranceIndex]}} <t-icon name="chevron-right" size="16px" color="#2f2925" /></view></view>
        </picker>
        <picker mode="selector" range="{{floorLabels}}" value="{{floorIndex}}" bindchange="onFloorChange">
          <view class="form-row"><text>层数</text><view>{{floorLabels[floorIndex]}} <t-icon name="chevron-right" size="16px" color="#2f2925" /></view></view>
        </picker>
        <picker mode="selector" range="{{familyLabels}}" value="{{familyIndex}}" bindchange="onFamilyChange">
          <view class="form-row"><text>家庭需求</text><view>{{familyLabels[familyIndex]}} <t-icon name="chevron-right" size="16px" color="#2f2925" /></view></view>
        </picker>
        <picker mode="selector" range="{{layoutLabels}}" value="{{layoutIndex}}" bindchange="onLayoutChange">
          <view class="form-row form-row-last"><text>院落布局</text><view>{{layoutLabels[layoutIndex]}} <t-icon name="chevron-right" size="16px" color="#2f2925" /></view></view>
        </picker>
      </view>

      <view class="v12-card form-card">
        <view class="card-head"><text class="card-title">图纸类型</text><text class="sec-tip">已选：{{drawingTypes[drawingIndex].label}}</text></view>
        <view class="chips chips-wrap">
            <view role="button" wx:for="{{drawingTypes}}" wx:key="code" class="chip {{drawingIndex === index ? 'chip-on' : ''}}" data-index="{{index}}" bindtap="onDrawingChange">{{item.label}}</view>
        </view>
      </view>

      <view class="v12-card form-card">
        <view class="card-head">
          <view class="card-title-wrap"><text class="card-title">补充需求</text><text class="card-title-sub">（选填）</text></view>
          <!-- AI 优化按钮暂缓上线（接口已就绪，待密钥配置与扣点口径确认后恢复）： -->
          <!-- <view class="ai-chip {{polishing ? 'ai-chip-busy' : ''}}" bindtap="polishNote">{{polishing ? '优化中…' : 'AI 优化'}}</view> -->
        </view>
        <view class="textarea-row">
          <view class="note-field">
            <textarea auto-height maxlength="200" value="{{note}}" bindinput="onNoteInput" placeholder="如：老人房在一楼，客餐厅南向，保留露台" />
            <view class="note-tools">
              <view role="button" class="note-sketch" bindtap="chooseImage">＋ 附手绘草图{{sketchAssetId ? '（已传）' : '（选填）'}}</view>
              <view class="note-right"><text class="note-count">{{note.length}}/200</text><view role="button" class="note-expand" bindtap="openNoteEditor">展开<t-icon name="chevron-down" size="12px" /></view></view>
            </view>
          </view>
          <view wx:if="{{sketchImage}}" class="sketch-preview"><image src="{{sketchImage}}" mode="aspectFit" lazy-load /><text>草图已上传，将随任务提交</text></view>
        </view>
      </view>

      <view class="v12-card generation-settings">
        <view class="settings-head"><text class="card-title">出图设置</text></view>
        <view class="opt-label">清晰度</view>
        <view class="segbar">
          <view role="button" class="seg {{resolution === '2K' ? 'seg-on' : ''}}" data-value="2K" bindtap="selectResolution">2K · 清晰出图</view>
          <view role="button" class="seg {{resolution === '4K' ? 'seg-on' : ''}}" data-value="4K" bindtap="selectResolution">4K · 高清细节</view>
        </view>
        <view class="opt-label"><text>画面方向</text></view>
        <view class="segbar">
          <view role="button" class="seg {{orientation === 'LANDSCAPE' ? 'seg-on' : ''}}" data-value="LANDSCAPE" bindtap="selectOrientation"><view class="ori-frame"></view>横屏 16:9</view>
          <view role="button" class="seg {{orientation === 'PORTRAIT' ? 'seg-on' : ''}}" data-value="PORTRAIT" bindtap="selectOrientation"><view class="ori-frame ori-portrait"></view>竖屏 9:16</view>
        </view>
        <view class="opt-label"><text>生成数量</text><text class="opt-val price" wx:if="{{quoteUnit}}">单张 {{quoteUnit}} 公司积分</text></view>
        <view class="segbar">
          <view role="button" wx:for="{{[1, 2, 4]}}" wx:key="*this" class="seg {{count === item ? 'seg-on' : ''}}" data-count="{{item}}" bindtap="selectCount">{{item}} 张</view>
        </view>
        <view class="settings-footer">
          <view class="cost-summary"><text>本次费用</text><b>{{priceText || '正在获取报价…'}}</b><text>余额 {{points}} 公司积分</text><text role="button" wx:if="{{quoteError}}" class="quote-retry" bindtap="retryQuote">重新获取报价</text></view>
          <view role="button" class="v12-primary-button generate-button {{(!acceptedGeneration && (!quoteReady || candidateConfirming)) || creating ? 'disabled' : ''}}" aria-disabled="{{(!acceptedGeneration && (!quoteReady || candidateConfirming)) || creating}}" bindtap="generate">{{creating ? creatingText : candidateConfirming ? '正在确认参考…' : pendingGeneration ? '继续上次生成' : '生成平面方案'}}</view>
        </view>
      </view>
    </block>

    <!-- ============ 线路二：立面方案 ============ -->
    <block wx:else>
      <view class="v12-card form-card">
        <view class="card-head"><view class="card-title-wrap"><text class="card-title">参考图</text><text class="card-title-sub">（选填 · 最多 3 张）</text></view></view>
        <view class="src-row">
          <view role="button" class="src src-lib" bindtap="chooseReference">从户型库选</view>
          <view role="button" class="src" bindtap="chooseElevImage">上传图片</view>
        </view>
        <view wx:if="{{elevRefs.length || elevRefCase}}" class="ref-slots">
          <view wx:for="{{elevRefs}}" wx:key="assetId" class="ref-slot">
            <image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFit" />
            <view wx:else class="ref-slot-pending"><text>已上传</text></view>
            <text class="ref-slot-tag">上传参考</text>
            <view role="button" aria-label="删除这张参考图" class="ref-slot-del" catchtap="clearElevRef" data-index="{{index}}">×</view>
          </view>
          <view wx:if="{{elevRefCase}}" class="ref-slot">
            <image wx:if="{{elevRefCase.coverUrl}}" src="{{elevRefCase.coverUrl}}" mode="aspectFit" />
            <view wx:else class="ref-slot-pending"><text>已选户型</text></view>
            <text class="ref-slot-tag">户型库 · {{elevRefCase.title}}</text>
            <view role="button" aria-label="移除户型库参考案例" class="ref-slot-del" catchtap="clearElevRefCase">×</view>
          </view>
        </view>
      </view>

      <view class="v12-card form-card">
        <view class="card-head"><text class="card-title">建筑风格<text class="card-title-sub">（可选）</text></text><text class="sec-tip">已选：{{elevStyleCode ? elevStyleLabel : '不指定'}}</text></view>
        <view wx:if="{{styleError}}" class="style-error" role="button" bindtap="loadStyles">{{styleError}}</view>
        <scroll-view class="chips-scroll style-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="chips chips-nowrap style-pills">
            <view role="button" class="chip {{!elevStyleCode ? 'chip-on' : ''}}" data-code="" bindtap="onElevStyle">不指定</view>
            <view role="button" wx:for="{{elevStyles}}" wx:key="code" class="chip {{elevStyleCode === item.code ? 'chip-on' : ''}}" data-code="{{item.code}}" bindtap="onElevStyle">{{item.label}}</view>
          </view>
        </scroll-view>
      </view>

      <view class="v12-card form-card">
        <view class="card-head"><text class="card-title">建筑条件</text></view>
        <text wx:if="{{elevRefCase}}" class="case-strip-text">参考户型：{{elevRefCase.faceWidth || '—'}} × {{elevRefCase.depth || '—'}} m · {{elevRefCase.buildingArea || '—'}}㎡</text>
        <view class="adv-group"><text class="adv-label">层数</text>
          <view class="chips">
            <view role="button" wx:for="{{floorChips}}" wx:key="label" class="chip {{elevFloorIndex === index ? 'chip-on' : ''}}" data-index="{{index}}" bindtap="onElevFloor">{{item.label}}</view>
          </view>
        </view>
        <view role="button" class="adv-head" bindtap="toggleElevAdvanced">
          <text>高级选项<text class="adv-sub">（选填 · 屋顶 / 外墙 / 点缀色）</text></text>
          <text class="adv-toggle">{{elevAdvancedOpen ? '收起 ▴' : '展开 ▾'}}</text>
        </view>
        <block wx:if="{{elevAdvancedOpen}}">
          <view class="adv-group"><text class="adv-label">屋顶形式</text>
            <view class="chips">
              <view role="button" wx:for="{{elevRoofs}}" wx:key="code" class="chip {{elevRoof === item.code ? 'chip-on' : ''}}" data-code="{{item.code}}" bindtap="onElevRoof">{{item.label}}</view>
            </view>
          </view>
          <view class="adv-group"><text class="adv-label">外墙材质</text>
            <view class="chips">
              <view role="button" wx:for="{{elevWalls}}" wx:key="code" class="chip {{elevWall === item.code ? 'chip-on' : ''}}" data-code="{{item.code}}" bindtap="onElevWall">{{item.label}}</view>
            </view>
          </view>
          <view class="adv-group"><text class="adv-label">点缀色</text>
            <view class="chips">
              <view role="button" wx:for="{{elevAccents}}" wx:key="code" class="chip {{elevAccent === item.code ? 'chip-on' : ''}}" data-code="{{item.code}}" bindtap="onElevAccent">{{item.label}}</view>
            </view>
          </view>
          <view class="sec-hint">不动高级选项时，屋顶与材质由所选风格智能决定</view>
        </block>
      </view>

      <view class="v12-card form-card">
        <view class="card-head">
          <view class="card-title-wrap"><text class="card-title">补充需求</text><text class="card-title-sub">（选填）</text></view>
          <!-- AI 优化按钮暂缓上线（接口已就绪，待密钥配置与扣点口径确认后恢复）： -->
          <!-- <view class="ai-chip {{polishing ? 'ai-chip-busy' : ''}}" bindtap="polishNote">{{polishing ? '优化中…' : 'AI 优化'}}</view> -->
        </view>
        <view class="textarea-row">
          <view class="note-field">
            <textarea auto-height maxlength="200" value="{{elevNote}}" bindinput="onElevNoteInput" placeholder="如：面宽约 12 米，白墙灰瓦，带院子" />
            <view class="note-tools">
              <view class="note-right"><text class="note-count">{{elevNote.length}}/200</text><view role="button" class="note-expand" bindtap="openNoteEditor">展开<t-icon name="chevron-down" size="12px" /></view></view>
            </view>
          </view>
        </view>
      </view>

      <view class="v12-card generation-settings">
        <view class="settings-head"><text class="card-title">出图设置</text></view>
        <view class="opt-label">清晰度</view>
        <view class="segbar">
          <view role="button" class="seg {{elevResolution === '2K' ? 'seg-on' : ''}}" data-value="2K" bindtap="selectElevResolution">2K · 清晰出图</view>
          <view role="button" class="seg {{elevResolution === '4K' ? 'seg-on' : ''}}" data-value="4K" bindtap="selectElevResolution">4K · 高清细节</view>
        </view>
        <view class="opt-label"><text>画面方向</text></view>
        <view class="segbar">
          <view role="button" class="seg {{elevOrientation === 'LANDSCAPE' ? 'seg-on' : ''}}" data-value="LANDSCAPE" bindtap="selectElevOrientation"><view class="ori-frame"></view>横屏 16:9</view>
          <view role="button" class="seg {{elevOrientation === 'PORTRAIT' ? 'seg-on' : ''}}" data-value="PORTRAIT" bindtap="selectElevOrientation"><view class="ori-frame ori-portrait"></view>竖屏 9:16</view>
        </view>
        <view class="opt-label"><text>生成数量</text><text class="opt-val price" wx:if="{{quoteUnit}}">单张 {{quoteUnit}} 公司积分</text></view>
        <view class="segbar">
          <view role="button" wx:for="{{[1, 2, 4]}}" wx:key="*this" class="seg {{elevCount === item ? 'seg-on' : ''}}" data-count="{{item}}" bindtap="selectElevCount">{{item}} 张</view>
        </view>
        <view class="settings-footer">
          <view class="cost-summary"><text>本次费用</text><b>{{priceText || '正在获取报价…'}}</b><text>余额 {{points}} 公司积分</text><text role="button" wx:if="{{quoteError}}" class="quote-retry" bindtap="retryQuote">重新获取报价</text></view>
          <view role="button" class="v12-primary-button generate-button {{(!acceptedGeneration && !quoteReady) || creating ? 'disabled' : ''}}" aria-disabled="{{(!acceptedGeneration && !quoteReady) || creating}}" bindtap="generate">{{creating ? creatingText : pendingGeneration ? '继续上次生成' : '生成立面方案'}}</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{noteEditorOpen}}" class="note-editor-mask" bindtap="closeNoteEditor">
    <view class="note-editor-sheet" catchtap="noop">
      <view class="note-editor-head"><text>补充需求</text><text class="note-count">{{draftNote.length}}/200</text></view>
      <textarea class="note-editor-textarea" maxlength="200" value="{{draftNote}}" bindinput="onDraftNoteInput" focus placeholder="如：老人房在一楼，客餐厅南向，保留露台" aria-label="补充需求编辑" />
      <view class="note-editor-actions">
        <view role="button" class="v12-secondary-button" bindtap="closeNoteEditor">取消</view>
        <view role="button" class="v12-primary-button" bindtap="applyNoteEditor">完成</view>
      </view>
    </view>
  </view>
</view>
