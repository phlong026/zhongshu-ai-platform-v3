<view wx:if="{{accessReady}}" class="v12-page result-page">
  <v12-navbar title="方案结果" show-back show-brand="{{false}}" />
  <view wx:if="{{loading}}" class="state-panel">正在读取方案…</view>
  <view wx:elif="{{error}}" class="state-panel"><text>{{error}}</text><button bindtap="loadVersions">重试</button></view>
  <block wx:elif="{{latest}}">
    <view class="result-content">
      <view class="panel result-header">
        <view class="header-line"><text wx:if="{{projectName}}" class="project-name">{{projectName}}</text><button class="more-action" bindtap="moreActions" aria-label="更多方案操作">更多</button></view>
        <view class="title-line"><text class="plan-title">{{imageLabel || '设计方案'}} V{{latest.version}}</text><text class="status {{readOnly ? 'is-history' : ''}}">{{readOnly ? '历史版本' : '已选用'}}</text></view>
      </view>
      <view class="panel drawing-card">
        <view wx:if="{{resultImages.length > 1}}" class="version-images">
          <button wx:for="{{resultImages}}" wx:key="key" data-key="{{item.key}}" bindtap="selectVersionImage" class="{{activeImageKey === item.key ? 'active' : ''}}">{{item.label}}</button>
        </view>
        <view class="drawing-frame" wx:if="{{imageUrl}}">
          <image class="drawing" mode="widthFix" src="{{imageUrl}}" binderror="imageFailed" bindtap="previewCurrentImage" data-url="{{imageUrl}}" aria-label="放大查看{{imageLabel}}" />
          <button class="zoom" bindtap="previewCurrentImage" aria-label="查看大图">查看大图</button>
        </view>
        <view wx:else class="drawing-state"><text>{{imageError || '正在读取图纸…'}}</text><button wx:if="{{imageError}}" bindtap="loadImages">重试</button></view>
      </view>
      <view wx:if="{{planFacts.length}}" class="panel plan-info">
        <text class="section-title">方案信息</text>
        <view class="facts"><view wx:for="{{planFacts}}" wx:key="label" class="fact"><text class="fact-label">{{item.label}}</text><text class="fact-value">{{item.value}}</text></view></view>
      </view>
      <view class="plan-note"><t-icon name="info-circle" size="14px" color="#a3592e"/><text>AI 生成 · 仅供方案沟通，不作为施工图。</text></view>
    </view>
    <view class="result-actions">
      <button class="v12-secondary-button" disabled="{{!imageUrl}}" bindtap="saveToAlbum">保存到相册</button>
      <button class="v12-primary-button" bindtap="budget">生成预算</button>
    </view>
  </block>
</view>
