@import "/design-migration/styles/base.wxss";
@charset "UTF-8";
page {
  min-height: 100%;
  background: #f7f4ee;
  color: #2f2925;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.v12-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f4ee;
  color: #2f2925;
}

.v12-content {
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.v12-content--tab {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.v12-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(232, 222, 209, 0.72);
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 30rpx rgba(72, 49, 32, 0.07);
}

.v12-primary-button,
.v12-secondary-button,
.v12-disabled-button {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 500;
}

.v12-primary-button::after,
.v12-secondary-button::after,
.v12-disabled-button::after {
  border: 0;
}

.v12-primary-button--md,
.v12-secondary-button--md,
.v12-disabled-button--md {
  height: 80rpx;
  font-size: 28rpx;
}

.v12-primary-button--sm,
.v12-secondary-button--sm,
.v12-disabled-button--sm {
  height: 68rpx;
  font-size: 28rpx;
}

.v12-primary-button[disabled] {
  color: #ffffff;
  background: #cfc5ba;
  box-shadow: none;
}

.v12-secondary-button[disabled] {
  color: #a89a8c;
  border-color: #cfc5ba;
}

.v12-primary-button {
  color: #ffffff;
  background: linear-gradient(100deg, #8b4818, #7b5532);
  box-shadow: 0 10rpx 24rpx rgba(106, 59, 27, 0.14);
}

.v12-secondary-button {
  color: #6a3b1b;
  border: 2rpx solid #6a3b1b;
  background: #fffdf8;
}

.v12-disabled-button {
  color: #ffffff;
  background: #cfc5ba;
}

.v12-section-title {
  display: block;
  color: #2f2925;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 600;
}

.v12-muted {
  color: #786858;
}

.v12-fixed-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 253, 248, 0.98);
  border-top: 1rpx solid #e8ded1;
}

.v12-safe-bottom {
  height: env(safe-area-inset-bottom);
}

@media (max-width: 350px) {
  .v12-content {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .v12-primary-button, .v12-secondary-button {
    font-size: 28rpx;
  }
}
.budget-page {
  padding: 0 32rpx calc(190rpx + env(safe-area-inset-bottom));
  background: #f7f4ee;
  color: #2f2925;
}

.budget-page > v12-navbar {
  display: block;
  margin: 0 -32rpx;
}

.budget-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.auto-note {
  min-height: 82rpx;
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: #fdf5e9;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #b9690b;
  font-size: 24rpx;
  box-sizing: border-box;
}

.auto-note > text:first-of-type {
  flex: 1;
}

.source-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 1rpx solid #c8a679;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.budget-page .text-action {
  display: inline-flex;
  width: auto;
  margin: 0;
  padding: 0;
  color: #8b4818;
  background: transparent;
  border: 0;
  line-height: 1.6;
  border-radius: 0;
  font-size: 26rpx;
}

.text-action::after, .budget-primary::after {
  border: 0;
}

.text-action[disabled] {
  background: transparent;
  color: #a89a8c;
}

.budget-page .text-action.source-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 1rpx solid #c8a679;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.round-icon {
  width: 74rpx;
  height: 74rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f4f0e9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.explanation {
  margin-top: 28rpx;
  padding: 32rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.muted {
  display: block;
  margin-top: 12rpx;
  color: #a89a8c;
  font-size: 24rpx;
  line-height: 1.65;
}

/* 填写说明增强块：多行条目逐行展示（parameters / prices 专用，单行说明页不受影响） */
.explanation.help-card {
  align-items: flex-start;
}

.help-copy {
  flex: 1;
  min-width: 0;
}

.help-items {
  margin-top: 8rpx;
}

.help-item {
  position: relative;
  display: block;
  padding-left: 28rpx;
  margin-top: 10rpx;
  color: #786858;
  font-size: 22rpx;
  line-height: 1.7;
}

.help-item::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-top: -4rpx;
  border-radius: 50%;
  background: #6a3b1b;
}

.budget-footer {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 80;
}

.footer-actions {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 24rpx;
}

.budget-page .budget-primary {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: linear-gradient(100deg, #8b4818, #7b5532);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(106, 59, 27, 0.14);
}

.budget-page .budget-secondary {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid #6a3b1b;
  border-radius: 16rpx;
  background: #fffdf8;
  color: #6a3b1b;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.budget-secondary[disabled] {
  color: #a89a8c;
  background: #f4f0e9;
}

.budget-primary[disabled] {
  color: #ffffff;
  background: #cfc5ba;
}

.footer-hint {
  display: block;
  margin-bottom: 12rpx;
  color: #a89a8c;
  font-size: 22rpx;
  text-align: center;
  background: #f7f4ee;
}

/* 只保留卡片外框的留白；态内部（文字层级、重试按钮）由 v12-state 组件自带，
   组件有样式隔离，页面选择器穿不进去，留着也是死规则。 */
.state-card {
  margin-top: 28rpx;
  padding: 36rpx;
}

.inline-warning {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #fdf5e9;
  border-radius: 16rpx;
  color: #b9690b;
  font-size: 22rpx;
  line-height: 1.5;
}

.inline-warning .text-action {
  margin-left: 12rpx;
}

/* 角标提示符：标题行内的小徽标（替代独立提醒横幅） */
.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.count-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f4f0e9;
  color: #786858;
  font-size: 20rpx;
  white-space: nowrap;
}

.result-footnote {
  display: block;
  margin: 16rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: #a89a8c;
}

.prices-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.prices-card {
  margin-top: 20rpx;
  padding: 8rpx 28rpx;
}

.prices-hint {
  padding: 20rpx 0 24rpx;
  color: #8b4818;
  font-size: 22rpx;
}

.prices-group {
  margin-top: 20rpx;
  padding: 28rpx 28rpx 12rpx;
}

.prices-head {
  padding-bottom: 8rpx;
}

.price-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 128rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8ded1;
  box-sizing: border-box;
}

.price-row:last-child {
  border-bottom: 0;
}

.price-copy {
  flex: 1;
  min-width: 0;
}

.price-label {
  display: block;
  font-size: 28rpx;
  line-height: 1.4;
  word-break: break-all;
}

.price-unit {
  color: #a89a8c;
  font-size: 24rpx;
}

.price-mine {
  display: block;
  margin-top: 8rpx;
  color: #8b4818;
  font-size: 26rpx;
  font-weight: 600;
  word-break: break-all;
}

.price-reason {
  font-size: 22rpx;
  font-weight: 400;
  color: #b9690b;
}

.price-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  padding-top: 8rpx;
}

.muted-action {
  color: #a89a8c;
}

.price-editor {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.price-editor input {
  width: 300rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #c8a679;
  border-radius: 12rpx;
  background: #fffdf8;
  font-size: 28rpx;
  text-align: right;
  box-sizing: border-box;
}

/* 自定义地区：行内标签 + 新增入口（与基础参数页同口径，2026-10-05） */
.parameter-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid #e8ded1;
  font-size: 28rpx;
}

.parameter-row > text {
  flex-shrink: 0;
}

.last-row {
  border-bottom: 0;
}

.input-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  min-width: 0;
}

.region-tag {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid #6a3b1b;
  color: #6a3b1b;
  font-size: 20rpx;
}

.add-region-label {
  color: #6a3b1b;
  font-size: 26rpx;
}