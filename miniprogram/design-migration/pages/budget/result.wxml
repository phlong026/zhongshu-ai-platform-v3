<view class="v12-page budget-page budget-read-page budget-result-page" wx:if="{{accessReady}}">
  <v12-navbar title="参考预算" show-back show-brand="{{false}}" />
  <view class="budget-card state-card" wx:if="{{loading || error}}"><v12-state status="{{loading ? 'loading' : 'error'}}" text="{{loading ? '正在读取预算…' : error}}" action-text="{{loading ? '' : '重试'}}" bind:action="load" card="{{false}}" /></view>
  <block wx:elif="{{estimate}}">
    <view class="result-hero">
      <image class="budget-sketch" src="/design-migration/assets/v12/budget-sketch.jpg" mode="aspectFit" />
      <text class="amount-label">{{legacy ? amountLabel : '预算小计'}}</text>
      <view class="hero-amount"><text class="amount-number {{exact ? 'exact-number' : ''}}">{{amountText}}</text><text class="amount-unit">{{amountUnit}}</text></view>
    </view>
    <view class="budget-card quote-card" wx:if="{{quote}}">
      <view class="quote-title-row"><text class="section-title">正式报价 · V{{quote.quoteVersion}}</text><text class="quote-badge">已发布</text></view>
      <text class="amount-label">最终报价</text>
      <view class="quote-amount"><text>{{quoteAmountText}}</text><text class="amount-unit">{{quoteAmountUnit}}</text></view>
      <view class="quote-basis"><text>系统测算 {{quoteCalculatedText}}</text><text>调价 {{quoteAdjustmentText}}</text></view>
      <text class="row-description">{{quote.disclaimer}}</text>
    </view>
    <view class="inline-warning" wx:elif="{{quoteStatusText}}"><text>{{quoteStatusText}}</text></view>
    <view class="quote-loading" wx:if="{{quoteLoading}}">正在核对正式报价…</view>
    <view class="quote-loading" wx:if="{{quoteError}}">正式报价暂时无法读取：{{quoteError}}</view>
    <view class="budget-card result-section" wx:if="{{!legacy}}">
      <view class="result-section-head"><text class="section-title">预算构成</text><button wx:if="{{estimate.completeness === 'COMPLETE'}}" class="text-action export-link" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportImage">保存预算图</button></view>
      <view class="summary-row" wx:for="{{categoryRows}}" wx:key="code" data-category="{{item.code}}" bindtap="detail" role="button" aria-label="查看{{item.name}}明细">
        <view class="round-icon"><image class="category-icon" src="/assets/{{item.code === 'BODY' ? 'house' : 'home-design-icon'}}.png" mode="aspectFit" /></view>
        <view class="summary-copy"><text>{{item.name}}</text><text class="row-description">{{item.description}}</text></view>
        <view class="row-price"><text>{{item.amountText}}</text><text class="row-description" wx:if="{{item.incomplete}}">待补齐</text></view>
        <t-icon name="chevron-right" size="16px" color="#a89a8c" />
      </view>
    </view>
    <view class="budget-card result-section"><text class="section-title">{{legacy ? '历史测算依据' : '方案概况'}}</text><view class="result-grid"><view wx:for="{{basis}}" wx:key="label" class="result-cell"><text>{{item.label}}</text><text>{{item.value}}</text></view></view></view>
    <button wx:if="{{!legacy}}" class="v12-primary-button commission-entry" bindtap="commission">发起设计委托 <t-icon name="chevron-right" size="18px" color="#ffffff" /></button>
    <text class="save-error result-feedback" wx:if="{{saveError}}">{{saveError}}</text>
    <view class="result-tabs" role="toolbar" aria-label="预算操作">
      <button class="result-tab {{estimate.saved ? 'is-saved' : ''}}" loading="{{saving}}" disabled="{{legacy || saving || estimate.saved}}" bindtap="save"><image src="/design-migration/assets/budget-icons/save.png" mode="aspectFit" /><text>{{estimate.saved ? '已保存' : '保存预算单'}}</text></button>
      <button class="result-tab" disabled="{{legacy || saving}}" bindtap="archive"><image src="/assets/team.png" mode="aspectFit" /><text>发送至客户</text></button>
      <button class="result-tab" disabled="{{saving}}" bindtap="adjust"><image src="/design-migration/assets/budget-icons/refresh.png" mode="aspectFit" /><text>重新测算</text></button>
      <button class="result-tab" disabled="{{saving}}" bindtap="history"><image src="/assets/studio-clock.png" mode="aspectFit" /><text>预算历史</text></button>
    </view>
    <canvas type="2d" id="budgetCanvas" class="share-canvas"></canvas>
  </block>
</view>
