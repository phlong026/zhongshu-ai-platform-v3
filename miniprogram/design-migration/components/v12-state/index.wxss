:host {
  display: block;
}

.v12-state {
  box-sizing: border-box;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  text-align: center;
}

.v12-state--card {
  border: 1rpx solid rgba(232, 222, 209, 0.72);
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 30rpx rgba(72, 49, 32, 0.07);
}

.v12-state__icon {
  margin-bottom: 8rpx;
  color: #786858;
}

.v12-state__text {
  font-size: 28rpx;
  line-height: 1.6;
  font-weight: 500;
  color: #786858;
  overflow-wrap: anywhere;
}

.v12-state__hint {
  font-size: 24rpx;
  line-height: 1.6;
  color: #786858;
  overflow-wrap: anywhere;
}

.v12-state__action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin: 8rpx 0 0;
  padding: 0 32rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #7b5532;
  background: #f4f0e9;
  border-radius: 12rpx;
}

.v12-state__action::after {
  border: 0;
}