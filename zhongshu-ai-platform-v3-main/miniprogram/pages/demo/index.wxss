.demo-page{background:#faf8f4;color:#302b26;min-height:100vh;padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}.content{padding:24rpx}.card{padding:28rpx;background:#fff;border-radius:18rpx;margin-bottom:22rpx;border:1rpx solid #eee4d9}.card>text{display:block;font-size:26rpx;line-height:1.7;margin:8rpx 0;overflow-wrap:anywhere}.card>.title{font-size:31rpx;font-weight:600;margin:4rpx 0 14rpx}.muted{color:#78736d}.group,.next{color:#824019}.actor{font-weight:600}.current{border-color:#824019}.filters{white-space:nowrap;margin:12rpx 0 24rpx;width:100%}.filter{display:inline-flex;min-height:44px;align-items:center;padding:12rpx 22rpx;font-size:25rpx;border:1rpx solid #ded3c5;border-radius:14rpx;margin-right:12rpx;background:#fff}.selected{background:#824019;color:#fff}.actions{display:flex;gap:16rpx;margin-top:22rpx}.outline{flex:1;border:1rpx solid #824019;border-radius:12rpx;color:#824019;font-size:26rpx;min-height:44px;display:flex;justify-content:center;align-items:center;padding:12rpx}.page-actions{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;z-index:20;border-top:1rpx solid #eee4d9}.solid{width:100%;background:#824019;color:#fff;font-size:28rpx;min-height:44px;display:flex;align-items:center;justify-content:center;border-radius:12rpx}.error{color:#a72626;display:block;padding:20rpx}
