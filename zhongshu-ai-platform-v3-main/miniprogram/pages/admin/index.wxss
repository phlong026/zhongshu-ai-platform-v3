@import "./layout.wxss";
@import "./typography.wxss";

/* Voucher captions and long attachment names must remain fully readable. */
.admin .upload{display:flex;flex-direction:column;align-items:center;justify-content:center;height:auto;min-height:166rpx;flex-shrink:0;gap:8rpx;padding:20rpx 12rpx;white-space:normal;overflow:visible}
.admin .upload .plus{flex-shrink:0}
.admin .upload-caption{display:block;width:100%;font-size:24rpx;line-height:36rpx;word-break:break-all}
.admin .upload-row>.hint{min-width:0;max-width:100%;word-break:break-all}
.admin .value{min-width:0;word-break:break-all}
.admin .hero-copy{flex:1;min-width:0;word-break:break-all}

@import "../../styles/project-flow.wxss";
