<import src="./finance-home.wxml"/>
<template wx:if="{{financeDesk}}" is="financeHome" data="{{desk:financeDesk}}"/>
<view wx:else class="page management-page workbench-page"><view class="workbench-header"><brand-header id="management-workbench-header" divider="{{true}}" account-font="{{true}}" title="{{deskTitle}}"/></view><view class="content">
<block wx:if="{{guest}}">
<view class="guest-search-box"><image src="/assets/search.png" mode="aspectFit"/><input value="{{guestKeyword}}" bindinput="searchGuest" placeholder="搜索项目、客户或管理事项" placeholder-class="guest-search-placeholder" confirm-type="search" maxlength="60" aria-label="搜索项目、客户或管理事项"/><button wx:if="{{guestKeyword}}" class="guest-search-clear" bindtap="clearGuestSearch" aria-label="清空搜索"><image src="/assets/studio-clear.png" mode="aspectFit"/></button></view>
<view wx:if="{{guestHasSearch&&!guestResultCount}}" class="section guest-search-empty"><text>没有找到匹配内容</text><text class="hint">试试客户姓名、项目或事项关键词</text><button class="outline" bindtap="clearGuestSearch">重置搜索</button></view>

<view wx:if="{{!guestHasSearch}}" class="section guest-section"><view class="section-heading"><text class="section-title">经营摘要</text><button class="guest-section-link" data-key="data" bindtap="preview">查看数据 ›</button></view><text class="guest-period">{{monthText}}</text><view class="guest-stats"><view><text class="guest-stat-label">有效已收</text><text class="guest-stat-value">{{summary.income}}<text>万</text></text></view><view><text class="guest-stat-label">有效已付</text><text class="guest-stat-value">{{summary.paid}}<text>万</text></text></view><view><text class="guest-stat-label">收支结余</text><text class="guest-stat-value">{{summary.balance}}<text>万</text></text></view></view><text class="guest-footnote">收支结余为有效已收减有效已付，不代表项目利润。</text></view>
<view wx:if="{{!guestHasSearch||guestVisibleTodos.length}}" class="section guest-section"><view class="section-heading"><text class="section-title">重点待办</text><button class="guest-section-link" data-key="todos" bindtap="preview">全部待办 ›</button></view><view wx:if="{{!guestHasSearch}}" class="guest-counts"><text>待核算 <text>{{financeCounts.reconcile}}</text></text><text>待办理 <text>{{financeCounts.pay}}</text></text><text>待核实 <text>{{financeCounts.verify}}</text></text></view><button wx:for="{{guestVisibleTodos}}" wx:key="key" class="guest-todo" data-key="todos" bindtap="preview"><image src="/assets/management-{{item.icon}}.jpg"/><view class="grow"><view class="guest-todo-heading"><text>{{item.name}}</text><text class="guest-status">{{item.status}}</text></view><text class="guest-todo-amount">¥ {{item.amount}}</text><text class="guest-footnote">{{item.note}}</text></view><text class="guest-chevron">›</text></button></view>
<view wx:if="{{!guestHasSearch||guestVisibleProjects.length}}" class="section guest-section"><view class="section-heading"><text class="section-title">重点项目</text><button class="guest-section-link" data-key="projects" bindtap="preview">全部项目 ›</button></view><button wx:for="{{guestVisibleProjects}}" wx:key="id" class="guest-project" data-key="projects" bindtap="preview"><image src="/assets/house.png"/><view class="grow"><view class="guest-project-heading"><text>{{item.name}}</text><text class="guest-status">{{item.status}}</text></view><text class="guest-footnote">{{item.note}}</text></view><text class="guest-chevron">›</text></button></view>
<view wx:if="{{!guestHasSearch||guestVisibleMenu.length}}" class="section guest-section guest-common"><view class="section-heading"><text class="section-title">常用功能</text></view><view class="menu-grid guest-menu"><button wx:for="{{guestVisibleMenu}}" wx:key="key" class="guest-entry" data-key="{{item.key}}" bindtap="preview"><image src="/assets/{{item.icon}}.png"/><text>{{item.label}}</text><text>›</text></button></view></view>
<button class="primary guest-login-button" bindtap="loginPreview">登录后查看本人工作台</button>
</block>
<block wx:elif="{{allowed}}">
<view class="guest-search-box staff-search-box"><image src="/assets/search.png" mode="aspectFit"/><input value="{{staffKeyword}}" bindinput="searchStaff" placeholder="搜索待办、项目或办理事项" placeholder-class="guest-search-placeholder" confirm-type="search" maxlength="60" aria-label="搜索本人待办与办理事项"/><button wx:if="{{staffKeyword}}" class="guest-search-clear" bindtap="clearStaffSearch" aria-label="清空搜索"><image src="/assets/studio-clear.png" mode="aspectFit"/></button></view>
<view wx:if="{{staffHasSearch&&!staffResultCount}}" class="section guest-search-empty"><text>没有找到匹配内容</text><text class="hint">试试客户、款项或功能名称</text><button class="outline" bindtap="clearStaffSearch">重置搜索</button></view>
<view wx:if="{{!staffHasSearch||visibleFinanceTodos.length}}" class="section staff-todos"><view class="section-heading"><text class="section-title">今日待办</text><button class="guest-section-link" data-view="todos" bindtap="go">全部待办 ›</button></view><button wx:for="{{visibleFinanceTodos}}" wx:key="key" class="todo finance-todo" data-url="{{item.url}}" data-view="{{item.view}}" data-id="{{item.id}}" data-area="{{item.area}}" data-record="{{item.record}}" bindtap="go"><image src="/assets/management-receipt.jpg"/><view class="grow"><text>{{item.name}}</text><text class="amount">{{item.amount}}</text><text class="hint">{{item.status}}</text></view><text class="mini-solid">去办理</text></button><text wx:if="{{!visibleFinanceTodos.length}}" class="hint">当前暂无需要本人处理的事项</text></view>
<view wx:if="{{!staffHasSearch}}" class="section staff-summary"><view class="section-heading"><text class="section-title">经营摘要</text><button class="guest-section-link" data-view="finance" bindtap="go">收支明细 ›</button></view><text class="guest-period">{{monthText}}</text><view class="guest-stats"><view><text class="guest-stat-label">有效已收</text><text class="guest-stat-value">{{displaySummary.income}}<text>万</text></text></view><view><text class="guest-stat-label">有效已付</text><text class="guest-stat-value">{{displaySummary.paid}}<text>万</text></text></view><view><text class="guest-stat-label">收支结余</text><text class="guest-stat-value">{{displaySummary.balance}}<text>万</text></text></view></view><text class="hint">待核算、待复核与退回补证中的款项不计入有效累计。收支结余不代表项目利润。</text></view>
<view wx:if="{{!staffHasSearch||visibleMenu.length}}" class="section staff-common"><view class="section-heading"><text class="section-title">常用功能</text></view><view class="menu-grid staff-menu"><button wx:for="{{visibleMenu}}" wx:key="key" data-url="{{item.url}}" data-view="{{item.view}}" data-task-type="{{item.taskType}}" data-area="{{item.area}}" bindtap="go"><image src="/assets/{{item.icon}}.png"/><view class="grow"><text class="staff-menu-title">{{item.label}}</text><text wx:if="{{item.description}}" class="hint">{{item.description}}</text></view><text wx:if="{{item.count}}" class="staff-menu-count">{{item.count}}</text><text class="brown">›</text></button></view></view>
</block>
<view wx:else class="section workbench-denied"><text class="section-title">{{loggedIn?'当前身份无管理工作台权限':'登录后查看管理工作台'}}</text><text>当前身份：{{role||'访客'}}</text><text>团队经营数据、财务汇总和管理审批按岗位授权开放。本人客户及移交进度请在业务工作台查看。</text><button wx:if="{{active}}" class="primary return-workbench" bindtap="goHome">返回{{homeTitle}}</button><button wx:else class="primary" bindtap="identity">{{loggedIn?'选择有效工作身份':'登录后继续'}}</button></view><text wx:if="{{allowed&&!guest}}" class="snapshot"><text bindtap="identity">工作身份 ›</text></text></view><view wx:if="{{guest&&guestDetail}}" class="guest-modal-mask" catchtap="closePreview" catchtouchmove="noop"><view class="guest-modal" catchtap="noop" aria-role="dialog" aria-label="{{guestDetail.label}}"><view class="guest-modal-heading"><text>{{guestDetail.label}}</text><button class="guest-modal-close" bindtap="closePreview" aria-label="关闭功能预览">×</button></view><text class="guest-modal-copy">{{guestDetail.text}}</text><text class="guest-footnote">登录后按岗位权限使用相应功能。</text><view class="guest-modal-actions"><button class="guest-modal-back" bindtap="closePreview">继续浏览</button><button class="primary" bindtap="loginPreview">登录后使用</button></view></view></view></view>
