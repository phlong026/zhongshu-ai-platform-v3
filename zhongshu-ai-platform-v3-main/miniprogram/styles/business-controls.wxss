@import "./business-tokens.wxss";
.workflow .customer-banner.project-compact .name{white-space:normal;flex-wrap:wrap;gap:6rpx 12rpx}.workflow .customer-banner.project-compact .customer-name{overflow-wrap:break-word;min-width:0}.workflow .customer-banner.project-compact .quote-phone{flex-shrink:0}
.overlay.business-surface{--biz:var(--business-brand);--muted:var(--business-muted);--soft:var(--business-soft);--line:var(--business-line);font-family:var(--business-font);font-size:28rpx;line-height:42rpx}.overlay.business-surface .sheet-head{font-size:32rpx;line-height:46rpx}.overlay.business-surface .btn{background:var(--business-brand);border-color:var(--business-brand);min-height:88rpx;border-radius:14rpx;font-size:28rpx;line-height:42rpx}
.workflow .customer-banner.project-compact{padding:18rpx 22rpx}.workflow .customer-banner.project-compact .banner-main{min-height:76rpx;gap:18rpx}.workflow .customer-banner.project-compact .initial{width:76rpx;height:76rpx;line-height:76rpx;font-size:34rpx;flex-shrink:0}.workflow .customer-banner.project-compact .name{padding-right:0}.workflow .customer-banner.project-compact .banner-badge{position:static;margin-left:auto;flex-shrink:0}.workflow .customer-banner.project-compact .banner-line{font-size:24rpx;line-height:36rpx;margin-top:4rpx;color:var(--business-muted)}
.workflow.workflow .operation-identity{font-size:24rpx;line-height:36rpx;padding:8rpx 0;background:transparent;color:var(--business-muted);margin-bottom:12rpx}.workflow .task-summary{border-left:5rpx solid var(--business-brand)}.task-summary>view{display:flex;align-items:flex-start;gap:18rpx}.task-label{font-size:24rpx;line-height:38rpx;color:var(--business-muted);flex-shrink:0}.task-state{font-size:28rpx;line-height:40rpx;font-weight:500}.task-summary>.muted{display:block;margin-top:6rpx}.project-utilities{display:flex;justify-content:flex-end;gap:28rpx;padding:0 4rpx 18rpx}.project-utilities button{font-size:24rpx;line-height:40rpx;color:var(--business-brand);padding:4rpx 0}
.workflow .input-row.stacked{display:flex;flex-direction:column;align-items:stretch;gap:12rpx;margin:14rpx 0 24rpx}.workflow .input-row.stacked>.label{width:auto;min-width:0;white-space:normal;color:var(--business-muted)}.workflow .textarea-field{margin:12rpx 0 24rpx}.workflow .textarea-field>.field-label{display:block;font-size:26rpx;line-height:40rpx;color:var(--business-muted);margin:0 0 12rpx}.workflow .textarea-field .textarea{width:100%;min-height:152rpx;height:180rpx}.workflow .file-row .file-name{display:block;white-space:normal;overflow-wrap:anywhere;line-height:38rpx}.workflow .record-main .badge{font-size:22rpx}.workflow.workflow .card{margin-bottom:var(--business-space)}.workflow.workflow .muted,.workflow.workflow .hint{color:var(--business-muted)}.workflow.workflow .check-row{font-size:26rpx;line-height:40rpx;min-height:64rpx;color:var(--business-muted);padding:12rpx 0}.workflow .checkbox-image{width:38rpx;height:38rpx}.workflow .checklist .link,.workflow .steps .link{min-height:64rpx;min-width:84rpx}
.budget-result-surface{font-family:var(--business-font);font-size:28rpx;line-height:42rpx;color:var(--business-ink);padding-bottom:160rpx}.budget-result-surface .card.section{background:#fff;border:1rpx solid var(--business-line);border-radius:var(--business-radius);padding:22rpx;margin:0 0 var(--business-space)}.budget-result-surface .heading{position:relative;display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding-left:18rpx;min-height:46rpx;margin:0 0 18rpx;font-family:inherit;font-size:32rpx;line-height:46rpx;font-weight:600}.budget-result-surface .heading::before{content:'';position:absolute;left:0;top:10rpx;width:6rpx;height:28rpx;border-radius:4rpx;background:var(--business-brand)}.budget-result-surface .heading .amount{font-size:28rpx;color:var(--business-brand);line-height:42rpx;white-space:nowrap}.budget-result-surface .heading .badge{font-size:22rpx;line-height:32rpx;font-weight:400;color:var(--business-brand);background:var(--business-soft);border-radius:8rpx;padding:2rpx 12rpx;white-space:nowrap}.budget-result-surface .budget-total{text-align:center;font-size:58rpx;font-weight:600;line-height:80rpx;color:var(--business-brand);padding:12rpx 0}.budget-result-surface .muted{display:block;color:var(--business-muted);font-size:24rpx;line-height:36rpx}.budget-result-surface .centered{text-align:center}.budget-result-surface .stats{display:flex;border-top:1rpx solid var(--business-line);margin-top:24rpx;padding-top:20rpx}.budget-result-surface .stats>view{flex:1;padding:0 14rpx}.budget-cost{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid var(--business-line)}.budget-cost:last-child{border-bottom:0}.budget-cost>view{flex:1;min-width:0}.budget-cost>view>text{display:block}.budget-cost>text{white-space:nowrap}.budget-explanation{margin-top:18rpx}.budget-linked{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid var(--business-line)}.budget-linked .link{font-size:24rpx;color:var(--business-brand);min-height:64rpx}.budget-result-surface .quote-export-entry{margin-top:18rpx;width:100%}
.budget-result-surface .btn,.workflow.workflow .footer .btn{display:flex;align-items:center;justify-content:center;min-height:88rpx;line-height:42rpx;padding:12rpx 18rpx;border-radius:14rpx;font-size:28rpx;font-weight:500;background:var(--business-brand);color:#fffaf3;border:1rpx solid var(--business-brand);font-family:var(--business-font)}.budget-result-surface .outline.btn,.workflow.workflow .footer .outline.btn{background:#fff;color:var(--business-brand)}.budget-action-bar{position:fixed;left:0;right:0;bottom:0;z-index:80;display:flex;gap:16rpx;padding:14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));background:var(--business-paper);border-top:1rpx solid var(--business-line)}.budget-action-bar>.btn{flex:1;min-width:0}.budget-action-bar>.outline.btn{flex:.6}.budget-action-bar>.budget-next{margin-top:0}
@media(max-width:360px){.budget-result-surface .heading{font-size:30rpx}.workflow .customer-banner.project-compact .banner-main{flex-wrap:wrap}.workflow .customer-banner.project-compact .banner-badge{margin-left:94rpx}.budget-action-bar .btn{font-size:26rpx}}
.quote-draft-total{margin-top:22rpx;padding:20rpx;background:var(--business-soft);border-radius:14rpx}.quote-draft-total>text{display:block}.quote-draft-total>text:last-child{font-size:44rpx;line-height:62rpx;font-weight:600;color:var(--business-brand)}.workflow .customer-banner.project-compact .quote-phone{position:static;margin:10rpx 0 0 94rpx}.workflow.view-quote .customer-banner.project-compact .banner-info{padding-right:0}.workflow .customer-banner.project-compact .demo-badge{display:none}

.workflow.view-quote .customer-banner.project-compact .banner-main{flex-wrap:wrap}.workflow.view-quote .customer-banner.project-compact .quote-phone{flex-basis:calc(100% - 94rpx);margin-top:0}
