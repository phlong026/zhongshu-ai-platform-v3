@import "business-tokens.wxss";
.design-desk{font-family:ZSDashboard,var(--business-font);background:var(--business-paper);line-height:40rpx}.design-content{padding:20rpx 28rpx}.design-page-intro{margin:0 4rpx 24rpx}.design-heading{display:block;font-size:34rpx;line-height:50rpx;font-weight:600}.design-muted{display:block;font-size:24rpx;line-height:36rpx;color:var(--business-muted);overflow-wrap:anywhere}.design-search{display:flex;align-items:center;gap:16rpx;min-height:88rpx;padding:16rpx 22rpx;border-radius:18rpx;background:#fff;border:1rpx solid var(--business-line);margin-bottom:22rpx}.design-search>image{width:32rpx;height:32rpx;flex-shrink:0}.design-search>input{flex:1;min-width:0;font-size:26rpx}.design-filters{width:100%;margin-bottom:24rpx;white-space:nowrap}.design-filters>view{display:flex;gap:14rpx}.design-chip{display:inline-flex;flex-shrink:0;align-items:center;min-height:88rpx;padding:10rpx 24rpx;border-radius:14rpx;background:#fff;color:#6e737c;font-size:25rpx;border:1rpx solid var(--business-line)}.design-chip.selected{background:#f1e5d5;border-color:#d9c3a7;color:var(--business-brand)}.design-desk .design-card{background:#fff;border:1rpx solid var(--business-line);border-radius:22rpx;padding:24rpx;margin-bottom:22rpx}.design-project-heading{display:flex;align-items:center;gap:20rpx;justify-content:space-between;text-align:left;width:100%;margin-bottom:16rpx}.design-project-heading>view{flex:1;min-width:0}.design-name{display:block;font-size:29rpx;line-height:43rpx;font-weight:600;overflow-wrap:anywhere}.design-arrow{width:14rpx;height:24rpx;flex-shrink:0}.design-state{display:inline-block;font-size:24rpx;line-height:36rpx;padding:6rpx 12rpx;background:#f7f1e8;color:var(--business-brand);border-radius:8rpx;margin-bottom:16rpx}.design-meta{display:flex;gap:20rpx;justify-content:space-between;font-size:25rpx;line-height:38rpx;margin:8rpx 0}.design-meta>text:first-child{color:var(--business-muted);flex-shrink:0}.design-meta>text:last-child{text-align:right;overflow-wrap:anywhere}.design-primary{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:16rpx 22rpx;background:var(--business-brand);color:#fff;border-radius:16rpx;font-size:28rpx;line-height:40rpx}.design-project-action{width:100%;margin-top:22rpx}.design-secondary{background:#faf7f2;color:var(--business-brand);border:1rpx solid #e6daca}.design-empty{padding:64rpx 24rpx;text-align:center;background:#fff;border-radius:22rpx}.design-empty>text{display:block;margin-bottom:14rpx}.design-version-options{display:flex;gap:22rpx;align-items:center;justify-content:flex-end;margin:0 0 24rpx}.design-version-options>button{min-height:88rpx;display:flex;align-items:center;font-size:24rpx;color:var(--business-muted)}.design-version-options>button.selected{color:var(--business-brand);border-bottom:3rpx solid var(--business-brand)}.design-file-top{display:flex;justify-content:space-between;gap:20rpx;font-size:23rpx;line-height:36rpx}.design-file-type{color:var(--business-muted)}.design-status{color:var(--business-brand);flex-shrink:0}.design-file-open{width:100%;display:flex;align-items:center;gap:18rpx;text-align:left;padding:22rpx 0}.design-file-open>image:first-child{width:54rpx;height:54rpx;flex-shrink:0}.design-file-open>view{flex:1;min-width:0}.design-file-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding-top:12rpx;border-top:1rpx solid var(--business-line)}.design-file-footer>button{color:var(--business-brand);font-size:24rpx;min-height:88rpx;display:flex;align-items:center;flex-shrink:0}.design-preview-mask{position:fixed;inset:0;background:rgba(30,23,16,.38);display:flex;align-items:center;justify-content:center;padding:28rpx;z-index:200}.design-preview{background:#fffdfa;border-radius:24rpx;padding:32rpx;width:100%;max-height:80vh;overflow:auto}.design-preview-text{display:block;white-space:pre-wrap;font-size:26rpx;line-height:42rpx;margin:24rpx 0 32rpx}.design-greeting{display:flex;justify-content:space-between;gap:16rpx;align-items:center;margin-bottom:24rpx}.design-greeting>view{min-width:0}.design-role{color:var(--business-brand);font-size:23rpx;line-height:34rpx}.design-metrics{display:flex;gap:16rpx;margin-bottom:26rpx}.design-metric{flex:1;min-width:0;text-align:left;background:#fff;border:1rpx solid var(--business-line);border-radius:20rpx;padding:20rpx}.design-metric:first-child{background:#f3e7d7;border-color:#e5d4bc}.design-metric>text{display:block;color:#74695c;font-size:24rpx;line-height:36rpx}.design-metric .design-number{font-size:48rpx;line-height:66rpx;color:#543621;font-weight:600;margin-top:10rpx}.design-desk .design-section{background:#fff;border:1rpx solid var(--business-line);border-radius:22rpx;padding:22rpx;margin-bottom:24rpx}.design-desk .section-title{font-family:inherit;font-size:30rpx;line-height:42rpx;letter-spacing:0}.design-task{border-bottom:1rpx solid var(--business-line);padding:20rpx 0}.design-task:last-child{border-bottom:0;padding-bottom:0}.design-task .design-state{margin-top:12rpx}.design-task .design-primary{margin-top:20rpx}.design-task+.design-task .design-primary{background:#faf7f2;border:1rpx solid #e6daca;color:var(--business-brand)}.design-home-tools{display:flex;gap:18rpx;margin-top:16rpx}.design-home-tools>button{flex:1;display:flex;align-items:center;gap:16rpx;background:#faf8f4;padding:24rpx 18rpx;border-radius:16rpx;font-size:26rpx;text-align:left}.design-home-tools image{width:48rpx;height:48rpx;flex-shrink:0}.design-inline-file{display:flex;width:100%;gap:16rpx;align-items:center;text-align:left;padding:20rpx 0;border-bottom:1rpx solid var(--business-line)}.design-inline-file:last-child{border:0}.design-inline-file>view{flex:1;min-width:0}.design-profile .profile-role{white-space:normal}.design-profile .profile-card{height:auto;min-height:176rpx}.design-profile .service-row{min-height:96rpx;height:auto;padding-top:20rpx;padding-bottom:20rpx}.design-profile .design-profile-note{margin:12rpx 8rpx 26rpx}.design-profile .quick-card{height:116rpx}

.design-page-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.design-page-heading .text-link{min-height:88rpx;flex-shrink:0}

.business-page .design-content{padding:20rpx 28rpx}.design-profile .profile-role{color:#6e737c}

.design-desk .section-heading .text-link{min-height:88rpx;padding:0 8rpx}
