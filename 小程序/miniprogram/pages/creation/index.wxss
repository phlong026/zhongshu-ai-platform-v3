@import '../../styles/workbench.wxss';
@import '../../styles/creation.wxss';
.center-page.center-page{padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}.creation-modes{display:flex;gap:12rpx;margin:0 0 28rpx}.creation-mode{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10rpx;padding:20rpx 4rpx;background:var(--sales-paper);border-radius:14rpx;color:var(--sales-ink)}.creation-mode>image{width:56rpx;height:56rpx}.creation-mode>text{font-size:28rpx;line-height:42rpx;font-weight:500;white-space:nowrap}.creation-mode>text.creation-mode-hint{font-size:22rpx;line-height:32rpx;font-weight:400;color:var(--sales-muted)}.creation-mode.selected{background:var(--sales-brand);color:#fffaf3}.creation-mode.selected>image{filter:brightness(0) invert(1)}.creation-mode.selected>text.creation-mode-hint{color:#f0e3d5}.sales-page .remix-heading{margin-bottom:8rpx}.remix-subtitle{display:block;margin-bottom:20rpx}.share-input{display:flex;align-items:center;gap:12rpx;min-height:90rpx;padding:10rpx 12rpx;background:var(--sales-paper);border-radius:14rpx}.link-icon{width:36rpx;height:36rpx;flex-shrink:0}.link-input{flex:1;min-width:0;height:58rpx;font-size:26rpx}.paste-button{display:flex;align-items:center;justify-content:center;width:110rpx;min-height:68rpx;border:1rpx solid var(--sales-brand);border-radius:12rpx;color:var(--sales-brand);font-size:26rpx;flex-shrink:0}.demo-video-picker{display:block;margin:12rpx 0 20rpx}.demo-video-picker>view{display:flex;align-items:center;gap:14rpx;font-size:23rpx;line-height:36rpx;min-height:56rpx;color:var(--sales-muted)}.demo-video-picker text:nth-child(2){flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--sales-brand)}.sales-page .extract-button{width:100%;min-height:84rpx;border-radius:14rpx;font-size:28rpx;font-weight:500}.manual-link{display:flex;align-items:center;justify-content:center;gap:10rpx;min-height:70rpx;margin-top:6rpx;font-size:26rpx;color:var(--sales-brand)}.shortcuts{display:flex;gap:10rpx}.shortcut{flex:1;min-width:0;display:flex;align-items:center;flex-direction:column;gap:14rpx;padding:18rpx 2rpx;background:var(--sales-paper);border-radius:12rpx;font-size:24rpx;line-height:36rpx;white-space:nowrap}.shortcut>image{width:50rpx;height:50rpx}.recent-row{display:flex;align-items:center;gap:16rpx;min-height:128rpx;padding:20rpx 0;border-bottom:1rpx solid var(--sales-line)}.recent-row:last-child{border:0;padding-bottom:0}.recent-cover{width:150rpx;height:112rpx;border-radius:14rpx;flex-shrink:0}.recent-copy{flex:1;min-width:0}.recent-copy>text{display:block}.recent-title{font-size:28rpx;font-weight:500;line-height:42rpx;overflow-wrap:anywhere}.recent-action{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;min-height:68rpx;color:var(--sales-brand);font-size:23rpx;white-space:nowrap}.center-page .creation-sheet-header{font-size:32rpx;line-height:46rpx}
.demo-video-row{display:flex;align-items:center;gap:14rpx;font-size:23rpx;line-height:36rpx;min-height:56rpx;color:var(--sales-muted)}.demo-video-row .demo-video-title{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--sales-brand)}.recent-title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
