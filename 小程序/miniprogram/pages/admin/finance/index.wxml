<view class="owner-page"><owner-header title="经营"/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-card"><view class="owner-heading"><text>应收应付与成本</text><button class="owner-link" data-action="operating" bindtap="go">财务办理</button></view><view class="owner-statistics"><button class="owner-stat" data-action="receivables" bindtap="go"><text class="owner-stat-label">客户未收</text><text class="owner-name">{{desk.operating.receivable}}</text></button><button class="owner-stat" data-action="costs" bindtap="go"><text class="owner-stat-label">合同预计毛利</text><text class="owner-name">{{desk.operating.profit}}</text></button></view></view><view class="owner-tabs"><button class="{{financeTab==='summary'?'selected':''}}" data-tab="summary" bindtap="tab">收支总览</button><button class="{{financeTab==='projects'?'selected':''}}" data-tab="projects" bindtap="tab">项目账目</button></view>
<view class="owner-period"><text class="owner-muted">{{desk.company}}</text><picker mode="date" fields="month" value="{{desk.period}}" bindchange="month"><view>{{desk.periodLabel}}<image class="owner-arrow owner-select-icon" src="/assets/creation-chevron.png"/></view></picker></view>
<view class="owner-search"><image src="/assets/search.png" mode="aspectFit"/><input class="owner-search-input" value="{{keyword}}" placeholder="搜索客户或项目" bindinput="search" aria-label="搜索客户或项目"/><button wx:if="{{keyword}}" class="owner-search-clear" bindtap="clear">清空</button></view>
<view class="owner-card"><view class="owner-statistics"><view class="owner-stat"><text class="owner-stat-label">有效实收</text><text class="owner-number">{{desk.income}}<text class="owner-unit">万</text></text></view><view class="owner-stat"><text class="owner-stat-label">有效已付</text><text class="owner-number">{{desk.paid}}<text class="owner-unit">万</text></text></view><view class="owner-stat"><text class="owner-stat-label">收支结余</text><text class="owner-number">{{desk.balance}}<text class="owner-unit">万</text></text></view></view><view class="owner-keyline owner-finance-note"><text wx:if="{{desk.sample}}" class="owner-badge">示例数据</text><text class="owner-muted">按有效账簿统计，结余不代表利润</text></view></view>
<view wx:if="{{financeTab==='projects'}}" class="owner-card"><view class="owner-heading"><text>项目账目</text><text class="owner-heading-meta">共{{projects.length}}个</text></view><view wx:for="{{projects}}" wx:key="key" class="owner-row"><image class="owner-thumb" src="{{item.image}}" mode="aspectFill"/><view class="owner-grow"><text class="owner-name">{{item.name}}</text><view class="owner-project-totals">本月实收 <text>{{item.income}}万</text> · 已付 <text>{{item.paid}}万</text></view><text wx:if="{{item.waiting||item.pending}}" class="owner-badge">{{item.waiting?'待审批'+item.waiting+'笔':'待核算'+item.pending+'笔'}}</text></view><button class="owner-outline" data-key="{{item.key}}" bindtap="go">查看账目</button></view><view wx:if="{{!projects.length}}" class="owner-empty">{{keyword?'没有找到匹配的项目':'当前暂无项目账目'}}</view></view>
<view wx:else class="owner-card"><view class="owner-heading"><text>财务办理进度</text><button class="owner-link" data-action="financeProgress" bindtap="go">查看全部<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><view class="owner-statistics"><view class="owner-stat"><text class="owner-number">{{desk.approvalCount}}</text><text class="owner-stat-label">待我审批</text></view><view class="owner-stat"><text class="owner-number">{{desk.reconcileCount}}</text><text class="owner-stat-label">待核算</text></view><view class="owner-stat"><text class="owner-number">{{desk.reviewCount}}</text><text class="owner-stat-label">待付款复核</text></view></view><view wx:for="{{desk.previewQueue}}" wx:key="key" class="owner-row"><view class="owner-grow"><text class="owner-name">{{item.name}}</text><text class="owner-muted">{{item.status}} · {{item.amount}}</text></view><button class="owner-outline" data-key="{{item.key}}" bindtap="go">查看</button></view><view wx:if="{{!desk.queue.length}}" class="owner-empty">当前暂无待核算或待复核记录</view></view>
<view class="owner-card owner-keyline"><view class="owner-grow"><text class="owner-name">待我审批 <text class="owner-badge">{{desk.approvalCount}}项</text></text><text class="owner-muted">报价、服务费与付款按原事项办理</text></view><button class="owner-primary" data-action="approvals" bindtap="go">去审批</button></view>
<view class="owner-card"><view class="owner-heading"><text>常用功能</text></view><view class="owner-tools"><button class="owner-tool" data-action="receipts" bindtap="go"><view class="owner-tool-icon"><image src="/assets/money.png" mode="aspectFit"/></view><text>收款记录</text></button><button class="owner-tool" data-action="approvals" bindtap="go"><view class="owner-tool-icon"><image src="/assets/management-payment.jpg" mode="aspectFit"/></view><text>付款审批</text></button><button class="owner-tool" data-action="reports" bindtap="go"><view class="owner-tool-icon"><image src="/assets/chart.png" mode="aspectFit"/></view><text>经营报表</text></button></view></view>
</block></view><owner-nav id="owner-navigation" active="finance"/></view>
