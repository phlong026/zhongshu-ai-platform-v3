<admin-header id="subpage-header" title="{{title}}"/>
<view class="admin view-{{view}}" style="padding-top:calc({{statusHeight}}px + 96rpx)"><demo-guide id="demo-guide"/>
<view wx:if="{{missing}}" class="card empty"><text>记录不存在或当前无权访问</text><view class="page-actions"><button class="solid" data-handler="home" bindtap="home">返回管理工作台</button></view></view>
<block wx:else>
<view wx:if="{{tabs}}" class="tabs {{view==='data'?'seg':''}}"><button wx:for="{{tabs}}" wx:key="*this" class="{{(view==='data'?form.dataTab:form.tab||tabs[0])===item?'active':''}}" data-value="{{item}}" data-handler="tab" bindtap="tab">{{item}}</button></view>
<view wx:if="{{snapshot}}" class="snapshot">{{snapshot}} <text>⌄</text></view>
<input wx:if="{{view==='finance'||view==='todos'||view==='staff'}}" class="search" placeholder="⌕ 搜索客户、姓名或事项" value="{{form.keyword}}" bindinput="search"/>
<view wx:if="{{hero}}" class="card hero"><image wx:if="{{hero.avatarImage}}" class="avatar" src="{{hero.avatarImage}}" mode="aspectFill"/><view wx:elif="{{hero.avatar}}" class="avatar initial-avatar">{{hero.title[0]}}</view><image wx:else src="/assets/management-receipt.jpg" mode="aspectFit" class="hero-icon"/><view class="hero-copy"><text class="hero-title">{{hero.title}}</text><text wx:if="{{hero.amount}}" class="hero-money">{{hero.amount}}</text><text class="hint">{{hero.desc}}</text></view></view>
<view wx:for="{{sections}}" wx:key="index" wx:for-item="section" class="card section-{{index}} {{section.grid?'finance-grid':''}}"><view wx:if="{{section.title}}" class="heading"><text>{{section.title}}</text><picker wx:if="{{view==='finance'&&index===0}}" class="month-picker" mode="date" fields="month" value="{{period}}" bindchange="monthChange"><text>{{periodLabel}} ⌄</text></picker><text wx:if="{{section.meta}}" class="meta">{{section.meta}}</text></view>
<block wx:for="{{section.rows}}" wx:key="index" wx:for-item="item">
<button wx:if="{{item.type==='fund-card'}}" class="fund-card {{item.wide?'wide':''}}" data-view="{{item.view}}" data-id="{{item.id}}" bindtap="go"><image src="/assets/management-receipt.jpg" mode="aspectFit"/><view><text class="fund-status">{{item.status}} · {{item.label}}</text><text class="fund-amount">{{item.amount}}<text wx:if="{{item.note}}" class="fund-note"> · {{item.note}}</text></text></view></button>
<view wx:elif="{{item.type==='estimate'}}" class="estimate-row"><image src="/assets/account-chart.jpg" mode="aspectFit"/><text>{{item.value}}</text></view>
<view wx:elif="{{item.type==='stats'}}" class="stats"><view wx:for="{{item.values}}" wx:key="label" wx:for-item="stat"><text class="stat-value">{{stat.value}}</text><text class="hint">{{stat.label}}</text></view></view>
<view wx:elif="{{item.type==='row'}}" class="row"><text class="label">{{item.label}}</text><text class="value {{item.value[0]==='¥'?'money-value':''}}">{{item.value}}</text></view>
<button wx:elif="{{item.type==='link'}}" class="item-link" data-view="{{item.view}}" data-id="{{item.id}}" data-url="{{item.url}}" data-area="{{item.area}}" data-record="{{item.record}}" data-handler="go" bindtap="go"><view wx:if="{{item.icon==='staff'}}" class="staff-initial">{{item.label[0]}}</view><image wx:else src="{{item.icon&&item.icon!=='finance'?'/pages/admin/assets/'+item.icon+'.jpg':'/assets/management-receipt.jpg'}}" mode="aspectFit"/><view class="grow"><text class="item-title">{{item.label}}</text><text wx:if="{{item.subtitle}}" class="hint">{{item.subtitle}}</text></view><text class="arrow">›</text></button>
<view wx:elif="{{item.type==='notice'}}" class="notice">ⓘ {{item.value}}</view>
<view wx:elif="{{item.type==='input'}}" class="row"><text class="label">{{item.label}}</text><picker wx:if="{{item.inputType==='date'}}" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="pickDate"><text>{{form[item.key]||item.placeholder}}　⌄</text></picker><input wx:else type="{{item.inputType}}" value="{{form[item.key]}}" placeholder="{{item.placeholder}}" data-key="{{item.key}}" bindinput="input"/></view>
<textarea wx:elif="{{item.type==='textarea'}}" class="textarea" placeholder="{{item.placeholder}}" value="{{form[item.key]}}" maxlength="500" data-key="{{item.key}}" bindinput="input"/>
<view wx:elif="{{item.type==='upload'}}" class="upload-row"><button class="upload" data-key="{{item.key}}" data-handler="upload" bindtap="upload"><text class="plus">＋</text><text class="upload-caption">{{form[item.key]?'重新选择':item.label}}</text></button><text class="hint">{{form[item.key].name||'尚未上传'}}</text></view>
<button wx:elif="{{item.type==='check'}}" class="check-row" data-key="{{item.key}}" data-handler="toggle" bindtap="toggle"><text class="checkbox {{form[item.key]?'checked':''}}">{{form[item.key]?'✓':''}}</text><text>{{item.label}}</text></button>
<view wx:elif="{{item.type==='radio'}}"><button wx:for="{{item.values}}" wx:key="*this" wx:for-item="choice" class="radio {{form[item.key]===choice?'selected':''}}" data-key="{{item.key}}" data-value="{{choice}}" data-handler="select" bindtap="select"><text>{{form[item.key]===choice?'●':'○'}}</text>{{choice}}</button></view>
<view wx:elif="{{item.type==='picker'}}"><text class="hint">{{item.label}}</text><picker range="{{item.options}}" range-key="name" data-key="{{item.key}}" data-options="{{item.options}}" bindchange="pick"><view class="picker">{{selectedLabels[item.key]||'请选择在岗接替人'}} <text>⌄</text></view></picker></view>
<button wx:elif="{{item.type==='picture'}}" class="picture" data-src="{{item.src}}" data-file="{{item.file}}" data-handler="preview" bindtap="preview"><image src="{{item.src}}" mode="aspectFit"/><text>查看原图 ›</text></button>
<view wx:elif="{{item.type==='metric'}}" class="metric"><image src="/assets/management-receipt.jpg" mode="aspectFit"/><view class="grow"><text class="strong">{{item.label}}</text><text class="metric-value">目标 {{item.value}}</text></view><text class="metric-weight">{{item.secondary}}</text></view>
<view wx:elif="{{item.type==='progress'}}" class="progress-card"><view class="circle">{{item.value}}%</view><view><text class="hint">目标</text><text class="target">{{item.target}}%</text></view><text class="progress-caption">已按期 {{item.numerator}} 项 / 到期 {{item.denominator}} 项</text></view>
<button wx:elif="{{item.type==='action'}}" class="row action-row" data-action="{{item.action}}" data-handler="rowAction" bindtap="rowAction">{{item.label}} <text>›</text></button>
</block><text wx:if="{{!section.rows.length}}" class="empty">暂无记录</text></view>
<view wx:if="{{roleChoices}}" class="section role-choices"><text class="section-title">选择岗位（可兼任）</text><button wx:for="{{roleChoices}}" wx:key="id" class="check-row" data-role="{{item.id}}" bindtap="toggleRole">{{item.checked?'☑':'□'}} {{item.name}}</button></view><view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:if="{{primary}}" class="footer page-actions"><button wx:if="{{secondary}}" class="outline" data-handler="secondary" bindtap="secondary">{{secondary}}</button><button class="solid {{busy||action==='reconcile'&&!form.checked||(action==='pay'||action==='verify')&&(!form.file||!form.checked)?'is-disabled':''}}" loading="{{busy}}" disabled="{{busy||action==='reconcile'&&!form.checked||(action==='pay'||action==='verify')&&(!form.file||!form.checked)}}" data-handler="submit" bindtap="submit">{{primary}}</button></view>
</block></view>
<view wx:if="{{modal}}" class="overlay" data-handler="closeModal" bindtap="closeModal"><view class="sheet" catchtap="noop"><button class="close" data-handler="closeModal" bindtap="closeModal">×</button><text class="large">{{modal.title}}</text><text wx:if="{{modal.text}}" class="body">{{modal.text}}</text><image wx:if="{{modal.src}}" class="preview-image" src="{{modal.src}}" mode="widthFix"/><textarea wx:if="{{modal.type==='reason'}}" class="textarea" placeholder="请填写原因" maxlength="300" value="{{form.note}}" data-key="note" bindinput="input"/><text wx:if="{{error}}" class="error">{{error}}</text><button class="solid" data-handler="confirm" bindtap="confirm">确认</button></view></view>
