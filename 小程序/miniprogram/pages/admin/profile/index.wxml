<view class="owner-page"><owner-header title="我的"/><view class="owner-content"><text wx:if="{{error}}" class="owner-error">{{error}}</text><block wx:if="{{ready}}">
<view class="owner-card"><button class="owner-person" data-action="profile" bindtap="go"><image class="owner-avatar" src="{{desk.avatar}}" mode="aspectFill"/><view class="owner-grow"><text class="owner-title">{{desk.name}}</text><text class="owner-muted">{{desk.company}} · {{desk.role}}</text><text wx:if="{{desk.sample}}" class="owner-badge">示例数据</text></view><text class="owner-link">个人资料<image class="owner-arrow" src="/assets/creation-chevron.png"/></text></button></view>
<view class="owner-card me-quick"><button class="me-quick-item" data-action="messages" bindtap="go"><image class="me-quick-icon" src="/assets/account-message.jpg" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">消息</text><text class="me-count">{{desk.unread}}</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="me-quick-item" data-action="goals" bindtap="go"><image class="me-quick-icon" src="/assets/account-chart.jpg" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">绩效设置</text><text class="owner-muted">目标 · 提成发放</text></view><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view>
<view class="owner-card"><button class="owner-row" data-action="identity" bindtap="go"><text class="owner-name owner-grow">组织与工作身份</text><text class="owner-muted">{{desk.company}} · {{desk.role}}</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="team" bindtap="go"><text class="owner-name owner-grow">我的团队</text><text class="owner-muted">在岗 {{desk.staff.length}} 人</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view>
<view class="owner-card"><view class="owner-heading"><text>门店管理</text></view><view class="me-grid"><button class="me-tile" data-action="staff" bindtap="go"><image src="/assets/team.png" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">成员与权限</text><text class="owner-muted">岗位与兼岗</text></view></button><button class="me-tile" data-action="settings" bindtap="go"><image src="/assets/management-payment.jpg" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">审批设置</text><text class="owner-muted">金额事项</text></view></button><button class="me-tile" data-action="handover" bindtap="go"><image src="/assets/folder.png" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">项目经理交接</text><text class="owner-muted">离岗与接续</text></view></button><button class="me-tile" data-action="company" bindtap="go"><image src="/assets/account-shop.jpg" mode="aspectFit"/><view class="owner-grow"><text class="owner-name">门店资料</text><text class="owner-muted">机构信息</text></view></button></view></view>
<view class="owner-card"><view class="owner-heading"><text>学习培训</text><button class="owner-link" data-action="learning" bindtap="go">全部课程<image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view><text class="owner-muted me-academy">自媒体运营 · 招商 · 设计 · 工程 · AI</text><button class="me-course" data-action="course" bindtap="go"><image class="me-course-image" src="{{desk.course.image}}" mode="aspectFill"/><view class="owner-grow"><text class="me-course-tag">继续学习</text><text class="owner-name">AI短视频获客实战</text><text class="owner-muted">已完成 {{desk.course.progress.completed}}/{{desk.course.progress.total}} 节</text><view class="owner-progress"><view style="width:{{desk.course.progress.percent}}%"/></view></view></button></view>
<view class="owner-card"><view class="owner-heading"><text>加盟商服务</text></view><view class="me-grid"><button class="me-tile" data-action="services" bindtap="go"><image src="/assets/account-shop.jpg" mode="aspectFit"/><text class="owner-name owner-grow">展陈设计</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="me-tile" data-action="procurement" bindtap="go"><image src="/assets/account-bag.jpg" mode="aspectFit"/><text class="owner-name owner-grow">众墅甄选</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view></view>
<view class="owner-card"><button class="owner-row" data-action="orders" bindtap="go"><image class="owner-menu-icon" src="/assets/account-order.jpg" mode="aspectFit"/><text class="owner-grow owner-name">我的订单</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="help" bindtap="go"><image class="owner-menu-icon" src="/assets/account-headset.jpg" mode="aspectFit"/><text class="owner-grow owner-name">帮助与反馈</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button><button class="owner-row" data-action="privacy" bindtap="go"><image class="owner-menu-icon" src="/assets/account-shield.jpg" mode="aspectFit"/><text class="owner-grow owner-name">账号与隐私</text><image class="owner-arrow" src="/assets/creation-chevron.png"/></button></view>
<button class="profile-logout" bindtap="logout">退出登录</button></block></view><owner-nav id="owner-navigation" active="profile"/></view>
