@import "../../../styles/profile-session.wxss";
@import "../owner.wxss";
/* 我的页：与各岗位“我的”同结构，老板在“我的绩效”位置放“绩效设置”。 */
.me-quick{display:flex;padding:0}
.me-quick-item{flex:1;min-width:0;display:flex;align-items:center;gap:16rpx;padding:26rpx 22rpx;text-align:left}
.me-quick-item:first-child{border-right:1rpx solid #ebe5dc}
.me-quick-icon{width:52rpx;height:52rpx;flex-shrink:0}
.me-count{display:block;color:var(--boss-brown);font-size:40rpx;line-height:52rpx;font-weight:700}
.me-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}
.me-tile{display:flex;align-items:center;gap:16rpx;min-height:120rpx;padding:18rpx;border-radius:18rpx;background:#fcf8f2;text-align:left}
.me-tile>image:first-child{width:50rpx;height:50rpx;flex-shrink:0}
.me-academy{margin:-6rpx 0 18rpx}
.me-course{width:100%;display:flex;align-items:center;gap:20rpx;padding:14rpx;border-radius:18rpx;background:#fcf8f2;text-align:left}
.me-course-image{width:250rpx;height:170rpx;border-radius:14rpx;flex-shrink:0}
.me-course-tag{display:block;color:var(--boss-brown);font-size:22rpx;line-height:34rpx}
