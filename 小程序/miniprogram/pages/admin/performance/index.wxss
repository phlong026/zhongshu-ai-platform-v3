@import "../owner.wxss";
/* 绩效页：公司目标 2×2 卡片与按部门分组的人员行。 */
.perf-targets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}
.perf-target{background:#fcf8f2;border-radius:18rpx;padding:20rpx 22rpx}
.perf-figure{display:flex;align-items:baseline;margin-top:6rpx}
.perf-value{font-size:40rpx;line-height:56rpx;font-weight:700;color:var(--boss-brown)}
.perf-goal{font-size:24rpx;line-height:36rpx;color:var(--boss-muted);margin-left:6rpx}
.perf-group{display:flex;justify-content:space-between;color:var(--boss-muted);font-size:24rpx;line-height:36rpx;padding:18rpx 0 6rpx}
.perf-person{width:100%;display:flex;align-items:center;gap:18rpx;padding:18rpx 0;text-align:left;border-bottom:1rpx solid #ebe5dc}
.perf-percent{min-width:96rpx;text-align:right;flex-shrink:0}
