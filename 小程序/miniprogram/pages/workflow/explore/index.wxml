<import src="../budget-result.wxml"/>
<view class="page workbench-page sales-page explore-page">
 <business-header id="subpage-header" title="{{title}}" design-flow/>
 <view class="content">
 <view wx:if="{{pickingRef}}" class="explore-notice">选择喜欢的外观，在详情中点击“用作立面参考”</view>
 <text wx:if="{{error}}" class="explore-error">{{error}}</text>
 <block wx:if="{{view==='inspiration'||view==='search'}}">
  <view class="section"><view class="sales-search"><image src="/assets/search.png"/><input class="explore-input" value="{{keyword}}" bindinput="searchInput" placeholder="搜索名称或方案编号"/></view><view class="explore-filters"><picker class="explore-picker" range="{{styles}}" data-key="filterStyle" data-list="styles" bindchange="filterPick"><view class="explore-select">{{filterStyle}}<image src="/assets/creation-down.png"/></view></picker><picker class="explore-picker" range="{{floorFilters}}" data-key="floorFilter" data-list="floorFilters" bindchange="filterPick"><view class="explore-select">{{floorFilter}}<image src="/assets/creation-down.png"/></view></picker></view>
   <block wx:if="{{view==='search'}}"><view class="explore-pair"><label>开间（米）<input class="explore-input" type="digit" value="{{searchWidth}}" data-key="searchWidth" bindinput="searchDimension"/></label><label>进深（米）<input class="explore-input" type="digit" value="{{searchDepth}}" data-key="searchDepth" bindinput="searchDimension"/></label></view><button class="primary explore-wide explore-search-submit" bindtap="searchPlans">按尺寸检索平面</button><text class="hint">按开间、进深各±1米匹配，参考尺寸与实际目标尺寸分别保留。</text></block><button wx:else class="text-link explore-search-open" bindtap="openSearch">按尺寸检索平面<view class="chevron"/></button>
  </view>
  <view class="explore-grid"><button wx:for="{{filteredCases}}" wx:key="id" class="explore-case" data-id="{{item.id}}" bindtap="openCase"><image src="{{item.image}}" mode="aspectFill"/><view><text>{{item.name}}</text><text class="hint">{{item.width}}×{{item.depth}}m · {{item.floors}}层</text><text class="hint">{{item.style}} · {{item.area}}㎡</text></view></button></view><view wx:if="{{!filteredCases.length}}" class="section sales-empty">暂无匹配灵感，可放宽尺寸或筛选条件。</view>
 </block>
 <block wx:elif="{{view==='case'}}"><view class="section"><view class="section-heading"><text class="section-title">{{caseItem.name}}</text><button class="text-link" bindtap="favorite">{{favorite?'已收藏':'收藏灵感'}}</button></view><text class="hint">{{caseItem.style}} · {{caseItem.width}}×{{caseItem.depth}}m · {{caseItem.floors}}层 · {{caseItem.area}}㎡</text><view class="explore-tabs"><button wx:for="{{caseTabs}}" wx:key="*this" class="explore-case-tab {{caseTab===index?'selected':''}}" data-index="{{index}}" bindtap="caseTab">{{item}}</button></view><image class="explore-case-image" src="{{caseImage}}" mode="widthFix" data-image="{{caseImage}}" bindtap="preview"/><text class="hint">本地模拟案例 · {{caseItem.versionId}}，图像仅供沟通参考。</text></view><view class="explore-action-pair"><button wx:if="{{!pickingRef}}" class="outline explore-use-case" data-kind="plan" bindtap="useCase">参考做AI平面</button><button class="primary explore-use-case" data-kind="facade" bindtap="useCase">用作立面参考</button></view></block>
 <block wx:elif="{{view==='ai-config'||view==='ai-facade'}}">
  <view class="section"><view class="section-heading"><text class="section-title">{{kind==='plan'?'建房需求':'立面需求'}}</text></view><view class="explore-pair"><label>开间（米）<input class="explore-input" type="digit" value="{{form.width}}" data-key="width" bindinput="input"/></label><label>进深（米）<input class="explore-input" type="digit" value="{{form.depth}}" data-key="depth" bindinput="input"/></label></view><view class="explore-pair"><label>建筑层数<input class="explore-input" type="number" value="{{form.floors}}" data-key="floors" bindinput="input"/></label><label>建筑风格<picker class="explore-picker" range="{{styleOptions}}" data-key="style" data-list="styleOptions" bindchange="pick"><view class="explore-select">{{form.style}}<image src="/assets/creation-down.png"/></view></picker></label></view>
   <label wx:if="{{kind==='facade'}}" class="explore-field">外观主色调<input class="explore-input" value="{{form.palette}}" data-key="palette" bindinput="input"/></label><label class="explore-field">家庭与设计要求<textarea value="{{form.note}}" data-key="note" bindinput="input" maxlength="1000"/></label>
   <view class="explore-reference"><text class="hint">参考灵感：{{form.referenceCaseId||(kind==='facade' && sourcePlanRef?'已选平面方案':'未选择')}}</text><button wx:if="{{kind==='facade'}}" class="text-link" bindtap="chooseReference">从灵感库选择<view class="chevron"/></button><button wx:else class="text-link explore-search-open" bindtap="openSearch">检索平面参考<view class="chevron"/></button></view>
  </view><view class="section"><view class="section-heading"><text class="section-title">出图设置</text></view><view class="explore-pair"><label>候选数量<picker class="explore-picker" range="{{countOptions}}" data-key="count" data-list="countOptions" bindchange="pick"><view class="explore-select">{{form.count}}个<image src="/assets/creation-down.png"/></view></picker></label><label>清晰度<picker class="explore-picker" range="{{resolutions}}" data-key="resolution" data-list="resolutions" bindchange="pick"><view class="explore-select">{{form.resolution}}<image src="/assets/creation-down.png"/></view></picker></label></view><text class="hint">平面与立面的参数分别保存。当前使用本地候选示意，正式成果仍由设计团队制作和审核。</text></view><button class="primary explore-wide generate-explore" loading="{{busy}}" disabled="{{busy}}" bindtap="generate">生成{{kind==='plan'?'平面':'立面'}}方案（模拟）</button>
 </block>
 <block wx:elif="{{view==='plan-result'||view==='facade-result'}}"><view class="section"><view class="section-heading"><text class="section-title">选择{{kind==='plan'?'平面':'立面'}}方案</text></view><text class="hint">目标{{result.parameters.width}}×{{result.parameters.depth}}m · {{result.parameters.floors}}层 · {{result.parameters.resolution}} · 模拟候选</text><view class="explore-tabs"><button wx:for="{{result.candidates}}" wx:key="id" class="explore-candidate {{result.selected===index?'selected':''}}" data-index="{{index}}" bindtap="selectCandidate">方案{{index+1}}</button></view><view wx:if="{{kind==='plan'}}" class="explore-tabs"><button wx:for="{{result.candidates[result.selected].images}}" wx:key="index" class="explore-floor {{floor===index?'selected':''}}" data-index="{{index}}" bindtap="selectFloor">{{index+1}}层</button></view><image class="explore-case-image" src="{{result.candidates[result.selected].images[floor]}}" mode="widthFix" data-image="{{result.candidates[result.selected].images[floor]}}" bindtap="preview"/><text class="hint">方案为参数关联的本地示意，建筑布局以正式设计为准。</text></view><view class="explore-action-pair"><button wx:if="{{kind==='plan'}}" class="outline explore-next-facade" bindtap="continueFacade">选用并继续立面</button><button class="primary explore-next-budget" bindtap="continueBudget">选用并测算预算</button></view><button class="outline explore-wide save-explore" bindtap="save">选择客户保存方案</button></block>
 <block wx:elif="{{view==='budget'}}"><view class="section"><view class="section-heading"><text class="section-title">建造规模</text></view><view class="explore-pair"><label>开间（米）<input class="explore-input" type="digit" value="{{form.width}}" data-key="width" bindinput="input"/></label><label>进深（米）<input class="explore-input" type="digit" value="{{form.depth}}" data-key="depth" bindinput="input"/></label><label>建筑层数<input class="explore-input" type="number" value="{{form.floors}}" data-key="floors" bindinput="input"/></label><label>占地面积（㎡）<input class="explore-input" type="digit" value="{{form.footprint}}" data-key="footprint" bindinput="input"/></label><label>建筑面积（㎡）<input class="explore-input" type="digit" value="{{form.area}}" data-key="area" bindinput="input"/></label><label>屋顶面积（㎡）<input class="explore-input" type="digit" value="{{form.roofArea}}" data-key="roofArea" bindinput="input"/></label></view><text class="hint">可独立填写面积测算；从方案继续时带入目标尺寸，面积可按实际工程量调整。</text></view><view class="section"><view class="section-heading"><text class="section-title">建造配置</text></view><label class="explore-field">基础<picker class="explore-picker" range="{{foundations}}" data-key="foundation" data-list="foundations" bindchange="pick"><view class="explore-select">{{form.foundation}}<image src="/assets/creation-down.png"/></view></picker></label><label class="explore-field">结构<picker class="explore-picker" range="{{structures}}" data-key="structure" data-list="structures" bindchange="pick"><view class="explore-select">{{form.structure}}<image src="/assets/creation-down.png"/></view></picker></label><label class="explore-field">屋顶<picker class="explore-picker" range="{{roofs}}" data-key="roof" data-list="roofs" bindchange="pick"><view class="explore-select">{{form.roof}}<image src="/assets/creation-down.png"/></view></picker></label><text class="explore-field">外装项目</text><view class="explore-choices"><button wx:for="{{exteriors}}" wx:key="key" class="{{form.exterior[item.key]?'selected':''}}" data-key="{{item.key}}" bindtap="toggleExterior">{{item.label}}</button></view></view><button class="primary explore-wide calculate-explore" bindtap="calculate">生成参考预算</button></block>
 <block wx:elif="{{view==='budget-result'}}"><template is="budget-result" data="{{budget:budgetPresentation,linked:!!saved,customerName:saved.customerName,continueHandler:'continueFormal',adjustHandler:'adjustBudget',continueLabel:'发起／继续设计委托',canChoose:true}}"/></block>
 <view wx:if="{{saved&&view!=='budget-result'}}" class="section explore-saved"><text>已保存至 {{saved.customerName}}</text><button class="text-link" bindtap="viewCustomer">查看客户方案<view class="chevron"/></button></view>
 </view>
 <view wx:if="{{sheet}}" class="explore-overlay" bindtap="closeSheet"><view class="explore-sheet" catchtap="noop"><view class="section-heading"><text class="section-title">选择客户保存</text><button class="text-link" bindtap="closeSheet">关闭</button></view><text class="hint">保存选定方案或预算，其他客户记录不变。</text><scroll-view scroll-y class="explore-customer-list"><button wx:for="{{saveCustomers}}" wx:key="id" class="explore-save-customer" data-id="{{item.id}}" bindtap="saveCustomer"><view><text>{{item.name}}</text><text class="hint">{{item.city}}</text></view><text class="text-link">保存<view class="chevron"/></text></button><text wx:if="{{!saveCustomers.length}}" class="sales-empty">暂无可由本人保存方案的客户</text></scroll-view><text wx:if="{{error}}" class="explore-error">{{error}}</text><button class="outline explore-wide" bindtap="register">登记新客户</button></view></view>
</view>
