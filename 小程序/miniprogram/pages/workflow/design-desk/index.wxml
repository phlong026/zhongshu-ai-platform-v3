<view class="page design-desk"><brand-header divider title="{{tab==='drawings'?'图纸':'项目'}}"/><view class="content design-content"><block wx:if="{{allowed}}">
 <view class="design-page-intro"><view class="design-page-heading"><text class="design-heading">{{tab==='drawings'?'项目图纸与成果':'设计项目'}}</text><button wx:if="{{tab==='projects'&&canManageTeam}}" class="text-link" bindtap="manageTeam">团队管理<view class="chevron"/></button></view><text class="design-muted">{{tab==='drawings'?'按项目找图，核对版本与审核状态':'共 '+allCount+' 个授权项目，按进度继续办理'}}</text></view>
 <view class="design-search"><image src="/assets/search.png"/><input class="design-search-input" value="{{keyword}}" bindinput="search" placeholder="{{tab==='drawings'?'搜索项目、文件或版本':'搜索项目、地点或设计师'}}" confirm-type="search"/></view>
 <scroll-view class="design-filters" scroll-x><view><button wx:for="{{filters}}" wx:key="id" class="design-chip {{filter===item.id?'selected':''}}" data-filter="{{item.id}}" bindtap="filter">{{item.label}} {{item.count}}</button></view></scroll-view>
 <block wx:if="{{tab==='projects'}}"><view wx:for="{{projects}}" wx:key="id" class="design-card"><button class="design-project-heading" data-id="{{item.id}}" data-detail="true" bindtap="open"><view><text class="design-name">{{item.name}}</text><text class="design-muted">{{item.city}}<text wx:if="{{item.basis}}"> · {{item.basis}}</text></text></view><image class="design-arrow" src="/assets/creation-chevron-muted.png"/></button><text class="design-state">{{item.state}}</text><view class="design-meta"><text>{{item.designerLabel||'对接设计师'}}</text><text>{{item.designer}}</text></view><view class="design-meta"><text>计划完成</text><text>{{item.dueDate||item.dueLabel||'待指派时确定'}}</text></view><view class="design-meta"><text>当前办理</text><text>{{item.owner}}</text></view><button class="design-primary design-project-action {{!item.actionable?'design-secondary':''}}" data-id="{{item.id}}" bindtap="open">{{item.action}}</button></view><view wx:if="{{!projects.length}}" class="design-empty"><text>暂无符合条件的项目</text><text class="design-muted">切换进度或调整搜索条件后再查看</text></view></block>
 <block wx:else><view class="design-version-options"><text class="design-muted">显示版本</text><button class="design-version-option {{versionFilter==='current'?'selected':''}}" data-version="current" bindtap="versions">最新版本</button><button class="design-version-option {{versionFilter==='all'?'selected':''}}" data-version="all" bindtap="versions">全部版本</button></view><view wx:for="{{files}}" wx:key="key" class="design-card design-file"><view class="design-file-top"><text class="design-file-type">{{item.label}} · {{item.version}}</text><text class="design-status">{{item.status}}</text></view><button class="design-file-open" data-key="{{item.key}}" bindtap="previewFile"><image src="/assets/home-design-icon.png"/><view><text class="design-name">{{item.name}}</text><text class="design-muted">{{item.project}}<text wx:if="{{item.date}}"> · {{item.date}}</text></text></view><image class="design-arrow" src="/assets/creation-chevron-muted.png"/></button><view class="design-file-footer"><text class="design-muted">{{item.current?'本类最新版本':'历史版本'}}{{item.sample?' · 演示附件':''}}</text><button class="design-file-project" data-id="{{item.id}}" data-detail="true" bindtap="open">查看项目</button></view></view><view wx:if="{{!files.length}}" class="design-empty"><text>暂无符合条件的图纸</text><text class="design-muted">提交成果或上传施工图后，这里会同步显示</text></view></block>
 </block><view wx:else class="design-empty"><text>当前身份无总部设计权限</text><button class="design-primary" bindtap="home">返回工作台</button></view></view>
 <view wx:if="{{preview}}" class="design-preview-mask" bindtap="closePreview"><view class="design-preview"><text class="design-name">{{preview.name}}</text><text class="design-preview-text">{{preview.text}}</text><button class="design-primary" bindtap="closePreview">关闭预览</button></view></view>
 <workspace-nav id="design-desk-nav" active-index="{{tab==='drawings'?16:15}}" nested/>
</view>
