<template name="record-fields"><view class="eng-section record-fields"><view wx:for="{{fields}}" wx:key="key" class="record-field"><text>{{item.label}}</text><picker wx:if="{{item.type==='date'}}" mode="date" value="{{form[item.key]}}" data-key="{{item.key}}" bindchange="input"><view>{{form[item.key]||'请选择日期'}}</view></picker><button wx:elif="{{item.type==='file'}}" class="eng-outline" data-key="{{item.key}}" bindtap="upload">{{form[item.key].name||'选择凭据'}}</button><button wx:elif="{{item.type==='check'}}" class="record-check" data-key="{{item.key}}" bindtap="toggle">{{form[item.key]?'已确认':'点击确认'}}</button><textarea wx:elif="{{item.type==='textarea'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height="{{true}}"/><input wx:else type="{{item.type==='digit'?'digit':'text'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input"/></view></view></template>
<view class="page engineering-desk record-page">
 <brand-header title="{{title}}" divider="{{true}}"/>
 <view class="eng-content">
  <text wx:if="{{error}}" class="eng-error">{{error}}</text>
  <block wx:if="{{p}}">
   <view class="eng-section"><text class="eng-name">{{p.name}}</text><text class="eng-muted">项目工程人员：{{p.manager}}</text><text class="eng-tag">{{stageText}}</text><text class="eng-muted">{{p.city}} · {{p.area}}㎡ · {{p.floors}}层</text></view>
   <view wx:if="{{view==='node'&&node}}" class="eng-section"><text class="eng-name">{{node.name}} · {{node.status}}</text><text class="eng-muted">计划 {{node.start}} 至 {{node.end}}</text><view class="record-node-menu"><button data-section="site" bindtap="jumpNodeSection">施工记录</button><button data-section="inspection" bindtap="jumpNodeSection">验收记录</button><button data-url="{{nodeMaterialUrl}}" bindtap="go">材料计划 {{nodePlans.length}}</button><button data-url="{{nodeFundingUrl}}" bindtap="go">资金计划</button></view></view>
   <template wx:if="{{view==='node'&&fields.length&&own}}" is="record-fields" data="{{fields:fields,form:form}}"/>
   <template wx:if="{{view==='prepare'&&fields.length&&own}}" is="record-fields" data="{{fields:fields,form:form}}"/>
   <view wx:if="{{view==='prepare'}}" class="eng-section"><text class="eng-muted">保存后交老板确认两期收款约定，确认后继续登记开工款。</text><button class="eng-link" data-url="{{links[1].url}}" bindtap="go">查看已接收的项目资料</button></view>
   <block wx:if="{{view==='overview'}}">
    <view class="eng-section"><view class="eng-heading"><text>下一步</text></view><button wx:if="{{next}}" class="eng-primary" data-url="{{next.url}}" bindtap="go">{{next.title}}</button><text wx:else class="eng-muted">施工记录已完成，款项与保修可在原项目继续办理</text></view>
    <view class="eng-section"><view class="eng-heading"><text>施工进度</text></view><button wx:for="{{nodeRows}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">{{item.name}}</text><text class="eng-muted">{{item.start}} 至 {{item.end}}</text></view><text class="eng-tag">{{item.status}} ›</text></button><button wx:if="{{own&&!p.delivery}}" class="eng-outline eng-submit" data-url="{{nodeUrl}}" bindtap="go">记录当前施工节点</button></view>
    <view class="eng-section"><view class="eng-heading"><text>待我办理</text></view><button wx:for="{{pending}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><text class="eng-grow">{{item.title}}</text><text>去记录</text></button><text wx:if="{{!pending.length}}" class="eng-muted">暂无待办</text></view>
    <view class="eng-section"><view class="eng-heading"><text>办理中</text></view><button wx:for="{{waiting}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><text class="eng-grow">{{item.title}}</text><text>查看</text></button><text wx:if="{{!waiting.length}}" class="eng-muted">暂无等待事项</text></view>
    <view class="eng-section"><button wx:for="{{links}}" wx:key="label" class="eng-row" data-url="{{item.url}}" bindtap="go"><text>{{item.label}}</text></button></view>
   </block>
   <view wx:if="{{view==='overview'||view==='payments'||view==='collection'||view==='prepare'}}" class="eng-section"><view class="eng-heading"><text>两次工程收款</text></view><button wx:for="{{installments}}" wx:key="stage" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">{{item.name}} · {{item.status}}</text><text class="eng-muted">应收 {{item.expected}} · 已确认 {{item.confirmed}}</text><text class="eng-muted">待财务确认 {{item.pending}} · 待收 {{item.remaining}}</text></view></button></view>
   <view wx:if="{{(view==='payments'||view==='collection')&&collections.length}}" class="eng-section"><view class="eng-heading"><text>原收款记录</text></view><button wx:for="{{collections}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>{{item.date}} · {{item.amountText}} · {{item.status}}</text><text class="eng-muted">{{item.transaction}}</text></view><text>{{item.status==='退回补充'?'补充原记录':'查看'}}</text></button></view><view wx:if="{{view==='prepare'||view==='project'}}" class="eng-section"><view class="eng-heading"><text>施工计划</text><button wx:if="{{view==='prepare'}}" class="eng-link" bindtap="togglePlan">{{showPlan?'收起':'查看或调整'}}</button></view><text wx:if="{{view==='prepare'&&!showPlan}}" class="eng-muted">按基础、各层主体、主体封顶及后续工程建立，日期可在原计划调整。</text><block wx:if="{{view==='project'||showPlan}}"><picker wx:if="{{view==='project'&&own}}" range="{{engineers}}" range-key="name" data-key="engineerId" value="{{engineerIndex}}" bindchange="pickEngineer"><view class="record-field">项目工程人员：{{engineers[engineerIndex].name}}　点击调整</view></picker><view wx:for="{{form.nodes}}" wx:key="id" class="record-node"><input value="{{item.name}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="name" bindinput="nodeInput"/><text class="eng-muted">{{item.status}}</text><picker mode="date" value="{{item.start}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="start" bindchange="nodeInput"><view class="record-field">开始：{{item.start}}</view></picker><picker mode="date" value="{{item.end}}" disabled="{{!own||item.status==='已完成'}}" data-index="{{index}}" data-key="end" bindchange="nodeInput"><view class="record-field">结束：{{item.end}}</view></picker></view></block></view>
   <block wx:if="{{view==='materials'}}"><button wx:if="{{!nodeId}}" class="eng-outline eng-submit" data-url="/pages/build/projects/index?destination=materials" bindtap="go">选择其他项目的材料计划</button>
    <view class="eng-section"><view class="eng-heading"><text>已有材料计划</text></view><button wx:for="{{plans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text class="eng-name">材料计划 · {{item.due}}</text><text class="eng-muted">{{item.lines.length}}项材料 · {{item.arrival}} · {{item.payment}}</text></view></button><text wx:if="{{!plans.length}}" class="eng-muted">暂无材料计划</text></view>
    <view wx:if="{{own&&!p.delivery&&(!nodeId||node.status!=='已完成')}}" class="eng-section"><view class="eng-heading"><text>提交材料计划</text></view><picker range="{{p.plan.nodes}}" range-key="name" value="{{nodeIndex}}" disabled="{{!!nodeId}}" bindchange="pickNode"><view class="record-field">使用节点：{{p.plan.nodes[nodeIndex].name}}</view></picker><view wx:for="{{form.lines}}" wx:key="index" class="record-node"><input placeholder="材料名称" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="lineInput"/><input placeholder="规格（选填）" value="{{item.spec}}" data-index="{{index}}" data-key="spec" bindinput="lineInput"/><view class="record-grid"><input type="digit" placeholder="需用数量" value="{{item.quantity}}" data-index="{{index}}" data-key="quantity" bindinput="lineInput"/><input placeholder="单位" value="{{item.unit}}" data-index="{{index}}" data-key="unit" bindinput="lineInput"/></view></view><button class="eng-outline record-add-line" bindtap="addLine">添加一种材料</button></view>
   </block>
   <block wx:if="{{view==='material'&&plan}}">
    <view class="eng-section"><view class="eng-heading"><text>到货与付款</text></view><text class="eng-muted">本计划施工节点：{{node.name}}</text><text class="eng-name">{{plan.arrival}} · {{plan.payment}}</text><text class="eng-muted">应付 {{plan.totalText}} · 已付 {{plan.paidText}} · 待付 {{plan.remainingText}}</text><view wx:for="{{plan.lines}}" wx:key="id" class="eng-row"><view class="eng-grow"><text class="eng-name">{{item.name}} {{item.spec}}</text><text class="eng-muted">需用 {{item.quantity}}{{item.unit}} · 合格实收 {{item.received}}{{item.unit}} · 未到 {{item.remaining}}{{item.unit}}</text><text class="eng-muted">{{item.supplier}} · {{item.paymentStatus}}</text></view><button wx:if="{{(finance||item.canSupplement)&&item.payUrl}}" class="eng-outline" data-url="{{item.payUrl}}" bindtap="go">{{item.canSupplement?'补充原事项':'办理付款'}}</button></view></view>
    <view wx:if="{{own&&!p.delivery&&plan.arrival!=='已验收齐全'&&plan.arrival!=='已取消'}}" class="eng-section"><view class="eng-heading"><text>确认本次到货</text></view><view wx:for="{{form.lines}}" wx:key="id" wx:if="{{!item.cancelled}}" class="record-field"><text>{{item.name}}</text><input type="digit" placeholder="本次实际合格到货数量，无到货留空" value="{{item.actual}}" data-index="{{index}}" data-key="actual" bindinput="lineInput"/></view></view>
    <view wx:if="{{canAdjust}}" class="eng-section material-adjust"><view class="eng-heading"><text>调整需用数量</text></view><text class="eng-muted">多报或不再需要时按实际修改，填 0 为取消；不能少于已到货数量，已有付款的材料由财务处理。</text><view wx:for="{{form.lines}}" wx:key="id" class="record-field"><text>{{item.name}} · 需用 {{item.quantity}}{{item.unit}} · 已到 {{item.received}}{{item.unit}}</text><text wx:if="{{item.locked}}" class="eng-muted">已有付款，不能由工程调整</text><input wx:else type="digit" placeholder="调整后的需用数量，不改留空" value="{{item.adjust}}" data-index="{{index}}" data-key="adjust" bindinput="lineInput"/></view><view class="record-field"><text>调整原因</text><input value="{{form.adjustReason}}" data-key="adjustReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="material-adjust" bindtap="perform" disabled="{{busy}}">保存数量调整</button></view><view wx:if="{{arrivals.length}}" class="eng-section"><view class="eng-heading"><text>到货记录</text></view><view wx:for="{{arrivals}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.materialName}} · 合格实收 {{item.actual}}{{item.unit}}</text><text class="eng-muted">{{item.note}}</text><text wx:if="{{item.corrections.length}}" class="eng-muted">已更正，原记 {{item.corrections[0].from}}{{item.unit}}</text><button class="eng-link" data-file="{{item.file}}" bindtap="preview">查看到货凭据</button><button wx:if="{{item.canCorrect}}" class="eng-link" data-id="{{item.id}}" bindtap="pickArrival">更正数量</button></view></view><view wx:if="{{view==='material'&&form.correctId}}" class="eng-section"><view class="eng-heading"><text>更正到货数量</text><button class="eng-link" bindtap="cancelCorrection">取消</button></view><view class="record-field"><text>更正后的实到数量</text><input type="digit" value="{{form.correctActual}}" data-key="correctActual" bindinput="input"/></view><view class="record-field"><text>更正原因</text><input value="{{form.correctReason}}" data-key="correctReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="arrival-correct" bindtap="perform" disabled="{{busy}}">保存更正</button></view>
    <view wx:if="{{canTerms}}" class="eng-section"><view class="eng-heading"><text>付款信息</text></view><text class="eng-muted">由公司或财务记录实际采购金额，付款沿原财务事项办理</text><view wx:for="{{form.lines}}" wx:key="id" wx:if="{{!item.cancelled}}" class="record-node"><text class="eng-name">{{item.name}}</text><text class="eng-muted">实际供应方</text><input placeholder="实际供应方" value="{{item.supplier}}" data-index="{{index}}" data-key="supplier" bindinput="lineInput"/><text class="eng-muted">实际单价（元）</text><input type="digit" placeholder="实际单价（元）" value="{{item.unitPrice}}" data-index="{{index}}" data-key="unitPrice" bindinput="lineInput"/><text class="eng-muted">本项运费（元，无运费填0）</text><input type="digit" placeholder="本项运费（元，无运费填0）" value="{{item.freight}}" data-index="{{index}}" data-key="freight" bindinput="lineInput"/></view><button class="eng-outline" data-key="termsFile" bindtap="upload">{{form.termsFile.name||'上传实际采购凭据'}}</button><button class="eng-outline eng-submit" data-action="material-terms" bindtap="perform" disabled="{{busy}}">保存付款信息，交财务办理</button></view>
   </block>
   <view wx:if="{{view==='funding'&&node}}" class="eng-section"><text class="eng-name">{{node.name}} · {{node.status}}</text><text class="eng-muted">计划 {{node.start}} 至 {{node.end}}</text><text class="eng-muted">施工、验收、材料和资金均关联本节点</text><button wx:if="{{view==='funding'}}" class="eng-link" data-url="{{nodeRecordUrl}}" bindtap="go">返回本节点记录</button></view>
   <view wx:if="{{view==='node'}}" class="eng-section"><view class="eng-heading"><text>本节点材料计划</text><button class="eng-link" data-url="{{nodeMaterialUrl}}" bindtap="go">{{node.status==='已完成'?'查看计划':'提交或查看'}}</button></view><button wx:for="{{nodePlans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>{{item.lines.length}}项材料 · {{item.due}}</text><text class="eng-muted">{{item.arrival}} · {{item.payment}}</text></view><text>查看</text></button><text wx:if="{{!nodePlans.length}}" class="eng-muted">本节点尚无材料计划；无需新增材料时，核对现场材料后继续记录。</text></view>
   <view wx:if="{{(view==='node'||view==='funding')&&nodeMoney}}" class="eng-section"><view class="eng-heading"><text>本节点资金计划</text><button wx:if="{{view==='node'}}" class="eng-link" data-url="{{nodeFundingUrl}}" bindtap="go">查看或记录</button></view><text class="eng-name">预计用款 {{nodeMoney.plannedText}}</text><text class="eng-muted">已记录材料及费用 {{nodeMoney.committedText}}</text><text class="eng-muted">实际已付 {{nodeMoney.paidText}} · 尚待付款 {{nodeMoney.remainingText}}</text><text wx:if="{{!nodeMoney.known}}" class="eng-muted">部分材料采购金额待记录，汇总金额尚未完整。</text><text wx:if="{{nodeMoney.funding}}" class="eng-muted">计划用款 {{nodeMoney.funding.due}} · {{nodeMoney.funding.note}}</text><text class="eng-muted">资金计划用于安排用款，实际付款沿原材料或费用事项办理。</text><block wx:if="{{view==='funding'}}"><button wx:for="{{nodePlans}}" wx:key="id" class="eng-row" data-url="{{item.url}}" bindtap="go"><view class="eng-grow"><text>材料计划 · {{item.due}}</text><text class="eng-muted">{{item.payment}} · 应付 {{item.totalText}}</text></view><text>查看</text></button><view wx:for="{{nodeMoney.expenses}}" wx:key="id" class="record-field"><text>{{item.name}} · {{item.amountText}}</text><text class="eng-muted">{{item.status==='approved'?'已批准':item.status==='pending'?'待确认':'原事项待补充'}}</text></view><button class="eng-outline eng-submit" data-view="expenses" bindtap="operating">本节点人工及其他费用</button></block></view>
   <view wx:if="{{view==='node'}}" class="eng-section node-inspection"><view class="eng-heading"><text>本节点验收记录</text></view><view wx:for="{{inspections}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.result}} · {{item.person}}</text><button class="eng-link" data-file="{{item.file}}" bindtap="preview">查看验收凭据</button></view><text wx:if="{{!inspections.length}}" class="eng-muted">现场核对后，在本节点记录验收结果并确认完成。</text></view><view wx:if="{{view==='node'&&canCorrectNode}}" class="eng-section node-correct"><view class="eng-heading"><text>更正本节点完成记录</text></view><view class="record-field"><text>实际完成日期</text><picker mode="date" value="{{form.nodeDate}}" data-key="nodeDate" bindchange="input"><view>{{form.nodeDate}}</view></picker></view><view class="record-field"><text>施工情况与验收记录</text><textarea value="{{form.nodeNote}}" data-key="nodeNote" bindinput="input" auto-height="{{true}}"/></view><view class="record-field"><text>现场及验收凭据</text><button class="eng-outline" data-key="nodeFile" bindtap="upload">{{form.nodeFile.name||'选择凭据'}}</button></view><view class="record-field"><text>更正或撤回原因</text><input value="{{form.nodeReason}}" data-key="nodeReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="node-correct" bindtap="perform" disabled="{{busy}}">保存更正</button><button wx:if="{{canReopen}}" class="eng-outline eng-submit" data-action="node-reopen" bindtap="perform" disabled="{{busy}}">撤回本节点完成</button><text wx:else class="eng-muted">只有最近完成、且下一节点还没开始记录的节点可以撤回。</text></view>
   <view wx:if="{{view==='node'&&siteRecords.length}}" class="eng-section node-site-records"><view class="eng-heading"><text>本节点现场记录</text></view><view wx:for="{{siteRecords}}" wx:key="id" class="record-field"><text>{{item.date}} · {{item.note}}</text><button wx:if="{{item.file}}" class="eng-link" data-file="{{item.file}}" bindtap="preview">查看现场凭据</button><button wx:if="{{item.canCorrect}}" class="eng-link" data-id="{{item.id}}" bindtap="pickSite">更正</button></view></view><view wx:if="{{view==='node'&&form.siteId}}" class="eng-section"><view class="eng-heading"><text>更正现场记录</text><button class="eng-link" bindtap="cancelCorrection">取消</button></view><view class="record-field"><text>现场情况</text><textarea value="{{form.siteNote}}" data-key="siteNote" bindinput="input" auto-height="{{true}}"/></view><view class="record-field"><text>现场凭据（不换可不选）</text><button class="eng-outline" data-key="siteFile" bindtap="upload">{{form.siteFile.name||'选择凭据'}}</button></view><view class="record-field"><text>更正原因</text><input value="{{form.siteReason}}" data-key="siteReason" bindinput="input"/></view><button class="eng-outline eng-submit" data-action="site-correct" bindtap="perform" disabled="{{busy}}">保存更正</button></view><view wx:if="{{view==='documents'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>项目资料</text></view><button wx:for="{{docs}}" wx:key="name" class="eng-row" data-file="{{item.file}}" bindtap="preview"><view class="eng-grow"><text>{{item.name}}</text><text class="eng-muted">{{item.file.name}}</text></view><text>查看</text></button></view>
   <view wx:if="{{view==='archive'}}" class="eng-section"><text class="eng-name">{{p.archived?'施工资料已归档':p.delivery?'已交付，待归档':'请先记录工程交付'}}</text><text wx:if="{{p.delivery}}" class="eng-muted">{{p.delivery.date}} · 业主签收：{{p.delivery.recipient}}</text><button class="eng-outline eng-submit" data-url="{{links[5].url}}" bindtap="go">保修记录</button></view>
   <view wx:if="{{view==='payments'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>费用与财务收尾</text></view><button class="eng-row" data-view="expenses" bindtap="operating">人工、运输及其他项目费用</button><button class="eng-row" data-view="payables" bindtap="operating">材料及费用付款记录</button><button class="eng-row" data-view="costs" bindtap="operating">项目成本</button><button class="eng-row" data-view="settlement" bindtap="operating">项目财务结清</button></view>
   <template wx:if="{{fields.length&&own&&view!=='prepare'&&view!=='node'}}" is="record-fields" data="{{fields:fields,form:form}}"/>

   <view wx:if="{{view==='warranty'}}" class="eng-section"><view wx:for="{{warranties}}" wx:key="id" class="eng-row"><view class="eng-grow"><text>{{item.date}} · {{item.status}}</text><text class="eng-muted">{{item.note}}</text></view><button wx:if="{{own}}" class="eng-outline" data-id="{{item.id}}" bindtap="editWarranty">补充原记录</button></view></view>
   <view wx:if="{{view==='overview'||view==='project'||view==='archive'}}" class="eng-section"><view class="eng-heading"><text>项目记录</text></view><view wx:for="{{events}}" wx:key="id" class="record-field"><text>{{item.title}}</text><text class="eng-muted">{{item.time}} · {{item.by}}</text></view></view>
  </block>
 </view>
</view>

<view wx:if="{{actions.length}}" class="page-actions record-actions"><button wx:for="{{actions}}" wx:key="action" class="{{index===0?'eng-primary':'eng-outline'}} primary-action" data-action="{{item.action}}" bindtap="perform" loading="{{busy}}" disabled="{{busy}}">{{item.label}}</button></view>
