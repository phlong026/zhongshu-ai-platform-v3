page{background:#faf8f4;color:#252525}.content{padding:210rpx 28rpx 190rpx}.card{padding:28rpx;background:#fff;border-radius:20rpx;margin-bottom:24rpx;display:flex;flex-direction:column;gap:20rpx}.title{font-size:32rpx;font-weight:600}.muted{font-size:25rpx;color:#777;overflow-wrap:anywhere}.record{display:flex;flex-direction:column;gap:12rpx;border-bottom:1rpx solid #eee;padding:18rpx 0}.solid,.outline{font-size:28rpx;border-radius:12rpx;padding:18rpx 24rpx;line-height:1.5;width:100%;margin:0}.solid{background:#91502b;color:#fff}.outline{background:#fff8f2;border:1rpx solid #dcc3b3;text-align:left}.selected{border-color:#91502b}.page-actions{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;z-index:20}.error{color:#b33}
