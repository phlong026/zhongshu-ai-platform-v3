<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.iocoder.boot</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>yudao-platform-identity</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        平台能力：员工登录。小程序员工用微信登录：首次以微信手机号匹配已建档且在岗的员工并绑定，之后凭微信直接登录；
        签发与 Web 后台相同的令牌。支持多个小程序 AppID。
    </description>

    <dependencies>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-platform-org</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 审计查询：只认当前岗位权限（@post.has），并按当前组织自动过滤 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-platform-authz</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-platform-test-support</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
